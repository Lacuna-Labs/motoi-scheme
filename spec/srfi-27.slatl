(part
  :std "SRFI-27"
  :title "SRFI-27: Sources of Random Bits"
  :provenance "Sebastian Egner"
  :url "https://srfi.schemers.org/srfi-27/"
  :mode "lazy"
  :verb-count 4
  :note "Lazy part. R7RS-small has no random; SRFI-27 is the conformance target. random-source-randomize! is a no-op (Math.random is already nondeterministic).")

(verb :name "make-random-source" :std "SRFI-27" :arity 0
  :doc "(make-random-source) — a fresh random source. SRFI-27."
  :example "(make-random-source)")
(verb :name "random-integer" :std "SRFI-27" :arity 1
  :doc "(random-integer n) — integer in [0, n). SRFI-27."
  :example "(< (random-integer 6) 6) => #t")
(verb :name "random-real" :std "SRFI-27" :arity 0
  :doc "(random-real) — real in the open interval (0, 1). SRFI-27."
  :example "(random-real) => 0.37…")
(verb :name "random-source-randomize!" :std "SRFI-27" :arity 1
  :doc "(random-source-randomize! src) — reseed a source; no-op in Motoi. SRFI-27."
  :example "(random-source-randomize! (make-random-source))")
