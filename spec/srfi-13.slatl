;; SPEC — SRFI-13: String Library
;;
;; Provenance: Olin Shivers
;; Source:     https://srfi.schemers.org/srfi-13/
;;
;; This is gate #2 of the 5-point part gate (CLAUDE.md): the part's
;; spec kept ALONGSIDE the part. Every record below is derived from
;; the authored META in lib/std/ — nothing invented. Generated by
;; scratch/gen-std-specs.mjs; edit the part META, then regenerate.
;; ═══════════════════════════════════════════════════════════════

(part
  :std "SRFI-13"
  :title "SRFI-13: String Library"
  :provenance "Olin Shivers"
  :url "https://srfi.schemers.org/srfi-13/"
  :mode "lazy"
  :verb-count 18
  :note "Lazy part. Only the string verbs NOT already in R7RS §6.7 live here. Divergences (string-split Racket-flavored, string-replace replace-all) documented as broken-examples.")

(verb :name "string-contains" :std "SRFI-13" :arity 2
  :doc "(string-contains hay needle) → index of first match, or #f. SRFI-13."
  :example "(string-contains \"hello world\" \"world\") => 6")
(verb :name "string-index" :std "SRFI-13" :arity 2
  :doc "(string-index s char-or-pred) → index of first match, or #f. SRFI-13."
  :example "(string-index \"hello\" \"l\") => 2")
(verb :name "string-split" :std "SRFI-13" :arity [1,2]
  :doc "(string-split s [sep]) → list of parts. Whitespace default sep. SRFI-13."
  :example "(string-split \"a,b,c\" \",\") => (\"a\" \"b\" \"c\")")
(verb :name "string-join" :std "SRFI-13" :arity [1,2]
  :doc "(string-join lst [sep]) → glue lst with sep. Inverse of split. SRFI-13."
  :example "(string-join (list \"a\" \"b\" \"c\") \"-\") => \"a-b-c\"")
(verb :name "string-titlecase" :std "SRFI-13" :arity 1
  :doc "Titlecase (first-letter-cap per word). SRFI-13."
  :example "(string-titlecase \"hello world\") => \"Hello World\"")
(verb :name "string-take" :std "SRFI-13" :arity 2
  :doc "(string-take s n) — first n characters. SRFI-13."
  :example "(string-take \"hello\" 3) => \"hel\"")
(verb :name "string-drop" :std "SRFI-13" :arity 2
  :doc "(string-drop s n) — drop first n characters. SRFI-13."
  :example "(string-drop \"hello\" 2) => \"llo\"")
(verb :name "string-pad" :std "SRFI-13" :arity [2,3]
  :doc "(string-pad s len [char]) — left-pad to len. SRFI-13."
  :example "(string-pad \"7\" 3 \"0\") => \"007\"")
(verb :name "string-pad-right" :std "SRFI-13" :arity [2,3]
  :doc "(string-pad-right s len [char]) — right-pad to len. SRFI-13."
  :example "(string-pad-right \"7\" 3 \"0\") => \"700\"")
(verb :name "string-trim" :std "SRFI-13" :arity 1
  :doc "Trim whitespace from both ends. SRFI-13."
  :example "(string-trim \"  hi  \") => \"hi\"")
(verb :name "string-trim-left" :std "SRFI-13" :arity 1
  :doc "Trim leading whitespace. SRFI-13."
  :example "(string-trim-left \"  hi\") => \"hi\"")
(verb :name "string-trim-right" :std "SRFI-13" :arity 1
  :doc "Trim trailing whitespace. SRFI-13."
  :example "(string-trim-right \"hi  \") => \"hi\"")
(verb :name "string-replace" :std "SRFI-13" :arity 3
  :doc "(string-replace s from to) → replace all occurrences. SRFI-13."
  :example "(string-replace \"hello\" \"l\" \"L\") => \"heLLo\"")
(verb :name "string-reverse" :std "SRFI-13" :arity 1
  :doc "Reverse a string. SRFI-13."
  :example "(string-reverse \"abc\") => \"cba\"")
(verb :name "string-count" :std "SRFI-13" :arity 2
  :doc "(string-count s char-or-pred) → count of matches. SRFI-13."
  :example "(string-count \"hello\" \"l\") => 2")
(verb :name "string-prefix?" :std "SRFI-13" :arity 2
  :doc "(string-prefix? s1 s2) → #t if s1 is a prefix of s2. SRFI-13."
  :example "(string-prefix? \"he\" \"hello\") => #t")
(verb :name "string-suffix?" :std "SRFI-13" :arity 2
  :doc "(string-suffix? s1 s2) → #t if s1 is a suffix of s2. SRFI-13."
  :example "(string-suffix? \"lo\" \"hello\") => #t")
(verb :name "string-null?" :std "SRFI-13" :arity 1
  :doc "(string-null? s) → #t if s is the empty string. SRFI-13."
  :example "(string-null? \"\") => #t")
