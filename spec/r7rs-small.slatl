(part
  :std "R7RS-small"
  :title "Revised(7) Report on the Algorithmic Language Scheme (R7RS-small)"
  :provenance "Alex Shinn, John Cowan, Arthur A. Gleckler (eds.), 2013"
  :url "https://small.r7rs.org/"
  :mode "eager"
  :verb-count 120
  :note "The semantic authority. Default bundle, eager. Section citations are per the R7RS numbering carried in each verb doc.")

(verb :name "list?" :std "R7RS-small" :arity 1
  :doc "#t if x is a proper list. R7RS §6.4."
  :example "(list? (list 1 2 3)) => #t")
(verb :name "list-tail" :std "R7RS-small" :arity 2
  :doc "(list-tail lst k) — drop the first k elements. R7RS §6.4."
  :example "(list-tail (list 1 2 3 4) 2) => (3 4)")
(verb :name "list-copy" :std "R7RS-small" :arity 1
  :doc "(list-copy lst) — a shallow copy. R7RS §6.4."
  :example "(list-copy (list 1 2 3)) => (1 2 3)")
(verb :name "string-upcase" :std "R7RS-small" :arity 1
  :doc "Uppercase a string. R7RS §6.7."
  :example "(string-upcase \"hi\") => \"HI\"")
(verb :name "string-downcase" :std "R7RS-small" :arity 1
  :doc "Lowercase a string. R7RS §6.7."
  :example "(string-downcase \"HI\") => \"hi\"")
(verb :name "string->list" :std "R7RS-small" :arity 1
  :doc "Explode a string into a list of characters. R7RS §6.7."
  :example "(string->list \"abc\") => (#\\a #\\b #\\c)")
(verb :name "list->string" :std "R7RS-small" :arity 1
  :doc "Concatenate a list of characters into a string. R7RS §6.7."
  :example "(list->string (list #\\a #\\b #\\c)) => \"abc\"")
(verb :name "string" :std "R7RS-small" :arity [0,null]
  :doc "Build a string from character arguments. R7RS §6.7."
  :example "(string #\\a #\\b #\\c) => \"abc\"")
(verb :name "make-string" :std "R7RS-small" :arity [1,2]
  :doc "(make-string k [char]) — a string of k copies of char. R7RS §6.7."
  :example "(make-string 3 #\\-) => \"---\"")
(verb :name "string-copy" :std "R7RS-small" :arity [1,3]
  :doc "(string-copy s [start [end]]) — copy substring. R7RS §6.7."
  :example "(string-copy \"hello\" 1 4) => \"ell\"")
(verb :name "string<?" :std "R7RS-small" :arity 2
  :doc "Lexicographic less-than. R7RS §6.7."
  :example "(string<? \"abc\" \"abd\") => #t")
(verb :name "string>?" :std "R7RS-small" :arity 2
  :doc "Lexicographic greater-than. R7RS §6.7."
  :example "(string>? \"abd\" \"abc\") => #t")
(verb :name "string<=?" :std "R7RS-small" :arity 2
  :doc "Lexicographic less-than-or-equal. R7RS §6.7."
  :example "(string<=? \"abc\" \"abc\") => #t")
(verb :name "string>=?" :std "R7RS-small" :arity 2
  :doc "Lexicographic greater-than-or-equal. R7RS §6.7."
  :example "(string>=? \"abc\" \"abc\") => #t")
(verb :name "string-ci=?" :std "R7RS-small" :arity 2
  :doc "Case-insensitive string equality. R7RS §6.7."
  :example "(string-ci=? \"Hi\" \"hi\") => #t")
(verb :name "string-ci<?" :std "R7RS-small" :arity 2
  :doc "Case-insensitive lexicographic less-than. R7RS §6.7."
  :example "(string-ci<? \"abc\" \"ABD\") => #t")
(verb :name "string-set!" :std "R7RS-small" :arity null
  :doc "")
(verb :name "string-fill!" :std "R7RS-small" :arity null
  :doc "")
(verb :name "string-copy!" :std "R7RS-small" :arity null
  :doc "")
(verb :name "symbol->string" :std "R7RS-small" :arity 1
  :doc "Convert a symbol to its printable name. R7RS §6.5."
  :example "(symbol->string 'foo) => \"foo\"")
(verb :name "string->symbol" :std "R7RS-small" :arity 1
  :doc "Intern a string as a symbol. R7RS §6.5."
  :example "(string->symbol \"foo\") => foo")
(verb :name "char-alphabetic?" :std "R7RS-small" :arity 1
  :doc "#t if arg is an ASCII letter. R7RS §6.6."
  :example "(char-alphabetic? #\\a) => #t")
(verb :name "char-numeric?" :std "R7RS-small" :arity 1
  :doc "#t if arg is an ASCII digit. R7RS §6.6."
  :example "(char-numeric? #\\5) => #t")
(verb :name "char-whitespace?" :std "R7RS-small" :arity 1
  :doc "#t if arg is whitespace. R7RS §6.6."
  :example "(char-whitespace? #\\space) => #t")
(verb :name "char-upper-case?" :std "R7RS-small" :arity 1
  :doc "#t if arg is uppercase. R7RS §6.6."
  :example "(char-upper-case? #\\A) => #t")
(verb :name "char-lower-case?" :std "R7RS-small" :arity 1
  :doc "#t if arg is lowercase. R7RS §6.6."
  :example "(char-lower-case? #\\a) => #t")
(verb :name "char-upcase" :std "R7RS-small" :arity 1
  :doc "Uppercase a single character. R7RS §6.6."
  :example "(char-upcase #\\a) => #\\A")
(verb :name "char-downcase" :std "R7RS-small" :arity 1
  :doc "Lowercase a single character. R7RS §6.6."
  :example "(char-downcase #\\A) => #\\a")
(verb :name "char-foldcase" :std "R7RS-small" :arity 1
  :doc "Foldcase (Unicode-lowercase, ASCII-equivalent to downcase). R7RS §6.6."
  :example "(char-foldcase #\\A) => #\\a")
(verb :name "char->integer" :std "R7RS-small" :arity 1
  :doc "Char code point. R7RS §6.6."
  :example "(char->integer #\\A) => 65")
(verb :name "integer->char" :std "R7RS-small" :arity 1
  :doc "Code point → character. R7RS §6.6."
  :example "(integer->char 65) => #\\A")
(verb :name "digit-value" :std "R7RS-small" :arity 1
  :doc "Digit character to numeric value 0-9, or #f. R7RS §6.6."
  :example "(digit-value #\\5) => 5")
(verb :name "char?" :std "R7RS-small" :arity 1
  :doc "#t if arg is a character object. R7RS §6.6."
  :example "(char? #\\a) => #t")
(verb :name "char=?" :std "R7RS-small" :arity 2
  :doc "Character equality. R7RS §6.6."
  :example "(char=? #\\a #\\a) => #t")
(verb :name "char<?" :std "R7RS-small" :arity 2
  :doc "Character less-than. R7RS §6.6."
  :example "(char<? #\\a #\\b) => #t")
(verb :name "char>?" :std "R7RS-small" :arity 2
  :doc "Character greater-than. R7RS §6.6."
  :example "(char>? #\\b #\\a) => #t")
(verb :name "char<=?" :std "R7RS-small" :arity 2
  :doc "Character less-than-or-equal. R7RS §6.6."
  :example "(char<=? #\\a #\\a) => #t")
(verb :name "char>=?" :std "R7RS-small" :arity 2
  :doc "Character greater-than-or-equal. R7RS §6.6."
  :example "(char>=? #\\b #\\a) => #t")
(verb :name "exact" :std "R7RS-small" :arity 1
  :doc "Convert an inexact number to exact (integer or rational). R7RS §6.2."
  :example "(exact 3.5) => 7/2")
(verb :name "inexact" :std "R7RS-small" :arity 1
  :doc "Convert to inexact (float). R7RS §6.2."
  :example "(inexact 3) => 3")
(verb :name "exact->inexact" :std "R7RS-small" :arity 1
  :doc "Alias for inexact. R7RS §6.2."
  :example "(exact->inexact 3) => 3")
(verb :name "inexact->exact" :std "R7RS-small" :arity 1
  :doc "Alias for exact. R7RS §6.2."
  :example "(inexact->exact 3.5) => 7/2")
(verb :name "exact?" :std "R7RS-small" :arity 1
  :doc "#t if x is an integer-valued number. R7RS §6.2."
  :example "(exact? 3) => #t")
(verb :name "inexact?" :std "R7RS-small" :arity 1
  :doc "#t if x is a non-integer-valued number. R7RS §6.2."
  :example "(inexact? 3.5) => #t")
(verb :name "integer?" :std "R7RS-small" :arity 1
  :doc "#t if x is an integer. R7RS §6.2."
  :example "(integer? 3) => #t")
(verb :name "rational?" :std "R7RS-small" :arity 1
  :doc "#t if x is a finite real. R7RS §6.2."
  :example "(rational? 3.5) => #t")
(verb :name "real?" :std "R7RS-small" :arity 1
  :doc "#t if x is a real number. R7RS §6.2."
  :example "(real? 3.5) => #t")
(verb :name "complex?" :std "R7RS-small" :arity 1
  :doc "#t if x is a complex number (JS: same as real). R7RS §6.2."
  :example "(complex? 3) => #t")
(verb :name "exact-integer?" :std "R7RS-small" :arity 1
  :doc "#t if x is an exact integer. R7RS §6.2."
  :example "(exact-integer? 3) => #t")
(verb :name "finite?" :std "R7RS-small" :arity 1
  :doc "#t if x is a finite number. R7RS §6.2."
  :example "(finite? 3.5) => #t")
(verb :name "infinite?" :std "R7RS-small" :arity 1
  :doc "#t if x is +inf or -inf. R7RS §6.2."
  :example "(infinite? (/ 1 0)) => #t")
(verb :name "nan?" :std "R7RS-small" :arity 1
  :doc "#t if x is NaN. R7RS §6.2."
  :example "(nan? (/ 0 0)) => #t")
(verb :name "gcd" :std "R7RS-small" :arity [0,null]
  :doc "Greatest common divisor. R7RS §6.2.6."
  :example "(gcd 12 18) => 6")
(verb :name "lcm" :std "R7RS-small" :arity [0,null]
  :doc "Least common multiple. R7RS §6.2.6."
  :example "(lcm 4 6) => 12")
(verb :name "numerator" :std "R7RS-small" :arity 1
  :doc "The numerator of a rational. JS: x for integers. R7RS §6.2.6."
  :example "(numerator 3) => 3")
(verb :name "denominator" :std "R7RS-small" :arity 1
  :doc "The denominator of a rational. JS: always 1. R7RS §6.2.6."
  :example "(denominator 3) => 1")
(verb :name "truncate" :std "R7RS-small" :arity 1
  :doc "Truncate to integer (toward zero). R7RS §6.2.6."
  :example "(truncate 3.7) => 3")
(verb :name "atan" :std "R7RS-small" :arity [1,2]
  :doc "(atan y) → arctan; (atan y x) → atan2. R7RS §6.2.6."
  :example "(atan 1 1) => 0.785…")
(verb :name "asin" :std "R7RS-small" :arity 1
  :doc "(asin x) → arcsine, in radians. R7RS §6.2.6."
  :example "(asin 1) => 1.5707…")
(verb :name "acos" :std "R7RS-small" :arity 1
  :doc "(acos x) → arccosine, in radians. R7RS §6.2.6."
  :example "(acos -1) => 3.1415…")
(verb :name "square" :std "R7RS-small" :arity 1
  :doc "x squared. R7RS §6.2.6."
  :example "(square 5) => 25")
(verb :name "write" :std "R7RS-small" :arity 1
  :doc "Print a machine-readable representation. Strings quoted. R7RS §6.10.3."
  :example "(write \"hi\") ; prints \"hi\"")
(verb :name "write-string" :std "R7RS-small" :arity 1
  :doc "Print a string with no quoting. R7RS §6.10.3."
  :example "(write-string \"hi\")")
(verb :name "read-line" :std "R7RS-small" :arity 1
  :doc "(read-line port) — read a line from a port. R7RS §6.10.2."
  :example "(read-line (open-input-string \"hi\\n\")) => \"hi\"")
(verb :name "read-char" :std "R7RS-small" :arity 1
  :doc "(read-char port) — read one character or EOF. R7RS §6.10.2."
  :example "(read-char (open-input-string \"a\")) => #\\a")
(verb :name "peek-char" :std "R7RS-small" :arity 1
  :doc "(peek-char port) — look at next char without consuming. R7RS §6.10.2."
  :example "(peek-char (open-input-string \"a\")) => #\\a")
(verb :name "write-char" :std "R7RS-small" :arity [1,2]
  :doc "Print a single character. R7RS §6.10.3."
  :example "(write-char #\\!)")
(verb :name "eof-object" :std "R7RS-small" :arity 0
  :doc "Return the EOF object. R7RS §6.10."
  :example "(eof-object)")
(verb :name "eof-object?" :std "R7RS-small" :arity 1
  :doc "#t if arg is the EOF object. R7RS §6.10."
  :example "(eof-object? (eof-object)) => #t")
(verb :name "open-input-string" :std "R7RS-small" :arity 1
  :doc "Open a read-port over a string. R7RS §6.10.2."
  :example "(open-input-string \"hi\")")
(verb :name "open-output-string" :std "R7RS-small" :arity 0
  :doc "Open a write-port. R7RS §6.10.2."
  :example "(open-output-string)")
(verb :name "get-output-string" :std "R7RS-small" :arity 1
  :doc "Extract accumulated string from a write-port. R7RS §6.10.2."
  :example "(let ((p (open-output-string))) (display \"hi\" p) (get-output-string p)) => \"hi\"")
(verb :name "close-port" :std "R7RS-small" :arity 1
  :doc "Close any port. R7RS §6.10."
  :example "(close-port (open-output-string))")
(verb :name "close-input-port" :std "R7RS-small" :arity 1
  :doc "Close a read-port. R7RS §6.10."
  :example "(close-input-port (open-input-string \"x\"))")
(verb :name "close-output-port" :std "R7RS-small" :arity 1
  :doc "Close a write-port. R7RS §6.10."
  :example "(close-output-port (open-output-string))")
(verb :name "input-port?" :std "R7RS-small" :arity 1
  :doc "#t if arg is a read-port. R7RS §6.10."
  :example "(input-port? (open-input-string \"x\")) => #t")
(verb :name "output-port?" :std "R7RS-small" :arity 1
  :doc "#t if arg is a write-port. R7RS §6.10."
  :example "(output-port? (open-output-string)) => #t")
(verb :name "port?" :std "R7RS-small" :arity 1
  :doc "#t if arg is any port. R7RS §6.10."
  :example "(port? (open-input-string \"x\")) => #t")
(verb :name "with-output-to-string" :std "R7RS-small" :arity 1
  :doc "(with-output-to-string thunk) — capture stdout as a string. SRFI-6/R7RS §6.10.3."
  :example "(with-output-to-string (lambda () (display \"hi\"))) => \"hi\"")
(verb :name "with-input-from-string" :std "R7RS-small" :arity 2
  :doc "(with-input-from-string s thunk) — pass a string-input-port to thunk. R7RS §6.10.2."
  :example "(with-input-from-string \"hi\" (lambda (p) (read-line p))) => \"hi\"")
(verb :name "make-bytevector" :std "R7RS-small" :arity [1,2]
  :doc "(make-bytevector k [fill]) — new bytevector. R7RS §6.9."
  :example "(make-bytevector 3 0) => #u8(0 0 0)")
(verb :name "bytevector" :std "R7RS-small" :arity [0,null]
  :doc "Build a bytevector from byte arguments. R7RS §6.9."
  :example "(bytevector 1 2 3) => #u8(1 2 3)")
(verb :name "bytevector?" :std "R7RS-small" :arity 1
  :doc "#t if arg is a bytevector. R7RS §6.9."
  :example "(bytevector? #u8(1 2)) => #t")
(verb :name "bytevector-length" :std "R7RS-small" :arity 1
  :doc "Number of bytes. R7RS §6.9."
  :example "(bytevector-length #u8(1 2 3)) => 3")
(verb :name "bytevector-u8-ref" :std "R7RS-small" :arity 2
  :doc "(bytevector-u8-ref bv i) — the i-th byte. R7RS §6.9."
  :example "(bytevector-u8-ref #u8(10 20 30) 1) => 20")
(verb :name "bytevector-u8-set!" :std "R7RS-small" :arity 3
  :doc "(bytevector-u8-set! bv i byte) — mutate. R7RS §6.9."
  :example "(let ((bv (make-bytevector 3 0))) (bytevector-u8-set! bv 0 42) (bytevector-u8-ref bv 0)) => 42")
(verb :name "bytevector-copy" :std "R7RS-small" :arity [1,3]
  :doc "(bytevector-copy bv [start [end]]) — copy a range. R7RS §6.9."
  :example "(bytevector-copy #u8(1 2 3 4) 1 3) => #u8(2 3)")
(verb :name "bytevector-append" :std "R7RS-small" :arity [0,null]
  :doc "Concatenate bytevectors. R7RS §6.9."
  :example "(bytevector-append #u8(1) #u8(2 3)) => #u8(1 2 3)")
(verb :name "utf8->string" :std "R7RS-small" :arity [1,3]
  :doc "(utf8->string bv [start [end]]) — decode UTF-8. R7RS §6.9."
  :example "(utf8->string #u8(72 105)) => \"Hi\"")
(verb :name "string->utf8" :std "R7RS-small" :arity [1,3]
  :doc "(string->utf8 s [start [end]]) — encode UTF-8. R7RS §6.9."
  :example "(string->utf8 \"Hi\") => #u8(72 105)")
(verb :name "vector" :std "R7RS-small" :arity [0,null]
  :doc "Build a vector from element arguments. R7RS §6.8."
  :example "(vector 1 2 3) => #(1 2 3)")
(verb :name "make-vector" :std "R7RS-small" :arity [1,2]
  :doc "(make-vector k [fill]) — new vector of length k. R7RS §6.8."
  :example "(make-vector 3 0) => #(0 0 0)")
(verb :name "vector?" :std "R7RS-small" :arity 1
  :doc "#t if arg is a vector. R7RS §6.8."
  :example "(vector? #(1 2)) => #t")
(verb :name "vector-length" :std "R7RS-small" :arity 1
  :doc "Number of elements. R7RS §6.8."
  :example "(vector-length #(1 2 3)) => 3")
(verb :name "vector-set!" :std "R7RS-small" :arity 3
  :doc "(vector-set! v i x) — mutate slot i. R7RS §6.8."
  :example "(let ((v (vector 1 2 3))) (vector-set! v 0 42) v) => #(42 2 3)")
(verb :name "vector->list" :std "R7RS-small" :arity 1
  :doc "Convert vector to list. R7RS §6.8."
  :example "(vector->list #(1 2 3)) => (1 2 3)")
(verb :name "list->vector" :std "R7RS-small" :arity 1
  :doc "Convert list to vector. R7RS §6.8."
  :example "(list->vector (list 1 2 3)) => #(1 2 3)")
(verb :name "vector-map" :std "R7RS-small" :arity 2
  :doc "(vector-map f v) — map f over the vector. R7RS §6.8."
  :example "(vector-map square #(1 2 3)) => #(1 4 9)")
(verb :name "vector-for-each" :std "R7RS-small" :arity 2
  :doc "(vector-for-each f v) — call f for side-effects. R7RS §6.8."
  :example "(vector-for-each display #(1 2))")
(verb :name "vector-fill!" :std "R7RS-small" :arity 2
  :doc "(vector-fill! v x) — set every slot to x. R7RS §6.8."
  :example "(let ((v (vector 1 2 3))) (vector-fill! v 0) v) => #(0 0 0)")
(verb :name "vector-copy" :std "R7RS-small" :arity [1,3]
  :doc "(vector-copy v [start [end]]) — copy range. R7RS §6.8."
  :example "(vector-copy #(1 2 3 4) 1 3) => #(2 3)")
(verb :name "error" :std "R7RS-small" :arity [1,null]
  :doc "(error msg . irritants) — raise a Scheme error. R7RS §6.11."
  :example "(guard (e (#t (error-object-message e))) (error \"not found\" \"k\")) => \"not found\"")
(verb :name "raise" :std "R7RS-small" :arity 1
  :doc "(raise obj) — raise obj as a condition. R7RS §6.11."
  :example "(guard (e (#t e)) (raise \"boom\")) => \"boom\"")
(verb :name "raise-continuable" :std "R7RS-small" :arity 1
  :doc "(raise-continuable obj) — same as raise (no continuations). R7RS §6.11."
  :example "(guard (e (#t e)) (raise-continuable \"boom\")) => \"boom\"")
(verb :name "error-object?" :std "R7RS-small" :arity 1
  :doc "#t if arg is an error object. R7RS §6.11."
  :example "(guard (e ((error-object? e) #t)) (error \"x\")) => #t")
(verb :name "error-object-message" :std "R7RS-small" :arity 1
  :doc "Extract the message string. R7RS §6.11."
  :example "(guard (e (#t (error-object-message e))) (error \"boom\" 1 2)) => \"boom\"")
(verb :name "error-object-irritants" :std "R7RS-small" :arity 1
  :doc "Extract the irritant list. R7RS §6.11."
  :example "(guard (e (#t (error-object-irritants e))) (error \"boom\" 1 2)) => (1 2)")
(verb :name "_make-record-type" :std "R7RS-small" :arity null
  :doc "")
(verb :name "_make-record" :std "R7RS-small" :arity null
  :doc "")
(verb :name "_record-of-type?" :std "R7RS-small" :arity null
  :doc "")
(verb :name "_record-ref" :std "R7RS-small" :arity null
  :doc "")
(verb :name "_record-set!" :std "R7RS-small" :arity null
  :doc "")
(verb :name "force" :std "R7RS-small" :arity 1
  :doc "Force a promise (evaluate the delayed thunk once, memoize). R7RS §4.2.5."
  :example "(force (delay (+ 1 2))) => 3")
(verb :name "make-promise" :std "R7RS-small" :arity 1
  :doc "(make-promise v) — a pre-forced promise. R7RS §4.2.5."
  :example "(force (make-promise 42)) => 42")
(verb :name "promise?" :std "R7RS-small" :arity 1
  :doc "#t if arg is a promise. R7RS §4.2.5."
  :example "(promise? (delay 3)) => #t")
(verb :name "identity" :std "R7RS-small" :arity 1
  :doc "(identity x) → x. Useful as a default fold seed. SRFI-1."
  :example "(identity 42) => 42")
(verb :name "const" :std "R7RS-small" :arity 1
  :doc "(const x) → a function returning x for any args. Motoi-own."
  :example "((const 7) 1 2 3) => 7")
(verb :name "compose" :std "R7RS-small" :arity [0,null]
  :doc "(compose f g h …) → right-to-left composition. Motoi-own."
  :example "((compose square +) 1 2) => 9")
(verb :name "boolean=?" :std "R7RS-small" :arity [1,null]
  :doc "Boolean equality, pairwise along the whole chain (all #t or all #f). R7RS §6.3."
  :example "(boolean=? #t #t) => #t")
(verb :name "symbol=?" :std "R7RS-small" :arity [1,null]
  :doc "Symbol equality by name, pairwise along the whole chain. R7RS §6.5."
  :example "(symbol=? 'foo 'foo) => #t")
