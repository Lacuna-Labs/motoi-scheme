;; ═══════════════════════════════════════════════════════════════
;; SPEC — SRFI-125: Intermediate Hash Tables
;;
;; Provenance: Taylor Campbell, John Cowan, Will Clinger
;; Source:     https://srfi.schemers.org/srfi-125/
;;
;; This is gate #2 of the 5-point part gate (CLAUDE.md): the part's
;; spec kept ALONGSIDE the part. Every record below is derived from
;; the authored META in lib/std/ — nothing invented. Generated by
;; scratch/gen-std-specs.mjs; edit the part META, then regenerate.
;; ═══════════════════════════════════════════════════════════════

(part
  :std "SRFI-125"
  :title "SRFI-125: Intermediate Hash Tables"
  :provenance "Taylor Campbell, John Cowan, Will Clinger"
  :url "https://srfi.schemers.org/srfi-125/"
  :mode "lazy"
  :verb-count 20
  :note "Lazy part. Supersedes SRFI-69 as the R7RS-large-track hash-table selection. hash-table->alist returns two-element lists (Motoi has no dotted pairs) — see broken-examples.")

(verb :name "make-hash-table" :std "SRFI-125" :arity 0
  :doc "Make a new empty hash table. SRFI-125."
  :example "(make-hash-table)")
(verb :name "hash-table" :std "SRFI-125" :arity [0,null]
  :doc "(hash-table key1 value1 key2 value2 ...) — construct a hash table from alternating key/value arguments. SRFI-125 (Motoi omits the comparator argument; odd argument count is an error)."
  :example "(hash-table 'a 1 'b 2)")
(verb :name "hash-table?" :std "SRFI-125" :arity 1
  :doc "#t if arg is a hash table. SRFI-125."
  :example "(hash-table? (make-hash-table)) => #t")
(verb :name "hash-table-set!" :std "SRFI-125" :arity 3
  :doc "(hash-table-set! h k v) — insert or update. SRFI-125."
  :example "(let ((h (make-hash-table))) (hash-table-set! h \"k\" 42) (hash-table-ref/default h \"k\" 0)) => 42")
(verb :name "hash-table-ref" :std "SRFI-125" :arity [2,4]
  :doc "(hash-table-ref h k [failure [success]]) — read; failure is a thunk called when missing (error if omitted), success transforms the found value. SRFI-125."
  :example "(hash-table-ref (hash-table \"k\" 42) \"k\" (lambda () 0)) => 42")
(verb :name "hash-table-ref/default" :std "SRFI-125" :arity 3
  :doc "(hash-table-ref/default h k default) — read, default if missing. SRFI-125."
  :example "(hash-table-ref/default (hash-table \"k\" 42) \"k\" 0) => 42")
(verb :name "hash-table-delete!" :std "SRFI-125" :arity 2
  :doc "(hash-table-delete! h k) — remove entry. SRFI-125."
  :example "(let ((h (hash-table \"k\" 1))) (hash-table-delete! h \"k\") (hash-table-size h)) => 0")
(verb :name "hash-table-contains?" :std "SRFI-125" :arity 2
  :doc "(hash-table-contains? h k) — #t if k is bound. SRFI-125 (replaces the SRFI-69 name hash-table-exists?)."
  :example "(hash-table-contains? (hash-table \"k\" 1) \"k\") => #t")
(verb :name "hash-table-keys" :std "SRFI-125" :arity 1
  :doc "List of all keys in a hash table. SRFI-125."
  :example "(hash-table-keys (hash-table \"a\" 1 \"b\" 2)) => (\"a\" \"b\")")
(verb :name "hash-table-values" :std "SRFI-125" :arity 1
  :doc "List of all values in a hash table. SRFI-125."
  :example "(hash-table-values (hash-table \"a\" 1 \"b\" 2)) => (1 2)")
(verb :name "hash-table-size" :std "SRFI-125" :arity 1
  :doc "Number of entries in a hash table. SRFI-125."
  :example "(hash-table-size (hash-table \"a\" 1 \"b\" 2)) => 2")
(verb :name "hash-table-clear!" :std "SRFI-125" :arity 1
  :doc "Remove all entries. SRFI-125."
  :example "(let ((h (hash-table \"a\" 1))) (hash-table-clear! h) (hash-table-size h)) => 0")
(verb :name "hash-table-update!" :std "SRFI-125" :arity [3,5]
  :doc "(hash-table-update! h k updater [failure [success]]) — apply updater; failure is a thunk for the missing-key value (error if omitted). SRFI-125."
  :example "(let ((h (hash-table \"k\" 1))) (hash-table-update! h \"k\" (lambda (v) (+ v 1)) (lambda () 0)) (hash-table-ref/default h \"k\" 0)) => 2")
(verb :name "hash-table-update!/default" :std "SRFI-125" :arity 4
  :doc "(hash-table-update!/default h k proc default) — update; default is a plain value. SRFI-125."
  :example "(let ((h (make-hash-table))) (hash-table-update!/default h \"k\" (lambda (v) (+ v 1)) 0) (hash-table-ref/default h \"k\" 0)) => 1")
(verb :name "hash-table-fold" :std "SRFI-125" :arity 3
  :doc "(hash-table-fold h f seed) — left fold over entries. SRFI-125."
  :example "(hash-table-fold (hash-table \"a\" 1 \"b\" 2) (lambda (k v acc) (+ acc v)) 0) => 3")
(verb :name "hash-table-walk" :std "SRFI-125" :arity 2
  :doc "(hash-table-walk h proc) — call (proc key value) on every entry for side effect (table-first order). SRFI-125."
  :example "(hash-table-walk (hash-table \"a\" 1) (lambda (k v) (display v)))")
(verb :name "hash-table-for-each" :std "SRFI-125" :arity 2
  :doc "(hash-table-for-each proc h) — like hash-table-walk but proc-first (R7RS-large order). SRFI-125."
  :example "(hash-table-for-each (lambda (k v) (display v)) (hash-table \"a\" 1))")
(verb :name "hash-table-copy" :std "SRFI-125" :arity [1,2]
  :doc "(hash-table-copy h [mutable]) — new hash table with the same associations (mutable arg accepted and ignored). SRFI-125."
  :example "(hash-table-size (hash-table-copy (hash-table \"a\" 1))) => 1")
(verb :name "hash-table->alist" :std "SRFI-125" :arity 1
  :doc "Convert a hash table to an association list. SRFI-125."
  :example "(hash-table->alist (hash-table \"a\" 1 \"b\" 2)) => ((\"a\" 1) (\"b\" 2))")
(verb :name "alist->hash-table" :std "SRFI-125" :arity 1
  :doc "Convert an association list to a hash table. SRFI-125."
  :example "(alist->hash-table (list (list \"a\" 1)))")
