;; ═══════════════════════════════════════════════════════════════
;; SPEC — SRFI-48: Intermediate Format Strings
;;
;; Provenance: Kenneth A Dickey
;; Source:     https://srfi.schemers.org/srfi-48/
;;
;; This is gate #2 of the 5-point part gate (CLAUDE.md): the part's
;; spec kept ALONGSIDE the part.
;;
;; HONESTY NOTE, 2026-08-04. The SRFI-48 reference text is NOT vendored
;; into this repo. The directive table below records what the Motoi
;; implementation DOES, and marks each directive with how it was
;; established. `:verified "execution"` means it was run and its output
;; checked. `:verified "unimplemented"` means the implementation RAISES
;; on it rather than guessing — those four are the ones whose SRFI-48
;; semantics were not settled here, and they are open work, not silent
;; gaps. Nothing in this file is asserted from memory alone as though it
;; had been checked.
;; ═══════════════════════════════════════════════════════════════

(part
  :std "SRFI-48"
  :title "SRFI-48: Intermediate Format Strings"
  :provenance "Kenneth A Dickey"
  :url "https://srfi.schemers.org/srfi-48/"
  :mode "lazy"
  :verb-count 1
  :status "partial — 4 directives raise as unimplemented; see :caveats"
  :note "R7RS-small has no format, so per the conformance ladder SRFI-48 is the rung. SRFI-48 is a strict superset of SRFI-28: (format fmt arg ...) is the string-destination shorthand and keeps working. Rendering for ~a and ~s is delegated to the language's own display/write through a string port — there is no second printer inside format.")

(verb :name "format" :std "SRFI-48" :arity "2+"
  :signature "(format destination format-string arg ...) -> string | unspecified"
  :doc "(format dest fmt arg ...) — dest #f returns a string, #t writes to the current output port, a port writes there. (format fmt arg ...) is the SRFI-28 shorthand for the #f case."
  :example "(format #f \"~a and ~s\" \"x\" \"x\") => \"x and \\\"x\\\"\"")

;; ── the directive table ────────────────────────────────────────
;; Every row below was exercised on 2026-08-04 unless marked otherwise.

(directive :name "~a" :means "display the next argument"
  :verified "execution" :example "(format #f \"~a\" (list 1 \"x\")) => \"(1 x)\"")
(directive :name "~s" :means "write the next argument"
  :verified "execution" :example "(format #f \"~s\" \"q\") => \"\\\"q\\\"\"")
(directive :name "~d" :means "the next argument in base 10"
  :verified "execution" :example "(format #f \"~d\" 99) => \"99\"")
(directive :name "~b" :means "the next argument in base 2"
  :verified "execution" :example "(format #f \"~b\" 5) => \"101\"")
(directive :name "~o" :means "the next argument in base 8"
  :verified "execution" :example "(format #f \"~o\" 8) => \"10\"")
(directive :name "~x" :means "the next argument in base 16"
  :verified "execution" :example "(format #f \"~x\" 255) => \"ff\"")
(directive :name "~c" :means "the next argument as a character"
  :verified "execution" :example "(format #f \"~c\" #\\z) => \"z\"")
(directive :name "~[w[,d]]f" :means "a real number, optional width and decimal places"
  :verified "execution" :example "(format #f \"~5,2f\" 3.14159) => \" 3.14\"")
(directive :name "~%" :means "newline"
  :verified "execution" :example "(format #f \"a~%b\") => \"a\\nb\"")
(directive :name "~n" :means "newline (synonym of ~%)"
  :verified "execution" :example "(format #f \"a~nb\") => \"a\\nb\"")
(directive :name "~~" :means "a literal tilde"
  :verified "execution" :example "(format #f \"~~\") => \"~\"")
(directive :name "~&" :means "freshline — a newline unless already at column 0"
  :verified "execution"
  :caveat "PARTIAL. It can only see what THIS format call has built so far; it cannot inspect the column a port was already sitting at. A ~& at the very start of a format string writing to a mid-line port will not break the line."
  :example "(format #f \"x~&y\") => \"x\\ny\"")
(directive :name "~_" :means "a space"
  :verified "execution" :example "(format #f \"a~_b\") => \"a b\"")
(directive :name "~?" :means "indirection — next argument is a format string, the one after it a list of its arguments"
  :verified "execution" :example "(format #f \"~?\" \"sub ~a ~a\" (list 1 2)) => \"sub 1 2\"")
(directive :name "~k" :means "indirection (synonym of ~?)"
  :verified "execution" :example "(format #f \"~k\" \"~a\" (list 7)) => \"7\"")

;; ── raised, not guessed ────────────────────────────────────────
(directive :name "~w" :means "shared-structure write"
  :verified "unimplemented" :status "needs-alfred"
  :note "Raises a named error. No cart calls it. Implementing it requires the SRFI-48 text, which is not vendored here.")
(directive :name "~y" :means "pretty print"
  :verified "unimplemented" :status "needs-alfred")
(directive :name "~h" :means "help — describe the directives"
  :verified "unimplemented" :status "needs-alfred")
(directive :name "~t" :means "tab"
  :verified "unimplemented" :status "needs-alfred"
  :note "Listed here because it is a plausible directive to reach for. Whether SRFI-48 defines ~t at all was NOT confirmed; it raises rather than doing something approximate.")

;; ── error behaviour (this is the point) ────────────────────────
(errors
  :doctrine "An unknown or unimplemented directive RAISES. It is never passed through as literal text."
  :why "Passing it through yields output that is still string-shaped, so nothing fails and the wrong string travels — the silent-wrong class that a run-only gate cannot catch."
  :verified "execution"
  :cases (
    "(format #f \"~q\" 1)      -> error: format: unknown directive ~q"
    "(format #f \"~a ~a\" 1)   -> error: format: ~a ran out of arguments"
    "(format #f \"~w\" 1)      -> error: format: ~w (shared-structure write) is not implemented"
    "(format #f \"trailing ~\") -> error: format: the format string ends in a lone ~"
    "(format 99 \"x\")          -> error: format: the destination must be #f, #t, or a port"))

;; ── the numeric tower ──────────────────────────────────────────
(note
  :subject "exact rationals"
  :verified "execution"
  :claim "(format #f \"rational ~a\" (/ 1 3)) => \"rational 1/3\""
  :why "~a renders by calling the language's display, so every member of the numeric tower prints as the language prints it. A private printer inside format is how an exact rational becomes [object Object].")
