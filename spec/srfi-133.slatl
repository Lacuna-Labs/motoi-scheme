;; ═══════════════════════════════════════════════════════════════

(part
  :std "SRFI-133"
  :title "SRFI-133: Vector Library (R7RS-compatible)"
  :provenance "John Cowan, Will Clinger"
  :url "https://srfi.schemers.org/srfi-133/"
  :mode "lazy"
  :verb-count 27
  :note "Lazy part. Only the vector verbs NOT already in R7RS §6.8 live here — R7RS-small stays the authority for vector-map, vector-copy!, vector-append and the rest. Note vector-fold takes the STATE FIRST, the opposite of SRFI-1 fold.")

(verb :name "vector-unfold" :std "SRFI-133" :arity -1
  :doc "(vector-unfold f length seed ...) — build a vector left to right; f answers the element and the next seeds. SRFI-133."
  :example "(vector-unfold (lambda (i) (* i i)) 4) => #(0 1 4 9)")
(verb :name "vector-unfold-right" :std "SRFI-133" :arity -1
  :doc "(vector-unfold-right f length seed ...) — build a vector right to left. SRFI-133."
  :example "(vector-unfold-right (lambda (i) i) 4) => #(0 1 2 3)")
(verb :name "vector-reverse-copy" :std "SRFI-133" :arity -1
  :doc "(vector-reverse-copy vec [start [end]]) — a fresh vector holding the range backwards. SRFI-133."
  :example "(vector-reverse-copy '#(1 2 3)) => #(3 2 1)")
(verb :name "vector-concatenate" :std "SRFI-133" :arity 1
  :doc "(vector-concatenate list-of-vectors) — append the vectors in a LIST. SRFI-133."
  :example "(vector-concatenate (list '#(1) '#(2 3))) => #(1 2 3)")
(verb :name "vector-append-subvectors" :std "SRFI-133" :arity -1
  :doc "(vector-append-subvectors [vec start end] ...) — append slices, three arguments per group. SRFI-133."
  :example "(vector-append-subvectors '#(1 2 3) 0 2 '#(4 5) 1 2) => #(1 2 5)")
(verb :name "vector-empty?" :std "SRFI-133" :arity 1
  :doc "(vector-empty? vec) — #t when the vector has no elements. SRFI-133."
  :example "(vector-empty? '#()) => #t")
(verb :name "vector=" :std "SRFI-133" :arity -1
  :doc "(vector= elt=? vec ...) — compare vectors elementwise; #t for fewer than two vectors. SRFI-133."
  :example "(vector= eqv? '#(1 2) '#(1 2)) => #t")
(verb :name "vector-fold" :std "SRFI-133" :arity -1
  :doc "(vector-fold kons knil vec ...) — fold left; kons takes the STATE FIRST, unlike SRFI-1 fold. SRFI-133."
  :example "(vector-fold (lambda (s x) (+ s x)) 0 '#(1 2 3)) => 6")
(verb :name "vector-fold-right" :std "SRFI-133" :arity -1
  :doc "(vector-fold-right kons knil vec ...) — fold right; state first. SRFI-133."
  :example "(vector-fold-right (lambda (s x) (cons x s)) '() '#(1 2 3)) => (1 2 3)")
(verb :name "vector-count" :std "SRFI-133" :arity -1
  :doc "(vector-count pred vec ...) — how many positions satisfy the predicate. SRFI-133."
  :example "(vector-count even? '#(1 2 3 4)) => 2")
(verb :name "vector-cumulate" :std "SRFI-133" :arity 3
  :doc "(vector-cumulate f knil vec) — the running states of a fold, as a vector. SRFI-133."
  :example "(vector-cumulate + 0 '#(1 2 3)) => #(1 3 6)")
(verb :name "vector-index" :std "SRFI-133" :arity -1
  :doc "(vector-index pred vec ...) — index of the first satisfying position, else #f. SRFI-133."
  :example "(vector-index even? '#(1 3 4)) => 2")
(verb :name "vector-index-right" :std "SRFI-133" :arity -1
  :doc "(vector-index-right pred vec ...) — index of the LAST satisfying position, else #f. SRFI-133."
  :example "(vector-index-right even? '#(2 3 4)) => 2")
(verb :name "vector-skip" :std "SRFI-133" :arity -1
  :doc "(vector-skip pred vec ...) — index of the first position that does NOT satisfy the predicate. SRFI-133."
  :example "(vector-skip even? '#(2 4 5)) => 2")
(verb :name "vector-skip-right" :std "SRFI-133" :arity -1
  :doc "(vector-skip-right pred vec ...) — index of the last position that does NOT satisfy the predicate. SRFI-133."
  :example "(vector-skip-right even? '#(1 2 4)) => 0")
(verb :name "vector-binary-search" :std "SRFI-133" :arity 3
  :doc "(vector-binary-search vec value cmp) — index of value in a sorted vector, else #f; cmp answers negative/zero/positive. SRFI-133."
  :example "(vector-binary-search '#(1 3 5) 3 -) => 1")
(verb :name "vector-any" :std "SRFI-133" :arity -1
  :doc "(vector-any pred vec ...) — the first true value the predicate produced, else #f. SRFI-133."
  :example "(vector-any even? '#(1 2 3)) => #t")
(verb :name "vector-every" :std "SRFI-133" :arity -1
  :doc "(vector-every pred vec ...) — the last value if every position satisfies the predicate, else #f. SRFI-133."
  :example "(vector-every even? '#(2 4)) => #t")
(verb :name "vector-partition" :std "SRFI-133" :arity 2
  :doc "(vector-partition pred vec) — two values: the regrouped vector and the count that satisfied. SRFI-133."
  :example "(vector-partition even? '#(1 2 3 4))")
(verb :name "vector-swap!" :std "SRFI-133" :arity 3
  :doc "(vector-swap! vec i j) — exchange two elements in place. SRFI-133."
  :example "(vector-swap! (vector 1 2) 0 1)")
(verb :name "vector-reverse!" :std "SRFI-133" :arity -1
  :doc "(vector-reverse! vec [start [end]]) — reverse a range in place. SRFI-133."
  :example "(vector-reverse! (vector 1 2 3))")
(verb :name "vector-reverse-copy!" :std "SRFI-133" :arity -1
  :doc "(vector-reverse-copy! to at from [start [end]]) — copy a range backwards into another vector. SRFI-133."
  :example "(vector-reverse-copy! (make-vector 3 0) 0 (vector 1 2 3))")
(verb :name "vector-unfold!" :std "SRFI-133" :arity -1
  :doc "(vector-unfold! f vec start end seed ...) — fill a range in place, left to right. SRFI-133."
  :example "(vector-unfold! (lambda (i) i) (make-vector 3 0) 0 3)")
(verb :name "vector-unfold-right!" :std "SRFI-133" :arity -1
  :doc "(vector-unfold-right! f vec start end seed ...) — fill a range in place, right to left. SRFI-133."
  :example "(vector-unfold-right! (lambda (i) i) (make-vector 3 0) 0 3)")
(verb :name "vector-map!" :std "SRFI-133" :arity -1
  :doc "(vector-map! f vec1 vec2 ...) — like vector-map, but writes the results back into vec1. SRFI-133."
  :example "(vector-map! (lambda (x) (* x 2)) (vector 1 2 3))")
(verb :name "reverse-vector->list" :std "SRFI-133" :arity -1
  :doc "(reverse-vector->list vec [start [end]]) — the range as a list, backwards. SRFI-133."
  :example "(reverse-vector->list '#(1 2 3)) => (3 2 1)")
(verb :name "reverse-list->vector" :std "SRFI-133" :arity 1
  :doc "(reverse-list->vector list) — the list as a vector, backwards. SRFI-133."
  :example "(reverse-list->vector '(1 2 3)) => #(3 2 1)")
