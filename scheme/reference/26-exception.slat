;;; 26-exception.slat — Motoi Scheme Reference · Chapter 26 · library exception
;;;
;;; 10 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.
;;; R7RS §6.11. Wired end-to-end; every code block runs.
;;; 2026-08-02: 5 undocumented verbs added — with-exception-handler,
;;; error-object-type, read-error?, file-error?, last-error. Every example
;;; below was executed against the live engine before its note was written.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library exception — 10 verbs.")

(chapter :number "26" :library "exception" :verb-count 10 :training-eligible #t)

(verb :name "error" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(error message . irritants) -> raises"
  :summary "R7RS §6.11 — raise an error condition with a message and optional extra values."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t 'caught)) (error \"bad\"))" :note "caught.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (error-object-message e))) (error \"nope\" 42))" :note "nope.")
    (:dialect "motoi" :tier "expert"       :code "(define (guarded v) (guard (e (#t (error-object-irritants e))) (if (positive? v) v (error \"not-positive\" v))))\n(guarded -3)" :note "Irritants surface the offending value."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(guard (e (#t 'caught)) (error \"bad-input\" 42))"
     :math-program "(guard (e (#t 'total)) (error \"partial-defined\"))"
     :cs-program "(define (safe-op x) (guard (e (#t 'fallback)) (if (number? x) (* x 2) (error \"need-number\" x))))\n(safe-op 'not-a-num)"
     :problem "Operation must fail loudly with actionable info, not silently return #f."
     :explanation "eng: input validation. math: totality guard on partial function. cs: type-guarded compute."
     :meta "Reach for error and NOT return #f: #f is silently indistinguishable from a valid boolean; error carries message + irritants.")
    (:eng "Named errors point at the offending value." :math "Distinguish 'undefined' from a valid falsy value." :cs "Contract-violation signal."))
  :row-3-dimension (
    (:setup "Named signal with payload."
     :rungs (
       (:domain "engineering"  :code "(guard (e (#t 'caught)) (let ((v -1)) (error \"bad-input\" v)))")
       (:domain "mathematics"  :code "(guard (e (#t 'caught)) (let ((domain 'real)) (error \"partial-defined\" domain)))")
       (:domain "cs / dispatch" :code "(guard (e (#t 'total)) (error \"partial-defined\"))"))
     :explanation "Direct, math-domain, parsed."
     :meta "Named signal with payload is universal.")
    (:eng "Every named error is an assertion of intent." :math "Partial function marker." :cs "Exception-condition primitive."))
  :row-4-proof (
    (:eng-program "(guard (e (#t #t)) (error \"nope\") #f)"
     :math-program "(guard (e (#t (string? (error-object-message e)))) (error \"msg\") #f)"
     :cs-program "(guard (e (#t (equal? (error-object-irritants e) (list 1 2)))) (error \"m\" 1 2) #f)"
     :claim "error unconditionally raises a condition carrying message + irritants."
     :invariant "∀ msg irritants. error(msg, irritants) raises; handler gets an object with message = msg, irritants = list-of-args"
     :meta "Pattern: exception raise with structured payload.")
    (:eng "Handler can inspect message + irritants." :math "Condition-object carries the partial-function witness." :cs "Standard R7RS error contract."))
  :row-5-emergence (
    (:eng-composition "(define (safe-div a b) (guard (e (#t 'div-by-zero)) (if (zero? b) (error \"div-by-zero\" a) (/ a b))))\n(safe-div 10 0)"
     :math-composition "(define (bounded x lo hi) (guard (e (#t 'out-of-range)) (if (<= lo x hi) x (error \"out-of-range\" x lo hi))))\n(bounded 5 0 3)"
     :cs-composition "(define (validate v pred) (guard (e (#t (list :error (error-object-message e)))) (if (pred v) v (error \"invalid\" v))))\n(validate -1 positive?)"
     :base "error raises a structured condition."
     :emergent "Compositions: eng safe-div, math bounded-range, cs validate wrapper."
     :meta "Family: guard + fallback.")
    (:eng "Safe-div is one of the classic guarded operations." :math "Bounded range is partial function with error signal." :cs "Validate wraps predicate with structured error."))
)

(verb :name "raise" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(raise obj) -> raises"
  :summary "R7RS §6.11 — raise obj as a condition (non-error objects are wrapped)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t 'caught)) (raise 'error))" :note "caught.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t e)) (raise 'my-signal))" :note "Handler receives the raised value.")
    (:dialect "motoi" :tier "expert"       :code "(define (typed-raise kind data) (guard (e (#t e)) (raise (list :kind kind :data data))))\n(typed-raise 'over-budget 500)" :note "Raise a tagged data record."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(guard (e (#t 'caught)) (raise 'user-cancel))"
     :math-program "(guard (e (#t e)) (raise 'partial-fn-token))"
     :cs-program "(define (safe-signal v) (guard (e (#t (equal? e v))) (raise v)))\n(safe-signal 'ping)"
     :problem "Non-error signal — user cancel, custom stop token, protocol message — needs the exception channel."
     :explanation "eng: cancel signal. math: partial-fn token. cs: any Scheme value can be raised."
     :meta "Reach for raise and NOT error: raise ships any value; error is specialized for error-message + irritants.")
    (:eng "Any Scheme value can travel the exception channel." :math "Signal is a value, not a text-string." :cs "Generalized signal primitive."))
  :row-3-dimension (
    (:setup "Value-to-handler channel."
     :rungs (
       (:domain "engineering"  :code "(guard (e (#t e)) (raise 'partial-fn-token))")
       (:domain "mathematics"  :code "(guard (e (#t e)) (raise 'partial-fn-token))")
       (:domain "cs / dispatch" :code "(guard (e (#t e)) (raise 'partial-fn-token))"))
     :explanation "Direct, math-domain witness, structured signal."
     :meta "Structured signal transport.")
    (:eng "Cancel signals travel to the enclosing handler." :math "Partial-function witness reaches the guard." :cs "Signal primitive routes across the stack."))
  :row-4-proof (
    (:eng-program "(guard (e (#t (eq? e 'x))) (raise 'x))"
     :math-program "(guard (e (#t (equal? e (list 1 2)))) (raise (list 1 2)))"
     :cs-program "(guard (e (#t #t)) (raise 42) #f)"
     :claim "raise sends the value verbatim to the enclosing handler; body after raise does not execute."
     :invariant "∀ v. raise(v) → handler receives v ∧ code after raise is unreachable"
     :meta "Pattern: transfer control with value.")
    (:eng "Value delivery is faithful." :math "Escape from body to handler is total." :cs "Non-local exit with payload."))
  :row-5-emergence (
    (:eng-composition "(define (cancel-flow steps) (guard (e (#t 'cancelled)) (for-each (lambda (s) (if (eq? s 'stop) (raise 'user-cancel) s)) steps) 'complete))\n(cancel-flow (list 'a 'b 'stop 'c))"
     :math-composition "(define (early-return xs f) (guard (v (#t v)) (for-each (lambda (x) (let ((r (f x))) (if r (raise r) 'continue))) xs) #f))\n(early-return (list 1 2 3) (lambda (x) (if (> x 1) x #f)))"
     :cs-composition "(define (handle-signal fn on-signal) (guard (e (#t (on-signal e))) (fn)))\n(handle-signal (lambda () (raise 'ping)) (lambda (s) s))"
     :base "raise transports a value to the handler."
     :emergent "Compositions: eng cancellable flow, math early-return-with-witness, cs signal handler."
     :meta "Family: non-local control with payload.")
    (:eng "Cancellable flow leaves ops in a clean state." :math "Early return delivers the found witness." :cs "Signal + handler is the pub-sub of control flow."))
)

(verb :name "raise-continuable" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(raise-continuable obj) -> raises"
  :summary "R7RS §6.11 — raise obj, and let the handler's return value come BACK to the raise point so the body carries on."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-exception-handler (lambda (e) 'caught) (lambda () (raise-continuable 'x)))" :note "caught — the handler's value is the value of the raise, which here is the last thing the thunk does, so it is the answer.")
    (:dialect "motoi" :tier "intermediate" :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))" :note "signal — a handler that returns its argument makes raise-continuable an identity round-trip.")
    (:dialect "motoi" :tier "expert"       :code "(with-exception-handler (lambda (e) 42) (lambda () (list 'before (raise-continuable 'x) 'after)))" :note "(before 42 after) — the handler's 42 lands where the raise stood and the list finishes building. Nothing is unwound. That is what `continuable` means, and it is exactly what plain raise will NOT do."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22; prose corrected 2026-08-03 when raise became non-continuable and the two verbs stopped being aliases"
  :row-2-audit (
    (:eng-program "(with-exception-handler (lambda (e) 'caught) (lambda () (raise-continuable 'x)))"
     :math-program "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))"
     :cs-program "(define (compat-signal v) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable v))))\n(compat-signal 'ping)"
     :problem "The body has hit a condition it can be TOLD how to get past — a missing default, an unreadable field — and wants to keep going from where it stood, not unwind."
     :explanation "eng: ask the handler for a substitute and resume. math: supply the value at a point where the function is otherwise partial. cs: the handler is a resumption oracle, not an exit."
     :meta "Reach for raise-continuable and NOT raise when the raise point wants an ANSWER back. Reach for raise when the condition is fatal to the body. Reach for guard when the CALLER wants the answer instead.")
    (:eng "The handler repairs and the body resumes." :math "Fills in a partial function at the point of use." :cs "Resumption, not unwinding."))
  :row-3-dimension (
    (:setup "R7RS-compat signal."
     :rungs (
       (:domain "engineering"  :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))")
       (:domain "mathematics"  :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))")
       (:domain "cs / dispatch" :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))"))
     :explanation "Direct, math-domain, structured."
     :meta "The value travels to the handler and the handler's answer travels back.")
    (:eng "Round trip, not one way." :math "The handler completes a partial function." :cs "Resumption primitive."))
  :row-4-proof (
    (:eng-program "(with-exception-handler (lambda (e) (eq? e 'x)) (lambda () (raise-continuable 'x)))"
     :math-program "(with-exception-handler (lambda (e) (equal? e (list 1))) (lambda () (raise-continuable (list 1))))"
     :cs-program "(with-exception-handler (lambda (e) #t) (lambda () (raise-continuable 'x) #f))"
     :claim "The handler's return value becomes the value of the raise-continuable expression, and the thunk then runs on to its end — so the cs-program answers #f, not #t: the handler's #t is discarded as the value of a non-final expression."
     :invariant "∀ v h. with-exception-handler(h, λ().raise-continuable(v)) = h(v), and any thunk body after the raise still executes"
     :meta "Pattern: resume with a substituted value.")
    (:eng "The handler's answer is consumed at the raise point." :math "The raise expression is total once a handler is installed." :cs "Control returns; the stack is never unwound."))
  :row-5-emergence (
    (:eng-composition "(define (portable-signal v) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable v))))\n(portable-signal 'x)"
     :math-composition "(define (compat-witness domain) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable domain))))\n(compat-witness 'partial-fn)"
     :cs-composition "(define (dual-raise v) (list (guard (e (#t e)) (raise v)) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable v)))))\n(dual-raise 'x)"
     :base "raise-continuable hands the value out and takes an answer back."
     :emergent "Compositions: eng portable signal, math compat witness, cs dual-raise — the same value reaches both a guard on raise and a handler on raise-continuable."
     :meta "Family: resumable signal.")
    (:eng "Portable code runs on Motoi without change." :math "Semantics carry across." :cs "Two verbs, two control shapes, one payload."))
)

(verb :name "error-object-message" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(error-object-message e) -> string"
  :summary "Extract the error message string from a condition object."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t (error-object-message e))) (error \"hi\"))" :note "hi.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (string-length (error-object-message e)))) (error \"12345\"))" :note "5.")
    (:dialect "motoi" :tier "expert"       :code "(define (fmt-error thunk) (guard (e (#t (string-append \"ERR: \" (error-object-message e)))) (thunk)))\n(fmt-error (lambda () (error \"broke\")))" :note "Named formatter."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(guard (e (#t (error-object-message e))) (error \"bad\"))"
     :math-program "(guard (e (#t (string? (error-object-message e)))) (error \"x\"))"
     :cs-program "(define (safe-msg thunk default) (guard (e (#t (or (error-object-message e) default))) (thunk)))\n(safe-msg (lambda () (error \"real\")) \"fallback\")"
     :problem "Handler needs the human-readable message from the raised condition."
     :explanation "eng: extract message. math: string projection. cs: fallback default."
     :meta "Reach for error-object-message and NOT (car e): the structure of a condition object is opaque; the extractor is the contract.")
    (:eng "Extractor is the durable contract." :math "String-valued projection." :cs "Well-typed field access."))
  :row-3-dimension (
    (:setup "Field extraction from a structured value."
     :rungs (
       (:domain "engineering"  :code "(guard (e (#t 'total)) (error \"partial-defined\"))")
       (:domain "mathematics"  :code "(guard (e (#t (string? (error-object-message e)))) (error \"x\"))")
       (:domain "cs / dispatch" :code "(guard (e (#t (string? (error-object-message e)))) (error \"x\"))"))
     :explanation "Direct, canonicalized, parsed."
     :meta "Well-known field extractor.")
    (:eng "Field access as narrow contract." :math "Projection to string." :cs "Getter for structured field."))
  :row-4-proof (
    (:eng-program "(guard (e (#t (equal? (error-object-message e) \"hi\"))) (error \"hi\"))"
     :math-program "(guard (e (#t (string? (error-object-message e)))) (error \"x\"))"
     :cs-program "(guard (e (#t (string-length (error-object-message e)))) (error \"12345\"))"
     :claim "Returns the message string passed to error, verbatim."
     :invariant "∀ msg irr. error-object-message(handler(error(msg, irr))) = msg"
     :meta "Pattern: faithful field extraction.")
    (:eng "Message survives the exception path unchanged." :math "String → string identity." :cs "Faithful getter."))
  :row-5-emergence (
    (:eng-composition "(define (log-error thunk logger) (guard (e (#t (logger (error-object-message e)))) (thunk)))\n(log-error (lambda () (error \"oops\")) (lambda (m) (list :logged m)))"
     :math-composition "(define (fmt-error thunk fmt) (guard (e (#t (fmt (error-object-message e)))) (thunk)))\n(fmt-error (lambda () (error \"broke\")) (lambda (m) (string-append \"! \" m)))"
     :cs-composition "(define (retry-with-log fn max-retries logger) (let loop ((n 0)) (guard (e (#t (logger (error-object-message e)) (if (< n max-retries) (loop (+ n 1)) 'gave-up))) (fn))))\n(retry-with-log (lambda () 'ok) 3 (lambda (m) m))"
     :base "error-object-message extracts the message."
     :emergent "Compositions: eng log-error, math fmt-error, cs retry-with-log."
     :meta "Family: error observability.")
    (:eng "Log-error is the smallest useful observability adapter." :math "Formatter composes with message extractor." :cs "Retry loop uses message for diagnostics."))
)

(verb :name "error-object-irritants" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(error-object-irritants e) -> list"
  :summary "Extract the irritant list from a condition object."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t (error-object-irritants e))) (error \"bad\" 1 2))" :note "(1 2).")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (length (error-object-irritants e)))) (error \"bad\" 1 2 3))" :note "3.")
    (:dialect "motoi" :tier "expert"       :code "(define (extract-first-irritant thunk) (guard (e (#t (car (error-object-irritants e)))) (thunk)))\n(extract-first-irritant (lambda () (error \"bad\" 42)))" :note "First irritant."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(guard (e (#t (car (error-object-irritants e)))) (error \"bad\" 42))"
     :math-program "(guard (e (#t (length (error-object-irritants e)))) (error \"bad\" 1 2 3))"
     :cs-program "(guard (e (#t (list (error-object-message e) (error-object-irritants e)))) (error \"bad-input\" 'x))"
     :problem "Handler needs the offending values from the raised condition."
     :explanation "eng: extract offender. math: count irritants. cs: message + irritants pair."
     :meta "Reach for error-object-irritants and NOT (cdr e): irritants is the contracted field name; opaque access is more portable.")
    (:eng "Irritants pinpoint the offender." :math "List-valued projection." :cs "Well-typed field access."))
  :row-3-dimension (
    (:setup "Extract the irritant list."
     :rungs (
       (:domain "engineering"  :code "(guard (e (#t 'total)) (error \"partial-defined\"))")
       (:domain "mathematics"  :code "(guard (e (#t (length (error-object-irritants e)))) (error \"bad\" 1 2 3))")
       (:domain "cs / dispatch" :code "(guard (e (#t (length (error-object-irritants e)))) (error \"bad\" 1 2 3))"))
     :explanation "Direct, canonicalized, parsed."
     :meta "Well-known field extractor.")
    (:eng "Field access as narrow contract." :math "Projection to list." :cs "Getter for structured field."))
  :row-4-proof (
    (:eng-program "(guard (e (#t (equal? (error-object-irritants e) (list 1 2)))) (error \"bad\" 1 2))"
     :math-program "(guard (e (#t (list? (error-object-irritants e)))) (error \"x\"))"
     :cs-program "(guard (e (#t (= 3 (length (error-object-irritants e))))) (error \"bad\" 1 2 3))"
     :claim "Returns the irritant list exactly as passed to error."
     :invariant "∀ msg irr. error-object-irritants(handler(error(msg, ...irr))) = irr"
     :meta "Pattern: faithful field extraction.")
    (:eng "Irritant list survives the exception path unchanged." :math "List → list identity." :cs "Faithful getter."))
  :row-5-emergence (
    (:eng-composition "(define (report thunk) (guard (e (#t (list :msg (error-object-message e) :vals (error-object-irritants e)))) (thunk)))\n(report (lambda () (error \"nope\" 1 2)))"
     :math-composition "(define (first-witness thunk) (guard (e (#t (car (error-object-irritants e)))) (thunk)))\n(first-witness (lambda () (error \"partial\" 'x)))"
     :cs-composition "(define (structured-log thunk) (guard (e (#t (list :error (error-object-message e) :context (error-object-irritants e)))) (thunk)))\n(structured-log (lambda () (error \"nope\" 'ctx)))"
     :base "error-object-irritants extracts the payload list."
     :emergent "Compositions: eng report record, math first-witness, cs structured log record."
     :meta "Family: error observability with payload.")
    (:eng "Report record joins message + irritants." :math "First-witness names the partial-function counterexample." :cs "Structured log carries both."))
)

(verb :name "with-exception-handler" :std "R7RS-small" :library "exception" :tier "core" :kind "meta" :signature "(with-exception-handler handler thunk) -> value"
  :summary "R7RS §6.11 — run thunk with handler installed. The handler is called FOR ITS EFFECT; if it returns from a plain raise, a secondary exception is raised."
  :explanation "Two procedures. `thunk` is the work; `handler` is what to DO when the work raises. If the thunk finishes, its value is the value of the whole form and the handler is never called. If the thunk raises — via `error`, `raise`, `escalate`, or a runtime fault like taking the car of the empty list — the handler is called with the raised value. What happens next depends on how the condition was raised, and this is the part to read twice. Under plain `raise` the condition is NON-CONTINUABLE: the handler may act, but it must not simply return. If it returns, a secondary exception is raised in the handler's own dynamic environment, carrying the message `with-exception-handler: the handler returned, but the condition was raised with `raise`, which cannot be continued`. Under `raise-continuable` the handler's return value DOES come back, standing in for the raise expression, and the thunk carries on from there. So a handler has exactly three honest endings: act and re-raise, escape (call an outer continuation, or `emergency-exit`), or serve a `raise-continuable`. Motoi answered the handler's value from `with-exception-handler` until 2026-08-03, which made `raise` indistinguishable from `raise-continuable` and quietly swallowed conditions; it now conforms to R7RS §6.11 and to chibi-scheme. When you want a VALUE out of a failure, the verb is `guard`, not this one."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-exception-handler (lambda (e) 'never-called) (lambda () (* 6 7)))" :note "42 — nothing raised, so the handler was never called and the thunk's own value came back. This is the only case where the answer comes from with-exception-handler itself.")
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t 'caught)) (error \"boom\"))" :note "caught. When what you want is a value instead of the failure, reach for guard. with-exception-handler will not do this job — its handler cannot answer for a plain raise.")
    (:dialect "motoi" :tier "intermediate" :code "(define seen 'not-yet)\n(guard (e (#t #t)) (with-exception-handler (lambda (e) (set! seen (error-object-message e))) (lambda () (error \"boom\"))))\n(display seen)\n(newline)" :note "\"boom\" — the handler DID run, and its effect stuck. Only its return value was refused. The outer guard is there to catch the secondary raise that followed.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (error-object-message e))) (with-exception-handler (lambda (e) 'ignored) (lambda () (error \"boom\"))))" :note "\"with-exception-handler: the handler returned, but the condition was raised with `raise`, which cannot be continued\" — the guard catches the SECONDARY condition, not the original \"boom\". A handler that returns loses the thing it was handed.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (list 'outer e))) (with-exception-handler (lambda (e) (raise (list 'rethrown e))) (lambda () (raise 'first))))" :note "(outer (rethrown first)) — act, then re-raise. This is the everyday correct shape: the handler does its work and hands the condition onward, and the raise travels to the NEXT handler out, never back into its own.")
    (:dialect "motoi" :tier "expert"       :code "(with-exception-handler (lambda (e) 42) (lambda () (list 'before (raise-continuable 'x) 'after)))" :note "(before 42 after) — with raise-continuable the handler's value genuinely does come back, landing where the raise stood, and the thunk finishes building the list. Same handler, same wrapper; only the raising verb changed."))
  :caveats ("The handler's return value is NOT the value of the form. Under plain raise, a handler that returns triggers a secondary exception in the handler's own dynamic environment. Motoi answered the handler's value until 2026-08-03, when raise was made non-continuable per R7RS §6.11; code written against the old reading now raises." "Under raise-continuable the handler's return value IS used — it becomes the value of the raise-continuable expression and the thunk resumes. That is the one case where returning is correct." "To turn a failure into a value, use guard. with-exception-handler is for effects at the raise point: logging, counting, cleanup, translation-and-re-raise." "The handler is NOT called for a thunk that finishes normally, even if the thunk returned #f or an error-looking value. Only a raise reaches it." "Runtime faults raise too — (car '()), (vector-ref v 99) and an unbound symbol all reach the handler, not just explicit calls to error." "A handler that raises escapes to the enclosing handler, so an outer handler or guard is the only thing that will catch it.")
  :usecases ("Logging or counting a failure at the point it happens, then re-raising it unchanged." "Translating a low-level condition into a domain one before letting it travel." "Recording cleanup state while the condition is still in flight." "Serving a raise-continuable with a substitute value so the body can resume.")
  :related ("guard" "error" "raise" "raise-continuable" "escalate" "error-object-message" "error-object-irritants" "error-object-type")
  :learn (:concept "An exception handler is something you DO at the moment of failure, not something that answers for it. Answering is guard's job; only raise-continuable lets a handler answer." :prerequisites ("lambda" "error" "raise" "guard") :progression "Start by watching a handler run for its effect and then hit the secondary raise; then write the act-and-re-raise shape; then compare against guard, which returns a value; then meet raise-continuable, the one raise whose handler may return.")
  :provenance "R7RS §6.11; implementation lib/base/r7rs-small.js. Record added 2026-08-02 documenting the handler's return value as the form's value; rewritten 2026-08-03 when raise was made non-continuable and that reading became false. Every example below was executed against the live engine before its note was written."
  :row-2-audit (
    (:eng-program "(define (load-config raw)\n  (guard (e (#t (list 'defaults)))\n    (if (string? raw) (list 'parsed raw) (error \"config is not text\" raw))))\n(display (list (load-config \"depth=3\") (load-config 42)))\n(newline)"
     :math-program "(define (safe-recip x)\n  (guard (e (#t 'undefined)) (if (zero? x) (error \"no reciprocal of zero\") (/ 1 x))))\n(display (map safe-recip (list 4 0 -2)))\n(newline)"
     :cs-program "(define (audit thunk)\n  (define note 'clean)\n  (guard (e (#t (list note (error-object-message e))))\n    (with-exception-handler (lambda (c) (set! note 'handler-ran) (raise c)) thunk)))\n(display (audit (lambda () (error \"disk full\"))))\n(newline)"
     :problem "A cart reads a config value that may be missing or the wrong shape, and it must still boot — and the operator wants a line in the log saying it degraded. Two different jobs are hiding in one sentence: producing a value despite the failure, and noticing the failure. Candidates: check every field with a predicate first (correct, but the checks outnumber the work and a new field silently escapes them), let it crash (the cart dies on a typo), or split the two jobs — guard produces the value, a handler notices."
     :explanation "eng: guard produces (parsed …) or (defaults) — one value, always. math: reciprocal is undefined at zero, so guard names the gap instead of pretending. cs: the handler is the auditor — it sets a flag and re-raises, and guard outside it decides what the caller sees. The programs print ((parsed depth=3) (defaults)), (1/4 undefined -1/2), and (handler-ran disk full)."
     :meta "Reach for guard and NOT with-exception-handler when you need a VALUE, and reach for with-exception-handler and NOT guard when you need to SEE the failure without changing where it goes. The cs-program is the shape when you need both: handler inside for the effect, guard outside for the answer.")
    (:eng "One boot path, not two: the cart always gets a config, and the flag says which kind." :math "A partial function made total by naming its gap, rather than by returning a number that is not an answer." :cs "The thunk boundary is the try block; guard is the catch; with-exception-handler is the finally-adjacent observer that runs before the stack goes."))
  :row-3-dimension (
    (:setup "Failure passes one point; decide there whether you want to WATCH it, ANSWER it, or SUBSTITUTE for it."
     :rungs (
       (:domain "exception — watch, then let it go" :code "(guard (top (#t 'reported))\n  (with-exception-handler (lambda (e) (display (list 'logging (error-object-message e))) (newline) (raise e))\n    (lambda () (error \"sensor offline\"))))")
       (:domain "a sensor reading with a last-known-good value — answer it" :code "(display (map (lambda (x) (guard (e (#t 'undefined)) (if (negative? x) (error \"outside domain\" x) (sqrt x)))) (list 9 -1 16)))\n(newline)")
       (:domain "a partial function extended by naming the gap — substitute for it" :code "(display (with-exception-handler (lambda (e) (list 'resumed-with e)) (lambda () (raise-continuable 'stage-2))))\n(newline)"))
     :explanation "Three verbs, three control shapes, one payload. Rung 1 prints (logging sensor offline) and then answers reported: the handler observed and re-raised, and guard outside took the outcome. Rung 2 prints (3 undefined 4): guard answers in place of the failure, so map keeps its shape. Rung 3 prints (resumed-with stage-2): the handler's value went BACK to the raise point, because raise-continuable asked for it."
     :meta "The shape is total-by-construction, but who supplies the total is a choice. Observation does not change the outcome; guard replaces the outcome; raise-continuable repairs the computation in place. Picking the wrong one of the three is the most common exception bug there is.")
    (:eng "Put the decision where a reader will find it — at the boundary, not buried at the raise site." :math "Extending a partial function to a total one requires choosing a value for the gap; guard writes that choice at the caller, raise-continuable writes it at the call." :cs "Observe / recover / resume are three distinct primitives in every language that has all three; Scheme just refuses to blur them."))
  :row-4-proof (
    (:eng-program "(display (list 'returns (with-exception-handler (lambda (e) 'H) (lambda () 'BODY))\n                 'raises  (guard (e (#t 'SECONDARY)) (with-exception-handler (lambda (e) 'H) (lambda () (error \"x\") 'BODY)))\n                 'continuable (with-exception-handler (lambda (e) 'H) (lambda () (raise-continuable 'x)))))\n(newline)"
     :math-program "(display (guard (e (#t (string? (error-object-message e)))) (with-exception-handler (lambda (e) 'handler-value) (lambda () (error \"any\")))))\n(newline)"
     :cs-program "(display (with-exception-handler (lambda (e) 'never) (lambda () (+ 1 2))))\n(newline)"
     :claim "H is never the value of the form after a plain raise. The thunk's value comes back when the thunk returns; a secondary condition comes out when the handler returns from a plain raise; only raise-continuable lets H through."
     :invariant "For all handler h, thunk t. with-exception-handler(h,t) = t() when t returns; raises a secondary condition when t raises v with `raise` and h(v) returns; = h(v) when t's last act is raise-continuable(v)"
     :meta "The eng-program is the whole proof in one line: it prints (returns BODY raises SECONDARY continuable H). Same handler, same body expression — the answer is BODY, then SECONDARY, then H, and H appears only in the continuable column. What would falsify it: H in the middle slot, which is exactly what Motoi printed until 2026-08-03. The math-program prints #t, showing the condition the guard receives is a real error object carrying the secondary message; the cs-program prints 3, the untouched thunk."
    )
    (:eng "Three outcomes, each testable; the middle one is the regression this row exists to catch." :math "The relation is a function of (handler, thunk, raising-verb) — drop the third argument and it stops being well-defined." :cs "The unreachable-suffix property is what makes raise a non-local exit rather than a return value; raise-continuable is the deliberate exception."))
  :row-5-emergence (
    (:eng-composition "(define (retry n thunk)\n  (if (= n 0) 'gave-up (guard (e (#t (retry (- n 1) thunk))) (thunk))))\n(define tries 0)\n(display (retry 3 (lambda () (set! tries (+ tries 1)) (if (< tries 3) (error \"flaky\") (list 'ok-after tries)))))\n(newline)"
     :math-composition "(define (first-defined xs f)\n  (if (null? xs) 'none (guard (e (#t (first-defined (cdr xs) f))) (f (car xs)))))\n(display (first-defined (list -4 -1 25) (lambda (x) (if (negative? x) (error \"outside domain\") (sqrt x)))))\n(newline)"
     :cs-composition "(define (with-trace thunk)\n  (define trail '())\n  (define answer (guard (e (#t (list 'stopped (error-object-message e))))\n                   (with-exception-handler (lambda (c) (set! trail (cons (error-object-message c) trail)) (raise c)) thunk)))\n  (list answer (reverse trail)))\n(display (with-trace (lambda () (fold (lambda (stage acc) (stage acc)) 2 (list (lambda (x) (* x 10)) (lambda (x) (if (> x 15) (error \"too big\" x) x)))))))\n(newline)"
     :base "guard turns a raise into a value; with-exception-handler lets you touch the raise on its way past."
     :emergent "eng: a retry loop — the guard clause is the recursive call, so failure is just another iteration; prints (ok-after 3). math: search-until-defined — walk the inputs and stop at the first one the function accepts; prints 5. cs: log-and-rethrow nested inside guard, so the trail records every stage that refused AND the caller still gets one value; prints ((stopped too big) (too big))."
     :meta "The move that generates the first two is putting a RECURSIVE call in the guard clause: failure stops being a dead end and becomes a branch of the control flow. The move that generates the third is NESTING — the handler is inside, close to the raise, where the information still exists; guard is outside, where the caller's contract is. Handler for the effect, guard for the answer, and they compose because they are not the same verb."
    )
    (:eng "The retry counter lives in one place and the flaky operation does not know it is being retried." :math "Search-until-defined is the domain of a partial function computed by trial rather than by predicate." :cs "One guard around the fold beats one guard per stage: the failing stage identifies itself through the message, and the inner handler is what preserved that message."))
)

(verb :name "error-object-type" :std "Motoi" :library "exception" :tier "core" :kind "accessor" :signature "(error-object-type e) -> symbol"
  :summary "The condition's NAME as a symbol — the tag `escalate` put on it, or `error` for a condition that carries no tag. It raises on anything that is not a condition."
  :explanation "The third accessor on a condition, alongside error-object-message and error-object-irritants, and the only one of the three that is not in R7RS-small. It exists because Motoi has `escalate`, which raises a condition under a NAME you choose — (escalate 'out-of-fuel 3) — and something has to read that name back out in the handler. For a condition raised by escalate, error-object-type returns that symbol. For a condition that carries no name — one raised by `error`, or an engine fault like (car '()) — it returns the symbol `error`. And for a value that is not a condition at all it RAISES: (error-object-type 42) reports \"error-object-type: expected a condition, got the number 42\". That last case is the one to keep hold of, because it used to be different. Until 2026-08-02 the verb answered `error` for a plain number, a string, or a symbol you raised yourself, which meant a handler could not tell a real condition from an untyped value that arrived down the same channel. It now refuses instead of guessing. The practical consequence: a handler that may receive a bare raised value should ask error-object? first, because error-object-type will raise on one rather than describe it — and a raise from inside a handler escapes to the enclosing handler."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t (error-object-type e))) (escalate 'over-budget 500))" :note "over-budget — escalate's first argument comes back as the condition's type.")
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t (symbol? (error-object-type e)))) (error \"anything\"))" :note "#t — the answer is always a symbol; a condition from error is typed `error`.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (eq? (error-object-type e) 'outside-domain))) (escalate 'outside-domain -1))" :note "#t — comparing the type with eq? is how a handler decides which condition it is looking at.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (error-object-message e))) (error-object-type 42))" :note "\"error-object-type: expected a condition, got the number 42\" — a number is not a condition, so the verb refuses rather than inventing a type for it.")
    (:dialect "motoi" :tier "expert"       :code "(define (classify thunk)\n  (guard (e (#t (list (error-object-type e) (error-object-irritants e)))) (thunk)))\n(display (list (classify (lambda () (escalate 'out-of-fuel 3))) (classify (lambda () (error \"plain\" 7)))))\n(newline)" :note "((out-of-fuel (3)) (error (7))) — type and irritants together are the whole routable payload of a condition."))
  :caveats ("Motoi-own. R7RS-small has error-object?, error-object-message and error-object-irritants and NO error-object-type; portable code cannot use it." "It is PARTIAL, not total. A value that is not a condition raises: (error-object-type 42) reports \"error-object-type: expected a condition, got the number 42\", and so do a string and a bare symbol. Guard it, or ask error-object? first." "A value raised with (raise 'my-signal) reaches the handler as the bare symbol, not as a condition, so error-object-type raises on it. Only escalate and error produce a condition." "Engine faults — (car '()), an unbound symbol — report type `error`, so they are indistinguishable from an explicit (error \"…\") by type alone." "A raise from inside a handler escapes to the enclosing handler, so an unguarded error-object-type on a non-condition will take your recovery path down with it.")
  :usecases ("Routing a condition raised by escalate to the handler branch that knows about it." "Deciding whether a failure is retryable by comparing its type against a known tag." "Logging the condition's name alongside its message and irritants.")
  :related ("escalate" "error" "error-object?" "error-object-message" "error-object-irritants" "with-exception-handler" "raise")
  :learn (:concept "A condition can carry a NAME as well as a message, and the name is what a handler dispatches on — text is for people, symbols are for code." :prerequisites ("escalate" "with-exception-handler" "eq?") :progression "Raise one named condition with escalate and read its type back, then compare the type with eq? to pick a branch, then build a small table from type to handler.")
  :provenance "Motoi-own; nothing in R7RS-small corresponds. Implementation lib/base/r7rs-small.js:1089 (it fabricated `error` for non-conditions until that was fixed 2026-08-02); re-measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (route thunk)\n  (guard (e (#t (list 'kind (error-object-type e) 'why (error-object-message e)))) (thunk)))\n(display (list (route (lambda () (escalate 'out-of-fuel 3))) (route (lambda () (error \"bad tile\" 9)))))\n(newline)"
     :math-program "(display (guard (e (#t (eq? (error-object-type e) 'outside-domain))) (escalate 'outside-domain -1)))\n(newline)"
     :cs-program "(define (tag-of thunk) (guard (e (#t (error-object-type e))) (thunk)))\n(display (list (tag-of (lambda () (escalate 'timeout))) (tag-of (lambda () (car '())))))\n(newline)"
     :problem "A cart's handler must react differently to running out of fuel than to a bad tile: one refuels and continues, the other stops. Candidates: match on the message string (works until someone rewords the message, and the reword is invisible to the compiler), put a tag in the irritants and dig it out with car (works, but every raise site must agree on the position), or name the condition with escalate and read the name with error-object-type."
     :explanation "eng: two conditions, one handler, routed by name. math: the type is compared with eq?, which is the exact question — is this THE condition called outside-domain. cs: an engine fault comes back tagged `error`, which is the unnamed-condition default, not a name anybody chose."
     :meta "Reach for error-object-type and NOT the message string. A message is prose for a person and is expected to change; a type is a symbol for a program and is expected not to. Routing on prose makes rewording a breaking change.")
    (:eng "The log line carries both: the type for the dashboard to count, the message for the person to read." :math "eq? on an interned symbol is exact equality on the tag set — no substring matching, no near miss." :cs "The `error` answer for (car '()) is the unnamed-condition default: the fault IS a condition, the engine just never named it."))
  :row-3-dimension (
    (:setup "A failure arrives carrying a name you chose in advance, so the code that catches it can decide what it is without reading English."
     :rungs (
       (:domain "exception" :code "(guard (e (#t (error-object-type e))) (escalate 'over-budget 500))")
       (:domain "a labelled fault light on a machine panel" :code "(display (guard (e (#t (error-object-type e))) (escalate 'divide-by-zero)))\n(newline)")
       (:domain "the name of the case in a case analysis" :code "(display (guard (e (#t (symbol? (error-object-type e)))) (error \"anything\")))\n(newline)"))
     :explanation "A panel light says WHICH fault, not how the fault feels; a case analysis names its cases so a proof can refer to them; a typed condition names itself so a handler can refer to it. In all three the name is a small closed vocabulary agreed on ahead of time, and the descriptive text hangs off it rather than replacing it."
     :meta "Naming the case is what makes exhaustiveness a question you can ask. Once the tags are a fixed set, 'did I handle them all' has an answer; when failures are distinguished by prose, it does not.")
    (:eng "A closed tag vocabulary is what lets a dashboard count failures by kind instead of by string." :math "The tag partitions the failures into named cases; the case analysis is over the tags, not the messages." :cs "Same shape as a tagged union / sum type discriminant, or an errno. The tag is the thing you switch on."))
  :row-4-proof (
    (:eng-program "(display (guard (e (#t (eq? 'my-tag (error-object-type e)))) (escalate 'my-tag)))\n(newline)"
     :math-program "(display (list (guard (e (#t (error-object-type e))) (error \"m\")) (guard (x (#t 'raised)) (error-object-type 42)) (guard (x (#t 'raised)) (error-object-type \"s\"))))\n(newline)"
     :cs-program "(display (guard (e (#t (list (error-object? e) (guard (x (#t 'raised)) (error-object-type e))))) (raise 'my-signal)))\n(newline)"
     :claim "escalate's name survives the raise verbatim; an unnamed condition reports `error`; and a value that is not a condition at all is refused rather than described."
     :invariant "For all symbols s. error-object-type(escalate(s, …)) = s; error-object-type(c) = 'error for a condition c carrying no name; and error-object-type(v) raises for every v that is not a condition"
     :meta "Three programs, three clauses of one contract. The first shows the name surviving; the second shows the unnamed default AND, in its second and third slots, the refusal — (error-object-type 42) does not answer, it raises, so the guard reports `raised`. The third is the sharpest: (raise 'my-signal) hands the handler a bare symbol, error-object? says #f, and error-object-type refuses it. That refusal is what makes an eq? test against 'error mean something — before 2026-08-02 the verb fabricated `error` for all three of those, and the test proved nothing. What would falsify the invariant: an escalate whose name came back changed, or an (error-object-type 42) that answered instead of raising."
    )
    (:eng "A verb that refuses the input it cannot describe is a verb whose #t you can act on." :math "Partial function with an explicit domain — conditions — rather than a total one bought by collapsing the complement to a point." :cs "Membership is still error-object?'s question, and asking it first is now load-bearing: error-object-type raises on a non-member instead of answering."))
  :row-5-emergence (
    (:eng-composition "(define (dispatch thunk table)\n  (guard (e (#t (let ((hit (assq (error-object-type e) table))) (if hit ((cdr hit) e) 'unhandled)))) (thunk)))\n(display (dispatch (lambda () (escalate 'out-of-fuel 2)) (list (cons 'out-of-fuel (lambda (e) (list 'refuel (error-object-irritants e)))))))\n(newline)"
     :math-composition "(define (tags thunks) (map (lambda (t) (guard (e (#t (error-object-type e))) (t))) thunks))\n(display (tags (list (lambda () (escalate 'a)) (lambda () (escalate 'b)) (lambda () (error \"c\")))))\n(newline)"
     :cs-composition "(define (retry-if tag n thunk)\n  (guard (e (#t (if (and (eq? (error-object-type e) tag) (> n 0)) (retry-if tag (- n 1) thunk) (list 'stop (error-object-type e))))) (thunk)))\n(display (retry-if 'flaky 2 (lambda () (escalate 'fatal))))\n(newline)"
     :base "error-object-type reads back the name escalate put on a condition."
     :emergent "eng: a handler TABLE — an alist from type to procedure, so adding a new condition is adding a row rather than editing a cond. math: collecting the types of a batch of thunks, which turns failures into data you can count. cs: a selective retry that only retries the tag it was told to and stops on anything else."
     :meta "The composition that generates all three is type-as-key. Once the failure carries a symbol, every structure that keys on symbols — assq, a hash table, a member test — becomes an exception router for free. The retry is the sharpest use: without a type you must retry everything or nothing, and neither is what an operator wants."
    )
    (:eng "The handler table is the point where an operator can add a recovery without touching the code that fails." :math "Mapping thunks to their failure tags turns a control-flow property into a value you can aggregate." :cs "Selective retry needs a discriminator; this is exactly why the type field exists even though R7RS does not have one."))
)

(verb :name "read-error?" :std "R7RS-small" :library "exception" :tier "core" :kind "predicate" :signature "(read-error? obj) -> boolean"
  :summary "R7RS §6.11 — #t when obj is a condition raised by `read` because the text would not parse."
  :explanation "The one predicate that separates 'your input is malformed' from 'your program is wrong', and the two want opposite reactions. When `read` meets text it cannot finish — an unclosed list, an unterminated string, a stray close paren — it raises a condition that read-error? answers #t for, and the message names the fault and the line and column it stopped at. Every other raised value answers #f: a condition from `error`, a condition from `escalate`, an engine fault, a bare symbol somebody raised, and any value that was never raised at all. So a handler can ask read-error? first and take the input-was-bad branch, and fall through to the something-is-broken branch otherwise. That distinction is what lets a cart accept text a person typed without treating every typo as a crash."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(read-error? 'anything)" :note "#f — an ordinary value is not a read condition; the predicate is safe to ask about anything.")
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t (read-error? e))) (read (open-input-string \"(1 2\")))" :note "#t — the list was never closed, so read refused and the condition is a read error.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (read-error? e))) (error \"not a read problem\"))" :note "#f — a condition from error is not a read error, which is exactly the branch this predicate exists to separate.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (list (read-error? e) (error-object-message e)))) (read (open-input-string \"\\\"abc\")))" :note "(#t \"unterminated string (line 1, col 1)\") — the message names the fault and where the reader gave up.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-read text)\n  (guard (e (#t (if (read-error? e) (list 'bad-syntax (error-object-message e)) (list 'other-failure)))) (read (open-input-string text))))\n(display (list (safe-read \"(a b)\") (safe-read \"(a b\")))\n(newline)" :note "((a b) (bad-syntax missing ) (line 1, col 1))) — good text parses, bad text is reported as syntax rather than as a crash."))
  :caveats ("End of input is NOT a read error. (read p) on an exhausted port returns the eof object; test it with eof-object?, not with a handler." "A condition from error, from escalate, or from an engine fault answers #f. Only the reader raises read conditions." "The predicate answers #f for any non-condition, so a #f tells you nothing on its own about whether anything was raised." "Motoi has no file ports, so the only way to reach a read error is a string port from open-input-string.")
  :usecases ("Separating malformed user input from a bug in the program that is reading it." "Reporting the line and column of a syntax fault back to whoever typed it." "Falling back to a default datum when a saved cart or config will not parse." "Stopping a read-every-datum loop cleanly at the first unparseable form.")
  :related ("read" "error-object-message" "file-error?" "with-exception-handler" "eof-object?" "open-input-string")
  :learn (:concept "Not all failures deserve the same reaction: bad input is the user's to fix, a bug is yours, and a predicate on the condition is how the handler tells them apart." :prerequisites ("read" "with-exception-handler" "open-input-string") :progression "Read a good datum first, then a malformed one inside a handler, then branch on read-error? so the two paths report differently.")
  :provenance "R7RS §6.11; implementation lib/base/r7rs-small.js:972; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (safe-read text)\n  (guard (e (#t (if (read-error? e) (list 'bad-syntax (error-object-message e)) (list 'other-failure)))) (read (open-input-string text))))\n(display (list (safe-read \"(a b)\") (safe-read \"(a b\")))\n(newline)"
     :math-program "(display (guard (e (#t (read-error? e))) (read (open-input-string \"(1 (2 3)\"))))\n(newline)"
     :cs-program "(display (list (read-error? 'a) (read-error? 42) (read-error? \"s\")))\n(newline)"
     :problem "A cart loads a saved level that a person may have hand-edited. Candidates: count the parens yourself before reading (a partial reimplementation of the reader that will disagree with it on strings and comments), catch everything and always report 'bad file' (which hides a genuine bug in the loader behind a message blaming the user), or catch and ask read-error?."
     :explanation "eng: two report shapes from one wrapper, chosen by the predicate. math: a nested list missing one closer is still a read error — the reader tracks depth, so you do not have to. cs: the predicate is total and answers #f for ordinary values, so asking is never itself a risk."
     :meta "Reach for read-error? and NOT a paren counter. The reader already knows the grammar, including that a paren inside a string is not a paren; any counter you write is a second, worse copy of that knowledge that will drift from the first.")
    (:eng "The operator gets 'line 1, col 1' rather than 'load failed', which is the difference between a fixable report and a shrug." :math "Bracket matching is a depth counter over the token stream, and the reader is where that counter lives." :cs "Distinguishing user error from program error at the catch site is the whole reason typed conditions exist."))
  :row-3-dimension (
    (:setup "Ask the failure which kind it is, so the two kinds can be answered differently."
     :rungs (
       (:domain "exception" :code "(guard (e (#t (read-error? e))) (read (open-input-string \"(1 2\")))")
       (:domain "a form rejected at the counter versus a broken till" :code "(display (guard (e (#t (list 'read? (read-error? e) 'file? (file-error? e)))) (read (open-input-string \"(oops\"))))\n(newline)")
       (:domain "a proof that fails on a malformed statement versus on a false one" :code "(display (map (lambda (t) (guard (e (#t (read-error? e))) (t))) (list (lambda () (read (open-input-string \"(1\"))) (lambda () (error \"logic bug\")))))\n(newline)"))
     :explanation "A clerk hands a form back because a box is blank; the till breaking is not the customer's problem and the customer is not asked to fix it. A statement that is not well-formed is rejected before anyone asks whether it is true. A read error is the blank box: the text never became a datum, so nothing downstream is at fault yet."
     :meta "Well-formedness comes before meaning, in every one of these. Sorting failures by which stage they happened in is what tells you who has to act — and a system that collapses the stages tells everybody the same unhelpful thing.")
    (:eng "Handing the fault back to the layer that can fix it is the whole job of classification." :math "Syntax is checked before semantics; a malformed formula has no truth value to be wrong about." :cs "Parse errors versus runtime errors — the same split every compiler makes, available here at the value level."))
  :row-4-proof (
    (:eng-program "(display (guard (e (#t (read-error? e))) (read (open-input-string \"(1 2\"))))\n(newline)"
     :math-program "(display (guard (e (#t (read-error? e))) (error \"not a read problem\")))\n(newline)"
     :cs-program "(display (list (read-error? #t) (read-error? '()) (read-error? (list 1))))\n(newline)"
     :claim "read-error? is #t for a condition raised by read on malformed text and #f for everything else, including conditions from error and values nothing raised."
     :invariant "For all values v. read-error?(v) = #t if and only if v is the condition raised by read on text it could not parse"
     :meta "Three programs, three sides of the same claim: a real read fault answers #t, a genuine but unrelated condition answers #f, and ordinary values answer #f without raising. What would falsify it: a #t from the second program, which would mean the predicate is really asking 'was anything raised at all' — and would make every handler that branches on it misroute every error."
    )
    (:eng "The #f from the error case is the load-bearing test; without it the predicate would be a rubber stamp." :math "An if-and-only-if, so both directions have to be shown — most predicates are only ever tested in one." :cs "Total on all values: asking about a non-condition is safe and answers #f."))
  :row-5-emergence (
    (:eng-composition "(define (parse-or-default text fallback)\n  (guard (e (#t (if (read-error? e) fallback (raise e)))) (read (open-input-string text))))\n(display (list (parse-or-default \"(1 2 3)\" 'default) (parse-or-default \"(1 2\" 'default)))\n(newline)"
     :math-composition "(define (read-all text)\n  (let ((p (open-input-string text)))\n    (guard (e (#t (list 'stopped (read-error? e)))) (let loop ((acc '())) (let ((d (read p))) (if (eof-object? d) (reverse acc) (loop (cons d acc))))))))\n(display (list (read-all \"1 2 3\") (read-all \"1 (2\")))\n(newline)"
     :cs-composition "(define (lint text)\n  (guard (e (#t (if (read-error? e) (list 'syntax (error-object-message e)) (list 'runtime)))) (begin (read (open-input-string text)) (list 'ok))))\n(display (list (lint \"(define x 1)\") (lint \"(define x\")))\n(newline)"
     :base "read-error? tells a syntax failure apart from every other failure."
     :emergent "eng: parse-or-default — swallow the syntax fault and re-raise anything else, so a bug in the loader still surfaces. math: read-all — a loop that ends on eof and reports separately when it ended on a fault instead. cs: a one-datum linter that answers ok, syntax, or runtime."
     :meta "The move worth copying is in the first composition: `(if (read-error? e) fallback (raise e))`. Recovering from the failures you understand and RE-RAISING the rest is what keeps a recovery from turning into a place bugs go to die. A handler that returns a fallback unconditionally is how a broken loader ships looking fine."
    )
    (:eng "Re-raising the unrecognised condition is the difference between a guard and a gag." :math "The loop's two exits — eof and fault — are different facts and the caller can tell which happened." :cs "ok / syntax / runtime is the smallest useful classification a tool can report."))
)

(verb :name "file-error?" :std "R7RS-small" :library "exception" :tier "core" :kind "predicate" :signature "(file-error? obj) -> boolean"
  :summary "R7RS §6.11 — #t when obj is a condition raised by a file operation. In Motoi that means a condition named `file-error` (or `file`) by escalate, or a Node filesystem fault; everything else is #f."
  :explanation "The standard's storage-fault predicate, and the reason a missing file is survivable without a catch-all guard. Motoi has file ports: open-input-file, open-output-file, call-with-input-file, with-output-to-file, file-exists?, delete-file and load are all live as of decision-026, and every one of them raises a condition this predicate answers #t to when the filesystem refuses. That includes refusal by the SANDBOX — a path outside the allowed roots raises a file error rather than crashing, so (guard (e ((file-error? e) 'refused)) (open-input-file \"/etc/passwd\")) answers 'refused. Verbs that touch the filesystem raise the same way. It answers #t in two cases: a condition you named yourself with (escalate 'file-error path), which is the portable route, and a Node filesystem error carrying an fs errno plus a syscall or path. It answers #f for everything else — a condition from `error`, a read fault, a condition escalated under some other name like disk-full, and any value that was never raised at all. Until 2026-08-02 it was hardcoded to #f and could not answer #t for any argument; a note or a claim saying it is a constant is describing an engine that no longer exists."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(file-error? 'anything)" :note "#f — a bare symbol is not a condition, let alone a storage one. The predicate is total and safe to ask about any value.")
    (:dialect "motoi" :tier "novice"       :code "(guard (e (#t (file-error? e))) (error \"disk full\"))" :note "#f — a message that mentions a disk is still not a file condition; the predicate reads the condition, not the prose.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (file-error? e))) (escalate 'file-error \"/tmp/x\"))" :note "#t — the portable route in. Naming the condition `file-error` with escalate is how you raise one Motoi will classify as storage.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (e (#t (list 'read (read-error? e) 'file (file-error? e)))) (read (open-input-string \"(1\")))" :note "(read #t file #f) — the two R7RS condition predicates side by side on one condition: a syntax fault is not a storage fault.")
    (:dialect "motoi" :tier "expert"       :code "(define (classify-failure thunk)\n  (guard (e (#t (cond ((read-error? e) 'syntax) ((file-error? e) 'storage) (else 'logic)))) (thunk)))\n(display (list (classify-failure (lambda () (read (open-input-string \"(1\")))) (classify-failure (lambda () (error \"oops\"))) (classify-failure (lambda () (escalate 'file-error \"/tmp/x\")))))\n(newline)" :note "(syntax logic storage) — all three branches of the classifier are reachable."))
  :caveats ("Only two things make it #t: a condition escalated under the name `file-error` or `file`, and a Node filesystem error carrying an fs errno (ENOENT, EACCES, EPERM …) together with a syscall or path. Nothing else does." "A condition escalated under a different storage-sounding name is #f: (escalate 'disk-full \"/tmp\") gives error-object? #t and file-error? #f. The tag has to be the one the predicate looks for." "Motoi still has no file PORTS: open-input-file, open-output-file, file-exists? and delete-file are UNBOUND, so calling one raises an unbound-symbol condition — which is a logic error, not a file error, and file-error? correctly says #f." "A message containing the word 'file' or 'disk' has no effect on the answer. The predicate looks at the condition, not the text." "It is total and never raises: asking it about a number, a string or the empty list is safe and answers #f.")
  :usecases ("Writing a condition classifier that routes storage faults away from logic faults." "Raising a storage fault portably with (escalate 'file-error path) so a caller's file-error? branch fires." "Confirming that a failure is NOT a storage failure before blaming the disk.")
  :related ("read-error?" "escalate" "error-object?" "error-object-message" "with-exception-handler" "open-input-string")
  :learn (:concept "A standard predicate asks about a KIND of failure, and the implementation decides which of its own faults belong to that kind — here, a named tag and a filesystem errno." :prerequisites ("with-exception-handler" "escalate" "read-error?") :progression "See read-error? answer #t on a syntax fault, then get file-error? to answer #t by escalating 'file-error, then write a cond that routes syntax, storage and logic to three different places.")
  :provenance "R7RS §6.11; implementation lib/base/r7rs-small.js:1108 (it returned #f unconditionally until that was fixed 2026-08-02); re-measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (open-safely path)\n  (guard (e (#t (if (file-error? e) (list 'file-problem path) (list 'not-a-file-problem (error-object-message e))))) (open-input-file path)))\n(display (open-safely \"/no/such/file\"))\n(newline)"
     :math-program "(display (list (guard (e (#t (file-error? e))) (escalate 'file-error \"/tmp/x\")) (guard (e (#t (file-error? e))) (escalate 'disk-full \"/tmp\"))))\n(newline)"
     :cs-program "(display (guard (e (#t (list 'read (read-error? e) 'file (file-error? e)))) (read (open-input-string \"(1\"))))\n(newline)"
     :problem "Code ported from another Scheme wraps an open in a handler and branches on file-error?. Candidates: delete the branch (loses the portability and the record of the decision), assume it fires for any failure near the filesystem (it does not — the tag has to match), or keep the branch and know exactly what makes it true."
     :explanation "eng: the open fails and is reported as NOT a file problem, because open-input-file is UNBOUND — the fault is an unbound-symbol condition, which is a logic error, and file-error? is right to say #f. math: two escalates, one named file-error and one named disk-full, and only the first is #t; the predicate reads the tag, not the sentiment. cs: read-error? and file-error? asked of one condition, and they disagree, which is what a live classifier looks like."
     :meta "Reach for file-error? when the raise site and the catch site have AGREED on the tag. Its #t is earned by (escalate 'file-error …) or by a real fs errno; it is not a synonym for 'something went wrong near storage', so a recovery that depends on it must be paired with a raise site that names the condition properly.")
    (:eng "Reporting a missing binding as 'not a file problem' is the correct answer, not a misleading one: nothing tried to touch a file." :math "The predicate partitions conditions by tag, so its value is informative — knowing the output narrows the input." :cs "Two predicates disagreeing on one condition is the evidence that both of them are reading it."))
  :row-3-dimension (
    (:setup "A question answered by the LABEL a failure was given, not by what the failure looks like or what its text says."
     :rungs (
       (:domain "exception" :code "(file-error? 'anything)")
       (:domain "a fault light wired to one switch, not to a mood" :code "(display (guard (e (#t (file-error? e))) (error \"disk full\")))\n(newline)")
       (:domain "membership in a named class, decided at the raise site" :code "(display (list (file-error? (list 'enoent \"/tmp/x\")) (guard (e (#t (file-error? e))) (escalate 'file-error \"/tmp/x\"))))\n(newline)"))
     :explanation "A fault light comes on because a specific switch closed, not because the machine feels unwell — so a message reading 'disk full' lights nothing. A value that merely LOOKS like a filesystem record, (enoent \"/tmp/x\"), is not a member of the class either. Membership is decided at the raise site by the name the condition was given, and read back here."
     :meta "The trap is prose. 'disk full' is a sentence about storage and it is #f; (escalate 'file-error …) says nothing about disks and it is #t. Classification lives in the tag, and every raise site that wants its failures classified has to spend the tag.")
    (:eng "An instrument wired to a switch tells you something; one wired to a description tells you what someone typed." :math "Membership in a named subset, decided by the constructor rather than inferred from the element." :cs "Same shape as an exception CLASS versus a message match — the class is declared at throw time and cannot be faked by wording."))
  :row-4-proof (
    (:eng-program "(display (map file-error? (list 0 -1 \"\" \"ENOENT\" 'file-error #t #f '() (list 1 2))))\n(newline)"
     :math-program "(display (guard (e (#t (file-error? e))) (error \"anything at all\" 1 2 3)))\n(newline)"
     :cs-program "(display (list (guard (e (#t (list (error-object? e) (file-error? e)))) (escalate 'disk-full \"/tmp\")) (guard (e (#t (list (error-object? e) (file-error? e)))) (escalate 'file-error \"/tmp\"))))\n(newline)"
     :claim "file-error? is #t only for a condition NAMED as a file condition; an unraised value, a raw errno string, and a genuine condition carrying any other name are all #f."
     :invariant "For all values v. file-error?(v) = #t if and only if v is a condition whose type is file-error or file, or a Node fs error carrying an errno and a syscall or path"
     :meta "The third program is the sharp one, and it is a matched pair: two escalates, both genuine conditions (error-object? #t on each), differing only in the name — disk-full gives #f and file-error gives #t. That is the proof that the predicate reads the tag and nothing else. The first program is the negative half: nine values of nine shapes, including the SYMBOL 'file-error and the STRING \"ENOENT\", and all nine are #f, because looking like a file error is not being one. What would falsify the invariant: a #t from anything in the first list, or an #f from the second escalate."
    )
    (:eng "The matched pair is the test worth keeping: same shape, one word different, opposite answers." :math "An if-and-only-if with both directions exhibited — the positive by construction, the negative over nine shapes." :cs "A regression guard in two directions. Before 2026-08-02 the second escalate answered #f, and this record's predecessor claimed that was the invariant."))
  :row-5-emergence (
    (:eng-composition "(define (classify-failure thunk)\n  (guard (e (#t (cond ((read-error? e) 'syntax) ((file-error? e) 'storage) (else 'logic)))) (thunk)))\n(display (list (classify-failure (lambda () (read (open-input-string \"(1\")))) (classify-failure (lambda () (error \"oops\"))) (classify-failure (lambda () (escalate 'file-error \"/tmp/x\")))))\n(newline)"
     :math-composition "(display (list 'tag-decides (equal? (map file-error? (list 1 2 3 'file-error \"ENOENT\")) (list #f #f #f #f #f))))\n(newline)"
     :cs-composition "(define (portable-guard thunk)\n  (guard (e (#t (if (file-error? e) 'retry-storage 'give-up))) (thunk)))\n(display (list (portable-guard (lambda () 'fine)) (portable-guard (lambda () (error \"boom\"))) (portable-guard (lambda () (escalate 'file-error \"/x\")))))\n(newline)"
     :base "file-error? is #t exactly for a condition named as a file condition."
     :emergent "eng: a three-way classifier all three of whose branches fire — syntax, logic, storage. math: the negative half written as a tripwire, so the day an unraised value starts answering #t the test says so. cs: a retry-on-storage guard with three outcomes, and the storage one is reachable by naming the condition at the raise site."
     :meta "What emerges is a CONTRACT BETWEEN TWO SITES. The catch site can only classify what the raise site was willing to name, so the tag is a small shared vocabulary that both halves have to spend — and the moment they agree on it, the whole cond becomes live. The composition to copy is the first one: write the branches, then make each one fire in a test, because a branch you have never seen taken is a branch you do not know the shape of."
    )
    (:eng "Write the branch, then make it fire once. The second half is the part people skip." :math "The tripwire tests the negative direction; the classifier tests the positive one. Both directions or neither." :cs "The raise site spends the tag and the catch site collects it; neither half works alone."))
)

(verb :name "last-error" :std "Motoi" :library "exception" :tier "core" :kind "rd" :signature "(last-error) -> string or #f"
  :summary "The message of the most recent error the REPL caught. Motoi-own, REPL-only: under `motoi run` it is never set."
  :explanation "A convenience for the interactive session and nothing more. When you type something at the REPL that fails, the REPL prints the error AND stashes its message text, so the next thing you type can reach for it — this is what makes `(fix)` with no argument have something to work on. Two limits decide everything about how you may use it. First, only the REPL fills the slot: `motoi run` catches nothing on your behalf, and neither does with-exception-handler, so in a script last-error stays unset no matter how many conditions you raise and catch. Second, what it returns when it IS set is the message STRING, not the condition object — there are no irritants and no type to read off it. And what it returns when unset is plain #f, which is an ordinary Scheme value: it is false in a conditional, (boolean? (last-error)) is #t, and it prints as #f under both the top level and display. So `(if (last-error) …)` reads correctly, and `(string? (last-error))` is the type-exact form of the same question — #t means an error was recorded, #f means the slot is untouched. Until 2026-08-03 the unset slot was a JavaScript null that leaked into Scheme, printed as `()`, and answered #f to every type predicate including boolean?; notes describing a value with no honest predicate are stale."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(last-error)" :note "#f — the unset slot. Under `motoi run` this is the only answer you will ever see.")
    (:dialect "motoi" :tier "novice"       :code "(string? (last-error))" :note "#f — nothing has been recorded, and string? is the honest way to ask.")
    (:dialect "motoi" :tier "intermediate" :code "(null? (last-error))" :note "#f — the unset value is #f, not the empty list. Test it with string? or in a conditional, not with null?.")
    (:dialect "motoi" :tier "intermediate" :code "(list (null? (last-error)) (pair? (last-error)) (string? (last-error)) (boolean? (last-error)) (symbol? (last-error)))" :note "(#f #f #f #t #f) — boolean? is the one that says yes, because the unset slot IS the boolean #f. That is what makes the slot safe to read in a conditional.")
    (:dialect "motoi" :tier "expert"       :code "(define last-seen 'none)\n(define (watched thunk)\n  (guard (e (#t (set! last-seen (error-object-message e)) 'recovered)) (thunk)))\n(display (list (watched (lambda () (error \"tile out of range\" 99))) last-seen))\n(newline)" :note "(recovered tile out of range) — the portable replacement: record it yourself in the handler, because last-error will not."))
  :caveats ("Motoi-own. Nothing in R7RS-small corresponds; portable code cannot use it." "Only the REPL writes the slot (src/repl.js:829 and :865). Under `motoi run` last-error is ALWAYS unset, however many conditions the script raises and catches." "with-exception-handler does NOT record anything here. Catching an error and then reading last-error still gives the unset sentinel." "The unset value is #f, not the empty list. (null? (last-error)) is #f and (equal? (last-error) '()) is #f, while (boolean? (last-error)) is #t." "Passing the unset value to a list verb still raises, because #f is not a list: (length (last-error)) reports \"length: expected a proper list, got #f\"." "When it IS set it holds the message STRING only — no condition object, so no error-object-irritants and no error-object-type." "Test it with (string? (last-error)), or read it directly in a conditional — #f is false, so (if (last-error) …) takes the else branch when nothing was recorded." "The JavaScript null that used to leak out of the unset slot was fixed 2026-08-03 (lib/ai/llm.js:725 now maps it to #f). Notes saying it auto-prints as (), that inspect says \"null\", or that all five type predicates answer #f, describe an engine that no longer exists.")
  :usecases ("At the REPL, feeding the last failure to (fix) without retyping it." "At the REPL, reading the message of the thing that just went wrong." "As a worked example of why a handler should record what it catches instead of relying on ambient state.")
  :related ("error-object-message" "error-object-type" "with-exception-handler" "error" "inspect")
  :learn (:concept "Ambient state that only one host fills is a convenience, not an interface — the portable move is to record what you catch, at the moment you catch it." :prerequisites ("with-exception-handler" "error-object-message" "string?") :progression "Read the unset value and see that it is plain #f, then write a handler that stashes the message in your own variable, then compare: yours works under run, last-error does not.")
  :provenance "Motoi-own; nothing in R7RS-small corresponds. Implementation lib/ai/llm.js:719, slot written only by src/repl.js:829 and :865; measured against the live engine 2026-08-03; reference record added 2026-08-02, corrected 2026-08-03 when the unset slot stopped leaking a JavaScript null"
  :row-2-audit (
    (:eng-program "(define (error-since-boot?)\n  (string? (last-error)))\n(display (list 'run-mode (error-since-boot?)))\n(newline)"
     :math-program "(display (list (last-error) (last-error) (last-error)))\n(newline)"
     :cs-program "(define (own-last-error)\n  (let ((slot 'none))\n    (list (lambda () slot) (lambda (thunk) (guard (e (#t (set! slot (error-object-message e)) 'caught)) (thunk))))))\n(define pair (own-last-error))\n((cadr pair) (lambda () (error \"boom\" 7)))\n(display ((car pair)))\n(newline)"
     :problem "A cart wants to show the last thing that went wrong on a debug overlay. Candidates: read last-error (one call, no plumbing — and always empty under run), keep a module-level variable that the handler writes (three lines, works everywhere), or pass the condition down to whatever draws the overlay (most explicit, most threading)."
     :explanation "eng: under run, string? answers #f, which is the whole verdict on the first candidate. math: three reads of an unset slot render as nothing at all inside a list — even the printed shape gives you no handle. cs: the second candidate written out, a reader and a recorder over one slot, and it does hold the message."
     :meta "Reach for your own slot and NOT last-error whenever the code will run outside the REPL. last-error is not wrong, it is not yours: the REPL owns the write, so a script that reads it is reading somebody else's variable and finding it empty.")
    (:eng "A debug overlay fed by ambient state shows nothing and gives no hint why; one fed by a handler shows the message." :math "Reading a slot nobody writes is a constant, and a constant on a debug display is worse than a blank one." :cs "Same shape as errno versus a returned error value: the ambient version is convenient in a shell and a hazard in a library."))
  :row-3-dimension (
    (:setup "A value that reads as 'nothing here yet', and the trouble that starts when 'nothing' is spelled the same as a real value."
     :rungs (
       (:domain "exception" :code "(last-error)")
       (:domain "a blank line on a form versus a line filled in with a dash" :code "(display (list 'unset-is-not-empty-list (null? (last-error))))\n(newline)")
       (:domain "the empty set versus the symbol for 'undefined'" :code "(display (inspect (last-error)))\n(newline)"))
     :explanation "A blank box and a box containing a dash look similar on paper and mean different things: one was never filled in, the other was answered 'none'. The empty set is a set; 'undefined' is not a set at all. The unset last-error prints exactly like the empty list and answers #f to null?, so the printed form and the real identity disagree — which is the single most expensive way for a value to be spelled."
     :meta "The lesson generalises past this verb: a sentinel must be distinguishable by a PREDICATE, not by how it prints. `inspect` is the only thing in Motoi that tells the truth about this value, and it says \"null\", a word with no other meaning in the language.")
    (:eng "Two states that render identically will be confused by whoever reads the render, every time." :math "Absent and empty are different, and collapsing them loses information you cannot get back." :cs "A null that impersonates the empty list is the classic sentinel bug; the fix is a predicate, not a nicer printer."))
  :row-4-proof (
    (:eng-program "(display (list (null? (last-error)) (pair? (last-error)) (string? (last-error)) (boolean? (last-error)) (symbol? (last-error))))\n(newline)"
     :math-program "(display (list 'stable (eq? (last-error) (last-error)) 'equals-empty-list (equal? (last-error) '())))\n(newline)"
     :cs-program "(display (guard (e (#t (list 'raised (error-object-message e)))) (length (last-error))))\n(newline)"
     :claim "Under `motoi run` the slot is never written, and the value it holds belongs to no Scheme type: five type predicates all answer #f, it is not equal? to the empty list it prints as, and handing it to a list verb raises."
     :invariant "Under run: for every type predicate p in {null?, pair?, string?, boolean?, symbol?}, p(last-error()) = #f; and last-error() is eq? to itself but not equal? to '()"
     :meta "The third program is the one that settles it. length raises rather than answering, and the message the engine chooses is \"expected a proper list, got nothing\" — the engine has its own word for this value and that word is nothing. What would falsify the claim: any predicate answering #t, or the slot holding a string after a caught error, which it does not — with-exception-handler never writes it."
    )
    (:eng "Five predicates and a raise is the cheapest complete description of a value with no type." :math "Not equal? to '() while printing as () is the exact statement that the printer and the identity disagree." :cs "eq? to itself confirms it is one stable object, so this is a sentinel, not a fresh value per call."))
  :row-5-emergence (
    (:eng-composition "(define last-seen 'none)\n(define (watched thunk)\n  (guard (e (#t (set! last-seen (error-object-message e)) 'recovered)) (thunk)))\n(display (list (watched (lambda () (error \"tile out of range\" 99))) last-seen))\n(newline)"
     :math-composition "(define log '())\n(define (record thunk)\n  (guard (e (#t (set! log (cons (error-object-type e) log)) 'next)) (thunk)))\n(record (lambda () (escalate 'a)))\n(record (lambda () (escalate 'b)))\n(display (reverse log))\n(newline)"
     :cs-composition "(define (with-last-error)\n  (let ((slot #f))\n    (cons (lambda () slot)\n          (lambda (thunk) (guard (e (#t (set! slot (error-object-message e)) #f)) (thunk))))))\n(define box (with-last-error))\n(display (list 'before ((car box)) 'result ((cdr box) (lambda () (error \"disk\" 1))) 'after ((car box))))\n(newline)"
     :base "last-error is a slot only the REPL writes, holding only a message string."
     :emergent "eng: your own last-seen, one variable and one set! inside the handler, and it works under run. math: a LOG rather than a slot — keep every failure's type, not just the newest, and the failures become a sequence you can read. cs: the slot closed over, so the reader and the recorder ship together and nothing else can write it."
     :meta "Each composition is strictly better than the verb it replaces, and the third is the one to keep: closing the slot over a lambda gives you the same one-call convenience with none of the ambient reach, and #f is a real Scheme value that string? and boolean? both have opinions about. If you find yourself wanting last-error in a script, build this instead — it is six lines and it does not lie about being empty."
    )
    (:eng "One variable and one set! is the entire cost of not depending on the host." :math "A log generalises a slot: the slot is the log truncated to length one, and truncation is a choice you should make on purpose." :cs "Closing over the slot makes the write site enumerable — exactly what ambient state gives up."))
)
