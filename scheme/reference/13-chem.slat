;;; 13-chem.slat — Motoi Scheme Reference · Chapter 13 · library chem
;;;
;;; 5 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library chem — 5 verbs.")

(chapter :number "13" :library "chem" :verb-count 5 :training-eligible #t)

(verb :name "chem/atomic-weight" :std "Motoi" :library "chem" :tier "core" :kind "pure" :signature "(chem/atomic-weight symbol) -> number"
  :summary "Return the standard atomic weight (u) for a chemical element symbol."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(chem/atomic-weight 'H)" :note "≈ 1.008.")
    (:dialect "motoi" :tier "intermediate" :code "(chem/atomic-weight 'C)" :note "≈ 12.011.")
    (:dialect "motoi" :tier "expert"       :code "(define (avg-weight symbols) (/ (apply + (map chem/atomic-weight symbols)) (length symbols)))\n(avg-weight (list 'C 'H))" :note "Mean atomic weight across a symbol set."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define mass (chem/atomic-weight 'H))\nmass"
     :math-program "(define (weight-fn sym) (chem/atomic-weight sym))\n(weight-fn 'H)"
     :cs-program "(define (safe-weight s) (if (symbol? s) (chem/atomic-weight s) (error 'need-symbol)))\n(safe-weight 'H)"
     :problem "Molar mass calc needs per-atom weight lookup — hardcoding forces per-element case explosion."
     :explanation "eng: mass lookup. math: element → real. cs: type-guarded lookup."
     :meta "Reach for chem/atomic-weight and NOT hardcoded table: table drifts vs periodic-table updates.")
    (:eng "Table maintenance lives in the runtime, not the caller." :math "Total function on registered elements." :cs "Reference-table lookup."))
  :row-3-dimension (
    (:setup "Element → property lookup."
     :rungs (
       (:domain "engineering"  :code "(chem/atomic-weight 'H)")
       (:domain "mathematics"  :code "(define (weight-fn sym) (chem/atomic-weight sym))\n(weight-fn 'H)")
       (:domain "cs / dispatch" :code "(define (weight-fn sym) (chem/atomic-weight sym))\n(weight-fn 'H)"))
     :explanation "Direct, algebraic index, parsed dispatch."
     :meta "Nominal → real.")
    (:eng "Property lookup over named set." :math "Function Elements → ℝ." :cs "Constant-table lookup."))
  :row-4-proof (
    (:eng-program "(equal? (chem/atomic-weight 'H) (chem/atomic-weight 'H))"
     :math-program "(define (deterministic? s) (equal? (chem/atomic-weight s) (chem/atomic-weight s)))\n(deterministic? 'H)"
     :cs-program "(define (returns-positive? s) (positive? (chem/atomic-weight s)))\n(returns-positive? 'H)"
     :claim "Pure, deterministic; returns positive real."
     :invariant "∀ s ∈ Elements. chem/atomic-weight(s) > 0 ∧ deterministic"
     :meta "Pattern: static reference-table read.")
    (:eng "Cacheable across the whole program." :math "Positive real-valued function." :cs "Pure read."))
  :row-5-emergence (
    (:eng-composition "(define (total-mass counts) (apply + (map (lambda (p) (* (chem/atomic-weight (car p)) (cadr p))) counts)))\n(total-mass (list (list 'H 2) (list 'O 1)))"
     :math-composition "(define (weighted-sum symbols weights) (apply + (map (lambda (s w) (* (chem/atomic-weight s) w)) symbols weights)))\n(weighted-sum (list 'H 'O) (list 2 1))"
     :cs-composition "(define (mass-table symbols) (map (lambda (s) (cons s (chem/atomic-weight s))) symbols))\n(mass-table (list 'H 'C 'O))"
     :base "chem/atomic-weight is per-element mass lookup."
     :emergent "Compositions: eng molar-mass sum, math weighted-sum, cs mass-table build."
     :meta "Family: element-property aggregation.")
    (:eng "Molar mass is a weighted-sum composition." :math "Linearity of sum." :cs "Table transform."))
)

(verb :name "chem/balance" :std "Motoi" :library "chem" :tier "core" :kind "pure" :signature "(chem/balance reaction) -> list"
  :summary "Balance a chemical equation; return integer coefficient list or 'unbalanced-reaction."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(chem/balance '(H2 + O2 -> H2O))" :note "→ (2 1 2).")
    (:dialect "motoi" :tier "intermediate" :code "(let ((c (chem/balance '(C + O2 -> CO2)))) c)" :note "→ (1 1 1).")
    (:dialect "motoi" :tier "expert"       :code "(define (balanced-with-labels rxn) (let ((c (chem/balance rxn))) (if (list? c) (list :coeffs c) 'unbalanced-reaction)))\n(balanced-with-labels '(H2 + O2 -> H2O))" :note "Label-tagged balance result."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(chem/balance '(H2 + O2 -> H2O))"
     :math-program "(define (null-space-solve rxn) (chem/balance rxn))\n(null-space-solve '(H2 + O2 -> H2O))"
     :cs-program "(define (safe-balance rxn) (if (list? rxn) (chem/balance rxn) (error 'need-reaction-list)))\n(safe-balance '(H2 + O2 -> H2O))"
     :problem "Chemistry classroom app must balance user-provided equations; hand-solving is error-prone."
     :explanation "eng: automated balancer. math: matrix null-space solve. cs: type-guarded balance."
     :meta "Reach for chem/balance and NOT hand-count: automated null-space avoids trial-and-error errors.")
    (:eng "Automated conservation check." :math "Solve M·c = 0 for integer c." :cs "Matrix null-space returned as list."))
  :row-3-dimension (
    (:setup "Linear system with integer constraint."
     :rungs (
       (:domain "engineering"  :code "(define (null-space-solve rxn) (chem/balance rxn))\n(null-space-solve '(H2 + O2 -> H2O))")
       (:domain "mathematics"  :code "(define (null-space-solve rxn) (chem/balance rxn))\n(null-space-solve '(H2 + O2 -> H2O))")
       (:domain "cs / dispatch" :code "(define (null-space-solve rxn) (chem/balance rxn))\n(null-space-solve '(H2 + O2 -> H2O))"))
     :explanation "Direct, canonical form, parsed dispatch."
     :meta "Integer null-space solver.")
    (:eng "Balance = conservation constraint." :math "Kernel of atom-count matrix." :cs "Integer LP solver."))
  :row-4-proof (
    (:eng-program "(define c (chem/balance '(H2 + O2 -> H2O)))\n(list? c)"
     :math-program "(define (deterministic? rxn) (equal? (chem/balance rxn) (chem/balance rxn)))\n(deterministic? '(H2 + O2 -> H2O))"
     :cs-program "(define (unbalanced-symbol? r) (eq? r 'unbalanced-reaction))\n(unbalanced-symbol? (chem/balance '(X + Y -> Z)))"
     :claim "Returns list of positive integers or 'unbalanced-reaction; deterministic."
     :invariant "∀ rxn. chem/balance(rxn) ∈ (list-of positive-int) ∪ {'unbalanced-reaction}"
     :meta "Pattern: sum-typed result.")
    (:eng "Sum-typed contract handles unsolvable case honestly." :math "Kernel exists iff coefficients found." :cs "Result<Solution, Error>."))
  :row-5-emergence (
    (:eng-composition "(define (balance-and-mass rxn) (let ((c (chem/balance rxn))) (if (list? c) (list :coeffs c) 'unbalanced)))\n(balance-and-mass '(H2 + O2 -> H2O))"
     :math-composition "(define (balance-many rxns) (map chem/balance rxns))\n(balance-many (list '(H2 + O2 -> H2O)))"
     :cs-composition "(define (balance-with-fallback rxn on-fail) (let ((c (chem/balance rxn))) (if (list? c) c (on-fail rxn))))\n(balance-with-fallback '(X -> Y) (lambda (r) 'unknown))"
     :base "chem/balance solves reaction coefficients."
     :emergent "Compositions: eng balance-then-mass, math batch balance, cs fallback on unbalanced."
     :meta "Family: stoichiometric composition.")
    (:eng "Balance is the entry step to mass calcs." :math "Batch fold on reaction list." :cs "Fallback on unsolvable case."))
)

(verb :name "chem/formula-counts" :std "Motoi" :library "chem" :tier "core" :kind "pure" :signature "(chem/formula-counts formula-string) -> list"
  :summary "Parse a chemical formula; return ((element-string count) ...)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(chem/formula-counts \"H2O\")" :note "→ ((\"H\" 2) (\"O\" 1)).")
    (:dialect "motoi" :tier "intermediate" :code "(chem/formula-counts \"C6H12O6\")" :note "→ ((\"C\" 6) (\"H\" 12) (\"O\" 6)).")
    (:dialect "motoi" :tier "expert"       :code "(define (element-set f) (map car (chem/formula-counts f)))\n(element-set \"C6H12O6\")" :note "Unique element list from formula."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(chem/formula-counts \"H2O\")"
     :math-program "(define (multiset-of f) (chem/formula-counts f))\n(multiset-of \"H2O\")"
     :cs-program "(define (safe-parse f) (if (string? f) (chem/formula-counts f) (error 'need-string)))\n(safe-parse \"H2O\")"
     :problem "Molar-mass calc needs per-element counts from a formula string."
     :explanation "eng: parse for mass. math: multiset. cs: type-guarded parse."
     :meta "Reach for chem/formula-counts and NOT regex over the string: parser handles nesting + parentheses correctly.")
    (:eng "One call to a real parser." :math "String → multiset." :cs "Structured parse output."))
  :row-3-dimension (
    (:setup "Structured parse of a domain string."
     :rungs (
       (:domain "engineering"  :code "(chem/formula-counts \"H2O\")")
       (:domain "mathematics"  :code "(define (multiset-of f) (chem/formula-counts f))\n(multiset-of \"H2O\")")
       (:domain "cs / dispatch" :code "(define (multiset-of f) (chem/formula-counts f))\n(multiset-of \"H2O\")"))
     :explanation "Direct, canonicalized, extracted."
     :meta "String → structured multiset.")
    (:eng "Parser handles nesting." :math "Element multiset." :cs "Structured tokenizer output."))
  :row-4-proof (
    (:eng-program "(let ((c (chem/formula-counts \"H2O\"))) (and (list? c) (>= (length c) 1)))"
     :math-program "(define (deterministic? f) (equal? (chem/formula-counts f) (chem/formula-counts f)))\n(deterministic? \"H2O\")"
     :cs-program "(define (all-pairs? c) (and (list? c) (fold (lambda (p ok) (and ok (= (length p) 2))) #t c)))\n(all-pairs? (chem/formula-counts \"H2O\"))"
     :claim "Returns list of (element-string count) pairs; deterministic."
     :invariant "∀ f. chem/formula-counts(f) = list-of-(string, positive-int)"
     :meta "Pattern: structured parse output.")
    (:eng "Every entry is (string, positive int)." :math "Deterministic parse." :cs "Well-typed multiset."))
  :row-5-emergence (
    (:eng-composition "(define (molar-mass-alt f) (apply + (map (lambda (p) (* (chem/atomic-weight (string->symbol (car p))) (cadr p))) (chem/formula-counts f))))\n(molar-mass-alt \"H2O\")"
     :math-composition "(define (element-set-of f) (map car (chem/formula-counts f)))\n(element-set-of \"C6H12O6\")"
     :cs-composition "(define (parse-and-validate f) (let ((c (chem/formula-counts f))) (if (null? c) (error 'empty) c)))\n(parse-and-validate \"H2O\")"
     :base "chem/formula-counts parses a formula into a multiset."
     :emergent "Compositions: eng manual molar-mass, math element set, cs validate parse."
     :meta "Family: parse-then-aggregate.")
    (:eng "Parser output drives every downstream calc." :math "Weighted sum over multiset." :cs "Validation gate on empty parse."))
)

(verb :name "chem/molar-mass" :std "Motoi" :library "chem" :tier "core" :kind "pure" :signature "(chem/molar-mass formula-string) -> number"
  :summary "Compute molar mass (g/mol) of a formula by summing weighted atomic weights."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(chem/molar-mass \"H2O\")" :note "≈ 18.015 g/mol.")
    (:dialect "motoi" :tier "intermediate" :code "(chem/molar-mass \"C6H12O6\")" :note "≈ 180.156 g/mol.")
    (:dialect "motoi" :tier "expert"       :code "(define (mass-difference f1 f2) (- (chem/molar-mass f1) (chem/molar-mass f2)))\n(mass-difference \"H2O\" \"CO2\")" :note "Delta between formulas."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(chem/molar-mass \"H2O\")"
     :math-program "(define (mass f) (chem/molar-mass f))\n(mass \"H2O\")"
     :cs-program "(define (safe-mass f) (if (string? f) (chem/molar-mass f) (error 'need-string)))\n(safe-mass \"H2O\")"
     :problem "Stoichiometry problem needs molar mass to convert grams ↔ moles."
     :explanation "eng: mass lookup. math: sum-of-weighted-atoms. cs: type-guarded call."
     :meta "Reach for chem/molar-mass and NOT hand-summed atomic-weights: molar-mass composes formula-counts + atomic-weight correctly.")
    (:eng "One-call mass computation." :math "Sum: Σ (aw(e) × n(e))." :cs "Composed reference-table read."))
  :row-3-dimension (
    (:setup "Formula → real-valued property."
     :rungs (
       (:domain "engineering"  :code "(chem/molar-mass \"H2O\")")
       (:domain "mathematics"  :code "(define (mass f) (chem/molar-mass f))\n(mass \"H2O\")")
       (:domain "cs / dispatch" :code "(define (mass f) (chem/molar-mass f))\n(mass \"H2O\")"))
     :explanation "Direct, canonicalized, extracted."
     :meta "Formula → real property.")
    (:eng "Property-value derivation." :math "Real-valued derived quantity." :cs "Function composition."))
  :row-4-proof (
    (:eng-program "(positive? (chem/molar-mass \"H2O\"))"
     :math-program "(define (linearity-check? f1 f2) (< (abs (- (chem/molar-mass \"H2O\") (chem/molar-mass \"H2O\"))) 1e-6))\n(linearity-check? \"H2O\" \"H2O\")"
     :cs-program "(define (deterministic? f) (equal? (chem/molar-mass f) (chem/molar-mass f)))\n(deterministic? \"H2O\")"
     :claim "Deterministic; returns positive real."
     :invariant "∀ f. chem/molar-mass(f) > 0 ∧ deterministic"
     :meta "Pattern: derived positive property.")
    (:eng "Positive means unit is real g/mol." :math "Deterministic on input formula." :cs "Composed pure lookup."))
  :row-5-emergence (
    (:eng-composition "(define (grams->moles g f) (/ g (chem/molar-mass f)))\n(grams->moles 18 \"H2O\")"
     :math-composition "(define (mass-ratio f1 f2) (/ (chem/molar-mass f1) (chem/molar-mass f2)))\n(mass-ratio \"H2O\" \"CO2\")"
     :cs-composition "(define (mass-table formulas) (map (lambda (f) (cons f (chem/molar-mass f))) formulas))\n(mass-table (list \"H2O\" \"CO2\"))"
     :base "chem/molar-mass gives per-formula mass."
     :emergent "Compositions: eng grams→moles conversion, math mass ratio, cs mass table."
     :meta "Family: stoichiometric conversion.")
    (:eng "Conversion pipeline runs on the mass property." :math "Ratios encode reaction proportions." :cs "Table transform."))
)

(verb :name "chem/moles" :std "Motoi" :library "chem" :tier "core" :kind "pure" :signature "(chem/moles formula grams) -> number"
  :summary "Convert mass in grams to moles; grams / molar-mass."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(chem/moles \"H2O\" 18.015)" :note "≈ 1.0 mol.")
    (:dialect "motoi" :tier "intermediate" :code "(chem/moles \"C6H12O6\" 180.156)" :note "≈ 1.0 mol.")
    (:dialect "motoi" :tier "expert"       :code "(define (batch-moles items) (map (lambda (p) (chem/moles (car p) (cadr p))) items))\n(batch-moles (list (list \"H2O\" 18)))" :note "Batch conversion."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(chem/moles \"H2O\" 18)"
     :math-program "(define (moles-fn f g) (chem/moles f g))\n(moles-fn \"H2O\" 18)"
     :cs-program "(define (safe-moles f g) (if (and (string? f) (number? g)) (chem/moles f g) (error 'bad-args)))\n(safe-moles \"H2O\" 18)"
     :problem "Stoichiometry — convert measured grams to moles for a balanced-reaction ratio calc."
     :explanation "eng: grams to moles. math: g / mm. cs: type-guarded conversion."
     :meta "Reach for chem/moles and NOT manual (/ g (chem/molar-mass f)): moles is the domain-named operation.")
    (:eng "Named conversion is more readable." :math "n = g / M." :cs "Named division."))
  :row-3-dimension (
    (:setup "Mass-quantity conversion via formula."
     :rungs (
       (:domain "engineering"  :code "(define (moles-fn f g) (chem/moles f g))\n(moles-fn \"H2O\" 18)")
       (:domain "mathematics"  :code "(define (moles-fn f g) (chem/moles f g))\n(moles-fn \"H2O\" 18)")
       (:domain "cs / dispatch" :code "(define (moles-fn f g) (chem/moles f g))\n(moles-fn \"H2O\" 18)"))
     :explanation "Direct, canonicalized, parsed."
     :meta "Formula-parameterized division.")
    (:eng "Conversion driver." :math "n = g / M." :cs "Named function on two inputs."))
  :row-4-proof (
    (:eng-program "(< (abs (- (chem/moles \"H2O\" 18.015) 1.0)) 0.01)"
     :math-program "(define (proportional? g) (= (chem/moles \"H2O\" (* 2 g)) (* 2 (chem/moles \"H2O\" g))))\n(proportional? 18)"
     :cs-program "(define (deterministic? f g) (equal? (chem/moles f g) (chem/moles f g)))\n(deterministic? \"H2O\" 18)"
     :claim "Deterministic; linear in grams (holding formula)."
     :invariant "∀ f g₁ g₂. chem/moles(f, g₁+g₂) = chem/moles(f,g₁) + chem/moles(f,g₂)"
     :meta "Pattern: linear conversion.")
    (:eng "Linearity means splitting mass and summing works." :math "Additivity in second argument." :cs "Deterministic conversion."))
  :row-5-emergence (
    (:eng-composition "(define (grams-to-moles-of-many items) (map (lambda (p) (list (car p) (chem/moles (car p) (cadr p)))) items))\n(grams-to-moles-of-many (list (list \"H2O\" 18)))"
     :math-composition "(define (ratio-vs f g target-ratio) (/ (chem/moles f g) target-ratio))\n(ratio-vs \"H2O\" 18 0.5)"
     :cs-composition "(define (kv-mass-to-moles table) (map (lambda (p) (cons (car p) (chem/moles (car p) (cadr p)))) table))\n(kv-mass-to-moles (list (list \"H2O\" 18)))"
     :base "chem/moles converts grams to moles."
     :emergent "Compositions: eng batch conversion, math ratio-vs-target, cs KV transform."
     :meta "Family: stoichiometric conversion.")
    (:eng "Batch conversion drives lab-report generation." :math "Ratio comparison drives reaction planning." :cs "Same shape as any unit conversion pipeline."))
)
