;;; 35-io.slat — Motoi Scheme Reference · Chapter 35 · library io
;;;
;;; 46 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;

(dialect :applies ("motoi") :note "Library io — 46 verbs.")

(chapter :number "35" :library "io" :verb-count 46 :training-eligible #t)

;; ═══ 46 verbs in library io ═══

(verb :name "write" :std "R7RS-small"           :library "io" :tier "core" :kind "io" :signature "(write value) -> void"
  :summary "Print a machine-readable representation. Strings quoted. R7RS §6.10.3."
  :provenance "R7RS §6.10.3; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(write \"hello\")" :note "Prints \"hello\" — with quotes, machine-readable form.")
    (:dialect "motoi" :tier "intermediate" :code "(write (list 1 \"two\" 'three))" :note "Prints (1 \"two\" three) — write shows the shape.")
  )
  :row-2-audit (
    (:eng-program "(define snapshot (list 'user \"Alfred\" 'count 42))\n(write snapshot)\n(newline)"
     :math-program "'honest-null-math ; write is an IO effect against a total pretty-printing function — its algebra is the read/write bijection on readable values, stated in row 4."
     :cs-program "(define (structured-log-line tag payload)\n  (let ((p (open-output-string)))\n    (write (list tag payload) p)\n    (get-output-string p)))\n(display (structured-log-line 'user-login (list 'user \"alice\" 'ts 1729)))\n(newline)"
     :problem "The operator is dumping structured data to a log file that will be read back later by a Scheme program. Two candidates: write (produces a machine-readable form the reader can parse) and display (produces human-friendly form that drops quotes on strings and cannot always be re-read). For a round-trippable dump, write is the honest verb — the auditor can point at the log entry and know it will parse back."
     :program "(define snapshot (list 'user \"Alfred\" 'count 42))\n(write snapshot)\n(newline)\n(display snapshot)\n(newline)"
     :explanation "eng: dump a structured snapshot in machine-readable form. math: honest-null — write is an IO effect, not algebra. cs: structured-log-line builder that captures the write form into a string for downstream serialization."
     :meta "Why write and not display: display drops the quotes on strings, which makes the log line unparsable as Scheme.")
    (:eng "Round-trippable logs use write; user-facing prompts use display. Never conflate them."
     :math "write is a total function from Scheme values to the parseable subset of their external representations."
     :cs "Related patterns: repr() in Python, Object.toString in Java. The read-write duality is what makes S-expression logs auditable.")
)
  :row-3-dimension (
    (:setup "A structural serializer: print a value in a form that a machine can re-parse to reconstruct the value."
     :rungs ((:domain "io" :code "(write (list 1 \"two\" 'three))")
             (:domain "warehouse tag with barcode" :code "(define snapshot (list 'user \"Alfred\" 'count 42))\n(write snapshot)\n(newline)\n(display snapshot)\n(newline)")
             (:domain "pretty-printer round-trip identity" :code "(define snapshot (list 'user \"Alfred\" 'count 42))\n(write snapshot)\n(newline)\n(display snapshot)\n(newline)"))
     :explanation "In io, write is structural. On a warehouse tag, the barcode encodes the item enough that a scanner reconstructs the record. In math, a printer/parser pair defines a round-trip identity. All three share: a printed form that a reader can turn back into the source value."
     :meta "The shape transfers wherever a system needs to record data for later re-reading, not just for looking at."))
  :row-4-proof (
    (:eng-program "(define original (list 1 \"two\" 'three))\n(define output (with-output-to-string (lambda () (write original))))\n(display (list 'output output 'is-string (string? output)))\n(newline)"
     :math-program "'honest-null-math ; the read∘write=id property on readable values is a serialization contract — a CS bijection statement, not algebra."
     :cs-program "(define (serializable? v)\n  (string? (with-output-to-string (lambda () (write v)))))\n(display (map serializable? (list 1 \"str\" '(a b c) 3.14 'sym)))\n(newline)"
     :claim "write produces output that, when passed back through read, reconstructs the original value (for readable values)."
     :program "(define original (list 1 \"two\" 'three))\n(define output (with-output-to-string (lambda () (write original))))\n(display output)\n(newline)\n(display (string? output))\n(newline)"
     :invariant "∀ v readable. read(write(v)) = v"
     :meta "The pattern is print-read round-trip. CS pattern name: bijective serialization on readable values. What would falsify: any readable value that fails to round-trip through write-then-read. See book-of-code ch09 on serialization semantics.")
    (:eng "The engineering payoff is that write-produced output is safe to feed to read; no escaping bugs."
     :math "The write-read pair forms an equivalence on the readable subset of values."
     :cs "Not every value is readable (e.g., procedures, ports); write on non-readable values still prints but the round-trip fails.")
)
  :row-5-emergence (
    (:eng-composition "(define log-buf (open-output-string))\n(define (log-event tag payload) (write (list tag payload) log-buf) (write-string \"\\n\" log-buf))\n(log-event 'user-login 'alice)\n(log-event 'user-logout 'alice)\n(display (get-output-string log-buf))\n(newline)"
     :math-composition "'honest-null-math ; structured-log-as-stream is IO composition (write + newline + append), not algebra."
     :cs-composition "(define log-buf2 (open-output-string))\n(define (log-event2 tag payload) (write (list tag payload) log-buf2) (write-string \"\\n\" log-buf2))\n(log-event2 'user-login 'alice)\n(log-event2 'user-action \"click\")\n(log-event2 'user-logout 'alice)\n(display (string-length (get-output-string log-buf2)))\n(newline)"
     :base "write prints a value in machine-readable form."
     :composition "(define log-buf (open-output-string))\n(define (log-event tag payload) (write (list tag payload) log-buf) (write-string \"\\n\" log-buf))\n(log-event 'user-login 'alice)\n(log-event 'user-logout 'alice)\n(display (get-output-string log-buf))\n(newline)"
     :emergent "eng: append-only structured log via write+newline. math: honest-null. cs: event-sourced replay — round-trip a serialized log back into a list of parsed events, the same shape as Kafka consumers."
     :meta "The composition chains write with newline into a string port. What emerges is the structured-log family: append-only serialized events. Same shape as JSON-line logs, as Common Log Format, as event-sourced storage. See book-of-composition ch14 on log-as-stream.")
)
)

(verb :name "write-string" :std "R7RS-small"    :library "io" :tier "core" :kind "io" :signature "(write-string s) -> void"
  :summary "Print s unquoted. R7RS §6.10.3."
  :provenance "R7RS §6.10.3; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(write-string \"hello\")" :note "Prints hello — no quotes, no newline.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string)))\n  (write-string \"hi\" p)\n  (get-output-string p))" :note "\"hi\" — captured into a string port.")
    (:dialect "motoi" :tier "advanced" :code "(define p (open-output-string))\n(for-each (lambda (w) (write-string w p) (write-string \" \" p)) (list \"one\" \"two\" \"three\"))\n(display (get-output-string p))\n(newline)" :note "one two three  — folding a list of pieces into a port, no framing added.")
  )
  :row-2-audit (
    (:eng-program "(define buf (open-output-string))\n(write-string \"motoi-\" buf)\n(write-string \"scheme\" buf)\n(display (get-output-string buf))\n(newline)"
     :math-program "; honest-null: write-string is an IO byte-out sink — no numeric structure to fold, no algebra to exhibit beyond string concatenation on the port side (already Row 4 territory). The math view of a raw-emit primitive is trivial length-additivity, not a computed shape.\n(display 'honest-null-io-emit)\n(newline)"
     :cs-program "(define (write-string-safe s p) (if (string? s) (begin (write-string s p) 'ok) (error 'need-string)))\n(define p2 (open-output-string))\n(display (write-string-safe \"ok\" p2))\n(newline)\n(display (get-output-string p2))\n(newline)"
     :problem "The operator wants to concatenate several string pieces to a port without adding quotes or newlines. Candidates: write-string (writes exactly the characters, no framing), write (adds quotes around strings), display (unquotes but reads as user output). For streaming string pieces into a buffer for later retrieval, write-string is the honest verb — the output is exactly the input, no adornment."
     :explanation "eng: two pieces to a string port, no framing. math: honest-null — write-string is an IO byte-emit; the interesting math (concatenation, length additivity) already lives in Row 4. cs: type-guard the input string so bad callers fail at the boundary."
     :meta "Why write-string and not display: display would work here for strings, but display's contract is 'human-friendly' and covers non-string values too. write-string commits to the string type and to the no-framing rule.")
    (:eng "String assembly should prefer write-string over display when the output is being fed to a machine — the intent is 'raw characters,' not 'human display.'"
     :math "The operation is the identity map from string to output-characters, restricted to the string codomain."
     :cs "Related patterns: fwrite in C, Writer.write in Java. The 'no framing' contract is what distinguishes it from print/println.")
)
  :row-3-dimension (
    (:setup "A raw character emission: send exactly the characters of a string to an output sink, without adding markers, delimiters, or newlines."
     :rungs ((:domain "io" :code "(define port (open-output-string))\n(write-string \"hello\" port)\n(display (get-output-string port))\n(newline)")
             (:domain "pipe raw bytes" :code "; honest-null: write-string is an IO byte-out sink — no numeric structure to fold, no algebra to exhibit beyond string concatenation on the port side (already Row 4 territory). The math view of a raw-emit primitive is trivial length-additivity, not a computed shape.\n(display 'honest-null-io-emit)\n(newline)")
             (:domain "identity id: string → string" :code "(define id (lambda (s) s))"))
     :explanation "In io, write-string is the raw output primitive. In a pipe metaphor, dumping raw bytes writes exactly the given characters to the pipe. In math, the identity function is the pure-transmission map. All three share: exact-character transmission with no framing."
     :meta "The shape transfers wherever a system needs a low-level raw-output primitive over which framed formats can be layered."))
  :row-4-proof (
    (:eng-program "(define p (open-output-string))\n(write-string \"abc\" p)\n(write-string \"def\" p)\n(display (get-output-string p))\n(newline)\n(display (string-length (get-output-string p)))\n(newline)"
     :math-program "(define (length-additive? pieces)\n  (let ((p (open-output-string)))\n    (for-each (lambda (s) (write-string s p)) pieces)\n    (= (string-length (get-output-string p))\n       (apply + (map string-length pieces)))))\n(display (length-additive? '(\"abc\" \"def\" \"\" \"gh\")))\n(newline)"
     :cs-program "(define (append-only? pieces)\n  (let ((p (open-output-string)))\n    (let loop ((rest pieces) (prev \"\"))\n      (cond ((null? rest) #t)\n            (else (write-string (car rest) p)\n                  (let ((now (get-output-string p)))\n                    (if (and (>= (string-length now) (string-length prev))\n                             (equal? (substring now 0 (string-length prev)) prev))\n                        (loop (cdr rest) now)\n                        #f)))))))\n(display (append-only? '(\"a\" \"bc\" \"def\")))\n(newline)"
     :claim "write-string preserves the characters of s exactly: after (write-string s p), the port's accumulated content ends with s."
     :invariant "∀ s p. after write-string(s, p): contents(p) = contents(p_pre) ++ s ∧ |contents(p) - contents(p_pre)| = |s|"
     :meta "The pattern is character-exact concatenation. CS pattern name: append-only output. What would falsify: added or dropped characters, or extra framing. See book-of-code ch09.")
    (:eng "The engineering payoff is that write-string is composable — you can build any framed format on top of it."
     :math "The output is the concatenation of prior content with s; length is additive: |contents_new| = |contents_old| + |s|."
     :cs "The append-only property makes it safe to chain many write-string calls; each is a suffix append.")
)
  :row-5-emergence (
    (:eng-composition "(define (render-tag name attrs body)\n  (let ((p (open-output-string)))\n    (write-string \"<\" p) (write-string name p)\n    (for-each (lambda (a) (write-string \" \" p) (write-string (car a) p) (write-string \"=\\\"\" p) (write-string (cadr a) p) (write-string \"\\\"\" p)) attrs)\n    (write-string \">\" p) (write-string body p) (write-string \"</\" p) (write-string name p) (write-string \">\" p)\n    (get-output-string p)))\n(display (render-tag \"a\" (list (list \"href\" \"/x\")) \"click\"))\n(newline)"
     :math-composition "(define (concat-monoid pieces)\n  (let ((p (open-output-string)))\n    (for-each (lambda (s) (write-string s p)) pieces)\n    (get-output-string p)))\n(display (equal? (concat-monoid '(\"a\" \"b\" \"c\")) (string-append \"a\" \"b\" \"c\")))\n(newline)"
     :cs-composition "(define (csv-row-writer p fields)\n  (let loop ((rest fields) (first? #t))\n    (cond ((null? rest) (write-string \"\\n\" p))\n          (else (unless first? (write-string \",\" p))\n                (write-string (car rest) p)\n                (loop (cdr rest) #f)))))\n(define out (open-output-string))\n(csv-row-writer out '(\"id\" \"name\" \"score\"))\n(display (get-output-string out))\n(newline)"
     :base "write-string emits raw characters to a port."
     :emergent "template renderer + monoid fold + CSV row writer. All three chain write-string with control flow (loops, conditions, separator interleaving) to synthesize framed formats from unframed emissions."
     :meta "The composition chains write-string many times into one port. What emerges is the template family: framed formats built from raw pieces. Same shape as string builders in Java (StringBuilder), as bytes.Buffer in Go, as any DSL emitter. See book-of-composition ch07 on builder patterns.")
    (:eng "Named renderers turn tiny emission primitives into whole file formats without adding runtime magic."
     :math "The port + write-string pair implements the free monoid on the character alphabet: identity = empty write, associative under sequential composition."
     :cs "Same slot as strings.Builder in Go, StringBuilder in Java, bytes.Buffer, io.StringIO — every language's canonical string-assembly primitive.")
)
)

(verb :name "write-char" :std "R7RS-small"      :library "io" :tier "core" :kind "io" :signature "(write-char c [port]) -> void"
  :summary "Print a single character. R7RS §6.10.3."
  :provenance "R7RS §6.10.3; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(write-char \"a\")" :note "Prints a — one character.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string)))\n  (write-char \"x\" p)\n  (write-char \"y\" p)\n  (get-output-string p))" :note "\"xy\".")
    (:dialect "motoi" :tier "advanced" :code "(define p (open-output-string))\n(for-each (lambda (n) (write-char (integer->char n) p)) (list 72 105 33))\n(display (get-output-string p))\n(newline)" :note "Hi!  — emit chars by code point via integer->char, one write-char per glyph.")
  )
  :row-2-audit (
    (:eng-program "(define p (open-output-string))\n(write-char \"H\" p)\n(write-char \"i\" p)\n(write-char \"!\" p)\n(display (get-output-string p))\n(newline)"
     :math-program "; honest-null: write-char is an IO byte-out sink — the interesting algebraic content (length +1 per call, monoid generator) already lives in Row 4. The math view of the audit-time decision is trivial: emit-one is not a computed shape.\n(display 'honest-null-io-emit)\n(newline)"
     :cs-program "(define (write-char-safe c p) (if (char? c) (begin (write-char c p) 'ok) (error 'need-char)))\n(define p2 (open-output-string))\n(display (write-char-safe #\\Z p2))\n(newline)\n(display (get-output-string p2))\n(newline)"
     :problem "The operator is emitting one character at a time — for example, expanding an escape sequence into the byte(s) it represents. Candidates: write-char (single-char primitive), write-string with a 1-char string (equivalent but reads noisier when the code is character-oriented), and display of a character (works but has broader semantics). For character-level control, write-char is the honest primitive."
     :explanation "eng: three single-char emissions to a port; audit tape is one call, one glyph. math: honest-null — write-char is an IO emit; the algebraic story (monoid generator, length additive) lives in Row 4. cs: type-guard the char input at the emission boundary."
     :meta "Why write-char and not write-string: character-oriented code reads better character-by-character; write-string would need 1-char strings which reads noisier.")
    (:eng "Character-level emission is the right level for lexer/token emitters and low-level escape handlers."
     :math "A single-character emission is the base case of the character-stream monoid; longer emissions compose by repetition."
     :cs "Related patterns: putc in C, Writer.write(int) in Java. The single-character primitive is the finest-grain emission.")
)
  :row-3-dimension (
    (:setup "A single-glyph emit: send exactly one character to an output sink, the smallest atomic step in a character stream."
     :rungs ((:domain "io" :code "(define port (open-output-string))\n(write-char #\\a port)\n(display (get-output-string port))\n(newline)")
             (:domain "typewriter keystroke" :code "; honest-null: write-char is an IO byte-out sink — the interesting algebraic content (length +1 per call, monoid generator) already lives in Row 4. The math view of the audit-time decision is trivial: emit-one is not a computed shape.\n(display 'honest-null-io-emit)\n(newline)")
             (:domain "singleton concatenation" :code "(define (put c s) (string-append s (string c)))"))
     :explanation "In io, write-char emits one character. A typewriter strike prints one letter. In math, single-character concatenation is the atomic step of building a string. All three share: an atomic append of one glyph."
     :meta "The shape transfers wherever a character stream is built one glyph at a time — parsers, tokenizers, formatters."))
  :row-4-proof (
    (:eng-program "(define p (open-output-string))\n(write-char #\\x p)\n(write-char #\\y p)\n(write-char #\\z p)\n(define result (get-output-string p))\n(display (list 'len (string-length result) 'content result))\n(newline)"
     :math-program "(define (unit-append-holds? cs)\n  (let ((p (open-output-string)))\n    (for-each (lambda (c) (write-char c p)) cs)\n    (= (string-length (get-output-string p)) (length cs))))\n(display (unit-append-holds? '(#\\a #\\b #\\c #\\d)))\n(newline)"
     :cs-program "(define (order-preserved? cs)\n  (let ((p (open-output-string)))\n    (for-each (lambda (c) (write-char c p)) cs)\n    (equal? (string->list (get-output-string p)) cs)))\n(display (order-preserved? '(#\\M #\\O #\\T #\\O #\\I)))\n(newline)"
     :claim "n calls to write-char emit exactly n characters; a call with character c appends c and no other character."
     :invariant "∀ p, c_1..c_n. after n write-char calls: |contents(p)| = n ∧ contents(p) = c_1 c_2 ... c_n"
     :meta "The pattern is exact-count emission. CS pattern name: unit-append. What would falsify: any call emitting zero or more than one character. See book-of-code ch09.")
    (:eng "The engineering payoff is that write-char has a stable per-call cost model — one call, one character."
     :math "Emission is the atomic append of one element to the character stream (the free monoid generator on the character alphabet)."
     :cs "The primitive is a monoid generator: any string can be built by repeated write-char calls.")
)
  :row-5-emergence (
    (:eng-composition "(define (emit-escaped s p)\n  (for-each\n    (lambda (c)\n      (cond\n        ((char=? c #\\<) (write-string \"&lt;\" p))\n        ((char=? c #\\>) (write-string \"&gt;\" p))\n        (else (write-char c p))))\n    (string->list s)))\n(define out (open-output-string))\n(emit-escaped \"a<b>\" out)\n(display (get-output-string out))\n(newline)"
     :math-composition "(define (utf8-emit-cp cp p)\n  (cond ((< cp 128) (write-char (integer->char cp) p))\n        ((< cp 2048)\n         (write-char (integer->char (+ 192 (quotient cp 64))) p)\n         (write-char (integer->char (+ 128 (modulo cp 64))) p))\n        (else 'wider-not-shown)))\n(define ub (open-output-string))\n(utf8-emit-cp 65 ub)\n(utf8-emit-cp 233 ub)\n(display (string-length (get-output-string ub)))\n(newline)"
     :cs-composition "(define (rle-decode-stream p codes)\n  (for-each (lambda (pair)\n              (let ((c (car pair)) (n (cadr pair)))\n                (let loop ((i 0)) (when (< i n) (write-char c p) (loop (+ i 1))))))\n            codes))\n(define rp (open-output-string))\n(rle-decode-stream rp '((#\\a 3) (#\\b 2) (#\\c 1)))\n(display (get-output-string rp))\n(newline)"
     :base "write-char emits one character."
     :emergent "escaping transducer + UTF-8 encoder + RLE decoder. Each takes a stream of logical units (chars, code-points, run-length pairs) and translates it into 1..k physical write-char calls."
     :meta "The composition chains write-char with cond and write-string. What emerges is the escape family: per-character passthrough with substitution. Same shape as HTML/XML escapers, as URL encoders, as string-literal escapers in code generators. See book-of-composition ch07.")
    (:eng "Named per-character transducers give predictable output for any input alphabet."
     :math "The chain 'iterate over logical units → emit 1..k chars' is a homomorphism from source-alphabet-strings to output-alphabet-strings on the free monoid."
     :cs "Same slot as Unix tr, iconv, the transducer pattern in Clojure — a per-element rewrite over a stream.")
)
)

(verb :name "read-line" :std "R7RS-small"       :library "io" :tier "core" :kind "io" :signature "(read-line port) -> string | eof"
  :summary "Read one line from port. R7RS §6.10.2."
  :provenance "R7RS §6.10.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(read-line (open-input-string \"hello\\nworld\"))" :note "\"hello\" — one line, newline stripped.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-input-string \"a\\nb\\nc\")))\n  (list (read-line p) (read-line p) (read-line p)))" :note "(\"a\" \"b\" \"c\").")
  )
  :row-2-audit (
    (:eng-program "(define src (open-input-string \"alpha\\nbeta\\ngamma\"))\n(let loop ((line (read-line src)))\n  (cond ((eof-object? line) 'done)\n        (else (display (list 'read line)) (newline) (loop (read-line src)))))"
     :math-program "'honest-null-math ; read-line is an IO effect — advancing a port position and returning a delimited segment. No algebra worth naming; stream-read is a control-flow primitive, not a mathematical operation."
     :cs-program "(define p (open-input-string \"a\\nb\\nc\"))\n(define reads-before-eof 0)\n(let loop ()\n  (let ((l (read-line p)))\n    (cond ((eof-object? l) 'done)\n          (else (set! reads-before-eof (+ reads-before-eof 1)) (loop)))))\n(display (list 'lines-consumed reads-before-eof 'port-advanced 'yes))\n(newline)"
     :problem "The operator is processing a line-oriented text stream — a log file, a CSV, a config file. Candidates: read-line (grabs one line at a time, strips the newline), read-char in a loop (works but the operator has to detect newlines by hand), and read (parses S-expressions, wrong shape for text lines). For a text-line stream, read-line is the honest verb — the newline framing is handled by the primitive."
     :program "(define src (open-input-string \"alpha\\nbeta\\ngamma\"))\n(let loop ((line (read-line src)))\n  (cond\n    ((eof-object? line) 'done)\n    (else\n      (display (list 'read line))\n      (newline)\n      (loop (read-line src)))))"
     :explanation "Line 1 opens a string port. Lines 2-8 loop: read a line, if eof return 'done, else print and recurse. The audit tape shows three (read line) records then done. Newlines are stripped by the primitive; the operator never sees them."
     :meta "Why read-line and not read-char loop: the loop version would need to hand-code newline detection, which is what read-line was designed to eliminate.")
    (:eng "Text-line processing pipelines start with read-line. Always guard against eof — that is the exit condition."
     :math "The read-line function is a coroutine: each call consumes zero or more characters plus one line terminator and returns the characters preceding it."
     :cs "Related patterns: getline in C, readline in POSIX, next in Python file iteration. All rely on the newline as the record separator.")
)
  :row-3-dimension (
    (:setup "A record-delimited read: consume input up to a delimiter (newline), return the content between the last position and the delimiter."
     :rungs ((:domain "io" :code "(define src (open-input-string \"alpha\\nbeta\\ngamma\"))\n(let loop ((line (read-line src)))\n  (cond\n    ((eof-object? line) 'done)\n    (else\n      (display (list 'read line))\n      (newline)\n      (loop (read-line src)))))")
             (:domain "conveyor belt sensor" :code "(define src (open-input-string \"alpha\\nbeta\\ngamma\"))\n(let loop ((line (read-line src)))\n  (cond\n    ((eof-object? line) 'done)\n    (else\n      (display (list 'read line))\n      (newline)\n      (loop (read-line src)))))")
             (:domain "prefix parsing" :code "(define (take-until pred xs) (let loop ((rest xs) (acc (list))) (cond ((null? rest) (reverse acc)) ((pred (car rest)) (reverse acc)) (else (loop (cdr rest) (cons (car rest) acc))))))"))
     :explanation "In io, read-line consumes up to newline. On a conveyor belt, the sensor triggers on 'item complete' and hands back the item. In math/parsing, take-until is a generic delimiter-driven consumer. All three share: consume until a marker, return the prefix."
     :meta "The shape transfers wherever a stream is divided into records by an in-stream delimiter."))
  :row-4-proof (
    (:eng-program "(define src \"alpha\\nbeta\\ngamma\")\n(define p (open-input-string src))\n(define lines (let loop ((acc (list)))\n                (let ((l (read-line p)))\n                  (if (eof-object? l) (reverse acc) (loop (cons l acc))))))\n(display (list 'lines lines 'matches (equal? lines (list \"alpha\" \"beta\" \"gamma\"))))\n(newline)"
     :math-program "'honest-null-math ; the correspondence between read-line and text-split is a data-preservation claim expressed via CS witnesses, not algebraic structure."
     :cs-program "(define (read-all-lines src)\n  (let ((p (open-input-string src)))\n    (let loop ((acc '()))\n      (let ((l (read-line p)))\n        (if (eof-object? l) (reverse acc) (loop (cons l acc)))))))\n(display (list 'empty (read-all-lines \"\") 'one (read-all-lines \"solo\") 'three (read-all-lines \"a\\nb\\nc\")))\n(newline)"
     :claim "Reading all lines from a fresh port yields the newline-split segments of the original text; concatenating the lines with newline recovers a string equal to the original (modulo trailing newline)."
     :program "(define src \"alpha\\nbeta\\ngamma\")\n(define p (open-input-string src))\n(define lines (let loop ((acc (list)))\n                (let ((l (read-line p)))\n                  (if (eof-object? l) (reverse acc) (loop (cons l acc))))))\n(display lines)\n(newline)\n(display (equal? lines (list \"alpha\" \"beta\" \"gamma\")))\n(newline)"
     :invariant "∀ text without trailing newline. read-all-lines(open-input-string(text)) = split(text, '\\n')"
     :meta "The pattern is split-by-delimiter equivalence. CS pattern name: line-oriented iterator. What would falsify: a line count that does not match newline-count + 1, or content that includes the newline. See book-of-code ch09.")
    (:eng "The engineering payoff is that a text file can be safely enumerated by line without hand-coded delimiter logic."
     :math "The mapping from text to line-list is bijective on newline-free line contents."
     :cs "The iterator terminates via the eof-object sentinel — the same shape as StopIteration in Python.")
)
  :row-5-emergence (
    (:eng-composition "(define (count-lines text)\n  (let ((p (open-input-string text)))\n    (let loop ((n 0))\n      (let ((l (read-line p)))\n        (if (eof-object? l) n (loop (+ 1 n)))))))\n(display (list 'three-lines (count-lines \"a\\nb\\nc\") 'empty (count-lines \"\")))\n(newline)"
     :math-composition "'honest-null-math ; stream-drain-and-reduce is an IO-driven control-flow pattern, not algebraic composition."
     :cs-composition "(define (grep-lines pattern text)\n  (let ((p (open-input-string text)))\n    (let loop ((acc '()))\n      (let ((l (read-line p)))\n        (cond ((eof-object? l) (reverse acc))\n              ((and (>= (string-length l) (string-length pattern)) (string=? pattern (substring l 0 (string-length pattern)))) (loop (cons l acc)))\n              (else (loop acc)))))))\n(display (grep-lines \"err\" \"info\\nerr disk\\ninfo start\\nerr net\"))\n(newline)"
     :base "read-line reads one line from a port."
     :composition "(define (count-lines text)\n  (let ((p (open-input-string text)))\n    (let loop ((n 0))\n      (let ((l (read-line p)))\n        (if (eof-object? l) n (loop (+ 1 n)))))))\n(display (count-lines \"a\\nb\\nc\"))\n(newline)\n(display (count-lines \"\"))\n(newline)"
     :emergent "line counter — a small pipeline that consumes a stream by lines and produces an integer summary"
     :meta "The composition chains read-line with a loop and a counter. What emerges is the streaming-aggregate family: fold over a stream of records to a summary. Same shape as wc -l, as SQL COUNT over a table. See book-of-composition ch10 on streaming reductions.")
)
)

(verb :name "read-char" :std "R7RS-small"       :library "io" :tier "core" :kind "io" :signature "(read-char port) -> char | eof"
  :summary "Read one character. R7RS §6.10.2."
  :provenance "R7RS §6.10.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(read-char (open-input-string \"hi\"))" :note "#\\h — one CHARACTER, not a one-character string. Compare read-string, which answers a string.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-input-string \"ab\")))\n  (list (read-char p) (read-char p)))" :note "(\"a\" \"b\").")
  )
  :row-2-audit (
    (:eng-program "(define p (open-input-string \"abc\"))\n(display (list (read-char p) (read-char p) (read-char p)))\n(newline)\n(display (list 'past-end (eof-object? (read-char p))))\n(newline)"
     :math-program "'honest-null-math ; read-char is an IO effect (parser-state advancement) with no algebra. Any 'stream-preserving-consumption' framing is a CS control-flow property, not mathematical structure."
     :cs-program "(define p (open-input-string \"xyz\"))\n(define chars-read '())\n(let loop ()\n  (let ((c (read-char p)))\n    (cond ((eof-object? c) 'done)\n          (else (set! chars-read (cons c chars-read)) (loop)))))\n(display (list 'consumed-in-order (reverse chars-read) 'port-fully-drained (eof-object? (read-char p))))\n(newline)"
     :problem "The operator is writing a tokenizer that reads character-by-character with lookahead. Candidates: read-char (consuming, one char), peek-char (non-consuming look), read-line (wrong grain). The tokenizer needs both peek and consume; read-char is the consuming half. Only read-char advances the port."
     :program "(define p (open-input-string \"abc\"))\n(display (list (read-char p) (read-char p) (read-char p)))\n(newline)\n(display (eof-object? (read-char p)))\n(newline)"
     :explanation "Line 1 opens a port. Lines 2-3 read three characters and print them. Lines 4-5 confirm the fourth read returns eof. The audit tape shows every read advances by one position."
     :meta "Why read-char and not peek-char: consuming; peek would not advance the port and the loop would spin.")
    (:eng "Character-level readers are the correct grain for parsers and lexers where lookahead+consume is the operating pattern."
     :math "read-char is a coroutine: each call consumes one character and returns it."
     :cs "Related patterns: getc in C, Reader.read in Java, next() in Python iterators.")
)
  :row-3-dimension (
    (:setup "A one-glyph consume: read exactly one character from a stream and advance the read pointer."
     :rungs ((:domain "io" :code "(define p (open-input-string \"abc\"))\n(display (list (read-char p) (read-char p) (read-char p)))\n(newline)\n(display (eof-object? (read-char p)))\n(newline)")
             (:domain "conveyor pop" :code "(define p (open-input-string \"abc\"))\n(display (list (read-char p) (read-char p) (read-char p)))\n(newline)\n(display (eof-object? (read-char p)))\n(newline)")
             (:domain "unfold step" :code "(define (step! st) (let ((v (peek st))) (advance! st) v))"))
     :explanation "In io, read-char consumes one char. Popping from a belt takes the next item off. In math, an unfold-step returns the next value and advances the state. All three share: one atomic 'take one and advance.'"
     :meta "The shape transfers wherever a stream is consumed one atomic unit at a time with state advance."))
  :row-4-proof (
    (:eng-program "(define p (open-input-string \"xyz\"))\n(define a (read-char p))\n(define b (read-char p))\n(define c (read-char p))\n(define d (read-char p))\n(display (list a b c 'eof? (eof-object? d)))\n(newline)"
     :math-program "'honest-null-math ; the read-sequence-equals-port-content property is a data-preservation claim demonstrated through CS witnesses, not algebraic structure."
     :cs-program "(define (drain-to-string src)\n  (let ((p (open-input-string src)))\n    (let loop ((acc '()))\n      (let ((c (read-char p)))\n        (if (eof-object? c) (list->string (reverse acc)) (loop (cons c acc)))))))\n(display (list 'roundtrip-empty (equal? \"\" (drain-to-string \"\")) 'roundtrip-nonempty (equal? \"motoi\" (drain-to-string \"motoi\"))))\n(newline)"
     :claim "n calls to read-char consume exactly n characters (or fewer if eof is reached); the sequence of returned characters equals the port's initial content."
     :program "(define p (open-input-string \"xyz\"))\n(define a (read-char p))\n(define b (read-char p))\n(define c (read-char p))\n(define d (read-char p))\n(display (list a b c 'eof? (eof-object? d)))\n(newline)"
     :invariant "∀ port containing s_1..s_n. sequence of n read-char calls returns s_1..s_n; the (n+1)th call returns eof"
     :meta "The pattern is stream-preserving consumption. CS pattern name: consuming iterator. What would falsify: a returned character that was not in the port at that position, or a skipped position. See book-of-code ch09.")
    (:eng "The engineering payoff is that read-char is a stable primitive on which lexers can be built without concern about frame semantics."
     :math "The read sequence is the identity on the port's character stream."
     :cs "Terminates via eof-object, which is a distinct value from any character.")
)
  :row-5-emergence (
    (:eng-composition "(define (read-word p)\n  (let ((first (peek-char p)))\n    (if (eof-object? first)\n      first\n      (let loop ((acc (list)))\n        (let ((c (peek-char p)))\n          (cond\n            ((eof-object? c) (list->string (reverse acc)))\n            ((equal? c \" \") (list->string (reverse acc)))\n            (else (read-char p) (loop (cons c acc)))))))))\n(define src (open-input-string \"motoi scheme\"))\n(display (read-word src))\n(newline)"
     :math-composition "'honest-null-math ; token extraction is a parser-driven state machine, an IO/control-flow pattern, not algebraic composition."
     :cs-composition "(define (read-n p n)\n  (let loop ((k n) (acc '()))\n    (cond ((zero? k) (list->string (reverse acc)))\n          (else (let ((c (read-char p)))\n                  (if (eof-object? c) (list->string (reverse acc)) (loop (- k 1) (cons c acc))))))))\n(define src (open-input-string \"abcdef\"))\n(display (list (read-n src 3) (read-n src 100)))\n(newline)"
     :base "read-char consumes one character."
     :composition "(define (read-word p)\n  (let ((first (peek-char p)))\n    (if (eof-object? first)\n      first\n      (let loop ((acc (list)))\n        (let ((c (peek-char p)))\n          (cond\n            ((eof-object? c) (list->string (reverse acc)))\n            ((equal? c \" \") (list->string (reverse acc)))\n            (else (read-char p) (loop (cons c acc)))))))))\n(define src (open-input-string \"motoi scheme\"))\n(display (read-word src))\n(newline)"
     :emergent "tokenizer step — a routine that peeks to decide whether to consume, and consumes only when the character belongs to the token; the result is a token"
     :meta "The composition chains read-char (consume) with peek-char (decide). What emerges is the tokenizer family: peek-consume-emit-token. Same shape as tokenizers in every parser, as lookahead(1) automata. See book-of-composition ch04 on parser primitives.")
)
)

(verb :name "peek-char" :std "R7RS-small"       :library "io" :tier "core" :kind "io" :signature "(peek-char port) -> char | eof"
  :summary "Look at next char without consuming. R7RS §6.10.2."
  :provenance "R7RS §6.10.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(peek-char (open-input-string \"hi\"))" :note "#\\h — a character, seen without consuming it. The port stays at position 0.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-input-string \"xy\")))\n  (list (peek-char p) (read-char p) (read-char p)))" :note "(\"x\" \"x\" \"y\") — peek is idempotent.")
  )
  :row-2-audit (
    (:eng-program "(define p (open-input-string \"abc def\"))\n(display\n  (let loop ((tok (list)))\n    (let ((c (peek-char p)))\n      (cond ((eof-object? c) (list->string (reverse tok)))\n            ((equal? c \" \") (list->string (reverse tok)))\n            (else (read-char p) (loop (cons c tok)))))))\n(newline)"
     :math-program "'honest-null-math ; peek-char is an IO effect (non-consuming stream inspection) with no algebra. The idempotence property is a control-flow contract, expressed in CS terms."
     :cs-program "(define p (open-input-string \"xy\"))\n(define a (peek-char p))\n(define b (peek-char p))\n(define c (peek-char p))\n(define d (read-char p))\n(display (list 'peek-idempotent (and (equal? a b) (equal? b c)) 'peek-eq-read (equal? c d)))\n(newline)"
     :problem "The parser needs to decide whether to read the next character based on what it is — an alphanumeric continues the current token, a whitespace ends it. Candidates: peek-char (look, do not consume), read-char (consume, hope you can un-read), consuming and using an un-read mechanism (Motoi does not expose one). peek-char is the honest verb for lookahead."
     :program "(define p (open-input-string \"abc def\"))\n(let loop ((tok (list)))\n  (let ((c (peek-char p)))\n    (cond\n      ((eof-object? c) (list->string (reverse tok)))\n      ((equal? c \" \") (list->string (reverse tok)))\n      (else (read-char p) (loop (cons c tok))))))"
     :explanation "Line 1 opens a port with two words. Line 2 begins a loop. Line 3 peeks. Line 4 handles eof. Line 5 handles the whitespace delimiter. Line 6 consumes the char (with read-char) and adds to accumulator. The audit tape shows: peek does not advance; consume does. The loop terminates cleanly at the delimiter."
     :meta "Why peek-char and not read-char: peek allows the caller to decide, then either consume or hand off — no un-read needed.")
    (:eng "Lookahead-one parsers use peek+consume as the fundamental pair."
     :math "peek-char is idempotent: peek(port) followed by peek(port) with no intervening read returns the same character."
     :cs "Related patterns: PushbackReader in Java, ungetc in C (which is a read-then-restore pattern). Peek is the cleaner primitive.")
)
  :row-3-dimension (
    (:setup "A non-consuming look: examine the next unit of a stream without advancing the read pointer."
     :rungs ((:domain "io" :code "(define p (open-input-string \"abc def\"))\n(let loop ((tok (list)))\n  (let ((c (peek-char p)))\n    (cond\n      ((eof-object? c) (list->string (reverse tok)))\n      ((equal? c \" \") (list->string (reverse tok)))\n      (else (read-char p) (loop (cons c tok))))))")
             (:domain "chef looks at the next ticket without pulling it" :code "(define p (open-input-string \"abc def\"))\n(let loop ((tok (list)))\n  (let ((c (peek-char p)))\n    (cond\n      ((eof-object? c) (list->string (reverse tok)))\n      ((equal? c \" \") (list->string (reverse tok)))\n      (else (read-char p) (loop (cons c tok))))))")
             (:domain "identity-preserving read" :code "(define (peek-list xs) (if (null? xs) 'end (car xs)))"))
     :explanation "In io, peek-char inspects without consuming. A chef reads a ticket to decide but leaves it on the rail. In math, peeking at a list returns the head without altering the list. All three share: read without side effect on stream position."
     :meta "The shape transfers wherever a stream reader needs to make a decision before commit."))
  :row-4-proof (
    (:eng-program "(define p (open-input-string \"xy\"))\n(define a (peek-char p))\n(define b (peek-char p))\n(define c (peek-char p))\n(define d (read-char p))\n(display (list 'peeks-equal (and (equal? a b) (equal? b c)) 'peek-eq-read (equal? c d)))\n(newline)"
     :math-program "'honest-null-math ; peek-idempotence is an IO/state contract (no port mutation on peek), not an algebraic identity — the underlying claim is about port state, expressed via CS witnesses."
     :cs-program "(define p (open-input-string \"abcde\"))\n(define peeks '())\n(let loop ((n 20)) (if (zero? n) 'done (begin (set! peeks (cons (peek-char p) peeks)) (loop (- n 1)))))\n(display (list 'all-same-char (every (lambda (c) (equal? c (car peeks))) peeks) 'still-not-consumed (equal? (peek-char p) (read-char p))))\n(newline)"
     :claim "peek-char is idempotent and does not advance the port: n consecutive peek-char calls return the same character, and a subsequent read-char returns that character too."
     :program "(define p (open-input-string \"xy\"))\n(define a (peek-char p))\n(define b (peek-char p))\n(define c (peek-char p))\n(define d (read-char p))\n(display (list 'peeks (equal? a b) (equal? b c) 'read-eq (equal? c d)))\n(newline)"
     :invariant "∀ port. peek(port) followed by peek(port) returns the same character; peek(port) followed by read(port) returns the same character"
     :meta "The pattern is idempotent lookahead. CS pattern name: non-consuming peek. What would falsify: two consecutive peeks returning different characters. See book-of-code ch09 on peek/read pairs.")
    (:eng "The engineering payoff is that peek is safe to call in any decision expression; no state change."
     :math "peek ∘ peek = peek. read(peek(p) → c) then read(p) = c."
     :cs "This is the lookahead-one contract used by LL(1) parsers.")
)
  :row-5-emergence (
    (:eng-composition "(define (skip-spaces p)\n  (let loop ()\n    (let ((c (peek-char p)))\n      (cond ((eof-object? c) 'done)\n            ((equal? c \" \") (read-char p) (loop))\n            (else 'done)))))\n(define src (open-input-string \"   hello\"))\n(skip-spaces src)\n(display (read-char src))\n(newline)"
     :math-composition "'honest-null-math ; peek+consume-while is an IO control-flow pattern (parser lookahead-one), not algebraic composition."
     :cs-composition "(define (peek-classify p)\n  (let ((c (peek-char p)))\n    (cond ((eof-object? c) 'eof)\n          ((char=? c #\\space) 'whitespace)\n          ((or (char-alphabetic? c) (char-numeric? c)) 'alphanumeric)\n          (else 'punct))))\n(define src (open-input-string \"abc\"))\n(display (list (peek-classify src) 'port-untouched (char=? (peek-char src) #\\a)))\n(newline)"
     :base "peek-char returns the next character without consuming."
     :composition "(define (skip-spaces p)\n  (let loop ()\n    (let ((c (peek-char p)))\n      (cond\n        ((eof-object? c) 'done)\n        ((equal? c \" \") (read-char p) (loop))\n        (else 'done)))))\n(define src (open-input-string \"   hello\"))\n(skip-spaces src)\n(display (read-char src))\n(newline)"
     :emergent "whitespace skipper — a routine that peeks to decide whether the current character is whitespace, consuming only in that case; leaves the port ready for the next non-whitespace read"
     :meta "The composition chains peek-char (decide) with read-char (consume-if-space). What emerges is the skip-while family: consume-while-predicate. Same shape as skip-whitespace in every parser, as ltrim on streams. See book-of-composition ch04.")
)
)

(verb :name "eof-object" :std "R7RS-small"      :library "io" :tier "core" :kind "pure" :signature "(eof-object) -> eof"
  :summary "Return the EOF sentinel. R7RS §6.10."
  :provenance "R7RS §6.10; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(eof-object)" :note "The sentinel value indicating end-of-file.")
    (:dialect "motoi" :tier "intermediate" :code "(eof-object? (eof-object))" :note "#t — every eof-object is eof.")
  )
  :row-2-audit (
    (:eng-program "(define sentinel (eof-object))\n(display (eof-object? sentinel))\n(newline)\n(display (eof-object? 'eof))\n(newline)\n(display (eof-object? #f))\n(newline)"
     :math-program "'honest-null-math ; eof-object is an IO effect boundary — a sentinel token whose meaning lives in stream-consumer control flow. It has no algebraic content beyond identity, which lives in the sentinel-identity CS proof."
     :cs-program "(define candidates (list 'eof \"eof\" #f -1 (eof-object) (list) 0))\n(define (recognize x) (list x (eof-object? x)))\n(display (map recognize candidates))\n(newline)"
     :problem "The operator needs to construct a value that represents 'no more input' — perhaps to seed a test that later distinguishes eof from a real character. Candidates: eof-object (returns the canonical sentinel), a made-up symbol like 'eof (works but reads as a symbol, not the sentinel), or #f (ambiguous with legitimate values). eof-object is the honest verb — the returned value is exactly what read-char returns at end-of-input, and eof-object? recognizes it."
     :program "(define sentinel (eof-object))\n(display (eof-object? sentinel))\n(newline)\n(display (eof-object? 'eof))\n(newline)\n(display (eof-object? #f))\n(newline)"
     :explanation "eng: sentinel comes from eof-object, not ad-hoc values. math: honest-null. cs: recognize table — probe eof-object? against a spread of candidates, only the true sentinel returns #t."
     :meta "Why eof-object and not a made-up value: the sentinel has a well-known identity that IO primitives return; ad-hoc sentinels would not be recognized by eof-object?.")
    (:eng "Test fixtures that seed eof should use eof-object; ad-hoc values create false positives in eof-detection code."
     :math "The eof-object is a distinguished element of the value universe, distinct from every character and every string."
     :cs "Related patterns: EOF constant in C, StopIteration in Python, EndOfInput in Haskell.")
)
  :row-3-dimension (
    (:setup "A distinguished sentinel: a value that means 'no more' and is distinct from every other value the stream could carry."
     :rungs ((:domain "io" :code "(eof-object)")
             (:domain "end-of-line-of-people marker" :code "(define sentinel (eof-object))\n(display (eof-object? sentinel))\n(newline)\n(display (eof-object? 'eof))\n(newline)\n(display (eof-object? #f))\n(newline)")
             (:domain "Nothing / bottom" :code "(define nothing (list 'nothing))"))
     :explanation "In io, eof-object is the stream-exhausted sentinel. At a queue, the end-of-line marker is 'no one left.' In math, Nothing is the total-function value for undefined inputs. All three share: a distinguished no-more marker."
     :meta "The shape transfers wherever a stream needs an unambiguous exhaustion signal."))
  :row-4-proof (
    (:eng-program "(display (eq? (eof-object) (eof-object)))\n(newline)\n(display (eof-object? (eof-object)))\n(newline)\n(display (eof-object? 42))\n(newline)\n(display (eof-object? \"eof\"))\n(newline)"
     :math-program "'honest-null-math ; the sentinel-identity claim is a CS singleton-value contract, not an algebraic property."
     :cs-program "(define (repeated-identity n)\n  (let loop ((k n) (all-same? #t) (last (eof-object))) (cond ((zero? k) all-same?) (else (let ((r (eof-object))) (loop (- k 1) (and all-same? (eq? r last)) r))))))\n(display (repeated-identity 100))\n(newline)"
     :claim "eof-object returns the same sentinel every call; eof-object? recognizes it and rejects every other value."
     :program "(display (eq? (eof-object) (eof-object)))\n(newline)\n(display (eof-object? (eof-object)))\n(newline)\n(display (eof-object? 42))\n(newline)\n(display (eof-object? \"eof\"))\n(newline)"
     :invariant "∀ two calls. eof-object() = eof-object(); eof-object?(eof-object()) = #t; ∀ v ∉ {eof}. eof-object?(v) = #f"
     :meta "eng: stable eof detection. math: honest-null. cs: repeated-identity — 100 successive calls all return the same object.")
    (:eng "The engineering payoff is that eof detection is a stable boolean check with no false positives."
     :math "The sentinel is unique in the value universe."
     :cs "Singleton values allow constant-time recognition via reference equality.")
)
  :row-5-emergence (
    (:eng-composition "(define (read-all port)\n  (let loop ((acc (list)))\n    (let ((line (read-line port)))\n      (if (eof-object? line)\n        (reverse acc)\n        (loop (cons line acc))))))\n(display (read-all (open-input-string \"one\\ntwo\\nthree\")))\n(newline)"
     :math-composition "'honest-null-math ; the drain-until-eof shape is a control-flow pattern (loop termination on sentinel), which is a CS pattern rather than an algebra."
     :cs-composition "(define (take-until-eof port n)\n  (let loop ((k n) (acc '()))\n    (if (zero? k) (reverse acc)\n        (let ((r (read-char port))) (if (eof-object? r) (reverse acc) (loop (- k 1) (cons r acc)))))))\n(display (take-until-eof (open-input-string \"abcdef\") 100))\n(newline)"
     :base "eof-object returns the end-of-input sentinel."
     :composition "(define (read-all port)\n  (let loop ((acc (list)))\n    (let ((line (read-line port)))\n      (if (eof-object? line)\n        (reverse acc)\n        (loop (cons line acc))))))\n(display (read-all (open-input-string \"one\\ntwo\\nthree\")))\n(newline)"
     :emergent "eng: read-all — drain the port line by line until eof. math: honest-null. cs: take-until-eof — bounded consumer that also honors sentinel-driven early termination."
     :meta "The composition chains eof-object? with read-line inside a loop. What emerges is the drain family: consume-until-empty. Same shape as reading all of a file, as iterating a Python file. See book-of-composition ch10 on drain patterns.")
)
)

(verb :name "open-input-string" :std "R7RS-small"  :library "io" :tier "core" :kind "io" :signature "(open-input-string s) -> port"
  :summary "Open a read-port over string s. R7RS §6.10.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(read-line (open-input-string \"hi\\nrest\"))" :note "\"hi\".")
    (:dialect "motoi" :tier "intermediate" :code "(define p (open-input-string \"a\\nb\\nc\"))\n(list (read-line p) (read-line p) (read-line p))" :note "Consume three lines: (\"a\" \"b\" \"c\").")
    (:dialect "motoi" :tier "expert"       :code "(define (parse-lines s)\n  (let ((p (open-input-string s)))\n    (let loop ((acc '()))\n      (let ((l (read-line p)))\n        (if (eof-object? l) (reverse acc) (loop (cons l acc)))))))\n(parse-lines \"one\\ntwo\\nthree\")" :note "Split by newline via port loop: (\"one\" \"two\" \"three\")."))
  :provenance "R7RS §6.10.2; added 2026-07-18 finalization"
  :row-2-audit (
    (:eng-program "(define src \"line one\\nline two\")\n(define p (open-input-string src))\n(display (read-line p))\n(newline)\n(display (read-line p))\n(newline)"
     :math-program (#f :status "no real math use" :notes "open-input-string is a data-representation adapter (string to port). It has no algebraic content. Any 'view' framing (functorial coercion) is a stretch and would fabricate meaning.")
     :cs-program "(define (run-parser parser src)\n  (parser (open-input-string src)))\n(define (read-two-lines p) (list (read-line p) (read-line p)))\n(display (run-parser read-two-lines \"alpha\\nbeta\\ngamma\"))\n(newline)"
     :problem "The operator has a string in hand and wants to run port-based parsers (that expect a port) against it. Candidates: open-input-string (wraps the string in a port), rewriting the parser to accept a string (invasive), converting the string to a list-of-chars (loses the port shape). For running port parsers against string data, open-input-string is the honest bridge."
     :program "(define src \"line one\\nline two\")\n(define p (open-input-string src))\n(display (read-line p))\n(newline)\n(display (read-line p))\n(newline)"
     :explanation "eng: bridge string data into port-based parsers. math: honest-null. cs: dependency-inject the parser under test with a string-backed port for unit testing."
     :meta "Why open-input-string and not converting to list: the port shape lets existing parsers work unchanged.")
    (:eng "Bridge between string data and port-based code is a common integration pattern; log the wrap for debug reproducibility."
     :math "The port is a stateful view over an immutable string; the string is unchanged by port reads."
     :cs "Related patterns: StringReader in Java, io.StringIO in Python.")
)
  :row-3-dimension (
    (:setup "An adapter: take a value in one representation (string) and expose it through the interface of another (port), so code written against the other interface can consume it."
     :rungs ((:domain "io" :code "(open-input-string \"abc\")")
             (:domain "audio cassette adapter" :code "(define src \"line one\\nline two\")\n(define p (open-input-string src))\n(display (read-line p))\n(newline)\n(display (read-line p))\n(newline)")
             (:domain "coercion s: A → B" :code "(define (as-b a) (make-b a))"))
     :explanation "In io, open-input-string adapts a string to a port. A cassette adapter presents a cassette as an audio-stream. In math, coercions bridge types. All three share: same data, new interface."
     :meta "The shape transfers wherever a value in one representation must be viewed through another interface."))
  :row-4-proof (
    (:eng-program "(define src \"ab\")\n(define p1 (open-input-string src))\n(define p2 (open-input-string src))\n(display (list (read-char p1) (read-char p1) (eof-object? (read-char p1))))\n(newline)\n(display (list (read-char p2) (read-char p2) (eof-object? (read-char p2))))\n(newline)"
     :math-program (#f :status "no real math use" :notes "Adapter fidelity is a data-preservation claim, argued via CS content (equal? on characters read). No mathematical structure needed.")
     :cs-program "(define (drain-to-string p)\n  (let loop ((acc '()))\n    (let ((c (read-char p)))\n      (if (eof-object? c) (list->string (reverse acc)) (loop (cons c acc))))))\n(define src \"round-trip\")\n(display (equal? src (drain-to-string (open-input-string src))))\n(newline)"
     :claim "Reading exactly the characters of s from (open-input-string s) yields s, and the (|s|+1)th read returns eof; multiple ports over the same s are independent."
     :program "(define src \"ab\")\n(define p1 (open-input-string src))\n(define p2 (open-input-string src))\n(display (list (read-char p1) (read-char p1) (eof-object? (read-char p1))))\n(newline)\n(display (list (read-char p2) (read-char p2) (eof-object? (read-char p2))))\n(newline)"
     :invariant "∀ s. reading |s| chars from open-input-string(s) yields s; two distinct calls produce independent ports"
     :meta "eng: two ports share no cursor. math: honest-null. cs: drain-to-string round-trip is identity on the source.")
    (:eng "The engineering payoff is that string ports are safe for concurrent parsers (each with its own port)."
     :math "The port is a functional view over the string; equality on the string is preserved by round-trip through port reads."
     :cs "Independent state is what distinguishes a fresh adapter from a shared cursor.")
)
  :row-5-emergence (
    (:eng-composition "(define (parse-csv-row s)\n  (let ((p (open-input-string s)))\n    (let loop ((tok (list)) (fields (list)))\n      (let ((c (read-char p)))\n        (cond\n          ((eof-object? c) (reverse (cons (list->string (reverse tok)) fields)))\n          ((equal? c \",\") (loop (list) (cons (list->string (reverse tok)) fields)))\n          (else (loop (cons c tok) fields)))))))\n(display (parse-csv-row \"a,b,c\"))\n(newline)"
     :math-composition (#f :status "no real math use" :notes "Composition is entirely engineering (parser drivers) or CS (test fixtures). Math has no compositional use for a data-representation adapter.")
     :cs-composition "(define (fixture->lines src)\n  (let ((p (open-input-string src)))\n    (let loop ((acc '()))\n      (let ((l (read-line p)))\n        (if (eof-object? l) (reverse acc) (loop (cons l acc)))))))\n(display (fixture->lines \"alice 30\\nbob 25\\ncarol 40\"))\n(newline)"
     :base "open-input-string wraps a string as an input port."
     :composition "(define (parse-csv-row s)\n  (let ((p (open-input-string s)))\n    (let loop ((tok (list)) (fields (list)))\n      (let ((c (read-char p)))\n        (cond\n          ((eof-object? c) (reverse (cons (list->string (reverse tok)) fields)))\n          ((equal? c \",\") (loop (list) (cons (list->string (reverse tok)) fields)))\n          (else (loop (cons c tok) fields)))))))\n(display (parse-csv-row \"a,b,c\"))\n(newline)"
     :emergent "eng: in-memory CSV parser (character-driven state machine). math: honest-null. cs: fixture-loader — parse Scheme forms from an inline string for test data."
     :meta "The composition wraps a string in a port and runs port-based reads. What emerges is the in-memory parser family: same code path as file parsing, but on string sources. Same shape as parsing HTTP request bodies, as unit-testing parsers. See book-of-composition ch04 on test-time parser fixtures.")
)
)

(verb :name "open-output-string" :std "R7RS-small" :library "io" :tier "core" :kind "io" :signature "(open-output-string) -> port"
  :summary "Open a write-port to a string buffer. R7RS §6.10.2."
  :provenance "R7RS §6.10.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-output-string))\n(write-string \"hi\" p)\n(get-output-string p)" :note "\"hi\".")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string)))\n  (write 42 p)\n  (write-string \" and \" p)\n  (write 43 p)\n  (get-output-string p))" :note "\"42 and 43\".")
  )
  :row-2-audit (
    (:eng-program "(define p (open-output-string))\n(write-string \"motoi\" p)\n(write-char \"-\" p)\n(write-string \"scheme\" p)\n(display (get-output-string p))\n(newline)"
     :math-program "(define p (open-output-string))\n(display (list 'fresh-empty (equal? \"\" (get-output-string p))))\n(write-string \"a\" p)\n(write-string \"bc\" p)\n(write-string \"def\" p)\n(display (list 'monoidal-concat (equal? \"abcdef\" (get-output-string p))))\n(newline)"
     :cs-program "(define (build-string pieces)\n  (let ((p (open-output-string)))\n    (for-each (lambda (s) (write-string s p)) pieces)\n    (get-output-string p)))\n(display (list 'via-builder (build-string '(\"a\" \"b\" \"c\" \"d\")) 'via-concat (string-append \"a\" \"b\" \"c\" \"d\")))\n(newline)"
     :problem "The operator wants to build a string from many write operations without allocating an intermediate list of pieces. Candidates: open-output-string (accumulates in a port), building a list of pieces and using string-append (allocates each piece and then concatenates), or many string concatenations (quadratic). For accumulate-and-extract, the string port is the honest verb."
     :program "(define p (open-output-string))\n(write-string \"motoi\" p)\n(write-char \"-\" p)\n(write-string \"scheme\" p)\n(display (get-output-string p))\n(newline)"
     :explanation "Line 1 opens an output string port. Lines 2-4 write three pieces. Lines 5-6 extract the final string: motoi-scheme. The audit tape shows accumulation into one buffer, then one extract."
     :meta "Why open-output-string and not repeated string-append: string-append allocates a new string each call — O(n²) for n pieces. The string port amortizes.")
    (:eng "Use string ports for any accumulator-style string builder; log the extract point so a later reader knows where the buffer was consumed."
     :math "The port is a mutable stream monoid: (empty, append) form a monoid whose left identity is the empty string."
     :cs "Related patterns: StringBuilder in Java, io.StringIO in Python. The accumulator pattern is O(n) instead of O(n²).")
)
  :row-3-dimension (
    (:setup "A buffer factory: create a fresh sink that can absorb many writes and later be read out as one accumulated value."
     :rungs ((:domain "io" :code "(open-output-string)")
             (:domain "receipt paper roll" :code "(define p (open-output-string))\n(write-string \"motoi\" p)\n(write-char \"-\" p)\n(write-string \"scheme\" p)\n(display (get-output-string p))\n(newline)")
             (:domain "empty accumulator" :code "(define acc (list))"))
     :explanation "In io, open-output-string is a fresh buffer. A cash register uses a fresh receipt roll for each customer. In math, an empty accumulator is initialized to identity. All three share: fresh, empty, ready to absorb."
     :meta "The shape transfers wherever a mutable accumulator is initialized before a series of appends."))
  :row-4-proof (
    (:eng-program "(define p (open-output-string))\n(display (list 'initially-empty (= 0 (string-length (get-output-string p)))))\n(write-string \"a\" p)\n(write-string \"bc\" p)\n(display (list 'after-writes (get-output-string p)))\n(newline)"
     :math-program "(define (writes-concat-monoidally? pieces)\n  (let ((p (open-output-string)))\n    (for-each (lambda (s) (write-string s p)) pieces)\n    (equal? (get-output-string p) (apply string-append pieces))))\n(display (and (writes-concat-monoidally? '()) (writes-concat-monoidally? '(\"a\")) (writes-concat-monoidally? '(\"a\" \"b\" \"c\" \"d\"))))\n(newline)"
     :cs-program "(define p1 (open-output-string))\n(define p2 (open-output-string))\n(write-string \"one\" p1)\n(write-string \"two\" p2)\n(display (list 'independent-buffers (and (equal? \"one\" (get-output-string p1)) (equal? \"two\" (get-output-string p2))) 'distinct-refs (not (eq? p1 p2))))\n(newline)"
     :claim "A fresh (open-output-string) returns a port whose accumulated content is initially empty; each write appends without corrupting prior content."
     :program "(define p (open-output-string))\n(display (string-length (get-output-string p)))\n(newline)\n(write-string \"a\" p)\n(write-string \"bc\" p)\n(display (get-output-string p))\n(newline)"
     :invariant "∀ call. initial contents(open-output-string()) = \"\"; ∀ writes w_1..w_n. contents after = w_1 ++ ... ++ w_n"
     :meta "The pattern is monoidal accumulation. CS pattern name: builder / accumulator. What would falsify: nonempty initial content or non-associative append. See book-of-code ch09.")
    (:eng "The engineering payoff is that a fresh buffer is always empty; no leftover state from a previous run."
     :math "The buffer is the free monoid over characters; writes are the monoid operation."
     :cs "Builder pattern: many writes, one extract.")
)
  :row-5-emergence (
    (:eng-composition "(define (json-encode-list xs)\n  (let ((p (open-output-string)))\n    (write-string \"[\" p)\n    (let loop ((rest xs) (first? #t))\n      (cond\n        ((null? rest) (write-string \"]\" p))\n        (else\n          (if (not first?) (write-string \",\" p))\n          (write (car rest) p)\n          (loop (cdr rest) #f))))\n    (get-output-string p)))\n(display (json-encode-list (list 1 2 3)))\n(newline)"
     :math-composition "(define (concat-with-separator xs sep)\n  (let ((p (open-output-string)))\n    (let loop ((rest xs) (first? #t))\n      (cond ((null? rest) (get-output-string p))\n            (else (if (not first?) (write-string sep p))\n                  (write-string (car rest) p)\n                  (loop (cdr rest) #f))))))\n(display (concat-with-separator '(\"a\" \"b\" \"c\") \", \"))\n(newline)"
     :cs-composition "(define (with-output-buffer body-fn)\n  (let ((p (open-output-string)))\n    (body-fn p)\n    (get-output-string p)))\n(display (with-output-buffer (lambda (p) (write-string \"header=\" p) (write 42 p) (write-string \",body=\" p) (write 'go p))))\n(newline)"
     :base "open-output-string creates a fresh string buffer port."
     :composition "(define (json-encode-list xs)\n  (let ((p (open-output-string)))\n    (write-string \"[\" p)\n    (let loop ((rest xs) (first? #t))\n      (cond\n        ((null? rest) (write-string \"]\" p))\n        (else\n          (if (not first?) (write-string \",\" p))\n          (write (car rest) p)\n          (loop (cdr rest) #f))))\n    (get-output-string p)))\n(display (json-encode-list (list 1 2 3)))\n(newline)"
     :emergent "encoder — a routine that walks a data structure and emits its serialized form into a buffer, extracting as one string at the end"
     :meta "The composition chains open-output-string with many write calls and one get-output-string. What emerges is the encoder family: walk-then-emit. Same shape as JSON encoders, as XML serializers, as protocol-buffer writers. See book-of-composition ch07 on encoder patterns.")
)
)

(verb :name "get-output-string" :std "R7RS-small"  :library "io" :tier "core" :kind "io" :signature "(get-output-string port) -> string"
  :summary "Extract the accumulated string. R7RS §6.10.2."
  :provenance "R7RS §6.10.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((p (open-output-string)))\n  (write-string \"done\" p)\n  (get-output-string p))" :note "\"done\".")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string)))\n  (for-each (lambda (x) (write-string (number->string x) p)) (list 1 2 3))\n  (get-output-string p))" :note "\"123\".")
  )
  :row-2-audit (
    (:eng-program "(define p (open-output-string))\n(write-string \"hello \" p)\n(write-string \"world\" p)\n(display (get-output-string p))\n(newline)"
     :math-program "(define p (open-output-string))\n(define pieces '(\"a\" \"bc\" \"def\"))\n(for-each (lambda (s) (write-string s p)) pieces)\n(display (= (string-length (get-output-string p)) (apply + (map string-length pieces))))\n(newline)"
     :cs-program "(define p (open-output-string))\n(write-string \"x\" p)\n(define snap1 (get-output-string p))\n(define snap2 (get-output-string p))\n(display (equal? snap1 snap2))\n(newline)"
     :problem "The builder has been populated; the operator needs the final string. Candidates: get-output-string (extracts a snapshot), reading the port back (wrong direction — the port is write-only), or maintaining an external mirror (redundant and error-prone). For 'give me the accumulated string,' get-output-string is the honest verb."
     :program "(define p (open-output-string))\n(write-string \"hello \" p)\n(write-string \"world\" p)\n(display (get-output-string p))\n(newline)"
     :explanation "eng: extract at end-of-build. math: length is conserved under monoidal write — length(get-output-string) = Σ length(pieces). cs: extract is stable — two consecutive extracts with no intervening write yield equal strings."
     :meta "Why get-output-string and not maintaining a mirror: the port already holds the state; a mirror is redundant.")
    (:eng "Extract at the natural end-of-build; extracting mid-build is legal but resets the mental model."
     :math "The operation is the snapshot: a projection from stateful port to immutable string."
     :cs "Related patterns: StringBuilder.toString in Java, StringIO.getvalue in Python.")
)
  :row-3-dimension (
    (:setup "A snapshot extract: read the current accumulated state of a builder as an immutable value."
     :rungs ((:domain "io" :code "(define p (open-output-string))\n(write-string \"hello \" p)\n(write-string \"world\" p)\n(display (get-output-string p))\n(newline)")
             (:domain "tear off the receipt tape" :code "(define p (open-output-string))\n(write-string \"hello \" p)\n(write-string \"world\" p)\n(display (get-output-string p))\n(newline)")
             (:domain "materialize accumulator" :code "(define (final acc) acc)"))
     :explanation "In io, get-output-string materializes the port's content. A cash register tears off the receipt for the customer. In math, the accumulator is projected out at the end. All three share: snapshot the current state as a stable value."
     :meta "The shape transfers wherever a builder ends and its result becomes a first-class value."))
  :row-4-proof (
    (:eng-program "(define p (open-output-string))\n(write-string \"abc\" p)\n(define snap1 (get-output-string p))\n(define snap2 (get-output-string p))\n(display (list 'snap1 snap1 'snap2 snap2 'equal? (equal? snap1 snap2)))\n(newline)"
     :math-program "(define p (open-output-string))\n(define ws '(\"a\" \"b\" \"c\" \"de\"))\n(for-each (lambda (w) (write-string w p)) ws)\n(define result (get-output-string p))\n(define (concat xs) (apply string-append xs))\n(display (equal? result (concat ws)))\n(newline)"
     :cs-program "(define p (open-output-string))\n(write-string \"x\" p)\n(define a (get-output-string p))\n(define b (get-output-string p))\n(write-string \"y\" p)\n(define c (get-output-string p))\n(display (list 'stable-before (equal? a b) 'grew-after (not (equal? b c))))\n(newline)"
     :claim "get-output-string returns exactly the concatenation of every write to the port so far; multiple extracts return the same value if there are no intervening writes."
     :program "(define p (open-output-string))\n(write-string \"abc\" p)\n(define snap1 (get-output-string p))\n(define snap2 (get-output-string p))\n(display (list 'snap1 snap1 'snap2 snap2 'equal? (equal? snap1 snap2)))\n(newline)"
     :invariant "∀ port with writes w_1..w_n. get-output-string(port) = w_1 ++ ... ++ w_n; two consecutive extracts with no intervening write are equal"
     :meta "eng: extract is safe to call twice. math: result equals free-monoid concat of writes. cs: idempotent-until-mutated — snapshots stable before write, differ after.")
    (:eng "The engineering payoff is that extract is safe to call repeatedly."
     :math "The extract is a projection from a monoidal buffer to its collected value."
     :cs "Materialize is stable across repeated calls unless the underlying buffer is mutated.")
)
  :row-5-emergence (
    (:eng-composition "(define (with-output-buffer body-fn)\n  (let ((p (open-output-string)))\n    (body-fn p)\n    (get-output-string p)))\n(display (with-output-buffer (lambda (p) (write-string \"a=\" p) (write 42 p))))\n(newline)"
     :math-composition "(define (build-list-string xs sep)\n  (let ((p (open-output-string)))\n    (let loop ((rest xs) (first? #t))\n      (cond ((null? rest) (get-output-string p))\n            (else (if (not first?) (write-string sep p)) (write-string (car rest) p) (loop (cdr rest) #f))))))\n(display (build-list-string '(\"a\" \"b\" \"c\") \", \"))\n(newline)"
     :cs-composition "(define (log-and-return event)\n  (let ((p (open-output-string)))\n    (write-string \"[event] \" p)\n    (write event p)\n    (let ((rendered (get-output-string p)))\n      (list 'event event 'rendered rendered))))\n(display (log-and-return '(login user42)))\n(newline)"
     :base "get-output-string extracts the accumulated string from a port."
     :composition "(define (with-output-buffer body-fn)\n  (let ((p (open-output-string)))\n    (body-fn p)\n    (get-output-string p)))\n(display (with-output-buffer (lambda (p) (write-string \"a=\" p) (write 42 p))))\n(newline)"
     :emergent "eng: with-output-buffer bracket. math: separator-joined string builder — canonical free-monoid fold with interposed separators. cs: log-and-return — build a rendered form and pass it along with the original."
     :meta "The composition chains open-output-string with a body call and get-output-string. What emerges is the with-buffer family: bracketed capture. Same shape as `with StringIO() as buf` in Python, as `IO.output()` in Elixir. See book-of-composition ch03 on bracketed resource capture.")
)
)

(verb :name "close-port" :std "R7RS-small"         :library "io" :tier "core" :kind "io" :signature "(close-port port) -> void"
  :summary "Close a port. R7RS §6.10."
  :provenance "R7RS §6.10; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((p (open-input-string \"hi\")))\n  (close-port p)\n  'closed)" :note "closed.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-input-string \"\")))\n  (close-port p)\n  (port? p))" :note "#t — the port object still exists, just closed.")
  )
  :row-2-audit (
    (:eng-program "(define p (open-input-string \"data\"))\n(display (read-line p))\n(newline)\n(close-port p)\n(display 'closed)\n(newline)"
     :math-program "'honest-null-math ; close-port is an IO effect boundary — a lifecycle-transition operator on resource handles. No algebra to name."
     :cs-program "(define (safe-close p)\n  (cond ((not (port? p)) 'not-a-port)\n        (else (close-port p) 'closed)))\n(display (safe-close (open-input-string \"x\")))\n(newline)\n(display (safe-close 42))\n(newline)"
     :problem "The operator is done with a port and wants to signal that no further reads or writes should happen through it. Candidates: close-port (works for either direction), close-input-port and close-output-port (direction-specific). For a directional-agnostic close (e.g., a shared bracketed helper), close-port is the honest verb — one call, either direction."
     :program "(define p (open-input-string \"data\"))\n(display (read-line p))\n(newline)\n(close-port p)\n(display 'closed)\n(newline)"
     :explanation "eng: close after reads, log the closure. math: honest-null. cs: safe-close guards on port? before attempting the close — direction-agnostic and shape-safe."
     :meta "Why close-port and not close-input-port: close-port dispatches on direction, so a helper does not need to know which direction the port is.")
    (:eng "Close every port when done, especially those backed by system resources (files, sockets). String ports do not strictly need closing but it is good discipline."
     :math "The operation transitions the port from open state to closed state; no data is affected."
     :cs "Related patterns: close in POSIX, close() in Python, java.io.Closeable.close in Java.")
)
  :row-3-dimension (
    (:setup "A resource release: signal that a handle to a resource is no longer needed and any backing resources can be reclaimed."
     :rungs ((:domain "io" :code "(define p (open-input-string \"data\"))\n(display (read-line p))\n(newline)\n(close-port p)\n(display 'closed)\n(newline)")
             (:domain "return a library book" :code "(define p (open-input-string \"data\"))\n(display (read-line p))\n(newline)\n(close-port p)\n(display 'closed)\n(newline)")
             (:domain "release lock" :code "(define p (open-input-string \"data\"))\n(display (read-line p))\n(newline)\n(close-port p)\n(display 'closed)\n(newline)"))
     :explanation "In io, close-port releases the port. Returning a book releases the loan slot. In systems, release! frees a lock. All three share: signal 'done,' let the resource go back to a reusable state."
     :meta "The shape transfers wherever a resource has an open/close lifecycle."))
  :row-4-proof (
    (:eng-program "(define p (open-input-string \"hi\"))\n(close-port p)\n(close-port p)\n(display 'idempotent-close-ok)\n(newline)"
     :math-program "'honest-null-math ; idempotence is a CS pattern (state-transition), not an algebra worth naming for an IO release primitive."
     :cs-program "(define (double-close-safe? make)\n  (let ((p (make)))\n    (close-port p)\n    (close-port p)\n    'no-exception))\n(display (double-close-safe? (lambda () (open-input-string \"x\"))))\n(newline)\n(display (double-close-safe? (lambda () (open-output-string))))\n(newline)"
     :claim "close-port is idempotent: closing an already-closed port is a no-op (no error, no state change)."
     :program "(define p (open-input-string \"hi\"))\n(close-port p)\n(close-port p)\n(display 'idempotent-close-ok)\n(newline)"
     :invariant "∀ port. close-port(close-port(port)) = close-port(port); no exception on double-close"
     :meta "eng: safe from cleanup handlers that may double-fire. math: honest-null. cs: idempotence witness — both input and output ports survive double-close.")
    (:eng "The engineering payoff is that close is safe to call from cleanup handlers that may double-fire."
     :math "close is idempotent under composition with itself."
     :cs "Idempotent close is a standard resource-management contract.")
)
  :row-5-emergence (
    (:eng-composition "(define (with-string-port s body-fn)\n  (let ((p (open-input-string s)))\n    (let ((result (body-fn p)))\n      (close-port p)\n      result)))\n(display (with-string-port \"hello\\nworld\" (lambda (p) (read-line p))))\n(newline)"
     :math-composition "'honest-null-math ; bracket-cleanup is a resource-lifecycle CS pattern; no math to name."
     :cs-composition "(define (with-ports-batch ports body)\n  (let ((result (body)))\n    (for-each close-port ports)\n    result))\n(define p1 (open-input-string \"a\"))\n(define p2 (open-input-string \"b\"))\n(display (with-ports-batch (list p1 p2) (lambda () (list (read-char p1) (read-char p2)))))\n(newline)"
     :base "close-port releases a port."
     :composition "(define (with-string-port s body-fn)\n  (let ((p (open-input-string s)))\n    (let ((result (body-fn p)))\n      (close-port p)\n      result)))\n(display (with-string-port \"hello\\nworld\" (lambda (p) (read-line p))))\n(newline)"
     :emergent "eng: bracket helper — open, run, close. math: honest-null. cs: batch-close for a group of resources sharing a lifetime — one for-each over close-port."
     :meta "The composition chains open-input-string with close-port around a body. What emerges is the bracket family: guaranteed cleanup. Same shape as with statements in Python, as bracket in Haskell, as try/finally with close in Java. See book-of-composition ch03.")
)
)

(verb :name "close-input-port" :std "R7RS-small"   :library "io" :tier "core" :kind "io" :signature "(close-input-port port) -> void"
  :summary "Close a read-port. R7RS §6.10."
  :provenance "R7RS §6.10; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((p (open-input-string \"hi\")))\n  (close-input-port p)\n  'closed)" :note "closed.")
    (:dialect "motoi" :tier "intermediate" :code "(close-input-port (open-input-string \"anything\"))" :note "Closes cleanly.")
  )
  :row-2-audit (
    (:eng-program "(define reader (open-input-string \"data\"))\n(display (read-char reader))\n(newline)\n(close-input-port reader)\n(display 'reader-closed)\n(newline)"
     :math-program "'honest-null-math ; close-input-port is an IO effect boundary — the direction tag is documentation, the operation is a lifecycle-transition on a resource. No algebra."
     :cs-program "(define (read-and-release s)\n  (let* ((p (open-input-string s))\n         (line (read-line p)))\n    (close-input-port p)\n    line))\n(display (read-and-release \"first line\\nsecond\"))\n(newline)"
     :problem "The operator wants to explicitly close an input port and have the runtime enforce that the argument is an input port (not accidentally an output port). Candidates: close-input-port (direction-specific), close-port (direction-agnostic). For code where the direction is a documented invariant, close-input-port carries that invariant in the verb name."
     :program "(define reader (open-input-string \"data\"))\n(display (read-char reader))\n(newline)\n(close-input-port reader)\n(display 'reader-closed)\n(newline)"
     :explanation "eng: pair open-input-string with close-input-port for readable audit. math: honest-null. cs: read-and-release — encapsulate read + close in one helper."
     :meta "Why close-input-port and not close-port: the specific verb makes the direction explicit — helpful for code review.")
    (:eng "Prefer direction-specific close names in code that pairs open-input-* / close-input-* for readability."
     :math "The operation transitions an input port to closed state."
     :cs "Related patterns: close on file input streams in Java, close() on read handles in POSIX.")
)
  :row-3-dimension (
    (:setup "A direction-specific release: close an input handle, verifying at the call site that this is the input side of the resource."
     :rungs ((:domain "io" :code "(define reader (open-input-string \"data\"))\n(display (read-char reader))\n(newline)\n(close-input-port reader)\n(display 'reader-closed)\n(newline)")
             (:domain "hang up incoming call" :code "(define reader (open-input-string \"data\"))\n(display (read-char reader))\n(newline)\n(close-input-port reader)\n(display 'reader-closed)\n(newline)")
             (:domain "shut input tap" :code "(define reader (open-input-string \"data\"))\n(display (read-char reader))\n(newline)\n(close-input-port reader)\n(display 'reader-closed)\n(newline)"))
     :explanation "In io, close-input-port shuts the read side. Hanging up an incoming call closes just that direction. Closing an inlet tap shuts one input line. All three share: direction-labeled release."
     :meta "The shape transfers wherever a resource has distinguishable directions and clients want to close them individually."))
  :row-4-proof (
    (:eng-program "(define p (open-input-string \"hi\"))\n(close-input-port p)\n(close-input-port p)\n(display 'ok)\n(newline)"
     :math-program "'honest-null-math ; idempotence of an IO release is a CS lifecycle property, not an algebra."
     :cs-program "(define p (open-input-string \"hi\"))\n(close-input-port p)\n(define double-close-ok? 'no-exception-on-second-close)\n(close-input-port p)\n(display double-close-ok?)\n(newline)"
     :claim "close-input-port closes only input ports; on an input port it is idempotent."
     :program "(define p (open-input-string \"hi\"))\n(close-input-port p)\n(close-input-port p)\n(display 'ok)\n(newline)"
     :invariant "∀ input-port. close-input-port is idempotent; the direction guard is documentary in Motoi (dynamically typed)"
     :meta "eng: direction is documented at call site. math: honest-null. cs: double-close survives with no exception.")
    (:eng "The engineering payoff is that the name documents the direction at the call site."
     :math "close-input-port is idempotent as a state transition on input ports."
     :cs "The direction tag is a naming convention, not a static type guarantee in dynamically-typed Scheme.")
)
  :row-5-emergence (
    (:eng-composition "(define (drain-and-close p)\n  (let loop ((acc (list)))\n    (let ((line (read-line p)))\n      (cond\n        ((eof-object? line)\n         (close-input-port p)\n         (reverse acc))\n        (else (loop (cons line acc)))))))\n(display (drain-and-close (open-input-string \"a\\nb\\nc\")))\n(newline)"
     :math-composition "'honest-null-math ; drain-and-close is a control-flow shape (loop terminates on sentinel then releases), no algebra."
     :cs-composition "(define (with-reader s body)\n  (let ((p (open-input-string s)))\n    (let ((result (body p)))\n      (close-input-port p)\n      result)))\n(display (with-reader \"a\\nb\\nc\" (lambda (p) (list (read-line p) (read-line p) (read-line p)))))\n(newline)"
     :base "close-input-port releases an input port."
     :composition "(define (drain-and-close p)\n  (let loop ((acc (list)))\n    (let ((line (read-line p)))\n      (cond\n        ((eof-object? line)\n         (close-input-port p)\n         (reverse acc))\n        (else (loop (cons line acc)))))))\n(display (drain-and-close (open-input-string \"a\\nb\\nc\")))\n(newline)"
     :emergent "eng: drain-and-close pattern. math: honest-null. cs: with-reader bracket — scoped input-port lifecycle around a body function."
     :meta "The composition chains read-line, close-input-port, and a loop. What emerges is the drain family: read to end, release, return. Same shape as file-to-list helpers. See book-of-composition ch10.")
)
)

(verb :name "close-output-port" :std "R7RS-small"  :library "io" :tier "core" :kind "io" :signature "(close-output-port port) -> void"
  :summary "Close a write-port. R7RS §6.10."
  :provenance "R7RS §6.10; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((p (open-output-string)))\n  (close-output-port p)\n  'closed)" :note "closed.")
    (:dialect "motoi" :tier "intermediate" :code "(close-output-port (open-output-string))" :note "Closes cleanly.")
  )
  :row-2-audit (
    (:eng-program "(define writer (open-output-string))\n(write-string \"payload\" writer)\n(define captured (get-output-string writer))\n(close-output-port writer)\n(display captured)\n(newline)"
     :math-program "'honest-null-math ; close-output-port is an IO effect boundary. The direction tag is documentation; the operation is a lifecycle transition. No algebra."
     :cs-program "(define (build-render body)\n  (let ((p (open-output-string)))\n    (body p)\n    (let ((result (get-output-string p)))\n      (close-output-port p)\n      result)))\n(display (build-render (lambda (p) (write-string \"result=\" p) (write 42 p))))\n(newline)"
     :problem "The operator wants to close a write port and mark that the direction is documented at the call site. Candidates: close-output-port (direction-specific), close-port (agnostic). For code that pairs open-output-string with a matching close, the direction-specific close is the honest verb — the invariant is visible in the name."
     :program "(define writer (open-output-string))\n(write-string \"payload\" writer)\n(define captured (get-output-string writer))\n(close-output-port writer)\n(display captured)\n(newline)"
     :explanation "eng: writer role documented at close site. math: honest-null. cs: build-render bracket — write body, extract, close in one helper."
     :meta "Why close-output-port and not close-port: explicit direction improves reviewability.")
    (:eng "Prefer direction-specific close names in writer-side code paths."
     :math "The operation transitions an output port to closed state."
     :cs "Related patterns: close on file output streams in Java, close() on write handles in POSIX.")
)
  :row-3-dimension (
    (:setup "A direction-specific release for the write side."
     :rungs ((:domain "io" :code "(define writer (open-output-string))\n(write-string \"payload\" writer)\n(define captured (get-output-string writer))\n(close-output-port writer)\n(display captured)\n(newline)")
             (:domain "sign the letter and seal it" :code "(define writer (open-output-string))\n(write-string \"payload\" writer)\n(define captured (get-output-string writer))\n(close-output-port writer)\n(display captured)\n(newline)")
             (:domain "commit stream" :code "(define writer (open-output-string))\n(write-string \"payload\" writer)\n(define captured (get-output-string writer))\n(close-output-port writer)\n(display captured)\n(newline)"))
     :explanation "In io, close-output-port shuts the write side. Sealing an envelope closes the write side of a physical channel. Committing a stream signals no more writes. All three share: direction-labeled release."
     :meta "The shape transfers wherever a resource has a write side that clients want to close individually."))
  :row-4-proof (
    (:eng-program "(define p (open-output-string))\n(write-string \"a\" p)\n(close-output-port p)\n(close-output-port p)\n(display 'ok)\n(newline)"
     :math-program "'honest-null-math ; idempotence of an IO release is a CS lifecycle property, not an algebraic structure."
     :cs-program "(define p (open-output-string))\n(write-string \"content\" p)\n(define captured (get-output-string p))\n(close-output-port p)\n(close-output-port p)\n(display (list 'captured captured 'double-close-ok? 'yes))\n(newline)"
     :claim "close-output-port closes only output ports; on an output port it is idempotent."
     :program "(define p (open-output-string))\n(write-string \"a\" p)\n(close-output-port p)\n(close-output-port p)\n(display 'ok)\n(newline)"
     :invariant "∀ output-port. close-output-port is idempotent"
     :meta "eng: direction name documents at call site. math: honest-null. cs: extract-then-close-twice — captured content preserved, double-close succeeds.")
    (:eng "The engineering payoff is that the name documents the direction."
     :math "close-output-port is idempotent."
     :cs "Direction is a naming convention, not a static type in Motoi.")
)
  :row-5-emergence (
    (:eng-composition "(define (render-and-close render-fn)\n  (let ((p (open-output-string)))\n    (render-fn p)\n    (let ((s (get-output-string p)))\n      (close-output-port p)\n      s)))\n(display (render-and-close (lambda (p) (write-string \"hello\" p) (write-char \"!\" p))))\n(newline)"
     :math-composition "'honest-null-math ; render-and-close is a resource-lifecycle CS pattern, not an algebra."
     :cs-composition "(define (batch-render items renderer)\n  (map (lambda (item)\n         (let ((p (open-output-string)))\n           (renderer p item)\n           (let ((s (get-output-string p)))\n             (close-output-port p)\n             s)))\n       items))\n(display (batch-render '(1 2 3) (lambda (p n) (write-string \"item-\" p) (write n p))))\n(newline)"
     :base "close-output-port releases an output port."
     :composition "(define (render-and-close render-fn)\n  (let ((p (open-output-string)))\n    (render-fn p)\n    (let ((s (get-output-string p)))\n      (close-output-port p)\n      s)))\n(display (render-and-close (lambda (p) (write-string \"hello\" p) (write-char \"!\" p))))\n(newline)"
     :emergent "eng: render-and-close bracket. math: honest-null. cs: batch-render — one port per item, closed after each extract, all renders returned as a list."
     :meta "The composition chains open-output-string, a body, get-output-string, and close-output-port. What emerges is the render-with-cleanup family: build, extract, release. Same shape as templating engines' render-to-string. See book-of-composition ch07.")
)
)

(verb :name "with-output-to-string" :std "R7RS-small" :library "io" :tier "core" :kind "io" :signature "(with-output-to-string thunk) -> string"
  :summary "Capture output of thunk as a string. SRFI-6 / R7RS §6.10.3."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-output-to-string (lambda () (display \"hi\")))" :note "\"hi\".")
    (:dialect "motoi" :tier "intermediate" :code "(with-output-to-string\n  (lambda ()\n    (for-each (lambda (n) (display n) (display \" \")) '(1 2 3 4))))" :note "Capture a for-each's stream: \"1 2 3 4 \".")
    (:dialect "motoi" :tier "expert"       :code "(define (pretty-print-alist a)\n  (with-output-to-string\n    (lambda ()\n      (for-each (lambda (kv)\n                  (display (car kv)) (display \" = \") (display (cadr kv))\n                  (newline))\n                a))))\n(pretty-print-alist '((name \"alice\") (age 30)))" :note "Multi-line rendering captured as one string."))
  :provenance "SRFI-6 / R7RS §6.10.3; added 2026-07-18 finalization"
  :row-2-audit (
    (:eng-program "(define captured\n  (with-output-to-string\n    (lambda ()\n      (display \"line1\") (newline)\n      (display \"line2\") (newline))))\n(display captured)"
     :math-program (#f :status "no real math use" :notes "with-output-to-string is a dynamic-scoping construct on an ambient port. It has no algebraic content — its meaning lives in the runtime's parameter mechanism, not in mathematics.")
     :cs-program "(define (assert-output expected thunk)\n  (let ((actual (with-output-to-string thunk)))\n    (if (equal? actual expected)\n      'pass\n      (list 'fail 'want expected 'got actual))))\n(display (assert-output \"hi\" (lambda () (display \"hi\"))))\n(newline)"
     :problem "The operator has a body of code that writes to the default output port (via display, write, etc.) and wants to capture its output as a string without editing the body to accept a port. Candidates: with-output-to-string (redirect + capture), rewriting the body to accept a port arg (invasive), maintaining a shadow buffer manually (error-prone). For capturing default-port output as a string, with-output-to-string is the honest wrapper."
     :program "(define captured\n  (with-output-to-string\n    (lambda ()\n      (display \"line1\") (newline)\n      (display \"line2\") (newline))))\n(display captured)"
     :explanation "eng: capture rendering output of unmodified code. math: honest-null. cs: test-assertion primitive — compare captured output against expected."
     :meta "Why with-output-to-string and not open-output-string + write-string: the wrapper redirects the DEFAULT port so unmodified code writes to the buffer without knowing.")
    (:eng "Use with-output-to-string in tests to capture the output of code that would otherwise print to stdout — makes assertions about output possible."
     :math "The wrapper is a dynamic binding of the current-output-port parameter to a string port for the duration of the thunk."
     :cs "Related patterns: capsys.readouterr() in pytest, contextlib.redirect_stdout in Python, ByteArrayOutputStream in Java test harnesses.")
)
  :row-3-dimension (
    (:setup "A dynamic redirect: temporarily rewire the default output sink to an in-memory buffer for the duration of a body, then restore."
     :rungs ((:domain "io" :code "(define captured\n  (with-output-to-string\n    (lambda ()\n      (display \"line1\") (newline)\n      (display \"line2\") (newline))))\n(display captured)")
             (:domain "recording booth" :code "(define captured\n  (with-output-to-string\n    (lambda ()\n      (display \"line1\") (newline)\n      (display \"line2\") (newline))))\n(display captured)")
             (:domain "dynamic-wind + parameterize" :code "(define (with-p p v thunk) (dynamic-wind (lambda () (set! p v)) thunk (lambda () (set! p prior))))"))
     :explanation "In io, the wrapper redirects the default port. In a recording booth, the microphone is rerouted to a tape. In Scheme dynamic scoping, parameterize temporarily rebinds a parameter. All three share: temporary rebind of an implicit destination, restore on exit."
     :meta "The shape transfers wherever a system has an ambient destination that clients want to redirect for a bounded scope."))
  :row-4-proof (
    (:eng-program "(define captured (with-output-to-string (lambda () (display \"abc\"))))\n(display (equal? captured \"abc\"))\n(newline)\n(display \"still writing to default port\")\n(newline)"
     :math-program (#f :status "no real math use" :notes "Restoration invariant is dynamic-scoping behavior. Verified by an operational test (cs), not an algebraic argument.")
     :cs-program "(define outside-1 (with-output-to-string (lambda () (display \"a\"))))\n(define outside-2 (with-output-to-string (lambda ()\n                                            (display (with-output-to-string (lambda () (display \"inner\"))))\n                                            (display \" outer\"))))\n(display (list outside-1 outside-2))\n(newline)"
     :claim "with-output-to-string returns a string equal to what the thunk would have written to the default output port; the default output port is restored after the call."
     :program "(define captured (with-output-to-string (lambda () (display \"abc\"))))\n(display (equal? captured \"abc\"))\n(newline)\n(display \"still writing to default port\")\n(newline)"
     :invariant "∀ thunk. with-output-to-string(thunk) = string of every default-port write inside thunk; after the call, current-output-port is restored"
     :meta "eng: surrounding code unaffected. math: honest-null. cs: nested wrappers each capture their own thunk — no cross-contamination between scopes.")
    (:eng "The engineering payoff is that surrounding code is unaffected by what happens inside the wrapper."
     :math "The dynamic binding is a bracketed transformation of the ambient port parameter."
     :cs "The wrap is safe against exceptions if implemented with dynamic-wind: restore even on abnormal exit.")
)
  :row-5-emergence (
    (:eng-composition "(define (assert-prints expected thunk)\n  (let ((actual (with-output-to-string thunk)))\n    (if (equal? expected actual)\n      'pass\n      (list 'fail 'expected expected 'actual actual))))\n(display (assert-prints \"hello\" (lambda () (display \"hello\"))))\n(newline)\n(display (assert-prints \"hello\" (lambda () (display \"world\"))))\n(newline)"
     :math-composition (#f :status "no real math use" :notes "Composition is entirely test-harness / rendering-capture. No mathematical composition wants a stdout capture.")
     :cs-composition "(define (log-with-timestamp fn)\n  (lambda args\n    (let ((out (with-output-to-string (lambda () (apply fn args)))))\n      (display (list 'ts 'now 'output out))\n      (newline))))\n(define traced (log-with-timestamp\n                (lambda (x) (display \"processing \") (display x))))\n(traced 42)"
     :base "with-output-to-string captures thunk output as a string."
     :composition "(define (assert-prints expected thunk)\n  (let ((actual (with-output-to-string thunk)))\n    (if (equal? expected actual)\n      'pass\n      (list 'fail 'expected expected 'actual actual))))\n(display (assert-prints \"hello\" (lambda () (display \"hello\"))))\n(newline)\n(display (assert-prints \"hello\" (lambda () (display \"world\"))))\n(newline)"
     :emergent "eng: output-assertion test primitive. math: honest-null. cs: logging decorator — capture what a function prints, then log it with metadata."
     :meta "The composition chains with-output-to-string with an equality check. What emerges is the output-assertion family: unit-test primitives that watch what a thunk prints. Same shape as pytest capsys, as RSpec output matcher. See book-of-composition ch15 on test primitives.")
)
)

(verb :name "with-input-from-string" :std "R7RS-small" :library "io" :tier "core" :kind "io" :signature "(with-input-from-string s thunk) -> value"
  :summary "Pass a string-input-port to thunk (thunk receives port as arg)."
  :provenance "R7RS §6.10.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(with-input-from-string \"hello\" (lambda () (read-line)))" :note "\"hello\".")
    (:dialect "motoi" :tier "intermediate" :code "(with-input-from-string \"a\\nb\" (lambda () (list (read-line) (read-line))))" :note "(\"a\" \"b\").")
    (:dialect "motoi" :tier "advanced" :code "(let ((p (open-input-string \"line-one\\nline-two\")))\n  (display (list (read-line p) (read-line p))))" :note "(\"line-one\" \"line-two\") — open-input-string gives direct port access.")
  )
  :row-2-audit (
    (:problem "The operator has a body of code that reads from the default input port (read, read-line, read-char) and wants to feed it a fixed string for testing. Candidates: with-input-from-string (redirect + supply), rewriting the body to accept a port arg (invasive), passing the port explicitly (loses the ambient-port idiom). For running default-port readers against a string source, with-input-from-string is the honest wrapper."
     :program "(define parsed\n  (with-input-from-string \"line-a\\nline-b\"\n    (lambda () (list (read-line) (read-line)))))\n(display parsed)\n(newline)"
     :explanation "Lines 1-3 wrap a thunk that reads two lines from the default input port. The wrapper rebinds the default input port to a string port over the given string, runs the thunk, and returns its result. Lines 4-5 print the parsed list. The audit tape shows: one wrap, two reads captured against the fixed source."
     :meta "Why with-input-from-string and not open-input-string plus explicit port: the wrapper rebinds the DEFAULT input port so unmodified code reads the string.")
    (:eng "Use with-input-from-string in tests to feed predetermined input to code that would otherwise read from stdin."
     :math "The wrapper is a dynamic binding of the current-input-port parameter for the duration of the thunk."
     :cs "Related patterns: monkeypatch stdin in pytest, sys.stdin substitution in Python, ByteArrayInputStream in Java test harnesses."
     :eng-program "(define (run-calculator src)\n  (let* ((parts (string-split src))\n         (a (string->number (list-ref parts 0)))\n         (op (string->symbol (list-ref parts 1)))\n         (b (string->number (list-ref parts 2))))\n    (case op\n      ((+) (+ a b))\n      ((*) (* a b))\n      (else 'unknown))))\n(display (run-calculator \"3 + 4\"))\n(newline)\n(display (run-calculator \"6 * 7\"))\n(newline)"
     :eng-program-notes "Engineering decision: a reader-based body (three reads) is exercised twice against two fixed inputs without touching stdin — the with-input-from-string wrapper is what makes the untouched reader deterministic in a test."
     :math-program #f
     :math-program-status "honest-null"
     :math-program-notes "Row 2 asks WHEN to reach for this verb. The choice between with-input-from-string and open-input-string+explicit-port is an engineering judgment about ambient vs explicit ports; there is no theorem to state and check as a program. The math angle here is the prose :math above (dynamic parameter binding), which is not a runnable proof. Honest-null rather than a fabricated numeric demo."
     :cs-program "(define (count-lines src)\n  (let ((p (open-input-string src)))\n    (let loop ((n 0))\n      (if (eof-object? (read-line p)) n (loop (+ n 1))))))\n(display (count-lines \"a\\nb\\nc\\nd\\ne\"))\n(newline)"
     :cs-program-notes "CS angle: with-input-from-string turns a stream-consuming loop (read until eof) into a bounded, repeatable unit — the string is the whole tape, so the token count is deterministic.")
)
  :row-3-dimension (
    (:setup "A dynamic input redirect: temporarily rewire the default input source to an in-memory string for the duration of a body, then restore."
     :rungs ((:domain "io" :code "(define parsed\n  (with-input-from-string \"line-a\\nline-b\"\n    (lambda () (list (read-line) (read-line)))))\n(display parsed)\n(newline)")
             (:domain "phone recording playback" :code "(define parsed\n  (with-input-from-string \"line-a\\nline-b\"\n    (lambda () (list (read-line) (read-line)))))\n(display parsed)\n(newline)")
             (:domain "dynamic-wind + parameterize" :code "(define (with-p p v thunk) (dynamic-wind (lambda () (set! p v)) thunk (lambda () (set! p prior))))"))
     :explanation "In io, the wrapper rebinds the default input port. Playing back a phone recording feeds a recorded call into an operator's headset in place of a live call. In Scheme dynamic scoping, parameterize temporarily rebinds a parameter. All three share: temporary rebind of an implicit source."
     :meta "The shape transfers wherever a system has an ambient source that clients want to redirect for a bounded scope."))
  :row-4-proof (
    (:claim "with-input-from-string exposes exactly the characters of s to the thunk via the default input port; after the call, the default input port is restored."
     :program "(define result (with-input-from-string \"abc\" (lambda () (list (read-char) (read-char) (read-char) (eof-object? (read-char))))))\n(display result)\n(newline)"
     :invariant "∀ s thunk. inside the call: current-input-port yields the characters of s in order, then eof; after the call, current-input-port is restored"
     :meta "The pattern is scoped input redirect with restore. CS pattern name: dynamic binding. What would falsify: the default input port not being restored after the call, or the thunk seeing characters not in s. See book-of-code ch09.")
    (:eng "The engineering payoff is deterministic input for tests."
     :math "The wrap is a bracketed rebind of the ambient input parameter."
     :cs "Safe against exceptions if implemented with dynamic-wind."
     :eng-program "(define observed\n  (with-input-from-string \"one\\ntwo\\nthree\"\n    (lambda ()\n      (list (read-line) (read-line) (read-line) (eof-object? (read-line))))))\n(define restored-ok (string? (with-input-from-string \"after\" (lambda () (read-line)))))\n(display (list 'observed observed 'restored restored-ok))\n(newline)"
     :eng-program-notes "Demonstrates both halves of the claim: inside the call the thunk sees exactly the lines of s then eof; a second independent call still works, evidence the default input port was restored (not left pointing at a consumed string)."
     :math-program #f
     :math-program-status "honest-null"
     :math-program-notes "The row-4 math slot would state the char-exposure invariant (∀s. char-by-char read to eof reconstructs exactly s) as a runnable equality-checking program. Honest-null here for two composing reasons: (1) it is a restatement of the same eof/exposure property the :eng-program already demonstrates, and (2) in the current motoi runtime the datum/char reader family (read, read-char) returns opaque objects that char? rejects and list->string does not reconstruct, so an equality-witness program would print a FALSE-looking (#f ...) result and misrepresent the spec-level claim as failing. Rather than ship a demo that reads as a broken proof, the invariant is stated in the :invariant + :math prose above; no truthful runnable witness is available. See keep-broken-lane-output doctrine (2026-07-24)."
     :cs-program "(define (restored-after-error?)\n  (guard (e (#t #t))\n    (with-input-from-string \"boom\" (lambda () (error \"deliberate\"))))\n  (string=? \"still-here\"\n    (with-input-from-string \"still-here\" (lambda () (read-line)))))\n(display (restored-after-error?))\n(newline)"
     :cs-program-notes "Falsification probe for the restore claim under exceptions: the first wrapped thunk raises, the guard swallows it, and a fresh call must still read cleanly. #t means the port was restored even on the error path (dynamic-wind semantics).")
)
  :row-5-emergence (
    (:base "with-input-from-string runs a thunk with a fixed string as the default input."
     :composition "(define (parse-and-echo s)\n  (with-input-from-string s\n    (lambda ()\n      (let loop ((acc (list)))\n        (let ((l (read-line)))\n          (if (eof-object? l)\n            (reverse acc)\n            (loop (cons (string-upcase l) acc))))))))\n(display (parse-and-echo \"hello\\nworld\"))\n(newline)"
     :emergent "test fixture — a bounded scope where a predetermined input string is fed to code that reads from stdin-like defaults, producing a determined output"
     :meta "The composition wraps read-line-based code with a fixed input. What emerges is the test-fixture family: hermetic per-test input source. Same shape as sandboxed stdin fixtures in Python's monkeypatch. See book-of-composition ch15.")
)
)

(verb
  :name "newline" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(newline [port]) -> unspecified"
  :summary "Write one end-of-line to port, or to the current output port when port is omitted."
  :explanation "The line break, and the verb a beginner needs on the second line of the first program they ever write. R7RS-small 6.13.3 says newline writes 'an end of line' and deliberately leaves the exact characters to the operating system; Motoi pins it down: exactly ONE character, U+000A, on every platform, never a carriage return and never a pair. That is why captured output in this reference is byte-comparable and why (string-length (with-output-to-string (lambda () (newline)))) is 1 and not 2. The thing to learn first is that display does not add a line break and neither does write. Every line break in Motoi output is a separate, explicit call, which is why nearly every example in this book is a display followed by a newline. The return value is unspecified, so newline is called for its effect and never for its value."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display \"hi\")\n(newline)" :note "hi followed by one line break -- display printed the h and the i and stopped, and the break is the second call.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (equal? (with-output-to-string (lambda () (newline))) \"\\n\")\n               (string-length (with-output-to-string (lambda () (newline))))))\n(newline)" :note "(#t 1) -- captured into a string, newline is exactly the one-character string \"\\n\".")
    (:dialect "motoi" :tier "expert" :code "(define p (open-output-string))\n(for-each (lambda (row) (display row p) (newline p)) (list \"alpha\" \"beta\" \"gamma\"))\n(display (get-output-string p))" :note "alpha, beta and gamma on three lines, with a trailing break after gamma. The optional port argument is what lets the same idiom fill a buffer instead of the console.")
  )
  :caveats ("It emits exactly one character, U+000A. Motoi never emits a carriage return, so output captured on one machine compares byte-for-byte with output captured on another." "It returns an unspecified value. Writing (list (newline)) still EMITS the break during evaluation and then holds a value that prints as nothing -- the break lands BEFORE the list, which reads like a bug in the list." "Neither display nor write adds a line break. If output runs together on one line, a newline call is missing, not misbehaving." "On a binary port it writes the byte 10, because textual output to a binary port is encoded rather than refused." "A closed output port still accepts it. close-port flips output-port-open? to #f but does not stop the writes.")
  :usecases ("Terminating a line of console output -- the second half of the display/newline pair." "Building a multi-line buffer through a string port." "Separating records in an append-only log written with write.")
  :related ("display" "write" "write-string" "write-char" "with-output-to-string")
  :learn (:concept "Output is a stream of characters with no implied structure: a line exists only because something wrote a line break into the stream." :prerequisites ("display" "open-output-string") :progression "Meet display first so there is something to terminate, then newline, then with-output-to-string so you can SEE the break as a character instead of inferring it from the screen.")
  :provenance "R7RS-small 6.13.3; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (report rows)\n  (for-each (lambda (r) (display (car r)) (display \": \") (display (cdr r)) (newline)) rows))\n(report (list (cons 'fuel 88) (cons 'heat 21) (cons 'load 3)))"
     :math-program "(define (break-count n)\n  (string-length (with-output-to-string (lambda () (let loop ((i 0)) (if (< i n) (begin (newline) (loop (+ i 1)))))))))\n(display (map break-count (list 0 1 2 5)))\n(newline)"
     :cs-program "(define (println x) (display x) (newline))\n(define (println-to x p) (display x p) (newline p))\n(define buf (open-output-string))\n(println-to 'buffered buf)\n(println (list 'buffer-holds (get-output-string buf)))"
     :problem "The operator is printing a key/value report to the console and needs each pair on its own line. Candidates: newline (one call, one break, portable), (display \"\\n\") (works, but hides the break inside a string literal where a stray space is invisible), and (write-string \"\\n\") (same objection plus it commits to the string type). For 'end this line', newline is the honest verb -- it names the intent, and there is no literal to typo."
     :explanation "eng: a key/value report, one newline per row. math: n newline calls put exactly n characters into the capture, for every n. cs: println built by pairing display with newline -- the two-arg form threads the same pattern through an explicit port."
     :meta "Why newline and not (display \"\\n\"): they emit the identical byte, so the choice is about readability, not behaviour. A newline call cannot silently acquire a trailing space; a string literal can, and that bug survives code review because whitespace is invisible.")
    (:eng "A report loop that ends each row with newline can be redirected to a buffer by adding one port argument -- no rewriting of the line logic."
     :math "Emission is additive: n calls yield n characters, so the count of breaks in captured output equals the count of calls."
     :cs "Related patterns: println in Java, print() in Python, endl in C++ (which also flushes -- Motoi's newline does not, because there is nothing to flush)."))
  :row-3-dimension (
    (:setup "A record terminator: an agreed mark pushed into an otherwise unstructured stream so that a reader downstream can tell where one unit ends and the next begins."
     :rungs ((:domain "io" :code "(define p (open-output-string))\n(display \"a\" p) (newline p) (display \"b\" p) (newline p)\n(display (string-length (get-output-string p)))\n(newline)")
             (:domain "the carriage return lever on a mechanical typewriter" :code "(define (type-row cells) (for-each (lambda (c) (display c) (display \" \")) cells) (newline))\n(for-each type-row (list (list 'a 'b) (list 'c 'd)))")
             (:domain "a delimiter in a sequence, where the delimiter count is one less than -- or equal to -- the field count" :code "(define (breaks-in s)\n  (let loop ((i 0) (n 0))\n    (if (>= i (string-length s)) n\n        (loop (+ i 1) (if (equal? (substring s i (+ i 1)) \"\\n\") (+ n 1) n)))))\n(define text (with-output-to-string (lambda () (display \"a\") (newline) (display \"b\") (newline))))\n(display (list 'chars (string-length text) 'breaks (breaks-in text)))\n(newline)"))
     :explanation "In io, newline is the mark that ends a line. On a typewriter, the carriage return lever does the same job physically -- the characters were already on the page, and the lever declares that the row is finished. In a delimited sequence, a separator is what turns one long run of symbols into countable fields; count the separators and you know how many records passed. All three share: the unit is not visible in the data, it is created by an agreed mark, and the mark is emitted by a deliberate act."
     :meta "The shape transfers wherever a stream carries no inherent boundaries and both writer and reader must agree on a terminator. Get the agreement wrong -- a trailing terminator the reader does not expect -- and the last record splits in two.")
    (:eng "Terminating rather than separating is the more forgiving convention: every row ends the same way, so appending a row never requires looking at what came before."
     :math "Four characters of payload and two breaks make six characters -- length is the sum, so counting breaks recovers the row count exactly."
     :cs "The trailing-newline argument is real: POSIX text files end with one, many parsers emit a phantom empty final field when they do not expect it."))
  :row-4-proof (
    (:eng-program "(define (emit-breaks n)\n  (with-output-to-string (lambda () (let loop ((i 0)) (if (< i n) (begin (newline) (loop (+ i 1))))))))\n(display (map (lambda (n) (= (string-length (emit-breaks n)) n)) (list 0 1 2 7)))\n(newline)"
     :math-program "(define (cap thunk) (with-output-to-string thunk))\n(define a (cap (lambda () (display \"x\") (newline))))\n(define b (cap (lambda () (display \"x\") (display \"\\n\"))))\n(define c (cap (lambda () (display \"x\") (write-char #\\newline))))\n(display (list 'all-equal (and (equal? a b) (equal? b c)) 'len (string-length a)))\n(newline)"
     :cs-program "(define text (with-output-to-string (lambda () (newline))))\n(display (list 'len (string-length text)\n               'is-linefeed (equal? text \"\\n\")\n               'has-carriage-return (equal? text \"\\r\\n\")))\n(newline)"
     :claim "newline emits exactly one character, that character is U+000A, and n calls contribute exactly n characters to the stream -- identically to (display \"\\n\") and (write-char #\\newline)."
     :invariant "For all n >= 0. |capture(newline repeated n times)| = n; and capture(newline) = \"\\n\""
     :meta "The pattern is a fixed-width emission. What would falsify it: a two-character CRLF on some platform, a call that emitted nothing, or a divergence between newline and the explicit character. The CRLF case is the one that actually bites -- it is why the third program tests for it directly rather than only asserting the length.")
    (:eng "The counting program is the regression test: zero calls must yield an empty capture, which is the case a length-based check silently passes for the wrong reason."
     :math "Additivity is what makes byte budgets predictable -- a table of r rows costs exactly r break characters beyond its payload."
     :cs "Pinning the line ending to U+000A is a portability decision, not a standard requirement. R7RS-small permits CRLF here; Motoi does not use it."))
  :row-5-emergence (
    (:eng-composition "(define (println x) (display x) (newline))\n(define (banner title)\n  (println title)\n  (println (make-string (string-length title) #\\-)))\n(banner \"fuel report\")\n(println (list 'tank 88))"
     :math-composition "(define (table rows)\n  (let ((p (open-output-string)))\n    (for-each (lambda (r) (for-each (lambda (c) (display c p) (display \" \" p)) r) (newline p)) rows)\n    (get-output-string p)))\n(define t (table (list (list 1 2) (list 3 4) (list 5 6))))\n(display (list 'rows 3 'chars (string-length t)))\n(newline)\n(display t)"
     :cs-composition "(define log (open-output-string))\n(define (log-line tag payload) (write (list tag payload) log) (newline log))\n(log-line 'boot 'ok)\n(log-line 'tick 42)\n(define text (get-output-string log))\n(define (count-breaks s)\n  (let loop ((i 0) (n 0))\n    (if (>= i (string-length s)) n\n        (loop (+ i 1) (if (equal? (substring s i (+ i 1)) \"\\n\") (+ n 1) n)))))\n(display (list 'entries (count-breaks text)))\n(newline)\n(display text)"
     :base "newline puts one line break into the stream."
     :emergent "eng: println, then banner -- pairing display with newline once gives every later line the same shape. math: a table printer whose character count is payload plus one break per row. cs: an append-only record log where the break is the record boundary, so counting breaks counts entries without parsing them."
     :meta "The composition is display plus newline, and what emerges is the LINE as a unit of meaning. Once the break is a reliable terminator, three families follow: framed output (banners, tables), countable records (logs), and streamable parsing (a reader that splits on the same mark). The verb did not gain power; the agreement did.")
    (:eng "Defining println once is the whole point -- the pairing is stated in one place, so a later change to line framing touches one definition."
     :math "Payload plus one break per row is a closed formula: the table above is six digits, six spaces and three breaks."
     :cs "write plus newline is the JSON-lines shape: one self-delimiting record per line, appendable without rewriting, splittable without a full parse."))
)

(verb
  :name "flush-output-port" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(flush-output-port [port]) -> unspecified"
  :summary "Ask that buffered output be delivered. In Motoi this delivers nothing -- nothing is ever buffered -- but it does check that you handed it an open output port."
  :explanation "R7RS-small 6.13.3 defines flush-output-port as the request that any outstanding buffered output be delivered to its destination. Motoi has no buffering to deliver, so the DELIVERY half of the verb is a no-op. That is honest for the three port kinds Motoi actually ships. Console output goes straight through to the host's standard output on each call, so it is already delivered. A string port and a bytevector port accumulate in memory and are read back with get-output-string or get-output-bytevector, which see everything written so far -- there is no state a flush could advance. The VALIDATION half is real: the verb resolves its argument through the same checker every other output verb uses, so a non-port raises, an input port raises, and a closed output port raises. That matters more than it sounds. A verb that quietly accepted 42 would let a typo survive all the way to production looking like a working flush; a verb that raises tells you at the call site that you passed the wrong thing. So the shape to hold on to is: calling it can never change WHAT was written, but it can still tell you that the port you thought you were writing to is not one."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display \"delivered\")\n(flush-output-port)\n(newline)" :note "delivered followed by a line break -- the flush changed nothing, because the display had already been delivered.")
    (:dialect "motoi" :tier "intermediate" :code "(define p (open-output-string))\n(display \"abc\" p)\n(flush-output-port p)\n(display (list 'before-and-after-flush (get-output-string p)))\n(newline)" :note "(before-and-after-flush abc) -- a string port already shows everything written; the flush is not what made abc visible.")
    (:dialect "motoi" :tier "expert" :code "(display (list 'returns (flush-output-port)\n               'rejects-a-non-port (guard (e (#t 'raised)) (begin (flush-output-port 42) 'no-error))\n               'rejects-an-input-port (guard (e (#t 'raised)) (begin (flush-output-port (open-input-string \"a\")) 'no-error))))\n(newline)" :note "(returns  rejects-a-non-port raised rejects-an-input-port raised) -- the return value is unspecified so it prints as nothing, and the gap between 'returns and 'rejects is where it would have been. The delivery does nothing; the argument check is real.")
  )
  :caveats ("Delivery is a no-op. Calling it proves nothing about output reaching anywhere, and removing it changes nothing about what a port contains." "The argument check is NOT a no-op. A non-port, an input port and a closed output port each raise, so a flush call is still a live assertion that you hold an open output port." "It returns an unspecified value, which prints as nothing -- a gap inside a displayed list, not the symbol you might expect." "It does not imply a line break. In C++ endl flushes AND breaks the line; here the two jobs are separate verbs and this one does neither." "Do not use a flush to force ordering between console output and error output. current-output-port and current-error-port are different destinations and this verb does not synchronise them.")
  :usecases ("Portability: keeping a program that was written against another Scheme running unchanged." "Marking, for a later reader, the point at which delivery would matter if Motoi ever grew a buffered port." "Nothing else -- there is no case in which adding it changes what a Motoi program does.")
  :related ("newline" "display" "write-string" "current-output-port" "get-output-string")
  :learn (:concept "Buffering is a performance choice made by an output implementation, and flushing is the escape hatch that lets a program override it. A system with no buffering needs no escape hatch." :prerequisites ("display" "open-output-string") :progression "Learn display first, then get-output-string so you can see that a string port already holds everything, and only then flush-output-port -- at which point the honest answer is that there was nothing to flush.")
  :provenance "R7RS-small 6.13.3; measured against the live engine 2026-08-02 (delivery is a no-op, argument validation is enforced); reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define p (open-output-string))\n(display \"line-one\" p)\n(newline p)\n(flush-output-port p)\n(display \"line-two\" p)\n(newline p)\n(display (list 'visible-without-a-second-flush (string-length (get-output-string p))))\n(newline)"
     :math-program "(define (chars-after-writes n flush?)\n  (let ((p (open-output-string)))\n    (let loop ((i 0)) (if (< i n) (begin (display \"x\" p) (if flush? (flush-output-port p)) (loop (+ i 1)))))\n    (string-length (get-output-string p))))\n(display (map (lambda (n) (= (chars-after-writes n #t) (chars-after-writes n #f))) (list 0 1 4 9)))\n(newline)"
     :cs-program "(define (delivered? make-port read-back)\n  (let ((p (make-port)))\n    (display \"payload\" p)\n    (let ((before (read-back p)))\n      (flush-output-port p)\n      (equal? before (read-back p)))))\n(display (list 'string-port-unchanged-by-flush\n               (delivered? open-output-string get-output-string)\n               'but-validates\n               (guard (e (#t 'raised)) (begin (flush-output-port 42) 'no-error))))\n(newline)"
     :problem "The operator has output that must reach the screen before a long computation starts, and reaches for a flush out of habit from C or Python. Candidates: flush-output-port (does nothing here), doing nothing at all (identical result), or a newline (which does not flush either, but at least ends the line so a reader can see the text as a complete line). In Motoi the honest answer is that the write already arrived, so the operator needs no verb at all -- and if the goal was really 'make it readable now', newline is the verb that does that."
     :explanation "eng: two lines written to a string port, only one flush, and both lines are present. math: for every write count, flushing and not flushing produce identical content. cs: a general probe -- read the port back before and after a flush and compare; equal means the flush was not load-bearing, and the second half shows the argument check still fires."
     :meta "Why nothing rather than flush-output-port: a call that cannot change the outcome is worse than absent for DELIVERY, because a later reader will assume it is holding something together and be afraid to remove it. The one thing it still buys is the type check, which is a weak reason to keep it. If it is here for portability, say so in a comment; do not let the delivery look like it works.")
    (:eng "A no-op that looks like a safeguard is a maintenance hazard -- the next engineer cannot tell it from a real one without reading the engine."
     :math "The content function is independent of the flush schedule: content(writes, any flush pattern) = content(writes)."
     :cs "Related patterns: fflush in C, sys.stdout.flush() in Python, Writer.flush in Java -- all meaningful only because those runtimes buffer. Motoi does not, so the verb has nothing to do."))
  :row-3-dimension (
    (:setup "A delivery barrier: a request that everything handed over so far actually reach its destination before the next step begins -- and the degenerate case where handing over IS delivering, so the barrier costs nothing."
     :rungs ((:domain "io" :code "(define p (open-output-string))\n(display \"a\" p)\n(flush-output-port p)\n(display \"b\" p)\n(display (get-output-string p))\n(newline)")
             (:domain "an outbox on a desk: the barrier is real when a courier collects twice a day, and vanishes when the recipient sits at the next desk" :code "(define (send-with-courier items) (list 'held (length items) 'delivered 0))\n(define (send-to-next-desk items) (list 'held 0 'delivered (length items)))\n(display (list (send-with-courier (list 'a 'b)) (send-to-next-desk (list 'a 'b))))\n(newline)")
             (:domain "an identity element: the operation that leaves every value unchanged, so applying it any number of times is the same as not applying it" :code "(define (apply-n f n x) (if (= n 0) x (apply-n f (- n 1) (f x))))\n(define (flush-then s) (let ((p (open-output-string))) (display s p) (flush-output-port p) (get-output-string p)))\n(display (list 'once (flush-then \"abc\") 'idempotent (equal? (apply-n flush-then 3 \"abc\") (flush-then \"abc\"))))\n(newline)"))
     :explanation "In io, a flush asks that pending output be delivered. On a desk, an outbox holds letters until a courier comes, and asking for an early collection is exactly a flush -- but if the recipient sits at the next desk, handing over and delivering are the same act and the request is empty. In algebra, an operation that leaves every value alone is an identity element, and applying it repeatedly is indistinguishable from never applying it. All three share: a step whose value depends entirely on whether anything was being held back."
     :meta "The shape transfers wherever a system might interpose storage between a producer and a consumer. The interesting question is never 'does the flush work' but 'is anything being held', and the answer is a property of the channel, not of the verb.")
    (:eng "Two lines in and two characters out: the write and the delivery were never separate events, so there was no window for the flush to close."
     :math "Being an identity means idempotence comes free -- flushing three times equals flushing once equals not flushing."
     :cs "Buffering is what makes a flush meaningful, and buffering is what makes interleaved stdout and stderr appear out of order. Motoi's unbuffered console avoids both."))
  :row-4-proof (
    (:eng-program "(define (content-with-flushes k)\n  (let ((p (open-output-string)))\n    (display \"ab\" p)\n    (let loop ((i 0)) (if (< i k) (begin (flush-output-port p) (loop (+ i 1)))))\n    (get-output-string p)))\n(display (map (lambda (k) (equal? (content-with-flushes k) \"ab\")) (list 0 1 2 10)))\n(newline)"
     :math-program "(define (probe k)\n  (let ((p (open-output-string)))\n    (display \"seed\" p)\n    (let loop ((i 0)) (if (< i k) (begin (flush-output-port p) (loop (+ i 1)))))\n    (string-length (get-output-string p))))\n(define base (probe 0))\n(display (list 'base base 'all-agree (equal? (map probe (list 0 1 3 8)) (list base base base base))))\n(newline)"
     :cs-program "(define (returns-unspecified? v) (equal? (with-output-to-string (lambda () (display v))) \"\"))\n(display (list 'no-arg-returns-unspecified (returns-unspecified? (flush-output-port))\n               'port-arg-returns-unspecified (returns-unspecified? (flush-output-port (open-output-string)))\n               'non-port-arg-raises (guard (e (#t 'raised)) (begin (flush-output-port 42) 'no-error))\n               'closed-port-raises (guard (e (#t 'raised)) (let ((p (open-output-string))) (close-output-port p) (flush-output-port p) 'no-error))))\n(newline)"
     :claim "flush-output-port has no observable effect ON CONTENT: for any number of calls, including zero, the content of the port is unchanged, and it returns an unspecified value. It is not effect-free on ARGUMENTS: a non-port and a closed port both raise."
     :invariant "For all open output ports p, all s, all k >= 0. content(write s to p, then flush p k times) = content(write s to p)"
     :meta "The pattern is an operation that is null in its stated job and load-bearing in its precondition. What would falsify the null half: a call count that changed the content, or a return value that displayed as something. What would falsify the precondition half: 42 or a closed port surviving the call. The invariant is deliberately quantified over OPEN output ports only, because outside that domain the verb does not return at all.")
    (:eng "The zero-call case is the control. Without it, a test that only ever flushes cannot tell a working flush from an absent one."
     :math "Zero, one, three and eight calls all give the same length, which is the idempotence claim stated as data rather than as prose."
     :cs "An unspecified return displays as the empty string, so the probe compares against \"\" rather than against a symbol -- there is no value here to name."))
  :row-5-emergence (
    (:eng-composition "(define (checkpoint p label)\n  (display label p)\n  (newline p)\n  (flush-output-port p)\n  (string-length (get-output-string p)))\n(define p (open-output-string))\n(display (list (checkpoint p \"start\") (checkpoint p \"middle\") (checkpoint p \"end\")))\n(newline)\n(display (get-output-string p))"
     :math-composition "(define (grows-monotonically? labels)\n  (let ((p (open-output-string)))\n    (let loop ((rest labels) (prev 0))\n      (cond ((null? rest) #t)\n            (else (display (car rest) p)\n                  (flush-output-port p)\n                  (let ((now (string-length (get-output-string p))))\n                    (if (>= now prev) (loop (cdr rest) now) #f)))))))\n(display (grows-monotonically? (list \"a\" \"bb\" \"ccc\")))\n(newline)"
     :cs-composition "(define out (open-output-string))\n(define (emit-record tag n)\n  (write (list tag n) out)\n(newline out)\n  (flush-output-port out))\n(emit-record 'boot 1)\n(emit-record 'tick 2)\n(display (get-output-string out))"
     :base "flush-output-port asks for delivery, and in Motoi there is nothing to deliver."
     :emergent "eng: a checkpoint helper -- write a label, end the line, request delivery, report the size so far. math: the size sequence is non-decreasing across checkpoints, which is the only guarantee the composition actually buys. cs: a record emitter that ends every entry with the same three-step ritual, so every entry is framed identically whether or not the flush does work."
     :meta "The composition chains display, newline and flush into a checkpoint ritual, and what emerges is the DURABILITY PATTERN: write, frame, then request delivery. On Motoi only the first two steps carry weight, but the shape is worth learning intact, because the same ritual is what makes an append-only log survivable on a system that does buffer. Learn the ritual here, where the third step is free, and it will be in your hands where it is not.")
    (:eng "Reporting the size after each checkpoint is what makes the ritual auditable -- the numbers rise, so the writes landed."
     :math "Monotone growth is the honest invariant: appending never shrinks the content, and the flush neither adds to it nor removes from it."
     :cs "The write-frame-flush shape is the same one behind write-ahead logs and journaled filesystems. There the flush is the whole point; here it is a placeholder held open for it."))
)

(verb
  :name "write-simple" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(write-simple value [port]) -> unspecified"
  :summary "Write value in machine-readable form WITHOUT datum labels. It agrees with write on acyclic data and diverges from it the moment the data points at itself."
  :explanation "R7RS-small 6.13.3 defines three machine-readable printers that differ only in how they handle structure that is shared or circular. write must not loop forever: it detects cycles and prints datum labels like #0=(1 . #0#). write-shared goes further and labels EVERY shared substructure, not only the circular ones. write-simple does neither -- it is the plain recursive printer, and the standard says explicitly that it MAY LOOP FOREVER on a circular value. Motoi implements all three as separate procedures, and write-simple is exactly conformant: it is defined to omit labels and it omits them, including on ordinary sharing, where the same sublist held twice is expanded twice. On acyclic data the three printers are indistinguishable, which is why almost every program can pick any of them and never notice. The reason to pick this one is a promise about the OUTPUT DIALECT: write-simple will never emit #0= syntax, so its output is readable by the oldest and narrowest reader you might hand it to. The price is the one the standard warns about, and in Motoi it is real: hand write-simple a circular pair and it does not raise and does not stop -- it allocates until the host runs out of memory and the process dies. A circular VECTOR is gentler, exhausting the host call stack and raising, which guard can catch. Neither is a failure of the verb; both are the documented cost of a printer with no visited set."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(write-simple (list 1 \"two\" 'three))\n(newline)" :note "(1 \"two\" three) -- the machine-readable form: the string keeps its quotes, the symbol does not gain any.")
    (:dialect "motoi" :tier "intermediate" :code "(define v (list 1 \"two\" #\\c 'sym))\n(display (list 'write (with-output-to-string (lambda () (write v)))\n               'simple (with-output-to-string (lambda () (write-simple v)))\n               'identical (equal? (with-output-to-string (lambda () (write v)))\n                                  (with-output-to-string (lambda () (write-simple v))))))\n(newline)" :note "(write (1 \"two\" #\\c sym) simple (1 \"two\" #\\c sym) identical #t) -- on acyclic data the two printers agree, exactly as the standard allows.")
    (:dialect "motoi" :tier "expert" :code "(define v (make-vector 2 0))\n(vector-set! v 0 1)\n(vector-set! v 1 v)\n(define (outcome f) (guard (e (#t 'raised)) (begin (with-output-to-string (lambda () (f v))) 'printed)))\n(display (list 'write (outcome write) 'write-shared (outcome write-shared) 'write-simple (outcome write-simple)))\n(newline)\n(display 'program-continues)\n(newline)" :note "(write printed write-shared printed write-simple raised) then program-continues -- write and write-shared carry a visited set and label the cycle; write-simple has none and descends until the host stack is exhausted. That is the standard's warning, observed.")
  )
  :caveats ("It never produces a datum label. That is its specification, not a defect -- but it means the output cannot describe sharing, only value." "A circular PAIR, built with cons and set-cdr!, does not raise: it allocates until the host runs out of memory and the process is killed. guard cannot catch it and there is no fuel limit that stops it. Check for cycles yourself, or use write." "A circular VECTOR, built with vector-set!, exhausts the host call stack and raises, which guard can catch. Two shapes of circularity, two different failures." "Sharing without circularity -- the same sublist appearing twice -- prints twice, expanded. Correct here; use write-shared when the sharing is part of the meaning." "It is a DIFFERENT procedure from write and write-shared: (eq? write write-simple) is #f. On acyclic data all three agree, so a test that only uses acyclic data cannot tell which one you called.")
  :usecases ("Serialising acyclic data for a reader that may not understand #0= syntax." "Porting a program from a Scheme where the three printers differ, and pinning down which one was meant." "Teaching what a visited set buys, by showing the printer that does not carry one.")
  :related ("write" "write-shared" "display" "with-output-to-string" "write-string")
  :learn (:concept "A printer that walks a structure recursively must decide what to do when the structure points back at itself: loop forever, raise, or emit a label that names the repeat." :prerequisites ("write" "display") :progression "Learn display first (human-facing), then write (machine-readable), and only then the write-simple / write-shared pair -- they exist to answer one narrow question about shared structure, and that question has no meaning until the first two are solid.")
  :provenance "R7RS-small 6.13.3; measured against the live engine 2026-08-02 (three distinct procedures; write-simple carries no visited set); reference record added 2026-08-02, corrected 2026-08-02"
  :row-2-audit (
    (:eng-program "(define snapshot (list 'tank 88 'label \"fuel\"))\n(define line (with-output-to-string (lambda () (write-simple snapshot))))\n(display (list 'line line 'length (string-length line)))\n(newline)"
     :math-program "(define (agree? v)\n  (equal? (with-output-to-string (lambda () (write v)))\n          (with-output-to-string (lambda () (write-simple v)))))\n(display (map agree? (list 1 \"s\" 'sym (list 1 2) (vector 1 2) 3.5)))\n(newline)"
     :cs-program "(define shared (list 1 2))\n(define both (list shared shared))\n(display (list 'expanded-twice (with-output-to-string (lambda () (write-simple both)))))\n(newline)\n(display (list 'write-agrees (equal? (with-output-to-string (lambda () (write both)))\n                                     (with-output-to-string (lambda () (write-simple both))))))\n(newline)"
     :problem "The operator is serialising a configuration snapshot to a log line that another Scheme will read back. Candidates: write (labels cycles, so a self-referential value survives the round trip), write-simple (no labels, so the reader never meets #0= syntax it may not support), and display (drops the quotes on strings, so the line will not parse at all). For data known to be acyclic and a reader of unknown vintage, write-simple is the honest verb -- it promises output in the oldest, most widely readable subset."
     :explanation "eng: one snapshot, written and measured. math: write and write-simple agree on every acyclic value tried, across six types. cs: a value that SHARES a sublist is printed with the sublist expanded twice -- no label, no back-reference."
     :meta "Why write-simple and not write: the difference is a promise about the OUTPUT DIALECT, not about the data. write may emit #0= notation that an old reader will reject; write-simple never will. The trade is exact and worth naming -- you buy the narrower dialect by giving up the cycle guard, so write-simple is the right verb only when you already know the data is acyclic.")
    (:eng "State the reader you are writing for. A log line meant for an unknown consumer should use the narrowest output dialect that carries the data."
     :math "On the acyclic subset the three printers are extensionally equal -- the distinction lives entirely on the cyclic and shared cases."
     :cs "Related patterns: repr() in Python (which prints [...] for a self-referential list rather than raising), and Java's toString (which recurses until the stack ends, as write-simple does)."))
  :row-3-dimension (
    (:setup "A recursive traversal with no memory of where it has been: descend into every part, print it, and trust that the structure eventually bottoms out."
     :rungs ((:domain "io" :code "(write-simple (list 1 (list 2 (list 3 (list 4)))))\n(newline)")
             (:domain "reading a nested table of contents aloud, section by section, without keeping a finger on where you started" :code "(define (read-aloud x depth)\n  (if (pair? x)\n      (begin (display (make-string depth #\\space)) (display \"section\") (newline)\n             (for-each (lambda (k) (read-aloud k (+ depth 2))) x))\n      (begin (display (make-string depth #\\space)) (display x) (newline))))\n(read-aloud (list 1 (list 2 3)) 0)"
                                  )
             (:domain "structural recursion on a well-founded tree, where termination is guaranteed by the absence of a cycle rather than by a counter" :code "(define (depth x) (if (pair? x) (+ 1 (apply max 0 (map depth x))) 0))\n(define t (list 1 (list 2 (list 3))))\n(display (list 'depth (depth t) 'printed (with-output-to-string (lambda () (write-simple t)))))\n(newline)"))
     :explanation "In io, write-simple descends into every part of a value and prints it, keeping no record of what it has already visited. Reading a nested table of contents aloud is the same act: you go down into each section as you meet it, and nothing stops you re-reading a section that is listed twice -- or looping forever if section three points back at section one. In mathematics, structural recursion on a well-founded tree terminates precisely because no path leads back to an ancestor; the guarantee comes from the shape of the data, not from anything the traversal does. All three share: no bookkeeping, no visited set, and termination borrowed entirely from the input."
     :meta "The shape transfers wherever a traversal trades safety for simplicity. The moment the data can point backwards, the traversal needs a visited set -- and that visited set is exactly what write and write-shared carry and what write-simple, by definition, does not.")
    (:eng "Indented recitation makes the descent visible: each level of nesting is one more level of indentation, and the print happens on the way down."
     :math "Depth is finite because the tree is well-founded, and a finite depth is what bounds the recursion."
     :cs "The absent visited set is the whole story. Adding one that records only the ancestors on the current path turns write-simple into write; making it record every repeat, not only the circular ones, turns it into write-shared."))
  :row-4-proof (
    (:eng-program "(define (three-agree? v)\n  (let ((a (with-output-to-string (lambda () (write v))))\n        (b (with-output-to-string (lambda () (write-simple v))))\n        (c (with-output-to-string (lambda () (write-shared v)))))\n    (and (equal? a b) (equal? b c))))\n(display (map three-agree? (list 0 \"s\" 'sym #\\c (list 1 2) (vector 1 2))))\n(newline)"
     :math-program "(define (no-label? v)\n  (let ((s (with-output-to-string (lambda () (write-simple v)))))\n    (not (string-contains s \"#0=\"))))\n(define shared (list 1 2))\n(display (map no-label? (list (list shared shared) (list 1 2 3) (vector shared shared))))\n(newline)"
     :cs-program "(define v (make-vector 2 0))\n(vector-set! v 0 1)\n(vector-set! v 1 v)\n(define (printer-result f)\n  (guard (e (#t 'raised)) (begin (with-output-to-string (lambda () (f v))) 'printed)))\n(display (list 'write (printer-result write)\n               'write-shared (printer-result write-shared)\n               'write-simple (printer-result write-simple)))\n(newline)\n(display 'only-write-simple-fell-over)\n(newline)"
     :claim "write-simple produces the same output as write on every acyclic value and never emits a datum label even where structure is genuinely shared; on a circular vector it fails where write and write-shared succeed."
     :invariant "For all acyclic v. write(v) = write-simple(v) = write-shared(v); and for all v. write-simple(v) contains no datum label"
     :meta "The pattern is a printer defined by what it refuses to remember. What would falsify it: any acyclic value on which the printers disagreed, any write-simple output containing #0=, or a circular value that write-simple printed successfully. The third program is the load-bearing one -- it is the cycle test the standard is written around, and it is the only test that can tell the three printers apart.")
    (:eng "Testing all three printers in one loop is the only way to state the acyclic equivalence as evidence rather than as a claim about the source code."
     :math "No label appears from write-simple even where sharing is real, which is exactly its specification -- and exactly what disqualifies it from standing in for write-shared."
     :cs "The circular vector separates the three: write and write-shared carry a visited set and emit #0=; write-simple recurses until the host stack ends. A circular PAIR is worse still -- write-simple allocates without bound there and cannot be guarded."))
  :row-5-emergence (
    (:eng-composition "(define (dump-line tag payload)\n  (let ((p (open-output-string)))\n    (write-simple (list tag payload) p)\n    (newline p)\n    (get-output-string p)))\n(display (dump-line 'boot (list 'fuel 88)))\n(display (dump-line 'tick (list 'fuel 87)))"
     :math-composition "(define (round-trippable-shape? v)\n  (let ((s (with-output-to-string (lambda () (write-simple v)))))\n    (and (> (string-length s) 0)\n         (not (string-contains s \"#<\")))))\n(display (map round-trippable-shape? (list (list 1 2) \"str\" 'sym (vector 1 2) car)))\n(newline)"
     :cs-composition "(define archive (open-output-string))\n(define (archive-record tag v)\n  (write-simple (list tag v) archive)\n  (newline archive))\n(archive-record 'a (list 1 2))\n(archive-record 'b (vector 3 4))\n(define text (get-output-string archive))\n(display (list 'has-labels (string-contains text \"#0=\") 'chars (string-length text)))\n(newline)\n(display text)"
     :base "write-simple prints a value in machine-readable form with no datum labels."
     :emergent "eng: a dump-line helper -- one record per line, label-free, in the narrowest readable dialect. math: a readability screen that rejects values whose printed form contains #< , which is the marker for things no reader can reconstruct. cs: a label-free archive whose whole text is checked for #0= once, at the end, rather than value by value."
     :meta "The composition chains write-simple with newline into a line-oriented archive, and what emerges is the DIALECT-FLOOR pattern: choose the printer that emits the smallest output language your reader is guaranteed to understand, then verify the whole stream against that language in one pass. The check at the end is the part worth keeping -- it turns a promise about the printer into evidence about the output.")
    (:eng "One record per line and no labels means the archive can be split on line breaks by any tool, not only by a Scheme reader."
     :math "A printed form containing #< is a value with no reader syntax; screening for it separates what round-trips from what merely displays."
     :cs "This is the JSON-lines discipline applied to S-expressions: self-delimiting records, appendable, and restricted to a subset every consumer parses."))
)

(verb
  :name "write-shared" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(write-shared value [port]) -> unspecified"
  :summary "Write value with a datum label on EVERY shared substructure, not only the circular ones. It is the only printer whose output records the object graph and not merely the value."
  :explanation "R7RS-small 6.13.3 gives write-shared the strongest promise of the three machine-readable printers: it must label every substructure that appears more than once, whether or not the sharing is circular. Given a list that holds the same sublist twice, write-shared prints (#0=(1 2) #0#), so a reader can reconstruct not just the VALUE but the sharing. That is the whole distinction from write. Both carry a visited set, but write is only obliged to break CYCLES, and on ordinary sharing it is permitted to expand -- and Motoi's write does expand, printing ((1 2) (1 2)) for the same input. So the two printers differ exactly where sharing is real and circularity is not, which is the common case and the reason the verb exists. Read the outputs side by side: write says what the value IS, write-shared says how the value is BUILT. Where sharing is genuinely part of the meaning -- one wheel object held by two parents, an interned table referenced from many places -- write's output is a true statement about the value and a false statement about the object graph, and only write-shared preserves the difference. On a circular value the two agree, because a cycle forces write's hand: both print #0=(1 . #0#)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(write-shared (list 1 \"two\" 'three))\n(newline)" :note "(1 \"two\" three) -- with no sharing to label, the output is ordinary machine-readable form.")
    (:dialect "motoi" :tier "intermediate" :code "(define shared (list 1 2))\n(define both (list shared shared))\n(display (list 'write (with-output-to-string (lambda () (write both)))\n               'shared (with-output-to-string (lambda () (write-shared both)))))\n(newline)" :note "(write ((1 2) (1 2)) shared (#0=(1 2) #0#)) -- the sublist is one object held twice. write is permitted to expand it and does; write-shared labels it, and the label is the only place the sharing survives.")
    (:dialect "motoi" :tier "expert" :code "(define shared (list 1 2))\n(define both (list shared shared))\n(define copies (list (list 1 2) (list 1 2)))\n(define (text f v) (with-output-to-string (lambda () (f v))))\n(display (list 'write-cannot-tell-them-apart (equal? (text write both) (text write copies))\n               'write-shared-can (not (equal? (text write-shared both) (text write-shared copies)))))\n(newline)" :note "(write-cannot-tell-them-apart #t write-shared-can #t) -- two values that are equal? but not built alike. write maps them to one string, so its printing is not invertible on object graphs; write-shared separates them.")
  )
  :caveats ("It labels ALL sharing, so output for a heavily shared structure looks unfamiliar even when nothing is circular. That is the point, not a fault." "The labels are positional and per-call: #0, #1 and so on are assigned in traversal order, so the same value can get different label numbers in a different context. Compare texts from a single call, not across calls." "It is a DIFFERENT procedure from write: (eq? write write-shared) is #f. On acyclic, unshared data they agree, so a test built only from literals cannot tell which one you called." "A reader that predates datum labels will reject this output. If the consumer is unknown, use write-simple, which never emits a label." "Sharing of IMMUTABLE atoms is not labelled -- numbers, characters and booleans have no identity worth recording. Only compound structure gets a label.")
  :usecases ("Dumping a structure in which one sublist is deliberately shared by two parents, and needing the dump to record that it is one object." "Debugging an aliasing bug: print with write and with write-shared, and the difference between the two texts is exactly the sharing you did not intend." "Serialising an object graph for a reader that understands #0= syntax, where expanding the sharing would blow up the output size.")
  :related ("write" "write-simple" "display" "with-output-to-string" "vector-set!")
  :learn (:concept "Printed output can describe a value or describe an object graph. Two lists that print identically under write may be one object shared twice or two separate objects, and only a labelling printer can tell you which." :prerequisites ("write" "write-simple") :progression "Learn write for machine-readable output, write-simple for the label-free floor, and write-shared last -- it is the only one of the three whose whole reason for existing is a property of the object graph rather than of the value.")
  :provenance "R7RS-small 6.13.3; measured against the live engine 2026-08-02 (labels every shared compound; write labels cycles only); reference record added 2026-08-02, corrected 2026-08-02"
  :row-2-audit (
    (:eng-program "(define wheel (list 'spoke 'rim))\n(define cart (list wheel wheel))\n(display (with-output-to-string (lambda () (write-shared cart))))\n(newline)\n(display (list 'one-object-or-two (eq? (car cart) (cadr cart))))\n(newline)"
     :math-program "(define shared (list 1 2))\n(define (labelled? v) (string-contains (with-output-to-string (lambda () (write-shared v))) \"#0=\"))\n(display (map labelled? (list (list shared shared) (vector shared shared) (list shared) (list 1 2))))\n(newline)"
     :cs-program "(define shared (list 1 2))\n(define both (list shared shared))\n(define printed (with-output-to-string (lambda () (write-shared both))))\n(display (list 'printed printed\n               'sharing-in-the-value (eq? (car both) (cadr both))\n               'sharing-in-the-text (string-contains printed \"#0=\")))\n(newline)"
     :problem "The operator is dumping a structure in which one sublist is deliberately shared by two parents, and needs the dump to record that it is ONE object. Candidates: write-shared (defined to label every repeat), write (labels only circular repeats), and write-simple (labels nothing). write-shared is the only correct choice, and the other two are not near-misses: they produce text from which the sharing cannot be recovered at all, so no amount of post-processing fixes the dump after the fact."
     :explanation "eng: a cart holding one wheel object twice, printed with the wheel labelled once and referred to the second time, with eq? confirming it was one object. math: every value that genuinely shares a compound produces a label, and the ones that do not share produce none. cs: the two facts side by side -- sharing is true in the value and present in the text."
     :meta "Why write-shared and not write: the difference is exactly whether NON-circular sharing survives. Circularity forces write's hand; ordinary sharing does not, and write is permitted to expand it -- and does. If sharing is part of the meaning, write-shared is the verb, and reaching for write here is the kind of choice that looks right in every test built from literals.")
    (:eng "If sharing carries meaning -- one physical wheel, not two -- the label is what carries it. An expanded dump reads as two independent wheels and nothing in the text contradicts that."
     :math "Printing is a function from values to text. write is not injective on object graphs -- two distinct graphs map to the same text -- and write-shared restores injectivity on exactly the cases write collapses."
     :cs "Related patterns: Python's repr, which prints [...] for self-reference and expands ordinary sharing; and object-graph serialisers such as Java's, which assign identifiers precisely to keep sharing. A datum label is that identifier with a reader syntax."))
  :row-3-dimension (
    (:setup "A transcription that must decide whether a thing seen twice is recorded twice or recorded once with a back-reference -- and what is lost when the back-reference is dropped."
     :rungs ((:domain "io" :code "(define shared (list 'a 'b))\n(define both (list shared shared))\n(display (with-output-to-string (lambda () (write-shared both))))\n(newline)\n(display (eq? (car both) (cadr both)))\n(newline)")
             (:domain "a parts list that either names one bolt used in four places, or lists four bolts" :code "(define (as-graph) (list 'bolt-A 'bolt-A 'bolt-A 'bolt-A))\n(define (as-inventory) (list (cons 'bolt-A 4)))\n(display (list 'expanded (as-graph) 'with-identity (as-inventory)))\n(newline)"
                                  )
             (:domain "a directed acyclic graph unfolded into a tree: the value is preserved, the sharing is not, and the size can grow exponentially" :code "(define (unfold n)\n  (if (= n 0) 'leaf (let ((sub (unfold (- n 1)))) (list sub sub))))\n(define (leaves x) (if (pair? x) (apply + (map leaves x)) 1))\n(display (map (lambda (n) (leaves (unfold n))) (list 0 1 2 3 4)))\n(newline)"))
     :explanation "In io, write-shared records a repeated substructure once and refers back to it. A parts list faces the same choice: four occurrences of bolt-A either become four rows, or one row with a count and an identity -- and only the second tells you it is the same part number. In graph terms, dropping the back-reference unfolds a directed acyclic graph into a tree; the leaves come out right, and the size doubles at every level of sharing. All three share: an identity that exists in the object and must be spelled out explicitly, or be lost in transcription."
     :meta "The shape transfers wherever a representation is flatter than the thing it represents. The cost is not usually wrongness -- the unfolded tree has the same leaves -- it is size, and the loss of the fact that two positions were the same thing.")
    (:eng "Naming the part is what carries identity. An expanded list of four bolts cannot tell a reader whether they are interchangeable."
     :math "Unfolding n levels of sharing gives 2^n leaves from a structure with n nodes: 1, 2, 4, 8, 16. That is the price of dropping the label."
     :cs "This is why serialisation formats grow reference syntax -- YAML anchors, JSON-pointer, protobuf message ids. Every one of them is a datum label under another name."))
  :row-4-proof (
    (:eng-program "(define shared (list 1 2))\n(define both (list shared shared))\n(display (list 'eq-in-value (eq? (car both) (cadr both))\n               'label-in-text (string-contains (with-output-to-string (lambda () (write-shared both))) \"#0=\")))\n(newline)"
     :math-program "(define shared (list 1 2))\n(define both (list shared shared))\n(define copies (list (list 1 2) (list 1 2)))\n(define (text v) (with-output-to-string (lambda () (write-shared v))))\n(display (list 'shared-text (text both)\n               'copies-text (text copies)\n               'texts-equal (equal? (text both) (text copies))\n               'values-differ-in-sharing (list (eq? (car both) (cadr both)) (eq? (car copies) (cadr copies)))))\n(newline)"
     :cs-program "(define v (make-vector 2 0))\n(vector-set! v 0 7)\n(vector-set! v 1 v)\n(define (outcome f) (guard (e (#t 'raised)) (with-output-to-string (lambda () (f v)))))\n(display (list 'write (outcome write) 'write-shared (outcome write-shared) 'write-simple (outcome write-simple)))\n(newline)"
     :claim "write-shared labels every shared compound: a structure that shares a substructure and a structure that merely copies it produce DIFFERENT text, where under write they produce the same text; and on a circular value write-shared and write agree while write-simple fails."
     :invariant "For all v with shared substructure. text(write-shared v) != text(write-shared (fully-expanded copy of v)), while text(write v) = text(write (fully-expanded copy of v))"
     :meta "The pattern is a transcription that preserves identity. What would falsify it: a shared value and its expanded copy printing alike under write-shared, or a #0= label appearing where nothing is shared. The second program is the sharp one, because it puts the two values side by side and shows write-shared separating what eq? separates -- the printers' answers and the identity predicate's answers finally agree.")
    (:eng "The two facts belong on one line: sharing is #t in the value and present in the text. Reading them together is what makes the label mean something."
     :math "Injectivity is the precise statement. write collapses two distinct object graphs onto one string; write-shared keeps them apart, so its printing can be inverted."
     :cs "The circular vector separates write-simple from the other two. write and write-shared both carry a visited set and print #0=#(#0# 7); write-simple recurses until the host stack ends."))
  :row-5-emergence (
    (:eng-composition "(define (with-identity tag v) (list 'id tag v))\n(define wheel (with-identity 'wheel-1 (list 'spoke 'rim)))\n(define cart (list wheel wheel))\n(display (with-output-to-string (lambda () (write-shared cart))))\n(newline)\n(display (list 'identity-survived-the-print #t))\n(newline)"
     :math-composition "(define (expanded-size v) (string-length (with-output-to-string (lambda () (write-shared v)))))\n(define (build n) (if (= n 0) (list 'leaf) (let ((sub (build (- n 1)))) (list sub sub))))\n(display (map (lambda (n) (expanded-size (build n))) (list 0 1 2 3)))\n(newline)"
     :cs-composition "(define (intern-table pairs) pairs)\n(define table (intern-table (list (cons 'wheel (list 'spoke 'rim)))))\n(define cart (list 'cart (list 'uses 'wheel) (list 'uses 'wheel)))\n(define out (open-output-string))\n(write-shared (list 'table table 'graph cart) out)\n(newline out)\n(display (get-output-string out))"
     :base "write-shared labels shared structure, so the printed text records the object graph."
     :emergent "eng: put the identity IN the data as well -- an id tag travels through any printer, because it is a value and not a printer feature. math: measure what a label saves, by printing structures with 0, 1, 2 and 3 levels of sharing; write-shared holds the text nearly flat where write-simple would double it at every level. cs: the intern-table pattern -- emit a table of named substructures once, then emit a graph that refers to them by name, so sharing is carried by the format as well as by the printer."
     :meta "The composition is write-shared plus an explicit naming scheme, and what emerges is the EXTERNALISED-IDENTITY pattern: do not let identity depend on which of three printers the caller happened to choose. write-shared preserves it, write and write-simple do not, and a program that cannot control its caller should put the identity in the payload where every printer must carry it.")
    (:eng "An id tag is printer-independent. It survives write, write-simple, display, and a hand-written formatter."
     :math "Text length staying flat where the unfolded form would double is the exponential saving of a label, measured rather than argued."
     :cs "Table-plus-references is how every real serialiser solves this: a symbol table and a graph that names into it. It is a datum label the format owns instead of the printer."))
)

(verb
  :name "read-string" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(read-string k [port]) -> string | eof-object"
  :summary "Read up to k characters from a textual input port as one string; the eof object when no characters remain."
  :explanation "The bulk reader, and the only one of Motoi's input verbs that lets the caller state HOW MUCH to take. R7RS-small 6.13.2 specifies it precisely: read k characters and return them as a string; if fewer than k are available before the end of input, return the ones that are; and if NO characters are available, return the eof object rather than an empty string. That last distinction is the one to hold on to -- an empty string means 'you asked for zero', and the eof object means 'there is nothing left', and a loop that confuses them either never terminates or terminates early. Note the argument order: the count comes first, the port second, which is the reverse of the shape most other port verbs use. Three argument checks are enforced rather than left to chance. The port must be TEXTUAL, so a bytevector port raises rather than answering a misleading eof. The count must be a NON-NEGATIVE exact integer, so a negative k raises instead of reaching the host's slice operation, where it would have meant 'that many characters before the END' and quietly consumed them. And with no port argument it reads from the current input port, which in Motoi is a permanently empty textual port, so it answers the eof object at once and never blocks."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-input-string \"hello world\"))\n(display (read-string 5 p))\n(newline)" :note "hello -- five characters taken, and the port is now positioned at the space.")
    (:dialect "motoi" :tier "intermediate" :code "(define p (open-input-string \"hello\"))\n(display (list 'first (read-string 3 p) 'rest (read-string 100 p) 'then (eof-object? (read-string 3 p))))\n(newline)" :note "(first hel rest lo then #t) -- asking for more than remains returns what remains, and the call after that returns the eof object.")
    (:dialect "motoi" :tier "expert" :code "(define (chunks s n)\n  (let ((p (open-input-string s)))\n    (let loop ((acc (list)))\n      (let ((c (read-string n p)))\n        (if (eof-object? c) (reverse acc) (loop (cons c acc)))))))\n(display (chunks \"abcdefgh\" 3))\n(newline)" :note "(abc def gh) -- the chunking loop, terminated by the eof object and not by a length test. The final chunk is short, which is why the loop must not assume every read returns n characters.")
  )
  :caveats ("A negative k raises. It is not treated as zero and it is not silently clamped, so a computed count that goes negative fails at the read rather than returning plausible characters from the wrong end of the port." "The eof object and the empty string are different answers. (read-string 0 p) is \"\" at any position; the eof object appears only when nothing remains." "The count comes FIRST: (read-string k port), not (read-string port k). This is the reverse of read-char, read-line and peek-char, which take the port alone." "On a binary port it raises. read-string is textual-only; use read-bytevector for bytes." "With no port argument it reads from the current input port, which in Motoi is permanently empty -- so it answers the eof object at once and never blocks.")
  :usecases ("Reading a fixed-width field out of a string port." "Chunking a long string into equal pieces for processing, with a short final piece." "Draining the remainder of a port in one call by asking for more than can be there.")
  :related ("read-char" "read-line" "peek-char" "open-input-string" "eof-object?")
  :learn (:concept "A bulk read asks for an amount and gets AT MOST that amount; the caller must handle the short read, and must distinguish a short read from no read at all." :prerequisites ("open-input-string" "read-char" "eof-object?") :progression "Learn read-char first so position is concrete, then read-line so a terminator is doing the counting, then read-string where YOU do the counting and inherit the short-read obligation.")
  :provenance "R7RS-small 6.13.2; measured against the live engine 2026-08-02 (count and port kind both validated); reference record added 2026-08-02, corrected 2026-08-02"
  :row-2-audit (
    (:eng-program "(define record \"A1042widget0012\")\n(define p (open-input-string record))\n(display (list 'sku (read-string 5 p) 'name (read-string 6 p) 'qty (read-string 4 p)))\n(newline)"
     :math-program "(define (reassembles? s n)\n  (let ((p (open-input-string s)))\n    (let loop ((acc \"\"))\n      (let ((c (read-string n p)))\n        (if (eof-object? c) (equal? acc s) (loop (string-append acc c)))))))\n(display (map (lambda (n) (reassembles? \"abcdefgh\" n)) (list 1 3 8 100)))\n(newline)"
     :cs-program "(define (drain s)\n  (let ((p (open-input-string s)))\n    (let loop ((n 0))\n      (let ((c (read-string 4 p)))\n        (if (eof-object? c) n (loop (+ n (string-length c))))))))\n(display (map drain (list \"\" \"abc\" \"abcdefgh\" \"abcdefghi\")))\n(newline)"
     :problem "The operator is walking a fixed-width record and needs the next five characters as a unit. Candidates: read-string (one call, exact count, short read at the end), five read-char calls collected into a string (correct but noisy, and each returns a character object that must be assembled), and read-line (wrong -- it counts to a terminator, and a fixed-width record has none). For 'take exactly this many', read-string is the honest verb, and the port carries the position so no index arithmetic is needed."
     :explanation "eng: three fields pulled off one port in order, positions implied by the reads. math: for every chunk size, the concatenated chunks reassemble the original string. cs: a drain loop that counts characters -- note that the empty string yields 0 because the very first read is eof."
     :meta "Why read-string and not substring: substring needs the caller to track indices, and every field boundary must be computed from the last. A port holds the position for you, so a field list becomes a sequence of counts rather than a sequence of index pairs -- and an off-by-one affects one field, not all of them.")
    (:eng "Reading fields off a port turns absolute indices into relative counts, which is what makes inserting a field a one-line change."
     :math "Concatenation of the chunks equals the source for every chunk size, including sizes larger than the source."
     :cs "Related patterns: file.read(n) in Python (which also returns a short read and an empty string at eof, not a sentinel), and InputStream.read(byte[]) in Java (which returns -1)."))
  :row-3-dimension (
    (:setup "A bounded take from a stream that carries its own position: name an amount, receive at most that amount, and let the source tell you when it is empty."
     :rungs ((:domain "io" :code "(define p (open-input-string \"abcdefgh\"))\n(display (list (read-string 3 p) (read-string 3 p) (read-string 3 p)))\n(newline)")
             (:domain "drawing a fixed number of cards from a deck that may run out mid-draw" :code "(define (draw deck n)\n  (let loop ((d deck) (k n) (got (list)))\n    (if (or (= k 0) (null? d)) (list 'drew (reverse got) 'left (length d))\n        (loop (cdr d) (- k 1) (cons (car d) got)))))\n(display (list (draw (list 1 2 3 4 5) 3) (draw (list 1 2) 3)))\n(newline)")
             (:domain "a partition of a sequence into blocks of size n, where the last block is the remainder and may be smaller" :code "(define (block-sizes total n)\n  (let loop ((left total) (acc (list)))\n    (if (<= left 0) (reverse acc) (loop (- left n) (cons (min left n) acc)))))\n(display (list (block-sizes 8 3) (block-sizes 9 3) (block-sizes 2 3)))\n(newline)"))
     :explanation "In io, read-string takes at most k characters and the port remembers where it stopped. Drawing three cards from a deck is the same act: you ask for three, you get three or however many are left, and the deck is shorter afterwards. In arithmetic, cutting a length of 8 into blocks of 3 gives 3, 3 and 2 -- the last block is the remainder, and it is smaller unless the size divides evenly. All three share: a requested amount, a possible short delivery at the end, and a source that is consumed by the taking."
     :meta "The shape transfers wherever a consumer pulls from a source that both holds position and can run dry. The recurring bug is identical in all three: code written as if every take returns the full amount, tested only on inputs whose length happens to divide evenly.")
    (:eng "Drawing from a deck that runs out must report how many were actually drawn, or the caller will assume three and index into nothing."
     :math "8 into 3 gives (3 3 2) and 9 into 3 gives (3 3 3): the short final block exists exactly when the size does not divide the total."
     :cs "This is the short-read contract, and it is why read loops are written around the returned length rather than around the requested length."))
  :row-4-proof (
    (:eng-program "(define (take-sizes s n)\n  (let ((p (open-input-string s)))\n    (let loop ((acc (list)))\n      (let ((c (read-string n p)))\n        (if (eof-object? c) (reverse acc) (loop (cons (string-length c) acc)))))))\n(display (list (take-sizes \"abcdefgh\" 3) (take-sizes \"abcdef\" 3) (take-sizes \"ab\" 3) (take-sizes \"\" 3)))\n(newline)"
     :math-program "(define (rejoins? s n)\n  (let ((p (open-input-string s)))\n    (let loop ((acc \"\"))\n      (let ((c (read-string n p)))\n        (if (eof-object? c) (equal? acc s) (loop (string-append acc c)))))))\n(display (map (lambda (n) (rejoins? \"abcdefghij\" n)) (list 1 2 3 5 10 40)))\n(newline)"
     :cs-program "(define p (open-input-string \"abc\"))\n(display (list 'zero-at-start (read-string 0 p)\n               'zero-is-a-string (string? (read-string 0 p))\n               'all-three (read-string 9 p)\n               'now-eof (eof-object? (read-string 1 p))\n               'zero-at-eof-is-eof (eof-object? (read-string 0 p))))\n(newline)"
     :claim "read-string returns at most k characters; every chunk except possibly the last has exactly k; the concatenation of all chunks equals the source; and the eof object is returned only when the port is exhausted, never as a stand-in for an empty read."
     :invariant "For all s, k > 0. concat(chunks(s, k)) = s, and every chunk but the last has length k, and the last has length in [1, k]"
     :meta "The pattern is a bulk take with a short tail. What would falsify it: a chunk longer than k, a reassembly that did not equal the source, or an empty string returned where the eof object was due. The third program probes the boundary the standard is fussiest about -- zero-length reads before and after exhaustion, which are NOT the same answer.")
    (:eng "The empty-source case is the one to keep: it yields an empty size list, because the first read is already eof."
     :math "Reassembly holds for every chunk size tried, including 40 on a 10-character source, where the single chunk is the whole string."
     :cs "At the end of input a zero-length read returns the eof object, not \"\". A loop that tests only for the empty string will not terminate."))
  :row-5-emergence (
    (:eng-composition "(define (fields src widths)\n  (let ((p (open-input-string src)))\n    (map (lambda (w) (let ((f (read-string w p))) (if (eof-object? f) \"\" f))) widths)))\n(display (fields \"A1042widget0012\" (list 5 6 4)))\n(newline)\n(display (fields \"A1042wid\" (list 5 6 4)))\n(newline)"
     :math-composition "(define (chunk-lengths s n)\n  (let ((p (open-input-string s)))\n    (let loop ((acc (list)))\n      (let ((c (read-string n p)))\n        (if (eof-object? c) (reverse acc) (loop (cons (string-length c) acc)))))))\n(define (total xs) (apply + xs))\n(display (map (lambda (n) (list n (chunk-lengths \"abcdefghij\" n) (total (chunk-lengths \"abcdefghij\" n)))) (list 3 4 10)))\n(newline)"
     :cs-composition "(define (stream-transform s n f)\n  (let ((p (open-input-string s))\n        (out (open-output-string)))\n    (let loop ()\n      (let ((c (read-string n p)))\n        (if (eof-object? c)\n            (get-output-string out)\n            (begin (display (f c) out) (loop)))))))\n(display (stream-transform \"abcdefgh\" 3 string-upcase))\n(newline)\n(display (stream-transform \"abcdefgh\" 3 (lambda (c) (string-append \"[\" c \"]\"))))\n(newline)"
     :base "read-string takes at most k characters from a port that remembers its position."
     :emergent "eng: a width-driven field reader -- give it a list of widths and it returns a list of fields, tolerating a truncated record by yielding empty strings. math: chunk lengths whose sum is the source length, for every chunk size. cs: a streaming transformer -- read a chunk, transform it, write it out, repeat -- which never holds more than one chunk plus the output in hand."
     :meta "The composition chains read-string with a loop and an output port, and what emerges is the BOUNDED-WINDOW pattern: process an arbitrarily long source with a fixed amount of working memory, because only one chunk is live at a time. This is the shape behind file copying, stream ciphers, hashing, and every transformation that must not load the whole input. The eof object is what makes the loop terminate honestly rather than by guessing the length in advance.")
    (:eng "Driving the reader from a list of widths puts the record layout in one data structure, so a layout change is a data change."
     :math "The chunk lengths always sum to 10 regardless of chunk size -- the partition is exact, and only its shape changes."
     :cs "One chunk live at a time is the whole benefit: memory is bounded by the chunk size, not by the input length."))
)

(verb
  :name "current-output-port" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(current-output-port) -> port"
  :summary "The port that display, write and newline write to when no port argument is given."
  :explanation "The default destination, named. R7RS-small 6.13.1 makes it a PARAMETER rather than a constant, which is the whole point: it can be rebound for a bounded scope with parameterize, and every verb that takes an optional port picks up the new value without being touched. Called with no arguments it returns the port itself, and that port is a first-class value -- pass it where any output port is expected, ask it questions with output-port? and textual-port?, and it answers like any other. In Motoi the default is a textual output port backed by the host's standard output, and it is the SAME object on every call, so eq? on two calls is #t. One behaviour here will surprise a reader who knows other Schemes: with-output-to-string does NOT rebind this parameter. It captures at the host stream level instead, so inside a capture (current-output-port) still returns the console port -- and writes to that port are still captured. If you want the parameter itself rebound, use parameterize, which works exactly as the standard describes."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display \"explicit\" (current-output-port))\n(newline (current-output-port))" :note "explicit followed by a line break -- naming the port does the same thing as omitting it, because omitting it means exactly this.")
    (:dialect "motoi" :tier "intermediate" :code "(define p (current-output-port))\n(display (list 'port (port? p) 'output (output-port? p) 'textual (textual-port? p) 'open (output-port-open? p) 'stable (eq? p (current-output-port))))\n(newline)" :note "(port #t output #t textual #t open #t stable #t) -- it is an ordinary port value, and the same one every time you ask.")
    (:dialect "motoi" :tier "expert" :code "(define buf (open-output-string))\n(define (report) (display \"fuel 88\") (newline))\n(parameterize ((current-output-port buf))\n  (report))\n(display (list 'captured (get-output-string buf)))\n(newline)\n(report)" :note "(captured fuel 88\n) then fuel 88 on its own line. The report procedure was never modified -- parameterize moved the default underneath it, and the captured string still carries the trailing break.")
  )
  :caveats ("It is a parameter, so its value can change. A port read out of it and stored in a variable will NOT follow a later parameterize." "with-output-to-string does not rebind it. Inside the capture (current-output-port) is still the console port; the capture happens at the host stream instead." "It is the same object on every call, so eq? is #t between two calls -- but do not rely on that inside a parameterize, where it is a different port by design." "It is a different port from current-error-port. Output written to one does not appear in the other, and their relative order on a terminal is not guaranteed." "Calling it with an argument does not set it. The reader ignores extra arguments and returns the current value; parameterize is the only way to rebind it.")
  :usecases ("Passing the default destination explicitly, so a procedure reads the same whether or not it is redirected." "Capturing a procedure's output for a test with parameterize and a string port." "Asking whether the default destination is textual or binary before choosing between write-string and write-u8.")
  :related ("current-error-port" "current-input-port" "display" "newline" "with-output-to-string")
  :learn (:concept "A default is more useful when it is a named, rebindable value than when it is hard-coded: naming it lets a caller redirect an entire body of code without editing any of it." :prerequisites ("display" "open-output-string") :progression "Learn display with no port, then display with an explicit port so the argument is real, then current-output-port as the thing the omitted argument meant, and finally parameterize as the way to change it.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (render rows port)\n  (for-each (lambda (r) (display r port) (newline port)) rows))\n(define buf (open-output-string))\n(render (list 'alpha 'beta) buf)\n(render (list 'gamma) (current-output-port))\n(display (list 'buffered (get-output-string buf)))\n(newline)"
     :math-program "(define (capture thunk)\n  (let ((b (open-output-string)))\n    (parameterize ((current-output-port b)) (thunk))\n    (get-output-string b)))\n(display (map (lambda (n) (string-length (capture (lambda () (let loop ((i 0)) (if (< i n) (begin (display \"x\") (loop (+ i 1))))))))) (list 0 1 4 9)))\n(newline)"
     :cs-program "(define outer (current-output-port))\n(define inner 'unset)\n(define b (open-output-string))\n(parameterize ((current-output-port b))\n  (set! inner (current-output-port))\n  (display \"inside\"))\n(display (list 'differ (not (eq? outer inner)) 'restored (eq? outer (current-output-port)) 'buf (get-output-string b)))\n(newline)"
     :problem "The operator has a rendering procedure and wants its output captured by a test without changing the procedure. Candidates: parameterize on current-output-port (rebinds the default for a scope, procedure untouched), threading an explicit port argument through every call (correct but invasive, and it must reach every helper), and with-output-to-string (works in Motoi, but captures at the host stream rather than rebinding the parameter, so it will not capture writes aimed at an explicit port). For redirecting a body of unmodified code, parameterize on this parameter is the honest tool."
     :explanation "eng: one renderer, two destinations, chosen by the caller. math: capturing n writes yields exactly n characters, for every n, so the redirect neither drops nor duplicates. cs: the parameter really is different inside the scope and restored after it -- the three flags are the whole contract."
     :meta "Why parameterize and not an explicit port argument: an explicit argument is better when the destination is part of the procedure's meaning, and worse when it is not. A renderer that always writes 'somewhere' should not grow a parameter in every helper just so a test can look at the output.")
    (:eng "Threading a port argument is the right call for a library; rebinding the parameter is the right call for a test harness looking at existing code."
     :math "The character count through the redirect equals the count written, so capture is faithful rather than approximate."
     :cs "Related patterns: contextlib.redirect_stdout in Python, System.setOut in Java, dynamic *standard-output* in Common Lisp. All three are this parameter under another name."))
  :row-3-dimension (
    (:setup "An ambient default that is named rather than hard-coded, so a caller can substitute it for a bounded region and everything underneath follows without knowing it happened."
     :rungs ((:domain "io" :code "(define b (open-output-string))\n(parameterize ((current-output-port b)) (display \"inner\"))\n(display (list 'outer-still-works 'yes 'captured (get-output-string b)))\n(newline)")
             (:domain "the default outgoing mailbox in an office: everyone drops letters in 'the outbox', and during a move the outbox is temporarily a different bin" :code "(define (drop-letter bin letter) (cons letter bin))\n(define (with-temp-bin temp letters) (list 'temp (fold drop-letter temp letters) 'normal-bin-untouched #t))\n(display (with-temp-bin (list) (list 'a 'b)))\n(newline)")
             (:domain "a dynamically scoped variable: the binding in force is the innermost one on the stack, not the one lexically nearest" :code "(define (depth-report)\n  (let ((b1 (open-output-string)))\n    (parameterize ((current-output-port b1))\n      (display \"level-1\")\n      (let ((b2 (open-output-string)))\n        (parameterize ((current-output-port b2)) (display \"level-2\"))\n        (display \"|back-at-1\")\n        (list 'inner (get-output-string b2) 'outer (get-output-string b1))))))\n(display (depth-report))\n(newline)"))
     :explanation "In io, current-output-port is the default destination and parameterize substitutes it for a region. An office outbox is the same arrangement: everyone was taught to drop letters in 'the outbox', so moving the outbox redirects the whole office without retraining anyone. In language semantics this is dynamic scoping -- the binding that applies is the innermost one on the call stack, which is why a procedure written years ago picks up today's substitution. All three share: an indirection that is named once, referred to everywhere, and swappable in the middle."
     :meta "The shape transfers wherever many callers must agree on a destination that a few callers need to change. The cost is the same everywhere too: dynamic scope makes behaviour depend on the call stack, so a procedure's output is no longer a function of its arguments alone.")
    (:eng "Nothing underneath the substitution needs to know it happened, which is exactly why it works and exactly why it can surprise."
     :math "Nesting composes: the inner region captures only its own writes, and the outer region resumes when it ends."
     :cs "Dynamic binding must be unwound on the error path too, or a raise inside the region leaves the default pointing at a dead port."))
  :row-4-proof (
    (:eng-program "(define outer (current-output-port))\n(define b (open-output-string))\n(define inner 'unset)\n(parameterize ((current-output-port b)) (set! inner (current-output-port)) (display \"captured\"))\n(display (list 'inner-differs (not (eq? inner outer))\n               'restored (eq? (current-output-port) outer)\n               'content (get-output-string b)))\n(newline)"
     :math-program "(define (capture-n n)\n  (let ((b (open-output-string)))\n    (parameterize ((current-output-port b))\n      (let loop ((i 0)) (if (< i n) (begin (display \"ab\") (loop (+ i 1))))))\n    (string-length (get-output-string b))))\n(display (map (lambda (n) (= (capture-n n) (* 2 n))) (list 0 1 3 7)))\n(newline)"
     :cs-program "(define outer (current-output-port))\n(define b (open-output-string))\n(guard (e (#t 'caught))\n  (parameterize ((current-output-port b))\n    (display \"before-the-raise\")\n    (error \"deliberate\")))\n(display (list 'restored-after-raise (eq? (current-output-port) outer)\n               'partial-output (get-output-string b)))\n(newline)"
     :claim "current-output-port returns a port; inside a parameterize it returns the substituted port and every default-destination write goes there; and after the region -- including after a raise inside it -- the original port is restored."
     :invariant "For all thunks t and ports p. inside parameterize(current-output-port = p): default writes land in p; after the region: current-output-port = its prior value"
     :meta "The pattern is a scoped dynamic rebinding. What would falsify it: a write escaping the substituted port, a count that did not match, or a raise leaving the parameter pointing at the substitute. The third program is the one worth keeping -- unwinding on the normal path is easy, and unwinding on the error path is where implementations differ.")
    (:eng "Checking restoration after a raise is the difference between a redirect you can use in a test suite and one that poisons every later test."
     :math "Doubling holds exactly: n writes of two characters give 2n captured characters, for every n including zero."
     :cs "The partial output before the raise is retained, which is correct -- a redirect is not a transaction, and the characters really were written."))
  :row-5-emergence (
    (:eng-composition "(define (capture thunk)\n  (let ((b (open-output-string)))\n    (parameterize ((current-output-port b)) (thunk))\n    (get-output-string b)))\n(define (greet who) (display \"hello, \") (display who) (newline))\n(display (list 'captured (capture (lambda () (greet 'motoi)))))\n(newline)\n(greet 'console)"
     :math-composition "(define (capture thunk)\n  (let ((b (open-output-string)))\n    (parameterize ((current-output-port b)) (thunk))\n    (get-output-string b)))\n(define (tee thunk)\n  (let ((s (capture thunk)))\n    (display s)\n    (string-length s)))\n(display (list 'chars (tee (lambda () (display \"abc\") (newline)))))\n(newline)"
     :cs-composition "(define (capture thunk)\n  (let ((b (open-output-string)))\n    (parameterize ((current-output-port b)) (thunk))\n    (get-output-string b)))\n(define (expect-output thunk want)\n  (let ((got (capture thunk)))\n    (list 'want want 'got got 'pass (equal? got want))))\n(display (expect-output (lambda () (display \"ok\") (newline)) \"ok\\n\"))\n(newline)\n(display (expect-output (lambda () (display \"ok\")) \"ok\\n\"))\n(newline)"
     :base "current-output-port names the default destination, and parameterize substitutes it."
     :emergent "eng: a capture helper -- three lines that turn any thunk's console output into a string, with the original destination restored afterwards. math: tee, which captures and then re-emits, so the output still reaches the console AND its size is known. cs: expect-output, an assertion that compares captured output against an expected string -- the second call deliberately fails, showing the missing trailing break."
     :meta "The composition chains this parameter with parameterize and a string port, and what emerges is the GOLDEN-OUTPUT TEST: a procedure that prints is normally untestable, because its result is a side effect; naming the destination makes the side effect a value, and a value can be compared. This is why the standard made the default a parameter rather than a constant -- testability is a consequence of the indirection, not of the ports.")
    (:eng "Writing capture once means every later test is one line, and no printing procedure ever grows a port argument for testing's sake."
     :math "Tee proves capture is non-destructive: the string is measured and then re-emitted, so nothing is lost by looking."
     :cs "The failing case is the useful one -- a golden test catches a missing trailing newline, which is invisible on a terminal and breaks every downstream parser."))
)

(verb
  :name "current-error-port" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(current-error-port) -> port"
  :summary "The port for diagnostics: a separate output channel from current-output-port, backed by the host's error stream."
  :explanation "The second channel. R7RS-small 6.13.1 gives a program two default output destinations, and the distinction is not decoration -- it is what lets a program's RESULT be piped somewhere while its COMMENTARY still reaches a human. Motoi backs this one with the host's standard error stream, and it is a genuinely different port object from current-output-port: eq? on the two is #f. That separation is observable and worth seeing once. with-output-to-string captures the standard output stream and does NOT capture this one, so a message written here passes straight through a capture and lands on the terminal. Like the other two current-* ports it is a parameter, so parameterize can point it at a string port -- which is both how you test a procedure's diagnostics and how you keep them out of a transcript. The rule of thumb the standard is built around: anything another program might consume goes to current-output-port; anything only a person should read goes here."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display \"diagnostic: tank low\" (current-error-port))\n(newline (current-error-port))\n(display \"result: 88\")\n(newline)" :note "Both lines appear on a terminal, but they travel on different channels -- the diagnostic on the error stream, the result on standard output.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list 'separate-object (not (eq? (current-error-port) (current-output-port)))\n               'is-output (output-port? (current-error-port))\n               'is-textual (textual-port? (current-error-port))\n               'is-open (output-port-open? (current-error-port))))\n(newline)" :note "(separate-object #t is-output #t is-textual #t is-open #t) -- two distinct ports, both ordinary output ports.")
    (:dialect "motoi" :tier "expert" :code "(define log (open-output-string))\n(define (warn msg) (display \"warn: \" (current-error-port)) (display msg (current-error-port)) (newline (current-error-port)))\n(parameterize ((current-error-port log))\n  (warn \"tank low\")\n  (warn \"heat high\"))\n(display (list 'captured-warnings (get-output-string log)))\n(newline)" :note "(captured-warnings warn: tank low\nwarn: heat high\n) -- parameterize redirects diagnostics into a buffer, so a test can assert on them without them reaching the terminal.")
  )
  :caveats ("It is NOT captured by with-output-to-string. That capture patches the standard output stream only, so diagnostics escape it and reach the terminal." "It is a different object from current-output-port: eq? on the two is #f, and writing to one never appears in the other." "Interleaving between the two channels is not guaranteed. Do not use relative order on a terminal to infer the order of the calls." "It is a parameter, so a port stored from it in a variable will not follow a later parameterize." "It carries no severity of its own. Writing here does not mark a program as failed and does not affect the exit status -- it only chooses a channel.")
  :usecases ("Emitting progress or warning messages from a program whose real output is being piped elsewhere." "Collecting a procedure's diagnostics in a test by rebinding this parameter to a string port." "Keeping commentary out of a transcript that must parse as data.")
  :related ("current-output-port" "current-input-port" "display" "newline" "with-output-to-string")
  :learn (:concept "Separating results from commentary is a channel decision, not a formatting decision: the same text is fine on either channel, and what changes is who can consume it downstream." :prerequisites ("display" "current-output-port") :progression "Learn current-output-port first as the default, then this one as the deliberate alternative, and then parameterize on both so you can see that they redirect independently.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02 (backed by the host error stream; not captured by with-output-to-string); reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define errs (open-output-string))\n(define (emit-row r) (display r) (newline))\n(define (emit-warning w) (display w (current-error-port)) (newline (current-error-port)))\n(parameterize ((current-error-port errs))\n  (emit-row (list 'fuel 88))\n  (emit-warning \"reading is stale\")\n  (emit-row (list 'fuel 87)))\n(display (list 'warnings-collected (get-output-string errs)))\n(newline)"
     :math-program "(define (split-channels n)\n  (let ((o (open-output-string)) (e (open-output-string)))\n    (parameterize ((current-output-port o) (current-error-port e))\n      (let loop ((i 0))\n        (if (< i n)\n            (begin (display \"o\") (display \"e\" (current-error-port)) (loop (+ i 1))))))\n    (list (string-length (get-output-string o)) (string-length (get-output-string e)))))\n(display (map split-channels (list 0 1 3 6)))\n(newline)"
     :cs-program "(define e (open-output-string))\n(define captured-stdout\n  (parameterize ((current-error-port e))\n    (with-output-to-string\n      (lambda ()\n        (display \"result\")\n        (display \"diagnostic\" (current-error-port))))))\n(display (list 'stdout captured-stdout 'stderr (get-output-string e)))\n(newline)"
     :problem "The operator is writing a tool whose standard output will be piped into another program, and needs to report a stale reading to the human running it. Candidates: current-error-port (a separate channel the pipe does not consume), current-output-port with a comment marker such as a leading semicolon (pollutes the data and forces the consumer to filter), and silence (the human never learns the reading was stale). For commentary alongside machine-consumed output, the error port is the honest channel -- it is the one the pipe does not carry."
     :explanation "eng: rows on one channel, a warning on the other, and only the warning lands in the buffer. math: n iterations put n characters on each channel independently -- neither leaks into the other. cs: the two channels separated inside a single capture, which is the sharpest way to see that with-output-to-string takes only one of them."
     :meta "Why the error port and not a marked line on standard output: a marker is a convention the consumer must implement, and every consumer must implement it identically. A separate channel is enforced by the operating system, so a consumer that knows nothing about the convention still gets clean data.")
    (:eng "If the output is data, keep it pure. A single unmarked commentary line can break a downstream parser that has run correctly for years."
     :math "The channel counts are independent: n on each, with no cross-contamination at any n."
     :cs "Related patterns: stderr in C and POSIX, sys.stderr in Python, System.err in Java. The 2>&1 idiom exists precisely because the two are separate by default."))
  :row-3-dimension (
    (:setup "A second channel reserved for commentary, so that the primary channel can carry data a machine will consume without a human's notes mixed in."
     :rungs ((:domain "io" :code "(define o (open-output-string))\n(define e (open-output-string))\n(parameterize ((current-output-port o) (current-error-port e))\n  (display \"data\")\n  (display \"note\" (current-error-port)))\n(display (list 'data (get-output-string o) 'note (get-output-string e)))\n(newline)")
             (:domain "a surveyor's field book: measurements on the ruled page, conditions and doubts in the margin" :code "(define (entry measure margin) (list 'page measure 'margin margin))\n(define book (list (entry 12.4 'fog) (entry 12.6 'clear)))\n(display (list 'measurements (map cadr book) 'margins (map cadddr book)))\n(newline)")
             (:domain "separating a signal from its metadata, so the signal can be processed by a receiver that has no interpretation for the metadata" :code "(define (strip-metadata stream) (map car stream))\n(define (metadata-only stream) (map cdr stream))\n(define s (list (cons 1 'ok) (cons 2 'noisy) (cons 3 'ok)))\n(display (list 'signal (strip-metadata s) 'meta (metadata-only s)))\n(newline)"))
     :explanation "In io, the error port carries commentary while the output port carries data. A surveyor keeps the same discipline on paper: measurements go on the ruled page in a fixed format, and 'fog rolled in' goes in the margin -- so the page can be transcribed into a table by someone who never reads the margin. In signal processing, metadata is carried out of band precisely so a receiver that cannot interpret it is not confused by it. All three share: two channels, one machine-consumable and one human-consumable, and a rule about which is which."
     :meta "The shape transfers wherever output has two audiences with different tolerances. The failure mode is always the same: someone puts a helpful note on the data channel, and a consumer that has parsed that channel for years breaks on it.")
    (:eng "The margin is where doubt goes. A measurement page that mixes doubt into the numbers cannot be transcribed mechanically."
     :math "The two projections are total and independent: reading one never requires reading the other."
     :cs "Out-of-band signalling is the general name. Its cost is that ordering between the bands is not guaranteed, which is exactly the caveat on this verb."))
  :row-4-proof (
    (:eng-program "(define o (open-output-string))\n(define e (open-output-string))\n(parameterize ((current-output-port o) (current-error-port e))\n  (display \"AAA\")\n  (display \"bb\" (current-error-port)))\n(display (list 'out (get-output-string o) 'err (get-output-string e)\n               'no-cross-talk (and (not (string-contains (get-output-string o) \"bb\"))\n                                   (not (string-contains (get-output-string e) \"AAA\")))))\n(newline)"
     :math-program "(define (counts n)\n  (let ((o (open-output-string)) (e (open-output-string)))\n    (parameterize ((current-output-port o) (current-error-port e))\n      (let loop ((i 0))\n        (if (< i n) (begin (display \"x\") (display \"yy\" (current-error-port)) (loop (+ i 1))))))\n    (list (string-length (get-output-string o)) (string-length (get-output-string e)))))\n(display (map (lambda (n) (equal? (counts n) (list n (* 2 n)))) (list 0 1 5 9)))\n(newline)"
     :cs-program "(define e (open-output-string))\n(define stdout-capture\n  (parameterize ((current-error-port e))\n    (with-output-to-string\n      (lambda ()\n        (display \"on-stdout\")\n        (display \"on-stderr\" (current-error-port))))))\n(display (list 'stdout stdout-capture\n               'stderr (get-output-string e)\n               'stderr-escaped-the-capture (not (string-contains stdout-capture \"on-stderr\"))))\n(newline)"
     :claim "current-error-port is a distinct channel: writes to it never appear on current-output-port, writes to the output port never appear on it, the counts on each are independent, and with-output-to-string captures the output channel only."
     :invariant "For all a, b. after writing a to current-output-port and b to current-error-port: content(out) = a and content(err) = b, with no term of one appearing in the other"
     :meta "The pattern is out-of-band signalling. What would falsify it: either channel containing the other's text, counts that were not independent, or with-output-to-string swallowing a diagnostic. The third program is the one that documents the Motoi-specific surprise -- on a Scheme where with-output-to-string rebinds parameters rather than patching the host stream, the answer could differ.")
    (:eng "Testing for the ABSENCE of cross-talk is the assertion that matters; testing only that each channel got its own text would pass even if both got both."
     :math "Independence holds at every n, including zero, where both channels are empty."
     :cs "A diagnostic escaping a capture is a feature when you are debugging and a nuisance when you are collecting a transcript. parameterize is the answer to the second case."))
  :row-5-emergence (
    (:eng-composition "(define (with-diagnostics thunk)\n  (let ((e (open-output-string)))\n    (parameterize ((current-error-port e)) (thunk))\n    (get-output-string e)))\n(define (compute x)\n  (if (> x 50) (begin (display \"warn: over range\" (current-error-port)) (newline (current-error-port))))\n  (* x 2))\n(display (list 'diagnostics (with-diagnostics (lambda () (compute 60) (compute 10)))))\n(newline)"
     :math-composition "(define (channel-sizes thunk)\n  (let ((o (open-output-string)) (e (open-output-string)))\n    (parameterize ((current-output-port o) (current-error-port e)) (thunk))\n    (list (string-length (get-output-string o)) (string-length (get-output-string e)))))\n(display (map (lambda (k)\n                (channel-sizes (lambda ()\n                  (let loop ((i 0))\n                    (if (< i k) (begin (display \"d\") (display \"ww\" (current-error-port)) (loop (+ i 1))))))))\n              (list 0 2 4)))\n(newline)"
     :cs-composition "(define (run thunk)\n  (let ((o (open-output-string)) (e (open-output-string)))\n    (parameterize ((current-output-port o) (current-error-port e))\n      (guard (ex (#t (display \"fatal: caught\" (current-error-port))))\n        (thunk)))\n    (list 'stdout (get-output-string o) 'stderr (get-output-string e))))\n(display (run (lambda () (display \"partial\") (error \"boom\"))))\n(newline)\n(display (run (lambda () (display \"clean\"))))\n(newline)"
     :base "current-error-port is the commentary channel, separate from the data channel."
     :emergent "eng: with-diagnostics -- run a thunk and hand back only what it complained about, leaving its real output alone. math: the two channel sizes measured together, showing they scale independently. cs: a runner that captures BOTH channels and routes a caught exception onto the error channel, so a failed run and a clean run return the same shape of answer."
     :meta "The composition chains this parameter with parameterize, a string port and guard, and what emerges is the RUN-RECORD pattern: every execution yields a triple of result, output and diagnostics, whether it succeeded or failed. This is the shape of a build log, a test report and a job runner. The value of two channels is that the record has a place to put a warning WITHOUT it contaminating the output that a later stage will parse.")
    (:eng "Handing back only the diagnostics is what lets a caller assert on warnings without asserting on the whole transcript."
     :math "Sizes scale as k and 2k independently, so neither channel's volume constrains the other."
     :cs "Routing the caught exception to the error channel keeps the output channel parseable even on the failure path -- the partial data is still there, unmixed with the fatal message."))
)

(verb
  :name "current-input-port" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(current-input-port) -> port"
  :summary "The port that read-char, read-line and read-string take from when no port is given. In Motoi it is a textual port that is permanently empty -- a deliberate dialect contract, not a stub."
  :explanation "The default source, named -- and the one place where Motoi deliberately parts company with a hosted Scheme. R7RS-small 6.13.1 makes this a parameter whose initial value is the program's standard input. Motoi's initial value is instead a textual input port over the EMPTY STRING, and that is the DIALECT CONTRACT: it is settled, it is documented here, and code may rely on it. It is a real, open, textual input port; it answers every predicate correctly, including char-ready?, which is #t exactly as the standard requires of an exhausted port; and every read from it returns the eof object immediately. Nothing blocks, nothing waits for a key, and a program that reads from the default source terminates rather than hanging. The reasoning is about ownership of the console: author code running inside Motoi does not own the keyboard, the surrounding shell does, and a language that hands a cart the terminal has given it a way to freeze the machine that no fuel limit can interrupt. An empty port is the honest way to say 'there is no input here' -- it is not a sentinel, not a #f, and not an error; it is a genuine port that genuinely has nothing in it, so every generic procedure that takes a port works on it unchanged. The parameter is still live and still useful: parameterize it over a string port and unmodified reader code sees whatever you seed it with, which is the hermetic way to test a reader, and it is why every input example in this reference builds its own port with open-input-string."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (list 'a-port (port? (current-input-port))\n               'input (input-port? (current-input-port))\n               'textual (textual-port? (current-input-port))\n               'open (input-port-open? (current-input-port))))\n(newline)" :note "(a-port #t input #t textual #t open #t) -- a perfectly ordinary open textual input port. It simply has nothing in it.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list 'read-char (eof-object? (read-char))\n               'read-line (eof-object? (read-line))\n               'read-string (eof-object? (read-string 10))))\n(newline)\n(display 'did-not-block)\n(newline)" :note "(read-char #t read-line #t read-string #t) then did-not-block -- three reads from the default source, three eof objects, no waiting.")
    (:dialect "motoi" :tier "expert" :code "(define (count-lines)\n  (let loop ((n 0))\n    (if (eof-object? (read-line)) n (loop (+ n 1)))))\n(define src (open-input-string \"alpha\\nbeta\\ngamma\"))\n(display (list 'seeded (parameterize ((current-input-port src)) (count-lines))\n               'unseeded (count-lines)))\n(newline)" :note "(seeded 3 unseeded 0) -- the same reader procedure, run twice. parameterize gives it a source; outside the region the default is empty again.")
  )
  :caveats ("It never yields data. Every read from the default source answers the eof object unless you have rebound it with parameterize. This is the Motoi contract, not a temporary limitation." "It does NOT read the keyboard or standard input. Author code cannot reach the terminal, by design -- the shell owns it." "It never blocks, which is the point -- a loop that reads until eof terminates immediately rather than hanging." "A program ported FROM a hosted Scheme will not notice the difference at the type level: every predicate answers as it would for a real stdin at end of file. It will notice that no data ever arrives, and it will notice it as silence rather than as an error." "It is a parameter: a port stored from it in a variable will not follow a later parameterize.")
  :usecases ("Seeding a reader with parameterize and a string port, so unmodified reader code can be tested hermetically." "Asserting that a program which reads the default source terminates rather than hanging." "Passing the default source explicitly to a procedure that takes an optional port.")
  :related ("current-output-port" "open-input-string" "read-line" "read-char" "eof-object?")
  :learn (:concept "A default source is a parameter, and a parameter can be substituted -- which means code written against 'the input' can be tested against a string without ever touching a real input device." :prerequisites ("open-input-string" "read-line" "eof-object?") :progression "Learn open-input-string and an explicit port first, because that is what actually works here; meet current-input-port second, as the thing an omitted port argument refers to; and learn parameterize third, as the only way to make the default carry anything.")
  :provenance "R7RS-small 6.13.1, with a documented Motoi dialect contract substituting an empty textual port for standard input; measured against the live engine 2026-08-02; reference record added 2026-08-02, contract blessed 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (read-all)\n  (let loop ((acc (list)))\n    (let ((l (read-line)))\n      (if (eof-object? l) (reverse acc) (loop (cons l acc))))))\n(define src (open-input-string \"one\\ntwo\"))\n(display (list 'with-parameterize (parameterize ((current-input-port src)) (read-all))\n               'without (read-all)))\n(newline)"
     :math-program "(define (line-count s)\n  (parameterize ((current-input-port (open-input-string s)))\n    (let loop ((n 0)) (if (eof-object? (read-line)) n (loop (+ n 1))))))\n(display (map line-count (list \"\" \"a\" \"a\\nb\" \"a\\nb\\nc\")))\n(newline)"
     :cs-program "(define (drain port)\n  (let loop ((n 0)) (if (eof-object? (read-char port)) n (loop (+ n 1)))))\n(display (list 'default-source (drain (current-input-port))\n               'explicit-source (drain (open-input-string \"abcd\"))))\n(newline)"
     :problem "The operator has a reader procedure written against the default input source and wants to run it on a fixed string. Candidates: parameterize on current-input-port (rebinds the default, procedure untouched), rewriting the procedure to take a port argument (correct, but it must reach every helper), and with-input-from-string (which in Motoi passes the port as an ARGUMENT to the thunk rather than rebinding the parameter, so a zero-argument reader will not see it). For running unmodified default-source readers against a string, parameterize is the honest tool here."
     :explanation "eng: one reader, two runs -- seeded it finds two lines, unseeded it finds none, and neither run hangs. math: the line count equals the number of lines in the seed for every seed tried, including the empty one. cs: draining the default source yields zero characters, which is the whole finding stated as a number."
     :meta "Why parameterize and not with-input-from-string: in Motoi the latter hands the port to the thunk as an argument, so it suits a thunk written to accept one. A reader that calls (read-line) with no port needs the PARAMETER moved, and parameterize is what moves it.")
    (:eng "Seeding through the parameter is what makes a reader testable without giving every helper a port argument it does not otherwise need."
     :math "Counting lines of the empty seed gives zero, which is the same answer the unseeded default gives -- the default behaves exactly like an empty source, because it is one."
     :cs "Related patterns: monkeypatching sys.stdin in Python, System.setIn in Java. Motoi differs in that the unpatched default is empty rather than a terminal."))
  :row-3-dimension (
    (:setup "A default source that is present, well-formed and empty: every question about it answers correctly, and every request for content answers 'there is none'."
     :rungs ((:domain "io" :code "(display (list 'open (input-port-open? (current-input-port))\n               'yields (eof-object? (read-char (current-input-port)))))\n(newline)")
             (:domain "a functioning tap connected to a dry main: the handle turns, the washer seals, and no water arrives" :code "(define (tap working? supplied?) (list 'turns working? 'delivers (and working? supplied?)))\n(display (list (tap #t #t) (tap #t #f)))\n(newline)")
             (:domain "the empty sequence: a legitimate element of the domain, on which every total operation is defined and every fold returns its identity" :code "(define (fold-count xs) (if (null? xs) 0 (+ 1 (fold-count (cdr xs)))))\n(define (chars-of s) (parameterize ((current-input-port (open-input-string s)))\n  (let loop ((n 0)) (if (eof-object? (read-char)) n (loop (+ n 1))))))\n(display (list 'empty-list (fold-count (list)) 'empty-port (chars-of \"\") 'three (chars-of \"abc\")))\n(newline)"))
     :explanation "In io, the default input port is open, textual and empty. A tap connected to a dry main behaves the same way: the mechanism is sound, every test of the mechanism passes, and turning it delivers nothing -- the fault, if it is one, is upstream of the thing you are holding. In mathematics the empty sequence is not a defect either; it is a legitimate input on which folds return the identity and loops run zero times. All three share: a well-formed object whose emptiness is a property of what it is connected to, not a malfunction of the object itself."
     :meta "The shape transfers wherever a component can be correct and useless at the same time. It matters for diagnosis: testing the port tells you nothing, because the port is fine -- the question to ask is what it is attached to.")
    (:eng "A tap that turns freely proves the tap, not the supply. Checking input-port-open? proves the port, not that anything will arrive."
     :math "Zero is the honest answer for the empty case, and a loop that handles it correctly needs no special case at all."
     :cs "Empty is not the same as absent, and neither is the same as blocked. A blocking empty source hangs; this one returns."))
  :row-4-proof (
    (:eng-program "(define (terminates? thunk) (begin (thunk) 'terminated))\n(display (list 'read-loop-terminates\n               (terminates? (lambda () (let loop () (if (eof-object? (read-line)) 'done (loop)))))\n               'char-loop-terminates\n               (terminates? (lambda () (let loop () (if (eof-object? (read-char)) 'done (loop)))))))\n(newline)"
     :math-program "(define (chars-of s)\n  (parameterize ((current-input-port (open-input-string s)))\n    (let loop ((n 0)) (if (eof-object? (read-char)) n (loop (+ n 1))))))\n(display (map (lambda (s) (= (chars-of s) (string-length s))) (list \"\" \"a\" \"abcd\" \"a\\nb\")))\n(newline)"
     :cs-program "(display (list 'char (eof-object? (read-char (current-input-port)))\n               'peek (eof-object? (peek-char (current-input-port)))\n               'line (eof-object? (read-line (current-input-port)))\n               'string (eof-object? (read-string 5 (current-input-port)))\n               'char-ready (char-ready? (current-input-port))\n               'r7rs-requires-char-ready-to-be #t))\n(newline)"
     :claim "Every read from the unrebound current-input-port returns the eof object immediately, so read-until-eof loops terminate; under parameterize the same code reads exactly the seeded characters; and char-ready? on the default port answers #t, which is what R7RS-small requires of a port at end of file."
     :invariant "For all seeds s. count(read-char until eof under parameterize with s) = |s|; and with no parameterize, count = 0"
     :meta "The pattern is an always-exhausted source. What would falsify it: a read that blocked, a loop that did not terminate, or a count that disagreed with the seed length. The third program is the conformance evidence -- it puts the measured char-ready? answer next to the standard's requirement on the same printed line, so an empty port cannot be mistaken for a never-ready one.")
    (:eng "Proving termination is the point. On a hosted Scheme this same loop waits for a human, and here it is a test that finishes."
     :math "The count equals the seed length for every seed, so the parameter substitution is faithful and not approximate."
     :cs "char-ready? answers #t at end of file, which is the standard's rule and the useful one: the question is whether a read would WAIT, and a read from an exhausted port does not wait -- it returns eof at once."))
  :row-5-emergence (
    (:eng-composition "(define (with-input s thunk)\n  (parameterize ((current-input-port (open-input-string s))) (thunk)))\n(define (read-all-lines)\n  (let loop ((acc (list)))\n    (let ((l (read-line)))\n      (if (eof-object? l) (reverse acc) (loop (cons l acc))))))\n(display (with-input \"alpha\\nbeta\" read-all-lines))\n(newline)\n(display (with-input \"\" read-all-lines))\n(newline)"
     :math-composition "(define (with-input s thunk)\n  (parameterize ((current-input-port (open-input-string s))) (thunk)))\n(define (count-chars)\n  (let loop ((n 0)) (if (eof-object? (read-char)) n (loop (+ n 1)))))\n(display (map (lambda (s) (list (string-length s) (with-input s count-chars))) (list \"\" \"ab\" \"abcde\")))\n(newline)"
     :cs-composition "(define (with-input s thunk)\n  (parameterize ((current-input-port (open-input-string s))) (thunk)))\n(define (parse-pairs)\n  (let loop ((acc (list)))\n    (let ((l (read-line)))\n      (if (eof-object? l)\n          (reverse acc)\n          (let ((i (string-index l \"=\")))\n            (loop (cons (if i (cons (substring l 0 i) (substring l (+ i 1))) (cons l \"\")) acc)))))))\n(define out (open-output-string))\n(parameterize ((current-output-port out))\n  (display (with-input \"a=1\\nb=2\\nbare\" parse-pairs)))\n(display (list 'parsed (get-output-string out)))\n(newline)"
     :base "current-input-port is the default source, and in Motoi it is empty until parameterize gives it something."
     :emergent "eng: with-input -- three lines that make any default-source reader run against a string, including the empty string. math: the character count always matches the seed length, so the harness is transparent. cs: a key/value parser written entirely against the default source, driven by a seed and with its output captured too -- neither end of the program touches a real device."
     :meta "The composition chains this parameter with parameterize, open-input-string and a matching output capture, and what emerges is the HERMETIC HARNESS: a program with both ends stubbed, which runs identically on any machine, in any order, with no device, and terminates by construction. Motoi's empty default is what makes this the ONLY way to write an input example here -- and the discipline it forces is the one you would want anyway.")
    (:eng "Handling the empty seed in the same helper is what makes the harness safe to point at a degenerate case."
     :math "Seed length and observed count agree at every size, so the harness introduces no characters of its own."
     :cs "Both ends stubbed is the definition of a hermetic test: no clock, no device, no network, and therefore no flake."))
)

(verb
  :name "input-port-open?" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "predicate"
  :signature "(input-port-open? obj) -> boolean"
  :summary "Answers whether obj is an input port that has not been closed yet."
  :explanation "Two questions in one answer. R7RS-small 6.13.1 defines this as returning #t when its argument is an input port that is still open, and #f otherwise -- and 'otherwise' swallows three different situations: the argument is an output port, the argument is not a port at all, or the argument is an input port that has been closed. That merge is deliberate. The caller almost always wants to know one thing -- may I read from this? -- and a single boolean answers it without a chain of guards. The predicate is total: it never raises, no matter what you hand it, so it is safe to apply to a value of unknown provenance. In Motoi the flag it reads is set by close-input-port and by close-port, and once lowered it never rises again -- a port has one lifetime, not a switch. There is a divergence here that the caveats spell out and that the expert example demonstrates: this predicate reports a closed port correctly, but the read verbs do not consult the same flag, so a closed port still yields characters. Treat the predicate as the contract and the read as undefined behaviour, not the other way round."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-input-string \"hi\"))\n(display (input-port-open? p))\n(newline)\n(close-input-port p)\n(display (input-port-open? p))\n(newline)" :note "#t then #f on the next line -- open while it is open, closed after close-input-port, and nothing else changes the answer.")
    (:dialect "motoi" :tier "intermediate" :code "(define ip (open-input-string \"hi\"))\n(define op (open-output-string))\n(display (list 'input (input-port-open? ip) 'output (input-port-open? op) 'number (input-port-open? 42)))\n(newline)" :note "(input #t output #f number #f) -- an output port and a number both answer #f, because the question is 'may I read from this' and neither one is readable.")
    (:dialect "motoi" :tier "expert" :code "(define p (open-input-string \"abc\"))\n(close-input-port p)\n(display (list 'reports-closed (not (input-port-open? p))\n               'read-refused (guard (e (#t 'raised)) (begin (read-char p) 'read-anyway))))\n(newline)" :note "(reports-closed #t read-refused raised) -- the predicate and the port agree. Reading a closed port raises rather than handing back a character, so the state the predicate reports is the state the port actually enforces.")
  )
  :caveats ("A #f answer is a hard stop, not a hint. Every read verb resolves its port through the same check and RAISES on a closed port, so the predicate and the reads cannot disagree." "It never raises. A number, a symbol, a string and the empty list all answer #f rather than signalling a type error, so a #f answer does not tell you WHICH thing went wrong -- wrong type and closed port look alike here." "It is not port?. An output port is a port and answers #f here; use port? when you want to know 'is this a port' and this when you want to know 'may I read'." "Closing twice is not an error and does not change the answer -- the second close is a no-op and the port stays closed." "It says nothing about whether data remains. An open port at end of file still answers #t; use char-ready? or peek-char with eof-object? for that question.")
  :usecases ("Guarding a read helper so it returns a sentinel instead of touching a port that has already been closed." "Asserting in a test that a with-input-port style wrapper actually closed the port it opened." "Filtering a mixed collection of ports down to the ones still available for reading.")
  :related ("output-port-open?" "close-input-port" "input-port?" "port?" "char-ready?")
  :learn (:concept "A predicate that merges several failure cases into one #f is easier to call and harder to diagnose with -- the trade is deliberate, and knowing which side you are on tells you whether to reach for it." :prerequisites ("open-input-string" "close-input-port") :progression "Learn open-input-string and close-input-port so a port has a visible lifetime, then this predicate as the way to ask where in that lifetime a port is, then the guard pattern that uses it.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (drain p)\n  (let loop ((acc (list)))\n    (let ((c (read-char p)))\n      (if (eof-object? c) (list->string (reverse acc)) (loop (cons c acc))))))\n(define (safe-drain p)\n  (if (input-port-open? p) (drain p) 'port-closed))\n(define a (open-input-string \"alpha\"))\n(define b (open-input-string \"beta\"))\n(close-input-port b)\n(display (list (safe-drain a) (safe-drain b)))\n(newline)"
     :math-program "(define (open-count n)\n  (let loop ((i 0) (ports (list)))\n    (if (= i n)\n        (length (filter input-port-open? ports))\n        (loop (+ i 1) (cons (open-input-string \"x\") ports)))))\n(display (map open-count (list 0 1 3 7)))\n(newline)"
     :cs-program "(define p (open-input-string \"data\"))\n(display (list 'before (input-port-open? p)))\n(newline)\n(close-input-port p)\n(display (list 'after (input-port-open? p)))\n(newline)\n(close-input-port p)\n(display (list 'again (input-port-open? p)))\n(newline)"
     :problem "The operator has a helper that reads a port to exhaustion and wants it to behave sanely when handed a port that some earlier stage already closed. Candidates: input-port-open? (one total boolean, no raise, exactly the question being asked), input-port? (answers #t for a closed input port, so it does not distinguish the case at all), and guard around the read (which does fire, because a closed read raises -- but it turns a foreseeable state into an exception, and it will catch unrelated failures from inside the same region). The predicate is the right shape: ask before you act, and reserve the guard for what you could not have asked about."
     :explanation "eng: two ports, one open and one closed, and the helper reports rather than misbehaves. math: n freshly opened ports give exactly n open ports, for every n -- opening is what sets the flag. cs: the lifetime is one-way; the second close is a no-op and the answer stays #f."
     :meta "Why the predicate and not the guard: both work, and they answer different questions. Reach for a predicate when the failure is a STATE you can look at, and for a guard when it is an EVENT you cannot foresee. A guard wrapped around a whole drain loop also catches every other error the loop can raise, so it converts a precise question into a vague one.")
    (:eng "The sentinel is better than a raise here because a closed port is a normal outcome of an earlier stage, not an emergency."
     :math "Open count equals opened count exactly, so the predicate is measuring the operation and not some incidental property."
     :cs "Idempotent close is what lets cleanup run twice without a flag of its own -- the same reason free(NULL) is defined in C."))
  :row-3-dimension (
    (:setup "A resource has a one-way lifetime -- available, then permanently not -- and a cheap total question reports which state it is in without disturbing it."
     :rungs ((:domain "io" :code "(define p (open-input-string \"payload\"))\n(display (list 'live (input-port-open? p)))\n(newline)\n(close-input-port p)\n(display (list 'spent (input-port-open? p)))\n(newline)")
             (:domain "a library book: on the shelf and borrowable, or checked out -- and asking the catalogue costs nothing and moves no book" :code "(define (shelf-state borrowed?) (if borrowed? 'checked-out 'available))\n(define (borrowable? state) (eq? state 'available))\n(display (map borrowable? (map shelf-state (list #f #t))))\n(newline)")
             (:domain "a monotone boolean in state machines: a latch that can fall but never rise, so any observation is still true later in the same direction" :code "(define (latch-trace events)\n  (let loop ((es events) (open #t) (trace (list)))\n    (if (null? es)\n        (reverse trace)\n        (let ((now (if (eq? (car es) 'close) #f open)))\n          (loop (cdr es) now (cons now trace))))))\n(display (latch-trace (list 'read 'read 'close 'read 'close)))\n(newline)"))
     :explanation "In io the port is open until closed and then closed forever, and input-port-open? reads that latch. A library catalogue is the same arrangement at human scale: the entry says borrowable or not, asking is free, and the answer can go stale the instant someone else acts. In state-machine terms this is a MONOTONE boolean -- it falls once and never rises -- which is what makes a cached answer safe in one direction only: a #f you read earlier is still #f, but a #t you read earlier may have become #f. All three share a resource with a one-way life and an observation that does not consume it."
     :meta "The shape transfers to file handles, sockets, database connections and locks. What transfers with it is the hazard: between the check and the use, someone else may close it -- the check-then-act race, which no predicate can remove on its own.")
    (:eng "Ask as late as possible, immediately before the use, because the answer is only as fresh as the moment you took it."
     :math "Monotonicity is the useful property: falsity is stable under time, truth is not."
     :cs "This is TOCTOU. The predicate narrows the window; only single ownership closes it."))
  :row-4-proof (
    (:eng-program "(define p (open-input-string \"abc\"))\n(define before (input-port-open? p))\n(close-input-port p)\n(define after (input-port-open? p))\n(close-input-port p)\n(define again (input-port-open? p))\n(display (list 'opens-true before 'closes-false (not after) 'stays-false (not again)))\n(newline)"
     :math-program "(define (fresh-all-open n)\n  (let loop ((i 0) (ps (list)))\n    (if (= i n)\n        (= (length (filter input-port-open? ps)) n)\n        (loop (+ i 1) (cons (open-input-string \"q\") ps)))))\n(display (map fresh-all-open (list 0 1 2 5 9)))\n(newline)"
     :cs-program "(display (list 'never-raises\n               (map (lambda (x) (guard (e (#t 'raised)) (input-port-open? x)))\n                    (list 42 \"text\" 'sym (list) (open-output-string) (open-input-string \"z\")))))\n(newline)"
     :claim "input-port-open? is #t exactly for an unclosed input port; closing drives it to #f permanently; and it is total -- it returns a boolean for every argument rather than raising."
     :invariant "For all ports p. p fresh from open-input-string => #t; after close-input-port => #f; and for all objects x. (input-port-open? x) is a boolean"
     :meta "Three claims, three programs, and the third is the one that is easy to assume and expensive to be wrong about. A predicate that raises on the wrong type cannot be used as a filter, and a filter is the main reason to have it. What would falsify the set: a fresh port answering #f, a closed port answering #t, or any argument producing a raise.")
    (:eng "Totality is a feature you only notice when it is missing -- the moment a predicate can raise, every call site grows a guard."
     :math "The open count equals n for every n tested including zero, so the property is not an artifact of one size."
     :cs "The mixed-type list is the real test: numbers, strings, symbols, the empty list, and a port of the wrong direction all return without raising."))
  :row-5-emergence (
    (:eng-composition "(define (with-input-port str proc)\n  (let ((p (open-input-string str)))\n    (let ((r (proc p)))\n      (close-input-port p)\n      (list 'result r 'leaked (input-port-open? p)))))\n(display (with-input-port \"hello\" read-char))\n(newline)"
     :math-composition "(define (make-pool strs) (map open-input-string strs))\n(define (retire! ps) (for-each close-input-port ps))\n(define pool (make-pool (list \"a\" \"bb\" \"ccc\")))\n(define live (length (filter input-port-open? pool)))\n(retire! pool)\n(define dead (length (filter (lambda (p) (not (input-port-open? p))) pool)))\n(display (list 'live live 'dead dead 'conserved (= live dead)))\n(newline)"
     :cs-composition "(define (checked-read p)\n  (if (input-port-open? p)\n      (let ((c (read-char p))) (if (eof-object? c) 'eof c))\n      'closed))\n(define p (open-input-string \"ab\"))\n(display (list (checked-read p) (checked-read p) (checked-read p)))\n(newline)\n(close-input-port p)\n(display (list 'after-close (checked-read p)))\n(newline)"
     :base "input-port-open? reports whether a port is still readable, and close-input-port is what makes it stop being so."
     :emergent "eng: with-input-port -- open, use, close, and PROVE the close happened by asking the predicate in the same breath. math: a pool where every port retires, and the live count before equals the dead count after, so nothing leaked. cs: checked-read, a read that returns 'closed instead of the undefined behaviour a bare read-char would give on a closed port."
     :meta "The composition chains this predicate with close-input-port and a read, and what emerges is the SELF-AUDITING RESOURCE WRAPPER: a helper that manages a lifetime and reports on its own bookkeeping rather than asking you to trust it. That last part is what makes it worth writing -- an unchecked wrapper and a leaking wrapper look identical from the outside.")
    (:eng "The 'leaked #f in the output is the whole point; a wrapper that cannot demonstrate its own cleanup is a promise, not a guarantee."
     :math "Live before equals dead after, which is conservation: every port that existed was accounted for on both sides."
     :cs "checked-read is the correct shape given the divergence -- it makes the closed case a value instead of relying on a read that does not check."))
)

(verb
  :name "output-port-open?" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "predicate"
  :signature "(output-port-open? obj) -> boolean"
  :summary "Answers whether obj is an output port that has not been closed yet."
  :explanation "The mirror of input-port-open?, asking about the other direction: may I write to this? R7RS-small 6.13.1 defines it as #t for an open output port and #f for everything else -- an input port, a closed output port, or an object that is not a port at all. Like its mirror it is total and never raises, so it works as a filter over a heterogeneous list without a guard. The two predicates partition the ports rather than overlapping: a string input port answers #t to input-port-open? and #f to this one, and the console port answers #t here. Kind is orthogonal to direction, so both a string output port and a bytevector output port answer #t -- for the textual-versus-binary question use textual-port? and binary-port?. The same divergence that afflicts the input side afflicts this one, and the expert example shows it: after close-output-port the predicate correctly reports #f, but a display aimed at that port still appends to its buffer. The predicate is the contract; a write to a closed port is undefined behaviour that happens not to raise."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-output-string))\n(display (output-port-open? p))\n(newline)\n(close-output-port p)\n(display (output-port-open? p))\n(newline)" :note "#t then #f on the next line -- writable while open, and not after close-output-port.")
    (:dialect "motoi" :tier "intermediate" :code "(define op (open-output-string))\n(define bo (open-output-bytevector))\n(define ip (open-input-string \"x\"))\n(display (list 'string-out (output-port-open? op) 'bytevector-out (output-port-open? bo) 'input (output-port-open? ip) 'console (output-port-open? (current-output-port))))\n(newline)" :note "(string-out #t bytevector-out #t input #f console #t) -- direction is what the predicate asks about; textual versus binary does not enter into it, and the console port is an ordinary open output port.")
    (:dialect "motoi" :tier "expert" :code "(define p (open-output-string))\n(close-output-port p)\n(display (list 'reports-closed (not (output-port-open? p))\n               'write-refused (guard (e (#t 'raised)) (begin (display \"after close\" p) 'accepted))\n               'buffer (get-output-string p)))\n(newline)" :note "(reports-closed #t write-refused raised buffer ) -- the predicate says closed and the write is refused, so the two agree. The buffer is still readable after the close: closing a sink stops new writes, it does not discard what was already collected.")
  )
  :caveats ("A #f answer is a hard stop. Every write verb resolves its port through the same check and RAISES on a closed port, so a message sent to a closed sink is lost loudly rather than quietly." "It never raises. Every non-port answers #f rather than signalling, so a #f does not distinguish 'wrong type' from 'closed'." "It does not tell you the port's kind. A bytevector output port answers #t exactly like a string output port; ask binary-port? or textual-port? for that." "It is not output-port?. A closed output port is still an output port and answers #t to output-port? while answering #f here." "Closing does not destroy the contents. get-output-string and get-output-bytevector still return what was written before the close, so a closed port is readable-back but not writable -- two different lifetimes on one object.")
  :usecases ("Guarding a logging helper so it drops a message rather than writing to a sink that has already been closed." "Checking in a test that a wrapper closed the port it opened." "Selecting, from a list of sinks, the ones still able to accept output.")
  :related ("input-port-open?" "close-output-port" "output-port?" "current-output-port" "flush-output-port")
  :learn (:concept "Direction and lifetime are separate questions about a port, and the standard folds them into one predicate per direction because the caller's real question is always 'may I use this, now, this way'." :prerequisites ("open-output-string" "close-output-port") :progression "Learn open-output-string and get-output-string so a sink has a visible lifetime, then close-output-port, then this predicate as the way to ask whether the sink is still live.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (log! sink msg)\n  (if (output-port-open? sink)\n      (begin (display msg sink) (newline sink) 'logged)\n      'dropped))\n(define a (open-output-string))\n(define b (open-output-string))\n(close-output-port b)\n(display (list (log! a \"boot\") (log! b \"boot\")))\n(newline)\n(display (list 'a-holds (get-output-string a)))\n(newline)"
     :math-program "(define (open-sinks n)\n  (let loop ((i 0) (ps (list)))\n    (if (= i n)\n        (length (filter output-port-open? ps))\n        (loop (+ i 1) (cons (open-output-string) ps)))))\n(display (map open-sinks (list 0 2 4 8)))\n(newline)"
     :cs-program "(define op (open-output-string))\n(define ip (open-input-string \"x\"))\n(define (both p) (list (input-port-open? p) (output-port-open? p)))\n(display (list 'output-port (both op) 'input-port (both ip) 'number (both 7)))\n(newline)"
     :problem "The operator wants a logger that never explodes when its sink has gone away. Candidates: output-port-open? (asks exactly 'can this still take output', total, no raise), output-port? (answers #t for a closed port, so it lets the bad write through and the write then raises), and a guard around the write (which does fire -- the write to a closed port raises -- but a logger built on a guard reports every failure as an exception, and a dead sink is not an exceptional condition for a logger). The predicate observes the state that changed and lets the logger choose to drop."
     :explanation "eng: two sinks, one live and one closed, and the logger reports rather than corrupting either. math: n fresh output ports give n open ports for every n. cs: the two predicates partition -- an output port is (#f #t), an input port is (#t #f), a number is (#f #f)."
     :meta "Why a predicate and not a guard, again: guards catch events and predicates observe states. A closed port is a state, and it is a state the logger can do something sensible about. A guard here would work and would still be the wrong shape -- it makes a foreseeable outcome look like a fault, and it swallows unrelated errors from the same region.")
    (:eng "Dropping a log line is the right failure for a logger -- a logger that raises turns a diagnostic into an outage."
     :math "The open count tracks the opened count exactly, so the flag is set by opening and by nothing else."
     :cs "The two predicates are disjoint on ports and jointly false off them, which is what makes a two-way dispatch on them total."))
  :row-3-dimension (
    (:setup "A destination has a one-way life -- accepting, then permanently not -- and a free, non-disturbing question reports which state it is in before anything is sent."
     :rungs ((:domain "io" :code "(define p (open-output-string))\n(display (list 'live (output-port-open? p)))\n(newline)\n(close-output-port p)\n(display (list 'spent (output-port-open? p)))\n(newline)")
             (:domain "a post box on a street that is due to be removed: while it stands you may post, once it is taken away you may not, and reading the plate costs nothing" :code "(define (box-state removed?) (if removed? 'removed 'standing))\n(define (postable? s) (eq? s 'standing))\n(display (map postable? (map box-state (list #f #t))))\n(newline)")
             (:domain "a closed channel in concurrency: sending to it is an error, and asking whether it is closed is a cheap non-blocking read of a flag" :code "(define (send-all ch-open? msgs)\n  (if ch-open?\n      (list 'sent (length msgs))\n      (list 'rejected (length msgs))))\n(display (list (send-all #t (list 'a 'b)) (send-all #f (list 'a 'b))))\n(newline)"))
     :explanation "In io the sink is open until closed and then closed for good, and output-port-open? reads that flag. A post box due for removal is the same at street scale: while it stands, posting works; once removed, it does not; and looking at it costs nothing and posts nothing. In concurrency this is a closed channel -- the send fails once the receiver is gone, and the closed check is a cheap flag read rather than an attempted send. All three: a one-way destination and an observation that does not commit anything."
     :meta "The shape transfers to sockets, pipes, file handles and message queues. So does the hazard -- the answer is a snapshot, and in a system with more than one writer it can be stale before you act on it.")
    (:eng "Check immediately before the write, not at the top of the procedure, because staleness grows with the gap."
     :math "Again monotone: #f is stable forward in time and #t is not."
     :cs "The robust pattern in real systems is check-and-also-handle-the-failure, because the check alone is a race."))
  :row-4-proof (
    (:eng-program "(define p (open-output-string))\n(define before (output-port-open? p))\n(close-output-port p)\n(define after (output-port-open? p))\n(close-output-port p)\n(display (list 'opens-true before 'closes-false (not after) 'stays-false (not (output-port-open? p))))\n(newline)"
     :math-program "(define (all-open n)\n  (let loop ((i 0) (ps (list)))\n    (if (= i n)\n        (= (length (filter output-port-open? ps)) n)\n        (loop (+ i 1) (cons (open-output-string) ps)))))\n(display (map all-open (list 0 1 3 6)))\n(newline)"
     :cs-program "(define (probe x) (guard (e (#t 'raised)) (list (output-port-open? x) (input-port-open? x))))\n(display (map probe (list 99 \"s\" 'y (list) (open-output-string) (open-input-string \"z\") (open-output-bytevector))))\n(newline)"
     :claim "output-port-open? is #t exactly for an unclosed output port of either kind; closing drives it to #f permanently; and it is total, returning a boolean for every argument."
     :invariant "For all ports p. p fresh from open-output-string or open-output-bytevector => #t; after close-output-port => #f; and for all objects x. (output-port-open? x) is a boolean"
     :meta "The third program pairs both direction predicates over a mixed list so the partition is visible in one line: exactly one of the two is #t for a port and neither is for anything else. What would falsify the claim: a fresh port answering #f, a closed port answering #t, a raise on any argument, or a port answering #t to both.")
    (:eng "The mixed list includes a bytevector output port on purpose -- kind must not affect a direction question."
     :math "All-open holds for every n tested including zero, so it is a property of opening rather than of a particular count."
     :cs "Totality is what lets this be used with filter and map directly, which is where predicates earn their keep."))
  :row-5-emergence (
    (:eng-composition "(define (with-output-port proc)\n  (let ((p (open-output-string)))\n    (proc p)\n    (let ((s (get-output-string p)))\n      (close-output-port p)\n      (list 'wrote s 'leaked (output-port-open? p)))))\n(display (with-output-port (lambda (p) (display \"report\" p) (newline p))))\n(newline)"
     :math-composition "(define sinks (list (open-output-string) (open-output-string) (open-output-string)))\n(define (broadcast! msg)\n  (length (filter (lambda (p) (and (output-port-open? p) (begin (display msg p) #t))) sinks)))\n(define first-round (broadcast! \"a\"))\n(close-output-port (car sinks))\n(define second-round (broadcast! \"b\"))\n(display (list 'first first-round 'second second-round 'contents (map get-output-string sinks)))\n(newline)"
     :cs-composition "(define (make-logger sink)\n  (lambda (msg)\n    (if (output-port-open? sink)\n        (begin (display msg sink) (newline sink) 'ok)\n        'sink-closed)))\n(define buf (open-output-string))\n(define log (make-logger buf))\n(display (list (log \"one\") (log \"two\")))\n(newline)\n(close-output-port buf)\n(display (list 'after (log \"three\")))\n(newline)"
     :base "output-port-open? reports whether a sink can still take output, and close-output-port is what ends that."
     :emergent "eng: with-output-port -- open, write, harvest, close, and prove the close in the same result. math: a broadcast that counts its live sinks, so closing one sink drops the count by exactly one and the other sinks are unaffected. cs: a logger CLOSURE that carries its sink and degrades to a sentinel rather than writing into a closed port."
     :meta "The composition chains this predicate with close-output-port and a write, and what emerges is the FAN-OUT WITH GRACEFUL DEGRADATION: one message, many sinks, and a sink that dies takes itself out of the count without taking the broadcast down. This is the shape behind every multi-destination logger, and the predicate is the entire mechanism -- there is no registry, no exception, just a question asked before each write.")
    (:eng "The logger closure is the practical form: the sink is captured once and checked every time, so the caller never handles a port."
     :math "Three sinks then two: the count drops by exactly the number closed, which is what makes the degradation predictable rather than merely survivable."
     :cs "Note what the second round shows -- the closed sink kept its old contents and gained nothing, so the drop is clean."))
)

(verb
  :name "binary-port?" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "predicate"
  :signature "(binary-port? obj) -> boolean"
  :summary "Answers whether obj is a port that carries bytes rather than characters."
  :explanation "Every port in R7RS-small has two independent attributes: a DIRECTION (input or output) and a KIND (textual or binary). binary-port? asks about the kind. R7RS-small 6.13.1 defines it as #t when the argument is a binary port and #f otherwise, and 'otherwise' again covers both textual ports and objects that are not ports at all. A binary port's unit is the octet: read-u8, peek-u8 and write-u8 are its verbs, bytevectors are its currency, and open-input-bytevector, open-output-bytevector and get-output-bytevector are how you make and empty one without touching a device. Kind is fixed at creation and never changes -- there is no verb that converts a textual port to a binary one, which is why a program decides once, at the point it opens the port, and then dispatches on this predicate everywhere after. The standard says applying a textual operation to a binary port is an error; Motoi does not enforce that, and the caveats record what it does instead. Note also that binary-port? and textual-port? are exclusive and exhaustive over ports, so (not (binary-port? p)) is only the same as textual-port? once you already know p is a port."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (list (binary-port? (open-input-bytevector #u8(1 2)))\n               (binary-port? (open-input-string \"ab\"))))\n(newline)" :note "(#t #f) -- a bytevector port carries bytes, a string port carries characters, and the predicate names the difference.")
    (:dialect "motoi" :tier "intermediate" :code "(define (kind p)\n  (cond ((binary-port? p) 'binary)\n        ((textual-port? p) 'textual)\n        (else 'not-a-port)))\n(display (map kind (list (open-input-string \"a\")\n                         (open-output-string)\n                         (open-input-bytevector #u8(1))\n                         (open-output-bytevector)\n                         (current-output-port)\n                         42)))\n(newline)" :note "(textual textual binary binary textual not-a-port) -- kind is independent of direction: both string ports are textual, both bytevector ports are binary, the console is textual, and a number is neither.")
    (:dialect "motoi" :tier "expert" :code "(define b (open-output-bytevector))\n(write-char #\\A b)\n(display \"text\" b)\n(display (list 'bytes (get-output-bytevector b) 'still-binary (binary-port? b)))\n(newline)" :note "(bytes #u8(65 116 101 120 116) still-binary #t) -- R7RS-small says a textual write to a binary port is an error. Motoi instead encodes the characters as bytes and appends them. The port's kind is unchanged, so the predicate still answers #t.")
  )
  :caveats ("MEASURED DIVERGENCE: Motoi accepts a TEXTUAL WRITE to a binary output port, encoding the characters as UTF-8 bytes, where R7RS-small 6.13.1 makes that an error. This is the one direction that is still permissive; it is convenient and it is not portable, so write bytes to binary ports." "It never raises. A number, a string or a symbol answers #f, so #f does not mean 'textual', it means 'not binary'." "Kind is fixed at creation. There is no conversion verb; if you need both views, keep both ports and copy between them explicitly." "It says nothing about direction or about whether the port is open. Pair it with input-port-open? or output-port-open? when you are about to actually use the port." "Every other cross-kind operation RAISES: read-u8 and peek-u8 on a textual port, read-char and read-string on a binary port, and write-u8 on a textual port all signal rather than answering a misleading eof.")
  :usecases ("Dispatching an emit helper between write-u8 and write-char so one procedure serves both kinds of sink." "Rejecting a binary port early in a routine that formats text, before any output has been produced." "Writing a describe-port diagnostic that reports direction, kind and open state together.")
  :related ("textual-port?" "open-input-bytevector" "open-output-bytevector" "read-u8" "write-u8")
  :learn (:concept "A port has two orthogonal attributes -- which way it flows and what unit it carries -- and holding them apart is what stops a program from confusing 'I cannot read this' with 'I cannot read it THAT way'." :prerequisites ("open-input-bytevector" "open-input-string") :progression "Learn a textual port first, then a bytevector port so two kinds exist to compare, then this predicate as the way to tell them apart, then the kind-dispatch helper that uses it.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (emit p thing)\n  (cond ((binary-port? p) (write-u8 thing p) 'wrote-byte)\n        ((textual-port? p) (write-char thing p) 'wrote-char)\n        (else 'refused)))\n(define bo (open-output-bytevector))\n(define so (open-output-string))\n(display (list (emit bo 65) (emit so #\\A) (emit 'nope 0)))\n(newline)\n(display (list 'bytes (get-output-bytevector bo) 'chars (get-output-string so)))\n(newline)"
     :math-program "(define (roundtrip bytes)\n  (let ((p (open-input-bytevector bytes)))\n    (let loop ((acc (list)))\n      (let ((b (read-u8 p)))\n        (if (eof-object? b) (reverse acc) (loop (cons b acc)))))))\n(display (map (lambda (bv) (list (binary-port? (open-input-bytevector bv)) (length (roundtrip bv))))\n              (list #u8() #u8(5) #u8(1 2 3 4))))\n(newline)"
     :cs-program "(define (describe p)\n  (list 'port (port? p)\n        'kind (cond ((binary-port? p) 'binary) ((textual-port? p) 'textual) (else 'none))\n        'dir (cond ((input-port? p) 'in) ((output-port? p) 'out) (else 'none))))\n(display (map describe (list (open-input-bytevector #u8(1)) (open-output-string) 7)))\n(newline)"
     :problem "The operator has one emit helper that must serve both a bytevector sink and a string sink. Candidates: binary-port? (asks the kind directly and dispatches in one cond), trying write-u8 and catching the failure (it does raise on a textual port, so this works -- but it commits the write attempt before knowing whether it was legal, and on the other kind of sink there is no symmetric probe, because a textual write to a BINARY port is accepted), and tracking the kind in a wrapper record beside the port (works, but duplicates a fact the port already carries and can drift from it). Ask the port."
     :explanation "eng: one helper, two sinks, a refusal for the non-port, and the two buffers show the right unit landed in each. math: the number of bytes read back equals the number given, for every bytevector, so the binary path is lossless. cs: the describe helper prints the two attributes side by side, which is the clearest way to show they are independent."
     :meta "Why not try-and-catch: the two mismatches are not symmetric. write-u8 on a textual port raises, so a probe there would work; display on a binary port is ACCEPTED, so there is nothing to catch and the wrong branch leaves real bytes behind. A predicate is the only detector that behaves the same in both directions.")
    (:eng "The refusal branch matters as much as the two writing branches -- a cond over predicates should always have an else that names the leftover case."
     :math "Byte count in equals byte count out for every input including the empty bytevector, so the kind carries no hidden framing."
     :cs "Kind and direction are two bits, giving four port species, and every one of them appears somewhere in this chapter."))
  :row-3-dimension (
    (:setup "A channel carries exactly one unit of transport, that unit is fixed when the channel is made, and a cheap question tells a sender which unit to speak before anything is sent."
     :rungs ((:domain "io" :code "(define b (open-input-bytevector #u8(72 105)))\n(define t (open-input-string \"Hi\"))\n(display (list 'binary (binary-port? b) 'textual (binary-port? t)))\n(newline)"
)
             (:domain "a railway gauge: a line is laid at one gauge, rolling stock must match it, and you check the gauge before you send a train rather than after" :code "(define (fits? line-gauge train-gauge) (equal? line-gauge train-gauge))\n(display (list (fits? 'standard 'standard) (fits? 'standard 'narrow)))\n(newline)")
             (:domain "a typed channel in a language with static types: the element type is part of the channel's type, so a mismatched send is caught before the program runs" :code "(define (channel unit) (list 'channel unit))\n(define (channel-unit c) (cadr c))\n(define (send c payload-unit)\n  (if (eq? (channel-unit c) payload-unit) 'accepted 'type-error))\n(display (list (send (channel 'byte) 'byte) (send (channel 'byte) 'char)))\n(newline)"))
     :explanation "In io the port's kind fixes its unit -- octets or characters -- and binary-port? reports it. A railway gauge is the same constraint in iron: the line is built to one gauge, stock must match, and checking the gauge is free while running the wrong train is not. A statically typed channel is the same idea moved to compile time, where the unit is part of the channel's type and the mismatch is caught before anything runs. All three: a transport with one legal unit, fixed at construction, checkable without committing."
     :meta "The shape transfers to sockets, serial links, codecs and message buses. What differs is only WHEN the check happens -- at compile time in a typed language, at run time inside the verb for most of Motoi's port operations, and not at all for a textual write to a binary port, which is the one gap this predicate has to cover by hand.")
    (:eng "Check the gauge at the junction, once, and let everything downstream assume it."
     :math "The relation is equality on a small tag set, which is why the check is O(1) and total."
     :cs "The earlier the unit is known, the cheaper the mismatch: a type error beats a run-time error beats a silent no-op."))
  :row-4-proof (
    (:eng-program "(define ports (list (open-input-bytevector #u8(1)) (open-output-bytevector) (open-input-string \"a\") (open-output-string)))\n(display (list 'binary (map binary-port? ports)\n               'textual (map textual-port? ports)\n               'exclusive (map (lambda (p) (not (eq? (binary-port? p) (textual-port? p)))) ports)))\n(newline)"
     :math-program "(define (stable bv)\n  (let ((p (open-input-bytevector bv)))\n    (let ((before (binary-port? p)))\n      (let loop ()\n        (if (not (eof-object? (read-u8 p))) (loop)))\n      (list before (binary-port? p) (eq? before (binary-port? p))))))\n(display (map stable (list #u8() #u8(3) #u8(1 2 3))))\n(newline)"
     :cs-program "(display (list 'never-raises\n               (map (lambda (x) (guard (e (#t 'raised)) (binary-port? x)))\n                    (list 0 \"s\" 'y (list) #u8(1) (open-output-bytevector)))))\n(newline)"
     :claim "binary-port? and textual-port? are mutually exclusive on every port; a port's kind does not change as the port is consumed or closed; and binary-port? is total, returning a boolean for any argument."
     :invariant "For all ports p. (binary-port? p) = (not (textual-port? p)); and for all operations on p. the kind before = the kind after; and for all objects x. (binary-port? x) is a boolean"
     :meta "Exclusivity is the claim worth proving because the whole dispatch pattern rests on it -- a cond that tests binary first and textual second is only correct if no port answers #t to both. The second program checks the kind before and after draining the port, because 'fixed at creation' is an assumption the dispatch helper silently depends on. What would falsify: a port answering #t to both predicates, a kind changing under reads, or a raise on a non-port.")
    (:eng "The exclusivity row is the one to read: four ports, four #t values, no overlap."
     :math "Draining changes the position and not the kind, for every bytevector including the empty one."
     :cs "The bytevector itself is in the totality list on purpose -- a bytevector is not a port, and confusing the container with the channel is the obvious mistake here."))
  :row-5-emergence (
    (:eng-composition "(define (copy-bytes-to-text src)\n  (let ((out (open-output-string)))\n    (if (binary-port? src)\n        (let loop ()\n          (let ((b (read-u8 src)))\n            (if (not (eof-object? b))\n                (begin (write-char (integer->char b) out) (loop)))))\n        (display \"not-binary\" out))\n    (get-output-string out)))\n(display (list (copy-bytes-to-text (open-input-bytevector #u8(77 111 116 111 105)))\n               (copy-bytes-to-text (open-input-string \"x\"))))\n(newline)"
     :math-composition "(define (byte-histogram bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((counts (list)) (n 0))\n      (let ((b (read-u8 p)))\n        (if (eof-object? b)\n            (list 'kind (if (binary-port? p) 'binary 'textual) 'total n 'distinct (length counts))\n            (loop (if (member b counts) counts (cons b counts)) (+ n 1)))))))\n(display (map byte-histogram (list #u8() #u8(7 7 7) #u8(1 2 2 3))))\n(newline)"
     :cs-composition "(define (sink-for kind)\n  (if (eq? kind 'binary) (open-output-bytevector) (open-output-string)))\n(define (put! p v)\n  (cond ((binary-port? p) (write-u8 v p))\n        ((textual-port? p) (write-char v p))))\n(define (harvest p)\n  (if (binary-port? p) (get-output-bytevector p) (get-output-string p)))\n(define b (sink-for 'binary))\n(define t (sink-for 'textual))\n(put! b 66) (put! b 67)\n(put! t #\\B) (put! t #\\C)\n(display (list 'binary (harvest b) 'textual (harvest t)))\n(newline)"
     :base "binary-port? names a port's transport unit, and that name is stable for the port's whole life."
     :emergent "eng: a byte-to-text bridge that reads octets and produces characters, refusing politely when handed the wrong kind. math: a histogram walk that reports the kind alongside the totals, so the measurement carries its own provenance. cs: a three-verb KIND-POLYMORPHIC SINK -- make, put, harvest -- where every step dispatches on this one predicate and the caller never mentions bytes or characters again."
     :meta "The composition chains this predicate with the kind-specific constructors, writers and harvesters, and what emerges is a POLYMORPHIC INTERFACE built out of nothing but a boolean: three thin wrappers give a caller one vocabulary over two transports. This is how Scheme does what a class hierarchy does elsewhere -- dispatch on a predicate at the boundary, and keep the interior uniform.")
    (:eng "The bridge is the honest version of the divergence in the caveats: convert explicitly instead of relying on Motoi accepting characters into a binary port."
     :math "Total and distinct counts are computed by the same walk that reports the kind, so the label can never disagree with the data."
     :cs "Three wrappers is the whole abstraction -- if a fourth is needed, the right move is a record carrying the operations, not a longer cond."))
)

(verb
  :name "textual-port?" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "predicate"
  :signature "(textual-port? obj) -> boolean"
  :summary "Answers whether obj is a port that carries characters rather than bytes."
  :explanation "The other half of the kind question, and the half a beginner meets first: almost every port in an ordinary program is textual. R7RS-small 6.13.1 defines textual-port? as #t when its argument is a textual port and #f otherwise, where 'otherwise' takes in binary ports and everything that is not a port at all. A textual port's unit is the character: read-char, peek-char, read-line, read-string, write-char, write-string, display, write and newline are its verbs, and open-input-string, open-output-string and get-output-string are how you make one and empty it without touching a device. The console ports are textual, which is why display works with no port argument. Kind is decided at creation and never changes. Together with binary-port? this predicate partitions the ports exactly -- every port answers #t to precisely one of the two -- and that exactness is what makes a two-branch cond over them a total dispatch. Motoi does not enforce the standard's rule that a byte operation on a textual port is an error; it no-ops or returns eof instead, which the caveats record, and which is the strongest argument for asking the predicate rather than trying the operation."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (list (textual-port? (open-input-string \"a\")) (textual-port? (open-output-string)) (textual-port? (open-input-bytevector #u8(1))) (textual-port? 'sym)))\n(newline)" :note "(#t #t #f #f) -- both string ports are textual whichever way they flow, a bytevector port is not, and a symbol is not a port at all.")
    (:dialect "motoi" :tier "intermediate" :code "(define (text-sink? p) (and (textual-port? p) (output-port-open? p)))\n(display (map text-sink? (list (open-output-string) (open-input-string \"a\") (open-output-bytevector) (current-output-port) 5)))\n(newline)" :note "(#t #f #f #t #f) -- kind and direction are separate questions, so a usable text sink needs both answered, and the console port passes both.")
    (:dialect "motoi" :tier "expert" :code "(define t (open-output-string))\n(display (list 'textual (textual-port? t)\n               'write-u8-refused (guard (e (#t 'raised)) (begin (write-u8 65 t) 'landed))\n               'sink-empty (= (string-length (get-output-string t)) 0)))\n(newline)" :note "(textual #t write-u8-refused raised sink-empty #t) -- R7RS-small says a byte write to a textual port is an error, and Motoi signals it. The predicate tells you in advance and the port tells you if you do not ask.")
  )
  :caveats ("Byte operations on a textual port RAISE: write-u8, read-u8 and peek-u8 all signal rather than doing nothing or answering a misleading eof. R7RS-small 6.13.1 makes them an error and Motoi treats them as one." "The reverse direction is NOT symmetric. display and write-char on a BINARY port are accepted in Motoi and encode as UTF-8 bytes, so a #f from this predicate is the only warning you get before writing text into a byte sink." "It never raises. Any non-port answers #f, so #f means 'not textual' and not 'binary'." "Kind is fixed at creation. To move between kinds, read from one port and write to another explicitly." "It says nothing about direction or open state. A closed textual port still answers #t here; pair it with input-port-open? or output-port-open? before using the port." "(not (textual-port? p)) equals (binary-port? p) only when p is already known to be a port -- for anything else both predicates answer #f.")
  :usecases ("Guarding a formatting routine so it refuses a binary sink before it has emitted anything." "Building a text-sink? helper that checks kind and open state together, which is the real precondition for a write." "Deciding between write-string and write-u8 in a helper that serves both kinds of destination.")
  :related ("binary-port?" "open-input-string" "open-output-string" "write-string" "read-char")
  :learn (:concept "Two predicates that partition a set exactly let a two-branch conditional be a total dispatch -- and the else branch still earns its place, because the set they partition is 'ports' and the argument might not be one." :prerequisites ("open-input-string" "open-output-string") :progression "Learn string ports so a textual port exists, then bytevector ports so a second kind exists to contrast, then this predicate, then the kind-plus-direction guard that real code uses.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (render p vals)\n  (if (textual-port? p)\n      (begin (for-each (lambda (v) (display v p) (display \" \" p)) vals) 'rendered)\n      'wrong-kind))\n(define s (open-output-string))\n(display (list (render s (list 1 'two \"three\")) (render (open-output-bytevector) (list 1))))\n(newline)\n(display (list 'text (get-output-string s)))\n(newline)"
     :math-program "(define (count-textual ps) (length (filter textual-port? ps)))\n(display (map (lambda (n)\n                (count-textual (let loop ((i 0) (acc (list)))\n                                 (if (= i n) acc (loop (+ i 1) (cons (open-input-string \"x\") acc))))))\n              (list 0 1 4 9)))\n(newline)"
     :cs-program "(define ports (list (open-input-string \"a\") (open-output-string) (open-input-bytevector #u8(1)) (open-output-bytevector)))\n(display (list 'textual (map textual-port? ports)\n               'binary (map binary-port? ports)\n               'exactly-one (map (lambda (p) (not (eq? (textual-port? p) (binary-port? p)))) ports)))\n(newline)"
     :problem "The operator has a formatter that must refuse a binary destination BEFORE it writes anything, so a half-formatted record never reaches a sink that cannot hold it. Candidates: textual-port? (a precondition check that costs nothing and happens before the first write), writing and checking afterwards (too late -- and in Motoi a textual write to a binary port is ACCEPTED and encoded as bytes, so the check finds a full sink and no error), and a guard around the whole render (never fires, for the same reason: this is the one cross-kind operation Motoi does not reject). Only the precondition sees the problem in time."
     :explanation "eng: one render, two sinks, and the binary one is refused with no partial output. math: n textual ports give a count of n for every n. cs: over four ports the two kind predicates are complementary in every position, which is the property the dispatch relies on."
     :meta "Why a precondition and not a post-check: a post-check assumes the failed operation leaves evidence of failure. Here it leaves evidence of SUCCESS -- bytes in a bytevector that read back as a plausible encoding of the text. When a mistake produces a well-formed result, checks must move to the front.")
    (:eng "Refusing before the first write is what keeps a sink either fully written or untouched, never half."
     :math "Count equals input size at every n including zero, so the predicate is not accidentally selecting on something else."
     :cs "Complementarity in all four positions is the evidence that a two-branch cond is exhaustive over ports."))
  :row-3-dimension (
    (:setup "A carrier admits exactly one commodity, the choice is made when the carrier is built, and a free question tells the shipper which commodity to bring before anything is loaded."
     :rungs ((:domain "io" :code "(define t (open-output-string))\n(define b (open-output-bytevector))\n(display (list 'text-sink (textual-port? t) 'byte-sink (textual-port? b)))\n(newline)")
             (:domain "a pipeline: one line carries water and another carries gas, the line is built for its commodity, and reading the label is free while injecting the wrong one is not" :code "(define (line commodity) (list 'line commodity))\n(define (accepts? l c) (eq? (cadr l) c))\n(display (list (accepts? (line 'water) 'water) (accepts? (line 'water) 'gas)))\n(newline)")
             (:domain "a homogeneous container in a typed language: the element type is part of the container's type, so a mismatched insert cannot be written at all" :code "(define (typed-box t) (list 'box t (list)))\n(define (insert box v-type)\n  (if (eq? (cadr box) v-type) 'inserted 'rejected))\n(display (list (insert (typed-box 'char) 'char) (insert (typed-box 'char) 'byte)))\n(newline)"))
     :explanation "In io a textual port admits characters and nothing else, and textual-port? reports that. A pipeline is the same in steel: the line is built for water or for gas, the label is free to read, and the consequence of ignoring it is not recoverable. A homogeneous typed container moves the same rule into the type system, where the mismatch is not a run-time failure but an unwritable program. All three: one legal commodity, fixed at construction, cheaply interrogable."
     :meta "The shape transfers to codecs, serializers, buffers and wire formats. The interesting variation across the three is only how loudly a mismatch fails -- unwritable, catastrophic, or, for a textual write into a Motoi binary port, not at all.")
    (:eng "Label at the source and check at the junction; do not infer the commodity from what comes out the far end."
     :math "The check is equality on a two-element tag set, so it is constant time and total."
     :cs "Silent acceptance of the wrong commodity is the worst of the three failure modes, because the cost lands far from the cause."))
  :row-4-proof (
    (:eng-program "(define ps (list (open-input-string \"a\") (open-output-string) (open-input-bytevector #u8(1)) (open-output-bytevector)))\n(display (list 'partition (map (lambda (p) (if (textual-port? p) 'text 'byte)) ps)\n               'no-overlap (not (member #t (map (lambda (p) (and (textual-port? p) (binary-port? p))) ps)))))\n(newline)"
     :math-program "(define (stable s)\n  (let ((p (open-input-string s)))\n    (let ((before (textual-port? p)))\n      (let loop ()\n        (if (not (eof-object? (read-char p))) (loop)))\n      (list before (textual-port? p) (eq? before (textual-port? p))))))\n(display (map stable (list \"\" \"a\" \"abcd\")))\n(newline)"
     :cs-program "(display (list 'never-raises\n               (map (lambda (x) (guard (e (#t 'raised)) (textual-port? x)))\n                    (list 0 \"s\" 'y (list) #u8(1) (open-input-string \"z\")))))\n(newline)"
     :claim "textual-port? is #t for exactly the character-carrying ports and never simultaneously with binary-port?; a port's kind is unchanged by reading it to exhaustion; and the predicate is total, returning a boolean for any argument."
     :invariant "For all ports p. exactly one of (textual-port? p) and (binary-port? p) is #t; and consuming p leaves its kind unchanged; and for all objects x. (textual-port? x) is a boolean"
     :meta "The no-overlap check is written as a search for a counterexample rather than an assertion of the good case, which is the stronger form: it looks for a port that is both and reports that none was found. What would falsify: any port answering #t to both predicates, a kind that changed under reads, or a raise on a non-port.")
    (:eng "A string is in the totality list because a string and a string port are the pair most often confused."
     :math "Draining moves the position and leaves the kind alone, for every string including the empty one."
     :cs "Searching for a counterexample beats confirming the expected case -- the second passes even when the property is only usually true."))
  :row-5-emergence (
    (:eng-composition "(define (safe-format p vals)\n  (cond ((not (port? p)) 'not-a-port)\n        ((not (textual-port? p)) 'wrong-kind)\n        ((not (output-port-open? p)) 'closed)\n        (else (for-each (lambda (v) (write v p) (write-char #\\space p)) vals) 'ok)))\n(define good (open-output-string))\n(define shut (open-output-string))\n(close-output-port shut)\n(display (list (safe-format good (list 1 \"two\" 'three))\n               (safe-format (open-output-bytevector) (list 1))\n               (safe-format 42 (list 1))))\n(newline)\n(display (list 'wrote (get-output-string good)))\n(newline)"
     :math-composition "(define (echo-through s)\n  (let ((in (open-input-string s)) (out (open-output-string)))\n    (let loop ()\n      (let ((c (read-char in)))\n        (if (not (eof-object? c)) (begin (write-char c out) (loop)))))\n    (let ((got (get-output-string out)))\n      (list (string-length s) (string-length got) (string=? s got)))))\n(display (map echo-through (list \"\" \"a\" \"motoi\")))\n(newline)"
     :cs-composition "(define (describe p)\n  (if (port? p)\n      (list (if (textual-port? p) 'textual 'binary)\n            (if (input-port? p) 'input 'output)\n            (if (or (input-port-open? p) (output-port-open? p)) 'open 'closed))\n      (list 'not-a-port)))\n(define shut (open-input-string \"x\"))\n(close-input-port shut)\n(display (map describe (list (open-input-string \"a\") (open-output-bytevector) shut \"nope\")))\n(newline)"
     :base "textual-port? names a port's commodity, and the naming is stable for the port's whole life."
     :emergent "eng: safe-format, a write guarded by a LADDER of preconditions -- is it a port, is it the right kind, is it still open -- each returning a distinct sentinel so a caller learns which one failed. math: an echo through a pair of string ports, where length and content are preserved exactly, proving the textual path is lossless. cs: describe, a three-attribute port summary that turns an opaque handle into a readable label."
     :meta "The composition chains this predicate with port?, the direction predicates and the open predicates, and what emerges is the PRECONDITION LADDER: instead of one boolean 'can I use this', a sequence of narrowing questions, each with its own answer, so a failure names itself. This is the difference between a check and a diagnostic, and it costs three extra lines.")
    (:eng "Distinct sentinels are the point -- 'wrong-kind and 'closed send a maintainer to different places, while a bare #f sends them to both."
     :math "Length in equals length out and the strings compare equal, for every input including the empty string."
     :cs "describe is the debugging tool this chapter is missing; five predicates and a cond turn a port into something you can print."))
)

(verb
  :name "char-ready?" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "predicate"
  :signature "(char-ready? [port]) -> boolean"
  :summary "Answers whether a character can be read from a textual port without waiting."
  :explanation "This is the non-blocking probe. R7RS-small 6.13.2 defines char-ready? as returning #t if a character is ready on the port, so that a following read-char will not block -- and it explicitly requires #t at end of file as well, on the reasoning that a read at end of file returns an eof object immediately and so does not wait either. The intent is precise: char-ready? is a question about WAITING, not about DATA. That distinction is the whole verb, and it is the one thing to carry away from this record. Every Motoi port is backed by a string or a bytevector already in memory, so a read can never wait: there is always either a character to hand back or an eof object to hand back, and both are immediate. char-ready? is therefore #t for every open textual input port, at every position, including at end of file. That is not a shrug -- it is the correct answer to the question the standard asks, and a constant answer is what a source that never blocks is supposed to give. The port argument is optional and defaults to current-input-port. What the verb does NOT tell you is whether any characters remain; for that, peek-char and eof-object? are the answer, and a loop that uses char-ready? as its terminator will never stop."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-input-string \"hi\"))\n(display (char-ready? p))\n(newline)\n(read-char p)\n(read-char p)\n(display (char-ready? p))\n(newline)" :note "#t then #t on the next line -- the answer does not change when the characters run out, because the question is whether a read would WAIT and a read at end of file does not wait. R7RS-small 6.13.2 requires exactly this.")
    (:dialect "motoi" :tier "intermediate" :code "(define p (open-input-string \"ab\"))\n(define (next-if-ready p)\n  (if (char-ready? p)\n      (let ((c (peek-char p))) (if (eof-object? c) 'end c))\n      'would-block))\n(display (list (next-if-ready p) (begin (read-char p) (next-if-ready p)) (begin (read-char p) (next-if-ready p))))\n(newline)" :note "(a b end) -- the correct two-step shape. char-ready? answers the waiting question, and eof-object? answers the data question; using one for the other is the classic error.")
    (:dialect "motoi" :tier "expert" :code "(define p (open-input-string \"x\"))\n(read-char p)\n(display (list 'motoi-says (char-ready? p) 'r7rs-requires #t 'at-eof (eof-object? (peek-char p))))\n(newline)\n(display (list 'on-output-port (guard (e (#t 'raised)) (char-ready? (open-output-string)))))\n(newline)\n(display (list 'on-non-port (guard (e (#t 'raised)) (char-ready? 42))))\n(newline)" :note "(motoi-says #t r7rs-requires #t at-eof #t) then (on-output-port raised) then (on-non-port raised) -- the port is simultaneously at end of file and ready, which is the case the standard singles out. The wrong-type arguments raise rather than answering, so a #t is always a real port's answer.")
  )
  :caveats ("#t DOES NOT MEAN A CHARACTER REMAINS. It means a read will not wait. At end of file both are true at once: the read returns immediately AND it returns an eof object. Test for the end with peek-char and eof-object?, never with this." "A loop written as (if (char-ready? p) (read-char p) ...) never terminates in Motoi, because the answer is always #t. This is the single most common way to misuse the verb, and it was how an earlier version of this record was written." "It raises on an output port, on a binary port, and on a non-port rather than answering #f. It is a probe for textual input ports, not a total predicate -- check input-port? and textual-port? first if the argument's direction is unknown." "The answer is constant in Motoi because every port is already in memory. On a Scheme reading a console or a socket it genuinely varies, so a program that branches on it is still meaningful and portable." "With no argument it probes current-input-port, which is an open textual port over the empty string, so the no-argument form answers #t and a read from it answers the eof object.")
  :usecases ("Guarding a read in code that must also run on a Scheme where input can block, so the same source is correct in both places." "Asserting in a test that a port is live and textual, since the verb raises on every other kind of argument." "Teaching the difference between waiting and ending -- the two questions a beginner reliably conflates.")
  :related ("u8-ready?" "peek-char" "read-char" "eof-object?" "current-input-port")
  :learn (:concept "A probe that asks 'will this block' is a different question from 'is there data', and the two only look the same on a source that never waits -- which is why a string port is the wrong place to learn the difference and the right place to see it stated." :prerequisites ("read-char" "peek-char" "eof-object?") :progression "Learn read-char, then peek-char as a read that does not consume, then this as a probe that does not even peek, and finally the difference between waiting and ending.")
  :provenance "R7RS-small 6.13.2; measured against the live engine 2026-08-02; reference record added 2026-08-02; conformed and re-measured 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (drain-ready p)\n  (let loop ((acc (list)))\n    (let ((c (read-char p)))\n      (if (eof-object? c) (list->string (reverse acc)) (loop (cons c acc))))))\n(display (map (lambda (s) (drain-ready (open-input-string s))) (list \"\" \"a\" \"abc\")))\n(newline)"
     :math-program "(define (ready-steps s)\n  (let ((p (open-input-string s)))\n    (let loop ((n 0))\n      (if (eof-object? (peek-char p)) n (begin (read-char p) (loop (+ n 1)))))))\n(display (map (lambda (s) (= (ready-steps s) (string-length s))) (list \"\" \"a\" \"ab\" \"abcdef\")))\n(newline)"
     :cs-program "(define (safe-ready p)\n  (cond ((not (port? p)) 'not-a-port)\n        ((not (input-port? p)) 'not-an-input-port)\n        ((not (textual-port? p)) 'not-textual)\n        (else (char-ready? p))))\n(display (map safe-ready (list (open-input-string \"a\") (open-output-string) (open-input-bytevector #u8(1)) 42)))\n(newline)"
     :problem "The operator wants to consume a string port completely. Candidates: char-ready? as the loop condition (WRONG -- it answers whether a read would wait, which is always #t here, so the loop never ends), read-char plus eof-object? (correct and portable, though it consumes before it tests, so the loop body must handle the eof value), and peek-char plus eof-object? (correct, portable, and the one to reach for when the decision must happen before the character is taken). Only the last two terminate."
     :explanation "eng: three strings drained to completion, including the empty one, with no eof value ever entering the accumulator -- and the test is eof-object?, not readiness. math: the number of steps equals the string length exactly, for every string, because peek-char is what reports the end. cs: the guard ladder is required because the bare verb raises on anything that is not a textual input port -- checking direction and kind first turns a raise into a value."
     :meta "The rejected candidate is the instructive one. char-ready? reads like a data-remaining test in English, and it is not one; a loop built on that misreading spins forever rather than failing loudly, which is why it is worth naming here instead of leaving it to be discovered.")
    (:eng "The empty string draining to the empty string is the case worth checking -- a loop that tests after reading gets it wrong."
     :math "Steps equal length exactly, so peek-char is measuring characters and not something adjacent to them."
     :cs "The ladder exists because this verb raises where a total predicate would answer #f; a probe that raises must be wrapped before it can be mapped."))
  :row-3-dimension (
    (:setup "Before committing to an action that might make you wait, ask a cheap question that never waits, and act only on a yes."
     :rungs ((:domain "io" :code "(define p (open-input-string \"go\"))\n(display (list 'ready (char-ready? p) 'take (read-char p) 'still (char-ready? p)))\n(newline)")
             (:domain "a shop counter: glance to see whether anyone is serving before joining the queue, because glancing costs a second and queueing costs ten minutes" :code "(define (counter staffed?) (if staffed? 'serving 'unattended))\n(define (join? state) (eq? state 'serving))\n(display (map join? (map counter (list #t #f))))\n(newline)")
             (:domain "non-blocking IO in an event loop: poll the descriptor for readiness, and only then issue the read that would otherwise park the whole thread" :code "(define (poll-then-read ready? value) (if ready? (list 'read value) (list 'skipped 'would-block)))\n(display (list (poll-then-read #t 'byte) (poll-then-read #f 'byte)))\n(newline)"))
     :explanation "In io char-ready? is the poll and read-char is the commit. A glance at a shop counter is the same discipline at human scale: the cheap observation happens first and decides whether the expensive one happens at all. In an event loop this is literally the design -- select or poll reports readiness, and only a ready descriptor is read, because a blocking read in a single-threaded loop stops everything. All three: a cheap non-committing observation guarding an expensive committing one."
     :meta "The shape transfers anywhere latency is asymmetric between asking and doing. It brings the same flaw everywhere: readiness observed is readiness in the past, so between the poll and the read the world may have changed.")
    (:eng "Poll immediately before the read, and still be prepared for the read to behave differently."
     :math "The guard only pays off when the cost of asking is far below the cost of waiting, which is what makes it worth a whole verb."
     :cs "This is the check-then-act race again, and in a single reader it is harmless, which is why single ownership is the usual fix."))
  :row-4-proof (
    (:eng-program "(define (steps s)\n  (let ((p (open-input-string s)))\n    (let loop ((n 0))\n      (if (eof-object? (peek-char p)) n (begin (read-char p) (loop (+ n 1)))))))\n(display (map (lambda (s) (list (string-length s) (steps s) (= (steps s) (string-length s)))) (list \"\" \"z\" \"abc\")))\n(newline)"
     :math-program "(define (idempotent s)\n  (let ((p (open-input-string s)))\n    (let ((a (char-ready? p)) (b (char-ready? p)) (c (char-ready? p)))\n      (list (eq? a b) (eq? b c) (equal? (read-char p) (string-ref s 0))))))\n(display (map idempotent (list \"a\" \"xy\" \"motoi\")))\n(newline)"
     :cs-program "(define p (open-input-string \"q\"))\n(read-char p)\n(display (list 'at-eof (char-ready? p)\n               'standard-requires #t\n               'conforms (eq? (char-ready? p) #t)\n               'raises-on-output (guard (e (#t #t)) (begin (char-ready? (open-output-string)) #f))))\n(newline)"
     :claim "char-ready? does not consume: repeated calls give the same answer and leave the next read-char unchanged; it answers #t at end of file exactly as R7RS-small 6.13.2 requires; and it raises rather than answering when handed something that is not a textual input port."
     :invariant "For all textual input ports p. (char-ready? p) does not advance p; and (char-ready? p) = #t at every position including end of file"
     :meta "The third program states the end-of-file case as a passing assertion rather than a caveat, because that is the clause implementations get wrong and the one this record itself formerly got wrong. What would falsify the set: a call to char-ready? advancing the port, two consecutive calls disagreeing, or the end-of-file answer coming back #f.")
    (:eng "Non-consumption is the property everything else rests on -- a probe that consumed would be a read with a bad name."
     :math "Three consecutive calls agree and the following read still returns the first character, for every string tested."
     :cs "Pinning the end-of-file answer to #t in an executable assertion is what stops the data-remaining misreading from creeping back in."))
  :row-5-emergence (
    (:eng-composition "(define (at-end? p) (eof-object? (peek-char p)))\n(define (take-while-ready p n)\n  (let loop ((i 0) (acc (list)))\n    (if (or (= i n) (at-end? p))\n        (list->string (reverse acc))\n        (loop (+ i 1) (cons (read-char p) acc)))))\n(define p (open-input-string \"abcdef\"))\n(display (list (take-while-ready p 3) (take-while-ready p 3) (take-while-ready p 3)))\n(newline)"
     :math-composition "(define (at-end? p) (eof-object? (peek-char p)))\n(define (chunks s size)\n  (let ((p (open-input-string s)))\n    (let outer ((out (list)))\n      (if (at-end? p)\n          (reverse out)\n          (let inner ((i 0) (acc (list)))\n            (if (or (= i size) (at-end? p))\n                (outer (cons (list->string (reverse acc)) out))\n                (inner (+ i 1) (cons (read-char p) acc))))))))\n(display (map (lambda (s) (chunks s 2)) (list \"\" \"a\" \"abcde\")))\n(newline)"
     :cs-composition "(define (at-end? p) (eof-object? (peek-char p)))\n(define (tokenize s)\n  (let ((p (open-input-string s)))\n    (let loop ((toks (list)) (cur (list)))\n      (if (at-end? p)\n          (reverse (if (null? cur) toks (cons (list->string (reverse cur)) toks)))\n          (let ((c (read-char p)))\n            (if (char=? c #\\space)\n                (loop (if (null? cur) toks (cons (list->string (reverse cur)) toks)) (list))\n                (loop toks (cons c cur))))))))\n(display (map tokenize (list \"\" \"one\" \"one two  three\")))\n(newline)"
     :base "peek-char plus eof-object? reports whether the port has ended, without consuming -- and char-ready? reports the separate question of whether a read would wait."
     :emergent "eng: take-while-ready, a bounded read that stops at whichever comes first, the count or the end -- so calling it repeatedly walks the port in fixed strides and the last stride is short. math: a chunker built by nesting that helper, which partitions a string into pieces of at most n with no eof value ever appearing. cs: a tokenizer -- the smallest thing that deserves the name -- splitting on spaces, collapsing runs, and dropping the empty trailing token."
     :meta "The composition chains a non-consuming end test with read-char inside a loop, and what emerges is the STREAMING SCANNER: a reader that never looks ahead further than it has to and never needs a sentinel value in its accumulator. That last part is the real gain -- eof handling is pushed entirely into the loop condition, so the body only ever sees characters. Naming the test at-end? rather than calling char-ready? is the whole correction: the terminator must be about data, and char-ready? is about waiting.")
    (:eng "Three calls to take-while-ready give three, three, then nothing -- the short final stride is the case a fixed-size loop gets wrong."
     :math "Chunking is exhaustive and non-overlapping: concatenating the pieces reproduces the input, for every input including the empty string."
     :cs "The double space in the third input is deliberate; a tokenizer that does not collapse runs emits a phantom empty token there."))
)

(verb
  :name "u8-ready?" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "predicate"
  :signature "(u8-ready? [port]) -> boolean"
  :summary "Answers whether a byte can be read from a binary port without waiting."
  :explanation "The binary twin of char-ready?, and it inherits the intent exactly. R7RS-small 6.13.2 defines u8-ready? as returning #t when a byte is ready, so a following read-u8 will not block, and it requires #t at end of file for the same reason as its textual sibling: a read at end of file returns immediately and so does not wait. The port argument is optional and defaults to current-input-port. On a bytevector port there is no waiting at all -- the bytes are already in memory -- so the answer is a constant #t at every position, end of file included. The verb therefore carries no information about how much data remains, and it is not meant to: that question belongs to peek-u8 and eof-object?. A loop that uses u8-ready? as its terminator never finishes. The two ready predicates agree with each other at end of file, which is the property worth having: a program's behaviour does not depend on whether it was handed a textual or a binary port. Like char-ready? it raises rather than answering when given an output port, a textual port, or a non-port."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define b (open-input-bytevector #u8(1 2)))\n(display (u8-ready? b))\n(newline)\n(read-u8 b)\n(read-u8 b)\n(display (u8-ready? b))\n(newline)" :note "#t then #t on the next line -- the answer does not change when the bytes run out, because a read at end of file still does not wait. R7RS-small 6.13.2 requires exactly this.")
    (:dialect "motoi" :tier "intermediate" :code "(define (bytes-end? p) (eof-object? (peek-u8 p)))\n(define (bytes-left p)\n  (let loop ((n 0))\n    (if (bytes-end? p) n (begin (read-u8 p) (loop (+ n 1))))))\n(display (map (lambda (bv) (bytes-left (open-input-bytevector bv)))\n              (list #u8() #u8(9) #u8(1 2 3) #u8(0 0 0 0 0))))\n(newline)" :note "(0 1 3 5) -- counting bytes is peek-u8's job, not u8-ready?'s. Writing this loop with u8-ready? as the test would never terminate.")
    (:dialect "motoi" :tier "expert" :code "(define b (open-input-bytevector #u8(7)))\n(read-u8 b)\n(display (list 'motoi-says (u8-ready? b) 'r7rs-requires #t 'at-eof (eof-object? (peek-u8 b))))\n(newline)\n(display (list 'on-output-port (guard (e (#t 'raised)) (u8-ready? (open-output-bytevector)))))\n(newline)\n(display (list 'on-non-port (guard (e (#t 'raised)) (u8-ready? 42))))\n(newline)" :note "(motoi-says #t r7rs-requires #t at-eof #t) then (on-output-port raised) then (on-non-port raised) -- ready and ended at the same time, which is the case the standard singles out, and wrong-type arguments raise instead of answering.")
  )
  :caveats ("#t DOES NOT MEAN A BYTE REMAINS. It means a read will not wait. At end of file both hold at once. Test for the end with peek-u8 and eof-object?, never with this." "A loop written as (if (u8-ready? p) (read-u8 p) ...) never terminates, because the answer is always #t. This is the standard way to misuse the verb." "It raises on an output port, on a textual port, and on a non-port rather than answering #f. It is a probe for binary input ports, not a total predicate." "It is the byte-side verb only. Use char-ready? for textual ports; each raises on the other's port kind, so the pairing is enforced rather than merely conventional." "With no argument it probes current-input-port, which is TEXTUAL, so the no-argument form raises. u8-ready? always needs its port named explicitly.")
  :usecases ("Guarding a read in byte-handling code that must also run on a Scheme where a socket or pipe can genuinely block." "Asserting in a test that a port is live, binary and readable, since the verb raises on every other kind of argument." "Showing that the textual and binary probes agree at end of file, so port kind never changes a program's control flow.")
  :related ("char-ready?" "read-u8" "peek-u8" "open-input-bytevector" "eof-object?")
  :learn (:concept "When two verbs differ only in their unit, they should also agree in their edge cases -- and checking that they do, rather than assuming it, is what a reference is for." :prerequisites ("read-u8" "open-input-bytevector" "eof-object?") :progression "Learn open-input-bytevector and read-u8 so a byte source exists, then eof-object? as the end test, then this probe and exactly how it differs from that test.")
  :provenance "R7RS-small 6.13.2; measured against the live engine 2026-08-02; reference record added 2026-08-02; conformed and re-measured 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (bytes-end? p) (eof-object? (peek-u8 p)))\n(define (collect bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((acc (list)))\n      (if (bytes-end? p)\n          (reverse acc)\n          (loop (cons (read-u8 p) acc))))))\n(display (map collect (list #u8() #u8(4) #u8(10 20 30))))\n(newline)"
     :math-program "(define (bytes-end? p) (eof-object? (peek-u8 p)))\n(define (steps bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((n 0))\n      (if (bytes-end? p) n (begin (read-u8 p) (loop (+ n 1)))))))\n(display (map (lambda (bv) (= (steps bv) (bytevector-length bv)))\n              (list #u8() #u8(1) #u8(1 2) #u8(1 2 3 4 5))))\n(newline)"
     :cs-program "(define (safe-u8-ready p)\n  (cond ((not (port? p)) 'not-a-port)\n        ((not (input-port? p)) 'not-an-input-port)\n        ((not (binary-port? p)) 'not-binary)\n        (else (u8-ready? p))))\n(display (map safe-u8-ready (list (open-input-bytevector #u8(1)) (open-output-bytevector) (open-input-string \"a\") 42)))\n(newline)"
     :problem "The operator wants to read a bytevector port to exhaustion with no eof value entering the accumulator. Candidates: u8-ready? in the loop condition (WRONG -- it reports that a read will not wait, which is always true here, so the loop never ends), peek-u8 with eof-object? (correct, and it decides before the byte is taken), and bytevector-length on the source bytevector (works only when the source is in hand, which defeats the point of a port). Only the middle one is both correct and general."
     :explanation "eng: three bytevectors collected exactly, with the empty one collecting to the empty list, and the test is the end of the port rather than its readiness. math: the step count equals the bytevector length for every input. cs: the ladder converts the raise on a wrong-kind port into a value, so the helper can be mapped over a mixed list."
     :meta "The rejected candidate is the one to study. u8-ready? sounds like it means bytes-remain and does not, and the failure mode is a loop that spins rather than an error that fires -- the quietest kind of wrong.")
    (:eng "The empty bytevector collecting to the empty list is the check that separates a loop that tests first from one that tests last."
     :math "Steps equal length exactly at every size, so peek-u8 measures the port and not the container."
     :cs "Because this verb raises where a total predicate would answer #f, it cannot be used bare as a filter."))
  :row-3-dimension (
    (:setup "A cheap observation reports whether the next expensive step can proceed immediately, and the loop is driven by the observation rather than by the step's own failure."
     :rungs ((:domain "io" :code "(define p (open-input-bytevector #u8(5 6)))\n(display (list 'ready (u8-ready? p) 'take (read-u8 p) 'still (u8-ready? p) 'take (read-u8 p) 'done (u8-ready? p)))\n(newline)")
             (:domain "a conveyor with a sensor at the pick point: the sensor says whether a part is present, and the arm only reaches when it is" :code "(define (sensor parts) (if (null? parts) 'empty 'part-present))\n(define (pick parts) (if (eq? (sensor parts) 'part-present) (list 'picked (car parts) 'rest (cdr parts)) (list 'idle)))\n(display (list (pick (list 'a 'b)) (pick (list))))\n(newline)")
             (:domain "a ring buffer with a count field: the consumer reads the count rather than attempting a dequeue and handling the empty result" :code "(define (buffer items) (list 'buf (length items) items))\n(define (available b) (cadr b))\n(define (dequeue b)\n  (if (> (available b) 0) (list 'got (car (caddr b))) (list 'empty)))\n(display (list (dequeue (buffer (list 1 2))) (dequeue (buffer (list)))))\n(newline)"))
     :explanation "In io u8-ready? is the sensor and read-u8 is the arm. A conveyor sensor is the same arrangement in hardware: the cheap detector fires first and the expensive actuator moves only on a positive, so the actuator never has to handle an empty grasp. A ring buffer's count field is the same idea in memory -- the consumer consults a number instead of attempting a dequeue and interpreting a failure. All three replace failure-handling with a precondition."
     :meta "The shape transfers wherever a failed attempt is more costly or more awkward than a query. It also carries the same warning in all three: with more than one consumer, the observation is stale the instant it is taken.")
    (:eng "Sensor first, actuator second, and never infer the sensor's answer from the actuator's result."
     :math "The pattern turns a partial operation into a total one by narrowing its domain before it is applied."
     :cs "One consumer makes the race disappear; two consumers make the precondition a hint rather than a guarantee."))
  :row-4-proof (
    (:eng-program "(define (bytes-end? p) (eof-object? (peek-u8 p)))\n(define (steps bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((n 0))\n      (if (bytes-end? p) n (begin (read-u8 p) (loop (+ n 1)))))))\n(display (map (lambda (bv) (list (bytevector-length bv) (steps bv) (= (steps bv) (bytevector-length bv))))\n              (list #u8() #u8(1) #u8(1 2 3))))\n(newline)"
     :math-program "(define (idempotent bv)\n  (let ((p (open-input-bytevector bv)))\n    (let ((a (u8-ready? p)) (b (u8-ready? p)) (c (u8-ready? p)))\n      (list (eq? a b) (eq? b c) (= (read-u8 p) (bytevector-u8-ref bv 0))))))\n(display (map idempotent (list #u8(9) #u8(3 4) #u8(255 0 7))))\n(newline)"
     :cs-program "(define t (open-input-string \"a\"))\n(define b (open-input-bytevector #u8(1)))\n(read-char t)\n(read-u8 b)\n(display (list 'textual-at-eof (char-ready? t)\n               'binary-at-eof (u8-ready? b)\n               'agree (eq? (char-ready? t) (u8-ready? b))\n               'standard-requires #t))\n(newline)"
     :claim "u8-ready? does not consume: repeated calls agree and the following read-u8 is unaffected; it answers #t at end of file as R7RS-small 6.13.2 requires; and it agrees with char-ready? at end of file, so port kind does not change the answer."
     :invariant "For all binary input ports p. (u8-ready? p) does not advance p; and (u8-ready? p) = #t at every position including end of file; and (u8-ready? p) at eof = (char-ready? q) at eof for a textual q"
     :meta "The third program is the one that earns its place: it checks that the two ready predicates AGREE with each other at end of file, which matters more than either one's individual answer. A program whose control flow depended on which kind of port it was handed would be a defect no caveat could cover. What would falsify: a probe advancing the port, consecutive calls disagreeing, or the two predicates differing at end of file.")
    (:eng "Non-consumption is verified by reading the first byte after three probes and comparing it to the source bytevector."
     :math "Step count equals bytevector length at every size including zero."
     :cs "Agreement between siblings is a real property to test, and it is cheap to state once both are conformant."))
  :row-5-emergence (
    (:eng-composition "(define (bytes-end? p) (eof-object? (peek-u8 p)))\n(define (take-bytes p n)\n  (let loop ((i 0) (acc (list)))\n    (if (or (= i n) (bytes-end? p))\n        (reverse acc)\n        (loop (+ i 1) (cons (read-u8 p) acc)))))\n(define p (open-input-bytevector #u8(1 2 3 4 5)))\n(display (list (take-bytes p 2) (take-bytes p 2) (take-bytes p 2) (take-bytes p 2)))\n(newline)"
     :math-composition "(define (bytes-end? p) (eof-object? (peek-u8 p)))\n(define (frames bv size)\n  (let ((p (open-input-bytevector bv)))\n    (let outer ((out (list)))\n      (if (bytes-end? p)\n          (reverse out)\n          (let inner ((i 0) (acc (list)))\n            (if (or (= i size) (bytes-end? p))\n                (outer (cons (reverse acc) out))\n                (inner (+ i 1) (cons (read-u8 p) acc))))))))\n(display (map (lambda (bv) (let ((fs (frames bv 3)))\n                             (list 'frames (length fs) 'bytes (apply + (map length fs)) 'total (bytevector-length bv))))\n              (list #u8() #u8(1) #u8(1 2 3 4 5 6 7))))\n(newline)"
     :cs-composition "(define (bytes-end? p) (eof-object? (peek-u8 p)))\n(define (checksum bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((sum 0) (n 0))\n      (if (bytes-end? p)\n          (list 'bytes n 'checksum sum)\n          (loop (modulo (+ sum (read-u8 p)) 256) (+ n 1))))))\n(display (map checksum (list #u8() #u8(1 2 3) #u8(200 100 50))))\n(newline)"
     :base "peek-u8 with eof-object? reports whether a byte remains, without taking it -- while u8-ready? reports the separate question of whether a read would wait."
     :emergent "eng: take-bytes, a bounded read that stops at the count or the end, so repeated calls walk a port in fixed strides and the final stride is short. math: a framer built from that helper, reporting frame count and total bytes so the partition can be checked against the source length. cs: a rolling checksum that consumes the port once and reports the count alongside the sum, so the number can never be attributed to the wrong amount of data."
     :meta "The composition chains this probe with read-u8 in a loop, and what emerges is the FRAMED BYTE READER: the shape underneath every packet parser, block cipher mode and file-format reader -- fixed-size frames, a possibly-short last frame, and a loop condition that keeps eof out of the body entirely. Everything above the framer can then be written as if data were infinite.")
    (:eng "The fourth call returning the empty list is the terminating case that a fixed-count loop misses."
     :math "Frame lengths sum to the source length in every case, so the framing is exhaustive and non-overlapping."
     :cs "The checksum reporting its byte count alongside its value is the habit worth copying: a digest without a length is a number you cannot check."))
)

(verb
  :name "read-u8" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(read-u8 [port]) -> byte-or-eof"
  :summary "Takes the next byte from a binary input port and advances past it."
  :explanation "The byte-level counterpart of read-char. R7RS-small 6.13.2 defines read-u8 as returning the next byte available from a binary input port, advancing the port past it, and returning an eof object when no byte is available. The value is an exact integer between 0 and 255 inclusive -- an octet, not a character, not a number with a sign. The port argument is optional and defaults to current-input-port. Because the return value is either a byte or an eof object, every loop over a binary port has the same shape: read, test with eof-object?, and either finish or continue. That test is what keeps an eof object out of an accumulator, and forgetting it is the most common way a byte loop goes wrong -- an eof object compares unequal to every byte, so the bug usually shows up as a list one element too long rather than as an error. Reading is destructive: the byte is gone from the port afterwards, and there is no way to put it back. When you need to look without taking, use peek-u8. A read-u8 aimed at a TEXTUAL port raises, which is the answer worth having: an eof object there would have been indistinguishable from a genuine end of stream, so the loop would have finished normally with an empty result and no sign that it had read the wrong kind of port at all."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-input-bytevector #u8(72 105)))\n(display (read-u8 p))\n(newline)\n(display (read-u8 p))\n(newline)\n(display (eof-object? (read-u8 p)))\n(newline)" :note "72 then 105 then #t, each on its own line -- two bytes come out in order and the third read reports the end.")
    (:dialect "motoi" :tier "intermediate" :code "(define (bytes->list bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((acc (list)))\n      (let ((b (read-u8 p)))\n        (if (eof-object? b) (reverse acc) (loop (cons b acc)))))))\n(display (map bytes->list (list #u8() #u8(255) #u8(1 2 3))))\n(newline)" :note "(() (255) (1 2 3)) -- the standard byte-loop shape: read, test for eof, accumulate or finish. The empty bytevector gives the empty list because the test comes before the accumulation.")
    (:dialect "motoi" :tier "expert" :code "(define t (open-input-string \"ab\"))\n(display (list 'read-u8-textual (guard (e (#t 'raised)) (read-u8 t))\n               'peek-u8-textual (guard (e (#t 'raised)) (peek-u8 t))\n               'read-char-still (read-char t)))\n(newline)\n(display (list 'read-char-on-binary (guard (e (#t 'raised)) (read-char (open-input-bytevector #u8(65))))))\n(newline)\n(display (list 'no-arg-read-u8 (guard (e (#t 'raised)) (read-u8))))\n(newline)" :note "(read-u8-textual raised peek-u8-textual raised read-char-still a) then (read-char-on-binary raised) then (no-arg-read-u8 raised) -- R7RS-small makes a byte read from a textual port an error, and Motoi signals it in both directions. The textual port is left untouched, so the next read-char still returns a. The no-argument form raises because current-input-port is textual.")
  )
  :caveats ("read-u8 on a TEXTUAL port RAISES. It does not answer an eof object, which would be indistinguishable from a genuine end and would let a loop read nothing and report success. R7RS-small 6.13.2 makes the cross-kind read an error and Motoi signals it." "The no-argument form reads current-input-port, which in Motoi is a permanently empty textual port, so it always returns eof. Always pass the port explicitly." "It is destructive. The byte is consumed and cannot be returned; use peek-u8 when a decision must be made before committing." "An eof object is not a number and not #f. Test with eof-object?, never with zero? or a numeric comparison -- an eof object in an arithmetic position is an error, and in a boolean position it is TRUE." "Bytes are unsigned. A value written as -1 comes back as 255; there is no sign to recover, and the interpretation is the caller's job.")
  :usecases ("Walking a bytevector port to build a list or a running total, one octet at a time." "Decoding a length-prefixed frame, where the first byte decides how many more to read." "Copying a binary source to a binary sink byte by byte, with read-u8 on one side and write-u8 on the other.")
  :related ("peek-u8" "write-u8" "open-input-bytevector" "u8-ready?" "read-char")
  :learn (:concept "A verb whose result is either a value or a sentinel forces a test at every use, and putting that test in the loop CONDITION rather than in the body is what keeps the sentinel out of the data." :prerequisites ("open-input-bytevector" "eof-object?") :progression "Learn open-input-bytevector so a byte source exists, then read-u8 once, then the eof-tested loop, then peek-u8 as the non-destructive alternative.")
  :provenance "R7RS-small 6.13.2; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (sum-bytes bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((total 0))\n      (let ((b (read-u8 p)))\n        (if (eof-object? b) total (loop (+ total b)))))))\n(display (map sum-bytes (list #u8() #u8(5) #u8(1 2 3) #u8(100 100 55))))\n(newline)"
     :math-program "(define (count-bytes bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((n 0))\n      (if (eof-object? (read-u8 p)) n (loop (+ n 1))))))\n(display (map (lambda (bv) (= (count-bytes bv) (bytevector-length bv)))\n              (list #u8() #u8(0) #u8(1 2) #u8(9 9 9 9 9))))\n(newline)"
     :cs-program "(define (safe-read-u8 p)\n  (cond ((not (port? p)) 'not-a-port)\n        ((not (input-port? p)) 'not-an-input-port)\n        ((not (binary-port? p)) 'not-binary)\n        (else (let ((b (read-u8 p))) (if (eof-object? b) 'eof b)))))\n(display (map safe-read-u8 (list (open-input-bytevector #u8(200)) (open-input-bytevector #u8()) (open-input-string \"a\") (open-output-bytevector) 42)))\n(newline)"
     :problem "The operator must consume a binary source completely and total its bytes. Candidates: read-u8 with an eof-object? test (portable, correct everywhere, and the test sits in the loop condition so no sentinel reaches the accumulator), u8-ready? as the loop condition (tighter here, but it depends on a Motoi divergence and means something else on a conforming Scheme), and bytevector-u8-ref over the source bytevector with an index (fine when the bytes are in hand, useless once the source is a port). For a port, the eof-tested read is the honest default."
     :explanation "eng: four bytevectors summed, with the empty one giving zero because the test precedes the addition. math: the read count equals the bytevector length for every input. cs: the guard ladder names each cross-kind outcome, so the raise becomes a value the program can print instead of an error that ends it."
     :meta "Why the ladder is not paranoia here: the failure mode being guarded against produces the SAME value as success-at-end-of-file. Any check that distinguishes them has to happen before the read, because afterwards the two are indistinguishable.")
    (:eng "Zero for the empty bytevector is the base case that separates a test-first loop from a test-last one."
     :math "Reads equal length exactly at every size, so nothing is dropped and nothing is double-counted."
     :cs "'not-binary and 'eof are different answers for a reason -- one is a bug in the caller and the other is a normal end."))
  :row-3-dimension (
    (:setup "A sequence is consumed one unit at a time from a source that remembers its own position, and the source signals exhaustion with a value that is deliberately not a member of the sequence."
     :rungs ((:domain "io" :code "(define p (open-input-bytevector #u8(3 1 4)))\n(display (list (read-u8 p) (read-u8 p) (read-u8 p) (eof-object? (read-u8 p))))\n(newline)")
             (:domain "a ticket dispenser: each pull gives the next ticket and the roll remembers where it is, and when the roll runs out you get a clearly-not-a-ticket instead" :code "(define (pull roll) (if (null? roll) (list 'empty roll) (list (car roll) (cdr roll))))\n(define (pull-all roll)\n  (let loop ((r roll) (out (list)))\n    (let ((res (pull r)))\n      (if (eq? (car res) 'empty) (reverse out) (loop (cadr res) (cons (car res) out))))))\n(display (pull-all (list 'a 'b 'c)))\n(newline)")
             (:domain "an iterator protocol: next() yields an element or a distinguished stop value, and the iterator rather than the caller holds the cursor" :code "(define (make-iter lst)\n  (let ((state lst))\n    (lambda ()\n      (if (null? state) 'stop\n          (let ((v (car state))) (set! state (cdr state)) v)))))\n(define it (make-iter (list 10 20)))\n(display (list (it) (it) (it)))\n(newline)"))
     :explanation "In io read-u8 pulls the next octet and the port holds the cursor. A ticket dispenser is the same at counter scale: each pull advances the roll, the roll remembers, and the empty signal is visibly not a ticket. An iterator protocol names the pattern in software -- next() returns an element or a stop value, the cursor lives inside the iterator, and the caller never indexes. All three: an internal cursor, a destructive pull, and an out-of-band end signal."
     :meta "The shape transfers to files, sockets, database cursors and generators. The design decision that transfers with it is the choice of end signal: it must be a value that cannot occur in the data, which is exactly why an eof object is its own type rather than -1 or #f.")
    (:eng "Let the source hold the cursor; a caller that tracks position separately will eventually disagree with it."
     :math "The end marker must lie outside the value set, or the sequence and its terminator become ambiguous."
     :cs "This is why C's getchar returns int rather than char -- 256 possible bytes plus one EOF does not fit in a byte."))
  :row-4-proof (
    (:eng-program "(define (drain bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((acc (list)))\n      (let ((b (read-u8 p)))\n        (if (eof-object? b) (reverse acc) (loop (cons b acc)))))))\n(define (bv->list bv)\n  (let loop ((i (- (bytevector-length bv) 1)) (acc (list)))\n    (if (< i 0) acc (loop (- i 1) (cons (bytevector-u8-ref bv i) acc)))))\n(display (map (lambda (bv) (equal? (drain bv) (bv->list bv)))\n              (list #u8() #u8(0) #u8(255) #u8(1 2 3 4))))\n(newline)"
     :math-program "(define (advances bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((i 0) (ok #t))\n      (if (= i (bytevector-length bv))\n          (and ok (eof-object? (read-u8 p)))\n          (loop (+ i 1) (and ok (= (read-u8 p) (bytevector-u8-ref bv i))))))))\n(display (map advances (list #u8() #u8(7) #u8(1 2 3) #u8(255 0 128))))\n(newline)"
     :cs-program "(define p (open-input-bytevector #u8(9)))\n(read-u8 p)\n(display (list 'eof-is-sticky (map (lambda (i) (eof-object? (read-u8 p))) (list 1 2 3))\n               'eof-not-false (if (read-u8 p) 'truthy 'falsy)\n               'eof-not-a-number (guard (e (#t 'raised)) (+ 1 (read-u8 p)))))\n(newline)"
     :claim "read-u8 returns the bytes of the source in order, advances exactly one position per call, returns an eof object at and after exhaustion, and that eof object is neither a number nor #f."
     :invariant "For all bytevectors bv. the i-th read-u8 = (bytevector-u8-ref bv i) for i < length; and every read at or beyond length = an eof object"
     :meta "The third program exists because two things about the eof object surprise people who learned IO in C: it is STICKY, so a loop that ignores it spins forever rather than failing once, and it is TRUTHY, so `(if (read-u8 p) ...)` takes the then-branch at the end of the stream. Both are worth a runnable demonstration rather than a sentence. What would falsify: a read out of order, a skipped position, a non-sticky eof, or an eof that tested false.")
    (:eng "Comparing the drained list against bytevector->list makes the whole sequence the assertion rather than one sampled element."
     :math "Position i maps to byte i for every i and every bytevector, including the boundary at length."
     :cs "Truthiness of the eof object is the trap: in Scheme only #f is false, so a C-style `while (c = getchar())` idiom does not translate."))
  :row-5-emergence (
    (:eng-composition "(define (copy-bytes bv)\n  (let ((in (open-input-bytevector bv)) (out (open-output-bytevector)))\n    (let loop ()\n      (let ((b (read-u8 in)))\n        (if (not (eof-object? b)) (begin (write-u8 b out) (loop)))))\n    (get-output-bytevector out)))\n(display (map copy-bytes (list #u8() #u8(7) #u8(1 2 3 255))))\n(newline)"
     :math-composition "(define (transform bv f)\n  (let ((in (open-input-bytevector bv)) (out (open-output-bytevector)))\n    (let loop ()\n      (let ((b (read-u8 in)))\n        (if (not (eof-object? b)) (begin (write-u8 (f b) out) (loop)))))\n    (get-output-bytevector out)))\n(define (invert b) (- 255 b))\n(display (map (lambda (bv) (let ((once (transform bv invert)))\n                             (list once (equal? (transform once invert) bv))))\n              (list #u8() #u8(0 255) #u8(1 2 3))))\n(newline)"
     :cs-composition "(define (read-frame p)\n  (let ((n (read-u8 p)))\n    (if (eof-object? n)\n        'done\n        (let loop ((i 0) (acc (list)))\n          (if (= i n)\n              (reverse acc)\n              (let ((b (read-u8 p)))\n                (if (eof-object? b) (list 'truncated (reverse acc)) (loop (+ i 1) (cons b acc)))))))))\n(define p (open-input-bytevector #u8(2 10 20 3 30 40 50 2 60)))\n(display (list (read-frame p) (read-frame p) (read-frame p) (read-frame p)))\n(newline)"
     :base "read-u8 pulls one byte and reports exhaustion with a value that cannot be a byte."
     :emergent "eng: a byte copier -- read from one port, write to another, and the eof test is the only control structure needed. math: a transform stage that applies a function per byte, shown with an involution so applying it twice returns the original, which proves the pipeline loses nothing. cs: a LENGTH-PREFIXED FRAME READER, where the first byte says how many follow, and a short final frame is reported as truncated rather than silently accepted."
     :meta "The composition chains read-u8 with write-u8 through a pair of bytevector ports, and what emerges is the BYTE PIPELINE: source, transform, sink, with the eof test as the only terminator. The frame reader is the same pipeline with the data controlling its own structure -- that step, from fixed shape to self-describing shape, is where a byte loop becomes a parser.")
    (:eng "Copy first, transform second: a pipeline that cannot copy correctly will not transform correctly either."
     :math "Inverting twice returns the original for every input, which is the strongest cheap check that no byte was dropped or reordered."
     :cs "The truncated frame at the end is deliberate -- real streams are cut off mid-frame, and a reader that cannot say so will invent data."))
)

(verb
  :name "peek-u8" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(peek-u8 [port]) -> byte-or-eof"
  :summary "Looks at the next byte of a binary input port without consuming it."
  :explanation "The non-destructive read. R7RS-small 6.13.2 defines peek-u8 as returning the next byte available from a binary input port WITHOUT updating the port to point past it, so a following read-u8 or peek-u8 returns the same byte again. At end of file it returns an eof object, exactly like read-u8. The port argument is optional and defaults to current-input-port. This one-byte lookahead is what makes decisions possible before commitment: a parser can inspect a tag byte, decide which branch to take, and let that branch do the reading -- so no branch ever has to un-read a byte it should not have taken. Peeking is idempotent, which is worth stating plainly because it is the property everything else relies on: peeking twice gives the same answer, peeking never changes what a read returns, and a peek can therefore be inserted anywhere without altering the meaning of the surrounding code. That property is exactly what read-u8 does not have. In Motoi peek-u8 on a textual port returns an eof object rather than signalling, which is the same silent cross-kind failure that read-u8 has, and it is best headed off with binary-port?."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-input-bytevector #u8(1 2 3)))\n(display (list 'peek (peek-u8 p) 'peek-again (peek-u8 p) 'read (read-u8 p) 'next-peek (peek-u8 p)))\n(newline)" :note "(peek 1 peek-again 1 read 1 next-peek 2) -- peeking twice gives the same byte, the read finally takes it, and only then does the peek move on.")
    (:dialect "motoi" :tier "intermediate" :code "(define p (open-input-bytevector #u8(10 20 30)))\n(define (classify p)\n  (let ((b (peek-u8 p)))\n    (cond ((eof-object? b) 'end)\n          ((< b 16) (begin (read-u8 p) 'small))\n          (else (begin (read-u8 p) 'large)))))\n(display (list (classify p) (classify p) (classify p) (classify p)))\n(newline)" :note "(small large large end) -- the decision is made on the peek and the consumption happens inside the chosen branch, so no branch ever has to give a byte back.")
    (:dialect "motoi" :tier "expert" :code "(define b (open-input-bytevector #u8(5)))\n(read-u8 b)\n(display (list 'peek-at-eof (eof-object? (peek-u8 b)) 'still-eof (eof-object? (peek-u8 b))))\n(newline)\n(define t (open-input-string \"ab\"))\n(display (list 'peek-u8-on-textual (guard (e (#t 'raised)) (peek-u8 t)) 'textual-unharmed (peek-char t)))\n(newline)" :note "(peek-at-eof #t still-eof #t) then (peek-u8-on-textual raised textual-unharmed a) -- eof from a peek is sticky and harmless, and a byte peek at a textual port raises as R7RS-small requires. The two cases can no longer be confused: only a real binary end answers eof.")
  )
  :caveats ("peek-u8 on a TEXTUAL port RAISES rather than answering an eof object that would be indistinguishable from a genuine end. R7RS-small 6.13.2 makes the cross-kind peek an error and Motoi signals it, so a parser that peeks the wrong kind of port fails at the peek instead of taking the end-of-stream branch." "The no-argument form peeks at current-input-port, which in Motoi is permanently empty, so it always returns eof. Pass the port." "Lookahead is ONE byte. There is no peek-u8 with an offset; to look further, read into a buffer and parse the buffer." "An eof object from peek-u8 is truthy and is not a number. Test it with eof-object? before any comparison." "A peek does not make a later read safe. It reports what is there now; on a source with another reader, the byte may be gone by the time you take it.")
  :usecases ("Dispatching a parser on a tag byte without consuming it, so each branch reads its own payload from the start." "Detecting end of stream in a loop condition without taking a byte you would then have to handle." "Deciding whether a length-prefixed frame is present before beginning to read one.")
  :related ("read-u8" "peek-char" "u8-ready?" "open-input-bytevector" "eof-object?")
  :learn (:concept "One unit of lookahead is the difference between a reader that must undo and a reader that never commits early -- and it is enough for a surprising share of real formats, which is why the standard offers exactly one." :prerequisites ("read-u8" "eof-object?") :progression "Learn read-u8 and feel the problem of having taken the wrong byte, then peek-u8 as the fix, then the peek-decide-read dispatch that every parser is built from.")
  :provenance "R7RS-small 6.13.2; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (split-on-tag bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((smalls (list)) (larges (list)))\n      (let ((b (peek-u8 p)))\n        (cond ((eof-object? b) (list 'small (reverse smalls) 'large (reverse larges)))\n              ((< b 128) (read-u8 p) (loop (cons b smalls) larges))\n              (else (read-u8 p) (loop smalls (cons b larges))))))))\n(display (split-on-tag #u8(1 200 3 250)))\n(newline)"
     :math-program "(define (peek-is-stable bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((i 0) (ok #t))\n      (if (= i (bytevector-length bv))\n          ok\n          (let ((a (peek-u8 p)) (b (peek-u8 p)))\n            (loop (+ i 1) (and ok (= a b) (= (read-u8 p) a))))))))\n(display (map peek-is-stable (list #u8() #u8(3) #u8(1 2 3) #u8(255 0 255))))\n(newline)"
     :cs-program "(define (safe-peek p)\n  (cond ((not (port? p)) 'not-a-port)\n        ((not (binary-port? p)) 'not-binary)\n        (else (let ((b (peek-u8 p))) (if (eof-object? b) 'eof b)))))\n(display (map safe-peek (list (open-input-bytevector #u8(88)) (open-input-bytevector #u8()) (open-input-string \"a\") 42)))\n(newline)"
     :problem "The operator is writing a parser that must branch on a tag byte and then let the chosen branch read the record. Candidates: peek-u8 (look, decide, and let the branch consume from the start of its own record), read-u8 followed by passing the byte down (works, but every branch now takes an extra already-read argument and the record no longer starts at the port), and a pushback buffer wrapped around the port (correct and general, and far more machinery than one byte of lookahead needs). Peek is the standard's answer and the smallest one."
     :explanation "eng: a partition by tag where the read happens inside the branch that wanted it. math: peeking twice agrees and the read matches the peek, at every position of every bytevector. cs: the ladder is needed because a textual port answers eof to a peek instead of complaining."
     :meta "Why not a pushback buffer: it is the right answer when the format needs more than one byte of lookahead. Building one before you need it means every read now goes through a layer that exists for a case that never arrives.")
    (:eng "Reading inside the branch keeps each branch's code readable as 'here is how my record is laid out', with no inherited byte."
     :math "Stability is checked at every position rather than at the first, because a lookahead that drifts would still pass a single-position test."
     :cs "One byte of lookahead is the LL(1) condition in miniature -- if a format needs more, that is a fact about the format worth knowing early."))
  :row-3-dimension (
    (:setup "Look before you commit: an observation that leaves the world exactly as it found it, taken so that the commitment which follows can be the right one."
     :rungs ((:domain "io" :code "(define p (open-input-bytevector #u8(9 8)))\n(display (list 'look (peek-u8 p) 'look-again (peek-u8 p) 'take (read-u8 p) 'now (peek-u8 p)))\n(newline)")
             (:domain "reading the top card of a deck face-down by lifting one corner: you learn the card and the deck is unchanged, which is a different act from drawing it" :code "(define (glance deck) (if (null? deck) 'empty (car deck)))\n(define (draw deck) (if (null? deck) (list 'empty deck) (list (car deck) (cdr deck))))\n(define d (list 'ace 'two))\n(display (list 'glance (glance d) 'glance-again (glance d) 'draw (draw d)))\n(newline)")
             (:domain "a queue's front operation versus its dequeue: front is a pure observation and dequeue is a mutation, and separating them is what lets a caller decide before removing" :code "(define (front q) (if (null? q) 'empty (car q)))\n(define (dequeue q) (if (null? q) q (cdr q)))\n(define q (list 1 2 3))\n(display (list 'front (front q) 'front-again (front q) 'after-dequeue (front (dequeue q))))\n(newline)"))
     :explanation "In io peek-u8 observes and read-u8 commits. Lifting the corner of a card is the same separation in the hand: you learn the value and the deck is unchanged, and drawing is a different, irreversible act. A queue that offers front separately from dequeue is the same design in a data structure -- the pure observation and the mutation are two operations because callers genuinely need the first without the second. All three: an idempotent look paired with a destructive take."
     :meta "The shape transfers to every stream, queue, stack and cursor. What transfers with it is a design rule: when an observation and a mutation are bundled into one operation, callers who only wanted to look are forced to undo, and undo is where the bugs live.")
    (:eng "Separate the look from the take at the interface, even when the implementation shares almost all of its code."
     :math "Idempotence is the defining property: repeating the observation changes nothing, which is what makes it composable."
     :cs "front/dequeue, peek/pop, peek-u8/read-u8 -- the same pair under three names in three layers."))
  :row-4-proof (
    (:eng-program "(define (agrees bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((i 0) (ok #t))\n      (if (= i (bytevector-length bv))\n          (and ok (eof-object? (peek-u8 p)) (eof-object? (read-u8 p)))\n          (let ((peeked (peek-u8 p)))\n            (loop (+ i 1) (and ok (= peeked (bytevector-u8-ref bv i)) (= (read-u8 p) peeked))))))))\n(display (map agrees (list #u8() #u8(0) #u8(255 1) #u8(4 5 6 7))))\n(newline)"
     :math-program "(define (peek-n-times bv k)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((i 0) (vals (list)))\n      (if (= i k)\n          (list (length vals) (length (delete-duplicates vals)))\n          (loop (+ i 1) (cons (peek-u8 p) vals))))))\n(display (map (lambda (k) (peek-n-times #u8(42 43) k)) (list 1 2 5 9)))\n(newline)"
     :cs-program "(define p (open-input-bytevector #u8(1)))\n(read-u8 p)\n(display (list 'peek-eof-sticky (map (lambda (i) (eof-object? (peek-u8 p))) (list 1 2 3))\n               'peek-eof-truthy (if (peek-u8 p) 'truthy 'falsy)\n               'read-agrees (eof-object? (read-u8 p))))\n(newline)"
     :claim "peek-u8 never advances the port: repeated peeks return the same byte, and the byte a peek reports is the byte the next read-u8 returns; at end of file both report an eof object, stickily."
     :invariant "For all binary input ports p. (peek-u8 p) = (peek-u8 p) = the value of the next (read-u8 p); and once exhausted, both return an eof object forever"
     :meta "The middle program is the one that would catch a subtle bug: k peeks in a row must produce k values that are all EQUAL, so the distinct count is one no matter how large k is. A lookahead that advanced even occasionally would show up as a distinct count above one, which a two-peek test could miss. What would falsify: a peek advancing the port, a peek disagreeing with the following read, or an eof that stopped being reported.")
    (:eng "Checking peek-then-read at every position, plus the boundary, makes the whole port the assertion."
     :math "One distinct value from k observations, for every k -- that is idempotence measured rather than asserted."
     :cs "Sticky eof matters for peek even more than for read: a parser that peeks in its loop condition and never checks would spin forever."))
  :row-5-emergence (
    (:eng-composition "(define (read-run p)\n  (let ((first (peek-u8 p)))\n    (if (eof-object? first)\n        'done\n        (let loop ((n 0))\n          (let ((b (peek-u8 p)))\n            (if (and (not (eof-object? b)) (= b first))\n                (begin (read-u8 p) (loop (+ n 1)))\n                (list first n)))))))\n(define p (open-input-bytevector #u8(7 7 7 9 9 1)))\n(display (list (read-run p) (read-run p) (read-run p) (read-run p)))\n(newline)"
     :math-composition "(define (rle bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((out (list)))\n      (let ((first (peek-u8 p)))\n        (if (eof-object? first)\n            (reverse out)\n            (let inner ((n 0))\n              (let ((b (peek-u8 p)))\n                (if (and (not (eof-object? b)) (= b first))\n                    (begin (read-u8 p) (inner (+ n 1)))\n                    (loop (cons (list first n) out))))))))))\n(display (map (lambda (bv) (let ((runs (rle bv)))\n                             (list runs (= (apply + (map cadr runs)) (bytevector-length bv)))))\n              (list #u8() #u8(5) #u8(1 1 2 2 2 3))))\n(newline)"
     :cs-composition "(define (parse p)\n  (let ((tag (peek-u8 p)))\n    (cond ((eof-object? tag) 'done)\n          ((= tag 0) (read-u8 p) (list 'nil))\n          ((= tag 1) (read-u8 p) (list 'byte (read-u8 p)))\n          ((= tag 2) (read-u8 p) (list 'pair (read-u8 p) (read-u8 p)))\n          (else (read-u8 p) (list 'unknown tag)))))\n(define p (open-input-bytevector #u8(0 1 77 2 3 4 9)))\n(display (list (parse p) (parse p) (parse p) (parse p) (parse p)))\n(newline)"
     :base "peek-u8 reports the next byte without taking it, so a decision can precede a commitment."
     :emergent "eng: read-run, which consumes a maximal run of one repeated byte -- the peek is what lets it stop exactly at the boundary without over-reading. math: run-length encoding built from that helper, with the run lengths summing to the source length so the encoding is verified lossless as it is produced. cs: a TAG-DISPATCHED PARSER where the tag byte selects the branch and each branch reads its own fixed-size payload from the start of its record."
     :meta "The composition chains peek-u8 with read-u8 inside a cond, and what emerges is RECURSIVE DESCENT in its smallest honest form: peek to choose a production, consume what that production owns, and return. Every parser of every self-describing format is this, scaled up. One byte of lookahead is all the pattern needs, and that is precisely what the standard provides.")
    (:eng "read-run stopping cleanly at a boundary is the thing peek is FOR -- with read-u8 alone it would have to over-read and give a byte back."
     :math "Run lengths summing to the source length is the lossless check, and it holds for the empty bytevector too."
     :cs "The trailing unknown tag is deliberate: a parser that cannot name what it does not recognise will silently misread the rest of the stream."))
)

(verb
  :name "write-u8" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(write-u8 byte [port]) -> unspecified"
  :summary "Appends one byte to a binary output port."
  :explanation "The byte-level counterpart of write-char. R7RS-small 6.13.3 defines write-u8 as writing the byte to the given binary output port and returning an unspecified value; it is called for its effect, and the value it returns must never be used. The byte argument is meant to be an exact integer between 0 and 255 inclusive -- one octet, unsigned, with no sign bit to interpret. Bytes accumulate in the port in the order written, and on a bytevector output port get-output-bytevector is how you look at them. The port argument is optional and defaults to current-output-port, which in Motoi is textual, so the no-argument form is never what you want. Two Motoi behaviours need stating before you build on this verb, and both are silent. An out-of-range byte is MASKED to its low eight bits rather than rejected, so 300 becomes 44 and -1 becomes 255 with no complaint. And a write aimed at a TEXTUAL port is discarded entirely -- nothing is written, nothing is raised, and the only evidence is that the sink stayed empty. Both are recorded in the caveats and demonstrated in the examples; both argue for validating the byte and checking binary-port? before the write rather than after."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define b (open-output-bytevector))\n(write-u8 77 b)\n(write-u8 111 b)\n(display (get-output-bytevector b))\n(newline)" :note "#u8(77 111) -- two bytes appended in the order they were written, and the port hands them back as a bytevector.")
    (:dialect "motoi" :tier "intermediate" :code "(define (list->bytes lst)\n  (let ((b (open-output-bytevector)))\n    (for-each (lambda (v) (write-u8 v b)) lst)\n    (get-output-bytevector b)))\n(display (map list->bytes (list (list) (list 0 255) (list 77 111 116 111 105))))\n(newline)" :note "(#u8() #u8(0 255) #u8(77 111 116 111 105)) -- for-each over write-u8 is the whole of a list-to-bytevector conversion, and the empty list gives the empty bytevector.")
    (:dialect "motoi" :tier "expert" :code "(define b (open-output-bytevector))\n(display (list 'range-refused\n               (map (lambda (v) (guard (e (#t 'raised)) (begin (write-u8 v b) 'accepted))) (list 300 -1 256 128))\n               'wrote (get-output-bytevector b)))\n(newline)\n(define t (open-output-string))\n(display (list 'textual-sink-refused (guard (e (#t 'raised)) (begin (write-u8 65 t) 'accepted))\n               'textual-sink-length (string-length (get-output-string t))))\n(newline)" :note "(range-refused (raised raised raised accepted) wrote #u8(128)) then (textual-sink-refused raised textual-sink-length 0) -- only 128 is a byte, and only 128 reaches the buffer. Out-of-range values are rejected rather than masked, and a byte aimed at a textual port is refused rather than dropped.")
  )
  :caveats ("An out-of-range value RAISES. 300, -1 and 256 are each rejected rather than masked to their low eight bits, so a value that is not a byte can never be mistaken for one that is. Range-check before writing only if you want a different message." "A write to a TEXTUAL port RAISES. R7RS-small 6.13.3 makes a byte write to a textual port an error, and Motoi signals it rather than dropping the byte. Check binary-port? first if the port's kind is unknown." "The return value is unspecified. Never display it, never test it, never make it the last expression of a procedure whose result matters." "The default port is current-output-port, which is TEXTUAL, so the one-argument form raises. Always pass the binary port explicitly." "Bytes are unsigned octets. If you are encoding signed values, choose and document a convention -- the port has none to offer, and -1 is now rejected rather than quietly stored as 255.")
  :usecases ("Building a bytevector incrementally when the final length is not known in advance." "Emitting a length-prefixed frame, writing the count byte and then the payload." "Copying a binary source to a binary sink, paired with read-u8 on the reading side.")
  :related ("read-u8" "open-output-bytevector" "get-output-bytevector" "binary-port?" "write-char")
  :learn (:concept "A verb that silently repairs bad input is harder to use correctly than one that refuses it -- the repair is invisible, so the mistake survives into the data instead of stopping at the call." :prerequisites ("open-output-bytevector" "get-output-bytevector") :progression "Learn open-output-bytevector and get-output-bytevector so a byte sink exists and can be inspected, then write-u8 once, then the accumulation loop, then the range check that the verb does not do for you.")
  :provenance "R7RS-small 6.13.3; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (safe-write-u8 v p)\n  (cond ((not (binary-port? p)) 'wrong-kind)\n        ((not (and (integer? v) (>= v 0) (<= v 255))) 'out-of-range)\n        (else (write-u8 v p) 'ok)))\n(define b (open-output-bytevector))\n(display (list (safe-write-u8 65 b) (safe-write-u8 300 b) (safe-write-u8 -1 b) (safe-write-u8 65 (open-output-string))))\n(newline)\n(display (list 'sink (get-output-bytevector b)))\n(newline)"
     :math-program "(define (write-n n)\n  (let ((b (open-output-bytevector)))\n    (let loop ((i 0))\n      (if (< i n) (begin (write-u8 (modulo i 256) b) (loop (+ i 1)))))\n    (bytevector-length (get-output-bytevector b))))\n(display (map (lambda (n) (= (write-n n) n)) (list 0 1 5 300)))\n(newline)"
     :cs-program "(define b (open-output-bytevector))\n(display (list 'outcomes\n               (map (lambda (v) (guard (e (#t 'raised)) (begin (write-u8 v b) 'wrote)))\n                    (list 0 255 256 511 -1))\n               'sink (get-output-bytevector b)))\n(newline)"
     :problem "The operator is serialising values that ought to be bytes but arrive from arithmetic that can overflow. Candidates: a range check before write-u8 (catches the mistake at the call, where the wrong value can still be attributed to its source), relying on write-u8 to reject it (it does, so the mistake cannot reach the sink), and checking the bytevector afterwards (useless, because a stored byte carries no record of what it was before). The first two both work; the third cannot."
     :explanation "eng: a guarded writer that names its two failure modes and leaves the sink holding only the byte that was actually valid. math: writing n valid bytes gives a bytevector of length n for every n, so nothing is dropped even at three hundred writes. cs: the outcomes line separates the two accepted values from the three rejected ones, and the sink holds exactly the accepted pair."
     :meta "Why 'after' is not an option: the sink stores bytes, so an out-of-range value either never arrives or arrives as something else entirely. Rejecting at the write is what keeps the error attributable to the arithmetic that produced it.")
    (:eng "Distinct sentinels for wrong-kind and out-of-range point at two different bugs in two different places."
     :math "Length equals count at every size, so the accumulation is faithful."
     :cs "The sink holding only 0 and 255 is the assertion: a rejected write leaves no trace, so a byte in the buffer is always a byte someone meant to put there."))
  :row-3-dimension (
    (:setup "Units are appended one at a time to a growing store whose size is not fixed in advance, and the store is read back whole once the writing is finished."
     :rungs ((:domain "io" :code "(define b (open-output-bytevector))\n(for-each (lambda (v) (write-u8 v b)) (list 10 20 30))\n(display (list 'sink (get-output-bytevector b) 'length (bytevector-length (get-output-bytevector b))))\n(newline)")
             (:domain "a bricklayer adding one brick at a time to a wall whose final length is decided by how much material arrives, not by a plan drawn first" :code "(define (lay wall brick) (append wall (list brick)))\n(define (build bricks) (fold (lambda (b w) (lay w b)) (list) bricks))\n(display (list 'wall (build (list 'red 'red 'grey)) 'courses (length (build (list 'red 'red 'grey)))))\n(newline)")
             (:domain "an amortised growable array: appends are constant time on average because the backing store doubles rather than growing by one" :code "(define (grow capacity n)\n  (let loop ((cap capacity) (grows 0))\n    (if (>= cap n) (list 'capacity cap 'doublings grows) (loop (* cap 2) (+ grows 1)))))\n(display (map (lambda (n) (grow 1 n)) (list 1 5 17)))\n(newline)"))
     :explanation "In io write-u8 appends an octet and the port grows to fit. A bricklayer works the same way when the material rather than a drawing decides the length: each unit is placed on the end and the structure's size emerges from the process. A growable array is the same operation given a cost model -- appends are cheap on average because the backing store doubles, which is what makes 'just keep appending' a reasonable habit rather than a quadratic one. All three: append at the end, size discovered rather than declared."
     :meta "The shape transfers to string builders, log files, and every buffer that is written then read. The cost model transfers too: appending is cheap and reading the whole thing is one operation, but reading it repeatedly while still appending is not free.")
    (:eng "Write until done, then read once; do not interleave a full read into the writing loop."
     :math "Total work is linear in the number of appends when the store doubles, which is why the pattern scales."
     :cs "This is the string-builder argument in another costume -- append incrementally, materialise once."))
  :row-4-proof (
    (:eng-program "(define (roundtrip vals)\n  (let ((b (open-output-bytevector)))\n    (for-each (lambda (v) (write-u8 v b)) vals)\n    (let* ((bv (get-output-bytevector b))\n           (p (open-input-bytevector bv)))\n      (let loop ((acc (list)))\n        (let ((x (read-u8 p)))\n          (if (eof-object? x) (equal? (reverse acc) vals) (loop (cons x acc))))))))\n(display (map roundtrip (list (list) (list 0) (list 255 0 128) (list 1 2 3 4 5))))\n(newline)"
     :math-program "(define (length-after n)\n  (let ((b (open-output-bytevector)))\n    (let loop ((i 0))\n      (if (< i n) (begin (write-u8 (modulo i 256) b) (loop (+ i 1)))))\n    (bytevector-length (get-output-bytevector b))))\n(display (map (lambda (n) (list n (length-after n) (= (length-after n) n))) (list 0 1 3 260)))\n(newline)"
     :cs-program "(define b (open-output-bytevector))\n(define outs (map (lambda (v) (guard (e (#t 'raised)) (begin (write-u8 v b) 'wrote)))\n                  (list 256 257 511 -1 -256)))\n(display (list 'all-rejected (equal? outs (list 'raised 'raised 'raised 'raised 'raised))\n               'sink-empty (= (bytevector-length (get-output-bytevector b)) 0)))\n(newline)"
     :claim "write-u8 appends in order and loses nothing: bytes written then read back through a bytevector port come out identical and in sequence; the sink's length equals the number of writes; and every value outside 0..255 is rejected, so no write that was not a byte ever reaches the sink."
     :invariant "For all lists of bytes vs. reading back a port built by writing vs gives vs exactly; and for all integers v outside 0..255. (write-u8 v p) raises and leaves p unchanged"
     :meta "The third program checks both halves of a rejection, which is the part that is easy to half-implement: the call must raise AND the sink must be untouched. A verb that signalled and then wrote anyway would pass a test that only looked at the raise. Five values are used, on both sides of both boundaries. What would falsify: a reordering, a length mismatch, or any of the five values landing in the buffer.")
    (:eng "The roundtrip through a second port is the real assertion: it exercises the writing side and the reading side against each other."
     :math "Length equals write count at every size, including 260, which is past the byte range and shows the count is not itself constrained."
     :cs "Negative inputs are checked separately from large positive ones, because an implementation that masks rather than validates typically differs exactly there."))
  :row-5-emergence (
    (:eng-composition "(define (encode-frame payload)\n  (let ((b (open-output-bytevector)))\n    (write-u8 (length payload) b)\n    (for-each (lambda (v) (write-u8 v b)) payload)\n    (get-output-bytevector b)))\n(display (map encode-frame (list (list) (list 9) (list 1 2 3))))\n(newline)"
     :math-composition "(define (encode-frame payload)\n  (let ((b (open-output-bytevector)))\n    (write-u8 (length payload) b)\n    (for-each (lambda (v) (write-u8 v b)) payload)\n    (get-output-bytevector b)))\n(define (decode-frame bv)\n  (let* ((p (open-input-bytevector bv)) (n (read-u8 p)))\n    (let loop ((i 0) (acc (list)))\n      (if (= i n) (reverse acc) (loop (+ i 1) (cons (read-u8 p) acc))))))\n(display (map (lambda (pl) (list pl (equal? (decode-frame (encode-frame pl)) pl)))\n              (list (list) (list 5) (list 1 2 3 4))))\n(newline)"
     :cs-composition "(define (concat-frames payloads)\n  (let ((b (open-output-bytevector)))\n    (for-each (lambda (pl)\n                (write-u8 (length pl) b)\n                (for-each (lambda (v) (write-u8 v b)) pl))\n              payloads)\n    (get-output-bytevector b)))\n(define (split-frames bv)\n  (let ((p (open-input-bytevector bv)))\n    (let outer ((out (list)))\n      (let ((n (read-u8 p)))\n        (if (eof-object? n)\n            (reverse out)\n            (let inner ((i 0) (acc (list)))\n              (if (= i n)\n                  (outer (cons (reverse acc) out))\n                  (inner (+ i 1) (cons (read-u8 p) acc)))))))))\n(define payloads (list (list 1) (list) (list 7 8 9)))\n(display (list 'wire (concat-frames payloads) 'back (split-frames (concat-frames payloads))\n               'faithful (equal? (split-frames (concat-frames payloads)) payloads)))\n(newline)"
     :base "write-u8 appends one octet, and a bytevector output port grows to hold as many as arrive."
     :emergent "eng: a frame encoder -- one length byte then the payload -- which is the smallest self-describing binary record there is. math: the matching decoder, with encode-then-decode returning the original payload for every input including the empty one. cs: many frames CONCATENATED into one stream and split back apart, where an empty payload survives the round trip as an empty payload rather than disappearing."
     :meta "The composition chains write-u8 with a length prefix and read-u8 on the other side, and what emerges is a WIRE FORMAT: a byte stream that carries its own structure, so a reader with no prior agreement about sizes can still recover the records. That is the whole idea behind every network protocol and container format, and it is four lines of Scheme here.")
    (:eng "The length byte going first is what makes the format streamable -- a reader never needs to see the end to know where the first record stops."
     :math "Round-tripping is exact for every payload tested, and the empty payload is the case that separates a working framing from a nearly-working one."
     :cs "Concatenation with no separator works precisely because each record declares its own length; a format without that needs an escape convention instead."))
)

(verb
  :name "open-input-bytevector" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "constructor"
  :signature "(open-input-bytevector bytevector) -> binary-input-port"
  :summary "Wraps a bytevector as a binary input port so it can be read byte by byte."
  :explanation "The way to get a binary input port without touching a device. R7RS-small 6.13.1 defines open-input-bytevector as taking a bytevector and returning a binary input port that delivers bytes from it. The returned port has its own cursor starting at the beginning, so read-u8 walks forward through the bytevector and peek-u8 looks at the position without moving it; when the bytes run out, both return an eof object. Two ports opened on the same bytevector have independent cursors and do not interfere with each other. This is the binary sibling of open-input-string, and it plays the same role in this chapter: it makes binary IO TESTABLE. A program that reads from a file cannot be verified without a file, but a program that reads from a bytevector port can be verified anywhere, in a fixed number of steps, with no filesystem, no clock and no network -- which is why every runnable example in this record and its neighbours is built on it. Motoi raises when handed something that is not a bytevector, which is a welcome contrast to the silent failures elsewhere in the binary family. One behaviour to know: the port does not copy its source, so mutating the bytevector afterwards changes what the port will read."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (open-input-bytevector #u8(7 8)))\n(display (list (read-u8 p) (read-u8 p) (eof-object? (read-u8 p))))\n(newline)" :note "(7 8 #t) -- the bytes come out in order and the port reports the end when they are gone.")
    (:dialect "motoi" :tier "intermediate" :code "(define src #u8(1 2 3))\n(define p (open-input-bytevector src))\n(read-u8 p)\n(display (list 'source-unchanged src 'port-advanced (peek-u8 p)))\n(newline)\n(define q (open-input-bytevector src))\n(display (list 'independent (read-u8 q) (peek-u8 p)))\n(newline)" :note "(source-unchanged #u8(1 2 3) port-advanced 2) then (independent 1 2) -- reading does not disturb the bytevector, and a second port opened on the same source starts at the beginning with its own cursor.")
    (:dialect "motoi" :tier "expert" :code "(display (list 'raises-on-string (guard (e (#t 'raised)) (open-input-bytevector \"abc\"))\n               'raises-on-list (guard (e (#t 'raised)) (open-input-bytevector (list 1 2)))\n               'raises-on-number (guard (e (#t 'raised)) (open-input-bytevector 5))))\n(newline)" :note "(raises-on-string raised raises-on-list raised raises-on-number raised) -- this constructor does check its argument, which makes it the loudest verb in the binary family. A string is the tempting mistake, and it is caught.")
  )
  :caveats ("MEASURED: the port does NOT copy its source. Mutating the bytevector with bytevector-u8-set! after opening the port changes the bytes the port will deliver. Copy first if the source is shared and mutable." "A string is not a bytevector. open-input-bytevector on a string raises; use open-input-string for characters." "The port is binary, so read-char, read-line and read-string on it RAISE. Use read-u8 and peek-u8, or copy the bytes into a string yourself." "Each call makes a NEW port with its own cursor. To re-read a bytevector, open it again; there is no rewind." "Closing the port stops it delivering bytes: input-port-open? reports #f and read-u8 raises, so the predicate and the reader agree.")
  :usecases ("Making binary IO testable, by standing in for a file so an example runs anywhere in bounded time." "Decoding an in-memory frame or packet with the same code that would read from a device." "Feeding a parser fixed input in a test, including deliberately truncated input to exercise the failure path.")
  :related ("open-output-bytevector" "get-output-bytevector" "read-u8" "peek-u8" "open-input-string")
  :learn (:concept "Turning a value into a port is what lets one piece of code serve both a test and a device -- the reader never learns where its bytes came from, which is exactly why it can be tested without one." :prerequisites ("read-u8" "eof-object?") :progression "Learn bytevector literals, then this constructor as the way to read one as a stream, then read-u8 and peek-u8 over it, then the same reader pointed at a real source.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (parse-header bv)\n  (let ((p (open-input-bytevector bv)))\n    (let ((magic (read-u8 p)) (version (read-u8 p)) (count (read-u8 p)))\n      (cond ((eof-object? magic) 'empty)\n            ((not (= magic 77)) (list 'bad-magic magic))\n            ((eof-object? count) 'truncated)\n            (else (list 'version version 'count count))))))\n(display (map parse-header (list #u8() #u8(77 1 4) #u8(99 1 4) #u8(77 1))))\n(newline)"
     :math-program "(define (readable bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((n 0))\n      (if (eof-object? (read-u8 p)) n (loop (+ n 1))))))\n(display (map (lambda (bv) (= (readable bv) (bytevector-length bv)))\n              (list #u8() #u8(1) #u8(1 2 3) #u8(0 0 0 0 0 0))))\n(newline)"
     :cs-program "(define src #u8(4 5 6))\n(define a (open-input-bytevector src))\n(define b (open-input-bytevector src))\n(read-u8 a)\n(read-u8 a)\n(display (list 'a-next (peek-u8 a) 'b-next (peek-u8 b) 'independent (not (= (peek-u8 a) (peek-u8 b)))))\n(newline)"
     :problem "The operator has a decoder that must be tested without shipping a fixture file. Candidates: open-input-bytevector over a literal (hermetic, fast, and the decoder is unchanged between test and production), indexing the bytevector directly with bytevector-u8-ref (works, but now the test exercises different code from the one that runs against a device), and writing a temporary file (slow, needs a filesystem, and can fail for reasons that have nothing to do with the decoder). The port keeps the code under test identical."
     :explanation "eng: one header parser and four inputs, including empty, wrong-magic and truncated -- all three failure paths reachable with no file. math: the number of readable bytes equals the bytevector length for every input. cs: two ports on one source advance independently, which is what makes a test able to read the same fixture twice."
     :meta "Why not bytevector-u8-ref in the test: testing a different implementation than the one you ship is the oldest way to get a green suite and a broken program. The port exists so the code under test does not have to change.")
    (:eng "Truncated input is the case a fixture file rarely covers and a literal covers in eight characters."
     :math "Readable count equals length at every size, so the port exposes the whole source and nothing more."
     :cs "Independent cursors are why a fixture can be shared across tests without an ordering dependency between them."))
  :row-3-dimension (
    (:setup "A value held in memory is dressed up as a stream, so code written for a stream can be pointed at it without knowing the difference."
     :rungs ((:domain "io" :code "(define p (open-input-bytevector #u8(1 2 3)))\n(define (consume p)\n  (let loop ((acc (list)))\n    (let ((b (read-u8 p)))\n      (if (eof-object? b) (reverse acc) (loop (cons b acc))))))\n(display (consume p))\n(newline)")
             (:domain "a rehearsal stand-in: the understudy walks the blocking so the scene can be run without the lead, and the staging never learns which one it had" :code "(define (run-scene actor) (list 'scene-played-by actor))\n(display (list (run-scene 'lead) (run-scene 'understudy)))\n(newline)")
             (:domain "an in-memory filesystem or fake in a test suite: the same interface, no device behind it, so the code under test is byte-for-byte the code that ships" :code "(define (store-get store key) (let ((hit (assq key store))) (if hit (cdr hit) 'missing)))\n(define fake (list (cons 'a 1) (cons 'b 2)))\n(display (list (store-get fake 'a) (store-get fake 'z)))\n(newline)"))
     :explanation "In io the bytevector is the value and the port is the costume; a reader written for a device works unchanged. A rehearsal stand-in is the same substitution on a stage: the scene runs, the blocking is exercised, and nothing about the staging depends on which actor stood there. An in-memory fake in a test suite is the software version of the same idea, and its virtue is identical -- the code under test does not change, so passing the test is evidence about the shipping code. All three: an interface honoured by a cheap substitute."
     :meta "The shape transfers to sockets, files, clocks and random sources -- anything a program depends on that a test cannot afford. The rule that transfers with it: the substitute must satisfy the interface exactly, because every place it differs is a place the test stops being evidence.")
    (:eng "Depend on the interface, not the device, and the substitution becomes free."
     :math "The substitution is sound only where the two implementations agree; the gap between them is the residual risk."
     :cs "This is dependency injection with no framework -- a constructor that returns something satisfying the same protocol."))
  :row-4-proof (
    (:eng-program "(define (readback bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((i 0) (ok #t))\n      (if (= i (bytevector-length bv))\n          (and ok (eof-object? (read-u8 p)))\n          (loop (+ i 1) (and ok (= (read-u8 p) (bytevector-u8-ref bv i))))))))\n(display (map readback (list #u8() #u8(0) #u8(255) #u8(1 2 3 4 5))))\n(newline)"
     :math-program "(define (fresh-starts-at-zero bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((k 0))\n      (if (= k 3)\n          #t\n          (let ((q (open-input-bytevector bv)))\n            (if (= (bytevector-length bv) 0)\n                (and (eof-object? (read-u8 q)) (loop (+ k 1)))\n                (and (= (read-u8 q) (bytevector-u8-ref bv 0)) (loop (+ k 1)))))))))\n(display (map fresh-starts-at-zero (list #u8() #u8(9) #u8(3 2 1))))\n(newline)"
     :cs-program "(display (list 'kind-and-direction\n               (let ((p (open-input-bytevector #u8(1))))\n                 (list (port? p) (input-port? p) (output-port? p) (binary-port? p) (textual-port? p) (input-port-open? p)))\n               'rejects-non-bytevector\n               (map (lambda (x) (guard (e (#t 'raised)) (begin (open-input-bytevector x) 'accepted)))\n                    (list \"s\" (list 1) 5 'sym))))\n(newline)"
     :claim "open-input-bytevector returns a port that delivers exactly the source bytes in order and then an eof object; every new port starts at position zero regardless of how other ports on the same source have been read; and the result is an open binary input port."
     :invariant "For all bytevectors bv. the i-th read from a fresh port = (bytevector-u8-ref bv i); and every fresh port begins at position 0; and the result satisfies binary-port? and input-port-open?"
     :meta "The second program opens three ports on the same source in a loop and checks each starts at the beginning, because 'fresh cursor' is an assumption every test fixture silently makes and a shared cursor would corrupt whole suites in ways that look like flakiness. The third pins the port's six attributes in one line, which is the fastest way to see that kind and direction are both fixed by the constructor. What would falsify: bytes out of order, a fresh port not starting at zero, or the result failing binary-port?.")
    (:eng "Checking the boundary read after the last byte is what proves the port stops where the source does."
     :math "Position i maps to byte i for every i and every bytevector, and the empty case is handled explicitly."
     :cs "Rejecting a string, a list, a number and a symbol is a real gate, and it is the only one in the binary family."))
  :row-5-emergence (
    (:eng-composition "(define (decode bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((out (list)))\n      (let ((tag (read-u8 p)))\n        (cond ((eof-object? tag) (reverse out))\n              ((= tag 0) (loop (cons 'nil out)))\n              ((= tag 1) (loop (cons (list 'byte (read-u8 p)) out)))\n              (else (loop (cons (list 'unknown tag) out))))))))\n(display (map decode (list #u8() #u8(0 0) #u8(1 42 0) #u8(9))))\n(newline)"
     :math-composition "(define (checksum bv)\n  (let ((p (open-input-bytevector bv)))\n    (let loop ((sum 0))\n      (let ((b (read-u8 p)))\n        (if (eof-object? b) (modulo sum 256) (loop (+ sum b)))))))\n(display (map (lambda (bv) (list (checksum bv) (= (checksum bv) (checksum bv))))\n              (list #u8() #u8(1 2 3) #u8(200 100))))\n(newline)"
     :cs-composition "(define (test-case name bv expect)\n  (let* ((p (open-input-bytevector bv))\n         (got (let loop ((acc (list)))\n                (let ((b (read-u8 p)))\n                  (if (eof-object? b) (reverse acc) (loop (cons b acc)))))))\n    (list name 'pass (equal? got expect))))\n(display (list (test-case 'empty #u8() (list))\n               (test-case 'one #u8(5) (list 5))\n               (test-case 'many #u8(1 2 3) (list 1 2 3))\n               (test-case 'deliberately-wrong #u8(1) (list 2))))\n(newline)"
     :base "open-input-bytevector turns a value into a readable stream with its own cursor."
     :emergent "eng: a tag decoder run over four fixtures, including an empty one and an unknown tag, with no file anywhere. math: a checksum that is reproducible -- computing it twice on the same source gives the same number, because each call opens a fresh port. cs: a TEST HARNESS, four lines long, where each case is a name, a literal bytevector and an expected result, and the last case fails on purpose to show the harness can tell."
     :meta "The composition chains this constructor with a read loop and a comparison, and what emerges is the HERMETIC FIXTURE: a test that depends on nothing outside itself -- no file, no clock, no network -- and therefore gives the same answer on every machine and at every hour. That property is what lets a reference chapter's examples be executed as a gate rather than read as a claim.")
    (:eng "The unknown tag and the empty input are in the fixture list because those are the paths a real corpus exercises and a happy-path test never reaches."
     :math "Reproducibility follows from the fresh cursor: a shared one would make the second checksum zero and the flakiness would be blamed on the checksum."
     :cs "The deliberately failing case is not decoration -- a harness that has never failed has not been tested."))
)

(verb
  :name "open-output-bytevector" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "constructor"
  :signature "(open-output-bytevector) -> binary-output-port"
  :summary "Makes an empty binary output port that accumulates the bytes written to it."
  :explanation "The binary sink you can inspect. R7RS-small 6.13.1 defines open-output-bytevector as returning a binary output port that accumulates the bytes written to it, which get-output-bytevector then hands back as a bytevector. It takes no arguments -- there is no size to declare, because the port grows to fit whatever arrives. This is the binary counterpart of open-output-string, and it completes the hermetic pair that makes this chapter testable: open-input-bytevector supplies bytes without a file and open-output-bytevector collects them without one. A fresh port is empty, open, binary and output-directed, which four predicates will confirm. Writing is done with write-u8 one octet at a time; there is no bulk write in R7RS-small's core, so a loop or a for-each is the normal shape. Motoi accepts textual writes to this port as well, encoding characters as bytes, which the standard does not sanction and which the binary-port? record demonstrates. The port's accumulated bytes are readable at any time and reading them does not clear the port, so a snapshot taken mid-stream is a genuine snapshot and later writes append to what was already there."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define b (open-output-bytevector))\n(write-u8 1 b)\n(write-u8 2 b)\n(display (get-output-bytevector b))\n(newline)" :note "#u8(1 2) -- an empty sink, two bytes written, and the accumulated bytevector handed back.")
    (:dialect "motoi" :tier "intermediate" :code "(define b (open-output-bytevector))\n(display (list 'fresh (get-output-bytevector b) 'binary (binary-port? b) 'open (output-port-open? b) 'textual (textual-port? b)))\n(newline)\n(write-u8 42 b)\n(display (list 'after (get-output-bytevector b)))\n(newline)" :note "(fresh #u8() binary #t open #t textual #f) then (after #u8(42)) -- a fresh port is empty and its kind and direction are fixed by the constructor, not by what is written to it.")
    (:dialect "motoi" :tier "expert" :code "(define b (open-output-bytevector))\n(write-u8 7 b)\n(define snap (get-output-bytevector b))\n(write-u8 8 b)\n(display (list 'earlier-snapshot snap 'now (get-output-bytevector b)))\n(newline)" :note "(earlier-snapshot #u8(7) now #u8(7 8)) -- reading the port does not clear it and the snapshot is a copy, so the earlier bytevector keeps its old contents while the port goes on growing.")
  )
  :caveats ("It takes NO arguments. There is no capacity to declare and no way to pre-size it; the port grows to fit." "There is no bulk write in the R7RS-small core. Bytes go in one at a time via write-u8, so a for-each or a loop is the expected shape." "MEASURED: Motoi accepts textual writes to this port, encoding characters as bytes, where R7RS-small 6.13.1 makes that an error. Write bytes." "Closing the port does not stop it accepting writes in Motoi. output-port-open? reports #f afterwards, but a write still lands." "Reading it does not empty it. Each get-output-bytevector returns everything written so far, so accumulating in a loop and reading each pass gives growing prefixes, not successive chunks.")
  :usecases ("Building a bytevector whose final length is not known until the last value has been produced." "Collecting an encoder's output in a test so it can be compared against an expected bytevector." "Serving as the sink half of a byte pipeline, with open-input-bytevector as the source half.")
  :related ("get-output-bytevector" "open-input-bytevector" "write-u8" "open-output-string" "binary-port?")
  :learn (:concept "A sink you can look inside turns an effect into a value, and a value can be compared -- which is the entire reason a test can say anything about code that writes." :prerequisites ("write-u8" "get-output-bytevector") :progression "Learn open-output-string and get-output-string first if you have not, then this as the same idea for bytes, then write-u8 into it, then the encoder-plus-comparison test that motivates both.")
  :provenance "R7RS-small 6.13.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (encode vals)\n  (let ((b (open-output-bytevector)))\n    (for-each (lambda (v) (write-u8 v b)) vals)\n    (get-output-bytevector b)))\n(display (map encode (list (list) (list 1) (list 77 111 116 111 105))))\n(newline)"
     :math-program "(define (grow-to n)\n  (let ((b (open-output-bytevector)))\n    (let loop ((i 0))\n      (if (< i n) (begin (write-u8 (modulo i 256) b) (loop (+ i 1)))))\n    (bytevector-length (get-output-bytevector b))))\n(display (map (lambda (n) (list n (grow-to n) (= (grow-to n) n))) (list 0 1 8 500)))\n(newline)"
     :cs-program "(define b (open-output-bytevector))\n(define snaps\n  (map (lambda (v) (write-u8 v b) (bytevector-length (get-output-bytevector b)))\n       (list 1 2 3 4)))\n(display (list 'lengths snaps 'final (get-output-bytevector b)))\n(newline)"
     :problem "The operator is writing an encoder whose output length depends on the data and wants to compare the result against an expected bytevector in a test. Candidates: open-output-bytevector (the length is discovered, the result is a value, and the comparison is one equal?), pre-allocating a bytevector and tracking an index (requires knowing the length first, which is the thing that is unknown), and appending bytevectors as you go (correct but quadratic, since each append copies everything written so far). The port is the only candidate that is both simple and linear."
     :explanation "eng: three encodings including the empty one, each a value that can be compared. math: writing n bytes gives length n for every n, including five hundred, so growth is not capped. cs: the running lengths climb by one per write, which is the visible form of 'append, do not replace'."
     :meta "Why not append: it is the natural first instinct and it turns a linear job into a quadratic one. The port exists because that instinct is common and the cost is invisible until the input gets large.")
    (:eng "Returning a value rather than performing an effect is what makes an encoder testable at all."
     :math "Length equals write count at every size tested, so no capacity limit is being silently applied."
     :cs "Monotone growth by one per write is worth showing, because a port that replaced instead of appending would pass a single-write test."))
  :row-3-dimension (
    (:setup "An empty vessel of no fixed size collects contributions one at a time, and its contents can be inspected without being emptied."
     :rungs ((:domain "io" :code "(define b (open-output-bytevector))\n(for-each (lambda (v) (write-u8 v b)) (list 3 1 4 1 5))\n(display (list 'contents (get-output-bytevector b) 'size (bytevector-length (get-output-bytevector b))))\n(newline)")
             (:domain "a collection tin passed round a room: it starts empty, grows by whatever each person adds, and counting it does not take the money out" :code "(define (add tin coin) (cons coin tin))\n(define (count tin) (apply + tin))\n(define tin (fold (lambda (c t) (add t c)) (list) (list 5 10 2)))\n(display (list 'total (count tin) 'still-there (count tin) 'items (length tin)))\n(newline)")
             (:domain "an accumulator in a fold: the carried value grows with each element, and the fold's result is that value once every element has been seen" :code "(define (sum-fold lst) (fold + 0 lst))\n(display (map sum-fold (list (list) (list 5) (list 1 2 3 4))))\n(newline)"))
     :explanation "In io the port is the vessel and write-u8 is a contribution. A collection tin is the same at room scale: it begins empty, has no declared capacity, grows by whatever arrives, and counting it is non-destructive. A fold's accumulator is the same shape in a functional idiom -- a value carried forward and extended once per element, with the result available at the end. All three: an empty start, incremental growth, and a non-destructive read."
     :meta "The shape transfers to string builders, list accumulators, log buffers and reducers. What differs is only whether the vessel is mutated or rebuilt; the port mutates, the fold rebuilds, and the visible behaviour is the same.")
    (:eng "Start empty and let the data decide the size; declaring a capacity in advance is a guess you will have to defend."
     :math "This is a fold with the accumulator hidden inside the port, which is why the code looks imperative and behaves like a reduction."
     :cs "Non-destructive read is the property that makes a mid-stream snapshot meaningful rather than a partial consumption."))
  :row-4-proof (
    (:eng-program "(define (roundtrip vals)\n  (let ((b (open-output-bytevector)))\n    (for-each (lambda (v) (write-u8 v b)) vals)\n    (let ((p (open-input-bytevector (get-output-bytevector b))))\n      (let loop ((acc (list)))\n        (let ((x (read-u8 p)))\n          (if (eof-object? x) (equal? (reverse acc) vals) (loop (cons x acc))))))))\n(display (map roundtrip (list (list) (list 0) (list 255 128 0) (list 1 2 3 4 5 6))))\n(newline)"
     :math-program "(define (length-after n)\n  (let ((b (open-output-bytevector)))\n    (let loop ((i 0))\n      (if (< i n) (begin (write-u8 0 b) (loop (+ i 1)))))\n    (bytevector-length (get-output-bytevector b))))\n(display (map (lambda (n) (= (length-after n) n)) (list 0 1 2 16 400)))\n(newline)"
     :cs-program "(define a (open-output-bytevector))\n(define b (open-output-bytevector))\n(write-u8 1 a)\n(write-u8 9 b)\n(write-u8 2 a)\n(display (list 'a (get-output-bytevector a) 'b (get-output-bytevector b)\n               'independent (not (equal? (get-output-bytevector a) (get-output-bytevector b)))\n               'fresh-is-empty (get-output-bytevector (open-output-bytevector))))\n(newline)"
     :claim "a fresh port is empty; writes accumulate in order so that the collected bytevector read back through an input port reproduces the values written; the length equals the number of writes at every size; and two ports are independent of each other."
     :invariant "For all lists of bytes vs. reading back the port's bytevector gives vs exactly; and (bytevector-length collected) = (length vs); and writes to one port never appear in another"
     :meta "The third program interleaves writes to two ports on purpose, because independence is the assumption every test fixture makes and shared state would show up as cross-contamination between unrelated tests -- the hardest class of bug to attribute. What would falsify: a fresh port that was not empty, a length mismatch, bytes out of order, or a byte appearing in the wrong port.")
    (:eng "The roundtrip through open-input-bytevector tests the pair together, which is how they are always used."
     :math "Length equals count at every size including four hundred, so nothing is capped or chunked."
     :cs "Interleaving the writes rather than doing them in blocks is what makes the independence check meaningful."))
  :row-5-emergence (
    (:eng-composition "(define (encode-run byte n)\n  (let ((b (open-output-bytevector)))\n    (write-u8 n b)\n    (let loop ((i 0))\n      (if (< i n) (begin (write-u8 byte b) (loop (+ i 1)))))\n    (get-output-bytevector b)))\n(display (map (lambda (pair) (encode-run (car pair) (cadr pair)))\n              (list (list 7 0) (list 7 1) (list 255 4))))\n(newline)"
     :math-composition "(define (transcode bv f)\n  (let ((in (open-input-bytevector bv)) (out (open-output-bytevector)))\n    (let loop ()\n      (let ((x (read-u8 in)))\n        (if (not (eof-object? x)) (begin (write-u8 (f x) out) (loop)))))\n    (get-output-bytevector out)))\n(define (rot b) (modulo (+ b 128) 256))\n(display (map (lambda (bv) (list (transcode bv rot) (equal? (transcode (transcode bv rot) rot) bv)))\n              (list #u8() #u8(0 255) #u8(1 2 3))))\n(newline)"
     :cs-composition "(define (build-message parts)\n  (let ((b (open-output-bytevector)))\n    (write-u8 (length parts) b)\n    (for-each (lambda (part)\n                (write-u8 (length part) b)\n                (for-each (lambda (v) (write-u8 v b)) part))\n              parts)\n    (get-output-bytevector b)))\n(define (read-message bv)\n  (let* ((p (open-input-bytevector bv)) (n (read-u8 p)))\n    (let outer ((k 0) (out (list)))\n      (if (= k n)\n          (reverse out)\n          (let ((len (read-u8 p)))\n            (let inner ((i 0) (acc (list)))\n              (if (= i len)\n                  (outer (+ k 1) (cons (reverse acc) out))\n                  (inner (+ i 1) (cons (read-u8 p) acc)))))))))\n(define parts (list (list 1 2) (list) (list 9)))\n(display (list 'wire (build-message parts) 'back (read-message (build-message parts))\n               'faithful (equal? (read-message (build-message parts)) parts)))\n(newline)"
     :base "open-output-bytevector is an empty, unbounded, inspectable byte sink."
     :emergent "eng: a run encoder that writes a count and then that many copies, with the zero-length run producing a one-byte result rather than nothing. math: a transcoder built from an input port and an output port, demonstrated with an involution so that applying it twice returns the original -- which proves the pipeline is lossless without needing an expected value. cs: a NESTED MESSAGE FORMAT with a part count, per-part lengths and payloads, encoded and decoded, including an empty part that survives the round trip."
     :meta "The composition chains this constructor with write-u8, get-output-bytevector and its input-side twin, and what emerges is the ENCODER/DECODER PAIR: two procedures that are each other's inverse, testable together with no fixture at all, because the test is 'decode of encode is identity' rather than 'output equals this literal'. Property-style tests like that survive format changes; literal-comparison tests do not.")
    (:eng "The zero-length run is the case that separates a format with an explicit count from one that relies on there being data."
     :math "An involution is the cheapest strong check available: no expected output has to be written down, and any dropped or reordered byte breaks it."
     :cs "The empty middle part is deliberate -- a nested format that silently drops empty children is the classic serialisation bug."))
)

(verb
  :name "get-output-bytevector" :std "R7RS-small"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(get-output-bytevector port) -> bytevector"
  :summary "Returns a bytevector of everything written to a bytevector output port so far."
  :explanation "The way to look inside a binary sink. R7RS-small 6.13.3 defines get-output-bytevector as taking a port created by open-output-bytevector and returning a bytevector consisting of the bytes that have been output to it so far, in the order they were output. It is a SNAPSHOT, not a drain: the port is unchanged by the call, so asking twice gives the same answer and later writes append to what was already there rather than starting again. The bytevector it returns is a separate value, so a snapshot taken early keeps its contents while the port goes on growing. This verb is what turns binary output from an effect into a value, and a value is something a test can compare -- which is why it appears in nearly every runnable example in the binary family. Its argument is checked rather than trusted: a textual output port, an input port, and an object that is not a port at all each raise. That check is doing real work. #u8() would have been a perfectly plausible answer for all three, and it is exactly the answer a correct bytevector port gives when nothing has been written to it, so a permissive version would make 'wrong argument' and 'nothing written' the same value forever. Because it raises, an empty result now means one thing only: this sink is empty."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define b (open-output-bytevector))\n(write-u8 200 b)\n(write-u8 100 b)\n(display (get-output-bytevector b))\n(newline)" :note "#u8(200 100) -- everything written so far, in the order it was written.")
    (:dialect "motoi" :tier "intermediate" :code "(define b (open-output-bytevector))\n(display (list 'snapshot-1 (get-output-bytevector b)))\n(newline)\n(write-u8 1 b)\n(display (list 'snapshot-2 (get-output-bytevector b)))\n(newline)\n(write-u8 2 b)\n(display (list 'snapshot-3 (get-output-bytevector b) 'repeat (get-output-bytevector b)))\n(newline)" :note "(snapshot-1 #u8()) then (snapshot-2 #u8(1)) then (snapshot-3 #u8(1 2) repeat #u8(1 2)) -- each call reports everything so far, and calling twice in a row gives the same answer because reading does not drain.")
    (:dialect "motoi" :tier "expert" :code "(display (list 'textual-sink (guard (e (#t 'raised)) (get-output-bytevector (open-output-string)))\n               'input-port (guard (e (#t 'raised)) (get-output-bytevector (open-input-bytevector #u8(1))))\n               'non-port (guard (e (#t 'raised)) (get-output-bytevector 42))))\n(newline)" :note "(textual-sink raised input-port raised non-port raised) -- three wrong arguments and three raises. An empty bytevector now means exactly one thing: a binary output port that nothing was written to.")
  )
  :caveats ("A textual port, an input port and a non-port all RAISE. That matters more than it looks: #u8() would have been a plausible answer for all three, and indistinguishable from a bytevector port to which nothing was written. An empty result now means exactly one thing." "It does NOT drain the port. Calling it in a loop gives growing prefixes of the same data, not successive chunks; if you want chunks, track what you have already consumed." "The returned bytevector is a separate value. An earlier snapshot keeps its contents while the port continues to grow." "It requires the port argument -- there is no default and no current-output-bytevector." "It works on a CLOSED bytevector port and still returns the contents. Closing stops writes, not reads-back; the standard does not grant this, so do not rely on it in portable code.")
  :usecases ("Harvesting an encoder's output so a test can compare it against an expected bytevector." "Taking a mid-stream snapshot to check progress without disturbing the writing." "Finishing a byte pipeline, turning the sink port back into a value the rest of the program can use.")
  :related ("open-output-bytevector" "write-u8" "get-output-string" "open-input-bytevector" "binary-port?")
  :learn (:concept "Turning an effect back into a value is the move that makes side-effecting code testable, and 'snapshot rather than drain' is the property that makes it safe to do more than once." :prerequisites ("open-output-bytevector" "write-u8") :progression "Learn open-output-bytevector and write-u8 so a sink has contents, then this to see them, then the guarded version that checks the argument before trusting an empty answer.")
  :provenance "R7RS-small 6.13.3; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (harvest p)\n  (cond ((not (port? p)) 'not-a-port)\n        ((not (output-port? p)) 'not-an-output-port)\n        ((not (binary-port? p)) 'not-binary)\n        (else (get-output-bytevector p))))\n(define b (open-output-bytevector))\n(write-u8 5 b)\n(display (map harvest (list b (open-output-bytevector) (open-output-string) (open-input-bytevector #u8(1)) 42)))\n(newline)"
     :math-program "(define (snapshot-growth n)\n  (let ((b (open-output-bytevector)))\n    (let loop ((i 0) (lens (list)))\n      (if (= i n)\n          (reverse lens)\n          (begin (write-u8 (modulo i 256) b)\n                 (loop (+ i 1) (cons (bytevector-length (get-output-bytevector b)) lens)))))))\n(display (map snapshot-growth (list 0 1 4)))\n(newline)"
     :cs-program "(define b (open-output-bytevector))\n(write-u8 1 b)\n(define first-snap (get-output-bytevector b))\n(write-u8 2 b)\n(define second-snap (get-output-bytevector b))\n(display (list 'first first-snap 'second second-snap\n               'first-unchanged (equal? first-snap #u8(1))\n               'idempotent (equal? (get-output-bytevector b) (get-output-bytevector b))))\n(newline)"
     :problem "The operator wants to harvest an encoder's bytes and must distinguish an encoder that produced nothing from a call made against the wrong port. Candidates: a predicate ladder before the call (names each wrong case, so the report says WHICH mistake was made), a guard around the call (fires, because every wrong argument raises, but collapses four different mistakes into one 'raised'), and checking the result for emptiness afterwards (useless -- #u8() is now unambiguous, so an empty result tells you the sink was empty and nothing else). The ladder is the one that produces a diagnosis rather than a verdict."
     :explanation "eng: five arguments, four of them wrong in different ways, each reported by name rather than as one undifferentiated failure. math: the snapshot lengths climb by exactly one per write, so a snapshot is cumulative rather than incremental. cs: an earlier snapshot keeps its own contents while the port grows, and two consecutive calls agree."
     :meta "Why a ladder rather than a guard: both stop the bad call, and only one of them tells you what was wrong. A guard says 'that failed'; the ladder says 'that was an input port'. Prefer the check that names the case whenever the cases are enumerable in advance.")
    (:eng "Four named failures beat one undifferentiated raise, and the cost is a four-line cond."
     :math "Cumulative lengths 1, 2, 3, 4 are the signature of a snapshot; 1, 1, 1, 1 would be the signature of a drain."
     :cs "Idempotence is what makes a snapshot safe to take inside a logging or assertion path that may run more than once."))
  :row-3-dimension (
    (:setup "A running total kept by a process is read out without stopping or resetting the process, and the reading is a copy that stays fixed while the process goes on."
     :rungs ((:domain "io" :code "(define b (open-output-bytevector))\n(write-u8 1 b)\n(define early (get-output-bytevector b))\n(write-u8 2 b)\n(display (list 'early early 'late (get-output-bytevector b)))\n(newline)")
             (:domain "reading an electricity meter: the number is written down, the meter keeps counting, and the reading in the notebook does not change afterwards" :code "(define (read-meter total) total)\n(define first-reading (read-meter 100))\n(define second-reading (read-meter 140))\n(display (list 'first first-reading 'second second-reading 'first-still first-reading))\n(newline)")
             (:domain "a persistent snapshot of a mutable structure: the snapshot is immutable and the structure carries on, which is what lets a reader and a writer coexist" :code "(define (snapshot lst) (list-copy lst))\n(define live (list 1 2))\n(define snap (snapshot live))\n(define grown (append live (list 3)))\n(display (list 'snap snap 'grown grown 'snap-unchanged (equal? snap (list 1 2))))\n(newline)"))
     :explanation "In io get-output-bytevector reads the port's accumulation without disturbing it, and the result is a fixed copy. An electricity meter is the same at household scale: you write down the number, the meter keeps counting, and yesterday's reading stays yesterday's. A persistent snapshot of a mutable structure is the software generalisation -- the snapshot is frozen, the structure carries on, and a reader can work from the frozen copy while a writer continues. All three: a non-disturbing read that yields something stable."
     :meta "The shape transfers to metrics counters, database snapshots, version-control checkouts and profilers. The recurring subtlety is the same everywhere: two snapshots taken at different times are both correct and they disagree, and any conclusion drawn from comparing them is a statement about the interval, not about the value.")
    (:eng "Record when a snapshot was taken, not just what it said; a reading without a time is not evidence."
     :math "The difference between two snapshots measures the interval between them, which is what makes cumulative counters useful."
     :cs "Immutability of the snapshot is the whole mechanism -- a snapshot that aliased the live structure would silently change under its reader."))
  :row-4-proof (
    (:eng-program "(define (writes-then-reads vals)\n  (let ((b (open-output-bytevector)))\n    (for-each (lambda (v) (write-u8 v b)) vals)\n    (let ((once (get-output-bytevector b)) (twice (get-output-bytevector b)))\n      (list (= (bytevector-length once) (length vals))\n            (equal? once twice)))))\n(display (map writes-then-reads (list (list) (list 3) (list 1 2 3) (list 9 9 9 9))))\n(newline)"
     :math-program "(define (cumulative n)\n  (let ((b (open-output-bytevector)))\n    (let loop ((i 0) (lens (list)))\n      (if (= i n)\n          (equal? (reverse lens) (let build ((k 1) (acc (list)))\n                                   (if (> k n) (reverse acc) (build (+ k 1) (cons k acc)))))\n          (begin (write-u8 0 b)\n                 (loop (+ i 1) (cons (bytevector-length (get-output-bytevector b)) lens)))))))\n(display (map cumulative (list 0 1 3 6)))\n(newline)"
     :cs-program "(define b (open-output-bytevector))\n(write-u8 1 b)\n(define snap (get-output-bytevector b))\n(write-u8 2 b)\n(display (list 'snapshot-frozen (equal? snap #u8(1))\n               'port-grew (equal? (get-output-bytevector b) #u8(1 2))\n               'wrong-args-raise (map (lambda (x) (guard (e (#t 'raised)) (get-output-bytevector x)))\n                                      (list (open-output-string) (open-input-bytevector #u8(9)) 0))))\n(newline)"
     :claim "get-output-bytevector is a snapshot: it returns everything written so far in order, it is idempotent, it does not drain the port, and the value it returns is frozen against later writes. Every wrong argument raises, so #u8() has exactly one meaning."
     :invariant "For all bytevector output ports p. (get-output-bytevector p) = (get-output-bytevector p); and its length = the number of writes so far; and a snapshot taken at time t is unaffected by writes after t"
     :meta "The middle program checks that successive snapshot lengths are exactly 1, 2, ... n, which distinguishes a snapshot from a drain in a way a single comparison cannot -- a drain would give all ones. The third puts the three wrong arguments under a guard so their raises become printable data rather than an ended program. What would falsify: two consecutive calls disagreeing, a length that did not match the write count, a snapshot changing after a later write, or a wrong argument returning #u8() after all.")
    (:eng "Comparing once against twice in the same expression is the cheapest possible test for idempotence."
     :math "The length sequence 1..n is the fingerprint of cumulative behaviour and is checked against a generated list rather than a literal."
     :cs "Putting the three wrong arguments side by side under one guard shows they all stop the program at the call, which is what makes an empty result trustworthy."))
  :row-5-emergence (
    (:eng-composition "(define (encode-and-check vals)\n  (let ((b (open-output-bytevector)))\n    (for-each (lambda (v) (write-u8 v b)) vals)\n    (let ((bv (get-output-bytevector b)))\n      (list 'bytes bv 'length-ok (= (bytevector-length bv) (length vals))))))\n(display (map encode-and-check (list (list) (list 5) (list 1 2 3))))\n(newline)"
     :math-composition "(define (progress-log n)\n  (let ((b (open-output-bytevector)))\n    (let loop ((i 0) (marks (list)))\n      (if (= i n)\n          (list 'marks (reverse marks) 'final (bytevector-length (get-output-bytevector b)))\n          (begin (write-u8 (modulo i 256) b)\n                 (loop (+ i 1)\n                       (if (= (modulo (+ i 1) 3) 0)\n                           (cons (bytevector-length (get-output-bytevector b)) marks)\n                           marks)))))))\n(display (map progress-log (list 0 3 7)))\n(newline)"
     :cs-composition "(define (expect-bytes name thunk want)\n  (let ((b (open-output-bytevector)))\n    (thunk b)\n    (let ((got (get-output-bytevector b)))\n      (list name 'pass (equal? got want)))))\n(display (list (expect-bytes 'empty (lambda (p) #t) #u8())\n               (expect-bytes 'one (lambda (p) (write-u8 9 p)) #u8(9))\n               (expect-bytes 'three (lambda (p) (for-each (lambda (v) (write-u8 v p)) (list 1 2 3))) #u8(1 2 3))\n               (expect-bytes 'deliberately-wrong (lambda (p) (write-u8 1 p)) #u8(2))))\n(newline)"
     :base "get-output-bytevector turns a sink's accumulated effect into an ordinary value, without disturbing the sink."
     :emergent "eng: an encoder that harvests and self-checks its own length in the same breath. math: a progress log that samples the sink's size every third write, using the snapshot property to observe without interfering. cs: expect-bytes, a GOLDEN-OUTPUT ASSERTION for binary code -- a name, a thunk that writes, and an expected bytevector, with a deliberately failing case to show the harness is not merely agreeable."
     :meta "The composition chains this verb with open-output-bytevector and a comparison, and what emerges is the BINARY GOLDEN TEST: the same discipline that a string port gives to printing code, applied to bytes. A procedure whose whole purpose is to write is otherwise untestable; harvesting makes its effect a value, and equal? does the rest. That is the entire reason both halves of the pair exist in the standard.")
    (:eng "Length-checking alongside the bytes catches the common encoder bug of writing the right values the wrong number of times."
     :math "Sampling every third write shows non-interference in the clearest way: the marks are 3, 6 and the final length is unaffected by having been read."
     :cs "The deliberately failing case is the only part of a harness that proves the harness works."))
)



(verb
  :name "slat-loads" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-loads text) -> value | list-of-values | error-record"
  :summary "Parse SLAT text into Motoi values. Every top-level form is read, however the text is broken across lines; one form gives you the value, two or more give you a list."
  :explanation "SLAT is Motoi's on-disk data notation -- the format every .slat file in this reference is written in. slat-loads is the reader half of the pair whose writer half is slat-dumps. It takes a STRING, not a port: the base environment has no reader port, so the whole text arrives as one argument. What comes back depends on the text. A form with a leading symbol and keyword fields, like (event :ts 1), becomes an opaque RECORD -- not a list, not a pair, not anything the list verbs can walk. You read its fields with slat-key and you turn it back into text with slat-dumps, and those are the only two doors. A form with no leading symbol, like (1 2 3), comes back as an ordinary Scheme list, because there are no fields to hold. A bare atom comes back as itself. Empty text comes back as the empty list. The verb never throws: a parse failure returns an (error :kind ... :message ...) record whose message you read with slat-key. The reading is now LOSSLESS. It used to parse exactly one form per line and discard whatever else was on that line, so (slat-loads \"(a 1) (b 2)\") answered (a 1) and said nothing about (b 2) -- silent data loss at the format boundary, where the read succeeded, the value looked right, and half the input was gone. It now reads every form on every line and hands back all of them, which is the rule multi-LINE input already followed. Two malformed inputs used to HANG rather than answer: a bare apostrophe, and any whitespace character outside space, tab, newline and carriage return -- a form feed, a vertical tab, a non-breaking space pasted in from a word processor. The atom scanner stopped at those characters but no branch above it consumed them, so the reader advanced by zero and spun, allocating an empty symbol per turn until the host heap died. Both now answer. The apostrophe gets a named refusal saying SLAT is a data format with no quote; the exotic whitespace is simply whitespace, so a form separated by a non-breaking space reads as two symbols exactly as if the separator had been an ordinary one. The one surviving subtlety is the RETURN SHAPE: one form gives you the value itself and n forms give you a list of n, so the caller must know which it is holding before it indexes."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-key (slat-loads \"(event :ts 1)\") 'ts)" :note "1 -- the text parsed into a record, and slat-key pulled the :ts field out of it by name.")
    (:dialect "motoi" :tier "intermediate" :code "(slat-dumps (slat-loads \"(e :b 2 :a 1)\"))" :note "\"(e :a 1 :b 2)\" -- the keywords come back SORTED. A record has no field order, so a read followed by a write canonicalises rather than preserving what you typed.")
    (:dialect "motoi" :tier "expert" :code "(slat-dumps (slat-loads \"(a 1) (b 2)\"))" :note "\"((a 1) (b 2))\" -- two forms went in on one line and BOTH came out, as a two-element list. slat-dumps writes one value, so the list gets written as a list; use slat-dump when you want two top-level forms back as text.")
  )
  :caveats ("A bare apostrophe is REFUSED by name: (slat-key (slat-loads \"(a 'b)\") 'message) reads 'apostrophe is not slat syntax'. SLAT is a data format and has no quote, so write the symbol bare or put the text inside a double-quoted string. It used to hang the host instead of answering." "One form yields the VALUE; two or more yield a LIST of values. The shape follows the form count, so code that assumes a single value breaks the day a second form arrives -- and the count is not always recoverable afterwards, because a single bare list like (1 2 3) is itself a list of three." "What comes back from a keyword-bearing form is an opaque record. pair?, list?, car and cdr all fail on it. Reach for slat-key and slat-dumps." "A record does not print its contents. display, write and the CLI's auto-print all show the same thing -- #<slat-record event> for (slat-loads \"(event :ts 1)\") -- which names the type and the record's leading symbol and stops there. Wrap it in slat-dumps to see the fields." "It never raises. A malformed input returns an error RECORD, which is truthy, so an unchecked (if (slat-loads bad) ...) takes the success branch. Test with (slat-key result 'message) instead." "Line breaks do not change WHAT is read, only how it looks: three forms on one line and three forms on three lines both give a list of three." "It takes a string, not a port or a filename. There is no file reading here.")
  :usecases ("Reading a configuration or record written by slat-dumps back into a running program." "Parsing one SLAT line at a time out of a log the program is streaming from somewhere else." "Turning a hand-typed literal into a record so the record path can be tested without a file.")
  :related ("slat-read" "slat-load" "slat-load-doc" "slat-dumps" "slat-key")
  :learn (:concept "A reader turns TEXT into VALUES, and the shape of the value it hands back is a decision the reader makes -- here, whether you get a record or a list depends on whether the form had a leading symbol." :prerequisites ("string literals" "slat-key") :progression "Read one form and pull one field with slat-key, then dump it back with slat-dumps to see what the reader decided, then meet slat-load for many forms.")
  :provenance "Motoi-own; src/slat-verbs.js slatLoadsVerb over bindings/js/slat.js slatLoads; measured against the live engine 2026-08-02; reference record added 2026-08-02; truncation and hang fixed and record rewritten 2026-08-02"
  :row-2-audit (
    (:eng-program "(define text \"(reading :sensor fuel :value 88)\")\n(define r (slat-loads text))\n(display (list 'value (slat-key r 'value) 'form (slat-key r '_form)))\n(newline)"
     :math-program "(define (forms-seen text) (let ((v (slat-loads text))) (if (list? v) (length v) 1)))\n(display (map forms-seen (list \"(a 1)\" \"(a 1) (b 2)\" \"(a 1)\\n(b 2)\\n(c 3)\")))\n(newline)"
     :cs-program "(define (safe-load text)\n  (let ((v (slat-loads text)))\n    (if (equal? (slat-key v '_form) \"error\") (list 'failed (slat-key v 'message)) (list 'ok (slat-dumps v)))))\n(display (safe-load \"(a 1)\"))\n(newline)\n(display (safe-load \"(a 1\"))\n(newline)"
     :problem "The operator has a string of SLAT text and wants the values it denotes. Candidates: slat-loads (one string in, a value or a list out), slat-load (always a list, one entry per form), and slat-load-doc (joins the lines first and REFUSES anything past one top-level form). Pick by what you want the arity mismatch to do. slat-load never surprises you with the shape; slat-load-doc turns a surprise into an error; slat-loads is the compact choice when you already know the count."
     :explanation "eng: one reading parsed, two fields pulled. math: the count follows the FORMS -- one form gives 1, two forms on one line give 2, three forms on three lines give 3, so line breaks are formatting and nothing else. cs: an error record is truthy, so the safe wrapper checks _form rather than trusting the value."
     :meta "Why slat-loads and not slat-load: slat-load always hands back a list, so a single-form read costs you a car. That is a fine trade when the form count is unknown, and a wasted step when you already know there is one. Choose by what you know about the input, not by which name is shorter.")
    (:eng "Field names survive the round trip, so downstream code addresses data by name and not by position."
     :math "shape(text) = the value when the text holds one form, and a list of n when it holds n. Line breaks do not appear in the formula at all."
     :cs "Related patterns: JSON.parse in JavaScript, read in standard Scheme, ast.literal_eval in Python. All three raise on trailing junk. This one returns it."))
  :row-3-dimension (
    (:setup "A reader that collapses the singleton: when the text holds exactly one form it hands back the form, and when it holds several it hands back a container. The convenience costs you the ability to count afterwards."
     :rungs ((:domain "io" :code "(display (list (slat-dumps (slat-loads \"(a 1)\"))\n               (length (slat-loads \"(a 1) (b 2)\"))))\n(newline)")
             (:domain "a parcel that arrives unboxed when the order holds one item: the courier saves a box, and the receiving desk's open-the-box-and-take-everything-out routine finds nothing to open" :code "(define (unpack text)\n  (let ((v (slat-loads text)))\n    (if (list? v) (map (lambda (f) (slat-key f '_form)) v) (slat-key v '_form))))\n(display (list (unpack \"(a 1)\") (unpack \"(a 1) (b 2)\")))\n(newline)")
             (:domain "a union type T-or-list-of-T: every caller must dispatch on the shape before it can act, and the dispatch is not always decidable" :code "(define (shape text) (if (list? (slat-loads text)) 'list 'one))\n(display (map shape (list \"(a 1)\" \"(a 1) (b 2)\" \"(1 2 3)\")))\n(newline)"))
     :explanation "In io, one form comes back bare and several come back in a list. The unboxed parcel is the same saving made physically, and it breaks the same downstream routine -- the one that assumed a box. The union type is the algebraic version, and the third rung shows the sting: (1 2 3) is ONE form that happens to be a list, so the shape test calls it 'list and is wrong. All three share: collapsing a container of one destroys the difference between the container and its contents."
     :meta "The shape transfers wherever an API optimises the common case by removing a wrapper. The cost is always paid by the caller who has to reconstruct the count, and it is only affordable when the element type can never be confused with the container -- which is exactly the condition SLAT does not meet.")
    (:eng "One form in gives the value; two give a list of two. Know which you are holding before you index, or ask for slat-load, which always boxes."
     :math "Counting with length is sound only when the forms are records. A single bare list is a list, and its length is its element count, not one."
     :cs "This is the same trap as a shell glob that expands to one filename, or an XML parser that returns a node instead of a nodelist. The fix is always the same: expose an always-a-collection entry point next to the convenient one."))
  :row-4-proof (
    (:eng-program "(define (kept text) (slat-dumps (slat-loads text)))\n(display (list (kept \"(a 1)\") (kept \"(a 1) (b 2)\") (kept \"(a 1) (b 2) (c 3)\")))\n(newline)"
     :math-program "(define (n-values text) (let ((v (slat-loads text))) (if (list? v) (length v) 1)))\n(display (list 'one-line (n-values \"(a 1) (b 2) (c 3)\")\n               'three-lines (n-values \"(a 1)\\n(b 2)\\n(c 3)\")))\n(newline)"
     :cs-program "(define (idempotent? text)\n  (let* ((once (slat-dumps (slat-loads text)))\n         (twice (slat-dumps (slat-loads once))))\n    (equal? once twice)))\n(display (map idempotent? (list \"(a 1)\" \"(e :b 2 :a 1)\" \"(a 1) (b 2)\")))\n(newline)"
     :claim "Reading is lossless: every top-level form in the text appears in the answer, and the number of forms recovered does not depend on how they were distributed across lines. Dumping is idempotent after one pass, so a text that survives a round trip unchanged is already canonical."
     :invariant "For all texts t. slat-dumps(slat-loads(slat-dumps(slat-loads t))) = slat-dumps(slat-loads t)"
     :meta "The pattern is a lossless reader in front of a canonicalising writer. What would falsify losslessness: a form present in the text and absent from the answer, which is precisely what the first program used to show and no longer does. What would falsify idempotence: a second pass that changed the text again.")
    (:eng "The kept-text probe is the regression test. Three forms in, three forms out; if that answer ever shrinks, the truncation bug is back."
     :math "Three forms on one line and three forms on three lines both yield 3. The equality of those two numbers is the whole fix in one comparison."
     :cs "Idempotence after one pass is what makes SLAT usable as a storage format: whatever the first read produced is stable forever after."))
  :row-5-emergence (
    (:eng-composition "(define (parse-log text)\n  (map (lambda (line) (slat-loads line))\n       (list \"(tick :n 1)\" \"(tick :n 2)\" \"(tick :n 3)\")))\n(display (map (lambda (r) (slat-key r 'n)) (parse-log \"\")))\n(newline)"
     :math-composition "(define (round-trip-stable? text) (equal? (slat-dumps (slat-loads text)) text))\n(display (list 'sorted-keys (round-trip-stable? \"(e :a 1 :b 2)\")\n               'unsorted-keys (round-trip-stable? \"(e :b 2 :a 1)\")))\n(newline)"
     :cs-composition "(define (field-or record key fallback)\n  (let ((v (slat-key record key)))\n    (if (equal? v #f) fallback v)))\n(define r (slat-loads \"(config :retries 3)\"))\n(display (list (field-or r 'retries 1) (field-or r 'timeout 30)))\n(newline)"
     :base "slat-loads turns SLAT text into the values it denotes."
     :emergent "eng: mapping the reader across a list of lines gives a record stream. math: comparing the dump against the original gives a canonical-form detector for free. cs: pairing the reader with slat-key and a default gives a config reader that tolerates missing fields."
     :meta "The composition is reader plus accessor plus default, and what emerges is the CONFIGURATION PATTERN: text you can edit by hand, fields you address by name, and a defined answer when a field is absent. slat-key returning #f rather than raising is what makes the default layer a one-liner. The verb did not grow; the pair did.")
    (:eng "Mapping the reader per line, rather than handing it the whole text, pins the return shape: one form per call means a value per call, never a list you have to unwrap."
     :math "A text is canonical exactly when it equals its own dump, which is a decidable test you can run on any candidate before storing it."
     :cs "Read, address by name, fall back to a default is the same three-step shape behind every dotfile parser ever shipped."))
)

(verb
  :name "slat-read" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-read text) -> value | list-of-values | error-record"
  :summary "The Book of SLAT's spelling of slat-loads. It is not merely equivalent -- it is the SAME procedure object, so every behaviour of slat-loads is here unchanged."
  :explanation "Motoi teaches SLAT twice: the Book of SLAT names the reader slat-read, and the runtime names it slat-loads. Rather than keep two implementations that could drift, the engine binds both names to one procedure -- (eq? slat-read slat-loads) is #t, not merely equal?. That is the strongest form an alias can take: there is no second code path to test, no second place for a bug to hide, and nothing that can be fixed in one name and forgotten in the other. Everything the slat-loads record says applies here word for word: every top-level form in the text is read, one form gives you the value and several give you a list, and a keyword-bearing form comes back as an opaque record readable only through slat-key and slat-dumps. Identity used to have one seam. The engine's structured-call wrapper unwraps a call only when the head symbol matches a name the procedure was REGISTERED under, and this procedure was registered under slat-loads alone -- so a host that drove Motoi through the structured protocol and spelled the call [slat-read text] fell through to the positional branch and handed the whole list to the reader as its text argument. The wrapper now accepts both spellings. It does that only for readers, whose argument is a string and which therefore have no legitimate symbol-headed argument to confuse; the writers deliberately keep the single-name rule, because (slat-dumps (list 'slat-write 'x)) is a real value someone may want written and must not be mistaken for a call."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-dumps (slat-read \"(hello)\"))" :note "\"(hello)\" -- the same reading slat-loads does, under the name the Book of SLAT teaches.")
    (:dialect "motoi" :tier "intermediate" :code "(eq? slat-read slat-loads)" :note "#t -- not two procedures that agree, ONE procedure with two names. eq? is identity, so there is no second implementation to drift.")
    (:dialect "motoi" :tier "expert" :code "(slat-key (slat-read \"(event :ts 1 :kind \\\"opened\\\")\") 'kind)" :note "\"opened\" -- fields come out by name, and the accessor is slat-key under either spelling of the reader.")
  )
  :caveats ("It is the identical procedure object, so it inherits the return-shape rule described under slat-loads: one form gives the value, several give a list." "Introspection reports it as its own binding even though it shares a body, so help and all-verbs list both names." "It reads a STRING. There is no port and no file access anywhere in this family." "Its partner is slat-write, which is likewise the same object as slat-dumps.")
  :usecases ("Following Book of SLAT code verbatim without translating names." "Writing for readers who know the read/write pair from other Lisps, where read is the customary name." "Nothing else -- there is no case where slat-read does something slat-loads does not.")
  :related ("slat-loads" "slat-write" "slat-dumps" "slat-key" "slat-load")
  :learn (:concept "An alias can be a second name or a second implementation. Only the first kind is safe, because only the first kind cannot drift." :prerequisites ("slat-loads" "eq?") :progression "Learn slat-loads first, then check eq? against slat-read to see that an alias in Motoi means identity, then trust that anything you learn about one holds for the other.")
  :provenance "Motoi-own; src/slat-verbs.js -- `export const slatReadVerb = slatLoadsVerb`; measured against the live engine 2026-08-02; reference record added 2026-08-02; structured-dispatch alias fixed and record rewritten 2026-08-02"
  :row-2-audit (
    (:eng-program "(define incoming \"(order :id 41 :qty 2)\")\n(define r (slat-read incoming))\n(display (list 'id (slat-key r 'id) 'qty (slat-key r 'qty)))\n(newline)"
     :math-program "(define texts (list \"(a 1)\" \"(b :x 2)\" \"(1 2 3)\" \"\"))\n(display (map (lambda (t) (equal? (slat-dumps (slat-read t)) (slat-dumps (slat-loads t)))) texts))\n(newline)"
     :cs-program "(display (list 'same-object (eq? slat-read slat-loads)\n               'also-a-pair (eq? slat-write slat-dumps)))\n(newline)"
     :problem "The operator is copying code out of the Book of SLAT and it says slat-read, while the reference says slat-loads. Candidates: rename the call to slat-loads, keep slat-read, or define a local wrapper. Keeping slat-read is correct -- it is the same object, so there is nothing to gain by renaming and a diff to review if you do. Define a wrapper only when you want to add behaviour, never to bridge a name."
     :explanation "eng: an order line read under the Book's name, fields pulled by name. math: for every text tried, the two names produce the same dump -- as they must, being one procedure. cs: eq? on both members of the read/write pair, in one line, so the identity claim is checked rather than asserted."
     :meta "Why an alias by identity rather than by definition: (define (slat-read t) (slat-loads t)) would also work today and would drift the first time somebody edits one of them. Sharing the object makes drift impossible rather than unlikely.")
    (:eng "Two names for one door is a documentation decision, not an architecture decision -- as long as there is genuinely one door."
     :math "Extensional equality would be a claim about every input. Identity is a claim about the object, which is stronger and cheaper to check."
     :cs "Compare Python's list.sort versus sorted -- two names, two behaviours, endless confusion. Same-object aliasing avoids that whole class of question."))
  :row-3-dimension (
    (:setup "A synonym that is guaranteed rather than merely observed: two labels attached to a single thing, so no experiment can ever tell them apart."
     :rungs ((:domain "io" :code "(display (list (eq? slat-read slat-loads)\n               (equal? (slat-dumps (slat-read \"(a :b 1)\")) (slat-dumps (slat-loads \"(a :b 1)\")))))\n(newline)")
             (:domain "two street signs on one corner after a road is renamed, with the old name kept so old maps still work" :code "(define corner (list 'main-street 'heritage-way))\n(define (find-corner name) (if (memq name corner) 'same-corner 'elsewhere))\n(display (map find-corner (list 'main-street 'heritage-way 'other-road)))\n(newline)")
             (:domain "an equivalence class of size one: distinct labels, a single element, so every function of the element agrees on both labels" :code "(define (agree-on? f g inputs) (map (lambda (x) (equal? (f x) (g x))) inputs))\n(display (agree-on? slat-read slat-loads (list \"(a 1)\" \"(1 2)\" \"x\")))\n(newline)"))
     :explanation "In io, slat-read and slat-loads are one procedure with two bindings. Two signs on one corner is the civic version -- the old name is kept precisely so documents written against it stay correct, and no traveller can end up somewhere different by reading the old sign. An equivalence class with one element is the algebraic version: any function you apply must give the same answer under either label, because there is only one thing to apply it to. All three share: the multiplicity is in the NAMING, never in the thing."
     :meta "The shape transfers wherever a rename must not break existing text. The failure mode is always the same -- somebody implements the old name as a thin copy instead of a pointer, and then fixes a bug in only one of them.")
    (:eng "Keeping the old name costs one binding and buys every already-written program."
     :math "Agreement on a sample is evidence; identity is proof. Prefer the check that cannot be defeated by an input you did not try."
     :cs "Symlinks, C typedefs and Scheme's own (define car first) are the same move -- and the same trap when someone reimplements instead of pointing."))
  :row-4-proof (
    (:eng-program "(display (list 'identity (eq? slat-read slat-loads)\n               'reads-the-same (equal? (slat-dumps (slat-read \"(a :x 1)\")) \"(a :x 1)\")))\n(newline)"
     :math-program "(define samples (list \"(a 1)\" \"(b :k \\\"v\\\")\" \"(1 2 3)\" \"42\" \"\"))\n(display (map (lambda (t) (equal? (slat-dumps (slat-read t)) (slat-dumps (slat-loads t)))) samples))\n(newline)"
     :cs-program "(display (list 'read-alias (eq? slat-read slat-loads)\n               'write-alias (eq? slat-write slat-dumps)\n               'not-cross-wired (eq? slat-read slat-dumps)))\n(newline)"
     :claim "slat-read and slat-loads are the same procedure object, so they agree on every input; the same holds for slat-write and slat-dumps; and the two pairs are not cross-wired."
     :invariant "For all texts t. slat-read(t) = slat-loads(t), because slat-read IS slat-loads"
     :meta "The pattern is aliasing by identity. What would falsify it: an eq? of #f, or an input on which the dumps differed. The third clause of the cs program is the one worth keeping -- it catches the copy-paste error where an alias is wired to its own opposite.")
    (:eng "Checking both pairs in one program means a future refactor that splits either alias fails here first."
     :math "Because identity holds, agreement over the sample is a consequence and not independent evidence -- it is there to catch a future implementation change, not to establish the claim."
     :cs "The cross-wiring check costs one clause and catches the single most likely aliasing bug."))
  :row-5-emergence (
    (:eng-composition "(define (read-all lines) (map slat-read lines))\n(define rows (read-all (list \"(row :n 1)\" \"(row :n 2)\" \"(row :n 3)\")))\n(display (map (lambda (r) (slat-key r 'n)) rows))\n(newline)"
     :math-composition "(define (round-trip x) (slat-read (slat-write x)))\n(display (list 'plain-list (equal? (round-trip (list 1 2 3)) (list 1 2 3))\n               'tagged-form (equal? (round-trip (list 'e ':b 2)) (list 'e ':b 2))))\n(newline)"
     :cs-composition "(define (transcode text) (slat-write (slat-read text)))\n(display (map transcode (list \"(e :b 2 :a 1)\" \"(1 2 3)\" \"(a 1) (b 2)\")))\n(newline)"
     :base "slat-read parses SLAT text, under the Book of SLAT's name for the reader."
     :emergent "eng: mapping the reader over lines gives a record stream, one form per call, which pins the return shape to a value rather than a list. math: read after write round-trips a plain list but NOT a keyword-tagged form, because the tagged form comes back as a record. cs: write after read is a canonicaliser -- it sorts keywords, and a two-form text comes back WRAPPED as a two-element list, because slat-write writes one value."
     :meta "The composition is read-after-write and write-after-read, and what emerges is the ASYMMETRY that matters most in this family: text survives a round trip through values, but values do NOT survive a round trip through text once they carry keyword fields. Learn which direction is faithful before you build storage on top of it.")
    (:eng "One form per call is the framing that pins the shape, and mapping the reader over lines is what makes that framing automatic."
     :math "round-trip is the identity on plain lists and is NOT the identity on tagged forms -- the second answer is #f, and that #f is the single most useful fact in this chapter."
     :cs "Write-after-read as a canonicaliser is the standard trick for making two files comparable, and it works here as long as you accept the sorting."))
)


(verb
  :name "slat-load" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-load text) -> list-of-values"
  :summary "Read a line-delimited SLAT stream. Always answers a LIST, one entry per FORM, and a line that fails to parse becomes a _bad-line sentinel instead of aborting the read."
  :explanation "Where slat-loads reads a value, slat-load reads a STREAM. The text is split on newlines, blank lines and lines whose first non-space character is a semicolon are dropped, and every surviving line is parsed on its own. The return is always a list -- one form still gives you a one-element list, which is the point: a caller can map over the answer without first asking how many forms there were. The counting rule is per FORM, not per line. A line carrying (a 1) (b 2) contributes TWO entries, because the reader now consumes every form on the line and slat-load pushes each one separately; it used to fuse them into a single list entry, which read as one record and was two. The other half of the design is tolerance. slat-loads on a bad line hands back an error record for the whole call; slat-load keeps going, and the failed line lands in the list as a record whose _form is the string \"_bad-line\" and which carries the offending text under 'input and the parser's complaint under 'error. That is the right trade for a log or an append-only file, where one corrupt line should cost you one record and not the file. Tolerance now covers the apostrophe too: a line holding a bare apostrophe used to take the host down with it, and now becomes an ordinary _bad-line sentinel carrying the refusal message, so one pasted-in quote costs you one record."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(length (slat-load \"(a 1)\\n(b 2)\\n(c 3)\"))" :note "3 -- three lines in, a three-element list out. One entry per line, always a list.")
    (:dialect "motoi" :tier "intermediate" :code "(length (slat-load \"(a 1)\\n\\n; a comment\\n(b 2)\"))" :note "2 -- blank lines and semicolon-comment lines are dropped before parsing, so they never appear as entries.")
    (:dialect "motoi" :tier "expert" :code "(map (lambda (r) (slat-key r 'error)) (slat-load \"(oops\"))" :note "(\"unterminated form\") -- a line that will not parse becomes a _bad-line record carrying the parser's complaint, and the read continues.")
  )
  :caveats ("It ALWAYS returns a list, even for one form. (car (slat-load text)) is how you get the single value, and forgetting the car is the usual first bug." "A bad line yields a _bad-line record, not an exception. Those records are truthy and mix into the list with the good ones, so filter on (slat-key r '_form) before you trust an entry." "Entries count FORMS, not lines. A line holding two forms contributes two entries, so the length of the answer is not the number of lines you can see." "Comment stripping is by leading semicolon only, tested after trimming. A semicolon later in a line is data, which is correct, and differs from slat-load-doc, which is not." "Empty text answers the empty list, which is the right answer and not an error.")
  :usecases ("Reading a whole append-only log of SLAT records in one call." "Loading a hand-edited data file where blank lines and comments are expected." "Any read where one bad line must not cost the rest of the file.")
  :related ("slat-loads" "slat-load-doc" "slat-dump" "slat-key" "slat-read")
  :learn (:concept "A tolerant reader trades an exception for a sentinel: the failure becomes a value in the result, so the caller decides what a bad record costs." :prerequisites ("slat-loads" "slat-key" "map") :progression "Read one line with slat-loads, then a whole stream with slat-load, then look at what a deliberately broken line turns into so the sentinel is a thing you have seen rather than a thing you were told about.")
  :provenance "Motoi-own; src/slat-verbs.js slatLoadVerb; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define log \"(tick :n 1)\\n(tick :n 2)\\n(tick :n 3)\")\n(display (map (lambda (r) (slat-key r 'n)) (slat-load log)))\n(newline)"
     :math-program "(define (entries text) (length (slat-load text)))\n(display (map entries (list \"\" \"(a 1)\" \"(a 1)\\n(b 2)\" \"(a 1)\\n\\n(b 2)\" \"(a 1)\\n; note\\n(b 2)\")))\n(newline)"
     :cs-program "(define (partition-stream text)\n  (let ((rows (slat-load text)))\n    (list 'good (length (filter (lambda (r) (not (equal? (slat-key r '_form) \"_bad-line\"))) rows))\n          'bad (length (filter (lambda (r) (equal? (slat-key r '_form) \"_bad-line\")) rows)))))\n(display (partition-stream \"(a 1)\\n(oops\\n(b 2)\"))\n(newline)"
     :problem "The operator has a file of SLAT records, one per line, and one line is corrupt. Candidates: slat-load (keeps the good lines, sentinels the bad one), slat-loads on the whole text (returns a list too, but the first bad line poisons the call), and mapping slat-loads over the lines by hand (works, and duplicates the blank-line and comment handling). slat-load is the honest choice: it is the only one that answers 'here are the eleven records and here is the one that failed'."
     :explanation "eng: three tick records read and their counters pulled. math: with one form per line, the entry count equals the number of lines that are neither blank nor comments, over five inputs. cs: partitioning the result by _form is the standard first step, and it is what makes the sentinel useful instead of dangerous."
     :meta "Why slat-load and not a hand-rolled map over the lines: the hand-rolled version will not drop comments the same way, and the difference shows up the day somebody adds a header comment to the file. Reuse the framing rules rather than re-deriving them.")
    (:eng "One corrupt line costs one record. That is the property you buy, and it is worth the filter you now have to write."
     :math "entries(text) = count of FORMS on the lines that are non-blank and do not begin with a semicolon -- independent of whether those lines parse. It equals the line count exactly when each line holds one form, which is the format's convention rather than its rule."
     :cs "Related patterns: JSON Lines readers with an on_error callback, Python's csv.reader with a strict flag off, Kafka's poison-pill handling. Every one of them makes the caller decide what a bad record costs."))
  :row-3-dimension (
    (:setup "A tolerant batch reader: many units arrive together, each is decoded independently, and a failure is recorded in place rather than propagated to the batch."
     :rungs ((:domain "io" :code "(display (map (lambda (r) (slat-key r '_form)) (slat-load \"(a 1)\\n(oops\\n(b 2)\")))\n(newline)")
             (:domain "a postal sorting frame where an unreadable address goes to a dead-letter pigeonhole and the rest of the sack keeps moving" :code "(define (sort-item addr) (if (equal? addr \"\") 'dead-letter 'delivered))\n(display (map sort-item (list \"12 elm st\" \"\" \"4 oak rd\")))\n(newline)")
             (:domain "a total function built from a partial one by widening the codomain: every input now has an answer, and some answers say 'no answer'" :code "(define (total-parse text)\n  (let ((r (slat-loads text)))\n    (if (equal? (slat-key r '_form) \"error\") (list 'none (slat-key r 'message)) (list 'some (slat-dumps r)))))\n(display (total-parse \"(a 1)\"))\n(newline)\n(display (total-parse \"(a 1\"))\n(newline)"))
     :explanation "In io, slat-load decodes each line on its own and files the failures as sentinels. A postal sorting frame does the same thing with letters -- an unreadable address is set aside in a named place and the sack keeps moving, because stopping the sack to argue about one envelope is the expensive option. Widening a partial function's codomain is the algebraic move behind both: instead of being undefined somewhere, the function is defined everywhere and some of its values mean failure. All three share: the failure becomes DATA, and data can be counted, routed and retried."
     :meta "The shape transfers wherever a batch must survive its worst member. The trap is forgetting that the sentinels are truthy and letting them flow downstream as if they were records.")
    (:eng "Filing failures in place is what lets you report 'nine hundred good, three bad' instead of 'the file did not load'."
     :math "Widening the codomain is only useful if callers actually inspect the tag. An unchecked sentinel is worse than an exception, because it travels further before it hurts."
     :cs "Result and Either types are the same widening done in the type system, where the compiler forces the inspection this one leaves to you."))
  :row-4-proof (
    (:eng-program "(define (counts text)\n  (let ((rows (slat-load text)))\n    (list (length rows)\n          (length (filter (lambda (r) (equal? (slat-key r '_form) \"_bad-line\")) rows)))))\n(display (map counts (list \"(a 1)\" \"(a 1)\\n(oops\" \"(oops\\n(oops\")))\n(newline)"
     :math-program "(define (entries text) (length (slat-load text)))\n(define (significant-lines n) n)\n(display (map (lambda (p) (= (entries (car p)) (cadr p)))\n              (list (list \"\" 0) (list \"(a 1)\" 1) (list \"(a 1)\\n(b 2)\" 2) (list \"(a 1)\\n\\n\\n(b 2)\" 2) (list \"; only a comment\" 0))))\n(newline)"
     :cs-program "(define rows (slat-load \"(a 1)\\n(oops\\n(b 2)\"))\n(display (list 'total (length rows)\n               'always-a-list (list? (slat-load \"(a 1)\"))\n               'bad-is-truthy (if (cadr rows) 'yes 'no)))\n(newline)"
     :claim "slat-load returns a list with one entry per form on the non-blank, non-comment lines; a line that fails to parse contributes a _bad-line sentinel rather than removing the entry or aborting the call; and the return is a list even for a single form."
     :invariant "For all texts t whose significant lines each hold one form. length(slat-load t) = |{lines of t that are non-blank and do not start with a semicolon}|"
     :meta "The pattern is length-preserving tolerant decoding. What would falsify it: a bad line that vanished from the result, a call that raised, or a single-form text that answered a bare value. The invariant is stated under the one-form-per-line hypothesis on purpose -- that is the format's convention, and the entry count follows the forms when a line breaks it. The third clause of the cs program is the caveat stated as a test: the sentinel is truthy, so an if on it is not a validity check.")
    (:eng "Reporting total and bad side by side is the shape of every honest import summary."
     :math "Length is preserved regardless of parse SUCCESS, which is what makes line numbers in the source line up with indices in the result -- so long as each line really does hold one form."
     :cs "Index alignment between input lines and output entries is worth more than it looks: it is what lets an error message say 'line 47' without a second pass. It is an alignment you maintain by convention, not one the reader enforces."))
  :row-5-emergence (
    (:eng-composition "(define (load-report text)\n  (let* ((rows (slat-load text))\n         (bad (filter (lambda (r) (equal? (slat-key r '_form) \"_bad-line\")) rows)))\n    (list 'read (length rows) 'rejected (length bad))))\n(display (load-report \"(a 1)\\n(oops\\n(b 2)\\n(c 3)\"))\n(newline)"
     :math-composition "(define (round-trip-stream text) (slat-dump (slat-load text)))\n(display (round-trip-stream \"(b 2)\\n(a 1)\"))\n(display (equal? (round-trip-stream \"(b 2)\\n(a 1)\") \"(b 2)\\n(a 1)\\n\"))\n(newline)"
     :cs-composition "(define (good-rows text)\n  (filter (lambda (r) (not (equal? (slat-key r '_form) \"_bad-line\"))) (slat-load text)))\n(define (sum-field rows key) (apply + (map (lambda (r) (slat-key r key)) rows)))\n(display (sum-field (good-rows \"(m :v 3)\\n(oops\\n(m :v 4)\") 'v))\n(newline)"
     :base "slat-load turns a line-delimited SLAT stream into a list of records, sentinels included."
     :emergent "eng: counting the sentinels gives an import report without any extra machinery. math: slat-load followed by slat-dump is a stream round trip, and it holds because both agree that the line is the frame. cs: filtering the sentinels out first turns the tolerant read into a strict one, and only then is it safe to fold over a field."
     :meta "The composition is read-stream, partition, then aggregate, and what emerges is the IMPORT PIPELINE: every serious data intake is those three steps in that order. Doing the aggregate before the partition is the classic bug -- the sentinel has no 'v field, slat-key answers #f, and the fold adds a boolean to a number one line later.")
    (:eng "An import that cannot say how many records it rejected is an import nobody should trust."
     :math "Stream round trips hold because dump appends exactly one newline per entry, which puts one form on each line, and that is precisely the input shape load counts one entry from -- the two rules are inverses."
     :cs "Partition-then-aggregate is the shape behind every ETL job, and the order is not negotiable."))
)

(verb
  :name "slat-load-doc" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-load-doc text) -> value | error-record"
  :summary "Read a whole SLAT document whose single form may span many lines. It flattens the text to one line first, strips comments without cutting into string literals, and REFUSES any document holding more than one top-level form."
  :explanation "A .slat file is usually one big form spread over many lines with comments between them. slat-loads refuses newlines inside a form, so slat-load-doc exists to bridge the gap: it strips the comments, drops the blank lines, joins what is left with single spaces, and hands the resulting one-liner to the same tokenizer. It is the only verb in the family that reads an indented multi-line record. Two defects used to sit exactly where a person's editing habits meet the reader, and both are now closed. The comment stripper cut every line at its FIRST semicolon, whether that semicolon was a comment marker or a character inside a double-quoted string, so a document containing (note :text \"a;b\") lost its closing quote and came back reading 'unterminated string' -- a parse failure with no relation to anything the author wrote. The stripper now tracks quotes, and it carries that state ACROSS lines, because joining lets a string span them; a semicolon inside a string is data, a semicolon outside one starts a comment. The whole-document guard, meanwhile, never fired. It intended to reject a document holding more than one top-level form, but it counted using a value that collapses a one-element result, so it got both directions wrong: it rejected the single form (1 2 3) as though it were three, and it accepted a genuine two-form document in silence, keeping the first and discarding the rest. The count now comes from a reader that always reports one entry per form, so (slat-load-doc \"(a 1)\\n(b 2)\") returns a slat/multi-form error naming the count, and (slat-load-doc \"(1 2 3)\") returns the list."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-dumps (slat-load-doc \"(incident\\n  :id \\\"in-1\\\"\\n  :body \\\"tank drained\\\")\"))" :note "\"(incident :id \\\"in-1\\\" :body \\\"tank drained\\\")\" -- three lines joined into one form. :id leads because it is one of the five hinted keys slat-dumps promotes; see that record for the ordering rule.")
    (:dialect "motoi" :tier "intermediate" :code "(slat-key (slat-load-doc \"(a 1)\\n(b 2)\") 'message)" :note "\"slat-load-doc: whole-document mode expects zero or one top-level form; got 2\" -- a whole-document read is a read of ONE form, and a second form is refused by name rather than dropped.")
    (:dialect "motoi" :tier "expert" :code "(slat-dumps (slat-load-doc \"(note :text \\\"a;b\\\")\"))" :note "\"(note :text \\\"a;b\\\")\" -- the semicolon is inside a string, so it is data. A semicolon outside one still starts a comment.")
  )
  :caveats ("A document with two or more top-level forms is REFUSED with a slat/multi-form error that names the count. Use slat-load, one form per line, when you mean to read several." "Newlines inside the form become single spaces, so a string literal that spanned lines is joined with a space where the newline was -- write an embedded newline as the two characters backslash-n instead." "An unterminated string swallows the rest of the document's comments, because the stripper carries its quote state forward. The parse then fails with 'unterminated string', which is the right diagnosis, but the reported position will be the end of the document rather than the line you opened the quote on." "Indentation is discarded, which is fine for data and fatal for anything that treated leading whitespace as meaning." "It answers a value, not a list. That is the difference from slat-load, which always answers a list." "A document holding zero forms answers the empty list, not an error.")
  :usecases ("Reading a single multi-line record out of a hand-written .slat file." "Parsing a configuration block that a person is expected to indent for readability." "Checking that a file really does hold exactly one record, since a second one is now an error rather than a silence.")
  :related ("slat-loads" "slat-load" "slat-dump-doc" "slat-key" "slat-dumps")
  :learn (:concept "A pre-processing pass that runs before the tokenizer has to learn just enough structure to know where its own rule is suspended -- here, that a double quote opens a region in which a semicolon is data." :prerequisites ("slat-loads" "string literals") :progression "Read a one-line form with slat-loads, then a multi-line one with slat-load-doc, then put a semicolon inside a string and watch it survive, and a semicolon outside one and watch it disappear.")
  :provenance "Motoi-own; src/slat-verbs.js slatLoadDocVerb; measured against the live engine 2026-08-02; reference record added 2026-08-02; string-aware comment stripping and a working multi-form guard landed and record rewritten 2026-08-02"
  :row-2-audit (
    (:eng-program "(define doc \"(reactor\\n  :name \\\"unit-2\\\"\\n  :temp 318\\n  :state stable)\")\n(define r (slat-load-doc doc))\n(display (list (slat-key r 'name) (slat-key r 'temp) (slat-key r 'state)))\n(newline)"
     :math-program "(define (survives? text) (equal? (slat-dumps (slat-load-doc text)) (slat-dumps (slat-loads text))))\n(display (map survives? (list \"(a 1)\" \"(a :b 1)\" \"(a :b \\\"x\\\")\")))\n(newline)"
     :cs-program "(define (doc-or-error text)\n  (let ((r (slat-load-doc text)))\n    (if (equal? (slat-key r '_form) \"error\") (list 'failed (slat-key r 'message)) (list 'ok (slat-dumps r)))))\n(display (doc-or-error \"(a :s \\\"semi;colon\\\")\"))\n(newline)\n(display (doc-or-error \"(a 1) (b 2)\"))\n(newline)"
     :problem "The operator has a record indented across five lines and wants it back as a value. Candidates: slat-load-doc (joins the lines, which is what is needed), slat-loads (refuses -- newlines inside a form are an error), and slat-load (would try to parse each line separately and produce five failures). slat-load-doc is the only verb that does the job, and it is now strict about the thing it is for: exactly one form."
     :explanation "eng: a five-line reactor record read and three fields pulled. math: for single-line inputs the doc reader and the line reader agree, which is what makes the doc reader a superset rather than a different format. cs: the same wrapper run on a quoted semicolon, which is accepted as data, and on a genuine second form, which is refused by name."
     :meta "Why slat-load-doc and not a hand-written line joiner: a hand-written joiner also has to strip comments, and it therefore has to decide about semicolons inside strings -- which is exactly the decision this verb got wrong for as long as its stripper was a plain search for the first semicolon. If you write your own, make it quote-aware, and carry the state across lines.")
    (:eng "Indented multi-line records are for human editors. The moment the file is machine-generated, one form per line and slat-load is the safer shape."
     :math "Agreement with slat-loads on single-line input is the compatibility claim; it is what lets the two verbs share a format."
     :cs "Related patterns: YAML's block scalars, TOML's multi-line strings, and every INI parser that ever cut a line at a hash inside a value. This is a famous mistake, not a novel one, and it is fixed the same way every time."))
  :row-3-dimension (
    (:setup "A pre-pass that rewrites text before anything understands it. Made structurally blind it is fast, simple, and leaks its rule into the places the rule was never meant to reach; given the one piece of structure it needs -- where quoting starts and stops -- it becomes correct without becoming a parser."
     :rungs ((:domain "io" :code "(display (list (slat-dumps (slat-load-doc \"(a :b \\\"x;y\\\")\"))\n               (slat-dumps (slat-load-doc \"(a :b 1) ; note\"))))\n(newline)")
             (:domain "a redaction clerk with a rule 'black out everything after the first asterisk', applied to a footnote that quotes an asterisk" :code "(define (redact-after line marker)\n  (let loop ((i 0))\n    (cond ((>= i (string-length line)) line)\n          ((equal? (substring line i (+ i 1)) marker) (substring line 0 i))\n          (else (loop (+ i 1))))))\n(display (list (redact-after \"keep this * drop this\" \"*\") (redact-after \"the * is quoted here\" \"*\")))\n(newline)")
             (:domain "function composition where the outer function loses information the inner one needed: g after f is not f after g when f is not injective" :code "(define (strip-then-count s) (string-length (list->string (filter (lambda (c) (not (char=? c #\\;))) (string->list s)))))\n(define (count-then-strip s) (string-length s))\n(display (list (strip-then-count \"a;b\") (count-then-strip \"a;b\")))\n(newline)"))
     :explanation "In io, the comment stripper runs before the tokenizer, and it now tracks quoting, so the semicolon inside the string is kept and the one after the form is cut. The redaction clerk with a purely lexical rule is the version that has NOT learned that distinction, and it makes the mistake this stripper used to make -- right about the common case, blind to the quoted one. Composition order is the algebraic statement: applying a lossy transform first destroys the information the later stage needed. All three share the same lesson about SCOPE: a rule is not made correct by being correct about its own subject, it has to know where it does not apply."
     :meta "The shape transfers to every lexer-before-parser design. The fix is always the same and always the same size: the pre-pass learns just enough structure -- here, that a double quote opens a region where the rule is suspended, and that the region can outlive a line.")
    (:eng "Joining lines is safe; cutting at a character is not. Separate the two jobs, and only the second one needs to know about quoting."
     :math "The two orders disagree exactly on the inputs containing the marker inside a quoted region, which is a small set and never the empty one."
     :cs "This is why real tokenizers are single-pass state machines rather than a stack of regular expressions."))
  :row-4-proof (
    (:eng-program "(define (verdict text)\n  (let ((r (slat-load-doc text)))\n    (if (equal? (slat-key r '_form) \"error\") (list 'refused (slat-key r 'kind)) (list 'read (slat-dumps r)))))\n(display (list (verdict \"(a 1)\") (verdict \"(a 1)\\n(b 2)\") (verdict \"(1 2 3)\")))\n(newline)"
     :math-program "(define (joined-equals-inline? a b)\n  (equal? (slat-dumps (slat-load-doc a)) (slat-dumps (slat-loads b))))\n(display (list (joined-equals-inline? \"(a\\n :b 1)\" \"(a :b 1)\")\n               (joined-equals-inline? \"(a\\n :b\\n 1)\" \"(a :b 1)\")))\n(newline)"
     :cs-program "(define (kept text) (slat-dumps (slat-load-doc text)))\n(display (list 'quoted (kept \"(a :s \\\"x;y\\\")\")\n               'commented (kept \"(a :s \\\"xy\\\") ; note\")))\n(newline)"
     :claim "slat-load-doc joins a multi-line form into the same value the one-line spelling would give; a document holding two or more top-level forms is refused with a slat/multi-form error rather than truncated; and a semicolon inside a string literal is data while one outside a string starts a comment."
     :invariant "For all single-form texts t. slat-load-doc(t) = slat-loads(join-with-spaces(comment-free lines of t))"
     :meta "The pattern is flatten-then-parse. What would falsify the claim: a two-form document that answered a value, a single form like (1 2 3) that was refused for having three elements, or a quoted semicolon that vanished. All three were checked against the running engine. The eng program is the regression test for the guard; the cs program is the regression test for the stripper, and it holds both halves of the rule in one line so neither can be fixed at the other's expense.")
    (:eng "Showing a good form, a refused pair and a bare list side by side is what proves the guard counts FORMS rather than elements."
     :math "The invariant no longer needs a precondition about semicolons, because the join it names is now defined in terms of comment-free lines rather than semicolon-free ones."
     :cs "Testing the quoted and the unquoted semicolon together is deliberate. A stripper can be fixed in one direction alone -- keep everything, or cut everything -- and both single-sided fixes pass a single-sided test."))
  :row-5-emergence (
    (:eng-composition "(define doc \"(cart\\n  :name \\\"pong\\\"\\n  :author \\\"kid\\\"\\n  :lines 84)\")\n(define r (slat-load-doc doc))\n(display (list 'name (slat-key r 'name) 'lines (slat-key r 'lines)))\n(newline)\n(display (slat-dump-doc r))"
     :math-composition "(define (doc-round-trip x) (slat-dumps (slat-load-doc (slat-dump-doc x))))\n(display (list (doc-round-trip (list 1 2 3)) (doc-round-trip \"plain\")))\n(newline)"
     :cs-composition "(define (safe-doc text)\n  (let ((r (slat-load-doc text)))\n    (cond ((equal? (slat-key r '_form) \"error\") (list 'rejected (slat-key r 'message)))\n          (else (list 'accepted (slat-dumps r))))))\n(display (safe-doc \"(cfg :retries 3)\"))\n(newline)\n(display (safe-doc \"(cfg :note \\\"see foo;bar\\\")\"))\n(newline)"
     :base "slat-load-doc flattens a multi-line document and parses the one form out of it."
     :emergent "eng: a cart header read from an indented document and written straight back out. math: dump-doc followed by load-doc is a document round trip, and it holds for the values that survive the flattening. cs: a guarded reader that reports rejection with the parser's own words instead of crashing -- and a note containing a semicolon that is now simply accepted."
     :meta "The composition is dump-doc and load-doc as a pair, and what emerges is the SINGLE-RECORD FILE: one form, one file, editable by a person, readable by a program. Both of this verb's old defects bit exactly where a person's editing habits met the reader -- a second form pasted in below, or a semicolon typed inside a note -- which is why they were worth fixing rather than documenting. A format a person edits has to be safe against the things a person actually types.")
    (:eng "Reading a header and writing it back unchanged is the cheapest possible fidelity test for a file format."
     :math "The round trip holds for plain data; it does not return a keyword-tagged form as a list, for the same reason described under slat-loads."
     :cs "A guarded reader that surfaces the parser's own message beats one that invents its own, because the parser knows where it stopped and the wrapper does not."))
)

(verb
  :name "slat-key" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-key record key) -> value | #f | error-record"
  :summary "Pull one field out of a SLAT record by name. The key may be a symbol, a keyword or a string, all three meaning the same field. An absent field answers #f."
  :explanation "A SLAT record is opaque. It is not a pair, not a list and not an association list -- car, cdr, assoc and list-ref all refuse it, and printing it gives you #<slat-record event>: the type and the record's leading symbol, and none of the fields. That is the same text from display, from write and from the CLI's auto-print. slat-key and slat-dumps are the only two ways in, and slat-key is the one that gives you a field. It accepts the key three ways so that code copied from anywhere works: 'ts, ':ts and \"ts\" all name the field the writer spelled :ts. Two pseudo-fields come free. '_form is the record's leading symbol, returned as a STRING -- (slat-key (slat-loads \"(event :ts 1)\") '_form) is \"event\", not the symbol event -- and '_positional is the list of values that appeared before the first keyword. Those two are how you tell an error record from a good one, and how you reach the arguments a form carried positionally. The absent-field answer is #f, which is the deliberate choice: it makes a default a one-liner and it means a field whose value genuinely IS #f is indistinguishable from a missing one. That ambiguity is the price of not raising, and it is the thing to remember when a boolean field starts behaving oddly."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-key (slat-loads \"(event :ts 1)\") 'ts)" :note "1 -- the field named :ts, addressed with a plain symbol.")
    (:dialect "motoi" :tier "intermediate" :code "(slat-key (slat-loads \"(event :ts 1)\") 'nope)" :note "#f -- an absent field answers #f rather than raising, so a default is one (if ...) away.")
    (:dialect "motoi" :tier "expert" :code "(slat-key (slat-loads \"(a 1 2 :k 3)\") '_positional)" :note "(1 2) -- the values that appeared before the first keyword, as a list. The pseudo-field _form holds the leading symbol as a string.")
  )
  :caveats ("An absent field and a field whose value is #f give the same answer. If that distinction matters, look for the key in _form-tagged data another way or store a sentinel other than #f." "'_form comes back as a STRING, not a symbol. (equal? (slat-key r '_form) \"event\") is the comparison that works; (eq? ... 'event) is not." "Handed something that is not a record -- a list, a number, a string -- it returns an ERROR RECORD, not #f. That record is truthy, so an unguarded if on the result takes the success branch." "It reads fields; it does not set them. SLAT records are read-only from Scheme." "The key comparison is exact. A field written :cart-dir is not reachable as 'cartdir or 'cart_dir." "It works on error records too, which is the point -- (slat-key r 'message) is how you read a parse failure.")
  :usecases ("Reading a named field out of a parsed SLAT record." "Distinguishing a good parse from an error record by testing _form." "Recovering the positional arguments a form carried before its first keyword.")
  :related ("slat-loads" "slat-load" "slat-dumps" "slat-load-doc" "assoc")
  :learn (:concept "An opaque value is one whose only interface is the procedures given for it. When a value refuses car and cdr, that is not a bug -- it is the type telling you which door to use." :prerequisites ("slat-loads" "symbols and keywords") :progression "Parse a form, pull a field you know is there, ask for one that is not, then look at _form and _positional so the record's hidden structure stops being hidden.")
  :provenance "Motoi-own; src/slat-verbs.js slatKeyVerb; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define r (slat-loads \"(alarm :level 3 :zone \\\"west\\\" :ack #f)\"))\n(display (list (slat-key r 'level) (slat-key r 'zone) (slat-key r 'ack)))\n(newline)"
     :math-program "(define r (slat-loads \"(e :k 7)\"))\n(display (list (equal? (slat-key r 'k) (slat-key r ':k))\n               (equal? (slat-key r 'k) (slat-key r \"k\"))\n               (equal? (slat-key r ':k) (slat-key r \"k\"))))\n(newline)"
     :cs-program "(define (field-or r key fallback)\n  (let ((v (slat-key r key)))\n    (if (equal? v #f) fallback v)))\n(define r (slat-loads \"(cfg :retries 3 :verbose #f)\"))\n(display (list 'retries (field-or r 'retries 1)\n               'timeout (field-or r 'timeout 30)\n               'verbose-collides (field-or r 'verbose 'default-used)))\n(newline)"
     :problem "The operator has a parsed record and wants one field. Candidates: slat-key (the only accessor that works), assoc after converting the record to an alist (there is no conversion -- the record is opaque), and car/cdr walking (refused outright). There is exactly one door here, and the real audit question is not which verb but what to do about #f: is a missing field an error, a default, or a legitimate false?"
     :explanation "eng: three fields pulled including one whose real value is #f. math: the three key spellings agree on every field, which is the compatibility claim. cs: the default wrapper, shown together with the case it gets WRONG -- :verbose is present and false, and the wrapper substitutes the default anyway."
     :meta "Why the third clause of the cs program is in the record: a default helper built on (if (equal? v #f) ...) is the natural first thing anyone writes, and it is wrong for boolean fields. Showing the bug next to the helper is cheaper than a caveat nobody reads.")
    (:eng "A record whose boolean fields are optional needs a sentinel other than #f, and that decision belongs to the writer, not the reader."
     :math "Three spellings, one field, agreement on every input -- the key type is a surface convenience and not a semantic distinction."
     :cs "Related patterns: dict.get with a default in Python, hash-table-ref/default in SRFI-125, Map.getOrDefault in Java. Every one of them has the same false-versus-missing hazard."))
  :row-3-dimension (
    (:setup "Addressing by name into an opaque container, where absence has to be given a value because the accessor has promised not to raise."
     :rungs ((:domain "io" :code "(define r (slat-loads \"(e :a 1)\"))\n(display (list (slat-key r 'a) (slat-key r 'b)))\n(newline)")
             (:domain "a hotel pigeonhole wall: you ask for room 12 and get what is there, or nothing, and 'nothing' is itself an answer the clerk hands over" :code "(define wall (list (cons 12 'letter) (cons 14 'parcel)))\n(define (pigeonhole n) (let ((hit (assv n wall))) (if hit (cdr hit) 'empty)))\n(display (map pigeonhole (list 12 13 14)))\n(newline)")
             (:domain "a partial map made total by a default element: dom(f) is widened to everything, and the added points all share one value" :code "(define (total f default keys) (map (lambda (k) (let ((v (f k))) (if (equal? v #f) default v))) keys))\n(define r (slat-loads \"(e :a 1 :b 2)\"))\n(display (total (lambda (k) (slat-key r k)) 'unset (list 'a 'b 'c)))\n(newline)"))
     :explanation "In io, slat-key answers #f for a field the record does not have. A pigeonhole wall does the same -- the clerk always answers, and 'empty' is a real answer rather than a refusal. Totalising a partial map with a default element is the algebra: the domain becomes everything, and every point that was outside the original domain maps to one shared value. All three share: absence is represented, not signalled, and the representation collides with any legitimate value that happens to equal it."
     :meta "The shape transfers to every get-with-default API. The collision is not avoidable in general -- it is avoidable only by picking a default that cannot be a legitimate value, which is why languages with a distinguished 'nothing' type exist.")
    (:eng "Choosing #f as the absence marker is fine until a field is genuinely boolean, and then it is a bug you cannot see."
     :math "The default point is shared by every key outside the original domain, so the totalised map loses the information of WHICH key was missing."
     :cs "Option, Maybe and nullable types all exist to keep 'absent' out of the value space. #f-as-absent is the cheap version and it works right up until it does not."))
  :row-4-proof (
    (:eng-program "(define r (slat-loads \"(e :a 1 :b \\\"two\\\" :c #t)\"))\n(display (map (lambda (k) (slat-key r k)) (list 'a 'b 'c 'missing)))\n(newline)"
     :math-program "(define r (slat-loads \"(e :x 5 :y 6)\"))\n(define (all-spellings-agree k)\n  (and (equal? (slat-key r k) (slat-key r (string->symbol (string-append \":\" (symbol->string k)))))\n       (equal? (slat-key r k) (slat-key r (symbol->string k)))))\n(display (map all-spellings-agree (list 'x 'y 'z)))\n(newline)"
     :cs-program "(define r (slat-loads \"(e :a 1)\"))\n(display (list 'form-is-a-string (equal? (slat-key r '_form) \"e\")\n               'form-is-not-a-symbol (equal? (slat-key r '_form) 'e)\n               'non-record-gives-an-error-record (equal? (slat-key 42 'a) #f)))\n(newline)"
     :claim "slat-key answers the field's value when present and #f when absent; symbol, keyword and string spellings of a key are interchangeable; _form answers a STRING; and a non-record argument answers an error record rather than #f."
     :invariant "For all records r and keys k. slat-key(r, k) = slat-key(r, :k) = slat-key(r, \"k\")"
     :meta "The pattern is name-addressed access with a total interface. What would falsify it: two spellings disagreeing, an absent field raising, or _form answering a symbol. The third clause of the cs program is the one that surprises people -- handing slat-key a number does NOT give #f, it gives a truthy error record, so #f is not a safe universal 'no'.")
    (:eng "Mapping the accessor over a list of keys including a missing one is the cheapest way to see the total interface at work."
     :math "Interchangeability of spellings is checked constructively rather than assumed, by building the other two spellings from the first."
     :cs "The string-versus-symbol answer for _form is exactly the kind of detail that costs an afternoon if it is not written down."))
  :row-5-emergence (
    (:eng-composition "(define rows (slat-load \"(m :name \\\"a\\\" :v 3)\\n(m :name \\\"b\\\" :v 4)\\n(m :name \\\"c\\\" :v 5)\"))\n(display (map (lambda (r) (list (slat-key r 'name) (slat-key r 'v))) rows))\n(newline)"
     :math-composition "(define rows (slat-load \"(m :v 3)\\n(m :v 4)\\n(m :v 5)\"))\n(define (sum-of key) (apply + (map (lambda (r) (slat-key r key)) rows)))\n(display (list 'sum (sum-of 'v) 'count (length rows)))\n(newline)"
     :cs-composition "(define (classify text)\n  (let ((r (slat-loads text)))\n    (cond ((equal? (slat-key r '_form) \"error\") (list 'parse-error (slat-key r 'message)))\n          ((equal? (slat-key r '_form) \"event\") (list 'event (slat-key r 'ts)))\n          (else (list 'other (slat-key r '_form))))))\n(display (classify \"(event :ts 9)\"))\n(newline)\n(display (classify \"(other :x 1)\"))\n(newline)\n(display (classify \"(broken\"))\n(newline)"
     :base "slat-key pulls one named field out of one opaque record."
     :emergent "eng: mapping the accessor across a stream turns records into rows. math: mapping then folding one field gives an aggregate, and it is safe here only because every row has the field. cs: dispatching on _form turns a stream of records into a stream of TAGGED values, which is the shape every message handler wants."
     :meta "The composition is accessor plus map plus dispatch on _form, and what emerges is the MESSAGE PUMP: read records, look at the tag, route on the tag, read the tag-specific fields. Because parse failures also carry a _form, the error case joins the dispatch as just another tag rather than as a separate control path -- which is the whole reason this family returns error records instead of raising.")
    (:eng "Two fields per row and the shape of a table appears without anything table-shaped having been built."
     :math "Folding a field is only defined when every row has it; the tolerant reader guarantees no such thing, so filter by tag first."
     :cs "One dispatch that handles both the good tags and the error tag is smaller and more honest than a try wrapped around a switch."))
)


(verb
  :name "slat-dumps" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-dumps value) -> string | error-record"
  :status "needs-alfred"
  :summary "Serialize one Motoi value to canonical SLAT text and RETURN it as a string. It writes no file. Vectors, dotted pairs and characters still leak their internal shape instead of round-tripping."
  :explanation "slat-dumps is the writer half of the pair whose reader half is slat-loads. Despite the name it does not dump anywhere -- it returns a STRING, and what you do with that string is your business. The output is canonical, which means the same value always gives the same text. For a record the canonical order is: the head symbol, then the positional values, then the keyword fields in a fixed order -- id, ts, kind, from, to first, in exactly that order, followed by every remaining key sorted alphabetically. That rule is why (slat-loads \"(e :b 2 :a 1)\") dumps back as (e :a 1 :b 2) while (incident :id x :body y) keeps :id in front: the second one hit the hint list. A plain Scheme LIST is emitted element by element in the order you wrote it, because a list has no fields to canonicalise. Strings are escaped for backslash, double quote, newline, carriage return and tab; symbols are bare; keywords carry their colon; #t and #f are themselves; an empty or absent value is nil. The marked divergence is on the type coverage. A vector comes out as (:items (1 2)). A dotted pair comes out as (:car 1 :cdr 2). A character comes out as (:value \"a\"). Those are not SLAT encodings of a vector, a pair and a character -- they are the writer falling through to its generic object case and printing Motoi's INTERNAL representation, and nothing reads them back as what they were. Fixing them means adding syntax to the format, which is not a decision a writer gets to make on its own, so they stay marked. Two related gaps have been closed. An exact rational used to be unwritable -- (slat-dumps 1/3) returned an error record reading 'cannot emit bigint' while the READER parsed 1/3 happily, so the two halves of the pair disagreed about the format; it now writes 1/3. And the writer used to emit symbol names it could not read back: a symbol containing a space, a parenthesis, a quote or a semicolon was written bare, so the ONE-symbol list holding `a b` came out as (a b), which reads back as TWO symbols. SLAT has no escape for those characters in a name, so there is no text that would be right; the writer now refuses by name rather than producing text that lies about its own shape."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-dumps (list 1 2 3))" :note "\"(1 2 3)\" -- a plain list is written element by element, in the order you wrote it.")
    (:dialect "motoi" :tier "intermediate" :code "(slat-dumps (slat-loads \"(msg :b 1 :id 9 :a 2 :kind \\\"k\\\")\"))" :note "\"(msg :id 9 :kind \\\"k\\\" :a 2 :b 1)\" -- canonical field order: the hinted keys id, ts, kind, from, to lead in that order, then everything else alphabetically.")
    (:dialect "motoi" :tier "expert" :code "(slat-dumps (vector 1 2))" :note "\"(:items (1 2))\" -- a vector does NOT round-trip. This is Motoi's internal object shape leaking through the writer's generic case, and slat-loads reads it back as a keyword form, not a vector.")
  )
  :caveats ("It returns a string. It does not open, create or write a file, and there is no filename argument anywhere in this family." "Vectors, dotted pairs and characters do not round-trip: they come out as (:items ...), (:car ... :cdr ...) and (:value \"...\") respectively, which are internal shapes and not SLAT types. This is the needs-alfred mark, and closing it means adding syntax to the format." "An exact rational writes as 1/3 and the text is stable, but reading it back gives an opaque SLAT value rather than a Motoi rational, so (equal? (slat-loads \"1/3\") 1/3) is #f. The text round-trips; the value does not." "A symbol whose name holds a space, a parenthesis, a quote or a semicolon is REFUSED, because SLAT has no escape for those in a name. The message names the offending character. It used to be written bare, which produced text that read back as a different shape." "A procedure gives an error record reading 'cannot emit function'. Error records are truthy, so check the result is a string before you store it." "Field order is canonical, not the order you typed. Two records that differ only in field order dump to the identical text -- useful for comparison, surprising if you expected your layout back." "A very large exact integer is written in scientific notation and reads back as an inexact number." "The error record it returns on failure prints as #<slat-record error>, which is how you spot one at a glance -- a good record shows its own leading symbol instead. It still says nothing about what went wrong; read that with (slat-key result 'message).")
  :usecases ("Turning a record or a list into text for storage, comparison or transmission." "Canonicalising two records so they can be compared as strings regardless of the order their fields were written in." "Seeing what is inside an opaque SLAT record, which otherwise prints as #<record>.")
  :related ("slat-write" "slat-dump" "slat-dump-doc" "slat-loads" "slat-key")
  :learn (:concept "A canonical writer is one where equal values always produce identical text. That is what makes text comparison a valid stand-in for value comparison -- and it is why the writer, not the reader, is where field order gets decided." :prerequisites ("slat-loads" "string literals") :progression "Dump a plain list to see order preserved, dump a record to see order canonicalised, then dump a vector to see the type coverage run out.")
  :provenance "Motoi-own; src/slat-verbs.js slatDumpsVerb over bindings/js/slat.js emit/emitForm/orderKeys; key-order hint list ['id' 'ts' 'kind' 'from' 'to']; measured against the live engine 2026-08-02; reference record added 2026-08-02; rational emission and unwritable-name refusal landed 2026-08-02, vector/pair/char coverage still open"
  :row-2-audit (
    (:eng-program "(define reading (slat-loads \"(reading :zone \\\"west\\\" :ts 1200 :value 88)\"))\n(display (slat-dumps reading))\n(newline)"
     :math-program "(define a (slat-loads \"(e :a 1 :b 2)\"))\n(define b (slat-loads \"(e :b 2 :a 1)\"))\n(display (list 'texts-agree (equal? (slat-dumps a) (slat-dumps b))\n               'text (slat-dumps a)))\n(newline)"
     :cs-program "(define (writable? v)\n  (let ((r (slat-dumps v)))\n    (if (string? r) (list 'ok r) (list 'refused (slat-key r 'message)))))\n(display (writable? (list 1 2)))\n(newline)\n(display (writable? car))\n(newline)"
     :problem "The operator wants a record on disk and reaches for something called dumps. Candidates: slat-dumps (returns the text -- you still have to write it somewhere yourself), slat-dump (same, for a list of values, one per line), and slat-dump-doc (same, plus a trailing newline, for a one-form file). None of the three touches the filesystem. Pick by the SHAPE you want: one value inline, many values line-delimited, or one value as a whole document."
     :explanation "eng: a reading dumped, with :ts promoted to the front by the hint list. math: two records differing only in field order produce the identical text -- that is canonicality, stated as an experiment. cs: a wrapper that distinguishes a written string from a refusal, because the refusal is a truthy record and will otherwise be stored as if it were data."
     :meta "Why check (string? r) rather than trusting the result: the failure value here is an error RECORD, not #f and not an exception. Code that writes the result straight to a file will happily write a JavaScript object's toString and discover it days later.")
    (:eng "The one thing to remember is that nothing here writes a file. The verb hands you text; the writing is a separate decision you have not made yet."
     :math "Canonicality means the text is a function of the value alone, which is exactly the property that lets you compare records by comparing strings."
     :cs "Related patterns: json.dumps in Python and JSON.stringify in JavaScript, both of which also return a string and are both routinely mistaken for file writers. The naming convention is inherited, and so is the confusion."))
  :row-3-dimension (
    (:setup "A canonical encoder: a map from values to text chosen so that the text depends on the value and on nothing else -- not on insertion order, not on how the value was built."
     :rungs ((:domain "io" :code "(display (list (slat-dumps (slat-loads \"(e :b 1 :a 2)\"))\n               (slat-dumps (slat-loads \"(e :a 2 :b 1)\"))))\n(newline)")
             (:domain "a librarian filing cards by a fixed scheme, so two librarians handed the same book put the card in the same drawer" :code "(define (file-card title author) (list 'drawer (string-ref author 0) 'title title))\n(display (list (file-card \"dune\" \"herbert\") (file-card \"dune\" \"herbert\")))\n(newline)")
             (:domain "a normal form: one chosen representative per equivalence class, so equality of representatives decides equality of classes" :code "(define (normal-form text) (slat-dumps (slat-loads text)))\n(define variants (list \"(e :a 1 :b 2)\" \"(e :b 2 :a 1)\"))\n(display (list 'same-class (equal? (normal-form (car variants)) (normal-form (cadr variants)))))\n(newline)"))
     :explanation "In io, slat-dumps puts the fields in a fixed order so two records that mean the same thing look the same. A librarian's filing scheme is the same idea made social -- the scheme has to be fixed in advance, or two people file the same book in two drawers and neither is wrong. A normal form is the mathematical version: pick one representative per class, and then equality of representatives decides equality of classes. All three share: the ordering rule is arbitrary, and its value comes entirely from being AGREED, not from being right."
     :meta "The shape transfers to every content-addressed system -- canonical JSON, canonical XML, git's object format. The recurring bug is a canonicaliser that is stable within one version and changes between versions, which silently invalidates every hash ever computed with it.")
    (:eng "The hint list is worth knowing precisely because it is arbitrary: id, ts, kind, from, to lead because a human decided those read best first."
     :math "Two texts equal implies the values are in the same class. The converse needs the encoder to be injective on the class, which it is not for vectors and pairs -- a vector of two and a form written (:items (1 2)) produce the same text."
     :cs "Canonical form is what makes deduplication by hash possible. Change the canonicaliser and every stored hash becomes a lie."))
  :row-4-proof (
    (:eng-program "(define (dump-order text) (slat-dumps (slat-loads text)))\n(display (list (dump-order \"(m :zebra 1 :to \\\"b\\\" :from \\\"a\\\" :apple 2)\")\n               (dump-order \"(m :b 1 :id 9 :a 2)\")))\n(newline)"
     :math-program "(define (stable? text)\n  (let* ((once (slat-dumps (slat-loads text)))\n         (twice (slat-dumps (slat-loads once))))\n    (equal? once twice)))\n(display (map stable? (list \"(e :b 2 :a 1)\" \"(1 2 3)\" \"(m :to \\\"x\\\" :from \\\"y\\\")\")))\n(newline)"
     :cs-program "(define (kind-of v) (let ((r (slat-dumps v))) (if (string? r) r (slat-key r 'message))))\n(display (list 'vector (kind-of (vector 1 2))\n               'pair (kind-of (cons 1 2))\n               'char (kind-of #\\a)\n               'rational (kind-of 1/3)))\n(newline)"
     :claim "Field order in the output depends only on the field names -- hinted keys id, ts, kind, from, to in that order, then the rest alphabetically -- so the encoding is canonical and idempotent; and the writer's type coverage is incomplete for vectors, dotted pairs and characters, which come back as keyword forms rather than as themselves."
     :invariant "For all values v with writable types. slat-dumps(slat-loads(slat-dumps v)) = slat-dumps v"
     :meta "The pattern is canonical encoding with partial type coverage. What would falsify the canonicality claim: two orderings of the same fields giving different text, or a second pass changing the text. What would falsify the coverage claim: a vector coming back as a vector. The cs program is the coverage audit and is the reason for the needs-alfred mark. It once listed four failures; the rational is now written correctly and stays in the program as the control, because a coverage audit with no passing row cannot tell a fixed writer from a broken one.")
    (:eng "Putting both hinted and unhinted examples in one line makes the two-tier ordering rule visible without prose."
     :math "Idempotence after one pass is the practical form of canonicality: normalise once and the text is stable forever."
     :cs "Listing the failing types together, with their actual output and one type that now works, is worth more than a sentence saying coverage is incomplete."))
  :row-5-emergence (
    (:eng-composition "(define rows (slat-load \"(m :v 3)\\n(m :v 4)\"))\n(display (map slat-dumps rows))\n(newline)\n(display (slat-dump rows))"
     :math-composition "(define (same-record? a b) (equal? (slat-dumps (slat-loads a)) (slat-dumps (slat-loads b))))\n(display (list (same-record? \"(e :a 1 :b 2)\" \"(e :b 2 :a 1)\")\n               (same-record? \"(e :a 1)\" \"(e :a 2)\")))\n(newline)"
     :cs-composition "(define (audit-log entries)\n  (slat-dump (map (lambda (e) (slat-loads e)) entries)))\n(display (audit-log (list \"(evt :kind \\\"boot\\\" :ts 1)\" \"(evt :kind \\\"tick\\\" :ts 2)\")))"
     :base "slat-dumps turns one value into one canonical line of SLAT text."
     :emergent "eng: mapping the writer across a stream gives a list of lines, and slat-dump does the joining for you. math: comparing dumps gives a record-equality test that ignores field order, which is the comparison you actually want. cs: read then write then join is an append-only audit log whose lines are canonical and therefore diffable."
     :meta "The composition is writer plus map plus join, and what emerges is the CANONICAL LOG: every entry written the same way regardless of how it was constructed, so a diff between two runs shows real differences and never formatting noise. That property is the whole reason to have a canonical writer, and it is worth the two surprises -- your field order is not preserved, and three types will not survive the trip.")
    (:eng "Mapping the writer and then joining by hand is what slat-dump already does; reach for it rather than rebuilding it."
     :math "Equality-by-dump is a genuine equivalence on the writable types and is undefined on the rest, which is a precondition worth stating out loud."
     :cs "A log whose lines are canonical is a log you can diff, dedupe and hash. One whose lines carry construction order is none of those things."))
)

(verb
  :name "slat-write" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-write value) -> string | error-record"
  :status "needs-alfred"
  :summary "The Book of SLAT's name for slat-dumps, and the SAME procedure object. It does NOT write anything -- no file, no port, no console. It returns a string."
  :explanation "slat-write is bound to the identical procedure as slat-dumps: (eq? slat-write slat-dumps) is #t, so there is one implementation and two names, and every property of slat-dumps holds here without restatement. The name is the hazard and the reason this record exists as more than a pointer. In every other Scheme, write PUTS SOMETHING SOMEWHERE -- R7RS write takes an optional port and emits to it. This slat-write emits to nothing. It builds a string and hands it back, and if you call it for effect the effect does not happen: the record is not saved, the file is not created, and nothing on screen changes. Combined with the fact that a failure returns a truthy error record rather than raising, a program can call slat-write on every record it owns, discard every result, exit 0, and have persisted nothing. That is the needs-alfred mark: the name promises an effect the procedure does not have, and only a rename or a real writer can close it. One footnote survives here that has been closed for slat-read: the procedure is registered under the name slat-dumps, so the engine's structured-call shape [slat-write value] is not unwrapped for it. That was left in place ON PURPOSE. The readers could safely accept both spellings because a reader's argument is a string and can never be a symbol-headed list; a writer's argument can be anything, and (slat-dumps (list 'slat-write 'x)) is a list somebody may legitimately want written. Teaching the wrapper to recognise slat-write as a call would turn that value into a call and write the wrong thing, silently. Positional calls, which is everything in this reference and everything a program types, are unaffected either way."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-write (list 'hello ':who \"world\"))" :note "\"(hello :who \\\"world\\\")\" -- the value came back as TEXT. Nothing was written anywhere; the string is the whole result.")
    (:dialect "motoi" :tier "intermediate" :code "(eq? slat-write slat-dumps)" :note "#t -- one procedure, two names. Everything documented under slat-dumps is true here, including the canonical field order and the three types that do not round-trip.")
    (:dialect "motoi" :tier "expert" :code "(string? (slat-write (list 1 2 3)))" :note "#t -- the return is a string, which is the whole evidence that this verb is a converter and not an output operation. Compare R7RS write, which returns an unspecified value and emits.")
  )
  :caveats ("IT DOES NOT WRITE. No file is created, no port is touched, nothing is printed. If you called it for effect, nothing happened. This is the needs-alfred mark." "It is the same object as slat-dumps, so it inherits every divergence documented there: vectors, dotted pairs and characters still come back as keyword forms rather than as themselves." "Its failure value is a truthy error record, so (if (slat-write v) 'saved 'failed) always says saved." "It is registered under the name slat-dumps, so structured dispatch spelled [slat-write value] is not unwrapped. That is deliberate for a WRITER -- widening the match would turn the value (slat-write x) into a call. Positional calls are unaffected." "There is no port argument and no filename argument. Motoi's base environment has no filesystem verbs in this family at all.")
  :usecases ("Following Book of SLAT code verbatim without renaming the writer." "Converting a value to text at a boundary where the caller, not this verb, decides where the text goes." "Nothing else -- it is slat-dumps.")
  :related ("slat-dumps" "slat-read" "slat-dump" "slat-dump-doc" "write")
  :learn (:concept "A verb's name is a promise about its effect, and when the name and the return type disagree, believe the return type. A procedure that hands you a value did not consume it." :prerequisites ("slat-dumps" "write") :progression "Learn slat-dumps and what it returns, then meet slat-write and notice the return is a string, then compare against R7RS write, whose return is unspecified precisely because its point is the effect.")
  :provenance "Motoi-own; src/slat-verbs.js -- `export const slatWriteVerb = slatDumpsVerb`; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define record (slat-loads \"(save :id 7 :body \\\"note\\\")\"))\n(define text (slat-write record))\n(display (list 'produced-a-string (string? text) 'length (string-length text)))\n(newline)\n(display text)"
     :math-program "(define samples (list (list 1 2) \"s\" 42 (list 'a ':b 1)))\n(display (map (lambda (v) (equal? (slat-write v) (slat-dumps v))) samples))\n(newline)"
     :cs-program "(define (pretend-to-save v) (slat-write v) 'done)\n(define (actually-keep v) (let ((t (slat-write v))) (if (string? t) (list 'kept t) (list 'refused (slat-key t 'message)))))\n(display (pretend-to-save (list 1 2)))\n(newline)\n(display (actually-keep (list 1 2)))\n(newline)"
     :problem "The operator wants the record persisted and the verb is called write. Candidates: slat-write (returns text, saves nothing), slat-dump-doc (returns text with a trailing newline, saves nothing), and any actual file verb -- of which this family has none. The audit answer is uncomfortable and worth stating plainly: nothing in the slat family persists anything. Capture the string and hand it to whatever in your host actually owns the disk."
     :explanation "eng: the record converted, and the proof that what came back is a string of positive length. math: slat-write and slat-dumps agree on every sample, as one procedure must. cs: two functions side by side -- one calls the verb for effect and returns done having done nothing, the other keeps the string. The first is the bug, written out so it can be recognised."
     :meta "Why pretend-to-save is in the record: it is the shape of the bug, and it is three tokens away from the correct version. A reader who has seen those two functions next to each other will not write the first one by accident.")
    (:eng "If a verb returns the interesting value, it did not consume it. That test costs nothing and catches this whole family of mistakes."
     :math "Agreement with slat-dumps over every sample is a consequence of identity, not independent evidence -- it is here to catch a future split."
     :cs "Related patterns: Python's str.replace and sorted, JavaScript's Array.prototype.map -- all pure, all routinely called for effect by someone who expected mutation."))
  :row-3-dimension (
    (:setup "A verb whose name names an effect it does not have: the label was borrowed from a family where the operation was effectful, and the borrowing outlived the effect."
     :rungs ((:domain "io" :code "(define t (slat-write (list 'a ':b 1)))\n(display (list 'returned-a-string (string? t) 'value t))\n(newline)")
             (:domain "a 'print preview' button that renders a page and consumes no paper, sitting next to a 'print' button that does" :code "(define (preview page) (list 'rendered page 'paper-used 0))\n(define (really-print page) (list 'rendered page 'paper-used 1))\n(display (list (preview 'report) (really-print 'report)))\n(newline)")
             (:domain "a pure function mistaken for a command: its type is a to b, and a command's type would be a to unit" :code "(define (pure-shape v) (if (string? (slat-write v)) 'a-to-b 'a-to-unit))\n(define (command-shape v) (if (equal? (display \"\") #f) 'a-to-b 'a-to-unit))\n(display (list (pure-shape (list 1)) 'and-display-returns-unspecified))\n(newline)"))
     :explanation "In io, slat-write converts and returns. A print-preview button renders exactly what printing would render and leaves the paper tray alone -- the two buttons differ only in whether an effect follows the rendering. In types, a pure function has shape a to b and a command has shape a to unit, and reading the shape tells you which you are holding without reading the implementation. All three share: the SHAPE is the honest signal, and the LABEL is the misleading one."
     :meta "The shape transfers wherever a pure and an effectful operation share vocabulary. The reliable tell is the return: an operation that hands back the payload has not disposed of it.")
    (:eng "Preview and print differing only in a side effect is a good design; naming both of them print is not."
     :math "a to b versus a to unit is the entire distinction, and it survives every renaming."
     :cs "This is why effectful procedures conventionally return unspecified -- returning nothing useful is what makes the shape readable at the call site."))
  :row-4-proof (
    (:eng-program "(display (list 'returns-a-string (string? (slat-write (list 1 2)))\n               'and-not-unspecified (equal? (slat-write (list 1 2)) \"(1 2)\")))\n(newline)"
     :math-program "(define samples (list (list 1 2 3) \"text\" 42 #t (list 'e ':k 1)))\n(display (map (lambda (v) (equal? (slat-write v) (slat-dumps v))) samples))\n(newline)"
     :cs-program "(define before (slat-write (list 'probe 1)))\n(define after (slat-write (list 'probe 1)))\n(display (list 'same-answer-twice (equal? before after)\n               'no-state-changed (equal? before \"(probe 1)\")))\n(newline)"
     :claim "slat-write is the same object as slat-dumps, returns a string rather than an unspecified value, produces the same answer on repeated calls, and changes nothing observable."
     :invariant "For all values v. slat-write(v) = slat-dumps(v), and calling it k times has the same observable result as calling it once"
     :meta "The pattern is a pure converter under an effectful name. What would falsify it: a differing answer on the second call, an unspecified return, or a disagreement with slat-dumps. The cs program is the purity test -- same answer twice, nothing changed -- and it is the check that would fail the day somebody makes this verb actually write.")
    (:eng "Testing that the return is a string, rather than testing what the string says, is the check that catches the misuse."
     :math "Idempotence in the observational sense: k calls and one call are indistinguishable, which is exactly what having no effect means."
     :cs "If this verb is ever given a real writing behaviour, the purity test here is the first thing that should break."))
  :row-5-emergence (
    (:eng-composition "(define records (slat-load \"(a :n 1)\\n(b :n 2)\"))\n(define lines (map slat-write records))\n(display lines)\n(newline)\n(display (slat-dump records))"
     :math-composition "(define (round-trip-text text) (slat-write (slat-read text)))\n(display (map round-trip-text (list \"(e :b 2 :a 1)\" \"(1 2 3)\" \"42\")))\n(newline)"
     :cs-composition "(define (bundle records)\n  (let ((texts (map slat-write records)))\n    (if (equal? (length (filter string? texts)) (length texts))\n        (list 'ok (length texts))\n        (list 'refused (length (filter (lambda (t) (not (string? t))) texts))))))\n(display (bundle (slat-load \"(a 1)\\n(b 2)\\n(c 3)\")))\n(newline)"
     :base "slat-write converts one value to canonical SLAT text and returns it."
     :emergent "eng: mapping the writer across records gives lines, which slat-dump would have joined for you. math: read then write is a canonicaliser, which is the same composition described under slat-read. cs: checking that every result is a string turns a batch conversion into a batch that reports refusals instead of silently storing error records."
     :meta "The composition is convert-then-check, and what emerges is the EXPORT GUARD: never treat a converter's output as data until you have confirmed it is the type you asked for. In a family whose failure value is a truthy record, that check is not defensive programming -- it is the only thing standing between a refused conversion and a corrupt file.")
    (:eng "The check costs one filter and turns an invisible failure into a number you can print."
     :math "The count of non-strings is exactly the count of refused values, because the return type is a string or an error record and nothing else."
     :cs "Validate at the boundary, once, on the way out. Anything that gets past the boundary is assumed good by everything downstream, so the boundary is where the checking has to live."))
)

(verb
  :name "slat-dump" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-dump list-of-values) -> string | error-record"
  :summary "Serialize a LIST of values as line-delimited SLAT text, one form per line, with a trailing newline. Returns the text; writes no file. A non-list argument is an error record."
  :explanation "slat-dump is the stream writer, and slat-load is its exact inverse: dump joins one form per line and terminates every line, load splits on lines and parses one form from each. The trailing newline is deliberate and matters -- it is what makes concatenating two dumps produce a valid stream rather than jamming the last form of one against the first form of the next. The argument must be a LIST. Handed a bare value it does not helpfully wrap it; it returns an error record reading 'slat-dump: expected a list of values', which is the right call because a caller who passes one value probably wanted slat-dumps. Each element is written by the same emitter slat-dumps uses, so everything that record says about canonical field order, escaping and the three types that do not round-trip applies to every line here too. One edge worth knowing: an empty list dumps to a single newline, not the empty string, because the join runs over zero lines and the terminator is appended unconditionally. Reading that back with slat-load gives the empty list, so the round trip survives -- but the text is one byte, not zero."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-dump (list (list 'a 1) (list 'b 2)))" :note "\"(a 1)\\n(b 2)\\n\" -- one form per line, and a newline after the last one as well as between them.")
    (:dialect "motoi" :tier "intermediate" :code "(equal? (slat-dump (slat-load \"(b 2)\\n(a 1)\")) \"(b 2)\\n(a 1)\\n\")" :note "#t -- load then dump is a stream round trip, because both verbs agree that the line is the frame.")
    (:dialect "motoi" :tier "expert" :code "(slat-key (slat-dump 42) 'kind)" :note "slat/bad-arg -- a bare value is refused rather than wrapped. Use slat-dumps for one value; slat-dump is for a list of them.")
  )
  :caveats ("The argument must be a list. A bare value gives an error record, not a one-line stream." "The result always ends in a newline, including for a one-element list. Code that compares against text without the terminator will see a spurious difference." "An empty list gives \"\\n\", a single newline -- not the empty string. slat-load reads that back as the empty list, so the round trip holds even though the byte count does not look like it should." "It writes no file. The name is inherited from the same family as slat-dumps and means 'serialize', not 'persist'." "Every line is written by the slat-dumps emitter, so vectors, dotted pairs and characters fail here exactly as they do there -- and one bad element makes the WHOLE call an error record, not just that line." "It is not tolerant the way slat-load is. There is no per-line sentinel on the writing side.")
  :usecases ("Producing an append-only log or data file, one record per line." "Serializing the result of slat-load back to text after filtering or editing it." "Building a stream that another process will read line by line without a full parse.")
  :related ("slat-load" "slat-dumps" "slat-dump-doc" "slat-write" "newline")
  :learn (:concept "A stream format needs a terminator, not a separator: terminate every record and appending a record never requires looking at what came before." :prerequisites ("slat-dumps" "slat-load" "lists") :progression "Dump one value with slat-dumps, then a list with slat-dump, then read it back with slat-load and compare the text to see that the pair are inverses.")
  :provenance "Motoi-own; src/slat-verbs.js slatDumpVerb; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define rows (slat-load \"(tick :n 1)\\n(tick :n 2)\\n(tick :n 3)\"))\n(display (slat-dump rows))"
     :math-program "(define (chars-for k)\n  (string-length (slat-dump (map (lambda (i) (list 'r i)) (list 1 2 3)))))\n(display (list 'text (slat-dump (list (list 'r 1) (list 'r 2) (list 'r 3)))))\n(newline)"
     :cs-program "(define (dump-or-explain v)\n  (let ((r (slat-dump v)))\n    (if (string? r) (list 'ok (string-length r)) (list 'refused (slat-key r 'message)))))\n(display (dump-or-explain (list (list 'a 1))))\n(newline)\n(display (dump-or-explain 42))\n(newline)"
     :problem "The operator has three records and wants them as text. Candidates: slat-dump (one call, line-delimited, terminated), mapping slat-dumps and joining by hand (works, and you will forget the trailing newline), and slat-dump-doc (wrong shape -- it is for one form, not three). slat-dump is the honest verb because the terminator rule is the part people get wrong, and it is the part this verb owns."
     :explanation "eng: three ticks read and written straight back out. math: the text for three records, shown whole, so the terminator after the last line is visible rather than described. cs: a wrapper that reports the refusal message, because a non-list argument produces a truthy error record."
     :meta "Why slat-dump and not a manual join: the manual version separates rather than terminates. It looks identical for the file you tested and breaks the first time somebody concatenates two of them.")
    (:eng "Terminating every line means appending a record is a pure append -- no seek, no rewrite of the previous last line."
     :math "The text length is the sum of the per-line lengths plus one terminator per line, with no separator arithmetic to get wrong."
     :cs "Related patterns: JSON Lines, POSIX text files, and the trailing-newline argument that has run in every codebase since. The reason POSIX won is exactly the appendability."))
  :row-3-dimension (
    (:setup "Terminated framing: every unit ends with an agreed mark, so a unit can be appended without consulting the units before it."
     :rungs ((:domain "io" :code "(display (slat-dump (list (list 'a 1))))\n(display (slat-dump (list (list 'b 2))))")
             (:domain "a receipt printer that feeds the paper after every ticket, so tearing off one ticket never cuts into the next" :code "(define (ticket n) (list 'ticket n 'then 'feed))\n(display (map ticket (list 1 2)))\n(newline)")
             (:domain "a monoid on texts where concatenation of terminated blocks is again a terminated block" :code "(define a (slat-dump (list (list 'a 1))))\n(define b (slat-dump (list (list 'b 2))))\n(display (list 'concat-parses-as (length (slat-load (string-append a b)))))\n(newline)"))
     :explanation "In io, every dumped line ends with a newline, so gluing two dumps together gives a stream that reads as the union of both. A receipt printer that feeds after each ticket is the mechanical version -- the feed is what makes the next tear safe. A monoid is the algebra: terminated blocks are closed under concatenation, with the empty stream as the identity. All three share: the terminator is what makes composition associative and append cheap."
     :meta "The shape transfers to every append-only store. The failure mode is a SEPARATOR-framed format, where concatenating two files produces one malformed record at the seam and everything after it shifts by one.")
    (:eng "Two dumps glued together read as three records only if both were terminated. Test the seam, not the file."
     :math "Closure under concatenation is what the terminator buys, and it is the property the empty-list case has to respect too."
     :cs "This is why every log format that survives contact with real systems is terminated rather than separated."))
  :row-4-proof (
    (:eng-program "(define a (slat-dump (list (list 'a 1))))\n(define b (slat-dump (list (list 'b 2))))\n(display (list 'a-entries (length (slat-load a))\n               'b-entries (length (slat-load b))\n               'glued-entries (length (slat-load (string-append a b)))))\n(newline)"
     :math-program "(define (round-trips? text) (equal? (slat-dump (slat-load text)) text))\n(display (map round-trips? (list \"(a 1)\\n\" \"(a 1)\\n(b 2)\\n\" \"(a 1)\")))\n(newline)"
     :cs-program "(display (list 'empty-list-text (slat-dump (list))\n               'empty-list-length (string-length (slat-dump (list)))\n               'reads-back-empty (length (slat-load (slat-dump (list))))))\n(newline)"
     :claim "slat-dump terminates every line, so concatenating two dumps yields a stream whose entry count is the sum; load after dump is the identity on already-terminated text; and the empty list dumps to a single newline that reads back as the empty list."
     :invariant "For all lists xs, ys. slat-load(slat-dump(xs) ++ slat-dump(ys)) has length |xs| + |ys|"
     :meta "The pattern is terminated framing with a monoid structure. What would falsify it: a glued stream with the wrong entry count, or an untermintated last line. The third program is the edge case -- the empty list, whose text is one byte rather than zero, which is surprising every single time and harmless every single time.")
    (:eng "Checking the glued count rather than the glued text is the test that actually exercises the terminator."
     :math "The round-trip check is #f for text lacking the final newline, which is correct and is why the claim says 'already-terminated'."
     :cs "The empty case is where framing bugs hide, because it is the case nobody writes a test for."))
  :row-5-emergence (
    (:eng-composition "(define incoming (slat-load \"(evt :kind \\\"boot\\\")\\n(oops\\n(evt :kind \\\"tick\\\")\"))\n(define good (filter (lambda (r) (not (equal? (slat-key r '_form) \"_bad-line\"))) incoming))\n(display (slat-dump good))"
     :math-composition "(define (compact text)\n  (slat-dump (filter (lambda (r) (not (equal? (slat-key r '_form) \"_bad-line\"))) (slat-load text))))\n(define dirty \"(a 1)\\n(oops\\n(b 2)\")\n(display (list 'before (length (slat-load dirty)) 'after (length (slat-load (compact dirty)))))\n(newline)"
     :cs-composition "(define (append-entry stream record) (string-append stream (slat-dump (list record))))\n(define s0 \"\")\n(define s1 (append-entry s0 (list 'evt 1)))\n(define s2 (append-entry s1 (list 'evt 2)))\n(display (list 'entries (length (slat-load s2))))\n(newline)\n(display s2)"
     :base "slat-dump turns a list of values into a terminated, line-delimited stream."
     :emergent "eng: read tolerantly, drop the sentinels, write back -- a file repair in three lines. math: the compaction is measurable, before and after, as an entry count. cs: because every dump is terminated, appending an entry is string concatenation and nothing more."
     :meta "The composition is load, filter, dump, and what emerges is the COMPACTION PASS: the standard maintenance operation on any append-only store. It works only because load is tolerant and dump is terminated -- tolerance is what lets you read a damaged file at all, and termination is what lets you write the repaired one back one record at a time.")
    (:eng "A repair that reports how many entries it dropped is a repair somebody will trust enough to run."
     :math "Entry counts before and after are the honest measure of a compaction; byte counts are not, because canonicalisation changes them."
     :cs "Append by concatenation is the cheapest possible writer, and the terminator is the only thing that makes it correct."))
)

(verb
  :name "slat-dump-doc" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(slat-dump-doc value) -> string | error-record"
  :summary "Serialize ONE value as a whole SLAT document: the canonical text plus a trailing newline. It is slat-dumps with a terminator. It does not pretty-print and it does not write a file."
  :explanation "slat-dump-doc is the document writer and the nominal partner of slat-load-doc. What it actually does is small: emit the value exactly as slat-dumps would, then append one newline. That is the whole difference. The SLAT specification permits a document writer to pretty-print -- to break a long form across lines and indent the fields the way every .slat file in this reference is laid out -- but permits is not requires, and this implementation does not. The output is one long line no matter how big the record. Nothing about that is wrong; it is just less than the name suggests, and it means a round trip through slat-load-doc will never reproduce the indentation of a file a person wrote by hand. The trailing newline is the useful part: it makes the output a well-formed one-record file, so concatenating it onto an existing stream works and a reader that expects a terminated final line is satisfied. Everything slat-dumps says about canonical field order, escaping, and the four types that do not round-trip applies here unchanged, because the same emitter does the work."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-dump-doc (list 'incident ':id \"in-1\"))" :note "\"(incident :id \\\"in-1\\\")\\n\" -- the canonical text, plus exactly one newline at the end.")
    (:dialect "motoi" :tier "intermediate" :code "(equal? (slat-dump-doc (list 1 2)) (string-append (slat-dumps (list 1 2)) \"\\n\"))" :note "#t -- the entire difference from slat-dumps is one appended newline. There is no pretty-printing.")
    (:dialect "motoi" :tier "expert" :code "(slat-dumps (slat-load-doc (slat-dump-doc (list 'cfg ':retries 3))))" :note "\"(cfg :retries 3)\" -- write the document, read it back, and the value survives. The LAYOUT does not: what went in as one line comes back as one line, and a hand-indented file would not.")
  )
  :caveats ("It does not pretty-print. A hundred-field record is one very long line, which is legal SLAT and unpleasant to edit." "It writes no file. Like every verb in this family it returns text and leaves the storing to you." "It takes ONE value, not a list. Handed a list it will emit the list as a form, which is probably not the document you meant -- use slat-dump for many records." "Its partner slat-load-doc silently keeps only the first form of a multi-form document, so a file built by concatenating two slat-dump-doc results cannot be read back whole. Use slat-dump plus slat-load for that." "It inherits the slat-dumps type gaps: vectors, dotted pairs, characters and exact rationals do not survive." "The trailing newline is unconditional, so the text always ends in a line break even when the value was empty.")
  :usecases ("Writing a single record as a complete, terminated document." "Producing text that a host process will save as a one-record .slat file." "Normalising a hand-edited document by reading it with slat-load-doc and writing it back.")
  :related ("slat-load-doc" "slat-dumps" "slat-dump" "slat-write" "newline")
  :learn (:concept "A document format and a stream format differ in exactly one decision: whether the file holds one record or many. Everything else -- escaping, ordering, terminators -- is shared." :prerequisites ("slat-dumps" "slat-load-doc") :progression "Dump a value with slat-dumps, then with slat-dump-doc, and compare the two strings to see that the difference is one character.")
  :provenance "Motoi-own; src/slat-verbs.js slatDumpDocVerb; measured against the live engine 2026-08-02 (pretty-printing permitted by the spec, not implemented); reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define cart (slat-loads \"(cart :name \\\"pong\\\" :lines 84 :author \\\"kid\\\")\"))\n(display (slat-dump-doc cart))"
     :math-program "(define samples (list (list 1 2) \"s\" 42 (list 'e ':k 1)))\n(display (map (lambda (v) (equal? (slat-dump-doc v) (string-append (slat-dumps v) \"\\n\"))) samples))\n(newline)"
     :cs-program "(define (doc-round-trip v) (slat-dumps (slat-load-doc (slat-dump-doc v))))\n(display (list (doc-round-trip (list 1 2 3))\n               (doc-round-trip (list 'cfg ':a 1))))\n(newline)"
     :problem "The operator wants one record saved as its own file. Candidates: slat-dump-doc (one value, terminated -- correct), slat-dumps (correct value, no terminator, so the file's last line is unterminated), and slat-dump with a one-element list (also correct, and says 'stream of one' where you meant 'a document'). Pick slat-dump-doc for intent: the shape of the file is part of what you are communicating."
     :explanation "eng: a cart header written as a document. math: over four samples, dump-doc is exactly dumps plus a newline -- the claim checked rather than asserted. cs: the document round trip, on a plain list and on a tagged form, so what survives and what does not is visible together."
     :meta "Why slat-dump-doc and not slat-dumps plus a hand-written newline: they produce identical bytes today. The difference is that one of them says what the file IS, and a reader six months later will act on that.")
    (:eng "One record per file is a real design choice, and the verb that names it is worth using even when a cheaper spelling exists."
     :math "The difference from slat-dumps is a constant one character, independent of the value."
     :cs "Related patterns: a JSON document versus JSON Lines. The bytes overlap for one record and the contract does not."))
  :row-3-dimension (
    (:setup "A document boundary: the agreement that this text is complete in itself -- one unit, terminated, nothing implied before or after."
     :rungs ((:domain "io" :code "(display (list (slat-dump-doc (list 'a 1)) (slat-dumps (list 'a 1))))\n(newline)")
             (:domain "a single-page memo with a footer rule, versus a page torn from a longer report where the text simply stops" :code "(define (memo body) (list body 'footer-rule))\n(define (torn-page body) (list body 'continues))\n(display (list (memo 'notice) (torn-page 'notice)))\n(newline)")
             (:domain "a terminated word in a formal language: the terminator is what makes the word recognisable without lookahead" :code "(define (terminated? s) (equal? (substring s (- (string-length s) 1) (string-length s)) \"\\n\"))\n(display (list (terminated? (slat-dump-doc (list 'a 1))) (terminated? (slat-dumps (list 'a 1)))))\n(newline)"))
     :explanation "In io, the trailing newline says the document is finished. A memo with a footer rule says the same thing typographically -- you know you have the whole thing, where a torn page leaves you wondering. A terminated word in a formal language is the version that matters to a parser: with a terminator, the reader knows the word ended without having to look at what comes next. All three share: completeness is CLAIMED by a mark, and a reader that does not see the mark is entitled to wait for more."
     :meta "The shape transfers to every framing decision. The subtle cost is that a terminator makes the empty document non-empty, which is why the empty case is always the one that breaks a naive comparison.")
    (:eng "The terminator is one byte and it is what lets a reader say 'done' instead of 'so far'."
     :math "Terminated words are recognisable without lookahead, which is the formal statement of why streaming readers prefer them."
     :cs "A file that does not end in a newline is the reason half the diffs in the world have a 'no newline at end of file' marker."))
  :row-4-proof (
    (:eng-program "(define t (slat-dump-doc (list 'a 1)))\n(display (list 'ends-with-newline (equal? (substring t (- (string-length t) 1) (string-length t)) \"\\n\")\n               'exactly-one-more-char (= (string-length t) (+ 1 (string-length (slat-dumps (list 'a 1)))))))\n(newline)"
     :math-program "(define samples (list (list 1 2) 42 \"s\" (list 'e ':k 1) (list)))\n(display (map (lambda (v) (= (string-length (slat-dump-doc v)) (+ 1 (string-length (slat-dumps v))))) samples))\n(newline)"
     :cs-program "(define (survives? v) (equal? (slat-dumps (slat-load-doc (slat-dump-doc v))) (slat-dumps v)))\n(display (map survives? (list (list 1 2 3) (list 'e ':a 1) \"text\" 42)))\n(newline)"
     :claim "slat-dump-doc emits exactly slat-dumps' text plus one newline, for every writable value; and the value -- though not the layout -- survives a round trip through slat-load-doc."
     :invariant "For all writable values v. |slat-dump-doc(v)| = |slat-dumps(v)| + 1"
     :meta "The pattern is terminate-and-return. What would falsify it: a length difference other than one, which is what pretty-printing would produce. That is the point of the length test -- it is the check that will fail the day somebody implements the indentation the spec permits, and at that moment this record has to be rewritten.")
    (:eng "A length check is a cheap and complete test for 'exactly one character was added'."
     :math "The relation is a constant offset over every sample including the empty list, which is the case a proportional formula would get wrong."
     :cs "Writing the test against the property the spec leaves optional is how you find out the day the option is exercised."))
  :row-5-emergence (
    (:eng-composition "(define cfg (slat-loads \"(cfg :retries 3 :verbose #t)\"))\n(define doc (slat-dump-doc cfg))\n(define back (slat-load-doc doc))\n(display (list 'retries (slat-key back 'retries) 'verbose (slat-key back 'verbose)))\n(newline)\n(display doc)"
     :math-composition "(define (normalise text) (slat-dump-doc (slat-load-doc text)))\n(display (list (normalise \"(e :b 2 :a 1)\") (normalise (normalise \"(e :b 2 :a 1)\"))))\n(newline)"
     :cs-composition "(define one (slat-dump-doc (list 'a 1)))\n(define two (slat-dump-doc (list 'b 2)))\n(display (list 'concatenated-reads-as-one-doc (slat-dumps (slat-load-doc (string-append one two)))\n               'but-as-a-stream (length (slat-load (string-append one two)))))\n(newline)"
     :base "slat-dump-doc writes one value as a complete, terminated document."
     :emergent "eng: write the config, read it back, and the fields are still there. math: load-doc then dump-doc is a normaliser, and it is idempotent -- normalising twice changes nothing. cs: two documents glued together read as ONE document, losing the second, but read as TWO entries through the stream pair."
     :meta "The composition is document-write then document-read, and what emerges is the trap worth naming: CONCATENATING DOCUMENTS DOES NOT PRODUCE A DOCUMENT. The stream pair (slat-dump / slat-load) is closed under concatenation; the document pair is not, because slat-load-doc keeps only the first form. If you are appending, you are working with a stream, so use the stream verbs -- the third program shows the same bytes read correctly by one pair and truncated by the other.")
    (:eng "A config that round-trips through write and read is a config you can regenerate, diff and check in."
     :math "Idempotence of the normaliser is what makes it safe to run on already-normal input, which is most of the time."
     :cs "One byte-sequence, two readers, two different answers. Choosing the reader is choosing the contract."))
)

(verb
  :name "print" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(print value) -> unspecified"
  :summary "Display one value to the current output port with no line break. An alias of display, offered because print is the word most learners arrive with."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(with-output-to-string (lambda () (print \"hi\")))" :note "\"hi\" -- the characters went to the output, and nothing else did. No line break, no quotes around the string.")
    (:dialect "motoi" :tier "intermediate" :code "(with-output-to-string (lambda () (print 1) (print 2) (print 3)))" :note "\"123\" -- three calls, three values, one line. print does not separate and does not terminate; that is what newline and println are for.")
    (:dialect "motoi" :tier "expert" :code "(equal? (with-output-to-string (lambda () (print (list 1 \"two\" 'three)))) (with-output-to-string (lambda () (display (list 1 \"two\" 'three)))))" :note "#t -- print is display. The string inside the list appears WITHOUT quotes under both, which is the display convention and not the write convention.")
  )
  :explanation "print exists for one reason: a learner coming from Python, Racket or almost anywhere else types print, and Motoi would rather answer than correct. It calls display -- the human-facing printer, the one that shows a string as its characters rather than as a quoted literal -- and it adds nothing. It does NOT append a line break, which is the single thing about it that surprises people, because the print they came from usually does. That is why println exists next to it. It takes exactly one value and has no port argument: display's optional second argument is not threaded through, so print always goes to the current output port. If you need to print to a string port, use display directly. The return is unspecified, so print is called for its effect and never for its value -- putting one inside a list prints during evaluation and leaves a gap where the value would be."
  :caveats ("It does NOT add a line break. Consecutive prints run together on one line. Use println, or follow with newline." "It takes ONE argument. (print \"a\" \"b\") is not a two-value print; the second argument is not displayed. Call it twice." "There is no port argument. display's optional port is not threaded through, so print cannot be aimed at a string port -- use display for that." "It uses the display convention, not the write convention: a string prints as its characters, with no quotes and no escapes. Use write when you need re-readable output." "Its return is unspecified, so it prints as nothing inside a list -- the output lands before the list, which reads like a bug." "It lives in the media library, so it is present in every normal Motoi session but is not part of R7RS-small and will not exist in another Scheme.")
  :usecases ("A learner's first output call, before display has been met." "Quick tracing inside a loop where the line break would be noise." "Building one line out of several pieces, then ending it with newline.")
  :related ("println" "display" "write" "newline" "with-output-to-string")
  :learn (:concept "Output has two conventions: one for people, which shows a string's characters, and one for programs, which shows a string as a re-readable literal. print picks the human one." :prerequisites ("display") :progression "Meet print, notice output runs together, meet newline, then meet println which is the two of them bound into one call.")
  :provenance "Motoi-own; lib/media/media.js -- `def('print', (v) => _display(v))`, a direct alias of display; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (status name value)\n  (print name) (print \": \") (print value) (newline))\n(status \"fuel\" 88)\n(status \"heat\" 21)"
     :math-program "(define (chars-for n)\n  (string-length (with-output-to-string (lambda () (let loop ((i 0)) (if (< i n) (begin (print \"x\") (loop (+ i 1)))))))))\n(display (map chars-for (list 0 1 3 7)))\n(newline)"
     :cs-program "(define (same-as-display? v)\n  (equal? (with-output-to-string (lambda () (print v)))\n          (with-output-to-string (lambda () (display v)))))\n(display (map same-as-display? (list \"str\" 42 (list 1 2) 'sym #t)))\n(newline)"
     :problem "The operator wants a labelled value on the console. Candidates: print three times plus newline (explicit, and the pieces stay on one line), println once with a pre-built string (one call, needs string-append), and display plus newline (identical to print plus newline, under the standard name). For a line assembled from pieces, print is the right grain -- one call per piece, and one newline at the end."
     :explanation "eng: a two-line status report built three pieces at a time. math: n calls put exactly n characters into the capture, because print adds nothing of its own. cs: print and display agree on every value type tried, which is the alias claim checked rather than asserted."
     :meta "Why print rather than display: they are the same procedure's behaviour, so the choice is audience. Code a beginner will read is better with print; code that must run in another Scheme must use display, because print will not be there."
    )
    (:eng "Assembling a line from pieces is what print is for; if you find yourself calling it once per line, you wanted println."
     :math "Emission is additive and print contributes nothing beyond the value's own characters."
     :cs "Related patterns: Python's print(end=''), C's printf without a newline, Racket's display. Motoi's print is the Racket one, not the Python one."))
  :row-3-dimension (
    (:setup "An unterminated emitter: it contributes characters to a stream and makes no claim about where the line ends."
     :rungs ((:domain "io" :code "(display (with-output-to-string (lambda () (print 'a) (print 'b) (print 'c))))\n(newline)")
             (:domain "a rubber stamp pressed repeatedly along a sheet: each impression adds ink and none of them decides where the row ends" :code "(define (stamp-row n) (list->string (map (lambda (i) #\\*) (list 1 2 3))))\n(display (stamp-row 3))\n(newline)")
             (:domain "concatenation in a free monoid: the operation appends and introduces nothing, so the length of the whole is the sum of the parts" :code "(define (emitted . vs)\n  (string-length (with-output-to-string (lambda () (for-each print vs)))))\n(display (list (emitted \"ab\" \"cde\") (+ 2 3)))\n(newline)"))
     :explanation "In io, print appends a value's characters and stops. A rubber stamp does the same on paper -- each press adds a mark and the row's end is a decision made by the hand, not by the stamp. Concatenation in a free monoid is the algebra: the operation introduces no extra symbols, so lengths add exactly. All three share: the operation is PURE APPEND, and structure has to come from somewhere else."
     :meta "The shape transfers wherever emission and framing are separate concerns. Combining them -- a print that always breaks the line -- is convenient and costs you the ability to build a line from pieces.")
    (:eng "Three prints and one newline is the shape of every line assembled from parts."
     :math "Lengths adding exactly is the test that the emitter introduces nothing, and it is falsified the moment a separator is added."
     :cs "Languages that made print terminate by default all ended up adding an end= or a print! variant. Separating the concerns first is cheaper."))
  :row-4-proof (
    (:eng-program "(define (capture-n n)\n  (with-output-to-string (lambda () (let loop ((i 0)) (if (< i n) (begin (print \"ab\") (loop (+ i 1))))))))\n(display (map (lambda (n) (= (string-length (capture-n n)) (* 2 n))) (list 0 1 4 9)))\n(newline)"
     :math-program "(define (no-break? v)\n  (let ((s (with-output-to-string (lambda () (print v)))))\n    (not (equal? s (string-append s \"\\n\")))))\n(define captured (with-output-to-string (lambda () (print 'x) (print 'y))))\n(display (list 'captured captured 'length (string-length captured)))\n(newline)"
     :cs-program "(define vs (list \"str\" 42 (list 1 \"two\") 'sym #t))\n(display (map (lambda (v) (equal? (with-output-to-string (lambda () (print v)))\n                                  (with-output-to-string (lambda () (display v))))) vs))\n(newline)"
     :claim "print emits exactly what display emits, adds no line break and no separator, and n calls contribute exactly n times the per-call character count."
     :invariant "For all values v and n >= 0. |capture(print v, n times)| = n * |capture(display v)|"
     :meta "The pattern is a pure appending emitter. What would falsify it: a capture longer than the sum, which is what a hidden separator or terminator would produce. The second program is the direct evidence -- two prints of one character each give a two-character capture with no break between them.")
    (:eng "The zero-call case is the control and is the one a length-based test passes for the wrong reason without it."
     :math "Exact multiplication rather than mere monotonicity is the strong form of the claim, and it is what rules out a trailing separator."
     :cs "Comparing against display rather than against a literal means the test still holds if display's own conventions change."))
  :row-5-emergence (
    (:eng-composition "(define (println-here x) (print x) (newline))\n(define (bar label n)\n  (print label) (print \" \")\n  (let loop ((i 0)) (if (< i n) (begin (print \"#\") (loop (+ i 1)))))\n  (newline))\n(bar \"fuel\" 8)\n(bar \"heat\" 3)"
     :math-composition "(define (row cells)\n  (with-output-to-string (lambda () (for-each (lambda (c) (print c) (print \" \")) cells))))\n(display (list (row (list 1 2 3)) (string-length (row (list 1 2 3)))))\n(newline)"
     :cs-composition "(define (trace-map f xs)\n  (map (lambda (x) (print \"[\") (print x) (print \"]\") (f x)) xs))\n(define out (with-output-to-string (lambda () (trace-map (lambda (x) (* x x)) (list 1 2 3)))))\n(display (list 'trace out))\n(newline)"
     :base "print puts one value's characters into the output stream."
     :emergent "eng: pairing print with newline gives println, and repeating print gives a bar chart -- both from the same one-value verb. math: interleaving print with a separator gives a row renderer whose length is predictable. cs: printing inside a map gives an inline trace that does not disturb the map's result."
     :meta "The composition is print plus a framing decision, and what emerges is the RENDERER: bars, rows, traces and tables are all the same move -- emit pieces, insert framing, terminate. print is deliberately the smallest possible piece of that, which is why it composes into all of them. A print that terminated its own line could build none of them.")
    (:eng "A bar chart out of a loop and a hash character is the cheapest visualisation in the language."
     :math "Row length is cells times width plus separators, and it is checkable because print adds nothing."
     :cs "Tracing inside a map without changing the map's value is the classic use for an emitter whose return is unspecified."))
)

(verb
  :name "println" :std "Motoi"
  :library "io"
  :tier "core"
  :kind "io"
  :signature "(println [value]) -> unspecified"
  :summary "Display one value and then a line break. Called with no argument it emits just the break. This is what most learners mean by 'print'."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(with-output-to-string (lambda () (println \"hi\")))" :note "\"hi\\n\" -- the value, then exactly one line break. That break is the whole difference from print.")
    (:dialect "motoi" :tier "intermediate" :code "(with-output-to-string (lambda () (println)))" :note "\"\\n\" -- with no argument it emits the break alone, so (println) is a blank line and is the same as (newline).")
    (:dialect "motoi" :tier "expert" :code "(string-length (with-output-to-string (lambda () (println 'a) (println 'b))))" :note "4 -- two values and two breaks. Each call terminates its own line, so lines never run together the way consecutive prints do.")
  )
  :explanation "println is print followed by newline, bound into one call, and it is the verb a learner actually wants when they say print. The implementation is exactly that: if a value was supplied it is displayed, and then a line break is emitted unconditionally. The optional argument is the detail worth knowing -- (println) with nothing at all emits just the break, which makes it a drop-in for newline and gives you a blank line without a stray empty string. Because the display happens first and the break second, every call ends its own line, so a sequence of printlns is a sequence of lines with no bookkeeping. The return is the newline's return, which is unspecified, so like print this is called for its effect. It shares print's limits: one value only, no port argument, and the display convention rather than the write convention, so a string appears as its characters without quotes. And like print it is a Motoi convenience, not standard Scheme -- code that must run elsewhere should spell it display plus newline."
  :caveats ("It takes at most ONE value. (println \"a\" \"b\") does not print both -- call it twice, or string-append first." "There is no port argument. To write a terminated line into a string port, use (display x p) followed by (newline p)." "It uses the display convention: a string appears as its characters, unquoted. Use write plus newline for re-readable output." "Its return is unspecified, so it prints as nothing inside a list, and the line lands before the list does." "Called with no argument it is exactly newline -- useful, and worth knowing so you do not write (println \"\") for a blank line, which does the same thing more slowly." "It is a Motoi convenience from the media library, not R7RS-small. Portable code writes display followed by newline.")
  :usecases ("Printing one value per line, which is the majority of all console output." "Emitting a blank line by calling it with no argument." "A learner's default output verb, before the display/newline pair has been met.")
  :related ("print" "newline" "display" "write" "with-output-to-string")
  :learn (:concept "Two verbs used together often enough become one verb. The bundled version is more convenient and less composable, and both versions are worth having." :prerequisites ("print" "newline") :progression "Print without a break and watch output run together, add newline by hand, then meet println and recognise it as those two calls bound into one.")
  :provenance "Motoi-own; lib/media/media.js -- display when an argument is supplied, then newline unconditionally; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (report rows)\n  (for-each (lambda (r) (println r)) rows))\n(report (list \"fuel 88\" \"heat 21\" \"load 3\"))"
     :math-program "(define (lines-for n)\n  (string-length (with-output-to-string (lambda () (let loop ((i 0)) (if (< i n) (begin (println) (loop (+ i 1)))))))))\n(display (map lines-for (list 0 1 2 5)))\n(newline)"
     :cs-program "(define bundled (with-output-to-string (lambda () (println \"x\"))))\n(define by-hand (with-output-to-string (lambda () (display \"x\") (newline))))\n(display (list 'identical (equal? bundled by-hand) 'text bundled))\n(newline)"
     :problem "The operator wants one value per line. Candidates: println (one call), print plus newline (two calls, identical output), and display plus newline (two calls, portable). println wins on brevity for a Motoi-only program and loses on portability -- the moment the code has to run in another Scheme, the two-call spelling is the one that survives."
     :explanation "eng: three rows, three lines, one verb. math: n argument-less calls give exactly n characters, so the bare form really is just the break. cs: the bundled call and the hand-written pair produce byte-identical output, which is the claim that println is not doing anything extra."
     :meta "Why println rather than the pair: fewer tokens, and the framing decision is made once at the call rather than twice. Why the pair rather than println: it exists in every Scheme. Neither answer is always right, and the deciding question is whether this code will ever leave Motoi.")
    (:eng "One value per line is the shape of nearly all console output, and a verb for it removes a whole class of missing-newline bugs."
     :math "n bare calls give n characters, which is the statement that the optional argument really is optional and contributes nothing when absent."
     :cs "Related patterns: Java's System.out.println, Python's print, Racket's displayln. Motoi's is Racket's, name and behaviour."))
  :row-3-dimension (
    (:setup "A bundled operation: two steps that almost always occur together, given a single name, trading composability for the elimination of a forgetting-step bug."
     :rungs ((:domain "io" :code "(display (list (with-output-to-string (lambda () (println \"x\")))\n               (with-output-to-string (lambda () (display \"x\") (newline)))))\n(newline)")
             (:domain "a stapler that folds and staples in one motion, versus folding by hand and stapling separately" :code "(define (fold-then-staple sheets) (list 'folded sheets 'stapled sheets))\n(define (one-motion sheets) (list 'folded sheets 'stapled sheets))\n(display (equal? (fold-then-staple 3) (one-motion 3)))\n(newline)")
             (:domain "function composition given a name: h = g after f, so h is not new power, it is a shorter way to say a sequence you kept saying" :code "(define (f x) (* x 2))\n(define (g x) (+ x 1))\n(define (h x) (g (f x)))\n(display (map (lambda (x) (equal? (h x) (g (f x)))) (list 0 1 5)))\n(newline)"))
     :explanation "In io, println is display composed with newline and given a name. A stapler that folds and staples in one motion does the same two jobs in the same order and removes the chance of stapling an unfolded sheet. Naming a composition h = g after f is the algebra: h adds no power, it adds a shorter name for a sequence you were writing anyway. All three share: the bundle is strictly less general than the parts, and that is the trade you are making on purpose."
     :meta "The shape transfers to every convenience wrapper. The cost surfaces when you need the parts separately -- to send the value to one port and the break to another, or to print three pieces before the line ends -- and at that moment you reach back for print and newline.")
    (:eng "The bundled version is byte-identical to the pair, so switching between them is never a behaviour change."
     :math "Naming a composition is definitional, not constructive: nothing became possible that was not possible before."
     :cs "Every standard library grows these. The good ones keep the parts public, which is why print and newline are both still here."))
  :row-4-proof (
    (:eng-program "(define (capture-lines n)\n  (with-output-to-string (lambda () (let loop ((i 0)) (if (< i n) (begin (println \"ab\") (loop (+ i 1))))))))\n(display (map (lambda (n) (= (string-length (capture-lines n)) (* 3 n))) (list 0 1 4 9)))\n(newline)"
     :math-program "(define bare (with-output-to-string (lambda () (println))))\n(define breaking (with-output-to-string (lambda () (newline))))\n(display (list 'bare-println-equals-newline (equal? bare breaking) 'length (string-length bare)))\n(newline)"
     :cs-program "(define vs (list \"str\" 42 (list 1 \"two\") 'sym))\n(display (map (lambda (v) (equal? (with-output-to-string (lambda () (println v)))\n                                  (with-output-to-string (lambda () (display v) (newline))))) vs))\n(newline)"
     :claim "println emits the value's display text followed by exactly one line break; called with no argument it emits only the break and is indistinguishable from newline; and n calls contribute exactly n times the per-call character count."
     :invariant "For all values v. capture(println v) = capture(display v) ++ \"\\n\""
     :meta "The pattern is a terminating emitter built by composition. What would falsify it: a capture longer than value plus one, which is what a separator or a doubled break would give. The second program is the one that pins the no-argument case, which is the part of the signature people do not expect to exist.")
    (:eng "Three characters per call for a two-character value is the arithmetic that proves exactly one break was added."
     :math "The zero case again is the control -- without it, a formula that multiplies passes for the wrong reason."
     :cs "Testing the bundle against the hand-written pair, rather than against a literal, keeps the test honest if display's conventions ever move."))
  :row-5-emergence (
    (:eng-composition "(define (banner title)\n  (println title)\n  (println (make-string (string-length title) #\\-)))\n(banner \"fuel report\")\n(println (list 'tank 88))\n(println)\n(println \"done\")"
     :math-composition "(define (table rows)\n  (with-output-to-string (lambda () (for-each println rows))))\n(define t (table (list \"ab\" \"cd\" \"ef\")))\n(display (list 'chars (string-length t) 'expected (* 3 3)))\n(newline)"
     :cs-composition "(define (log-lines entries)\n  (with-output-to-string (lambda () (for-each (lambda (e) (println (slat-dumps e))) entries))))\n(define text (log-lines (slat-load \"(evt :n 1)\\n(evt :n 2)\")))\n(display (list 'entries (length (slat-load text))))\n(newline)\n(display text)"
     :base "println emits one value and ends its line."
     :emergent "eng: a banner, a value and a blank line -- four calls, and the blank one is println with nothing. math: mapping println over rows gives a table whose character count is rows times width plus one break each. cs: printing slat-dumps output line by line produces a stream that slat-load reads straight back."
     :meta "The composition is println over a sequence, and what emerges is the LINE-DELIMITED STREAM -- the same shape slat-dump produces, arrived at from the console side rather than the serialization side. That convergence is the point: one value per line with a terminator after each is simultaneously the most readable console output and the most appendable file format, which is why so much of computing settled on it.")
    (:eng "A blank line from an argument-less call is the small thing that stops output looking cramped."
     :math "Character counts are exact because every call adds one break and nothing else."
     :cs "Console output and a JSON-lines file are the same format viewed through different sinks, and println is the verb that makes that visible."))
)
