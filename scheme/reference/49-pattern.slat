;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library pattern — 1 verb.")

(chapter :number "49" :library "pattern" :verb-count 1 :training-eligible #t)

(verb :name "pattern/clave" :std "Motoi" :library "pattern" :tier "core" :kind "pure" :signature "(pattern/clave [direction]) -> record"
  :summary "Return a son-clave rhythm pattern (2-3 or 3-2) as a descriptor."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(pattern/clave)" :note "Default 2-3 clave (five hits in 16 beats).")
    (:dialect "motoi" :tier "intermediate" :code "(pattern/clave '3-2)" :note "3-2 clave (reversed pattern) — different feel for salsa vs son.")
    (:dialect "motoi" :tier "expert"       :code "(define (dual-clave-map) (list (pattern/clave '2-3) (pattern/clave '3-2)))\n(dual-clave-map)" :note "Build both directions for a call-and-response pattern."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (drum-hits) (pattern/clave))\n(drum-hits)"
     :math-program "(define (five-hit-map dir) (assoc :map (pattern/clave dir)))\n(five-hit-map '2-3)"
     :cs-program "(define (safe-clave dir) (if (member dir (list '2-3 '3-2)) (pattern/clave dir) (error 'bad-direction)))\n(safe-clave '2-3)"
     :problem "Rhythmic scheduling needs a canonical five-hit pattern; hardcoding drops the model's pattern-name reference."
     :explanation "eng: hit source. math: hit map extraction. cs: enum validation."
     :meta "Reach for pattern/clave and NOT hand-coding: named patterns are training-data anchors.")
    (:eng "Named patterns compose in choreography." :math "Discrete hit-index set." :cs "Enum-validated selector."))
  :row-3-dimension (
    (:setup "Named-pattern descriptor."
     :rungs (
       (:domain "engineering"  :code "(pattern/clave)")
       (:domain "mathematics"  :code "(pattern/clave '2-3)")
       (:domain "cs / dispatch" :code "(define (five-hit-map dir) (assoc :map (pattern/clave dir)))\n(five-hit-map '2-3)"))
     :explanation "Rhythm engineering, math direction params, parsed dispatch."
     :meta "Named-pattern is a universal shape.")
    (:eng "Rhythm patterns compose vertically with parts and horizontally with time." :math "Discrete pulse set." :cs "Enum dispatch."))
  :row-4-proof (
    (:eng-program "(define (deterministic? dir) (equal? (pattern/clave dir) (pattern/clave dir)))\n(deterministic? '2-3)"
     :math-program "(define (five-hits? dir) (= 5 (length (assoc :map (pattern/clave dir)))))\n(five-hits? '2-3)"
     :cs-program "(define (dual-shape-different? ) (not (equal? (pattern/clave '2-3) (pattern/clave '3-2))))\n(dual-shape-different?)"
     :claim "pattern/clave is pure; 2-3 and 3-2 differ; each has exactly 5 hits."
     :invariant "∀ d ∈ {2-3, 3-2}. length(hits(pattern/clave(d))) = 5 ∧ pattern/clave(2-3) ≠ pattern/clave(3-2)"
     :meta "Pattern: named enum-descriptor.")
    (:eng "Deterministic patterns are safe to memoize." :math "Five is the canonical clave hit count." :cs "Enum dispatch preserves distinctness."))
  :row-5-emergence (
    (:eng-composition "(define (schedule-clave-beats dir) (assoc :map (pattern/clave dir)))\n(schedule-clave-beats '2-3)"
     :math-composition "(define (interleave-claves) (let ((a (pattern/clave '2-3)) (b (pattern/clave '3-2))) (list :a a :b b)))\n(interleave-claves)"
     :cs-composition "(define (safe-dispatch dir handler) (if (member dir (list '2-3 '3-2)) (handler (pattern/clave dir)) (error 'bad-dir)))\n(safe-dispatch '2-3 (lambda (p) p))"
     :base "pattern/clave is a named rhythm descriptor."
     :emergent "Compositions: eng scheduling, math interleaving, cs safe dispatch."
     :meta "Family: named-pattern composition.")
    (:eng "Scheduling drives choreography." :math "Interleaving two claves generates cross-rhythm." :cs "Safe dispatch enforces pattern enum."))
)
