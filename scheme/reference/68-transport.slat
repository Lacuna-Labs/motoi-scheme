;;; 68-transport.slat — Motoi Scheme Reference · Chapter 68 · library transport
;;;
;;; 2 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library transport — 2 verbs.")

(chapter :number "68" :library "transport" :verb-count 2 :training-eligible #t)

(verb :name "transport/tempo" :std "Motoi" :library "transport" :tier "core" :kind "state-change" :signature "(transport/tempo bpm) -> null"
  :summary "Set the shared transport BPM (beats per minute) across all synchronized playback."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(transport/tempo 120)" :note "Retune the shared clock to 120 BPM.")
    (:dialect "motoi" :tier "intermediate" :code "(define (nudge-up) (transport/tempo (+ (transport/bpm) 10)))\n(nudge-up)" :note "Read current BPM and increment.")
    (:dialect "motoi" :tier "expert"       :code "(define (sync-to-track track-meta) (let ((bpm (cadr (assoc :bpm track-meta)))) (transport/tempo bpm) bpm))\n(sync-to-track (list (list :bpm 128)))" :note "Extract BPM from track metadata and lock the shared clock."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (retune-to-track bpm) (transport/tempo bpm) (list 'retuned bpm))\n(retune-to-track 128)"
     :math-program "(define (broadcast-bpm bpm) (transport/tempo bpm) (list :bpm bpm :propagates-to 'all-beat-locked))\n(broadcast-bpm 120)"
     :cs-program "(define (safe-tempo bpm) (if (and (number? bpm) (> bpm 0)) (transport/tempo bpm) (error 'need-positive-number)))\n(safe-tempo 120)"
     :problem "Two subsystems fell out of sync (drums at 128, animation at 120); one authoritative BPM fixes both."
     :explanation "eng: retune source of truth. math: fanout broadcast. cs: input-validated setter."
     :meta "Reach for transport/tempo and NOT audio/tempo: transport is the shared clock; audio/tempo is per-channel only.")
    (:eng "Shared clock retunes all followers." :math "Broadcast fanout to k subscribers." :cs "Validated global write."))
  :row-3-dimension (
    (:setup "Master-clock broadcast: one source publishes the rate, subscribers retune."
     :rungs (
       (:domain "engineering"  :code "(transport/tempo 120)")
       (:domain "mathematics"  :code "(define (broadcast-bpm bpm) (transport/tempo bpm) (list :bpm bpm :propagates-to 'all-beat-locked))\n(broadcast-bpm 120)")
       (:domain "cs / dispatch" :code "(define (broadcast-bpm bpm) (transport/tempo bpm) (list :bpm bpm :propagates-to 'all-beat-locked))\n(broadcast-bpm 120)"))
     :explanation "Ops metronome, math LCM alignment, parsed dispatch."
     :meta "Master-clock is a universal shape.")
    (:eng "Debugging phase-drift means checking one variable." :math "LCM captures shared-period algebra." :cs "Broadcast is O(1) writer / O(k) reader on tick."))
  :row-4-proof (
    (:eng-program "(define (idempotent?) (transport/tempo 120) (transport/tempo 120) 'same)\n(idempotent?)"
     :math-program "(define (constant-in-x? x b) (transport/tempo b) b)\n(= (constant-in-x? 'a 120) (constant-in-x? 'b 120))"
     :cs-program "(define (retry-safe?) (transport/tempo 96) (transport/tempo 96) 'no-drift)\n(retry-safe?)"
     :claim "transport/tempo is idempotent: repeated calls with same BPM have the same visible effect as one."
     :invariant "∀ b > 0. tempo(tempo(state, b), b) = tempo(state, b)"
     :meta "Pattern: idempotent set — same shape as HTTP PUT, kubectl apply.")
    (:eng "Idempotence means 'safe to retry'." :math "Constant function in the state argument." :cs "Absolute-set variant; not nudge or ramp."))
  :row-5-emergence (
    (:eng-composition "(define (metronome bpm) (transport/tempo bpm) (on-tick (lambda () (audio/play 'tick))))\n(metronome 96)"
     :math-composition "(define (star-topology bpm subscribers) (transport/tempo bpm) (map (lambda (s) (list s :retuned-to bpm)) subscribers))\n(star-topology 120 (list 'drums 'anim))"
     :cs-composition "(define (pubsub-tempo bpm handlers) (transport/tempo bpm) (for-each (lambda (h) (h bpm)) handlers))\n(pubsub-tempo 120 (list (lambda (b) (list :got b))))"
     :base "transport/tempo publishes a shared rate."
     :emergent "Compositions: eng metronome, math star topology, cs pub-sub fanout."
     :meta "Family: shared-clock pattern.")
    (:eng "Change one number, everything retunes." :math "Star topology with rate at the root." :cs "Pub-sub fanout to subscribers."))
)

(verb
  :name "transport/bpm" :std "Motoi"
  :library "transport"
  :kind "pure"
  :signature "(transport/bpm) -> integer"
  :summary "Read the transport's current tempo in beats per minute; default 120."
  :impl-status "wired"
  :impl-file "lib/system/domain-verbs.js"
  :impl-notes "Zero-argument reader. Returns the current transport tempo as beats per minute. On a fresh process the tempo defaults to 120. Pure read; the setter transport/tempo changes it."
  :explanation "The transport is the shared musical clock that sequencers, arpeggios, and animations follow. transport/bpm reads its current tempo in beats per minute. A fresh transport starts at 120 BPM — a common default. Because it is a pure read, you can derive timings from it — seconds per beat, frames per beat — without changing the clock. The companion setter transport/tempo retunes it."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(transport/bpm)" :note "A fresh transport reports 120 BPM.")
    (:dialect "motoi" :tier "apprentice" :code "(> (transport/bpm) 0)" :note "The tempo is always positive: #t.")
    (:dialect "motoi" :tier "intermediate" :code "(/ 60.0 (transport/bpm))" :note "Seconds per beat at the current tempo: 0.5 at 120 BPM.")
    (:dialect "motoi" :tier "expert" :code "(define (beats->seconds n) (* n (/ 60.0 (transport/bpm))))\n(beats->seconds 4)" :note "Duration of four beats at the current tempo: 2.0 seconds.")
    (:dialect "motoi" :tier "master" :code "(define (bars->seconds bars beats-per-bar)\n  (* bars beats-per-bar (/ 60.0 (transport/bpm))))\n(bars->seconds 2 4)" :note "Two 4-beat bars at 120 BPM: 4.0 seconds.")
  )
  :caveats ("Returns beats per minute, not beats per second or a period — divide 60 by it for seconds per beat." "The value reflects the current tempo at call time; it is not a live subscription that updates a captured value." "A fresh transport is 120 BPM; do not assume a different default.")
  :drawbacks ("Reports a single global tempo; it does not model per-track or ramped tempo changes." "Gives the rate but not the current beat position or phase; it is a tempo read, not a clock query.")
  :usecases ("Convert a beat count to a real-time duration for scheduling." "Display the current tempo on a transport readout." "Compute frames-per-beat to sync animation to the beat.")
  :related ("transport/tempo")
  :learn (:concept "Clock read: sampling the shared tempo to derive musical timings." :prerequisites ("(core)") :progression "Read transport/bpm to convert beats to seconds, then set the tempo with transport/tempo when the music must speed up or slow down.")
  :row-2-audit (
    (:eng-program "(define (seconds-per-beat) (/ 60.0 (transport/bpm)))\n(seconds-per-beat)"
     :math-program "(define (beats->seconds n) (* n (/ 60.0 (transport/bpm))))\n(beats->seconds 8)"
     :cs-program "(define (tempo-band)\n  (let ((b (transport/bpm)))\n    (cond ((< b 90) 'slow) ((< b 140) 'medium) (else 'fast))))\n(tempo-band)"
     :problem "A sequencer must schedule the next note four beats from now in real seconds. Which verb reports the tempo so beats can be converted to time? Not transport/tempo (that SETS the rate — a side effect where a read is needed)."
     :explanation "eng: derive seconds-per-beat from the tempo. math: beats×(60/bpm) converts a beat count to seconds. cs: classify the tempo into a slow/medium/fast band."
     :meta "Reach for transport/bpm and NOT transport/tempo when reading: bpm reports the current rate; tempo changes it. Converting beats to time must never retune the clock.")
    (:eng "Schedulers read tempo to place events in real time."
     :math "bpm : () → ℤ⁺, the current beats-per-minute."
     :cs "A pure read of the shared clock rate."))
  :row-3-dimension (
    (:setup "Sample a shared rate to derive dependent quantities."
     :rungs (
       (:domain "musical tempo" :code "(transport/bpm)")
       (:domain "period from rate" :code "(/ 60.0 (transport/bpm))")
       (:domain "count to duration" :code "(* 4 (/ 60.0 (transport/bpm)))"))
     :explanation "Rung 1: read the rate. Rung 2: invert it to a period (seconds per beat). Rung 3: scale a count by the period to get a duration."
     :meta "Shape transfers to any rate whose reciprocal times a count yields a duration.")
    (:eng "Every clocked system reads its rate to schedule work."
     :math "period = 60 / rate; duration = count × period."
     :cs "Reading a shared frequency to derive timing."))
  :row-4-proof (
    (:eng-program "(= (transport/bpm) (transport/bpm))"
     :math-program "(define (period-positive?) (> (/ 60.0 (transport/bpm)) 0))\n(period-positive?)"
     :cs-program "(define (read-twice-stable?)\n  (= (transport/bpm) (transport/bpm)))\n(read-twice-stable?)"
     :claim "transport/bpm is a pure, positive read: two consecutive reads agree with no intervening set, and the value is always positive so its reciprocal period is well-defined."
     :invariant "∀ time with no set between reads.  transport/bpm = transport/bpm > 0."
     :meta "Referential transparency and positivity. Falsifier: two reads disagreeing with no set, or a non-positive tempo. Pattern-name: stable positive rate.")
    (:eng "Stable reads let a frame cache the tempo safely."
     :math "A positive rate guarantees a finite period 60/bpm."
     :cs "Pure read — memoizable within a frame."))
  :row-5-emergence (
    (:eng-composition "(define (schedule-beats counts)\n  (map (lambda (n) (* n (/ 60.0 (transport/bpm)))) counts))\n(schedule-beats (list 1 2 4))"
     :math-composition "(define (bar-seconds beats-per-bar) (* beats-per-bar (/ 60.0 (transport/bpm))))\n(bar-seconds 4)"
     :cs-composition "(define (frames-per-beat fps) (quotient (* fps 60) (transport/bpm)))\n(frames-per-beat 60)"
     :base "transport/bpm reads the shared tempo."
     :emergent "A beat-to-time scheduler emerges: read the tempo once and convert any beat count to a real duration. Eng: schedule several beat offsets. Math: seconds per bar. CS: frames per beat for animation sync."
     :meta "Family: rate-driven scheduling — the shape of metronomes, animation timelines, and any system that turns musical counts into wall-clock time.")
    (:eng "A scheduler folds the tempo across every beat offset."
     :math "Duration is a linear map of beat count with slope 60/bpm."
     :cs "Frames-per-beat syncs the render loop to the clock.")))
