;;; 16-compare.slat — Motoi Scheme Reference · Chapter 16 · library compare
;;;
;;; 2 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library compare — 2 verbs.")

(chapter :number "16" :library "compare" :verb-count 2 :training-eligible #t)

(verb :name "boolean=?" :std "R7RS-small" :library "compare" :tier "core" :kind "pure" :signature "(boolean=? a b) -> boolean"
  :summary "R7RS §6.3 — #t if both are #t or both are #f."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(boolean=? #t #t)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((shift-held #t)) (if (boolean=? shift-held #t) 'shifted 'not))" :note "Guard on a boolean flag with a monotype comparator.")
    (:dialect "motoi" :tier "expert"       :code "(define (count-matching ref flags) (fold (lambda (n f) (if (boolean=? f ref) (+ n 1) n)) 0 flags))\n(count-matching #t (list #t #f #t #t #f))" :note "Bucket boolean events without paying for equal? structural walk."))
  :provenance "R7RS §6.3; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (count-matching ref flags) (fold (lambda (n f) (if (boolean=? f ref) (+ n 1) n)) 0 flags))\n(count-matching #t (list #t #f #t #t #f))"
     :math-program "(define (biconditional a b) (boolean=? a b))\n(biconditional #t #t)"
     :cs-program "(define (safe-cmp a b) (if (and (boolean? a) (boolean? b)) (boolean=? a b) (error 'need-booleans)))\n(safe-cmp #t #f)"
     :problem "Boolean bucketing hot-path — need monotype comparator that reads as intent, not polymorphic walk."
     :explanation "eng: bucket flags. math: biconditional. cs: type-guarded compare."
     :meta "Reach for boolean=? and NOT equal?: equal? admits pairs/vectors; boolean=? narrows the signature to what the loop actually does.")
    (:eng "Narrow signatures shrink audit surface." :math "Decision procedure on 2-element domain." :cs "Monotype equality — same family as char=?, string=?."))
  :row-3-dimension (
    (:setup "Monotype equality: two values of one type, refuses to cross types."
     :rungs (
       (:domain "engineering"  :code "(boolean=? #t #t)")
       (:domain "mathematics"  :code "(define (biconditional a b) (boolean=? a b))\n(biconditional #t #t)")
       (:domain "cs / dispatch" :code "(define (biconditional a b) (boolean=? a b))\n(biconditional #t #t)"))
     :explanation "Hardcoded, double-negation math, parsed bool."
     :meta "Homogeneous decidable equality.")
    (:eng "Compare what you claim to compare." :math "Reflexive/symmetric/transitive on {#t,#f}." :cs "Tag-check on sum type."))
  :row-4-proof (
    (:eng-program "(define (reflexive?) (and (boolean=? #t #t) (boolean=? #f #f)))\n(reflexive?)"
     :math-program "(define (symmetric? a b) (boolean=? (boolean=? a b) (boolean=? b a)))\n(symmetric? #t #f)"
     :cs-program "(define (returns-boolean? a b) (boolean? (boolean=? a b)))\n(returns-boolean? #t #f)"
     :claim "boolean=? is reflexive, symmetric, and total on the boolean domain."
     :invariant "∀ x∈{#t,#f}. boolean=?(x,x) = #t ∧ ∀ x,y. boolean=?(x,y) = boolean=?(y,x) ∧ ∀ x,y. boolean=?(x,y) ∈ {#t,#f}"
     :meta "Pattern: equivalence relation on 2-element set — smallest nontrivial equivalence.")
    (:eng "Reflexivity enables constant-folding." :math "Equivalence-relation axioms on B = {#t,#f}." :cs "Decidable equality on finite type."))
  :row-5-emergence (
    (:eng-composition "(define (xor a b) (not (boolean=? a b)))\n(xor #t #f)"
     :math-composition "(define (parity bits) (fold (lambda (p b) (not (boolean=? p b))) #f bits))\n(parity (list #t #f #t))"
     :cs-composition "(define (drift-detect a b on-drift) (when (not (boolean=? a b)) (on-drift a b)))\n(drift-detect #t #f (lambda (a b) (list :drift a b)))"
     :base "boolean=? decides equality on the boolean domain."
     :emergent "Compositions: eng xor gate, math parity fold, cs drift detector."
     :meta "Family: combinational primitive — same family as CPU XOR, C ^.")
    (:eng "Parity check names itself in code." :math "xor is negation of biconditional; addition in GF(2)." :cs "Universal logic gate."))
)

(verb :name "symbol=?" :std "R7RS-small" :library "compare" :tier "core" :kind "pure" :signature "(symbol=? a b) -> boolean"
  :summary "R7RS §6.5 — symbol equality by name."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(symbol=? 'hello 'hello)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((tag 'draw)) (if (symbol=? tag 'draw) 'draw-handler 'other))" :note "Dispatch on a tag with a narrow-signature comparator.")
    (:dialect "motoi" :tier "expert"       :code "(define (dispatch tag table) (cond ((null? table) 'no-handler) ((symbol=? (car (car table)) tag) ((cadr (car table)))) (else (dispatch tag (cdr table)))))\n(dispatch 'move (list (list 'draw (lambda () 'drew)) (list 'move (lambda () 'moved))))" :note "Full dispatcher over a tag-keyed handler table."))
  :provenance "R7RS §6.5; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (has-handler? tag handlers) (cond ((null? handlers) #f) ((symbol=? (car handlers) tag) #t) (else (has-handler? tag (cdr handlers)))))\n(has-handler? 'move (list 'draw 'move 'attack))"
     :math-program "(define (name-eq? s t) (symbol=? s t))\n(name-eq? 'foo 'foo)"
     :cs-program "(define (safe-symcmp a b) (if (and (symbol? a) (symbol? b)) (symbol=? a b) (error 'need-symbols)))\n(safe-symcmp 'a 'a)"
     :problem "Dispatch table lookup by tag; equal? walks defensively, eq? is implementation-defined boundary risk."
     :explanation "eng: membership check. math: name equality. cs: type-guarded compare."
     :meta "Reach for symbol=? and NOT eq?: eq? is implementation-defined for numbers/characters; symbol=? promises name equality — strictly weaker and always correct.")
    (:eng "Signature-first tactics." :math "Total decidable on countable name set." :cs "Monotype equality on intern-backed type."))
  :row-3-dimension (
    (:setup "Tag equality: compare two labels from a flat name space."
     :rungs (
       (:domain "engineering"  :code "(symbol=? 'draw 'draw)")
       (:domain "mathematics"  :code "(define (name-eq? s t) (symbol=? s t))\n(name-eq? 'foo 'foo)")
       (:domain "cs / dispatch" :code "(define (name-eq? s t) (symbol=? s t))\n(name-eq? 'foo 'foo)"))
     :explanation "Hardcoded, canonicalized, parsed dispatch."
     :meta "Homogeneous name-equality.")
    (:eng "Documents itself at the callsite." :math "Singleton equivalence classes." :cs "Enum comparison analog."))
  :row-4-proof (
    (:eng-program "(define (reflexive?) (symbol=? 'x 'x))\n(reflexive?)"
     :math-program "(define (transitive? a b c) (if (and (symbol=? a b) (symbol=? b c)) (symbol=? a c) #t))\n(transitive? 'foo 'foo 'foo)"
     :cs-program "(define (symmetric? a b) (equal? (symbol=? a b) (symbol=? b a)))\n(symmetric? 'a 'b)"
     :claim "symbol=? is an equivalence: reflexive, symmetric, transitive on the symbol type."
     :invariant "∀ s. symbol=?(s,s)=#t ∧ ∀ s,t. symbol=?(s,t)=symbol=?(t,s) ∧ ∀ s,t,u. (symbol=?(s,t) ∧ symbol=?(t,u)) → symbol=?(s,u)"
     :meta "Pattern: equivalence on labelled type.")
    (:eng "Dispatch tables can be sorted, hashed, cached." :math "Equivalence-relation axioms." :cs "Decidable name-equality on intern-table type."))
  :row-5-emergence (
    (:eng-composition "(define (dispatch tag table) (cond ((null? table) 'no-handler) ((symbol=? (car (car table)) tag) ((cadr (car table)))) (else (dispatch tag (cdr table)))))\n(dispatch 'move (list (list 'move (lambda () 'moved))))"
     :math-composition "(define (partition-by-tag items tag) (filter (lambda (i) (symbol=? (car i) tag)) items))\n(partition-by-tag (list (list 'a 1) (list 'b 2) (list 'a 3)) 'a)"
     :cs-composition "(define (dispatch tag table) (cond ((null? table) 'no-handler) ((symbol=? (car (car table)) tag) ((cadr (car table)))) (else (dispatch tag (cdr table)))))\n(define (router table) (lambda (tag) (dispatch tag table)))\n((router (list (list 'ping (lambda () 'pong)))) 'ping)"
     :base "symbol=? decides equality on the symbol type."
     :emergent "Compositions: eng dispatcher, math partition-by-tag, cs closure-wrapped router."
     :meta "Family: dispatcher — same family as vtables, switch/case, pattern match, gen_server callbacks.")
    (:eng "Adding a handler is a one-line table addition." :math "Partial function tag → handler followed by application." :cs "Method table / vtable / jump table pattern."))
)
