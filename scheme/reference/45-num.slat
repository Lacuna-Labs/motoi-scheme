;;; 45-num.slat — Motoi Scheme Reference · Chapter 45 · library num
;;;
;;; 2 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library num — 2 verbs.")

(chapter :number "45" :library "num" :verb-count 2 :training-eligible #t)

(verb :name "num/nintegrate-2d" :std "Motoi" :library "num" :tier "core" :kind "pure" :signature "(num/nintegrate-2d f x-bounds y-bounds) -> number"
  :summary "Double integral over a rectangle via Simpson's rule."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(num/nintegrate-2d (lambda (x y) 1) (list 0 1) (list 0 1))" :note "Area of unit square ≈ 1.")
    (:dialect "motoi" :tier "intermediate" :code "(num/nintegrate-2d (lambda (x y) (+ x y)) (list 0 2) (list 0 2))" :note "∫∫(x+y)dxdy over [0,2]² = 8.")
    (:dialect "motoi" :tier "expert"       :code "(define (volume-under-paraboloid) (num/nintegrate-2d (lambda (x y) (- 4 (+ (* x x) (* y y)))) (list -1 1) (list -1 1)))\n(volume-under-paraboloid)" :note "Named procedure — cacheable, composable."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (density x y) (+ 1 (* 0.5 x y)))\n(num/nintegrate-2d density (list 0 2) (list 0 3))"
     :math-program "(define (linearity-witness f c) (num/nintegrate-2d (lambda (x y) (* c (f x y))) (list 0 1) (list 0 1)))\n(linearity-witness (lambda (x y) (+ x y)) 2)"
     :cs-program "(define (safe-integrate f xb yb) (if (procedure? f) (num/nintegrate-2d f xb yb) (error 'need-procedure)))\n(safe-integrate (lambda (x y) 1) (list 0 1) (list 0 1))"
     :problem "Mass of a flat plate — density has no closed form; symbolic integration refuses; 1D adaptive quadrature is wrong shape."
     :explanation "eng: mass of plate. math: linearity witness. cs: type-guarded call."
     :meta "Reach for num/nintegrate-2d and NOT nintegrate-3d: 3D would misrepresent the domain shape; nintegrate-2d is honest about (function-of-2, x-bounds, y-bounds).")
    (:eng "Name-your-numerical-method — signature matches domain shape." :math "Simpson's rule error O(h⁴)." :cs "Deterministic within a device; polynomial in mesh fineness."))
  :row-3-dimension (
    (:setup "Aggregate a function over a region into a scalar."
     :rungs (
       (:domain "engineering"  :code "(define (linearity-witness f c) (num/nintegrate-2d (lambda (x y) (* c (f x y))) (list 0 1) (list 0 1)))\n(linearity-witness (lambda (x y) (+ x y)) 2)")
       (:domain "mathematics"  :code "(define (linearity-witness f c) (num/nintegrate-2d (lambda (x y) (* c (f x y))) (list 0 1) (list 0 1)))\n(linearity-witness (lambda (x y) (+ x y)) 2)")
       (:domain "cs / dispatch" :code "(define (linearity-witness f c) (num/nintegrate-2d (lambda (x y) (* c (f x y))) (list 0 1) (list 0 1)))\n(linearity-witness (lambda (x y) (+ x y)) 2)"))
     :explanation "Continuous quadrature, measure-theoretic, discrete tile sum."
     :meta "Accumulate value-density over domain.")
    (:eng "Match method to smoothness class." :math "∫_R f dμ specializes to Simpson on rectangles." :cs "Reduction over rectangular domain."))
  :row-4-proof (
    (:eng-program "(define (f x y) (+ (* x x) (* y y)))\n(define whole (num/nintegrate-2d f (list 0 2) (list 0 2)))\n(define left (num/nintegrate-2d f (list 0 1) (list 0 2)))\n(define right (num/nintegrate-2d f (list 1 2) (list 0 2)))\n(< (abs (- whole (+ left right))) 1e-6)"
     :math-program "(define (linear? f c) (define whole (num/nintegrate-2d f (list 0 1) (list 0 1))) (define scaled (num/nintegrate-2d (lambda (x y) (* c (f x y))) (list 0 1) (list 0 1))) (< (abs (- scaled (* c whole))) 1e-6))\n(linear? (lambda (x y) (+ x y)) 3.5)"
     :cs-program "(define (returns-number? r) (number? r))\n(returns-number? (num/nintegrate-2d (lambda (x y) 1) (list 0 1) (list 0 1)))"
     :claim "Linear in the integrand; additive in the domain."
     :invariant "∀ c ∈ ℝ, f. ∫∫ cf = c·∫∫ f ; ∀ R = R₁ ∪ R₂ (disjoint). ∫∫_R f = ∫∫_{R₁} f + ∫∫_{R₂} f"
     :meta "Pattern: linear reduction.")
    (:eng "Decompose domain to fit budget; sum equals whole." :math "Linearity + additivity — defining properties of definite integral." :cs "Parallel MapReduce commutes with domain partition."))
  :row-5-emergence (
    (:eng-composition "(define (density x y) (+ 1 (* 0.1 x y)))\n(define (mass-of-strip x0 x1) (num/nintegrate-2d density (list x0 x1) (list 0 2)))\n(apply + (list (mass-of-strip 0 1) (mass-of-strip 1 2) (mass-of-strip 2 3)))"
     :math-composition "(define (partition-fold f bounds) (apply + (map (lambda (b) (num/nintegrate-2d f b (list 0 1))) bounds)))\n(partition-fold (lambda (x y) 1) (list (list 0 1) (list 1 2)))"
     :cs-composition "(define (retry-per-piece pieces integrator) (map (lambda (p) (integrator p)) pieces))\n(retry-per-piece (list (list 0 1) (list 1 2)) (lambda (b) (num/nintegrate-2d (lambda (x y) 1) b (list 0 1))))"
     :base "num/nintegrate-2d aggregates over a rectangle."
     :emergent "Compositions: eng domain decomposition into strips, math monoid-fold under additivity, cs per-piece retryable pipeline."
     :meta "Family: domain decomposition.")
    (:eng "Fuel exhaustion in one strip doesn't lose the whole computation." :math "Monoid-fold with identity ∫_∅ f = 0." :cs "Divide-and-conquer for numerical work."))
)

(verb :name "num/nintegrate-3d" :std "Motoi" :library "num" :tier "core" :kind "pure" :signature "(num/nintegrate-3d f x-bounds y-bounds z-bounds) -> number"
  :summary "Triple integral over a rectangular box via tensor Simpson's rule."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(num/nintegrate-3d (lambda (x y z) 1) (list 0 1) (list 0 1) (list 0 1))" :note "Volume of unit cube ≈ 1.")
    (:dialect "motoi" :tier "intermediate" :code "(num/nintegrate-3d (lambda (x y z) (+ x y z)) (list 0 2) (list 0 2) (list 0 2))" :note "∫∫∫(x+y+z) over [0,2]³ = 24.")
    (:dialect "motoi" :tier "expert"       :code "(define (moment-of-inertia-z density) (num/nintegrate-3d (lambda (x y z) (* density (+ (* x x) (* y y)))) (list -1 1) (list -1 1) (list 0 2)))\n(moment-of-inertia-z 8.0)" :note "Rotational inertia — density is a parameter for reuse."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (density x y z) (+ 1.0 (* 0.1 (- z 1))))\n(num/nintegrate-3d density (list 0 2) (list 0 3) (list 0 2))"
     :math-program "(define (volume-of-box xb yb zb) (num/nintegrate-3d (lambda (x y z) 1) xb yb zb))\n(volume-of-box (list 0 2) (list 0 3) (list 0 2))"
     :cs-program "(define (safe-3d f xb yb zb) (if (procedure? f) (num/nintegrate-3d f xb yb zb) (error 'need-procedure)))\n(safe-3d (lambda (x y z) 1) (list 0 1) (list 0 1) (list 0 1))"
     :problem "Mass of solid block with varying density — no closed form; nintegrate-2d cannot represent depth."
     :explanation "eng: mass of block. math: volume witness. cs: type-guarded call."
     :meta "Reach for num/nintegrate-3d and NOT nintegrate-2d × depth: 2D × depth is wrong for varying density; nintegrate-3d honestly represents the box domain.")
    (:eng "Signature must match physical domain shape." :math "Error O(h⁴) per axis." :cs "Cost O(N³) — multiplicative blowup across axes."))
  :row-3-dimension (
    (:setup "Aggregate a function over a volumetric domain."
     :rungs (
       (:domain "engineering"  :code "(define (volume-of-box xb yb zb) (num/nintegrate-3d (lambda (x y z) 1) xb yb zb))\n(volume-of-box (list 0 2) (list 0 3) (list 0 2))")
       (:domain "mathematics"  :code "(define (volume-of-box xb yb zb) (num/nintegrate-3d (lambda (x y z) 1) xb yb zb))\n(volume-of-box (list 0 2) (list 0 3) (list 0 2))")
       (:domain "cs / dispatch" :code "(define (volume-of-box xb yb zb) (num/nintegrate-3d (lambda (x y z) 1) xb yb zb))\n(volume-of-box (list 0 2) (list 0 3) (list 0 2))"))
     :explanation "Continuous tensor quadrature, measure-theoretic, discrete voxel sum."
     :meta "Value-density aggregation over volume.")
    (:eng "3D is dimensionally more expensive than 2D." :math "Tensor Simpson specializes 3D Lebesgue." :cs "3D reduction over mesh grid."))
  :row-4-proof (
    (:eng-program "(define (f x y z) (+ (* x x) (* y y) (* z z)))\n(define whole (num/nintegrate-3d f (list 0 2) (list 0 2) (list 0 2)))\n(define left (num/nintegrate-3d f (list 0 1) (list 0 2) (list 0 2)))\n(define right (num/nintegrate-3d f (list 1 2) (list 0 2) (list 0 2)))\n(< (abs (- whole (+ left right))) 1e-4)"
     :math-program "(define (linear-3d? f c) (define whole (num/nintegrate-3d f (list 0 1) (list 0 1) (list 0 1))) (define scaled (num/nintegrate-3d (lambda (x y z) (* c (f x y z))) (list 0 1) (list 0 1) (list 0 1))) (< (abs (- scaled (* c whole))) 1e-4))\n(linear-3d? (lambda (x y z) (+ x y z)) 2.5)"
     :cs-program "(define (numeric?) (number? (num/nintegrate-3d (lambda (x y z) 1) (list 0 1) (list 0 1) (list 0 1))))\n(numeric?)"
     :claim "Linear in the integrand; additive in the domain (up to numerical tolerance 1e-4)."
     :invariant "∀ c ∈ ℝ, f. ∫∫∫ cf = c·∫∫∫ f ; ∀ R = R₁ ∪ R₂ (disjoint). ∫∫∫_R f = ∫∫∫_{R₁} f + ∫∫∫_{R₂} f"
     :meta "Pattern: 3D linear reduction.")
    (:eng "Fuel-tight 3D via domain pieces that fit budget." :math "3D Lebesgue linearity + additivity." :cs "Parallel volumetric aggregation."))
  :row-5-emergence (
    (:eng-composition "(define (density x y z) (+ 1.0 (* 0.05 (+ x y z))))\n(define (mass-of-slab z0 z1) (num/nintegrate-3d density (list 0 2) (list 0 2) (list z0 z1)))\n(apply + (list (mass-of-slab 0 1) (mass-of-slab 1 2) (mass-of-slab 2 3)))"
     :math-composition "(define (slab-fold f slabs) (apply + (map (lambda (s) (num/nintegrate-3d f (list 0 1) (list 0 1) s)) slabs)))\n(slab-fold (lambda (x y z) 1) (list (list 0 1) (list 1 2)))"
     :cs-composition "(define (stream-per-slab slabs on-slab) (for-each (lambda (s) (on-slab (num/nintegrate-3d (lambda (x y z) 1) (list 0 1) (list 0 1) s))) slabs))\n(stream-per-slab (list (list 0 1)) (lambda (m) m))"
     :base "num/nintegrate-3d aggregates over a box."
     :emergent "Compositions: eng layered-aggregation into slabs, math monoid-fold under axis-aligned partition, cs streaming per-slab pipeline."
     :meta "Family: layered aggregation.")
    (:eng "Stream per-slab avoids materializing whole tensor grid." :math "∫_R f = Σᵢ ∫_{R∩[zᵢ,zᵢ₊₁]} f." :cs "Same slot as CT-scan reconstruction algorithms."))
)
