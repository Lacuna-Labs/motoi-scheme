    (:eng-composition "(define perms (list (alg/perm (list 1 0)) (alg/perm (list 1 2 0)) (alg/perm (list 1 2 0 4 3))))\n(map alg/perm-order perms)"
     :math-composition "(define S3 (alg/symmetric 3))\n(apply lcm (map alg/perm-order (alg/op S3)))"
     :cs-composition "(define p (alg/perm (list 1 2 3 4 0)))\n(map (lambda (k) (equal? (alg/perm-pow p k) (alg/perm-identity 5))) (list 1 2 3 4 5))")
    (:base "alg/perm-order — see :summary."
