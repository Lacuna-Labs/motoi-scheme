    (:eng-program "(define C4 (alg/cyclic 4))\n(define e (alg/identity C4))\n(= (alg/op C4 e 2) 2)"
     :math-program "(define C9 (alg/cyclic 9))\n(let loop ((xs (alg/op C9)))\n  (cond ((null? xs) #t)\n        ((not (zero? (modulo (alg/order C9) (alg/element-order C9 (car xs))))) #f)\n        (else (loop (cdr xs)))))"
     :cs-program "(define C6 (alg/cyclic 6))\n(define (inverse-check x) (= (alg/op C6 x (alg/inverse C6 x)) (alg/identity C6)))\n(let loop ((xs (alg/op C6)))\n  (cond ((null? xs) #t)\n        ((not (inverse-check (car xs))) #f)\n        (else (loop (cdr xs)))))")
