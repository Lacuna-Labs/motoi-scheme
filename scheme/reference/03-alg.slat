     :math-program "(define G (alg/cyclic 6))\n(define H (alg/cyclic 2))\n(define phi (lambda (x) (modulo x 2)))\n(length (alg/image G H phi))"
     :cs-program "(define G (alg/cyclic 3))\n(define H (alg/cyclic 3))\n(define id-phi (lambda (x) x))\n(= (length (alg/image G H id-phi)) (alg/order G))")
    (:claim "im(φ) is a subgroup of H, and G/ker(φ) ≅ im(φ) (First Iso Theorem)."
     :program "(define G (alg/zn 6))\n(define H (alg/zn 3))\n(define phi (lambda (x) (modulo x 3)))\n(define img (alg/image G H phi))\n(define ker (alg/kernel G H phi))\n(= (length img) (/ (alg/order G) (length ker)))"
