    (:eng "The runnable claim doubles as a CI smoke test — if the invariant ever prints #f, the verb has drifted."
     :math "The invariant is the defining property in the ring category."
     :cs "Property-based test: the program above is a runnable falsifier candidate for a QuickCheck-style fuzzer.")
)
  :row-5-emergence (
    (:eng-composition "(define f (list 1 0 1))\n(define g (list 1 1))\n(define prod (alg/poly-mul f g 2))\nprod"
     :math-composition "(define x (list 0 1))\n(define x2 (alg/poly-mul x x 2))\n(alg/poly-mul x2 x2 2)"
     :cs-composition "(define factors (list (list 1 1) (list 1 1) (list 1 1)))\n(fold (lambda (p acc) (alg/poly-mul acc p 2)) (list 1) factors)")
    (:base "alg/poly-mul — see :summary."
