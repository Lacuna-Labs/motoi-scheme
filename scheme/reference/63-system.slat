;;; 63-system.slat — Motoi Scheme Reference · Chapter 63 · library system
;;;
;;; 13 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;

(dialect :applies ("motoi") :note "Library system — 13 verbs.")

(chapter :number "63" :library "system" :verb-count 13 :training-eligible #t)

;; ═══ 13 verbs in library system ═══

(verb
  :name "system/cards" :std "Motoi"
  :library "system"
  :kind "rd"
  :signature "(system/cards) -> [{id kind x y k z focused} ...]"
  :summary "Return a list of all open cards with their position, size, z-order, and focus state."
  :explanation "A card is a UI container (window-like) on the Motoi surface. `system/cards` snapshots the entire card fleet: for each open card it reports the unique ID, the card kind (type/template), pixel position (x, y), size (k in pixels), z-depth (stacking order), and whether it has keyboard focus. This is introspection: you cannot modify cards with this verb, only read their state. Use it to query the layout, find cards by position, or monitor which card is active."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (system/cards))" :note "Print the current card roster: you'll see IDs, kinds, positions, and focus state for all open windows.")
    (:dialect "motoi" :tier "intermediate" :code "(define (filter pred xs)\n  (let loop ((xs xs) (acc '()))\n    (cond ((null? xs) (reverse acc))\n          ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc)))\n          (else (loop (cdr xs) acc)))))\n(let ((cards (system/cards)))\n  (let ((focused (filter (lambda (c) (eq? (assoc 'focused c) #t)) cards)))\n    (if (not (null? focused))\n      (display (car focused)))))" :note "Find the focused card and display its data; pattern for locating the active window.")
    (:dialect "motoi" :tier "expert" :code "(define (find-card-at-xy x y)\n  (let ((cards (system/cards)))\n    (let loop ((cs cards))\n      (if (null? cs)\n        #f\n        (let* ((c (car cs))\n               (cx (assoc 'x c))\n               (cy (assoc 'y c))\n               (csize (assoc 'k c)))\n          (if (and (>= x cx) (< x (+ cx csize))\n                   (>= y cy) (< y (+ cy csize)))\n            c\n            (loop (cdr cs))))))))\n(find-card-at-xy 100 200)" :note "Spatial query: return the card at screen coordinates (100, 200) by iterating the roster and checking bounding boxes.")
  )
  :caveats ("This is a read-only snapshot; calling it twice in quick succession may return different results if cards open/close." "Position and size are in pixels; z-order is an integer (higher = on top)." "The 'position field may be an object with x/y keys or a 2-element array [x y]; code normalizes both." "Cards with missing data (e.g., a closed card that hasn't cleaned up) may have null values; check before dereferencing.")
  :drawbacks ("No card filtering by kind: you get the entire list; filter in Scheme if you want specific types." "No hierarchical or parent/child relationship info; all cards are treated as peers." "Continuous polling (calling repeatedly) is inefficient; consider caching or event subscription if available." "Does not report cards that are closed; only open cards appear in the list.")
  :usecases ("Layout introspection: query which windows are open to decide whether to spawn a new card or reuse an existing one." "Spatial hit-testing: find which card a mouse click or touch landed on." "Focus management: determine which card has keyboard input, used to decide message routing." "Telemetry: log the card state for debugging or analytics (e.g., how many cards did the user have open?).")
  :related ("entity/all" "entity-find-by-kind" "entity-rect" "entity-screen-rect" "system/health" "system/registry")
  :learn (:concept "System introspection: querying the runtime state of UI containers (cards) to inform control flow and spatial reasoning." :prerequisites ("(core)/let" "(core)/filter" "(core)/lambda" "(core)/null?" "entity/all") :progression "Learn `system/cards` to understand the entity roster, then use `entity/all` or `entity/emit` to interact with specific entities, then explore the entity event system for reactive updates.")
  :row-2-audit (
    (:eng-program "(define (card-at x y)\n  (let loop ((cs (system/cards)))\n    (cond ((null? cs) #f)\n          ((let* ((c (car cs)) (cx (cdr (assoc 'x c))) (cy (cdr (assoc 'y c))) (k (cdr (assoc 'k c))))\n             (and (>= x cx) (< x (+ cx k)) (>= y cy) (< y (+ cy k)))) (car cs))\n          (else (loop (cdr cs))))))\n(card-at 100 200)"
     :math-program "(:honest-null \"system/cards is fleet-introspection — the verb returns a live snapshot of runtime records; the operation is a lookup, not algebra. Row-2 math is honest-null. See row-4 for schema invariant.\")"
     :cs-program "(define (fleet-size-bounded? max) (< (length (system/cards)) max))\n(fleet-size-bounded? 100)"
     :problem "UI hit-testing on mouse clicks at (100,200) needs to find which card the click landed on. Hard-coded positions break as soon as user moves a card."
     :explanation "eng: bounding-box hit test iterating fleet. math: honest-null — introspection is not algebra. cs: fleet-size bound predicate."
     :meta "system/cards is the runtime's authoritative snapshot. Hard-coded positions drift; the runtime holds ground truth.")
    (:eng "Fleet-snapshot introspection; log snapshot at click moment for audit."
     :math "Finite list of records — snapshot of card fleet."
     :cs "Fleet introspection — same slot as ps in Unix, docker ps, kubectl get pods."))
  :row-3-dimension (
    (:setup "A fleet snapshot: enumerate every live instance of a resource in one call, so the caller can search or aggregate."
     :rungs ((:domain "system (cards)" :code "(system/cards)")
             (:domain "process table" :code "(:honest-null \"system/cards is fleet-introspection — the verb returns a live snapshot of runtime records; the operation is a lookup, not algebra. Row-2 math is honest-null. See row-4 for schema invariant.\")")
             (:domain "set of live objects" :code "(:honest-null \"system/cards is fleet-introspection — the verb returns a live snapshot of runtime records; the operation is a lookup, not algebra. Row-2 math is honest-null. See row-4 for schema invariant.\")"))
     :explanation "In Motoi, system/cards enumerates cards. On Unix, ps enumerates processes. In set theory, a comprehension enumerates the live instances. All three cases share the shape of 'give me every live instance at this moment.'"
     :meta "The shape transfers wherever the caller needs to reason about the whole fleet.")
    (:eng "Log the snapshot length as a fleet-size signal."
     :math "The verb returns a finite subset of the potential-cards universe."
     :cs "The CS analog is process-table introspection."))
  :row-4-proof (
    (:eng-program "(define cards (system/cards))\n(and (list? cards) (= (length cards) (length cards)))"
     :math-program "(:honest-null \"Fleet-record integrity (unique IDs) is a schema constraint on the runtime record set, not an algebraic identity. See :cs-program for uniqueness witness.\")"
     :cs-program "(define (unique-ids? cards)\n  (let loop ((cs cards) (seen '()))\n    (cond ((null? cs) #t)\n          ((memv (cdr (assoc 'id (car cs))) seen) #f)\n          (else (loop (cdr cs) (cons (cdr (assoc 'id (car cs))) seen))))))\n(unique-ids? (system/cards))"
     :claim "system/cards returns a list of card records with fields {id, kind, x, y, k, z, focused}; every id is unique in the returned list."
     :invariant "cards() ∈ List<CardRecord> ∧ ids pairwise distinct"
     :meta "Fleet-record integrity. Falsified by two entries with same id.")
    (:eng "Smoke test: length stable across immediate re-reads."
     :math "Subset of CardRecord universe with distinct-id constraint."
     :cs "Unique-id invariant."))
  :row-5-emergence (
    (:eng-composition "(define (my-filter pred xs) (let loop ((xs xs) (acc '())) (cond ((null? xs) (reverse acc)) ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc))) (else (loop (cdr xs) acc)))))\n(define (count-focused)\n  (length (my-filter (lambda (c) (cdr (assoc 'focused c))) (system/cards))))\n(count-focused)"
     :math-composition "(:honest-null \"Fleet aggregation is a filter-count-fold over a runtime record snapshot; the operation is category-selection, not algebra. See :cs-composition for grouping composition.\")"
     :cs-composition "(define (cards-by-kind)\n  (let loop ((cs (system/cards)) (buckets '()))\n    (if (null? cs) buckets\n      (let* ((c (car cs)) (k (cdr (assoc 'kind c))) (existing (assoc k buckets)))\n        (loop (cdr cs) (if existing (cons (cons k (+ 1 (cdr existing))) (filter (lambda (b) (not (equal? (car b) k))) buckets)) (cons (cons k 1) buckets)))))))\n(cards-by-kind)"
     :base "system/cards enumerates open cards."
     :emergent "Focus report (filter-count) + group-by-kind bucketing form the FLEET-AGGREGATION family — Prometheus counters, kubectl get filters, top-N dashboards."
     :meta "Family: fleet aggregation — same slot as Grafana panel over kubectl get.")
    (:eng "Log fleet aggregates on startup for capacity planning."
     :math "Filter-then-count reduction on finite record set."
     :cs "Fleet aggregation — Prometheus counters, kubectl get filters."))
)

(verb
  :name "system/health" :std "Motoi"
  :library "system"
  :kind "rd"
  :signature "(system/health) -> {quarantined null fuel-exhausted null illusions null}"
  :summary "Best-effort read of system health metrics: quarantine flag, fuel exhaustion count, and illusion count."
  :explanation "The Motoi runtime has several internal health indicators. 'quarantined' signals whether the system has entered a safe mode (e.g., due to repeated errors). 'fuel-exhausted' tracks unfinished computations or resource exhaustion. 'illusions' counts anomalies or inconsistencies. `system/health` attempts to read these from the health provider; if the provider is unavailable or crashes, it returns an object with all fields null (honest-null). This is best-effort introspection: use it for diagnostics, not for hard control logic."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((h (system/health)))\n  (display h))" :note "Read the health status once and print it; shows the quarantine, fuel, and illusion counts (or nulls if unavailable).")
    (:dialect "motoi" :tier "intermediate" :code "(let ((h (system/health)))\n  (if (eq? (assoc 'quarantined h) #t)\n    (display \"System is quarantined; operations may be limited.\")\n    (display \"System is healthy.\")))" :note "Check the quarantine flag to decide whether to proceed with risky operations.")
    (:dialect "motoi" :tier "expert" :code "(define (health-monitor)\n  (let ((h (system/health)))\n    (if (or (pair? (cadr (assoc 'quarantined h)))\n            (and (assoc 'illusions h)\n                 (number? (cadr (assoc 'illusions h)))\n                 (> (cadr (assoc 'illusions h)) 10)))\n      (list 'degraded ':health h)\n      (list 'healthy ':health h))))\n(health-monitor)" :note "Check health; return degraded if quarantined or illusions exceed threshold. Pattern for system-level monitoring.")
  )
  :caveats ("Best-effort: if the health provider is not installed or fails, returns all-null object." "Non-deterministic: multiple calls may return different values; it is a live read, not a snapshot." "Field semantics are intentionally vague: 'quarantined is a bool/null, 'fuel-exhausted and 'illusions are counts or null." "Do not rely on health status for hard safety guarantees; it is a hint, not a promise.")
  :drawbacks ("No direct way to clear quarantine or reset fuel: health is read-only." "No subscription or event: you must poll if you want continuous monitoring." "Field meanings are system-specific and may change; portable code should treat all fields as optional." "If health provider is slow or crashes, blocking the calling card's event loop.")
  :usecases ("Diagnostics UI: show the user a health indicator (green = healthy, red = quarantined)." "Auto-recovery: if fuel-exhausted > 0, gracefully degrade or restart a sub-system." "Error reporting: log the health snapshot alongside any crash or exception." "Load shedding: if illusions > threshold, reduce frame rate or pause background tasks.")
  :related ("system/cards" "system/registry" "system/scheduler" "escalate" "floor/problem?")
  :learn (:concept "System health monitoring: reading non-deterministic runtime metrics to diagnose and respond to degradation." :prerequisites ("(core)/let" "(core)/if" "(core)/display" "system/registry") :progression "Learn `system/health` for basic health introspection, then combine with `after` or event loops for continuous monitoring, then explore escalation patterns with `escalate` for failure response.")
  :row-2-audit (
    (:eng-program "(define h (system/health))\n(list ':record h ':quarantined (assoc 'quarantined h))"
     :math-program "(:honest-null \"system/health returns a runtime record with three integer/null fields; the operation is a health-probe read, not algebra. Row-2 math is honest-null. See row-4 for schema.\")"
     :cs-program "(define (health-degraded? h) (or (eq? (cadr (assoc 'quarantined h)) #t) (let ((i (assoc 'illusions h))) (and i (number? (cadr i)) (> (cadr i) 10)))))\n(health-degraded? (system/health))"
     :problem "SRE dashboard needs quarantine state, fuel exhaustion counts, illusion counts. system/health is the aggregated posture read."
     :explanation "eng: record + quarantine highlight. math: honest-null — health is a probe, not algebra. cs: composite degradation predicate."
     :meta "Aggregated posture; sub-verbs (system/scheduler, system/registry) give slice views. system/health is the summary.")
    (:eng "System-posture read; log record at every incident."
     :math "Record with three integer/null-valued fields."
     :cs "Health probe — same slot as /healthz endpoints, kubelet liveness probes."))
  :row-3-dimension (
    (:setup "A health probe: read a summary record describing the system's current wellness."
     :rungs ((:domain "system (health)" :code "(system/health)")
             (:domain "restaurant morning briefing" :code "(:honest-null \"system/health returns a runtime record with three integer/null fields; the operation is a health-probe read, not algebra. Row-2 math is honest-null. See row-4 for schema.\")")
             (:domain "liveness probe" :code "(:honest-null \"system/health returns a runtime record with three integer/null fields; the operation is a health-probe read, not algebra. Row-2 math is honest-null. See row-4 for schema.\")"))
     :explanation "In Motoi the probe returns quarantine + fuel + illusions. In a restaurant the morning briefing summarizes staffing, deliveries, VIP reservations. In Kubernetes /healthz reports process health. All three share the summary-record shape."
     :meta "The shape transfers wherever a system needs an aggregate wellness reading.")
    (:eng "Log the health record with every incident report."
     :math "The verb is a nullary function into a small record type."
     :cs "The CS analog is a health-check endpoint."))
  :row-4-proof (
    (:eng-program "(define h (system/health))\n(and (assoc 'quarantined h) (assoc 'fuel-exhausted h) (assoc 'illusions h))"
     :math-program "(:honest-null \"Record-schema invariant is a metatheoretic claim about return type shape, not an algebraic identity. See :eng-program for schema witness.\")"
     :cs-program "(define (schema-stable? n)\n  (let loop ((i 0) (fields '()))\n    (if (>= i n) (or (null? fields) (equal? (car fields) (car (last-pair fields))))\n      (loop (+ i 1) (cons (map car (system/health)) fields)))))\n(schema-stable? 3)"
     :claim "system/health returns a record with fields {quarantined, fuel-exhausted, illusions}; each field is a value (bool/number) or null; schema is stable across reads."
     :invariant "health() has fields {quarantined, fuel-exhausted, illusions} ∧ schema(health())=schema(health())"
     :meta "Record-schema invariant. Falsified by any run with missing field or schema drift.")
    (:eng "Smoke test: all three fields present."
     :math "Fixed schema; only field values vary."
     :cs "Health-record schema."))
  :row-5-emergence (
    (:eng-composition "(define (traffic-light)\n  (let ((h (system/health)))\n    (cond ((eq? (cadr (assoc 'quarantined h)) #t) 'red)\n          ((let ((i (assoc 'illusions h))) (and i (number? (cadr i)) (> (cadr i) 5))) 'yellow)\n          (else 'green))))\n(traffic-light)"
     :math-composition "(:honest-null \"Health-signal categorization is a discrete cond-tree over runtime record values; the operation is triage rule application, not algebra. See :cs-composition for time-series composition.\")"
     :cs-composition "(define (health-samples n)\n  (let loop ((i 0) (samples '()))\n    (if (>= i n) (reverse samples)\n      (loop (+ i 1) (cons (system/health) samples)))))\n(length (health-samples 3))"
     :base "system/health returns aggregated wellness record."
     :emergent "Traffic-light indicator (red/yellow/green) + time-series sampling form the health-categorization family — cloud dashboards, air traffic control, medical triage, Prometheus alertmanager severity."
     :meta "Family: health categorization — reduce multi-metric to actionable category.")
    (:eng "Traffic-light dashboards; log transition timestamps for post-incident analysis."
     :math "Discrete categorical function of a record."
     :cs "Health categorization — same slot as cloud console color-coding."))
)

(verb
  :name "system/registry" :std "Motoi"
  :library "system"
  :kind "rd"
  :signature "(system/registry [keyword domain]) -> {domain name perm chip determinism summary [entry ...]}"
  :summary "Query the Motoi verb registry: list all verbs and their metadata (perms, summaries) or query another registry domain (e.g., events)."
  :explanation "The Motoi kernel maintains a registry of all available verbs, their signatures, permissions, and documentation. `system/registry` snapshots this registry and returns it as a structured list. By default it returns verbs; you can pass `:domain 'events` to query the events registry instead. Each entry includes the verb name, its required permission level, a permission chip (resource tag), determinism (pure, non-deterministic, etc.), and a brief summary. This is introspection for the language itself: use it to implement code completion, help systems, or self-discovering agents."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((reg (system/registry)))\n  (display (car (assoc 'entries reg))))" :note "Get the verb registry and print the first entry; shows the structure of a verb record.")
    (:dialect "motoi" :tier "intermediate" :code "(let* ((reg (system/registry))\n       (entry-list (car (cdr (assoc 'entries reg)))))\n  (let ((synth-verbs (filter\n           (lambda (e)\n             (let ((n (cadr (assoc 'name e))))\n               (and (string? n) (string-contains n \"synth/\"))))\n           entry-list)))\n    (display (length synth-verbs))))" :note "Filter the registry to find all synth/* verbs; useful for discovering a module's API.")
    (:dialect "motoi" :tier "expert" :code "(define (list-verbs-by-kind required-kind)\n  (let* ((reg (system/registry))\n         (entry-list (car (cdr (assoc 'entries reg)))))\n    (filter (lambda (e) \n      (equal? (cadr (assoc 'kind e)) required-kind))\n    entry-list)))\n(let ((impl-verbs (list-verbs-by-kind 'impl)))\n  (display (length impl-verbs))\n  (display \" impl verbs available\"))" :note "Query the registry, filter by kind (impl/spec), count and display; pattern for kind-aware code generation or help systems.")
  )
  :caveats ("Registry is permission-filtered: you only see verbs you are allowed to call (based on your current context)." "Domain parameter is optional; defaults to 'verbs. If you want events, pass `:domain 'events`." "Event domain returns a simpler structure: just domain and event list, no perms or summaries." "Registry snapshot is taken at call time; changes to available verbs (e.g., loading a plugin) happen after the snapshot.")
  :drawbacks ("No ability to modify the registry: this is read-only introspection." "Permission filtering means different callers see different registries; not suitable for cross-context discovery." "No search or indexing: you must filter client-side in Scheme." "Summary strings are brief and may not be sufficient for learning; use other reference tools for detailed documentation.")
  :usecases ("IDE autocomplete: query the registry to populate a dropdown of available verbs." "Help system: list all verbs that match a substring, with their summaries." "Permission checker: before generating code, verify that your context permits calling a specific verb." "Exploration: browse the verb namespace to discover new patterns or modules." "Diagnostics: compare your local registry snapshot to a golden copy to detect API drift.")
  :related ("system/cards" "system/health" "system/scheduler" "ask/reasoner")
  :learn (:concept "Reflective registry queries: introspecting the language's own verb definitions and metadata to enable tooling, discovery, and dynamic code generation." :prerequisites ("(core)/let" "(core)/filter" "(core)/lambda" "(core)/assoc" "(core)/display" "system/health") :progression "Learn `system/registry` to understand how to query the verb namespace, then use registry data to implement a help command or verb picker, then explore `ask/reasoner` for AI-assisted code generation that respects the registry.")
  :row-2-audit (
    (:eng-program "(define reg (system/registry))\n(list ':is-list (list? reg) ':entries (assoc 'entries reg))"
     :math-program "(:honest-null \"system/registry is language-reflection over the interpreter's own verb metadata; the operation is symbol-table lookup, not algebra. Row-2 math is honest-null.\")"
     :cs-program "(define (registry-drift-check! golden)\n  (let ((current (map car (system/registry))))\n    (equal? current golden)))\n(registry-drift-check! '())"
     :problem "Code-completion tool needs the current verb list. Hard-coding a list guarantees drift. system/registry is the authoritative introspection."
     :explanation "eng: registry query + entries slot. math: honest-null — reflection is not algebra. cs: drift check against golden snapshot."
     :meta "Query the registry, don't hard-code. Same reason Python has inspect, Java has reflection.")
    (:eng "Language-reflection; log registry size on startup as versioning signal."
     :math "Snapshot of well-known state."
     :cs "Language reflection — Python inspect, Java reflection, LSP servers."))
  :row-3-dimension (
    (:setup "A language-reflection probe: query the interpreter about its own defined names and metadata."
     :rungs ((:domain "system (registry)" :code "(system/registry)")
             (:domain "phone directory" :code "(:honest-null \"system/registry is language-reflection over the interpreter's own verb metadata; the operation is symbol-table lookup, not algebra. Row-2 math is honest-null.\")")
             (:domain "self-describing schema" :code "(:honest-null \"system/registry is language-reflection over the interpreter's own verb metadata; the operation is symbol-table lookup, not algebra. Row-2 math is honest-null.\")"))
     :explanation "In Motoi, the registry is the language's self-description. A phone directory lists all names. In SQL, information_schema lists tables. All three share the shape of 'ask the system what it knows.'"
     :meta "The shape transfers wherever a system can describe itself."
     )
    (:eng "Log registry size at startup as a versioning signal."
     :math "The verb is a nullary function returning a list of records."
     :cs "The CS analog is reflection API."))
  :row-4-proof (
    (:eng-program "(define reg (system/registry))\n(and (list? reg) (assoc 'entries reg))"
     :math-program "(:honest-null \"Registry schema invariant is a metatheoretic claim about return-record shape, not an algebraic identity. See :cs-program for entry-well-formedness witness.\")"
     :cs-program "(define (every-entry-has-name?)\n  (let* ((reg (system/registry)) (entry-list (car (cdr (assoc 'entries reg)))))\n    (let loop ((es entry-list))\n      (cond ((null? es) #t)\n            ((not (assoc 'name (car es))) #f)\n            (else (loop (cdr es)))))))\n(every-entry-has-name?)"
     :claim "system/registry returns a record with 'entries field (list); every entry has 'name field."
     :invariant "registry() has field 'entries ∧ ∀entry ∈ entries. entry has field 'name"
     :meta "Registry-schema invariant. Falsified by any entry missing 'name.")
    (:eng "Smoke test: entries present and is a list."
     :math "Fixed record schema."
     :cs "Reflective-schema invariant."))
  :row-5-emergence (
    (:eng-composition "(define (help-for pattern)\n  (let* ((reg (system/registry))\n         (entry-list (car (cdr (assoc 'entries reg)))))\n    (let loop ((es entry-list) (acc '()))\n      (cond ((null? es) (reverse acc))\n            ((let ((n (cadr (assoc 'name (car es)))))\n               (and (string? n) (string-contains n pattern)))\n             (loop (cdr es) (cons (car es) acc)))\n            (else (loop (cdr es) acc))))))\n(length (help-for \"world\"))"
     :math-composition "(:honest-null \"Help-index construction is a filter-project over a reflection record set; the operation is string search, not algebra. See :cs-composition for perm-slice.\")"
     :cs-composition "(define (verbs-by-kind required)\n  (let* ((reg (system/registry))\n         (entry-list (car (cdr (assoc 'entries reg)))))\n    (let loop ((es entry-list) (acc '()))\n      (cond ((null? es) (reverse acc))\n            ((equal? (cadr (assoc 'kind (car es))) required) (loop (cdr es) (cons (car es) acc)))\n            (else (loop (cdr es) acc))))))\n(length (verbs-by-kind 'impl))"
     :base "system/registry enumerates known verbs."
     :emergent "Help index (name substring) + perm-slice form the reflection-driven-docs family — Python help(), Javadoc, LSP servers, IDE autocomplete."
     :meta "Family: reflection-driven docs.")
    (:eng "Help indexes load-bearing for IDEs; log queries for usage analytics."
     :math "Projection over registry list."
     :cs "Help-index / reflection-driven docs."))
)

(verb
  :name "system/scheduler" :std "Motoi"
  :library "system"
  :kind "null"
  :signature "(system/scheduler) → {work, speech, Q_depth}"
  :summary "Query the scheduler's fuel tanks and queue depth — a window into her own pacing and load."
  :explanation "The scheduler is the engine that allocates thinking time. This verb returns a snapshot of three tanks: `work` (planning fuel), `speech` (response generation fuel), and `Q_depth` (pending task queue depth). Use it to reason about whether she is under load, approaching exhaustion, or able to take on new work. Values are null if the scheduler is unavailable (e.g., in a sandboxed context)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((sched (system/scheduler)))\n  (display sched))" :note "Inspect the scheduler state—three fuel tanks and queue depth.")
    (:dialect "motoi" :tier "intermediate" :code "(let* ((sched (system/scheduler))\n       (q (cadr (assoc 'Q_depth sched))))\n  (if (and (number? q) (< q 5))\n    'queue-is-shallow\n    'queue-is-deep))" :note "queue-is-deep — the snapshot is an assoc-list, so reach the field by name with assoc and take cadr, and guard the number? because every field is null when no scheduler is attached.")
    (:dialect "motoi" :tier "expert" :code "(define (think/shallow . args) 'shallow-thought)\n(define ... '...)\n(define (can-think-deeply?)\n  (let ((sched (system/scheduler)))\n    (and (number? (car sched))\n         (> (car sched) 0.5))))\n(if (can-think-deeply?) (think/deep ...) (think/shallow ...))" :note "Use work-fuel availability to gate expensive reasoning paths.")
  )
  :caveats ("All three fields may be null in sandboxed or offline contexts." "Queue depth reflects pending *internal* tasks, not user requests." "Fuel tanks deplete and refill asynchronously; a single read is a snapshot." "Do not rely on exact numeric values; use them only to reason about trends.")
  :drawbacks ("Non-deterministic; two identical calls may return different values." "Cannot directly control or reset fuel; only for observation." "Fuel semantics are internal and subject to change across interpreter versions.")
  :usecases ("Decide whether to offload a sub-task to a later frame." "Log system health during interactive sessions." "Implement graceful degradation when the queue is backing up." "Debug performance regressions by sampling scheduler state over time.")
  :related ("system/health" "system/cards" "system/registry")
  :learn (:concept "Self-awareness: the ability to introspect internal resource consumption." :prerequisites ("(core)" "system/health") :progression "Learn system/health next to see quarantine and fuel-exhaustion counts; then explore system/cards to map active work.")
  :row-2-audit (
    (:eng-program "(define sched (system/scheduler))\n(define w (cadr (assoc 'work sched)))\n(list ':snapshot sched ':decision (if (and (number? w) (> w 0.5)) 'deep 'shallow))"
     :math-program "(:honest-null \"system/scheduler returns a live snapshot of runtime fuel/queue tanks; the operation is a resource probe, not algebra. Row-2 math is honest-null.\")"
     :cs-program "(define (well-formed-scheduler? s) (and (list? s) (= (length s) 3)))\n(well-formed-scheduler? (system/scheduler))"
     :problem "Adaptive agent needs to decide deep vs shallow reasoning. Scheduler exposes fuel tanks and queue depth — the load signal."
     :explanation "eng: snapshot + decision. math: honest-null — resource probe is not algebra. cs: triple-shape check."
     :meta "system/health = quarantine/errors; system/scheduler = load/fuel. Different questions.")
    (:eng "Log scheduler snapshot at key decision points."
     :math "Triple of numbers or nulls."
     :cs "Scheduler introspection — getrusage, /proc/loadavg."))
  :row-3-dimension (
    (:setup "A load probe: read a summary of the system's current computational load."
     :rungs ((:domain "system (scheduler)" :code "(system/scheduler)")
             (:domain "kitchen: ticket depth on the rail" :code "(:honest-null \"system/scheduler returns a live snapshot of runtime fuel/queue tanks; the operation is a resource probe, not algebra. Row-2 math is honest-null.\")")
             (:domain "OS load average" :code "(:honest-null \"system/scheduler returns a live snapshot of runtime fuel/queue tanks; the operation is a resource probe, not algebra. Row-2 math is honest-null.\")"))
     :explanation "In Motoi, scheduler reports fuel/queue. In a kitchen, rail-depth reports pending tickets. On Unix, loadavg reports run-queue length. All three share the load-probe shape."
     :meta "The shape transfers wherever load must be reported."
     )
    (:eng "Log the load reading with every decision that depends on it."
     :math "The verb reports current values of finite bounded resources."
     :cs "The CS analog is load reporting."))
  :row-4-proof (
    (:eng-program "(define s (system/scheduler))\n(or (list? s) (vector? s) (pair? s))"
     :math-program "(:honest-null \"Scheduler-record schema is a metatheoretic type claim, not an algebraic identity. See :cs-program for schema stability witness.\")"
     :cs-program "(define (schema-shape s) (cond ((list? s) 'list) ((vector? s) 'vector) ((pair? s) 'pair) (else 'other)))\n(schema-shape (system/scheduler))"
     :claim "system/scheduler returns three values (or nulls when unavailable); shape is stable within an evaluation slice."
     :invariant "scheduler() has three fields {work, speech, Q_depth} ∧ shape stable"
     :meta "Scheduler-record schema. Falsified by any run with different arity.")
    (:eng "Smoke test: read is well-formed."
     :math "Fixed record schema."
     :cs "Scheduler-record invariant."))
  :row-5-emergence (
    (:eng-composition "(define (choose-path)\n  (let ((s (system/scheduler)))\n    (if (and s (pair? s) (number? (car s)) (> (car s) 0.5)) 'deep 'shallow)))\n(choose-path)"
     :math-composition "(:honest-null \"Adaptive-planner branching is a load-conditioned cond on scheduler snapshot; the operation is threshold gating on IO state, not algebra. See :cs-composition for backpressure loop.\")"
     :cs-composition "(define (backpressure-loop work)\n  (let loop ((remaining work))\n    (if (null? remaining) 'done\n      (let ((s (system/scheduler)))\n        (if (and s (pair? s) (number? (car s)) (> (car s) 0.3))\n          (loop (cdr remaining))\n          'shed)))))\n(backpressure-loop '(a b c))"
     :base "system/scheduler reports fuel/queue state."
     :emergent "Adaptive planner (deep/shallow) + backpressure shed form the adaptive-planning family — Netflix Concurrency Limits, TCP congestion control, Erlang flow-control."
     :meta "Family: adaptive planning.")
    (:eng "Log chosen path + driving metric."
     :math "Load-conditioned branch."
     :cs "Adaptive planning — TCP congestion, Netflix concurrency limits."))
)

(verb
  :name "system/surface" :std "Motoi"
  :library "system"
  :kind "null"
  :signature "(system/surface) → {cards, grid, entities, camera, ...}"
  :summary "Snapshot the entire surface in full detail — layers, cards, entities, camera, and metadata."
  :explanation "The surface is the dot-matrix world: all visible cards, grid state, entity positions, camera frame, and rendering context. This verb returns the complete state in one call. Use it for debugging, logging, or designing systems that respond to the world layout. Full detail means all nested fields are included; no abbreviation."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((surf (system/surface)))\n  (display surf))" :note "Inspect the full surface state—all cards, entities, and camera in one snapshot.")
    (:dialect "motoi" :tier "intermediate" :code "(let* ((surf (system/surface))\n       (cards (cadr (assoc 'cards surf))))\n  (map (lambda (c) (cadr (assoc 'id c))) cards))" :note "() on an empty surface — the snapshot is an assoc-list keyed by 'cards, 'camera, 'entities and 'grid, so reach a section by name rather than by position.")
    (:dialect "motoi" :tier "expert" :code "(define (surface-stable?)\n  (let* ((s1 (system/surface))\n         (s2 (begin (tick-frame) (system/surface))))\n    (equal? s1 s2)))\n(if (surface-stable?) 'no-change 'surface-changed)" :note "no-change on a still world — tick-frame advances the loop; on-frame is the verb that REGISTERS a handler and raises if handed anything but a procedure.")
  )
  :caveats ("Full detail is expensive; calling this every frame may impact performance." "The snapshot is stale the moment it returns; rapid world changes won't be captured." "Nested objects are deeply shared; modifying returned data does NOT mutate the world." "Camera and entity data are in world coordinates; card geometry is in screen space.")
  :drawbacks ("Non-deterministic; two calls may return different values if the surface is animating." "Full detail includes all nested fields, making the result large and hard to navigate." "Cheaper alternatives exist: use `camera-state`, `entity/all`, `world/count` if you only need one subsystem.")
  :usecases ("Serialize the world for replay or debugging." "Implement a system-level predictor that plans moves based on current geometry." "Log the surface state at key decision points." "Design a spectator or analytics card that displays world metrics.")
  :related ("camera-state" "entity/all" "world/count" "world/snapshot")
  :learn (:concept "Introspection: the ability to query the state of the rendered world without modifying it." :prerequisites ("(core)" "camera-state" "entity/all") :progression "Learn world/snapshot for entity-only state; then camera-state for camera-only queries; then world/each to iterate over entities efficiently.")
  :row-2-audit (
    (:eng-program "(define snap (system/surface))\n(list ':non-empty (not (null? snap)) ':shape (or (list? snap) (pair? snap)))"
     :math-program "(:honest-null \"system/surface returns a full-world runtime snapshot; the operation is heap-serialization, not algebra. Row-2 math is honest-null.\")"
     :cs-program "(define (snapshot-size s) (if (pair? s) (length s) 0))\n(snapshot-size (system/surface))"
     :problem "Bug-report tool needs full surface state attached to crash reports — cards, entities, camera. system/cards is cards-only; system/scheduler is fuel-only. system/surface is the wide read."
     :explanation "eng: snapshot + non-empty witness. math: honest-null — serialization is not algebra. cs: size probe."
     :meta "Bug reports where completeness > performance. Same slot as heap dump or Redux state serialization.")
    (:eng "Full-state snapshot for post-mortem; log stringified on crash."
     :math "Nullary function into large record."
     :cs "World snapshot — heap dumps, Redux state serializations."))
  :row-3-dimension (
    (:setup "A full-state snapshot: capture everything, at once, for offline analysis or replay."
     :rungs ((:domain "system (surface)" :code "(system/surface)")
             (:domain "crime scene photograph" :code "(:honest-null \"system/surface returns a full-world runtime snapshot; the operation is heap-serialization, not algebra. Row-2 math is honest-null.\")")
             (:domain "database backup" :code "(:honest-null \"system/surface returns a full-world runtime snapshot; the operation is heap-serialization, not algebra. Row-2 math is honest-null.\")"))
     :explanation "In Motoi the snapshot is the full surface. In investigation, a wide-angle photograph captures everything. In databases, pg_dump captures everything. All three share the shape of 'capture everything now.'"
     :meta "The shape transfers wherever a complete state must be preserved for later reasoning."
     )
    (:eng "Log the snapshot size; large snapshots can indicate world bloat."
     :math "The verb returns a record aggregate."
     :cs "The CS analog is full-state serialization."))
  :row-4-proof (
    (:eng-program "(define s (system/surface))\n(not (null? s))"
     :math-program "(:honest-null \"Snapshot-non-empty is a runtime existence claim, not an algebraic identity. See :cs-program for stability across immediate re-reads.\")"
     :cs-program "(define (surface-stable-schema? n)\n  (let loop ((i 0) (schemas '()))\n    (if (>= i n) (or (null? schemas) (equal? (car schemas) (car (last-pair schemas))))\n      (loop (+ i 1) (cons (if (pair? (system/surface)) 'record 'other) schemas)))))\n(surface-stable-schema? 3)"
     :claim "system/surface returns a non-empty aggregate; schema is stable across immediate re-reads."
     :invariant "surface() ≠ nil ∧ schema(surface()) stable within a slice"
     :meta "Snapshot-non-empty + schema-stability. Falsified by null return or schema drift.")
    (:eng "Smoke test: snapshot present."
     :math "Aggregate exists."
     :cs "Snapshot presence."))
  :row-5-emergence (
    (:eng-composition "(define before (system/surface))\n(define after (system/surface))\n(equal? before after)"
     :math-composition "(:honest-null \"State-diff detection is equality on a runtime snapshot pair; the operation is byte-comparison, not algebra. See :cs-composition for animation-settled loop.\")"
     :cs-composition "(define (wait-for-settle max-tries)\n  (let loop ((i 0) (prev (system/surface)))\n    (cond ((>= i max-tries) 'timeout)\n          ((equal? prev (system/surface)) 'settled)\n          (else (loop (+ i 1) (system/surface))))))\n(wait-for-settle 3)"
     :base "system/surface returns full world snapshot."
     :emergent "Diff detector + settle-loop form the state-diff family — React reconciliation, git diff, EventSourcing diffs, animation-settled detection."
     :meta "Family: state-diff detection.")
    (:eng "Log diffs when they occur — settlement moments are decision points."
     :math "Equality check on state manifold."
     :cs "State-diff detection — React reconciliation, git diff."))
)


(verb
  :name "bricklay-pack-native" :std "Motoi"
  :library "system"
  :kind "pure"
  :status "needs-alfred"
  :signature "(bricklay-pack-native cards vw margin-x margin-y gap-x gap-y) -> [(id x y) ...]"
  :summary "Pack a list of (id width height) cards into a viewport and return where each one goes, as (id x y) triples in placement order."
  :explanation "This is the surface's layout engine, moved into the host for speed. You hand it the cards in the order you want them considered — the caller sorts, the packer does not — plus the effective viewport width and the four spacing numbers, and it hands back one (id x y) triple per card telling you where the top-left corner lands. The rule it follows is a bricklayer's: the first card goes at the margin, and every card after it takes the highest, then leftmost, free anchor that does not overlap anything already placed and does not run past the right margin. Anchors are only ever created to the right of and below a card that has already been placed, which is what keeps the wall tight instead of leaving holes. Nothing is drawn and nothing is mutated — the answer is a plan, and system/cards is where you look to see what the surface actually did with it."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(bricklay-pack-native (list (list 'a 100 50) (list 'b 100 50)) 320 10 10 8 8)" :note "((a 10 10) (b 118 10)) — the first card sits at the margin, the second to its right at 10 + 100 + 8.")
    (:dialect "motoi" :tier "apprentice" :code "(bricklay-pack-native (list) 320 10 10 8 8)" :note "() — no cards, no placements; the empty plan is a valid plan.")
    (:dialect "motoi" :tier "intermediate" :code "(bricklay-pack-native (list (list 'a 100 50) (list 'b 100 50) (list 'c 100 50)) 320 10 10 8 8)" :note "((a 10 10) (b 118 10) (c 10 68)) — a third card will not fit on the row, so it wraps to the anchor below the first: y = 10 + 50 + 8.")
    (:dialect "motoi" :tier "expert" :code "(bricklay-pack-native (list (list 'wide 400 40) (list 'small 50 20)) 200 10 10 8 8)" :note "((wide 10 18) (small 10 66)) — a card wider than the viewport is placed anyway, on the fallback row; note the y of 18, not 10, which is a quirk documented in :caveats.")
    (:dialect "motoi" :tier "master" :code "(define (plan-heights cards vw)\n  (map (lambda (p) (caddr p))\n       (bricklay-pack-native cards vw 10 10 8 8)))\n(display (plan-heights (list (list 'a 100 50) (list 'b 100 50) (list 'c 100 50)) 320))\n(newline)" :note "(10 10 68) — pulling the y out of each triple shows the row structure: two cards on the first row, one on the second.")
  )
  :caveats ("AS OF 2026-08-02 MALFORMED CARDS ARE SILENTLY DROPPED. An entry that is not a list is skipped, and so is one whose width or height is not a finite number: (bricklay-pack-native (list (list 'a \"x\" 10)) 200 5 5 5 5) answers () for a one-card input. The output can therefore be SHORTER than the input with no error and no record of what went missing. Compare lengths yourself. Marked needs-alfred." "AS OF 2026-08-02 A NON-LIST cards ARGUMENT ANSWERS () INSTEAD OF RAISING: (bricklay-pack-native 5 200 5 5 5 5) is (). An empty plan and a type error look identical to the caller. Marked needs-alfred." "AS OF 2026-08-02 THE FALLBACK ROW ADDS A GAP THAT IS NOT THERE. When no anchor fits — a card wider than the viewport, for instance — the card is placed at (margin-x, max-bottom + gap-y) with max-bottom seeded to margin-y. For the FIRST card that means y = margin-y + gap-y, so an over-wide first card lands one gap lower than a card that fitted would have. Marked needs-alfred." "The caller decides the order. The packer places cards in exactly the order given and never reorders for a better fit, so the quality of the wall is the quality of your sort." "A card wider than the usable width is placed rather than refused; it will overhang the right margin." "Results are memoised on a hash of the arguments, so an identical call returns the SAME list object rather than a fresh one. Treat the plan as read-only." "Coordinates are the top-left corner of each card, in the same pixel units as the viewport width.")
  :drawbacks ("O(N²) in the number of cards — every placement scans every anchor against every placed card. Fine for a surface's worth of cards, wrong for thousands." "Greedy and single-pass: it never backtracks, so a bad ordering leaves holes it will not come back to fill." "No row-height alignment, no centring and no justification; cards of differing heights leave a ragged bottom edge." "Returns positions only. Widths and heights are not echoed back, so you must keep the input list to know how big anything is.")
  :usecases ("Lay out the card fleet on the Motoi surface after a resize or a new card opens." "Precompute a layout plan in Scheme before committing it, so it can be inspected or diffed." "Reflow a set of variably-sized panels into a fixed-width column.")
  :related ("system/cards" "system/surface" "grid/card-center" "entity/all")
  :learn (:concept "Greedy bin packing: place each item at the best currently-available anchor and never look back; fast, simple, and provably not optimal." :prerequisites ("list" "map" "system/cards") :progression "Read the plan this verb returns, then compare it with what system/cards reports the surface actually did, then vary the sort order of the input to see how much the greedy result depends on it.")
  :row-2-audit (
   (:problem "The window was resized and every open card must find a new home. The operator needs the whole arrangement computed at once, before anything moves, so the surface can be repainted in one pass instead of shuffling cards one at a time on screen."
    :eng-program "(define cards (list (list 'editor 200 120) (list 'console 100 60) (list 'help 100 60)))\n(display (bricklay-pack-native cards 320 10 10 8 8))\n(newline)"
    :math-program "(define (plan-is-total? cards vw)\n  (= (length cards) (length (bricklay-pack-native cards vw 10 10 8 8))))\n(display (list (plan-is-total? (list (list 'a 40 20) (list 'b 40 20)) 200)\n               (plan-is-total? (list (list 'a \"bad\" 20)) 200)))\n(newline)"
    :cs-program "(define (checked-plan cards vw)\n  (let ((plan (bricklay-pack-native cards vw 10 10 8 8)))\n    (if (= (length plan) (length cards)) plan 'cards-dropped)))\n(display (checked-plan (list (list 'a 40 20) 'junk) 200))\n(newline)"
    :explanation "eng: one call produces the whole arrangement, so nothing is drawn until every position is known. math: the plan is NOT total — a malformed card vanishes from the output, which the second case exposes. cs: compare the lengths yourself, because the verb will not tell you it dropped anything."
    :meta "Reach for bricklay-pack-native and NOT system/cards: system/cards reports where cards ARE, which is a reading of the past. This verb computes where they SHOULD go, which is a proposal about the future. Reading positions back and nudging them one at a time is how a reflow turns into a visible shuffle.")
   (:eng "Compute the whole plan, then commit it, so the user sees one repaint rather than N moves."
    :math "A map from (id, w, h) triples to (id, x, y) triples — total only when every input is well formed."
    :cs "A pure planning step separated from the effectful commit — the shape that makes layout testable."))
  :row-3-dimension (
   (:setup "The shape is 'place items one at a time at the best free anchor, never backtracking'."
    :rungs (
      (:domain "surface layout (this verb)" :code "(display (bricklay-pack-native (list (list 'a 60 30) (list 'b 60 30)) 200 5 5 5 5))\n(newline)")
      (:domain "typesetting — words filling a line before wrapping" :code "(define (wrap widths line-width)\n  (let loop ((ws widths) (x 0) (rows 1))\n    (cond ((null? ws) rows)\n          ((> (+ x (car ws)) line-width) (loop (cdr ws) (car ws) (+ rows 1)))\n          (else (loop (cdr ws) (+ x (car ws)) rows)))))\n(display (list 'rows (wrap (list 40 40 40 40) 100)))\n(newline)")
      (:domain "warehousing — cartons onto a pallet, tallest-first" :code "(define (fits? used capacity size) (<= (+ used size) capacity))\n(display (list (fits? 80 100 15) (fits? 80 100 30)))\n(newline)"))
    :explanation "A surface packs cards, a typesetter packs words into lines, a loader packs cartons onto a pallet. All three walk the items in a given order, take the first position that fits, and move on. None of them reconsiders an earlier choice, which is why all three depend on the order they were handed."
    :meta "Greedy packing is the same family everywhere: cheap, order-sensitive, and never optimal.")
   (:eng "The sort you apply before packing matters more than the packer does."
    :math "Bin packing is NP-hard; first-fit is a bounded-ratio approximation, not a solution."
    :cs "First-fit-decreasing — the standard practical heuristic in this family."))
  :row-4-proof (
   (:claim "The plan preserves the order and the identity of every well-formed card, and the first well-formed card that fits lands exactly on the margin."
    :eng-program "(define cards (list (list 'a 100 50) (list 'b 100 50) (list 'c 100 50)))\n(define plan (bricklay-pack-native cards 320 10 10 8 8))\n(display (equal? (map car plan) (map car cards)))\n(newline)"
    :math-program "(define (first-on-margin? w h vw mx my)\n  (let ((plan (bricklay-pack-native (list (list 'x w h)) vw mx my 8 8)))\n    (equal? (car plan) (list 'x mx my))))\n(display (list (first-on-margin? 80 40 300 12 12)\n               (first-on-margin? 80 40 300 0 0)))\n(newline)"
    :cs-program "(define (deterministic? cards vw)\n  (equal? (bricklay-pack-native cards vw 10 10 8 8)\n          (bricklay-pack-native cards vw 10 10 8 8)))\n(display (deterministic? (list (list 'a 40 20) (list 'b 90 30)) 200))\n(newline)"
    :invariant "∀ lists of well-formed cards. map(car, plan) = map(car, cards), and a first card narrow enough to fit is placed at exactly (margin-x, margin-y)"
    :meta "Order-and-identity-preservation pattern: the plan is a relabelling of the input, not a rearrangement of it, which is what lets the caller zip the two lists together. Falsified by any well-formed input whose ids come back in a different order — or by a malformed one, which is dropped instead; see :caveats.")
   (:eng "Because the order is preserved you can zip the plan back onto the original widths and heights."
    :math "A structure-preserving map on the well-formed subset of the input."
    :cs "Deterministic and memoised: the same arguments always yield the same plan, which is what makes it cacheable."))
  :row-5-emergence (
   (:base "bricklay-pack-native turns a list of card sizes into a list of card positions."
    :eng-composition "(define (plan-bounds cards vw)\n  (let ((plan (bricklay-pack-native cards vw 10 10 8 8)))\n    (list 'widest (apply max (map cadr plan))\n          'lowest (apply max (map caddr plan)))))\n(display (plan-bounds (list (list 'a 100 50) (list 'b 100 50) (list 'c 100 50)) 320))\n(newline)"
    :math-composition "(define (rows-used cards vw)\n  (length\n    (fold (lambda (y acc) (if (member y acc) acc (cons y acc)))\n          (list)\n          (map caddr (bricklay-pack-native cards vw 10 10 8 8)))))\n(display (rows-used (list (list 'a 100 50) (list 'b 100 50) (list 'c 100 50)) 320))\n(newline)"
    :cs-composition "(define (compare-widths cards)\n  (list 'narrow (length (bricklay-pack-native cards 200 10 10 8 8))\n        'wide (length (bricklay-pack-native cards 640 10 10 8 8))))\n(display (compare-widths (list (list 'a 100 50) (list 'b 100 50) (list 'c 100 50))))\n(newline)"
    :emergent "A reflow preview emerges: plan the same cards against several candidate viewport widths and read off how tall each arrangement would be, without moving anything on screen. Choosing the width that needs the fewest rows is a layout decision made entirely in Scheme."
    :meta "This is the plan-then-commit family — compute the whole effect purely, inspect it, and only then apply it; the same discipline as a database transaction or a dry-run deploy.")
   (:eng "Previewing several widths costs nothing visible, because no card has moved yet."
    :math "The distinct y values in the plan are exactly the rows the wall used."
    :cs "Purity is what makes the preview possible; the commit stays a separate, effectful step.")))

;; ═══ 3 cart persistence verbs (added 2026-08-02) ═══

(verb
  :name "save-cart" :std "Motoi"
  :library "system"
  :kind "state-change"
  :signature "(save-cart name) -> string"
  :summary "Write a snapshot of the framebuffer and audio state to a sandboxed cart file, returning the absolute path written."
  :explanation "save-cart serialises the current media state — the framebuffer pixels and an audio snapshot — into a small file under the user's cart directory, and returns the absolute path it wrote. The argument is a BARE FILENAME, never a path: anything containing a slash or a backslash, and anything beginning with a dot, and anything containing a character outside [A-Za-z0-9._-] is rejected outright. The rejection matters: unsafe characters used to be replaced with an underscore, which made two different names — \"my cart!\" and \"my_cart_\" — land on the same file, so the second save silently destroyed the first and reported success. The file itself is a prose header followed by a #!json-blob marker and a JSON payload, which is what makes load-cart able to read it back. save-cart carries the paint permission, so a sandboxed or untrusted context cannot call it at all."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(string? (save-cart \"demo\"))" :note "#t — the return value is the absolute path that was written, as a string.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (save-cart \"cart-a1\") (string? (load-cart \"cart-a1\")))" :note "#t — what save-cart writes, load-cart reads back.")
    (:dialect "motoi" :tier "expert" :code "(guard (e (#t 'rejected)) (save-cart \"my cart!\"))" :note "rejected — a name carrying a character outside [A-Za-z0-9._-] is refused rather than rewritten, so no two names can land on one file.")
  )
  :caveats ("The argument is a bare filename. (save-cart \"a/b\"), (save-cart \"../evil\") and (save-cart \".hidden\") all RAISE \"save-cart: invalid cart name (must be a bare filename)\"." "A character outside [A-Za-z0-9._-] makes the whole name invalid and the call raises. Nothing is rewritten, so two distinct names can never collide on one file." "Only the framebuffer and an audio snapshot are saved. Your definitions, variables and program text are NOT in the cart — this is a state snapshot, not a program." "The destination is the user's cart directory, which follows MOTOI_HOME. Set MOTOI_HOME to a temp dir before any batch run or you write into the real user tree." "An existing cart of the same name is overwritten with no confirmation." "The verb carries the paint permission, so untrusted and external tiers cannot call it." "The returned path is machine-specific. Never assert on its text; assert that it is a string.")
  :drawbacks ("Names are refused rather than repaired, so a name a user typed with a space has to be retyped rather than quietly accepted." "Saving only the framebuffer and audio means a cart cannot restore a running program, which is what most people expect from the word cart." "No versioning or backup: a second save under the same name destroys the first.")
  :usecases ("Capturing a rendered frame plus its audio state so a later session can restore it." "Checkpointing a demo between scenes." "Producing a fixture for a load-cart round-trip test.")
  :related ("load-cart" "load-community-cart" "sync" "tick-frame" "system/health")
  :learn (:concept "A sandboxed writer takes a NAME, not a path — the runtime decides where, and that is what makes it safe to expose to untrusted code." :prerequisites ("load-cart") :progression "Learn save-cart with load-cart beside it, always as a round trip, then read the sanitisation rules before choosing cart names.")
  :provenance "Motoi-own; lib/media/media.js save-cart, sandboxed by _safeCartPath into userCartsDir(). Authored 2026-08-02 from the implementation."
  :row-2-audit (
    (:problem "A cart must be persisted from a context that also runs code the operator does not control, so the write must not be able to escape a known directory."
     :eng-program "(let ((p (save-cart \"cart-b1\"))) (string? p))"
     :math-program "(let ((a (save-cart \"cart-b2\")) (b (save-cart \"cart-b2\"))) (equal? a b))"
     :cs-program "(let ((p (save-cart \"cart-b3\"))) (> (string-length p) 0))"
     :explanation "Passing a bare name means the caller never chooses a directory, so no argument can point the write anywhere else. The math program shows the mapping from name to path is a function: the same name always yields the same file."
     :meta "Reaching for a general file-write verb would hand the caller the whole filesystem, which is exactly what the sandbox exists to prevent. save-cart is the honest verb because the destination is the runtime's decision, not the caller's.")
    (:eng "Take a name, not a path, whenever the caller might be hostile."
     :math "The name-to-path map is a function into one fixed directory."
     :cs "Capability narrowing at the API boundary beats validation after the fact."))
  :row-3-dimension (
    (:setup "Constraining a caller-supplied identifier to a safe namespace is a shape that repeats wherever untrusted input names a resource."
     :rungs (
       (:domain "cart file" :code "(string? (save-cart \"cart-c1\"))")
       (:domain "frame rate" :code "(set-frame-rate 500)")
       (:domain "voice count" :code "(slat-key (song/config :voices 40) 'voices)")
     )
     :explanation "Each rung takes a request that could be out of bounds and forces it into a legal one: a name into a sanitised filename, a rate into 1..120, a voice count into 1..16. Two of the three report the coerced value; the cart path does too, in its return value."
     :meta "The dimension is the resource, but the discipline — coerce, then report what you coerced to — is the same.")
    (:eng "Coerce into the legal range and tell the caller what you chose."
     :math "Each is a retraction onto an admissible subset."
     :cs "Input normalisation belongs at the boundary, not scattered downstream."))
  :row-4-proof (
    (:claim "save-cart returns a string path, the same name always maps to the same path, and a traversal attempt never produces one."
     :eng-program "(let ((a (save-cart \"cart-d1\")) (b (save-cart \"cart-d1\"))) (list (string? a) (equal? a b)))"
     :math-program "(guard (e (#t 'rejected)) (save-cart \"cart d2\"))"
     :cs-program "(let ((p (save-cart \"cart-d3\"))) (and (string? p) (> (string-length p) 0)))"
     :invariant "For every accepted name n, (save-cart n) returns a string under the cart directory, and equal names give equal paths; names containing / or \\ or a leading dot or any character outside [A-Za-z0-9._-] are rejected rather than sanitised."
     :meta "The math program is the half that proves injectivity: the name that WOULD have collided is refused, so no two distinct accepted names can share a path.")
    (:eng "Test the rejection, because rejection is what makes the mapping safe to depend on."
     :math "The name-to-path map is injective on its domain; nothing is lost because nothing is rewritten."
     :cs "Any lossy normalisation admits collisions, and collisions must be documented."))
  :row-5-emergence (
    (:base "save-cart alone writes a file. Chained with load-cart it becomes a round trip."
     :eng-composition "(begin (save-cart \"cart-e1\") (string? (load-cart \"cart-e1\")))"
     :math-composition "(let ((w (save-cart \"cart-e2\"))) (equal? w (load-cart \"cart-e2\")))"
     :cs-composition "(begin (tick-frame) (save-cart \"cart-e3\") (string? (load-cart \"cart-e3\")))"
     :emergent "A checkpoint: because both verbs agree on the name-to-path map, the write path and the read path are the same string, and a snapshot taken now can be restored later with no bookkeeping at all."
     :meta "Emergence is that a shared sanitiser turns two independent verbs into a matched pair.")
    (:eng "Two verbs that share a naming rule need no shared state to agree."
     :math "The round trip is the composition of the write and read maps, and it is the identity on the path."
     :cs "Serialisation is only useful when the reader and writer are provably paired."))
)

(verb
  :name "load-cart" :std "Motoi"
  :library "system"
  :kind "state-change"
  :signature "(load-cart name) -> string"
  :summary "Restore framebuffer and audio state from a sandboxed cart file, returning the absolute path read."
  :explanation "load-cart is the read half of save-cart. It applies the same bare-filename sandbox — no slashes, no leading dot, and no character outside [A-Za-z0-9._-], all of which are rejected outright rather than rewritten — resolves the name under the user's cart directory, parses the file's #!json-blob payload, and installs the framebuffer and audio state it finds. The framebuffer is rebuilt and reattached to the animation loop, and the audio snapshot is restored. The return value is the absolute path that was read, which is exactly the string save-cart returned for the same name. Like save-cart it carries the paint permission."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (save-cart \"cart-f1\") (string? (load-cart \"cart-f1\")))" :note "#t — load-cart returns the path it read, as a string.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((w (save-cart \"cart-f2\"))) (equal? w (load-cart \"cart-f2\")))" :note "#t — the write path and the read path for one name are the same string.")
    (:dialect "motoi" :tier "expert" :code "(begin (tick-frame) (save-cart \"cart-f3\") (load-cart \"cart-f3\") (sync))" :note "1 — loading a cart restores the framebuffer but does NOT rewind the loop's frame counter.")
  )
  :caveats ("Loading a name that was never saved RAISES a raw filesystem error whose message includes the absolute path — a nonexistent cart is not a soft failure." "The argument is a bare filename. (load-cart \"a/b\") and (load-cart \"../x\") RAISE \"load-cart: invalid cart name (must be a bare filename)\"." "This is NOT a network fetch. load-cart reads only the local cart directory; nothing is downloaded. load-community-cart is the network-facing name, and it is a stub." "Only framebuffer and audio are restored. No definitions, no variables, no program." "The frame counter is not restored or rewound. sync still reports whatever tick-frame left it at." "A file without the #!json-blob marker, or with a payload missing a framebuffer, raises a specific parse error rather than loading partially." "The source directory follows MOTOI_HOME, so a batch run must set it or it reads the real user tree.")
  :drawbacks ("Errors surface as raw filesystem messages with absolute paths, which is noisy and leaks the layout of the machine." "No way to list the available carts, so a caller must already know the name." "Restoring only pixels and audio means a loaded cart cannot resume a program, only a picture.")
  :usecases ("Restoring a saved frame at the start of a session." "Round-tripping a snapshot in a test to prove the serialiser is lossless." "Loading a fixture image before running a rendering assertion.")
  :related ("save-cart" "load-community-cart" "sync" "tick-frame" "system/health")
  :learn (:concept "A reader and a writer that share one naming rule form a matched pair; the shared rule is the contract." :prerequisites ("save-cart") :progression "Learn load-cart only as the second half of a round trip with save-cart, then read the error cases — a missing cart raises rather than returning a sentinel.")
  :provenance "Motoi-own; lib/media/media.js load-cart, sandboxed by _safeCartPath, parsing the #!json-blob payload via slatToCart. Authored 2026-08-02 from the implementation."
  :row-2-audit (
    (:problem "A test needs a known framebuffer before it asserts anything, and it must not depend on whatever the previous test left behind."
     :eng-program "(begin (save-cart \"cart-g1\") (string? (load-cart \"cart-g1\")))"
     :math-program "(let ((w (save-cart \"cart-g2\"))) (equal? w (load-cart \"cart-g2\")))"
     :cs-program "(begin (save-cart \"cart-g3\") (load-cart \"cart-g3\") (sync))"
     :explanation "Saving a known state and loading it back gives the test a fixed starting point that does not depend on execution order. The cs program shows what is NOT restored: the frame counter stays where it was, so state and time are separate concerns."
     :meta "Reaching for load-community-cart instead would hit a stub that returns an error record, never a framebuffer. load-cart is the honest verb because the fixture is local and the read is real.")
    (:eng "Establish the fixture, then assert; never inherit state from a neighbour."
     :math "The load is a section of the save; together they pin the state."
     :cs "Test isolation requires an explicit setup step, not a hopeful one."))
  :row-3-dimension (
    (:setup "Restoring state from a named external record appears at several scales in this runtime."
     :rungs (
       (:domain "cart file" :code "(begin (save-cart \"cart-h1\") (string? (load-cart \"cart-h1\")))")
       (:domain "community stub" :code "(symbol? (slat-key (load-community-cart \"demo\") 'kind))")
       (:domain "song config" :code "(slat-key (song/config :bpm 90) 'bpm)")
     )
     :explanation "The first genuinely reads a file; the second is a stub that returns an error record instead of fetching; the third builds a record in memory with no I/O at all. Three points on a scale from real persistence to none, all wearing similar shapes."
     :meta "The dimension is how much of the outside world the verb actually touches — and two of these three touch none of it.")
    (:eng "Know which of your loaders actually loads."
     :math "Only one of the three is a partial function on the filesystem; the others are total."
     :cs "A stub with a convincing shape is the most expensive kind of stub."))
  :row-4-proof (
    (:claim "load-cart returns the same path save-cart returned for the same name, and does not alter the frame counter."
     :eng-program "(let ((w (save-cart \"cart-i1\"))) (equal? w (load-cart \"cart-i1\")))"
     :math-program "(begin (save-cart \"cart-i2\") (let ((a (load-cart \"cart-i2\")) (b (load-cart \"cart-i2\"))) (equal? a b)))"
     :cs-program "(begin (tick-frame) (tick-frame) (save-cart \"cart-i3\") (load-cart \"cart-i3\") (sync))"
     :invariant "For every accepted name n, (load-cart n) equals (save-cart n) as a string, loading is idempotent, and the animation frame counter is unchanged by the load."
     :meta "The cs program pins the negative claim — that loading does not rewind time — because that is the assumption a reader is most likely to make and be wrong about.")
    (:eng "Pin what the verb does NOT do, not only what it does."
     :math "Idempotence of the load, and independence from the frame counter."
     :cs "Two orthogonal pieces of state must be shown to be orthogonal."))
  :row-5-emergence (
    (:base "load-cart alone restores pixels. Chained with save-cart and the loop it becomes a checkpoint-and-resume."
     :eng-composition "(begin (tick-frame) (save-cart \"cart-j1\") (tick-frame) (load-cart \"cart-j1\") (sync))"
     :math-composition "(let ((w (save-cart \"cart-j2\"))) (list (equal? w (load-cart \"cart-j2\")) (equal? w (load-cart \"cart-j2\"))))"
     :cs-composition "(begin (save-cart \"cart-j3\") (load-cart \"cart-j3\") (load-cart \"cart-j3\") (string? (load-cart \"cart-j3\")))"
     :emergent "A checkpoint that restores the picture but not the clock: the eng program saves at frame 1, advances to frame 2, loads, and still reports frame 2. Anyone building undo on top of this must save the clock themselves."
     :meta "Emergence here is a warning rather than a gift — the composition reveals a gap the individual verbs hide.")
    (:eng "Compose the verbs and see what the pair forgets to carry."
     :math "The restore is a projection: it covers one component of the state, not all of it."
     :cs "Partial snapshots make partial undo, which is worse than none if undocumented."))
)

(verb
  :name "load-community-cart" :std "Motoi"
  :library "system"
  :kind "pure"
  :status "needs-alfred"
  :status-note "NOT IMPLEMENTED. The name promises a fetch from a community registry; the implementation in src/slat-verbs.js is a pure local stub that touches no network and no filesystem, and unconditionally returns the SLAT error record (:_form \"error\" :kind not-yet-implemented :message \"...the community registry is not wired yet (Book of SLAT §16 forward-looking)...\" :requested <id>). It returns a value rather than raising, so a caller who does not inspect the result will treat the failure as a cart. Documented here as it actually behaves; whether to wire the registry or rename the verb needs Alfred's ruling."
  :signature "(load-community-cart id) -> error-record"
  :summary "Placeholder for fetching a cart from the community registry; currently always returns a not-yet-implemented error record and performs no I/O."
  :explanation "load-community-cart is a forward-looking name with no implementation behind it. Every call, whatever the id, returns the same shape of SLAT error record: a :_form of \"error\", a :kind of not-yet-implemented, a :message naming Book of SLAT §16, and a :requested field echoing the id you asked for. It makes no network request, opens no socket and reads no file, so it is safe to call anywhere — but it never produces a cart. Because it RETURNS rather than raises, code that does not check the result will carry the error record forward as if it were data."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(slat-key (load-community-cart \"demo\") '_form)" :note "\"error\" — every call returns an error record, whatever the id.")
    (:dialect "motoi" :tier "intermediate" :code "(symbol? (slat-key (load-community-cart \"demo\") 'kind))" :note "#t — the :kind field is the symbol not-yet-implemented.")
    (:dialect "motoi" :tier "expert" :code "(slat-key (load-community-cart \"anything\") 'requested)" :note "\"anything\" — the id is echoed back in :requested, which is the only part of the input that survives.")
  )
  :caveats ("It ALWAYS fails. There is no id that produces a cart; the registry is not wired." "It returns an error record instead of raising, so an unchecked call looks like success. Always read :_form or :kind before using the result." "It performs NO network and NO filesystem access. Calling it is safe, but calling it is also pointless until the registry exists." "The result is not a cart and cannot be handed to load-cart. load-cart takes a local bare filename." "The record is a plain SLAT error record; read its fields with slat-key, since it prints opaquely.")
  :drawbacks ("A verb that returns an error value rather than raising invites unchecked use, which is the failure mode most likely to reach production." "The name promises network behaviour that does not exist, so reading the registry alone would mislead an author." "There is no capability flag or guard distinguishing it from a verb that would genuinely reach the network, so a future implementation changes its risk profile silently.")
  :usecases ("Writing code today against the shape the registry will eventually return." "Demonstrating the SLAT error-record convention with a verb that always produces one." "Asserting in a test that the community path is still unwired, so the day it lands is noticed.")
  :related ("load-cart" "save-cart" "slat-key" "system/registry" "system/health")
  :learn (:concept "A verb that returns its failure instead of raising it puts the checking burden on every caller — read the tag before you read the value." :prerequisites ("slat-key" "load-cart") :progression "Learn load-community-cart as an example of the SLAT error record, then always pair a call with a :kind check, which is the habit the real registry will also require.")
  :provenance "Motoi-own; src/slat-verbs.js loadCommunityCartVerb, a constant-returning stub with no network path. Authored 2026-08-02 from the implementation."
  :row-2-audit (
    (:problem "A cart wants to offer community downloads, and the author must find out whether that path works before building a UI on top of it."
     :eng-program "(let ((r (load-community-cart \"demo\"))) (list (slat-key r '_form) (symbol? (slat-key r 'kind))))"
     :math-program "(let ((a (load-community-cart \"x\")) (b (load-community-cart \"y\"))) (equal? (slat-key a 'kind) (slat-key b 'kind)))"
     :cs-program "(let ((r (load-community-cart \"demo\"))) (if (equal? (slat-key r '_form) \"error\") 'unavailable 'loaded))"
     :explanation "Reading the :_form tag before using the result turns a silent failure into a branch the author can see. The math program shows the failure is unconditional: two different ids produce the same :kind, so no id is special."
     :meta "Reaching for load-cart would be the honest verb IF the cart is local — it genuinely reads a file. load-community-cart is the right name for the future and the wrong call today, and the check is what makes that visible.")
    (:eng "Check the tag before you trust the value."
     :math "A constant function: the same failure for every input."
     :cs "Tagged results demand a branch; ignoring the tag is a latent bug."))
  :row-3-dimension (
    (:setup "Returning a tagged failure rather than raising is a convention worth recognising across the runtime."
     :rungs (
       (:domain "community stub" :code "(slat-key (load-community-cart \"demo\") '_form)")
       (:domain "composer clamp" :code "(slat-key (song/config :voices 40) 'warnings)")
       (:domain "easing miss" :code "(tick/ease 'no-such-curve 0.5)")
     )
     :explanation "Each rung reports a problem in its return value rather than raising: an error record, a warnings list, a 'nan symbol. All three keep the program running, and all three are invisible to a caller who does not look."
     :meta "The dimension is the shape of the report, not whether there is one.")
    (:eng "Soft failures need a hard habit of checking."
     :math "The codomain includes the failure, so the function is total but not always useful."
     :cs "Errors-as-values shift the burden from the callee to every caller."))
  :row-4-proof (
    (:claim "Every call returns the same error record shape, regardless of id, and the id survives only in :requested."
     :eng-program "(let ((r (load-community-cart \"demo\"))) (list (slat-key r '_form) (slat-key r 'requested)))"
     :math-program "(let ((a (load-community-cart \"alpha\")) (b (load-community-cart \"beta\"))) (list (equal? (slat-key a '_form) (slat-key b '_form)) (equal? (slat-key a 'requested) (slat-key b 'requested))))"
     :cs-program "(symbol? (slat-key (load-community-cart \"anything\") 'kind))"
     :invariant "For every id, (load-community-cart id) returns a record with :_form \"error\" and :kind not-yet-implemented, differing between calls only in :requested."
     :meta "The math program asserts one equality and one INEQUALITY in the same breath, which is the compact way to say 'constant except for the echo'.")
    (:eng "Prove what varies and what does not, in one expression."
     :math "The map is constant on all fields but one, where it is the identity."
     :cs "A stub's contract is still a contract, and pinning it makes the real implementation's arrival visible."))
  :row-5-emergence (
    (:base "load-community-cart alone always fails. Chained with a local fallback it becomes a graceful degradation."
     :eng-composition "(define (get-cart id local) (let ((r (load-community-cart id))) (if (equal? (slat-key r '_form) \"error\") (begin (save-cart local) (load-cart local)) r)))\n(string? (get-cart \"demo\" \"cart-k1\"))"
     :math-composition "(define (available? id) (not (equal? (slat-key (load-community-cart id) '_form) \"error\")))\n(list (available? \"a\") (available? \"b\"))"
     :cs-composition "(define (source-of id) (if (equal? (slat-key (load-community-cart id) '_form) \"error\") 'local 'community))\n(source-of \"demo\")"
     :emergent "A fallback chain: try the community, detect the tagged failure, fall back to a local save-and-load. The cart still opens, and the day the registry is wired the same code silently starts preferring it."
     :meta "Emergence is forward compatibility — a branch written against the failure tag needs no edit when the failure stops happening.")
    (:eng "Write the fallback now and the upgrade costs nothing later."
     :math "Case analysis on the tag makes the two sources interchangeable."
     :cs "Graceful degradation is a branch, not an exception handler."))
)

(verb
  :name "http/serve" :std "Motoi"
  :library "system"
  :kind "io"
  :signature "(http/serve :port N :cart-dir \"carts\" :compose-perm 'local-only) -> server-record"
  :summary "Starts a local HTTP host that serves carts from a directory, and returns a server record."
  :provenance "lib/net/http-serve.js; Motoi-own. Permission 'network. Corrected 2026-08-02: the record used to hold the REQUESTED port until an asynchronous readiness step wrote the real one; binding a numeric port is synchronous, so the record now carries the bound port when the verb returns."
  :explanation "http/serve binds a local web server so a cart can be played in a browser. It takes keyword arguments: :port (0 means let the OS choose a free one), :cart-dir (a directory that must resolve UNDER the process working directory — escapes, symlinks and non-directories are refused with an error), and :compose-perm (default 'local-only). Two endpoint families are served: /play/:cart is public and renders the cart's widgets as accessible HTML, and /compose/:cart is permission-gated and refuses off-host requests when :compose-perm is 'local-only. Binding a numeric port completes before the verb returns, so the record it hands back already carries the port actually bound — including the one the OS chose for :port 0 — and http/serve-info reads the port live from the socket. What does NOT complete in time is the operating system's explanation of a failure: if the socket did not bind, the verb records that fact immediately with a message that names no cause, and the cause is filled in later if the program is still running. Only GET and HEAD are answered; everything else gets 405."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(procedure? http/serve)" :note "#t — the verb is bound; calling it would bind a real TCP port, so this record never does.")
    (:dialect "motoi" :tier "intermediate" :code ";; SHAPE ONLY — this record never binds a port.\n;; The real call looks like:\n;;   (define srv (http/serve ':port 0 ':cart-dir \"carts\"))\n;; and returns a record whose port is already bound.\n(define (describe-serve-call) (list 'http/serve ':port 0 ':cart-dir \"carts\"))\n(display (describe-serve-call)) (newline)" :note "The keyword shape of the call, printed rather than executed.")
    (:dialect "motoi" :tier "expert" :code ";; SHAPE ONLY. The full lifecycle, written as data:\n;;   1. (define srv (http/serve ':port 0))\n;;   2. (http/wait-until-ready srv)   ; #f if it did not bind\n;;   3. ... play ...\n;;   4. (http/stop srv)\n(define lifecycle (list 'serve 'check 'play 'stop))\n(display (length lifecycle)) (newline)" :note "4 — the four stages of a served session, from bind to release.")
  )
  :caveats ("Binds a REAL TCP port. Never call it inside a documentation gate, a test that runs unattended, or a loop." ":cart-dir must resolve under the process working directory. An escape, a symlink, or a non-existent path raises rather than returning an error record." "A bind failure such as a port already in use does NOT throw. It is recorded on the returned record, so a caller that never checks — with http/wait-until-ready, or the :error field of http/serve-info — carries on as though the server started." "The first message recorded for a failed bind names no cause, only the fact that the port is not bound. The operating system's error code overwrites it later, which a short synchronous program will never see." "Requires the 'network permission; a sandbox without it refuses the call.")
  :drawbacks ("Read-only: /compose/:cart delivers the composer view but edits do not round-trip yet." "No TLS, no authentication beyond the local-only origin check, and the origin check reads the raw socket address — deliberately ignoring X-Forwarded-For, which means it does not work correctly behind a reverse proxy." "Cart discovery is capped at two directory levels and skips dot-prefixed names, so a deeply nested cart is invisible." "The server record is an opaque host object; only http/serve-info can read it." "A record that failed to bind is still a record, so it must be checked rather than assumed.")
  :usecases ("Hosting a cart locally so a friend on the same network can play it." "Previewing how a cart's widgets render as accessible HTML." "Serving a directory of carts as a browsable index." "Demonstrating a cart from a laptop without deploying anything.")
  :related ("http/wait-until-ready" "http/stop" "http/serve-info")
  :learn (:concept "A failure and its explanation do not arrive together: the fact that a resource did not open is known at once, while the reason may only be available later." :prerequisites ("http/wait-until-ready") :progression "Learn the four-stage lifecycle serve → check → use → stop, then http/serve-info to read the bound port and the error field.")
  :row-2-audit (
    (:eng-program ";; SHAPE ONLY — no port is bound in this record.\n(define (serve-plan port dir)\n  (list 'http/serve ':port port ':cart-dir dir ':compose-perm 'local-only))\n(display (serve-plan 0 \"carts\")) (newline)"
     :math-program "(:honest-null \"Binding a socket is an effect on the host, not an algebraic operation. There is no invariant over http/serve itself to state without fabricating one; the checkable properties live in the lifecycle (row 4), not in the verb.\")"
     :cs-program "(define (lifecycle-ordered? stages)\n  (equal? stages (list 'serve 'check 'use 'stop)))\n(display (lifecycle-ordered? (list 'serve 'check 'use 'stop))) (newline)\n(display (lifecycle-ordered? (list 'serve 'use 'check 'stop))) (newline)"
     :problem "The operator wants a friend to play their cart. Their instinct is to email the .sks file, but the friend has no Motoi installed. The audit question is which verb hands out a URL rather than a file — and then, crucially, whether the code checks that the bind succeeded before printing that URL. A record is returned whether or not a port was bound, so the record's existence is not evidence that anything is listening."
     :explanation "eng: the call is written as data so the keyword shape is visible without binding anything. math: honest-null — socket binding is an effect, and the checkable claims are about the lifecycle ordering, not about this verb in isolation. cs: an ordering predicate, because the common defect here is using the server without ever checking it bound."
     :meta "Why http/serve and not a file copy: the friend needs a running host, not source. Why the check step is not optional: a failed bind is reported on the record instead of raised, so the only difference between a working host and a dead one is a field nobody read. The tell is a program with no branch between starting a resource and using it."
    )
    (:eng "Check the record before you print the URL. A returned record means the call finished, not that a port is listening."
     :math "Not applicable — the verb's content is an effect on the host's socket table."
     :cs "The CS pattern is the error returned as a value rather than raised. Related: errno after a failed bind(2), which the caller must look at.")
)
  :row-3-dimension (
    (:setup "The fact before the reason: an operation reports at once THAT it failed, while WHY it failed becomes available only later, if at all."
     :rungs ((:domain "system (a socket that did not bind — known immediately; the operating system's error code arrives afterwards)" :code "(define (bind-report bound? code)\n  (if bound? 'listening (list 'not-bound 'cause (if code code 'unknown))))\n(display (bind-report #f #f)) (newline)\n(display (bind-report #f 'address-in-use)) (newline)")
             (:domain "medicine (a fever measured in a minute; the infection named after the culture grows)" :code "(define (triage temperature culture)\n  (if (> temperature 38)\n      (list 'fever 'cause (if culture culture 'pending))\n      'well))\n(display (triage 39 #f)) (newline)\n(display (triage 39 'strep)) (newline)")
             (:domain "logic (a refutation is immediate; a proof of why may be much longer)" :code "(define (all-even? xs)\n  (cond ((null? xs) #t)\n        ((even? (car xs)) (all-even? (cdr xs)))\n        (else #f)))\n(display (all-even? (list 2 4 6))) (newline)\n(display (all-even? (list 2 3 6))) (newline)"))
     :explanation "The socket is known not to be bound before anyone knows why. The fever is measured before the infection is named. A single odd number refutes the claim long before anyone could explain the pattern. All three share the shape 'the negative result is cheap and early, the explanation is expensive and late.'"
     :meta "The shape transfers wherever diagnosis lags detection. The design consequence is that the early report must not invent a cause to look complete — a placeholder reason is worse than no reason, because it is believed and then quoted.")
    (:eng "Report the fact the moment you have it, and leave the cause field empty until you actually have a cause."
     :math "Refutation and explanation are different problems with different costs."
     :cs "The CS analog is a health check that reports down immediately while the root-cause trace is still being collected."))
  :row-4-proof (
    (:eng-program "(display (procedure? http/serve)) (newline)"
     :math-program "(define (must-check-before-use? stages)\n  (let loop ((xs stages) (seen-check #f))\n    (cond ((null? xs) #t)\n          ((eq? (car xs) 'check) (loop (cdr xs) #t))\n          ((eq? (car xs) 'use) (and seen-check (loop (cdr xs) seen-check)))\n          (else (loop (cdr xs) seen-check)))))\n(display (must-check-before-use? (list 'serve 'check 'use 'stop))) (newline)\n(display (must-check-before-use? (list 'serve 'use 'stop))) (newline)"
     :cs-program "(display (and (procedure? http/serve)\n              (procedure? http/wait-until-ready)\n              (procedure? http/stop)\n              (procedure? http/serve-info))) (newline)"
     :claim "All four lifecycle verbs are bound, and any use of the server that is not preceded by a check of the record violates the lifecycle ordering."
     :invariant "∀ traces t of a served session. position(check, t) < position(use, t) ∧ position(serve, t) < position(check, t)"
     :meta "The pattern is a protocol state machine — a set of operations that are only legal in a particular order. See book-of-code ch on resource lifecycles. What falsifies the ordering claim in practice: a program that serves on a port another process already holds, never checks the record, and announces a URL that answers nothing. The binding check is the only claim about http/serve this record can prove without binding a port, and that limitation is stated rather than papered over."
    )
    (:eng "Smoke test: the four verbs exist and the trace ordering predicate rejects a use-before-check trace."
     :math "The legal traces form a prefix-closed language over the four operations."
     :cs "The CS pattern is typestate — the handle's permitted operations depend on which phase it is in.")
)
  :row-5-emergence (
    (:eng-composition ";; SHAPE ONLY — no port is bound.\n(define (session-plan port dir)\n  (list (list 'serve ':port port ':cart-dir dir)\n        (list 'check-bound)\n        (list 'announce-url)\n        (list 'stop)))\n(display (length (session-plan 0 \"carts\"))) (newline)\n(display (car (session-plan 0 \"carts\"))) (newline)"
     :math-composition "(define (valid-transition? from to)\n  (cond ((eq? from 'idle)    (eq? to 'serving))\n        ((eq? from 'serving) (memq to (list 'ready 'failed)))\n        ((eq? from 'ready)   (memq to (list 'ready 'stopped)))\n        ((eq? from 'failed)  (eq? to 'stopped))\n        ((eq? from 'stopped) #f)\n        (else #f)))\n(display (valid-transition? 'idle 'serving)) (newline)\n(display (valid-transition? 'serving 'failed)) (newline)\n(display (valid-transition? 'stopped 'serving)) (newline)"
     :cs-composition "(define (with-server-plan body)\n  (append (list 'serve 'check) body (list 'stop)))\n(display (with-server-plan (list 'announce 'play))) (newline)"
     :base "http/serve binds a host and returns a record whether or not the bind succeeded."
     :emergent "bracketed session with a failure branch — a plan that pairs every start with its stop AND gives the failed bind somewhere to go, so a cart demo neither leaves a port held nor announces a dead URL"
     :meta "The composition chains serve, check, use and stop into a single bracket. What emerges is the acquire-release family: with-open-file, RAII destructors, Python's context manager, try-with-resources. The shape exists because a resource acquired and not released outlives the program that wanted it, and a port is the most visible instance — the next run finds the address in use. The failed state matters here because acquisition can fail without raising, and a bracket with no failure edge silently runs its body on a resource it never got. In book-of-composition this is the bracket shape.")
    (:eng "Write the stop before you write the body, and give the failed bind its own exit. A demo that ends with an uncaught error must still release its port."
     :math "The composition is a state machine whose accepting states all pass through stopped, from either ready or failed."
     :cs "The CS pattern name is bracket / acquire-release. Familiar analogs: defer in Go, with in Python, ensure in Ruby.")
))

(verb
  :name "http/wait-until-ready" :std "Motoi"
  :library "system"
  :kind "io"
  :signature "(http/wait-until-ready server-record) -> server-record | #f"
  :summary "Answers the server record when its socket is bound, #f when it is not. It does not block."
  :provenance "lib/net/http-serve.js; Motoi-own. Permission 'network. Read 2026-08-02; rewritten synchronously the same day, having been an async JS function whose Promise leaked into Scheme."
  :explanation "http/wait-until-ready reports whether a host started by http/serve is actually listening. It does not wait, and there is nothing for it to wait for: listen() with a plain port number binds before it returns — only the 'listening' event is deferred — so by the time http/serve hands back a record, bound-or-not is already settled. This verb reads that settled fact. On a bound server it writes the real port into the record and returns the record; otherwise it returns #f. A record that failed to bind answers #f as well — that is what 'not ready' means — and the reason is readable as the :error entry of http/serve-info. Until 2026-08-02 the implementation was declared async, and the interpreter is synchronous and never awaited it, so every call handed Scheme a raw JavaScript Promise: truthy for every input including #f, and never once the bound port."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(boolean? (http/wait-until-ready #f))" :note "#t — #f is not a server record, so the answer is the boolean #f.")
    (:dialect "motoi" :tier "intermediate" :code "(if (http/wait-until-ready #f) 'truthy 'falsy)" :note "falsy — a readiness check written the obvious way is now correct.")
    (:dialect "motoi" :tier "expert" :code "(eq? (http/wait-until-ready (list 1 2)) #f)" :note "#t — a list of two numbers is not a server record and is refused, not guessed about.")
  )
  :caveats ("IT DOES NOT WAIT. The name is historical: by the time http/serve returns, the socket is bound or the bind has already failed, so there is nothing left to poll." "A second argument is accepted and ignored. Call sites written against the old (http/wait-until-ready server 500) signature still run; the number has no effect." "#f covers three different situations — the argument is not a server record, the bind failed, and the server has been stopped. Read http/serve-info's :error entry to tell a bind failure from the others." "Readiness is a LIVE reading, not a memory. The same record answers the record before http/stop and #f after it." "It mutates the record it was handed, writing the bound port into it. That is why the port is correct afterwards on a server started with :port 0." "Requires the 'network permission.")
  :drawbacks ("The answer is about NOW; a server can stop between the check and the use of the result, and no readiness verb can close that gap." "One #f for three causes, so a caller who needs the reason has to make a second call." "Returning the record rather than #t means the truthy branch carries a mutable host object, which is convenient and easy to hold past its lifetime.")
  :usecases ("Confirming a host bound before announcing its URL." "Discovering the actual port when :port 0 asked the OS to choose one." "Detecting a bind failure such as EADDRINUSE, which http/serve reports through the record rather than by raising." "Gating a demo until the host is accepting connections.")
  :related ("http/serve" "http/stop" "http/serve-info")
  :learn (:concept "A verb that cannot answer must say #f; handing back a container instead defeats every check written against it, because the container is truthy whatever it holds." :prerequisites ("http/serve") :progression "Start a host with http/serve, confirm it with http/wait-until-ready, read its port with http/serve-info, release it with http/stop.")
  :row-2-audit (
    (:eng-program "(display (boolean? (http/wait-until-ready #f))) (newline)\n(display (if (http/wait-until-ready #f) 'truthy 'falsy)) (newline)"
     :math-program "(define (stable? x)\n  (eq? (http/wait-until-ready x) (http/wait-until-ready x)))\n(display (stable? #f)) (newline)\n(display (stable? (list 1 2))) (newline)"
     :cs-program "(define (naive-ready? x) (if x 'ready 'not-ready))\n(display (naive-ready? (http/wait-until-ready #f))) (newline)\n(display (naive-ready? (http/wait-until-ready (list 1 2)))) (newline)"
     :problem "The operator started a host with :port 0 and wants to print the URL. They need the bound port, which http/serve was asked for but did not choose. The audit question is which verb resolves the record — and the answer is this one, which writes the real port into the record and hands it back. On the engine before 2026-08-02 the answer was that no verb could, because the readiness verb returned a Promise the interpreter never unwrapped, and the naive check below answered 'ready for input #f."
     :explanation "eng: the result is a boolean on the refusal path, which is the two-line check that the boundary is clean. math: asking twice gives the same answer, so the check is safe to repeat in a retry loop. cs: the readiness check a caller will actually write, shown answering not-ready for two things that are not servers."
     :meta "Why the refusal path is the one worth testing: the success path is exercised by every demo, and the refusal path is exercised only when something has gone wrong — which is exactly when a wrong answer costs the most. The old failure landed one line after the mistake: the readiness check passed, the URL was printed with port 0, and the friend on the other end got a connection refused, at which point the operator debugged the network rather than the check."
)
    (:eng "Branch on this verb's result and print the port from the record it gives back, never from the record you passed in before checking."
     :math "The reading is idempotent: repeating it does not change it, so a retry loop is sound."
     :cs "The CS pattern is a readiness probe over a synchronous fact. Related: SO_REUSEADDR checks, healthcheck endpoints that read state rather than perform work.")
)
  :row-3-dimension (
    (:setup "The wrapper that swallows falsity: a container standing in for a result, which passes every truthiness test regardless of what it holds — and the discipline of never letting one cross a language boundary."
     :rungs ((:domain "system (a readiness verb that answers #f itself instead of handing back a container)" :code "(display (if (http/wait-until-ready #f) 'truthy 'falsy)) (newline)\n(display (if (list #f) 'truthy 'falsy)) (newline)")
             (:domain "postal service (a delivery receipt proves a parcel was sent, never that it arrived)" :code "(define (receipt? x) (eq? x 'receipt))\n(define (delivered? x) (eq? x 'delivered))\n(display (receipt? 'receipt)) (newline)\n(display (delivered? 'receipt)) (newline)")
             (:domain "logic (a non-empty container is not the same proposition as a true element)" :code "(define (box v) (list 'box v))\n(display (pair? (box #f))) (newline)\n(display (cadr (box #f))) (newline)"))
     :explanation "A list holding #f is truthy; the verb beside it is not, because it answers #f directly. A delivery receipt is not a delivery. A box containing #f is not #f. All three share the shape 'the container is present, so the test on the container succeeds, and the test the programmer meant was on the contents' — which is precisely what this verb stopped doing on 2026-08-02."
     :meta "The shape transfers wherever a wrapper is introduced between a producer and a consumer. The tell is a conditional that never takes its false branch — and the reason it is dangerous is that the code reads exactly like correct code. A Promise is the wrapper that bites hardest, because the language that produced it hides the wrapping in a keyword.")
    (:eng "Any conditional that has never once taken its false branch in testing deserves a second look; it may be testing a wrapper."
     :math "Inhabitation of a container is a different proposition from the truth of its content."
     :cs "The CS analog is Optional-versus-value confusion — `if (optional)` is true even for an empty Optional."))
  :row-4-proof (
    (:eng-program "(display (boolean? (http/wait-until-ready #f))) (newline)\n(display (boolean? (http/wait-until-ready '()))) (newline)"
     :math-program "(define (wrapper-hides-falsity? boxed) (and (if boxed #t #f) #t))\n(display (wrapper-hides-falsity? (list #f))) (newline)\n(display (if #f #t #f)) (newline)"
     :cs-program "(display (eq? (http/wait-until-ready #f) #f)) (newline)\n(display (eq? (http/wait-until-ready (list 1 2)) #f)) (newline)\n(display (eq? (http/wait-until-ready '()) (http/stop '()))) (newline)"
     :claim "Every input that is not a server record is answered with the boolean #f, and the answer agrees with the one http/stop gives for the same input."
     :invariant "∀ x ∉ server-records. http/wait-until-ready(x) = #f = http/stop(x)"
     :meta "The pattern is a contract checked by type at the boundary — the cheapest kind to test for and, before the fix, the easiest kind to miss, because nothing raised. See book-of-code ch on contracts and boundaries. What falsifies the old divergence: (boolean? (http/wait-until-ready #f)), which was #f on the pre-2026-08-02 engine and is #t here. The bound-port half of the contract needs a real socket and is proved in tests/net/http-serve.test.js rather than in a reference example, because an example that binds a port depends on the directory it is run from."
    )
    (:eng "The one-line regression test for the old defect is (boolean? (http/wait-until-ready #f)). It must stay #t."
     :math "The claim is a type-level agreement between siblings, not a numeric invariant."
     :cs "The CS pattern is a boundary-crossing type check — assert the shape at the edge, because inside the edge everything looks fine.")
)
  :row-5-emergence (
    (:eng-composition "(define (assert-boolean label v)\n  (list label 'is-boolean (boolean? v)))\n(display (assert-boolean 'wait-until-ready (http/wait-until-ready #f))) (newline)\n(display (assert-boolean 'stop (http/stop #f))) (newline)"
     :math-composition "(define (contract-holds? pred v) (if (pred v) 'ok 'violated))\n(display (contract-holds? boolean? #f)) (newline)\n(display (contract-holds? boolean? (list 1 2))) (newline)"
     :cs-composition "(define (audit-boundary verbs)\n  (map (lambda (p) (list (car p) (boolean? (cdr p)))) verbs))\n(display (audit-boundary (list (cons 'stop (http/stop #f))\n                               (cons 'serve-info (http/serve-info #f))\n                               (cons 'wait (http/wait-until-ready #f))))) (newline)"
     :base "http/wait-until-ready answers a server record or #f."
     :emergent "boundary contract audit — a sweep that checks the RETURN TYPE of every verb at a foreign-function boundary, catching leaked host objects before they reach a conditional"
     :meta "The composition chains a type predicate over several boundary verbs at once. What emerges is the contract-audit family: check the shape at the seam, because a host object that crosses into the language unwrapped will type-check as 'some value' everywhere downstream and misbehave nowhere in particular. Same family: FFI marshalling tests, JSON schema validation at an API edge, serde round-trip tests. In book-of-composition this is the seam-assertion shape — and this sweep is what caught the Promise leak, because the third entry was the only one that answered #f.")
    (:eng "Run the sweep over the whole net family after any change to the interpreter's call path. All three pass today; the sweep is what shows when one stops."
     :math "The audit is a predicate applied pointwise over a family, reducing a contract question to a finite conjunction."
     :cs "The CS pattern name is boundary contract test. Familiar analogs: FFI type assertions, schema validation at service edges.")
))

(verb
  :name "http/stop" :std "Motoi"
  :library "system"
  :kind "io"
  :signature "(http/stop server-record) -> boolean"
  :summary "Closes a running host and forgets it; returns #f when handed something that is not a server record."
  :provenance "lib/net/http-serve.js; Motoi-own. Permission 'network. Corrected 2026-08-02: the guard tested for a server property the record keeps forever, so stopping the same record twice answered #t both times; it now tests the runtime's server table, which the first stop empties."
  :explanation "http/stop releases a host started by http/serve. It first checks that the argument is a server record and that the runtime still has that record registered; if either fails, it returns #f without doing anything. Otherwise it closes the underlying server inside a try block that swallows any close error, removes the record from the runtime's server table, and returns #t. The two return values therefore mean 'there was a server and I closed it' and 'there was nothing to close' — NOT 'the close succeeded' and 'the close failed', because a close error is discarded. It is safe to call on #f, on the empty list, and on a record that has already been stopped: all of those return #f, which makes it idempotent in the sense that matters for cleanup code."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(http/stop #f)" :note "#f — nothing to stop; safe to call in a cleanup path that may not have started anything.")
    (:dialect "motoi" :tier "intermediate" :code "(http/stop '())" :note "#f — the empty list carries no server, so it takes the nothing-to-do path.")
    (:dialect "motoi" :tier "expert" :code "(boolean? (http/stop #f))" :note "#t — this verb returns a genuine boolean, not a record and not a host value.")
  )
  :caveats ("#f means 'there was nothing to stop', NOT 'stopping failed'. A genuine close error is caught and discarded, and the verb still returns #t." "Closing is not instant: server.close() stops accepting new connections but existing keep-alive sockets drain on their own schedule." "Requires the 'network permission." "Calling it twice on the same record returns #t then #f: the first call removes the runtime's table entry, and the second finds nothing registered and does not attempt a close." "It cannot stop a server whose record you have lost; there is no verb to enumerate running hosts.")
  :drawbacks ("No error channel, so a failed close is indistinguishable from a successful one." "No way to wait for connections to drain before returning." "If the server record is dropped without stopping, the port stays held until the process exits and there is no in-language way to recover it.")
  :usecases ("Releasing a port at the end of a demo." "Cleanup in a path that may or may not have started a server, where the #f case must be harmless." "Restarting a host on a new port." "Freeing a port before a second http/serve call that would otherwise hit EADDRINUSE.")
  :related ("http/serve" "http/serve-info" "http/wait-until-ready")
  :learn (:concept "A cleanup verb should be safe to call when there is nothing to clean up; that is what lets error paths and success paths share one exit." :prerequisites ("http/serve") :progression "Learn http/stop as the release half of the bracket, then write every http/serve inside a form that guarantees the stop runs.")
  :row-2-audit (
    (:eng-program "(define (cleanup maybe-server) (http/stop maybe-server))\n(display (cleanup #f)) (newline)\n(display (cleanup '())) (newline)"
     :math-program "(define (idempotent-on-nothing? x) (eq? (http/stop x) (http/stop x)))\n(display (idempotent-on-nothing? #f)) (newline)\n(display (idempotent-on-nothing? '())) (newline)"
     :cs-program "(define (safe-exit steps) (append steps (list 'stop)))\n(display (safe-exit (list 'serve 'wait 'use))) (newline)\n(display (safe-exit '())) (newline)"
     :problem "The operator's demo script has three ways to exit: success, a cart that failed to load, and a user pressing quit before the server even started. They want one cleanup path. The audit question is whether the release verb tolerates being handed nothing — because if it raised on #f, the early-quit path would crash while cleaning up, which is the worst place to crash."
     :explanation "eng: one cleanup function handles a real record and a missing one identically. math: the nothing-to-stop case is stable under repetition, which is what makes a shared exit path safe. cs: appending the stop step to any prefix of the lifecycle, including the empty one."
     :meta "Why http/stop tolerates #f rather than requiring a guard at every call site: a cleanup path is exactly where a caller has the least information about what was started. Pushing the check outward would put an `(if srv ...)` around every exit, and the one that got forgotten would be in the rarest error branch. The tell that a cleanup verb is badly designed is a guard repeated at every call site.")
    (:eng "One exit path, called unconditionally. If the cleanup verb needs a guard, the guard is the defect."
     :math "The nothing-to-do case is an absorbing state: repeated application changes nothing."
     :cs "The CS pattern is the null-safe destructor. Related: free(NULL) being defined behaviour in C, close on an already-closed handle.")
)
  :row-3-dimension (
    (:setup "The tolerant release: a teardown operation defined on the empty case, so callers never have to know whether there is anything to tear down."
     :rungs ((:domain "system (stopping a host that may never have started)" :code "(display (http/stop #f)) (newline)\n(display (http/stop '())) (newline)")
             (:domain "kitchen (wiping a counter that may already be clean)" :code "(define (wipe state) (if (eq? state 'dirty) 'clean state))\n(display (wipe 'dirty)) (newline)\n(display (wipe 'clean)) (newline)")
             (:domain "algebra (an idempotent operation — applying it twice equals applying it once)" :code "(define (idem f x) (equal? (f (f x)) (f x)))\n(display (idem abs -3)) (newline)\n(display (idem (lambda (s) (if (eq? s 'dirty) 'clean s)) 'dirty)) (newline)"))
     :explanation "Stopping nothing is harmless. Wiping a clean counter is harmless. An idempotent function applied twice equals itself applied once. All three share the shape 'the operation is total, and repeating it costs nothing.'"
     :meta "The shape transfers to every teardown in every system: closing files, releasing locks, deleting a key that may not exist. The bargain is that the operation gives up its ability to report 'there was nothing there' as an error — which is exactly the caveat on this verb's #f return.")
    (:eng "Design teardown to be callable from any state. The cost is that it cannot also serve as an assertion that the resource existed."
     :math "Idempotence: f ∘ f = f. The empty case is a fixed point."
     :cs "The CS analog is the idempotent DELETE in HTTP — the second request is not an error."))
  :row-4-proof (
    (:eng-program "(display (list (http/stop #f) (http/stop '()) (boolean? (http/stop #f)))) (newline)"
     :math-program "(define (stable-under-repetition? x)\n  (eq? (http/stop x) (http/stop x)))\n(display (stable-under-repetition? #f)) (newline)\n(display (stable-under-repetition? '())) (newline)"
     :cs-program "(display (boolean? (http/stop #f))) (newline)\n(display (eq? (http/stop #f) #f)) (newline)"
     :claim "On any argument that carries no server, http/stop returns #f, returns a genuine boolean, and is stable under repetition — so a cleanup path may call it unconditionally and call it twice."
     :invariant "∀ x carrying no server. http/stop(x) = #f ∧ boolean?(http/stop(x))"
     :meta "The pattern is a total teardown with an idempotent empty case. See book-of-code ch on resource release. What this proof deliberately does NOT cover: the #t branch, which requires binding a real port and is therefore untestable in a documentation gate — that limitation is stated here rather than hidden behind an example that would break the gate. The boolean check is included because a verb that returns a host value instead of a Scheme boolean passes every `if` — the sibling verb http/wait-until-ready used to fail exactly that check.")
    (:eng "Smoke test: #f on nothing, twice, and a genuine boolean type. The #t path needs a live port and is out of scope for a gate."
     :math "Stability under repetition on the empty case is the observable half of idempotence."
     :cs "The CS pattern is the null-safe release, proven on the null case only.")
)
  :row-5-emergence (
    (:eng-composition "(define (with-server-bracket start-thunk body-thunk)\n  (let ((srv (start-thunk)))\n    (let ((result (body-thunk srv)))\n      (http/stop srv)\n      result)))\n(display (with-server-bracket (lambda () #f)\n                              (lambda (s) (list 'ran 'with s)))) (newline)"
     :math-composition "(define (release-all handles)\n  (map (lambda (h) (http/stop h)) handles))\n(display (release-all (list #f '() #f))) (newline)\n(display (release-all '())) (newline)"
     :cs-composition "(define stopped 0)\n(define (counted-stop h)\n  (if (http/stop h) (set! stopped (+ stopped 1)) 'nothing-to-stop)\n  stopped)\n(display (counted-stop #f)) (newline)\n(display (counted-stop '())) (newline)"
     :base "http/stop releases a host and tolerates being handed nothing."
     :emergent "resource bracket and bulk release — a wrapper that guarantees the stop runs whatever the body did, and a sweep that releases a whole list of handles without inspecting any of them"
     :meta "The composition chains the tolerant release with a body. What emerges is the bracket family: with-open-file, defer, RAII, context managers. The reason the tolerant empty case matters here is that the bracket's release runs on the failure path too, where the handle may be #f — a release that raised on #f would turn one failure into two, and the second would mask the first. Same family: connection pools draining on shutdown, transaction rollback on any exit. In book-of-composition this is the guaranteed-release shape.")
    (:eng "Count the successful stops. A bracket that reports zero stops over a run that started servers has a leak."
     :math "Bulk release is the pointwise lift of an idempotent operation over a list; the empty list is the identity case."
     :cs "The CS pattern name is bracket / RAII. Familiar analogs: Go's defer, Python's with, Java's try-with-resources.")
))

(verb
  :name "http/serve-info" :std "Motoi"
  :library "system"
  :kind "rd"
  :signature "(http/serve-info server-record) -> alist | #f"
  :summary "Reports a server record as an alist of :id, :port, :cart-dir, :compose-perm and :error; returns #f for anything that is not a server record."
  :provenance "lib/net/http-serve.js; Motoi-own. Permission 'read. Corrected 2026-08-02: the verb previously accepted any truthy argument and built a five-field report out of properties that were not there, so a list of two numbers read as a healthy server. It now recognises records by a private brand and answers #f otherwise."
  :explanation "http/serve-info is the introspection verb for a running host. Given a record from http/serve it returns an association list with five entries: :id (the runtime's integer handle), :port (the port the socket is bound to right now, read live from the socket), :cart-dir (the resolved absolute directory), :compose-perm (the permission symbol) and :error (the bind error message, or #f if there is none). Given anything that is not a server record — #f, the empty list, a list of numbers, a string, a record from another system — it returns #f. It is read-permission, not network, because it only reads a record. Because the rejection is total, this verb IS a usable recogniser: a non-#f answer means the argument really was a server record."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(http/serve-info #f)" :note "#f — nothing to report on.")
    (:dialect "motoi" :tier "intermediate" :code "(http/serve-info (list 1 2))" :note "#f — a list of two numbers is not a server, so no report is invented for it.")
    (:dialect "motoi" :tier "expert" :code "(if (http/serve-info '()) 'fabricated 'rejected)" :note "rejected — the empty list is truthy in Scheme, so this is the case a naive guard misses; the verb rejects it anyway.")
  )
  :caveats ("A server record cannot be built in Scheme — only http/serve makes one — so the only way to get a report is to hold the record you were given." "The :port field is read live from the socket, so a :port 0 server reports its real assigned port once it is bound, and a record whose socket has been closed falls back to the last port it was bound to." "The :error field is #f when there is no error; on a failed bind it carries a message, and the message may be refined later when the operating system's error code arrives." "Values are read out with cadr, not cdr — the entries are two-element lists, not dotted pairs." "The report survives http/stop: a stopped record still reports its fields, because the record is a description, not a liveness check.")
  :drawbacks ("Reports a snapshot with no timestamp, so two calls cannot be ordered." "There is no verb to enumerate running servers, so this verb is only usable if you still hold the record." "It reports fields, not health: a record that is present and a record that is serving traffic look the same apart from the :error field.")
  :usecases ("Reading the bound port after starting a host, to print a URL." "Checking the :error field for a bind failure such as a port already in use." "Recognising whether a value is a server record at all, since a non-record answers #f." "Logging which cart directory a host resolved to." "Confirming the compose permission a host was started with.")
  :related ("http/serve" "http/stop" "http/wait-until-ready")
  :learn (:concept "An introspection verb must be able to refuse; a report generated for an input it never examined is worse than an error, because it looks like evidence." :prerequisites ("http/serve") :progression "Learn the five fields, then use the #f answer as the type test — that is what makes this verb safe to point at an unknown value.")
  :row-2-audit (
    (:eng-program "(define (field k info)\n  (let ((hit (assoc k info)))\n    (if hit (cadr hit) 'missing)))\n(define (report-on x)\n  (let ((info (http/serve-info x)))\n    (if info (field ':error info) 'not-a-server)))\n(display (report-on #f)) (newline)\n(display (report-on (list 1 2))) (newline)"
     :math-program "(define (recognises? x) (if (http/serve-info x) #t #f))\n(display (recognises? #f)) (newline)\n(display (recognises? '())) (newline)\n(display (recognises? \"a string\")) (newline)"
     :cs-program "(define (looks-like-server? x)\n  (if (http/serve-info x) 'yes 'no))\n(display (looks-like-server? #f)) (newline)\n(display (looks-like-server? (list 1 2))) (newline)"
     :problem "The operator has a value that came back from somewhere and wants to know whether it is a live server before printing its URL. The obvious move is to call http/serve-info and treat a non-#f result as proof. The audit question is whether that inference is sound. It is — but only because the verb rejects non-records; the same code was unsound on an earlier build where every truthy argument produced a report."
     :explanation "eng: a field accessor with a not-a-server branch that actually gets taken. math: the recogniser answers #f for three different shapes of non-record, including the empty list. cs: the type test everyone will write, shown answering correctly."
     :meta "Why the empty list is the interesting case: only #f is false in Scheme, so '() is truthy, and a guard written as `if (!record)` in the host language rejects #f and lets '() straight through. That is the exact hole this verb used to have. The tell is a boundary check that names one falsy value instead of naming the shape it wants."
    )
    (:eng "Point the verb at the value you doubt. If it answers #f, the value was never a server, and no report was invented to hide that."
     :math "A recogniser is a total function into the booleans; totality is what makes the #f answer informative."
     :cs "The CS pattern is validation at the boundary. Related: parse-don't-validate, where the successful parse is the proof of type.")
)
  :row-3-dimension (
    (:setup "The honest refusal: a report verb that answers 'no' for inputs it does not recognise, rather than filling its template with whatever it was handed."
     :rungs ((:domain "system (asking for a server report on a list of two numbers)" :code "(display (http/serve-info (list 1 2))) (newline)\n(display (http/serve-info '())) (newline)")
             (:domain "reception (a clerk who says 'you are not in the register' instead of stamping a blank form)" :code "(define register (list (list 'ada 'room-1) (list 'grace 'room-2)))\n(define (look-up who)\n  (let ((hit (assoc who register)))\n    (if hit (cadr hit) #f)))\n(display (look-up 'ada)) (newline)\n(display (look-up 'nobody)) (newline)")
             (:domain "logic (a partial function made total by an explicit undefined value, rather than by guessing)" :code "(define (safe-div a b) (if (= b 0) #f (/ a b)))\n(display (safe-div 6 3)) (newline)\n(display (safe-div 6 0)) (newline)"))
     :explanation "The verb refuses a non-record. The clerk refuses to stamp a name that is not in the register. Division refuses zero instead of returning a number. All three share the shape 'the operation names the inputs it is defined on and returns a distinguishable nothing for the rest.'"
     :meta "The shape transfers wherever a lookup can miss. The design choice is which value means 'no', and in Scheme it must be #f, because #f is the only value the language treats as false — a miss reported as 0, as the empty list, or as a blank record is a miss that every caller's `if` will read as a hit.")
    (:eng "Choose the miss value so that the language's own conditional agrees with you. In Scheme that value is #f and nothing else."
     :math "A partial function is made total by adjoining a bottom element; the bottom must be distinguishable from every ordinary result."
     :cs "The CS analog is Option/Maybe versus a null object. The null object is convenient right up until it is mistaken for a real one."))
  :row-4-proof (
    (:eng-program "(display (http/serve-info #f)) (newline)\n(display (http/serve-info '())) (newline)\n(display (http/serve-info (list 1 2))) (newline)"
     :math-program "(define (rejects? x) (eq? (http/serve-info x) #f))\n(display (rejects? #f)) (newline)\n(display (rejects? '())) (newline)\n(display (rejects? (list 1 2))) (newline)\n(display (rejects? \"not a server\")) (newline)"
     :cs-program "(define (agree? a b) (eq? (if a #t #f) (if b #t #f)))\n(display (agree? (http/serve-info '()) (http/stop '()))) (newline)\n(display (agree? (http/serve-info (list 1 2)) (http/stop (list 1 2)))) (newline)"
     :claim "Every value that is not a server record is rejected with #f, including the truthy ones, and http/serve-info and http/stop now agree about which values carry no server."
     :invariant "∀ x not a server record. http/serve-info(x) = #f ∧ (http/serve-info(x) is truthy) = (http/stop(x) is truthy)"
     :meta "The pattern is a recogniser proven on its rejection set, plus a sibling-agreement check. See book-of-code ch on validation at boundaries. What this proof deliberately does NOT cover: the accepting branch, which requires binding a real port and is therefore untestable in a documentation gate — that limitation is stated here rather than hidden behind an example that would break the gate. The agreement check is the one that found the original defect, in two lines, without reading either implementation."
    )
    (:eng "The regression test is (if (http/serve-info '()) 'fabricated 'rejected). It must print rejected."
     :math "Agreement of two acceptance sets over one domain is checkable without knowing either definition."
     :cs "The CS pattern is the sibling-disagreement test — two verbs over the same type that answer differently about the same input is a defect in one of them.")
)
  :row-5-emergence (
    (:eng-composition "(define (field k info)\n  (let ((hit (assoc k info)))\n    (if hit (cadr hit) 'missing)))\n(define (report-line x)\n  (let ((info (http/serve-info x)))\n    (if info\n        (list 'port (field ':port info) 'error (field ':error info))\n        (list 'no-server))))\n(display (report-line #f)) (newline)\n(display (report-line (list 1 2))) (newline)"
     :math-composition "(define (agree? a b) (eq? (if a #t #f) (if b #t #f)))\n(define (sibling-audit xs)\n  (map (lambda (x) (agree? (http/serve-info x) (http/stop x))) xs))\n(display (sibling-audit (list #f '() (list 1 2) \"s\"))) (newline)"
     :cs-composition "(define (describe-all xs)\n  (map (lambda (x) (if (http/serve-info x) 'server 'other)) xs))\n(display (describe-all (list #f '() (list 1 2)))) (newline)\n(display (describe-all '())) (newline)"
     :base "http/serve-info reports a server record and rejects everything else."
     :emergent "sibling-agreement audit and safe classification — a check that every verb over one type accepts the same set, and a sweep that sorts a mixed list without inspecting any element by hand"
     :emergent-note "The classification sweep is only sound because the recogniser is total; on the earlier build it labelled every truthy element 'server."
     :meta "The composition chains the rejection paths of the whole verb family and compares them. What emerges is the consistency-audit family: when several operations share a type, their acceptance sets must agree, and a disagreement localises the bug to one of them without needing to read either implementation. Same family: parser-versus-serializer agreement, equals-versus-hashCode contracts, read-versus-write permission checks. In book-of-composition this is the cross-check shape.")
    (:eng "Run the agreement check over any verb family that shares an argument type. It found this defect in two lines."
     :math "Two predicates over the same domain must have the same acceptance set, or one of them is wrong."
     :cs "The CS pattern name is differential testing between siblings. Familiar analogs: round-trip property tests, comparing two implementations of one spec.")
))
