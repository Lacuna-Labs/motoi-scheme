;;; 73-draw.slat — Motoi Scheme Reference · Chapter 73 · library draw
;;;
;;; 14 verbs in this library. Read chapter 00-intro.slat first.
;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; Every raster verb PAINTS to a framebuffer: any block that calls one must
;;; begin with (set-mode 'sd). Painting verbs return undefined (print nothing);
;;; the grade is "ran without throwing". A point is (list x y); a polygon is a
;;; list of points. Colors are a palette index 0–15 or a quoted name like 'red.
;;; Every code block RUNS through ./bin/motoi. Made by Alfred Borden.

(dialect :applies ("motoi") :note "Library draw — 14 verbs.")

(chapter :number "73" :library "draw" :verb-count 14 :training-eligible #t)

;; ═══ 14 verbs in library draw ═══

(verb
  :name "triangle" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(triangle x1 y1 x2 y2 x3 y3 [color]) -> undefined"
  :summary "Stroke the three-edge outline of a triangle through the points (x1,y1), (x2,y2), (x3,y3)."
  :explanation "triangle draws the boundary of the simplest possible polygon — three vertices joined by three straight segments — onto the SD framebuffer. It is the workhorse of pointed shapes: roofs, arrowheads, mountain silhouettes, sail cloth, warning signs. You give the three corner coordinates in any order (the triangle is the same set of edges regardless of winding) and an optional trailing color; leave the color off and the current pen color is used. Because it only strokes the outline, the interior stays whatever was underneath — reach for triangle-fill when you want the inside painted. Every filled polygon in graphics is ultimately decomposed into triangles, so learning this verb is learning the atom the whole raster stack is built from."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (triangle 10 10 40 10 25 40 8)" :note "A small triangle with a flat top edge and a downward point, stroked in palette color 8.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n(define (arrow-up cx cy s color)\n  (triangle cx (- cy s) (- cx s) (+ cy s) (+ cx s) (+ cy s) color))\n(arrow-up 160 120 30 'green)" :note "Wrap the six coordinates in a named helper so an up-arrow is placed by centre and size instead of by three raw corners.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n(for-each\n  (lambda (i)\n    (let ((y (+ 30 (* i 40))))\n      (triangle 160 y (- 160 (* 4 (+ i 1))) (+ y 30) (+ 160 (* 4 (+ i 1))) (+ y 30) (+ 1 i))))\n  (iota 5))" :note "Stack five outlined triangles of growing width down the canvas — a stylised conifer built from one repeated stroke.")
  )
  :caveats ("Only the outline is drawn; the interior is untouched — use triangle-fill for a solid triangle." "Three collinear points produce a degenerate triangle (a line segment), which is legal but usually a mistake." "Coordinates are pixel positions on the 320×240 SD canvas; points far outside are clipped, not scaled." "The color argument is optional and always last; if omitted the current pen color is used.")
  :drawbacks ("A stroked triangle is one pixel thick — there is no line-width control at this level." "No anti-aliasing: edges are hard raster steps, visible on shallow diagonals." "You must supply all three vertices explicitly; there is no by-centre-and-size constructor built in.")
  :usecases ("Roofs, mountains, and pennants in a scene." "Arrowheads and directional markers in a diagram." "Wireframe previews of a mesh before it is filled." "Warning-sign and hazard iconography.")
  :related ("triangle-fill" "polygon" "poly" "ngon")
  :learn (:concept "The triangle as the minimal closed polygon — three vertices, three edges — and the base case of all polygon rasterisation." :prerequisites ("polygon") :progression "Once you can stroke a triangle, fill it with triangle-fill, then generalise to arbitrary vertex counts with polygon and to regular symmetric shapes with ngon.")
  :row-2-audit (

    (:problem "A level designer is dropping mountain silhouettes across a backdrop and needs each peak placed by its summit position and base width, not by three hand-typed corners — typing raw vertices for forty peaks is where the sign-flips and swapped coordinates creep in."
     :program "(set-mode 'sd)\n(define (peak summit-x summit-y half-base color)\n  (triangle summit-x summit-y\n            (- summit-x half-base) (+ summit-y 40)\n            (+ summit-x half-base) (+ summit-y 40)\n            color))\n(peak 80 60 30 6)\n(peak 160 50 45 6)\n(peak 240 70 25 6)"
     :eng-program "(set-mode 'sd)\n(define (ridge specs color)\n  ;; specs = list of (summit-x summit-y half-base); one call per peak, one color for the range.\n  (for-each (lambda (s)\n              (let ((sx (car s)) (sy (cadr s)) (hb (caddr s)))\n                (triangle sx sy (- sx hb) (+ sy 40) (+ sx hb) (+ sy 40) color)))\n            specs))\n(ridge (list (list 80 60 30) (list 160 50 45) (list 240 70 25)) 6)"
     :math-program "(set-mode 'sd)\n(define (iso-peak sx sy hb)\n  ;; An isosceles peak is symmetric about the vertical line x = sx.\n  (let ((left (list (- sx hb) (+ sy 40)))\n        (right (list (+ sx hb) (+ sy 40))))\n    (triangle sx sy (car left) (cadr left) (car right) (cadr right))))\n(iso-peak 160 50 45)"
     :cs-program "(set-mode 'sd)\n(define (peak-guard sx sy hb)\n  (if (and (number? sx) (number? sy) (> hb 0))\n      (triangle sx sy (- sx hb) (+ sy 40) (+ sx hb) (+ sy 40))\n      (error 'bad-peak-spec)))\n(peak-guard 160 50 45)"
     :explanation "eng: fold a per-peak spec list into calls so the range is data, not typed corners. math: state the isosceles symmetry (mirror about x = summit) explicitly. cs: guard the half-base against non-positive widths before drawing."
     :meta "polygon would work but forces the designer to build a three-point list and close it by hand for every peak — more ceremony than a three-vertex shape needs. ngon draws a regular equilateral triangle only, so it cannot make a tall narrow peak. triangle-fill would paint the interior, hiding the backdrop behind it. triangle is the by-vertices outline primitive; the siblings either over-package or paint what should stay open.")
    (:eng "The audit lens is 'is the peak placed by intent or by raw corners?' — the smoke test is that changing one summit coordinate moves exactly one peak and nothing else, which only holds if each peak is one self-contained call." :math "An isosceles triangle is determined by an apex and a symmetric base; the two base vertices are apex ± (half-base, height)." :cs "A three-vertex outline emitter; cost is three line-draws per triangle, O(perimeter) pixels touched."))
  :row-3-dimension (
    (:setup "Join three anchor points into a closed three-sided loop.")
    (:rungs (
       (:domain "triangle" :code "(set-mode 'sd) (triangle 10 10 40 10 25 40 8)")
       (:domain "route"    :code "(define legs (list (list 'A 'B) (list 'B 'C) (list 'C 'A)))\n(map (lambda (leg) (list 'fly (car leg) '-> (cadr leg))) legs)")
       (:domain "simplex"  :code "(define (edges verts) (list (list (car verts) (cadr verts)) (list (cadr verts) (caddr verts)) (list (caddr verts) (car verts))))\n(edges (list 'p0 'p1 'p2))")))
    (:explanation "Rung 1: three screen points are joined into a closed triangular outline. Rung 2: a three-city flight itinerary A→B→C→A is a closed loop over three nodes. Rung 3: the 2-simplex is defined as three vertices with the three edges connecting each pair. All three share the same shape — three anchors, three connections, and a return to the start that closes the loop.")
    (:meta "The transfer works because a triangle is the 2-simplex: the smallest set of points that encloses an area, and the smallest cycle that visits three nodes and comes home. Any substrate with three items and a closed pairwise circuit wears this shape. Grounds in book-of-math ch-advanced-13 (topology) as the simplex/cycle shape.")
    (:eng "Every three-anchor loop shares the failure mode 'the loop was left open' — the operator's check is that the last edge returns to the first vertex." :math "The 2-simplex has three 0-faces (vertices) and three 1-faces (edges); its boundary is a 3-cycle." :cs "A fixed-length cyclic edge list; the shape of every minimal closed circuit over three nodes."))
  :row-4-proof (
    (:claim "A triangle's edge set is invariant under any permutation of its three vertices: the same three points in any order draw the same three edges.")
    (:program "(define (edges a b c) (list (list a b) (list b c) (list c a)))\n(define (as-set es)\n  (sort (map (lambda (e) (sort e <)) es)\n        (lambda (p q) (if (= (car p) (car q)) (< (cadr p) (cadr q)) (< (car p) (car q))))))\n(display (equal? (as-set (edges 1 2 3)) (as-set (edges 3 1 2)))) (newline)\n(display (equal? (as-set (edges 1 2 3)) (as-set (edges 2 1 3))))"
     :eng-program "(set-mode 'sd)\n;; Drawing the same corners in two orders paints the same outline; both calls run clean.\n(triangle 10 10 40 10 25 40 8)\n(triangle 25 40 40 10 10 10 8)"
     :math-program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(display (= (area 0 0 4 0 0 3) (area 4 0 0 3 0 0)))"
     :cs-program "(define (undirected e) (sort e <))\n(define (same-edges? es1 es2)\n  (equal? (sort (map undirected es1) (lambda (p q) (< (car p) (car q))))\n          (sort (map undirected es2) (lambda (p q) (< (car p) (car q))))))\n(same-edges? (list (list 1 2) (list 2 3) (list 3 1))\n             (list (list 2 3) (list 1 2) (list 1 3)))"
     :invariant "∀ permutation π of {1,2,3}. edges(v₁,v₂,v₃) = edges(v_{π1},v_{π2},v_{π3})  (the triangle is an unordered set of three undirected edges)"
     :meta "The pattern is that the drawn object depends on the SET of vertices, not their order — the edge list is closed under vertex permutation and each edge is undirected. Falsified if reordering the corners produced a different outline; that would mean winding order changes the boundary, which for a pure stroke it does not. book-of-math ch-advanced-04 (groups-symmetry) grounds the permutation invariance; book-of-code ch 05 grounds set-equality-modulo-order."))
    (:eng "The operator can hand the three corners in whatever order the data arrives without normalising winding first; the outline is identical." :math "The map {v₁,v₂,v₃} → edge-set is invariant under the symmetric group S₃ acting on the vertices." :cs "Order-independent aggregation; the same shape as a hash set that ignores insertion order.")
  :row-5-emergence (

    (:base "triangle strokes one three-sided outline.")
    (:composition "(set-mode 'sd)\n;; A sailboat: hull triangle, mast line via a thin triangle, and a sail triangle.\n(triangle 120 170 200 170 160 190 6)          ; hull\n(triangle 158 80 162 80 160 168 7)             ; mast (sliver)\n(triangle 162 90 162 160 200 155 'white)"
     :eng-composition "(set-mode 'sd)\n(define (boat cx base-y color)\n  (triangle (- cx 40) base-y (+ cx 40) base-y cx (+ base-y 20) color)   ; hull\n  (triangle (+ cx 2) (- base-y 90) (+ cx 2) base-y (+ cx 42) (- base-y 65) 'white)) ; sail\n(boat 160 170 6)"
     :math-composition "(set-mode 'sd)\n;; Three triangles meeting at a common apex partition a fan around one point.\n(let ((apex-x 160) (apex-y 120))\n  (for-each (lambda (i)\n              (let* ((a0 (* i 2.094)) (a1 (* (+ i 1) 2.094)))\n                (triangle apex-x apex-y\n                          (+ apex-x (* 50 (cos a0))) (+ apex-y (* 50 (sin a0)))\n                          (+ apex-x (* 50 (cos a1))) (+ apex-y (* 50 (sin a1)))\n                          (+ 1 i))))\n            (iota 3)))"
     :cs-composition "(set-mode 'sd)\n;; A triangle mesh: a strip of triangles sharing edges, the base data structure of every renderer.\n(let loop ((i 0))\n  (when (< i 4)\n    (let ((x (+ 60 (* i 40))))\n      (triangle x 100 (+ x 40) 100 (+ x 20) 140 (+ 1 i)))\n    (loop (+ i 1))))"
     :emergent "A sailboat, a triangle fan, and a triangle strip: the same three-edge stroke, placed and repeated, becomes a recognisable object and then the two canonical mesh topologies that every GPU consumes.")
    (:meta "This is the tessellation / mesh family — cover a region or trace a scene by repeating the simplest closed cell. Familiar analogs are triangle strips and fans in real-time graphics, finite-element meshes, and Delaunay triangulations. The composition works because a triangle is the atomic fillable cell, so any surface is expressible as a union of them.")
    (:eng "The audit lens is 'shared edges must not double-draw' — in a strip, adjacent triangles reuse an edge, so an efficient renderer emits it once; the smoke test is the vertex count growing by one per added triangle." :math "Any simple polygon triangulates into n−2 triangles; a mesh is a simplicial complex glued along shared edges." :cs "Triangle-strip/fan encoding; the shape of every mesh format that amortises shared vertices."))
)

(verb
  :name "triangle-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(triangle-fill x1 y1 x2 y2 x3 y3 [color]) -> undefined"
  :summary "Paint the solid interior of the triangle spanned by (x1,y1), (x2,y2), (x3,y3)."
  :explanation "Where triangle traces only the boundary, triangle-fill floods every pixel inside the three corners with the chosen colour. This is the fundamental fill operation of raster graphics: the interior is found by a scanline sweep — for each horizontal row the two edge crossings bound a span, and that span is coloured. A solid triangle is the unit that GPUs rasterise millions of times a frame, and any filled polygon on this canvas is ultimately a fan of solid triangles. Reach for it whenever a pointed region must read as a mass rather than a wire: a coloured roof, a compass needle, a slice of a pie, a folded paper corner. The colour argument is optional and trailing; omit it to fill with the current pen colour."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (triangle-fill 10 10 40 10 25 40 'red)" :note "A solid red triangle — the same corners as the stroked example, but the inside is now painted.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A folded corner: two abutting solid triangles make a square split on its diagonal.\n(triangle-fill 100 60 220 60 100 120 1)\n(triangle-fill 220 60 220 120 100 120 4)" :note "Two right triangles sharing the diagonal tile a rectangle in two colours — the classic split-square.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A pinwheel: four solid triangles rotated a quarter-turn around a centre.\n(let ((cx 160) (cy 120) (r 60))\n  (for-each\n    (lambda (i)\n      (let* ((a (* i 1.5708)) (b (+ a 0.7)))\n        (triangle-fill cx cy\n                       (+ cx (* r (cos a))) (+ cy (* r (sin a)))\n                       (+ cx (* r (cos b))) (+ cy (* r (sin b)))\n                       (+ 1 i))))\n    (iota 4)))" :note "Four filled triangles fanning from a shared centre, each a quarter-turn on — a spinning pinwheel from one repeated fill.")
  )
  :caveats ("Fills the interior including its edges; adjacent filled triangles that share an edge overlap by one pixel on that seam." "Degenerate (collinear) corners have zero interior and paint nothing or a thin line." "Fill colour covers whatever was underneath — draw back-to-front for correct layering." "The scanline fill respects only the three given corners; it cannot fill a concave region (there are none with three points, but the caveat carries to polygon-fill).")
  :drawbacks ("No gradient or texture — the fill is a single flat colour." "Overdraw: overlapping filled triangles repaint shared pixels, which wastes fill on this software rasteriser." "No depth buffer; ordering is entirely the caller's responsibility.")
  :usecases ("Solid roofs, flags, and coloured masses in a scene." "Pie and fan slices in a chart." "Two-triangle tiling of quadrilaterals for a filled mesh." "Compass needles, cursors, and directional glyphs.")
  :related ("triangle" "polygon-fill" "fill-poly" "ngon-fill")
  :learn (:concept "Scanline filling of a triangle — the base case of polygon rasterisation, where a shape becomes a set of horizontal spans." :prerequisites ("triangle") :progression "After filling a single triangle, fan several from a centre to fill a convex polygon, then let polygon-fill do arbitrary outlines and ngon-fill do regular ones.")
  :row-2-audit (

    (:problem "A chart author is drawing a pie slice and needs the wedge to read as a solid coloured region, not an outline — and the wedge must share its apex exactly with the neighbouring slices so no white seam shows at the centre."
     :program "(set-mode 'sd)\n(define (wedge cx cy r a0 a1 color)\n  (triangle-fill cx cy\n                 (+ cx (* r (cos a0))) (+ cy (* r (sin a0)))\n                 (+ cx (* r (cos a1))) (+ cy (* r (sin a1)))\n                 color))\n(wedge 160 120 70 0 1.2 6)\n(wedge 160 120 70 1.2 2.4 3)"
     :eng-program "(set-mode 'sd)\n(define (pie cx cy r fracs colors)\n  ;; fracs sum to 1; each wedge shares cx,cy so the centre is seamless.\n  (let loop ((fs fracs) (cs colors) (a 0))\n    (unless (null? fs)\n      (let ((a1 (+ a (* (car fs) 6.2832))))\n        (triangle-fill cx cy (+ cx (* r (cos a))) (+ cy (* r (sin a)))\n                       (+ cx (* r (cos a1))) (+ cy (* r (sin a1))) (car cs))\n        (loop (cdr fs) (cdr cs) a1)))))\n(pie 160 120 70 (list 0.25 0.35 0.4) (list 6 3 1))"
     :math-program "(set-mode 'sd)\n;; A wedge is the convex hull of the apex and two rim points; its interior is a scanline span set.\n(define (rim cx cy r a) (list (+ cx (* r (cos a))) (+ cy (* r (sin a)))))\n(let ((p (rim 160 120 70 0)) (q (rim 160 120 70 1.2)))\n  (triangle-fill 160 120 (car p) (cadr p) (car q) (cadr q) 6))"
     :cs-program "(set-mode 'sd)\n(define (wedge-guard cx cy r a0 a1 color)\n  (if (< a0 a1)\n      (triangle-fill cx cy (+ cx (* r (cos a0))) (+ cy (* r (sin a0)))\n                     (+ cx (* r (cos a1))) (+ cy (* r (sin a1))) color)\n      (error 'wedge-angles-out-of-order)))\n(wedge-guard 160 120 70 0 1.2 6)"
     :explanation "eng: sweep a running angle so every wedge shares the apex and the seam closes. math: name the wedge as the convex hull of apex plus two rim points. cs: guard that the start angle precedes the end angle before filling."
     :meta "triangle would only outline the wedge, leaving the pie hollow. polygon-fill could fill it but needs an explicit three-point list built per wedge — more allocation than a fixed three-corner fill. ngon-fill draws a whole regular polygon, not a slice. triangle-fill is the solid-wedge primitive; each sibling either leaves the wedge open or fills the wrong region.")
    (:eng "The audit lens is 'does the centre seam close?' — the smoke test is that consecutive wedges reuse the exact apex coordinate, so no anti-seam gap appears at the hub." :math "A circular sector is approximated by the triangle (apex, rim(a₀), rim(a₁)); the approximation error shrinks as a₁−a₀ → 0." :cs "Scanline interior fill; cost is O(area) pixels, one span per row between the two bounding edges."))
  :row-3-dimension (
    (:setup "Sweep a boundary row by row and paint the interior span between the crossings.")
    (:rungs (
       (:domain "triangle-fill" :code "(set-mode 'sd) (triangle-fill 10 10 40 10 25 40 'red)")
       (:domain "irrigation"    :code "(define (rows->watered top bottom left right) (map (lambda (y) (list 'row y 'from left 'to right)) (iota (- bottom top) top)))\n(rows->watered 2 6 1 9)")
       (:domain "integral"      :code "(define (riemann f a b n) (let ((dx (/ (- b a) n))) (fold + 0 (map (lambda (i) (* (f (+ a (* i dx))) dx)) (iota n)))))\n(riemann (lambda (x) x) 0 4 1000)")))
    (:explanation "Rung 1: a triangle is filled by choosing, for each scan row, the left and right edge crossings and colouring the span between them. Rung 2: a field is irrigated row by row, each row watered from a left boundary to a right boundary. Rung 3: a Riemann sum accumulates the area under a curve as a stack of thin horizontal contributions. All three share the same shape — a 2D region is decomposed into a stack of 1D spans, and the whole is the sum of the parts.")
    (:meta "The transfer works because 'a filled area is the integral of its horizontal cross-sections' — Fubini's idea that a double integral is an iterated single integral. Every scanline rasteriser, every coverage sum, and every slab-based volume computation wears this shape. Grounds in book-of-math ch-advanced-06 (calculus-integration) as the area-as-sum-of-slices shape.")
    (:eng "Every scanline substrate shares 'the span endpoints must be computed per row' — the operator's check is that no row leaks past its boundary crossings." :math "By Fubini, area = ∫(right(y) − left(y)) dy; the fill sums the row widths." :cs "Row-major span filling; the shape of every rasteriser and every horizontal sweepline algorithm."))
  :row-4-proof (
    (:claim "A filled triangle's area is homogeneous of degree two: scaling all coordinates by k scales the area by k².")
    (:program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(define a1 (area 0 0 4 0 0 3))\n(define a2 (area 0 0 8 0 0 6))\n(display (= a2 (* 4 a1))) (newline)\n(define a3 (area 0 0 12 0 0 9))\n(display (= a3 (* 9 a1)))"
     :eng-program "(set-mode 'sd)\n;; Doubling a triangle's size covers four times the pixels; both fills run clean.\n(triangle-fill 10 10 30 10 20 30 'red)\n(triangle-fill 100 100 140 100 120 140 'red)"
     :math-program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(define (scale-check k)\n  (let ((base (area 0 0 4 0 0 3))\n        (scaled (area 0 0 (* k 4) 0 0 (* k 3))))\n    (< (abs (- scaled (* k k base))) 0.0001)))\n(and (scale-check 2) (scale-check 3) (scale-check 5))"
     :cs-program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(define (homogeneous-degree-2? k)\n  (= (area 0 0 (* k 6) 0 0 (* k 6)) (* k k (area 0 0 6 0 0 6))))\n(homogeneous-degree-2? 4)"
     :invariant "∀ k > 0. area(k·v₁, k·v₂, k·v₃) = k²·area(v₁, v₂, v₃)  (area is a degree-2 homogeneous function of the coordinates)"
     :meta "The pattern is dimensional scaling — area is a two-dimensional measure, so it grows as the square of a linear factor. Falsified if doubling every coordinate did not quadruple the pixel count; that would contradict the fact that area has units of length². book-of-math ch-advanced-06 grounds the shoelace area formula; book-of-code ch 11 grounds the multiply-accumulate that computes it."))
    (:eng "The operator can predict fill cost: a shape twice as big costs four times the pixels, so a size slider is really a quadratic cost knob." :math "The signed area 1/2·|det[v₂−v₁, v₃−v₁]| scales as the determinant of a k·I scaling, i.e. k²." :cs "Degree-2 homogeneity; the same shape as a nested loop whose work grows as the square of its bound.")
  :row-5-emergence (

    (:base "triangle-fill paints one solid three-cornered region.")
    (:composition "(set-mode 'sd)\n;; A pine tree: three stacked green triangle tiers over a brown trunk.\n(triangle-fill 150 60 170 60 160 30 3)\n(triangle-fill 140 100 180 100 160 55 3)\n(triangle-fill 130 140 190 140 160 90 3)\n(polygon-fill (list (list 155 140) (list 165 140) (list 165 170) (list 155 170)) 4)"
     :eng-composition "(set-mode 'sd)\n(define (conifer cx base-y tiers color trunk)\n  (for-each (lambda (i)\n              (let* ((w (* 12 (+ i 2))) (y (- base-y (* i 30))))\n                (triangle-fill (- cx w) y (+ cx w) y cx (- y 45) color)))\n            (iota tiers))\n  (polygon-fill (list (list (- cx 5) base-y) (list (+ cx 5) base-y)\n                      (list (+ cx 5) (+ base-y 20)) (list (- cx 5) (+ base-y 20))) trunk))\n(conifer 160 150 3 3 4)"
     :math-composition "(set-mode 'sd)\n;; A convex fan: fill a hexagon as six triangles from its centre.\n(let ((cx 160) (cy 120) (r 50))\n  (for-each (lambda (i)\n              (let ((a0 (* i 1.0472)) (a1 (* (+ i 1) 1.0472)))\n                (triangle-fill cx cy (+ cx (* r (cos a0))) (+ cy (* r (sin a0)))\n                               (+ cx (* r (cos a1))) (+ cy (* r (sin a1))) (+ 1 (modulo i 6)))))\n            (iota 6)))"
     :cs-composition "(set-mode 'sd)\n;; Quad-as-two-triangles: fill a rectangle by its diagonal split, the mesh renderer's primitive.\n(define (quad-fill x0 y0 x1 y1 color)\n  (triangle-fill x0 y0 x1 y0 x1 y1 color)\n  (triangle-fill x0 y0 x1 y1 x0 y1 color))\n(quad-fill 100 80 220 160 6)"
     :emergent "A pine tree, a fan-filled hexagon, and a diagonal-split quad: the same solid-triangle fill, stacked or fanned, builds a recognisable object and then the fan and quad decompositions that every filled-polygon rasteriser uses internally.")
    (:meta "This is the polygon-triangulation family — fill any convex region by fanning triangles from one vertex, and any quad as two triangles. Familiar analogs are GPU triangle rasterisation, ear-clipping triangulation, and finite-element meshing. The composition works because a solid triangle is the atomic fill cell, so every filled shape is a union of them.")
    (:eng "The audit lens is 'fan from the correct pivot' — for a convex polygon any vertex works as the fan apex, but for a concave one it does not; the smoke test is that no fan triangle spills outside the outline." :math "A convex n-gon fans into n−2 triangles from any vertex; the union of their interiors is the polygon's interior." :cs "Fan triangulation; the shape of every convex-polygon fill and every quad-to-two-triangles conversion."))
)

(verb
  :name "polygon" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(polygon points [color]) -> undefined"
  :summary "Stroke the closed outline through an ordered list of points, joining the last back to the first."
  :explanation "polygon is the general outline primitive: hand it an ordered list of vertices — each a (list x y) — and it draws a segment between consecutive points and a final segment closing the last vertex back to the first. Unlike triangle it accepts any number of corners, so it draws pentagons, arrows, gears-in-outline, hand-plotted curves sampled into points, and any closed path you can express as a vertex list. Order matters here in a way it does not for a triangle: the edges follow the list order, so the winding of the points is the shape you get. It strokes only; the interior is left alone (use polygon-fill for a solid). The optional trailing colour defaults to the current pen. Because the input is data, not fixed arguments, polygon is where drawing meets computation — you generate the vertices with map/iota and the outline follows."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (polygon (list (list 5 5) (list 30 5) (list 20 30)) 9)" :note "A three-point list draws a triangle outline — polygon with three vertices is the general form of triangle.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A right-pointing arrow as a seven-vertex outline.\n(polygon (list (list 100 110) (list 150 110) (list 150 100)\n               (list 180 120) (list 150 140) (list 150 130) (list 100 130)) 6)" :note "Seven vertices trace a block arrow; the closing edge returns from the tail to the start automatically.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A regular pentagon computed from angles, then stroked.\n(define pts\n  (map (lambda (i)\n         (let ((a (- (* i (/ 6.2832 5)) 1.5708)))\n           (list (+ 160 (* 40 (cos a))) (+ 120 (* 40 (sin a))))))\n       (iota 5)))\n(polygon pts 7)" :note "Generate five evenly-spaced points on a circle and stroke the closed path through them — the outline follows the computed vertex list.")
  )
  :caveats ("The path is closed automatically; do not repeat the first point at the end or you draw a zero-length final edge." "Winding order determines the drawn edges — reversing the list draws the same outline but is a different traversal." "A self-intersecting vertex list draws a self-crossing outline (a star-of-David from two triangles' worth of points, for instance)." "Only the outline is stroked; use polygon-fill for the interior.")
  :drawbacks ("No line width — every edge is one pixel." "Building the vertex list is the caller's job; a wrong point count or a swapped x/y silently draws the wrong shape." "No automatic convexity or simplicity check; degenerate lists still draw.")
  :usecases ("Arbitrary closed outlines: arrows, banners, hand-plotted silhouettes." "Sampled-curve outlines where a function is evaluated into a point list." "Regular and irregular polygon outlines generated from angle math." "Wireframe previews of a filled region before committing to the fill.")
  :related ("poly" "polygon-fill" "triangle" "ngon")
  :learn (:concept "A polygon as a closed piecewise-linear curve — an ordered vertex list whose edges connect consecutive points and close back to the start." :prerequisites ("triangle") :progression "Start with three-point polygons (triangles), then arbitrary outlines, then let polygon-fill paint the interior and ngon generate regular vertex lists for you.")
  :row-2-audit (

    (:problem "A UI author is drawing a speech-bubble outline whose tail points at a speaker. The shape is a rounded-ish box with a little triangular tail — it has seven or eight corners and must be one continuous closed outline, not separate strokes that leave gaps at the joins."
     :program "(set-mode 'sd)\n(polygon (list (list 80 60) (list 200 60) (list 200 110)\n               (list 130 110) (list 110 130) (list 115 110)\n               (list 80 110)) 7)"
     :eng-program "(set-mode 'sd)\n(define (bubble x y w h tail-x color)\n  ;; One vertex list = one closed outline = no seam at any corner.\n  (polygon (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h))\n                 (list (+ tail-x 15) (+ y h)) (list tail-x (+ y h 20))\n                 (list (+ tail-x 5) (+ y h)) (list x (+ y h)))\n           color))\n(bubble 80 60 120 50 120 7)"
     :math-program "(set-mode 'sd)\n;; The outline is a closed polyline: n vertices, n edges, edge i joins vertex i to i+1 mod n.\n(define verts (list (list 80 60) (list 200 60) (list 200 110) (list 80 110)))\n(polygon verts 7)"
     :cs-program "(set-mode 'sd)\n(define (draw-outline verts color)\n  (if (and (list? verts) (>= (length verts) 3))\n      (polygon verts color)\n      (error 'need-at-least-three-vertices)))\n(draw-outline (list (list 80 60) (list 200 60) (list 140 110)) 7)"
     :explanation "eng: build the whole tail-and-box as one vertex list so the closing edge seals it. math: state the closed-polyline structure (n vertices, n edges, wrap at the end). cs: guard that at least three vertices are present before drawing."
     :meta "Stroking each edge with a separate line call risks a one-pixel gap at every corner and forgets to close the loop. triangle cannot express seven corners. ngon draws only regular shapes, so it cannot make an asymmetric tail. polygon is the arbitrary-closed-outline primitive; the siblings either leak at the joins or cannot express the shape.")
    (:eng "The audit lens is 'is it one closed loop?' — the smoke test is that the last edge returns to the first vertex with no gap, which a single polygon call guarantees and hand-strung line calls do not." :math "A closed polyline of n vertices has exactly n edges: (vᵢ, vᵢ₊₁) for i in 0..n−1 with indices mod n." :cs "One traversal over the vertex list emitting n edges; O(n) line-draws, closure implicit."))
  :row-3-dimension (
    (:setup "Visit an ordered list of points, connect each to the next, and return to the start.")
    (:rungs (
       (:domain "polygon"     :code "(set-mode 'sd) (polygon (list (list 5 5) (list 30 5) (list 20 30)) 9)")
       (:domain "patrol-route" :code "(define stops (list 'gate 'lobby 'vault 'roof))\n(define (route ss) (map list ss (append (cdr ss) (list (car ss)))))\n(route stops)")
       (:domain "cyclic-graph" :code "(define (cycle-edges ns) (map cons ns (append (cdr ns) (list (car ns)))))\n(cycle-edges (list 1 2 3 4 5))")))
    (:explanation "Rung 1: an ordered vertex list is stroked edge by edge and closed back to the first point. Rung 2: a security patrol visits stops in order and loops back to the start of its round. Rung 3: a cyclic graph connects each node to the next and the last to the first, forming a Hamiltonian cycle. All three share the same shape — an ordered sequence turned into a closed circuit by joining consecutive elements and wrapping the tail to the head.")
    (:meta "The transfer works because a polygon is a cycle graph embedded in the plane: the pure combinatorial object is 'visit in order, return to start'. Every round-trip route, ring buffer, and cyclic schedule is the same wrap-around traversal. Grounds in book-of-math ch-advanced-13 (topology) as the closed-loop / 1-cycle shape.")
    (:eng "Every closed-circuit substrate shares 'the wrap-around edge is the one most often forgotten' — the operator's check is that the loop returns home." :math "A polygon is the image of a cyclic sequence under 'connect consecutive'; it is a 1-dimensional cycle in the plane." :cs "Zip a list with its rotation-by-one to produce the edge list; O(n) and closes automatically."))
  :row-4-proof (
    (:claim "An n-vertex polygon has exactly n edges: the number of segments equals the number of vertices because the closing edge replaces the missing open end.")
    (:program "(define (edges verts)\n  (map list verts (append (cdr verts) (list (car verts)))))\n(define (n-edges verts) (length (edges verts)))\n(display (= (n-edges (list 'a 'b 'c)) 3)) (newline)\n(display (= (n-edges (list 'a 'b 'c 'd 'e)) 5)) (newline)\n(display (= (n-edges (list 'a 'b 'c 'd 'e 'f 'g)) 7))"
     :eng-program "(set-mode 'sd)\n;; Three, five, and seven-vertex outlines each close cleanly; all run.\n(polygon (list (list 20 20) (list 60 20) (list 40 60)) 7)\n(polygon (list (list 100 20) (list 150 20) (list 165 60) (list 125 90) (list 85 60)) 7)"
     :math-program "(define (v-eq-e? verts)\n  (= (length verts)\n     (length (map list verts (append (cdr verts) (list (car verts)))))))\n(and (v-eq-e? (list 1 2 3)) (v-eq-e? (list 1 2 3 4 5 6)))"
     :cs-program "(define (edge-count verts)\n  ;; zip-with-rotation: one edge per vertex, closure implicit.\n  (length (map cons verts (append (cdr verts) (list (car verts))))))\n(list 'v 6 'e (edge-count (list 1 2 3 4 5 6)))"
     :invariant "∀ vertex-list L with |L| ≥ 3. |edges(L)| = |L|  (a closed polygon has as many edges as vertices)"
     :meta "The pattern is that closing a path makes edges and vertices equinumerous — an open polyline of n points has n−1 edges, but wrapping the tail to the head adds the one missing edge. Falsified if a closed polygon ever had a different edge count than its vertex count; that would mean the closing edge was dropped or doubled. book-of-math ch-advanced-13 (topology) grounds the Euler-characteristic bookkeeping (V − E + F); book-of-code ch 05 grounds the zip-with-rotation that pairs each item with its successor."))
    (:eng "The operator can budget the stroke cost directly from the vertex count — n vertices means n line-draws, no hidden closing surprise." :math "For a simple closed polygon V = E, and with one interior face F = 2, satisfying V − E + F = 2." :cs "Edge count equals vertex count under cyclic pairing; the same shape as a ring buffer where every slot has exactly one successor.")
  :row-5-emergence (

    (:base "polygon strokes one closed outline through an ordered vertex list.")
    (:composition "(set-mode 'sd)\n;; A house: a square wall outline, a triangle roof, a door — all as polygons.\n(polygon (list (list 110 120) (list 210 120) (list 210 190) (list 110 190)) 7)  ; wall\n(polygon (list (list 100 120) (list 220 120) (list 160 80)) 4)                   ; roof\n(polygon (list (list 145 190) (list 175 190) (list 175 150) (list 145 150)) 6)   ; door"
     :eng-composition "(set-mode 'sd)\n(define (house cx base-y w h color)\n  (let ((left (- cx (/ w 2))) (right (+ cx (/ w 2))) (top (- base-y h)))\n    (polygon (list (list left base-y) (list right base-y) (list right top) (list left top)) color)\n    (polygon (list (list (- left 10) top) (list (+ right 10) top) (list cx (- top 35))) 4)))\n(house 160 190 100 70 7)"
     :math-composition "(set-mode 'sd)\n;; Sample sin into a vertex list, close it, and stroke — a function's graph as a polygon.\n(define pts\n  (map (lambda (i) (list (+ 40 (* i 12)) (- 120 (* 30 (sin (* i 0.5)))))) (iota 20)))\n(polygon pts 3)"
     :cs-composition "(set-mode 'sd)\n;; A star polygon by connecting every second vertex of a pentagon (a {5/2} star).\n(define (star-poly cx cy r n step)\n  (let ((order (map (lambda (i) (modulo (* i step) n)) (iota n))))\n    (polygon (map (lambda (k) (let ((a (- (* k (/ 6.2832 n)) 1.5708)))\n                                (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n                  order) 'yellow)))\n(star-poly 160 120 50 5 2)"
     :emergent "A house, a plotted sine curve, and a five-pointed star polygon: the same close-the-vertex-list stroke builds a recognisable scene, then a function graph, then a star — proving the primitive spans both hand-placed and computed vertex lists.")
    (:meta "This is the parametric-outline family — express any closed shape as a computed vertex list and stroke it. Familiar analogs are SVG path data, plotter pen paths, and marching-squares contour lines. The composition works because polygon takes data, so wherever you can produce an ordered point list — by hand, by sampling a function, or by index arithmetic — you get its outline.")
    (:eng "The audit lens is 'the vertex list is the contract' — an SRE probe checks the point count and the x/y ranges before drawing, because a bad list draws a plausible-but-wrong outline silently." :math "Any closed planar curve is approximable by a polygon whose vertices sample it; error shrinks with vertex density." :cs "Data-driven outline; the shape of every path renderer whose input is a computed sequence of points."))
)

(verb
  :name "poly" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(poly points [color]) -> undefined"
  :summary "Short alias of polygon: stroke the closed outline through a point list — the name you reach for while sketching."
  :explanation "poly is polygon under a shorter name. The two are the same operation with the same arguments and the same result; poly exists because in the REPL, in a tight loop body, or in a cart you type dozens of times a minute, four fewer characters matters. Prefer poly when you are sketching, prototyping, or writing dense generative code where the outline call appears many times; prefer the full polygon when you are writing a reference example or teaching code where the long name reads more clearly. There is no behavioural difference — every property of polygon (auto-closing, order-sensitivity, outline-only) holds identically. The alias is a keystroke-economy convenience, not a second implementation."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (poly (list (list 5 5) (list 30 5) (list 20 30)))" :note "Same triangle outline as polygon, four characters shorter — the everyday sketching form.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; In a tight generative loop the short name keeps the body readable.\n(for-each\n  (lambda (i)\n    (let ((x (* i 40)))\n      (poly (list (list x 100) (list (+ x 30) 100) (list (+ x 15) 130)) (+ 1 i))))\n  (iota 6))" :note "A row of six triangle outlines; poly keeps each loop iteration compact.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A quick lightning bolt sketched as a zig-zag outline.\n(poly (list (list 150 40) (list 130 100) (list 155 100)\n            (list 135 180) (list 190 90) (list 165 90)\n            (list 180 40)) 'yellow)" :note "Seven vertices trace a bolt; the short name suits fast, throwaway shape sketches.")
  )
  :caveats ("poly and polygon are identical; do not assume poly is faster or different — it is the same call." "All of polygon's caveats apply unchanged: auto-closing, order-sensitivity, outline-only, no line width." "Mixing poly and polygon in one file is legal but stylistically noisy; pick one per context." "The alias saves keystrokes, not cycles — there is no performance reason to prefer it.")
  :drawbacks ("A shorter name is slightly less self-documenting to a first-time reader." "Two names for one verb can confuse grep/search over a codebase." "Inherits every drawback of polygon: no width, caller-built vertex lists, no simplicity check.")
  :usecases ("REPL sketching and live-coding where typing speed matters." "Dense generative loops that emit many outlines." "Cart code where the outline call recurs on many lines." "Any place polygon would be used but brevity is preferred.")
  :related ("polygon" "fill-poly" "triangle" "ngon")
  :learn (:concept "Aliasing — one operation exposed under two names for ergonomic reasons, with identical semantics." :prerequisites ("polygon") :progression "Learn polygon first for its full behaviour, adopt poly as the shorthand, and note the same pairing between polygon-fill and its alias fill-poly.")
  :row-2-audit (

    (:problem "A developer is live-coding a demo at a workshop, typing shape outlines into the REPL as the audience watches. Every extra character is a chance to fat-finger and a beat of dead air; they want the shortest correct name for a closed outline."
     :program "(set-mode 'sd)\n(poly (list (list 40 40) (list 120 40) (list 80 100)) 3)"
     :eng-program "(set-mode 'sd)\n;; In an outline-heavy session the short name pays off on every call.\n(poly (list (list 40 40) (list 120 40) (list 80 100)) 3)\n(poly (list (list 140 40) (list 220 40) (list 180 100)) 6)"
     :math-program "(set-mode 'sd)\n;; poly and polygon denote the same function of a vertex list; either draws the same edge set.\n(poly (list (list 40 40) (list 120 40) (list 80 100)) 3)\n(polygon (list (list 40 40) (list 120 40) (list 80 100)) 3)"
     :cs-program "(set-mode 'sd)\n;; The alias is referentially transparent: substituting poly for polygon changes nothing but the token.\n(define (outline verts color) (poly verts color))\n(outline (list (list 40 40) (list 120 40) (list 80 100)) 3)"
     :explanation "eng: bind an even terser local handle for an outline-heavy session. math: assert the two names denote one function by drawing the same shape both ways. cs: wrap poly to show the alias is referentially transparent."
     :meta "polygon is the same verb with a longer name — correct but slower to type in a live session. triangle only handles three corners, so it cannot sketch the general outline the demo needs. ngon draws regular shapes only. poly is the brevity-optimised alias of the general outline; the siblings are longer, narrower, or a different shape.")
    (:eng "The audit lens is 'is the shortest correct tool being used for the hot typing path?' — the smoke test is that poly and polygon produce pixel-identical output, so the choice is purely ergonomic." :math "poly = polygon as functions: same domain (vertex lists), same codomain (a stroked outline), same graph." :cs "Name aliasing; a compile-time renaming with zero runtime cost, the same as a `using` or `import as` shorthand."))
  :row-3-dimension (
    (:setup "Expose one underlying operation under a second, shorter name for the sake of the person typing.")
    (:rungs (
       (:domain "poly"        :code "(set-mode 'sd) (poly (list (list 5 5) (list 30 5) (list 20 30)))")
       (:domain "shell-alias" :code "(define (alias-table) (list (cons 'll 'list-long) (cons 'gs 'git-status)))\n(assq 'll (alias-table))")
       (:domain "synonym"     :code "(define (means-same? a b synonyms) (or (eq? a b) (member (cons a b) synonyms)))\n(means-same? 'poly 'polygon (list (cons 'poly 'polygon)))")))
    (:explanation "Rung 1: poly names the same outline operation as polygon in fewer characters. Rung 2: a shell alias like `ll` stands for a longer command so the operator types less. Rung 3: two words are synonyms when they denote the same thing, so either may be used. All three share the same shape — one referent, two surface forms, chosen for convenience, with no change in meaning.")
    (:meta "The transfer works because aliasing is the identity map wearing two labels: the referent is fixed and only the sign varies. Every shell alias, keyboard shortcut, and language synonym is this same one-thing-two-names structure. Grounds in book-of-code ch 14 (assembly-then-higher) as the macro/alias-expansion shape and in the word-books as the synonymy relation.")
    (:eng "Every alias substrate shares 'the alias must track the original' — if polygon's behaviour changed, poly must change with it, or the alias lies." :math "An alias is an equality of denotation: two names, one element of the function space." :cs "Reference aliasing; a second binding to the same closure, resolved at name-lookup with no dispatch cost."))
  :row-4-proof (
    (:claim "poly is behaviourally indistinguishable from polygon: for every vertex list and colour, the two calls paint the identical result.")
    (:program "(define (edges verts) (map list verts (append (cdr verts) (list (car verts)))))\n;; The alias models the same edge computation; the outputs are structurally equal.\n(define vs (list (list 5 5) (list 30 5) (list 20 30)))\n(display (equal? (edges vs) (edges vs))) (newline)\n(display (eq? 'poly 'poly))"
     :eng-program "(set-mode 'sd)\n;; Draw the same shape with each name; if the alias diverged, one call would differ. Both run clean.\n(poly (list (list 60 60) (list 120 60) (list 90 110)) 3)\n(polygon (list (list 60 60) (list 120 60) (list 90 110)) 3)"
     :math-program "(set-mode 'sd)\n;; Same vertex list, both names — the drawn edge set is the same function of the input.\n(let ((vs (list (list 60 60) (list 120 60) (list 90 110))))\n  (poly vs 3)\n  (polygon vs 3))"
     :cs-program "(set-mode 'sd)\n(define (via-alias vs c) (poly vs c))\n(define (via-full vs c) (polygon vs c))\n;; Both wrappers close over the same operation; substitution is safe.\n(via-alias (list (list 60 60) (list 120 60) (list 90 110)) 3)\n(via-full (list (list 60 60) (list 120 60) (list 90 110)) 3)"
     :invariant "∀ points color. poly(points, color) ≡ polygon(points, color)  (the alias is observationally equal to the original)"
     :meta "The pattern is observational equivalence — two expressions are equal if no context can distinguish them. Falsified if any vertex list drew differently under poly than under polygon; that would mean the alias is not an alias but a divergent second verb. book-of-code ch 05 grounds substitution/equational reasoning; book-of-math ch-advanced-05 grounds the identity morphism that an alias instantiates."))
    (:eng "The operator can refactor poly ↔ polygon anywhere without a visual diff; the rendered frame is byte-identical." :math "poly and polygon are the same point in function space; the map between the two names is the identity." :cs "Observational equivalence under substitution; the same guarantee a compiler gives when inlining an alias.")
  :row-5-emergence (

    (:base "poly strokes a closed outline, just like polygon, in fewer keystrokes.")
    (:composition "(set-mode 'sd)\n;; A quick rocket sketched entirely with the short name: body, nose, two fins.\n(poly (list (list 150 60) (list 170 60) (list 170 150) (list 150 150)) 6)   ; body\n(poly (list (list 150 60) (list 170 60) (list 160 35)) 4)                   ; nose\n(poly (list (list 150 150) (list 135 175) (list 150 130)) 8)               ; left fin\n(poly (list (list 170 150) (list 185 175) (list 170 130)) 8)               ; right fin"
     :eng-composition "(set-mode 'sd)\n(define (sketch-shapes specs)\n  ;; A batch sketcher: each spec is (vertex-list . color); poly keeps the body terse.\n  (for-each (lambda (s) (poly (car s) (cdr s))) specs))\n(sketch-shapes (list (cons (list (list 40 40) (list 90 40) (list 65 90)) 3)\n                     (cons (list (list 110 40) (list 160 40) (list 135 90)) 6)\n                     (cons (list (list 180 40) (list 230 40) (list 205 90)) 7)))"
     :math-composition "(set-mode 'sd)\n;; Rotate one outline by copies to make a rosette; the short name suits the dense loop.\n(let ((cx 160) (cy 120))\n  (for-each (lambda (k)\n              (let ((rot (* k 0.5236)))\n                (poly (map (lambda (i)\n                             (let ((a (+ rot (* i 2.094))))\n                               (list (+ cx (* 50 (cos a))) (+ cy (* 50 (sin a))))))\n                           (iota 3))\n                      (+ 1 (modulo k 8)))))\n            (iota 12)))"
     :cs-composition "(set-mode 'sd)\n;; A turtle-style path builder that emits with poly on each closed segment.\n(define (closed-path . vs) (poly vs 'white))\n(closed-path (list 100 100) (list 200 100) (list 200 160) (list 100 160))"
     :emergent "A rocket, a batch of sketched triangles, and a twelve-fold rosette: the short alias makes dense generative and live-coded scenes readable, so the same outline primitive scales from one keystroke-saving call to a whole rotated pattern.")
    (:meta "This is the ergonomics-of-repetition family — a shorthand pays off exactly where the operation recurs. Familiar analogs are shell aliases in a scripting session, single-letter loop variables, and terse combinators in point-free code. The composition works because poly is literally polygon, so every compositional property of the full name transfers with none of the typing.")
    (:eng "The audit lens is 'brevity must not cost clarity in shipped code' — the SRE guidance is poly for sketches and hot loops, polygon for reviewed reference examples; the rendered result is the same either way." :math "Repeated application of the same aliased operation composes exactly as the original would; the alias distributes over composition." :cs "Shorthand-in-a-hot-loop; the shape of every terse binding introduced to keep a dense body legible."))
)

(verb
  :name "polygon-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(polygon-fill points [color]) -> undefined"
  :summary "Paint the solid interior of an arbitrary polygon using an even-odd scanline fill."
  :explanation "polygon-fill floods the inside of any closed vertex list — convex or concave, simple or self-intersecting — with a solid colour. The rule it uses is even-odd (also called the crossing-number rule): for each pixel, count how many polygon edges a ray from that pixel crosses; an odd count means inside, even means outside. This handles stars, arrows, gears, and letter shapes where a naive fan-from-centre would spill outside the outline. It is the general solid-shape workhorse: where triangle-fill handles the three-corner base case and ngon-fill handles regular shapes, polygon-fill takes any outline you can express as points and gives you the mass. The optional colour is trailing and defaults to the current pen. Because self-intersecting lists follow the even-odd rule, overlapping loops carve holes — the pentagram's centre stays empty."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (polygon-fill (list (list 5 5) (list 30 5) (list 20 30)) 'green)" :note "A solid green triangle expressed as a three-point list — the general fill applied to the simplest case.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A concave chevron (arrow-block) filled solid — even-odd handles the inward notch.\n(polygon-fill (list (list 100 60) (list 140 60) (list 160 100)\n                    (list 140 140) (list 100 140) (list 120 100)) 6)" :note "The inward point at (120,100) makes this concave; even-odd fills only the true interior.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A solid five-pointed star computed from ten alternating inner/outer vertices.\n(define star-pts\n  (map (lambda (i)\n         (let ((a (- (* i (/ 3.14159 5)) 1.5708))\n               (r (if (even? i) 60 24)))\n           (list (+ 160 (* r (cos a))) (+ 120 (* r (sin a))))))\n       (iota 10)))\n(polygon-fill star-pts 'yellow)" :note "Ten vertices alternating between outer radius 60 and inner radius 24 make a star; even-odd fills the five-pointed body correctly.")
  )
  :caveats ("Uses the even-odd rule: a self-intersecting outline leaves overlap regions unfilled (a pentagram is hollow at the centre)." "The list is treated as closed; do not repeat the first point at the end." "Fill covers whatever was underneath — order back-to-front for layering." "Very many vertices make the per-row crossing test costlier; the fill is O(area × edges) in the worst case.")
  :drawbacks ("Flat colour only — no gradient, texture, or pattern fill." "Even-odd differs from the non-zero winding rule; shapes designed for winding fill may look wrong." "No hole-list argument; holes must be created by self-intersection or drawn over afterward.")
  :usecases ("Solid stars, arrows, chevrons, and gear teeth." "Filled letter and glyph shapes." "Coloured regions of a filled chart or map." "Any concave solid a fan-from-centre fill would get wrong.")
  :related ("fill-poly" "polygon" "triangle-fill" "ngon-fill")
  :learn (:concept "Even-odd (crossing-number) polygon filling — deciding inside/outside by counting edge crossings, which handles concave and self-intersecting shapes." :prerequisites ("polygon" "triangle-fill") :progression "Fill a convex triangle with triangle-fill, then a concave outline with polygon-fill, then let ngon-fill build regular filled shapes from a vertex count.")
  :row-2-audit (

    (:problem "A game artist is drawing a solid gold star pickup. Filling it as a fan of triangles from the centre works for the star's body, but if the outline is ever tweaked into a concave crown shape the fan spills outside the points — they want a fill that respects any outline they draw."
     :program "(set-mode 'sd)\n(define star-pts\n  (map (lambda (i)\n         (let ((a (- (* i (/ 3.14159 5)) 1.5708)) (r (if (even? i) 55 22)))\n           (list (+ 160 (* r (cos a))) (+ 120 (* r (sin a))))))\n       (iota 10)))\n(polygon-fill star-pts 'yellow)"
     :eng-program "(set-mode 'sd)\n(define (solid-star cx cy ro ri color)\n  (polygon-fill\n    (map (lambda (i)\n           (let ((a (- (* i (/ 3.14159 5)) 1.5708)) (r (if (even? i) ro ri)))\n             (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n         (iota 10))\n    color))\n(solid-star 160 120 55 22 'yellow)"
     :math-program "(set-mode 'sd)\n;; The interior is {p : crossing-number(p) is odd}; even-odd is robust to concavity.\n(define pts (list (list 100 60) (list 140 60) (list 160 100)\n                  (list 140 140) (list 100 140) (list 120 100)))\n(polygon-fill pts 6)"
     :cs-program "(set-mode 'sd)\n(define (fill-guard pts color)\n  (if (>= (length pts) 3)\n      (polygon-fill pts color)\n      (error 'polygon-needs-three-points)))\n(fill-guard (list (list 100 60) (list 140 60) (list 120 120)) 6)"
     :explanation "eng: wrap the star vertex math into a by-centre-and-radii constructor. math: name the interior as the odd-crossing-number set. cs: guard the minimum vertex count before filling."
     :meta "triangle-fill handles only three corners, so it cannot fill a ten-vertex star in one call. A fan of triangle-fills from the centre spills outside a concave crown. ngon-fill draws a convex regular polygon, not a star. polygon-fill with even-odd is the arbitrary-solid primitive; the siblings either can't express the shape or fill outside it.")
    (:eng "The audit lens is 'does the fill stay inside a concave outline?' — the smoke test is drawing a chevron and confirming the notch stays empty, which even-odd guarantees and a centre-fan does not." :math "Even-odd: p is inside iff a ray from p crosses the boundary an odd number of times; robust to concavity and self-intersection." :cs "Scanline fill with per-row crossing sort; cost O(rows × edges), the classic polygon rasteriser."))
  :row-3-dimension (
    (:setup "Decide membership in a region by parity of boundary crossings.")
    (:rungs (
       (:domain "polygon-fill" :code "(set-mode 'sd) (polygon-fill (list (list 100 60) (list 140 60) (list 160 100) (list 140 140) (list 100 140) (list 120 100)) 6)")
       (:domain "maze"         :code "(define (inside-cell? walls-crossed) (odd? walls-crossed))\n(list (inside-cell? 1) (inside-cell? 2) (inside-cell? 3))")
       (:domain "parity"       :code "(define (jordan-inside? crossings) (odd? crossings))\n(map jordan-inside? (list 0 1 2 3 4))")))
    (:explanation "Rung 1: a pixel is filled when a ray from it crosses the polygon's edges an odd number of times. Rung 2: after passing an odd number of walls you are inside a room, an even number and you are back outside. Rung 3: the Jordan curve theorem says a simple closed curve splits the plane into inside and outside, distinguished by crossing parity. All three share the same shape — inside-ness is a parity question, decided by counting how many times a path pierces the boundary.")
    (:meta "The transfer works because 'inside means an odd number of boundary crossings' is the Jordan-curve / crossing-number invariant, independent of the region's shape. Every point-in-region test, every wall-count in a maze, and every topological inside/outside call is this parity check. Grounds in book-of-math ch-advanced-13 (topology) as the Jordan-curve / winding-parity shape.")
    (:eng "Every parity-membership substrate shares 'a boundary touched exactly on an edge is ambiguous' — the operator's fix is a consistent tie-break rule at vertices." :math "Crossing-number mod 2 is a homotopy invariant of the ray relative to the closed boundary curve." :cs "Ray-cast crossing count; the shape of every point-in-polygon and every scanline coverage test."))
  :row-4-proof (
    (:claim "The filled area computed by the shoelace formula is invariant under a cyclic shift of the vertex list: rotating which vertex is first does not change the enclosed area.")
    (:program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed)))\n            2))))\n(define sq (list (list 0 0) (list 4 0) (list 4 3) (list 0 3)))\n(define sq-rot (list (list 4 0) (list 4 3) (list 0 3) (list 0 0)))\n(display (= (shoelace sq) 12)) (newline)\n(display (= (shoelace sq) (shoelace sq-rot)))"
     :eng-program "(set-mode 'sd)\n;; Filling the same square from two different starting vertices covers the same pixels; both run.\n(polygon-fill (list (list 40 40) (list 100 40) (list 100 100) (list 40 100)) 6)\n(polygon-fill (list (list 100 100) (list 40 100) (list 40 40) (list 100 40)) 6)"
     :math-program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed))) 2))))\n(define (rotate xs) (append (cdr xs) (list (car xs))))\n(define tri (list (list 0 0) (list 6 0) (list 3 6)))\n(and (= (shoelace tri) (shoelace (rotate tri)))\n     (= (shoelace tri) (shoelace (rotate (rotate tri)))))"
     :cs-program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed))) 2))))\n(define (cyclic-invariant? pts)\n  (= (shoelace pts) (shoelace (append (cdr pts) (list (car pts))))))\n(cyclic-invariant? (list (list 0 0) (list 5 0) (list 5 4) (list 0 4)))"
     :invariant "∀ polygon P, ∀ cyclic rotation ρ. area(P) = area(ρ(P))  (the enclosed area depends on the cyclic order of vertices, not on which one is listed first)"
     :meta "The pattern is that area is a function of the cyclic sequence, not the linear one — rotating the start vertex is a relabelling that the shoelace sum absorbs. Falsified if starting the same outline at a different vertex changed the filled area; that would mean the fill depends on an arbitrary list origin. book-of-math ch-advanced-06 (calculus-integration) grounds the shoelace formula as a discrete Green's theorem; book-of-code ch 10 grounds cyclic-shift invariance."))
    (:eng "The operator can start a polygon's vertex list at whichever corner the data provides; the filled region and its area are identical." :math "The shoelace sum ½|Σ(xᵢyᵢ₊₁ − xᵢ₊₁yᵢ)| is invariant under cyclic index shift because the sum wraps." :cs "Cyclic-shift invariance; the same shape as a checksum over a ring that ignores the rotation origin.")
  :row-5-emergence (

    (:base "polygon-fill paints the solid interior of any closed outline.")
    (:composition "(set-mode 'sd)\n;; A robot: a filled body, a filled head, two eye squares, and an antenna triangle.\n(polygon-fill (list (list 120 110) (list 200 110) (list 200 190) (list 120 190)) 8)  ; body\n(polygon-fill (list (list 135 70) (list 185 70) (list 185 105) (list 135 105)) 6)     ; head\n(polygon-fill (list (list 145 82) (list 155 82) (list 155 92) (list 145 92)) 'white)  ; eye\n(polygon-fill (list (list 165 82) (list 175 82) (list 175 92) (list 165 92)) 'white)  ; eye\n(triangle-fill 155 70 165 70 160 55 3)                                                ; antenna"
     :eng-composition "(set-mode 'sd)\n(define (bar-chart heights base-y bar-w color)\n  ;; Each bar is a filled quad; the chart is a fold over the data.\n  (let loop ((hs heights) (x 40))\n    (unless (null? hs)\n      (polygon-fill (list (list x base-y) (list (+ x bar-w) base-y)\n                          (list (+ x bar-w) (- base-y (car hs))) (list x (- base-y (car hs))))\n                    color)\n      (loop (cdr hs) (+ x bar-w 10)))))\n(bar-chart (list 40 80 120 60 100) 190 25 6)"
     :math-composition "(set-mode 'sd)\n;; Approximate a filled disc by an n-gon vertex list — as n grows the polygon fills a circle.\n(define (disc-approx cx cy r n color)\n  (polygon-fill (map (lambda (i)\n                       (let ((a (* i (/ 6.2832 n))))\n                         (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n                     (iota n))\n                color))\n(disc-approx 160 120 50 24 'cyan)"
     :cs-composition "(set-mode 'sd)\n;; A letter 'L' as a concave six-vertex solid — even-odd fills the true glyph interior.\n(polygon-fill (list (list 120 60) (list 150 60) (list 150 160)\n                    (list 210 160) (list 210 190) (list 120 190)) 7)"
     :emergent "A robot, a bar chart, a polygonal disc, and a solid letter L: the same even-odd fill turns any vertex list — hand-placed, data-driven, sampled from a circle, or a concave glyph — into a recognisable solid object.")
    (:meta "This is the region-fill family — any bounded region expressible as an outline becomes a coloured mass. Familiar analogs are flood-fill in paint programs, GPU polygon rasterisation, and font-glyph rendering. The composition works because even-odd fill is outline-general, so bars, discs, glyphs, and freehand shapes all fill from the same primitive.")
    (:eng "The audit lens is 'the outline determines the fill' — an SRE probe checks the vertex list is simple (non-self-intersecting) when a solid, hole-free fill is intended, since even-odd carves holes where loops overlap." :math "The filled set is the odd-crossing region of the plane relative to the boundary; area is the shoelace integral." :cs "Even-odd scanline fill; the shape of every rasteriser that turns a boundary into a coloured region."))
)

(verb
  :name "fill-poly" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(fill-poly points [color]) -> undefined"
  :summary "Short alias of polygon-fill: solid-fill a vertex list, completing the poly/fill-poly naming pair."
  :explanation "fill-poly is polygon-fill under a shorter, verb-first name. The library gives you two aliasing pairs that mirror each other: poly is the short outline (= polygon) and fill-poly is the short solid (= polygon-fill). The verb-leading word order — fill first, then poly — reads as an imperative and pairs naturally with poly when both appear in the same sketch: 'poly this, fill-poly that'. Behaviour is identical to polygon-fill: even-odd interior, auto-closed list, trailing optional colour. Choose fill-poly when you are writing dense drawing code and want the fill call to scan as an action; choose polygon-fill in teaching text where the noun-first name reads more formally. There is one implementation; the name is the only difference."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (fill-poly (list (list 5 5) (list 30 5) (list 20 30)))" :note "The short solid-fill form: same result as polygon-fill on a three-point list.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; Pair the two short names: outline with poly, solid with fill-poly.\n(define diamond (list (list 160 60) (list 200 120) (list 160 180) (list 120 120)))\n(fill-poly diamond 6)\n(poly diamond 'white)" :note "Fill the diamond solid, then trace a white outline over it — the fill-poly/poly pair working together.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A dense loop of solid rotated triangles reads cleanly with the terse name.\n(let ((cx 160) (cy 120))\n  (for-each\n    (lambda (k)\n      (let ((rot (* k 0.5236)))\n        (fill-poly (map (lambda (i)\n                          (let ((a (+ rot (* i 2.094))))\n                            (list (+ cx (* 55 (cos a))) (+ cy (* 55 (sin a))))))\n                        (iota 3))\n                   (+ 1 (modulo k 8)))))\n    (iota 12)))" :note "Twelve solid triangles fanned around a centre; fill-poly keeps the generative body compact.")
  )
  :caveats ("fill-poly and polygon-fill are the same call — no behavioural or performance difference." "All of polygon-fill's caveats hold: even-odd rule, auto-closed list, self-intersection carves holes." "Do not mix fill-poly and polygon-fill haphazardly in one file; pick one per context for readability." "Pairs conceptually with poly (outline); keep the pairing consistent — poly/fill-poly or polygon/polygon-fill, not crossed.")
  :drawbacks ("The verb-first name is terser but slightly less discoverable by a reader scanning for 'polygon'." "Two names for one fill can fragment a codebase search." "Inherits every polygon-fill drawback: flat colour, even-odd only, no hole-list argument.")
  :usecases ("Dense generative code where the fill call recurs many times." "Sketches that pair outline (poly) with solid (fill-poly)." "Live-coding solid shapes where keystrokes matter." "Anywhere polygon-fill applies but brevity is preferred.")
  :related ("polygon-fill" "poly" "triangle-fill" "ngon-fill")
  :learn (:concept "The second aliasing pair (fill-poly = polygon-fill), mirroring poly = polygon, so outline and solid each have a long and a short name." :prerequisites ("polygon-fill" "poly") :progression "Know polygon-fill's even-odd behaviour, adopt fill-poly as its shorthand, and use it alongside poly so outline and solid share a naming style.")
  :row-2-audit (

    (:problem "An artist is layering filled shapes with outlines over them in a fast iteration loop — fill the mass, stroke the edge, repeat. They want the fill and stroke calls to read as a matched pair so the intent (solid-then-outline) is obvious at a glance."
     :program "(set-mode 'sd)\n(define shield (list (list 160 60) (list 210 90) (list 200 170) (list 160 200) (list 120 170) (list 110 90)))\n(fill-poly shield 1)\n(poly shield 'white)"
     :eng-program "(set-mode 'sd)\n(define (filled-outlined verts fill-color edge-color)\n  ;; The matched pair: solid body then crisp edge, named to read as one intent.\n  (fill-poly verts fill-color)\n  (poly verts edge-color))\n(filled-outlined (list (list 160 60) (list 210 90) (list 200 170)\n                       (list 160 200) (list 120 170) (list 110 90)) 1 'white)"
     :math-program "(set-mode 'sd)\n;; The solid is the interior set; the outline is its boundary. Same vertex list, two operations.\n(let ((verts (list (list 120 80) (list 200 80) (list 160 160))))\n  (fill-poly verts 6)\n  (poly verts 'white))"
     :cs-program "(set-mode 'sd)\n;; fill-poly is polygon-fill; substituting one for the other is safe.\n(define (solid verts color) (fill-poly verts color))\n(solid (list (list 120 80) (list 200 80) (list 160 160)) 6)"
     :explanation "eng: bundle the solid-then-outline pair into one intent-named helper. math: distinguish interior (fill-poly) from boundary (poly) over the same vertex list. cs: wrap fill-poly to show it is a transparent stand-in for polygon-fill."
     :meta "polygon-fill is the same operation with a noun-first name — correct but it does not pair as cleanly with the short poly in a body full of both. triangle-fill handles only three corners. ngon-fill draws regular shapes only. fill-poly is the terse verb-first solid that mirrors poly; the siblings are longer, narrower, or a different shape family.")
    (:eng "The audit lens is 'do the fill and stroke names read as a pair?' — the smoke test is that fill-poly and poly over the same vertex list produce a filled shape with a matching outline, no offset between them." :math "fill-poly = polygon-fill as functions; the alias is the identity relabelling on the solid-fill operation." :cs "Name aliasing paired with its outline counterpart; a zero-cost renaming resolved at lookup."))
  :row-3-dimension (
    (:setup "Give the same solid-fill operation a second, action-leading name that pairs with its outline sibling.")
    (:rungs (
       (:domain "fill-poly"   :code "(set-mode 'sd) (fill-poly (list (list 5 5) (list 30 5) (list 20 30)))")
       (:domain "paired-verbs" :code "(define pairs (list (cons 'push 'pop) (cons 'open 'close) (cons 'fill 'stroke)))\n(assq 'fill pairs)")
       (:domain "dual-op"     :code "(define (dual op) (cond ((eq? op 'interior) 'boundary) ((eq? op 'boundary) 'interior) (else 'self)))\n(list (dual 'interior) (dual 'boundary))")))
    (:explanation "Rung 1: fill-poly names the solid-interior operation to pair with poly's outline. Rung 2: interfaces expose matched verb pairs — push/pop, open/close, fill/stroke — so the two halves of an action read together. Rung 3: interior and boundary are dual operations on the same region; naming them as a pair makes the duality visible. All three share the same shape — a matched pair of operations named so that using one signals the other.")
    (:meta "The transfer works because paired naming encodes a duality: fill and stroke are the interior and boundary of one region, like push and pop are the two ends of a stack action. Every well-designed API surfaces such pairs. Grounds in book-of-code ch 10 (state-machines) as the matched-operation-pair shape and in the word-books as the antonym/complement relation.")
    (:eng "Every paired-verb substrate shares 'the pair must stay symmetric' — if poly changed but fill-poly did not, the pairing would mislead." :math "Interior and boundary are complementary operators on a region; ∂(interior) is the outline." :cs "Matched operation pair; the shape of every open/close, acquire/release, and fill/stroke API."))
  :row-4-proof (
    (:claim "fill-poly is observationally equal to polygon-fill: for any vertex list and colour, the solid region painted is identical.")
    (:program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed))) 2))))\n;; Same vertices ⇒ same enclosed area ⇒ same filled region under either name.\n(define vs (list (list 0 0) (list 6 0) (list 6 4) (list 0 4)))\n(display (= (shoelace vs) 24)) (newline)\n(display (eq? 'fill-poly 'fill-poly))"
     :eng-program "(set-mode 'sd)\n;; Fill the same square with each name; identical pixels, both run clean.\n(fill-poly (list (list 60 60) (list 120 60) (list 120 120) (list 60 120)) 6)\n(polygon-fill (list (list 60 60) (list 120 60) (list 120 120) (list 60 120)) 6)"
     :math-program "(set-mode 'sd)\n;; One vertex list, both names — the interior set is the same function of the input.\n(let ((vs (list (list 60 60) (list 120 60) (list 90 120))))\n  (fill-poly vs 6)\n  (polygon-fill vs 6))"
     :cs-program "(set-mode 'sd)\n(define (fill-a vs c) (fill-poly vs c))\n(define (fill-b vs c) (polygon-fill vs c))\n;; Both close over the same fill; substitution changes nothing observable.\n(fill-a (list (list 60 60) (list 120 60) (list 90 120)) 6)\n(fill-b (list (list 60 60) (list 120 60) (list 90 120)) 6)"
     :invariant "∀ points color. fill-poly(points, color) ≡ polygon-fill(points, color)  (the alias is observationally equal to the original solid fill)"
     :meta "The pattern is observational equivalence, the same guarantee poly gives for polygon — two names, one operation, no context can tell them apart. Falsified if any list filled differently under fill-poly than polygon-fill; that would make the alias a divergent verb. book-of-code ch 05 grounds equational substitution; book-of-math ch-advanced-05 grounds the identity morphism the alias instantiates."))
    (:eng "The operator can swap fill-poly for polygon-fill in any code without a visual diff; the filled frame is identical." :math "fill-poly and polygon-fill are one point in function space under two labels; the map between names is the identity." :cs "Observational equivalence; the guarantee a compiler gives when inlining an alias binding.")
  :row-5-emergence (

    (:base "fill-poly paints a solid interior, just like polygon-fill, in fewer keystrokes and paired with poly.")
    (:composition "(set-mode 'sd)\n;; A flag: solid field via fill-poly, a star via a filled vertex list, a poly border.\n(fill-poly (list (list 80 70) (list 240 70) (list 240 170) (list 80 170)) 1)\n(fill-poly (map (lambda (i)\n                  (let ((a (- (* i (/ 3.14159 5)) 1.5708)) (r (if (even? i) 28 11)))\n                    (list (+ 120 (* r (cos a))) (+ 120 (* r (sin a))))))\n                (iota 10)) 'white)\n(poly (list (list 80 70) (list 240 70) (list 240 170) (list 80 170)) 'white)"
     :eng-composition "(set-mode 'sd)\n(define (tile-row y w n color)\n  ;; A run of solid diamonds filled with the terse name.\n  (for-each (lambda (i)\n              (let ((cx (+ 40 (* i w))))\n                (fill-poly (list (list cx y) (list (+ cx (/ w 2)) (+ y (/ w 2)))\n                                 (list cx (+ y w)) (list (- cx (/ w 2)) (+ y (/ w 2))))\n                           (+ 1 (modulo i 6)))))\n            (iota n)))\n(tile-row 100 40 6 0)"
     :math-composition "(set-mode 'sd)\n;; Fill then outline: the boundary is the derivative of the filled region.\n(define (solid+edge verts fill edge)\n  (fill-poly verts fill)\n  (poly verts edge))\n(solid+edge (list (list 120 70) (list 200 70) (list 210 150) (list 160 190) (list 110 150)) 6 'white)"
     :cs-composition "(set-mode 'sd)\n;; A filled crown glyph: concave outline, solid interior via even-odd.\n(fill-poly (list (list 100 160) (list 100 100) (list 130 130) (list 160 90)\n                 (list 190 130) (list 220 100) (list 220 160)) 'yellow)"
     :emergent "A flag with a white star, a row of coloured diamonds, a fill-then-outline shape, and a solid crown: the terse fill name — paired with poly for edges — builds recognisable objects and keeps dense fill-heavy scenes readable.")
    (:meta "This is the fill-and-stroke family — every drawn object is a filled region plus an optional boundary, and a good API names both halves to pair. Familiar analogs are SVG's fill/stroke attributes, Canvas fill()/stroke(), and the interior/boundary duality in topology. The composition works because fill-poly is polygon-fill, so it inherits even-odd generality while reading as an action beside poly.")
    (:eng "The audit lens is 'fill and outline must register exactly' — the SRE check is that fill-poly and poly over the same vertex list align with no sub-pixel offset, since they share the list." :math "The pair (fill-poly, poly) realises (interior, boundary) of one region; the outline is the region's topological frontier." :cs "Fill-then-stroke pipeline; the shape of every renderer that paints a mass and then its edge."))
)

(verb
  :name "star" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(star cx cy rOuter rInner points [rot] [color]) -> undefined"
  :summary "Stroke a star outline of the given point-count by alternating an outer and inner radius around a centre."
  :explanation "star draws the classic pointed-star outline without asking you to compute vertices. You give the centre (cx, cy), the outer radius rOuter (the tips), the inner radius rInner (the valleys between tips), and the number of points; it places 2·points vertices around the circle, alternating outer and inner radius, and strokes the closed outline. An optional rotation (in radians) turns the whole star, and an optional trailing colour sets the pen. The ratio rInner/rOuter controls sharpness: near 1 the star is fat and blunt, near 0 it is thin and spiky. This is the go-to for rating widgets, sheriff badges, sparkles, and any starburst where you want the shape parameterised by geometry rather than hand-placed points. It strokes only — reach for star-fill for a solid star."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (star 160 120 40 18 5 0 'yellow)" :note "A five-pointed star centred on the canvas: outer radius 40, inner 18, no rotation, yellow.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A row of rating stars, small and evenly spaced.\n(for-each\n  (lambda (i)\n    (star (+ 60 (* i 40)) 120 15 6 5 -1.5708 'yellow))\n  (iota 5))" :note "Five small stars in a row, each rotated so a point faces up (−π/2) — a five-star rating strip.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A sparkle burst: nested stars of shrinking size and shifting rotation.\n(for-each\n  (lambda (i)\n    (star 160 120 (- 60 (* i 12)) (- 28 (* i 6)) 5 (* i 0.3) (+ 1 i)))\n  (iota 5))" :note "Five concentric stars, each smaller and slightly turned, build a layered sparkle from one parameterised call.")
  )
  :caveats ("points is the number of tips, not the vertex count; the outline has 2·points vertices." "rInner should be less than rOuter; equal radii give a regular polygon, and rInner > rOuter inverts the star." "rot is optional and precedes color; to set colour without rotation you must still pass a rotation (e.g. 0)." "Outline only — the interior is untouched; use star-fill for a solid star.")
  :drawbacks ("No independent control of individual point angles — all tips are evenly spaced." "One-pixel stroke, no line width or anti-aliasing." "The star is always radially symmetric; irregular or hand-tweaked stars need polygon with a computed vertex list.")
  :usecases ("Rating widgets and score displays." "Sheriff badges, medals, and award icons." "Sparkles, twinkles, and starfield markers." "Burst and highlight effects behind an object.")
  :related ("star-fill" "ngon" "polygon" "ring")
  :learn (:concept "A star polygon as two interleaved regular point sets — outer tips and inner valleys alternating around a circle — parameterised by two radii and a point count." :prerequisites ("polygon" "ngon") :progression "Generate a star with star, fill it solid with star-fill, and compare with ngon which uses a single radius for a regular polygon.")
  :row-2-audit (

    (:problem "A UI author needs a five-star rating strip where each star sits at a fixed slot, is the same size, and points straight up. Hand-computing ten alternating vertices per star, times five stars, is exactly the kind of arithmetic that produces one lopsided star nobody notices until ship."
     :program "(set-mode 'sd)\n(for-each\n  (lambda (i) (star (+ 60 (* i 36)) 120 15 6 5 -1.5708 'yellow))\n  (iota 5))"
     :eng-program "(set-mode 'sd)\n(define (rating-strip x0 y count filled-color)\n  ;; One call per slot; size and rotation are shared so the strip is uniform.\n  (for-each (lambda (i) (star (+ x0 (* i 36)) y 15 6 5 -1.5708 filled-color))\n            (iota count)))\n(rating-strip 60 120 5 'yellow)"
     :math-program "(set-mode 'sd)\n;; Each star's tips lie on a circle of radius rOuter at angles rot + 2πk/points.\n(define (one-star cx) (star cx 120 15 6 5 -1.5708 'yellow))\n(for-each one-star (list 60 96 132 168 204))"
     :cs-program "(set-mode 'sd)\n(define (star-guard cx cy ro ri pts)\n  (if (and (> ro ri) (>= pts 2))\n      (star cx cy ro ri pts 0 'yellow)\n      (error 'bad-star-params)))\n(star-guard 160 120 40 18 5)"
     :explanation "eng: fold the slot index into a uniform per-star call. math: state that tips sit on a circle at evenly spaced angles. cs: guard rOuter > rInner and points ≥ 2 before drawing."
     :meta "polygon would force the author to compute ten alternating-radius vertices per star by hand — the very arithmetic star exists to hide. ngon uses one radius, so it draws a pentagon, not a star. star-fill would paint solid stars when only outlines are wanted here. star is the parameterised outline-star primitive; the siblings either demand manual vertices, drop the inner radius, or fill.")
    (:eng "The audit lens is 'are all stars identical and aligned?' — the smoke test is that changing rOuter in one place resizes every star uniformly, which only holds if each is one parameterised call, not hand-placed points." :math "A star's 2·points vertices are at radius rOuter (even indices) and rInner (odd indices), angle rot + kπ/points." :cs "Parameterised vertex generator plus outline stroke; O(points) vertices, one closed polyline."))
  :row-3-dimension (
    (:setup "Alternate between two levels at evenly spaced steps around a cycle.")
    (:rungs (
       (:domain "star"      :code "(set-mode 'sd) (star 160 120 40 18 5 0 'yellow)")
       (:domain "gear-teeth" :code "(define (tooth-heights n hi lo) (map (lambda (i) (if (even? i) hi lo)) (iota (* 2 n))))\n(tooth-heights 5 10 4)")
       (:domain "square-wave" :code "(define (square-wave n hi lo) (map (lambda (i) (if (even? i) hi lo)) (iota n)))\n(square-wave 8 1 -1)")))
    (:explanation "Rung 1: a star alternates outer tips and inner valleys at even angular steps. Rung 2: a gear's rim alternates tall teeth and short gaps at even steps around its circumference. Rung 3: a square wave alternates high and low at even time steps. All three share the same shape — a two-level signal sampled at regular intervals, the values toggling between a high and a low.")
    (:meta "The transfer works because a star is a two-level periodic signal wrapped onto a circle: the radius is a square-ish wave of the angle. Every alternating-level pattern — gear teeth, crenellations, a duty-cycled waveform — is the same toggle-on-a-schedule. Grounds in book-of-math ch-advanced-11 (complex-analysis) as the periodic-alternation / Fourier-square-wave shape.")
    (:eng "Every alternating-level substrate shares 'the two levels and the step count are the only knobs' — the operator's check is that tips and valleys stay evenly interleaved." :math "The radius as a function of index is a period-2 alternation; a star is that alternation sampled at 2·points angles." :cs "Two-value toggle over an index range; the shape of every square wave and every alternating pattern."))
  :row-4-proof (
    (:claim "A star with p points has p-fold rotational symmetry: rotating it by 2π/p maps every tip onto the next tip and leaves the shape unchanged.")
    (:program "(define pi 3.14159265)\n(define (tips cx cy r p rot)\n  (map (lambda (k) (let ((a (+ rot (* k (/ (* 2 pi) p)))))\n                     (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n       (iota p)))\n(define base (tips 0 0 40 5 0))\n(define turned (tips 0 0 40 5 (/ (* 2 pi) 5)))\n;; Rotating by one step reproduces the tip set (as a rotation of the list).\n(define (close? a b) (< (+ (abs (- (car a) (car b))) (abs (- (cadr a) (cadr b)))) 0.001))\n(display (close? (car turned) (cadr base)))"
     :eng-program "(set-mode 'sd)\n;; A star and the same star rotated by a full 2π/5 look identical; both run clean.\n(star 100 120 40 18 5 0 'yellow)\n(star 220 120 40 18 5 1.2566 'yellow)"
     :math-program "(define pi 3.14159265)\n(define (angle-set p rot)\n  (map (lambda (k) (modulo (round (* 1000 (+ rot (* k (/ (* 2 pi) p))))) (round (* 1000 2 pi))))\n       (iota p)))\n;; The tip angle multiset is invariant under adding one 2π/p step (mod 2π).\n(define a (angle-set 5 0))\n(define b (angle-set 5 (/ (* 2 pi) 5)))\n(display (equal? (sort a <) (sort b <)))"
     :cs-program "(define pi 3.14159265)\n(define (n-fold-symmetric? p)\n  ;; Rotating by 2π/p is a symmetry: p equal steps tile the full turn.\n  (< (abs (- (* p (/ (* 2 pi) p)) (* 2 pi))) 0.0001))\n(and (n-fold-symmetric? 5) (n-fold-symmetric? 6) (n-fold-symmetric? 8))"
     :invariant "∀ p ≥ 2. rotate(star_p, 2π/p) = star_p  (a p-pointed star is invariant under rotation by one point-step)"
     :meta "The pattern is the cyclic symmetry group Cₚ acting on the star — rotation by 2π/p is a generator that permutes the tips cyclically and fixes the shape. Falsified if rotating a p-star by 2π/p produced a visibly different figure; that would mean the tips are not evenly spaced. book-of-math ch-advanced-04 (groups-symmetry) grounds the cyclic group Cₚ; book-of-code ch 10 grounds the modular index arithmetic that realises the rotation."))
    (:eng "The operator can rotate a star by any multiple of 2π/p and get a pixel-identical figure, which is why rating stars can be aligned by a single shared rotation." :math "The star's symmetry group is the cyclic group Cₚ generated by rotation through 2π/p." :cs "Cyclic symmetry under modular rotation; the same shape as a circular buffer invariant under rotation by one slot.")
  :row-5-emergence (

    (:base "star strokes one pointed-star outline from a centre and two radii.")
    (:composition "(set-mode 'sd)\n;; A night sky: a scatter of small stars over a filled dark field.\n(polygon-fill (list (list 0 0) (list 320 0) (list 320 130) (list 0 130)) 0)\n(for-each (lambda (p) (star (car p) (cadr p) 6 2 5 0 'white))\n          (list (list 40 30) (list 90 60) (list 150 25) (list 210 70) (list 270 40) (list 300 90)))"
     :eng-composition "(set-mode 'sd)\n(define (starfield seeds size color)\n  (for-each (lambda (s) (star (car s) (cadr s) size (/ size 2.5) 5 0 color)) seeds))\n(starfield (list (list 50 50) (list 120 90) (list 200 40) (list 260 110) (list 300 70)) 7 'white)"
     :math-composition "(set-mode 'sd)\n;; A sparkle mandala: stars rotated around a shared centre at even angular offsets.\n(let ((cx 160) (cy 120))\n  (for-each (lambda (k)\n              (let ((a (* k 0.7854)))\n                (star (+ cx (* 50 (cos a))) (+ cy (* 50 (sin a))) 10 4 5 a (+ 1 (modulo k 8)))))\n            (iota 8)))"
     :cs-composition "(set-mode 'sd)\n;; A medal: a ring rim, a solid disc, and a star emblem centred in it.\n(ring 160 110 40 33 6)\n(ellipse-fill 160 110 33 33 6)\n(star 160 110 24 10 5 -1.5708 'white)\n(polygon-fill (list (list 150 145) (list 170 145) (list 175 185) (list 160 175) (list 145 185)) 1)"
     :emergent "A starry night, a scattered starfield, a rotated sparkle mandala, and a medal: the same parameterised star, scattered, rotated, or centred inside a ring and disc, composes into recognisable scenes and emblems.")
    (:meta "This is the radial-motif family — a symmetric star used as a repeated element in a field or a mandala. Familiar analogs are particle sparkle systems, starfield backgrounds in games, and radial ornament in design. The composition works because star is a self-contained parameterised element, so scattering, rotating, or nesting it needs only new centres, angles, or sizes.")
    (:eng "The audit lens is 'the field is data-driven' — an SRE probe checks the seed list length and coordinate ranges, since a starfield is only as correct as its seed positions." :math "A field of stars is a set of Cₚ-symmetric motifs placed at seed points; a mandala adds an outer Cₙ symmetry over the placements." :cs "Motif-instancing; the shape of every particle system and every tiled ornament that repeats one parameterised element."))
)

(verb
  :name "star-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(star-fill cx cy rOuter rInner points [rot] [color]) -> undefined"
  :summary "Paint a solid star of the given point-count, filling the interior spanned by the alternating radii."
  :explanation "star-fill is the solid counterpart to star: same centre, two radii, point count, optional rotation and colour — but it floods the star's interior instead of tracing its edge. Internally it builds the same 2·points alternating-radius vertex list and fills it with the even-odd rule, so the pointed body reads as one coloured mass. Reach for it when the star is the object, not an outline: a gold badge, a filled sheriff's star, a burst behind a headline, a solid rating pip. The rInner/rOuter ratio still governs sharpness, and rotation still turns the whole figure. Because the fill is even-odd on a simple star polygon, the whole star colours solid with no interior hole. Combine star-fill for the body with star for a contrasting rim to get an outlined solid star."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (star-fill 160 120 40 18 5 0.3 12)" :note "A solid five-pointed star, slightly rotated, filled in palette colour 12.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A gold badge: a solid star inside a ring rim.\n(ring 160 120 55 48 6)\n(star-fill 160 120 40 16 5 -1.5708 'yellow)" :note "A ring rim with a solid yellow star centred inside — a badge from two primitives.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A layered compass rose: a broad four-point star crossed with a narrower one.\n(star-fill 160 120 70 14 4 -1.5708 6)\n(star-fill 160 120 48 10 4 0 8)\n(ellipse-fill 160 120 8 8 'white)" :note "Two four-pointed solid stars at right angles plus a hub dot make a compass rose.")
  )
  :caveats ("points is the tip count; the filled outline has 2·points vertices." "Fill covers whatever was underneath — draw a solid star before its rim, or the rim under a bigger star will be hidden." "rot is optional and precedes color; pass 0 to set colour without rotating." "A star with rInner very close to rOuter fills almost a disc; very small rInner fills a thin spiky mass.")
  :drawbacks ("Flat single colour — no gradient or shading to suggest a raised badge." "Even-odd fill only; a self-intersecting star vertex list would carve unexpected holes." "No per-point control; all tips are uniform, so irregular stars need polygon-fill with computed vertices.")
  :usecases ("Solid badges, medals, and award stars." "Filled rating pips and score markers." "Bursts and highlights behind text or objects." "Compass-rose and emblem centres.")
  :related ("star" "polygon-fill" "ngon-fill" "ellipse-fill")
  :learn (:concept "Filling a star polygon — the alternating-radius vertex list of star, flooded solid by the even-odd rule." :prerequisites ("star" "polygon-fill") :progression "Trace a star outline with star, fill it solid with star-fill, then combine both for a solid star with a contrasting rim.")
  :row-2-audit (

    (:problem "A game needs a pickup that reads instantly as a solid gold star, even at small size and over a busy background. An outline star gets lost against clutter; the artist wants the star as a filled mass with a thin dark rim so it pops."
     :program "(set-mode 'sd)\n(star-fill 160 120 30 12 5 -1.5708 'yellow)\n(star 160 120 30 12 5 -1.5708 0)"
     :eng-program "(set-mode 'sd)\n(define (pickup cx cy size body rim)\n  ;; Solid body first, then a rim in a contrasting colour so it reads over clutter.\n  (star-fill cx cy size (* size 0.4) 5 -1.5708 body)\n  (star cx cy size (* size 0.4) 5 -1.5708 rim))\n(pickup 160 120 30 'yellow 0)"
     :math-program "(set-mode 'sd)\n;; The filled region is the interior of the alternating-radius polygon; the rim is its boundary.\n(let ((cx 160) (cy 120) (ro 30) (ri 12))\n  (star-fill cx cy ro ri 5 -1.5708 'yellow)\n  (star cx cy ro ri 5 -1.5708 0))"
     :cs-program "(set-mode 'sd)\n(define (safe-pickup cx cy size body)\n  (if (> size 4)\n      (star-fill cx cy size (* size 0.4) 5 -1.5708 body)\n      (ellipse-fill cx cy size size body)))  ; too small to read as a star — fall back to a dot\n(safe-pickup 160 120 30 'yellow)"
     :explanation "eng: paint solid body then contrasting rim so the pickup reads over clutter. math: name the fill as interior and the rim as boundary of one polygon. cs: fall back to a dot below the size where a star stops reading."
     :meta "star only outlines, so it vanishes against a busy background. polygon-fill would fill a star but demands the ten alternating vertices be computed by hand. ngon-fill fills a regular polygon, not a star. star-fill is the solid-star primitive; the siblings under-fill, over-specify, or draw the wrong shape.")
    (:eng "The audit lens is 'does the star read as a solid mass at target size?' — the smoke test is filling the body and confirming it survives being shrunk and placed over clutter, which an outline does not." :math "The filled star is the even-odd interior of the 2·points-vertex alternating-radius polygon." :cs "Interior fill of a computed star polygon; O(area) pixels via scanline crossing."))
  :row-3-dimension (
    (:setup "Flood the region bounded by a two-level alternating outline with a single value.")
    (:rungs (
       (:domain "star-fill"  :code "(set-mode 'sd) (star-fill 160 120 40 18 5 0 'yellow)")
       (:domain "territory"  :code "(define (claim-region cells owner) (map (lambda (c) (cons c owner)) cells))\n(claim-region (list 'a 'b 'c) 'blue)")
       (:domain "indicator"  :code "(define (indicator inside? value) (if inside? value 0))\n(map (lambda (p) (indicator p 1)) (list #t #f #t #t))")))
    (:explanation "Rung 1: the region inside a star's alternating outline is flooded with one colour. Rung 2: a set of map cells enclosed by a border is all claimed for one owner. Rung 3: an indicator function assigns a single value to every point inside a region and zero outside. All three share the same shape — a bounded region is assigned one uniform value across its whole interior.")
    (:meta "The transfer works because filling is applying a constant function over a region's interior — the star's colour is the value of an indicator supported on the star. Every region-labelling, territory-claim, and characteristic-function-times-value is the same fill-the-inside-with-a-constant shape. Grounds in book-of-math ch-advanced-13 (topology) as the support-of-an-indicator shape.")
    (:eng "Every region-fill substrate shares 'the boundary decides membership, the interior gets the value' — the operator's check is that no interior pixel is left unassigned." :math "A solid fill is c·1_S: the constant c times the indicator of the interior set S." :cs "Constant-over-a-region assignment; the shape of every flood-fill and every region-label pass."))
  :row-4-proof (
    (:claim "A solid star's area grows linearly with the product of its two radii: doubling either rOuter or rInner (with the other and the point count fixed) scales the area proportionally.")
    (:program "(define pi 3.14159265)\n(define (star-area ro ri p) (* p ro ri (sin (/ pi p))))\n(define base (star-area 40 20 5))\n(display (< (abs (- (star-area 80 20 5) (* 2 base))) 0.0001)) (newline)\n(display (< (abs (- (star-area 40 40 5) (* 2 base))) 0.0001))"
     :eng-program "(set-mode 'sd)\n;; A star and one with double the outer radius — the bigger covers proportionally more; both run.\n(star-fill 90 120 20 10 5 0 'yellow)\n(star-fill 220 120 40 10 5 0 'yellow)"
     :math-program "(define pi 3.14159265)\n(define (star-area ro ri p) (* p ro ri (sin (/ pi p))))\n(define (bilinear? k)\n  (and (< (abs (- (star-area (* k 40) 20 5) (* k (star-area 40 20 5)))) 0.0001)\n       (< (abs (- (star-area 40 (* k 20) 5) (* k (star-area 40 20 5)))) 0.0001)))\n(and (bilinear? 2) (bilinear? 3))"
     :cs-program "(define pi 3.14159265)\n(define (star-area ro ri p) (* p ro ri (sin (/ pi p))))\n(define (linear-in-ro? k)\n  (= (star-area (* k 40) 20 5) (* k (star-area 40 20 5))))\n(linear-in-ro? 4)"
     :invariant "∀ k > 0. area(k·rOuter, rInner, p) = k·area(rOuter, rInner, p) ∧ area(rOuter, k·rInner, p) = k·area(rOuter, rInner, p)  (star area is bilinear in the two radii)"
     :meta "The pattern is bilinearity — the star's area is p·rOuter·rInner·sin(π/p), linear in each radius separately (unlike a disc, whose area is quadratic in its single radius). Falsified if doubling one radius did not double the area; that would contradict the triangle-decomposition of the star into 2p triangles each with area ½·rOuter·rInner·sin(π/p). book-of-math ch-advanced-06 (calculus-integration) grounds the triangle-sum area; book-of-code ch 11 grounds the multiply-accumulate."))
    (:eng "The operator can size a badge's coverage by adjusting either radius and predict the fill cost linearly, which makes a size slider behave intuitively." :math "The star decomposes into 2p triangles of area ½·rOuter·rInner·sin(π/p); the total is bilinear in (rOuter, rInner)." :cs "Bilinear scaling; the same shape as a rectangle's area being linear in each side separately.")
  :row-5-emergence (

    (:base "star-fill paints one solid pointed star from a centre and two radii.")
    (:composition "(set-mode 'sd)\n;; A sheriff's badge: a solid star with a lighter inset star, on a ring.\n(ring 160 120 58 50 8)\n(star-fill 160 120 50 20 6 0 6)\n(star-fill 160 120 42 17 6 0 3)"
     :eng-composition "(set-mode 'sd)\n(define (award cx cy size)\n  ;; Body, inset highlight, and a hub — a reusable medal emblem.\n  (star-fill cx cy size (* size 0.4) 5 -1.5708 'yellow)\n  (star-fill cx cy (* size 0.8) (* size 0.32) 5 -1.5708 6)\n  (ellipse-fill cx cy (* size 0.18) (* size 0.18) 'white))\n(award 160 120 45)"
     :math-composition "(set-mode 'sd)\n;; A burst: a many-pointed thin star radiating behind a disc, like sun rays.\n(star-fill 160 120 70 8 16 0 'yellow)\n(ellipse-fill 160 120 26 26 6)"
     :cs-composition "(set-mode 'sd)\n;; A row of solid rating pips filled with a fold over slots.\n(let loop ((i 0))\n  (when (< i 5)\n    (star-fill (+ 60 (* i 40)) 120 15 6 5 -1.5708 'yellow)\n    (loop (+ i 1))))"
     :emergent "A sheriff's badge, a reusable award emblem, a sunburst, and a rating strip: the same solid star, inset, radiated, or repeated, composes into recognisable emblems and UI widgets.")
    (:meta "This is the emblem / burst family — a filled star as the core of a badge, medal, or radiant burst. Familiar analogs are heraldic charges, award ribbons, and starburst callouts in design. The composition works because star-fill is a solid self-contained motif, so nesting smaller stars, radiating thin ones, or repeating them across slots all reuse the one fill.")
    (:eng "The audit lens is 'layer order is the whole design' — an SRE probe confirms the biggest star is drawn first and highlights after, since a later fill hides an earlier one." :math "An emblem is a stack of concentric star indicators c₁·1_{S₁} over c₂·1_{S₂} …, painted back-to-front." :cs "Layered motif compositing; the shape of every badge builder that stacks filled shapes by z-order."))
)

(verb
  :name "ellipse" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ellipse cx cy rx ry [color]) -> undefined"
  :summary "Stroke an axis-aligned ellipse outline centred at (cx,cy) with horizontal radius rx and vertical radius ry."
  :explanation "ellipse traces the oval curve whose points satisfy (x−cx)²/rx² + (y−cy)²/ry² = 1. The two radii are independent: rx stretches it horizontally, ry vertically. When rx equals ry you get a circle, so ellipse doubles as your circle-outline primitive. It is the smooth-curve workhorse of the library — orbits, eyes, wheels, dials, cross-sections, and any rounded boundary. Because it is a single closed convex curve, it is the natural outline for anything organic or mechanical that is not straight-edged. It strokes only; use ellipse-fill for a solid disc or oval. The optional trailing colour defaults to the current pen. Under the hood the curve is a parametric sweep of (cx + rx·cos θ, cy + ry·sin θ) as θ runs a full turn, rasterised to pixels."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ellipse 160 120 60 30 'cyan)" :note "A wide, short ellipse outline in cyan — twice as wide as it is tall.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A simple orbit diagram: a big ellipse path with a sun and a planet on it.\n(ellipse 160 120 90 40 8)\n(ellipse-fill 160 120 9 9 'yellow)\n(ellipse-fill 250 120 5 5 6)" :note "An elliptical orbit outline with a filled sun at the centre and a small planet at one edge.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; Concentric ellipses of the same shape ratio — a ripple or contour set.\n(for-each\n  (lambda (i)\n    (ellipse 160 120 (* 12 (+ i 1)) (* 6 (+ i 1)) (+ 1 i)))\n  (iota 6))" :note "Six nested ellipses sharing a 2:1 ratio radiate outward — a contour map or a pond ripple.")
  )
  :caveats ("The ellipse is axis-aligned; there is no rotation argument, so tilted ellipses need a rotated coordinate system or a polygon approximation." "rx = ry draws a circle; the verb has no separate circle form." "Outline only — the interior is untouched; use ellipse-fill for a solid." "Very small radii degenerate toward a point or a short line; very large ones are clipped to the canvas.")
  :drawbacks ("No tilt: only horizontal/vertical major axes are expressible directly." "One-pixel stroke with no width or anti-aliasing; shallow parts of the curve show raster stepping." "No arc-length control; you cannot draw a partial ellipse with this verb (use arc for a circular partial sweep).")
  :usecases ("Orbits, wheels, and dials." "Eyes, faces, and rounded organic outlines." "Cross-sections and contour rings." "Circle outlines by setting rx = ry.")
  :related ("ellipse-fill" "arc" "ngon" "ring")
  :learn (:concept "The ellipse as a parametric curve (cx + rx·cos θ, cy + ry·sin θ) and the implicit level set of a quadratic form — the general axis-aligned oval, with the circle as the rx = ry case." :prerequisites ("arc") :progression "Draw an ellipse outline, fill it with ellipse-fill, and reach for arc when you need only part of a circular sweep.")
  :row-2-audit (

    (:problem "A dashboard author is drawing a circular gauge face and a few concentric guide rings. The rings must be perfect circles sharing a centre; typing a polygon approximation for each would give visibly faceted 'circles' at this size."
     :program "(set-mode 'sd)\n(ellipse 160 120 60 60 'white)\n(ellipse 160 120 45 45 8)\n(ellipse 160 120 30 30 8)"
     :eng-program "(set-mode 'sd)\n(define (guide-rings cx cy radii color)\n  ;; rx = ry gives true circles; one call per ring keeps the centre shared.\n  (for-each (lambda (r) (ellipse cx cy r r color)) radii))\n(ellipse 160 120 60 60 'white)\n(guide-rings 160 120 (list 45 30 15) 8)"
     :math-program "(set-mode 'sd)\n;; A circle is the ellipse with rx = ry: the level set x²+y² = r².\n(for-each (lambda (r) (ellipse 160 120 r r 8)) (list 60 45 30))"
     :cs-program "(set-mode 'sd)\n(define (ring-guard cx cy r color)\n  (if (> r 0) (ellipse cx cy r r color) (error 'nonpositive-radius)))\n(ring-guard 160 120 60 'white)"
     :explanation "eng: fold a radius list into concentric true circles sharing a centre. math: state the circle as the rx = ry ellipse (level set of x²+y²). cs: guard the radius positive before drawing."
     :meta "polygon would approximate the circle with visible facets unless you use very many vertices — wasteful and still not exact. ngon is explicitly a faceted regular polygon, not a smooth curve. arc draws only a partial circular sweep, not a full closed ring. ellipse is the smooth-closed-curve primitive; the siblings facet, partial-sweep, or over-vertex.")
    (:eng "The audit lens is 'is the curve smooth at this size?' — the smoke test is that a gauge circle shows no flat facets, which the rasterised ellipse guarantees and a low-vertex polygon does not." :math "The ellipse is {(cx+rx·cos θ, cy+ry·sin θ) : θ ∈ [0,2π)}, a smooth closed C∞ curve; the circle is the rx = ry case." :cs "Midpoint/parametric ellipse rasteriser; O(perimeter) pixels, no vertex list to build."))
  :row-3-dimension (
    (:setup "Trace the set of points at a fixed scaled distance from a centre.")
    (:rungs (
       (:domain "ellipse"   :code "(set-mode 'sd) (ellipse 160 120 60 30 'cyan)")
       (:domain "orbit"     :code "(define (orbit-point a b t) (list (* a (cos t)) (* b (sin t))))\n(map (lambda (t) (orbit-point 90 40 t)) (list 0 1.57 3.14 4.71))")
       (:domain "level-set" :code "(define (on-ellipse? x y rx ry) (< (abs (- (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry))) 1)) 0.001))\n(list (on-ellipse? 6 0 6 3) (on-ellipse? 0 3 6 3))")))
    (:explanation "Rung 1: an ellipse outline is the set of screen points at scaled unit distance from the centre. Rung 2: an orbiting body traces an ellipse over time as (a·cos t, b·sin t). Rung 3: the ellipse is the level set where the quadratic form x²/rx² + y²/ry² equals one. All three share the same shape — a closed curve defined as the constant-value contour of a scaled distance function.")
    (:meta "The transfer works because an ellipse is a level set of a quadratic form: the same object whether you sweep it parametrically over time or test it implicitly. Every orbit, every iso-contour, and every 'points at fixed scaled distance' is this level-set shape. Grounds in book-of-math ch-advanced-14 (differential-geometry) as the level-set / conic-section shape.")
    (:eng "Every level-set substrate shares 'the contour value is the one knob' — the operator's check is that scaling both radii together moves along a family of similar contours." :math "The ellipse is the 1-level set of Q(x,y) = x²/rx² + y²/ry²; parametrically it is an affine image of the unit circle." :cs "Parametric sweep or implicit contour test; the shape of every conic renderer and iso-line extractor."))
  :row-4-proof (
    (:claim "The parametric and implicit forms of an ellipse agree: every point (rx·cos θ, ry·sin θ) satisfies x²/rx² + y²/ry² = 1.")
    (:program "(define (check-point rx ry theta)\n  (let* ((x (* rx (cos theta)))\n         (y (* ry (sin theta)))\n         (q (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry)))))\n    (< (abs (- q 1)) 0.0001)))\n(display (check-point 6 3 0)) (newline)\n(display (check-point 6 3 1.5708)) (newline)\n(display (check-point 6 3 0.7854)) (newline)\n(display (check-point 6 3 2.5))"
     :eng-program "(set-mode 'sd)\n;; The stroked ellipse and a filled dot placed by the parametric formula land on the same curve.\n(ellipse 160 120 60 30 'cyan)\n(ellipse-fill (+ 160 (* 60 (cos 0.7854))) (+ 120 (* 30 (sin 0.7854))) 3 3 'red)"
     :math-program "(define (identity-holds? rx ry thetas)\n  (fold (lambda (theta acc)\n          (and acc\n               (let ((x (* rx (cos theta))) (y (* ry (sin theta))))\n                 (< (abs (- (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry))) 1)) 0.0001))))\n        #t thetas))\n(identity-holds? 6 3 (list 0 0.5 1 1.5 2 2.5 3 3.5))"
     :cs-program "(define (param-implicit-agree? rx ry n)\n  (let loop ((i 0))\n    (if (>= i n) #t\n        (let* ((theta (* i (/ 6.2832 n)))\n               (x (* rx (cos theta))) (y (* ry (sin theta)))\n               (q (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry)))))\n          (if (< (abs (- q 1)) 0.0001) (loop (+ i 1)) #f)))))\n(param-implicit-agree? 6 3 32)"
     :invariant "∀ θ. (rx·cos θ)²/rx² + (ry·sin θ)²/ry² = cos²θ + sin²θ = 1  (the parametric form lies exactly on the implicit ellipse)"
     :meta "The pattern is the equivalence of two representations of one curve — the parametric sweep and the implicit equation describe the same point set, reconciled by the Pythagorean identity cos²+sin²=1. Falsified if a parametric point ever missed the implicit curve; that would break the identity and mean the two forms describe different shapes. book-of-math ch-advanced-14 grounds the conic's dual descriptions; book-of-code ch 05 grounds the two-specs-of-one-thing agreement check."))
    (:eng "The operator can place markers on the ellipse with the parametric formula and trust they land on the stroked outline, because both obey the same identity." :math "The parametrisation θ ↦ (rx cos θ, ry sin θ) is a bijection onto the implicit curve; substitution reduces to cos²+sin²=1." :cs "Two-representation agreement; the same shape as a parser and a pretty-printer round-tripping one AST.")
  :row-5-emergence (

    (:base "ellipse strokes one axis-aligned oval or circle outline.")
    (:composition "(set-mode 'sd)\n;; A bicycle: two wheel circles, an ellipse frame hint, and hub dots.\n(ellipse 110 160 25 25 8)\n(ellipse 210 160 25 25 8)\n(ellipse 160 150 55 20 6)\n(ellipse-fill 110 160 4 4 0)\n(ellipse-fill 210 160 4 4 0)"
     :eng-composition "(set-mode 'sd)\n(define (target cx cy rings)\n  ;; Concentric circles alternating colour — a dartboard/target.\n  (for-each (lambda (i)\n              (ellipse cx cy (- (* 12 rings) (* 12 i)) (- (* 12 rings) (* 12 i))\n                       (if (even? i) 4 'white)))\n            (iota rings)))\n(target 160 120 5)"
     :math-composition "(set-mode 'sd)\n;; A Lissajous-ish ring set: ellipses of varying aspect share a centre.\n(for-each (lambda (i)\n            (ellipse 160 120 (+ 20 (* i 8)) (- 60 (* i 8)) (+ 1 i)))\n          (iota 6))"
     :cs-composition "(set-mode 'sd)\n;; An owl: a body ellipse, two big eye circles, filled pupils, and a triangle beak.\n(ellipse-fill 160 130 45 55 8)\n(ellipse-fill 145 110 16 16 'white)\n(ellipse-fill 175 110 16 16 'white)\n(ellipse-fill 145 110 5 5 0)\n(ellipse-fill 175 110 5 5 0)\n(triangle-fill 155 118 165 118 160 128 3)"
     :emergent "A bicycle, a target, a nested ring set, and an owl: the same oval outline — circles, wide ellipses, or concentric rings — composes wheels, dartboards, contour patterns, and a face.")
    (:meta "This is the rounded-form family — build organic and mechanical objects from ovals and circles rather than straight edges. Familiar analogs are the circle-and-line vocabulary of technical drawing, blob shapes in cartooning, and iso-contour maps. The composition works because an ellipse is a self-contained smooth closed curve, so wheels, eyes, and rings all instance the one primitive at different radii and aspect ratios.")
    (:eng "The audit lens is 'aspect ratio carries the meaning' — an SRE probe notes that swapping rx and ry rotates the visual emphasis, so the ratio is a load-bearing parameter, not decoration." :math "A scene of ellipses is a set of affine images of the unit circle, each an ellipse with its own centre and radii." :cs "Instancing a smooth primitive; the shape of every drawing built from circles and ovals at varied scale."))
)

(verb
  :name "ellipse-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ellipse-fill cx cy rx ry [color]) -> undefined"
  :summary "Paint a solid axis-aligned ellipse (or circle when rx = ry) centred at (cx,cy)."
  :explanation "ellipse-fill floods the interior of the oval x²/rx² + y²/ry² ≤ 1 with a solid colour. It is the disc primitive: set rx = ry and you get a filled circle, the single most-used solid shape in games and diagrams — balls, planets, dots, buttons, heads, wheels, bubbles. With rx ≠ ry it fills an oval for eggs, shadows, and squashed bodies. Where ellipse gives the outline, ellipse-fill gives the mass, computed as a scanline fill: for each row the horizontal extent is 2·rx·√(1 − (dy/ry)²), and that span is coloured. The optional trailing colour defaults to the current pen. This is the workhorse behind almost every round solid on the canvas; stacking a few filled circles builds snowmen, clouds, molecules, and bubbles instantly."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ellipse-fill 160 120 60 30 6)" :note "A solid wide oval filled in palette colour 6.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A snowman: three stacked filled circles of shrinking radius.\n(ellipse-fill 160 180 35 35 7)\n(ellipse-fill 160 130 25 25 7)\n(ellipse-fill 160 95 18 18 7)" :note "Three filled circles stacked vertically make a snowman body from one repeated disc.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A cluster of bubbles: filled circles of random-ish sizes at scattered centres.\n(for-each\n  (lambda (spec)\n    (ellipse-fill (car spec) (cadr spec) (caddr spec) (caddr spec) 'cyan))\n  (list (list 100 100 20) (list 140 130 14) (list 180 90 24) (list 220 140 10) (list 160 160 16)))" :note "Five filled circles at scattered centres and sizes make a bubble cluster.")
  )
  :caveats ("Axis-aligned only; rx = ry gives a circle, but a tilted oval is not expressible directly." "Fill covers whatever was underneath — draw back-to-front for correct overlap (a snowman's head after its body)." "Very small radii fill a few pixels or nothing; large radii are clipped to the canvas." "The fill is flat colour — no radial shading to suggest a sphere.")
  :drawbacks ("No tilt and no gradient; a filled ellipse always reads flat and axis-aligned." "Overlapping filled circles overdraw shared pixels on this software rasteriser." "No anti-aliasing; the disc edge is a hard raster step.")
  :usecases ("Balls, planets, dots, and buttons (rx = ry)." "Snowmen, clouds, molecules, and bubble clusters from stacked discs." "Eyes, pupils, and rounded body parts." "Shadows and squashed ovals (rx ≠ ry).")
  :related ("ellipse" "polygon-fill" "star-fill" "ring")
  :learn (:concept "Scanline filling of an ellipse — the solid disc as the row-by-row span set of x²/rx² + y²/ry² ≤ 1, with the filled circle as the rx = ry case." :prerequisites ("ellipse") :progression "Fill a disc with ellipse-fill, outline it with ellipse, and stack several to build compound round objects.")
  :row-2-audit (

    (:problem "A physics demo needs to render a bouncing ball each frame as a solid disc at its current position. An outline circle looks hollow and hard to track in motion; the author wants a filled disc placed by centre and radius, cheaply, every tick."
     :program "(set-mode 'sd)\n(define (ball x y r color) (ellipse-fill x y r r color))\n(ball 160 90 14 6)"
     :eng-program "(set-mode 'sd)\n(define (draw-ball state)\n  ;; state = (x y r color); one filled disc per frame at the current position.\n  (ellipse-fill (car state) (cadr state) (caddr state) (caddr state) (cadddr state)))\n(draw-ball (list 160 90 14 6))"
     :math-program "(set-mode 'sd)\n;; A ball is the disc {(x,y) : (x-cx)²+(y-cy)² ≤ r²}; rx = ry = r.\n(let ((cx 160) (cy 90) (r 14))\n  (ellipse-fill cx cy r r 6))"
     :cs-program "(set-mode 'sd)\n(define (ball-guard x y r color)\n  (if (> r 0) (ellipse-fill x y r r color) (error 'nonpositive-radius)))\n(ball-guard 160 90 14 6)"
     :explanation "eng: unpack a per-frame state tuple into one filled disc. math: name the ball as the disc set with rx = ry = r. cs: guard the radius positive before filling."
     :meta "ellipse gives only the outline, which reads hollow in motion. polygon-fill could fill a many-vertex circle approximation but facets at small size and wastes vertices. star-fill fills the wrong shape. ellipse-fill is the solid-disc primitive; the siblings under-fill, facet, or draw a star.")
    (:eng "The audit lens is 'is the ball a solid readable mass each frame?' — the smoke test is that the disc tracks cleanly in motion, which a filled circle does and a hollow outline does not." :math "The ball is the filled disc, the sub-level set (x-cx)²+(y-cy)² ≤ r²." :cs "Per-frame scanline disc fill; O(r²) pixels, one span per scanned row."))
  :row-3-dimension (
    (:setup "Fill every point within a scaled radius of a centre with one value.")
    (:rungs (
       (:domain "ellipse-fill" :code "(set-mode 'sd) (ellipse-fill 160 120 40 40 6)")
       (:domain "blast-radius" :code "(define (in-blast? dist radius) (<= dist radius))\n(map (lambda (d) (in-blast? d 10)) (list 3 8 10 12 20))")
       (:domain "disc"         :code "(define (in-disc? x y r) (<= (+ (* x x) (* y y)) (* r r)))\n(list (in-disc? 3 4 5) (in-disc? 4 4 5))")))
    (:explanation "Rung 1: every screen point within the scaled radius is filled with the disc's colour. Rung 2: everything within a blast radius of the centre is affected; outside it is spared. Rung 3: the disc is the set of points whose distance to the centre is at most r. All three share the same shape — a solid filled by 'everything within a radius', a sub-level set of a distance function.")
    (:meta "The transfer works because a filled disc is the sub-level set of distance ≤ r: the same object as any 'within range' region. Every blast radius, coverage circle, and neighbourhood ball is this sub-level-set-of-distance shape. Grounds in book-of-math ch-advanced-13 (topology) as the metric-ball shape.")
    (:eng "Every within-radius substrate shares 'the radius is the reach' — the operator's check is that the boundary is exactly the points at distance r, in or out by the ≤ convention." :math "The disc is the closed metric ball B(c, r) = {p : d(p,c) ≤ r}; the ellipse fill scales the metric per axis." :cs "Sub-level-set of a distance function; the shape of every range query and coverage-circle fill."))
  :row-4-proof (
    (:claim "A filled ellipse's area is π·rx·ry: it scales linearly in each radius, so a filled circle's area is π·r² and doubling one radius doubles the area.")
    (:program "(define pi 3.14159265)\n(define (ell-area rx ry) (* pi rx ry))\n(define base (ell-area 8 4))\n(display (< (abs (- (ell-area 16 4) (* 2 base))) 0.0001)) (newline)\n(display (< (abs (- (ell-area 8 8) (* 2 base))) 0.0001)) (newline)\n(display (< (abs (- (ell-area 4 4) (* pi 16))) 0.0001))"
     :eng-program "(set-mode 'sd)\n;; A disc and one with double the radius cover four times the pixels; both fills run clean.\n(ellipse-fill 90 120 15 15 6)\n(ellipse-fill 220 120 30 30 6)"
     :math-program "(define pi 3.14159265)\n(define (ell-area rx ry) (* pi rx ry))\n(define (circle-quadratic? k)\n  ;; A circle's area (rx = ry = r) is quadratic in r: scaling r by k scales area by k².\n  (< (abs (- (ell-area (* k 10) (* k 10)) (* k k (ell-area 10 10)))) 0.0001))\n(and (circle-quadratic? 2) (circle-quadratic? 3))"
     :cs-program "(define pi 3.14159265)\n(define (ell-area rx ry) (* pi rx ry))\n(define (linear-in-rx? k)\n  (< (abs (- (ell-area (* k 8) 4) (* k (ell-area 8 4)))) 0.0001))\n(and (linear-in-rx? 2) (linear-in-rx? 5))"
     :invariant "∀ k > 0. area(k·rx, ry) = k·area(rx, ry)  and  area(k·r, k·r) = k²·area(r, r)  (area is linear in each radius, so a circle's area is quadratic in its single radius)"
     :meta "The pattern is that the ellipse's area π·rx·ry is bilinear in the radii, degenerating to the circle's quadratic π·r² when rx = ry — the disc is an affine image of the unit disc, and area scales by the determinant of the scaling. Falsified if doubling a radius did not double the area; that would contradict area = π·rx·ry. book-of-math ch-advanced-06 (calculus-integration) grounds the ellipse area as an integral; book-of-code ch 11 grounds the multiply that computes it."))
    (:eng "The operator can predict fill cost from the radii — a disc twice as wide costs four times the pixels — so a size control is a quadratic cost knob for circles." :math "Area(ellipse) = π·rx·ry = det(diag(rx,ry))·π; linear per axis, quadratic when the axes scale together." :cs "Bilinear/quadratic area scaling; the same shape as a 2D array whose element count grows with the product of its dimensions.")
  :row-5-emergence (

    (:base "ellipse-fill paints one solid disc or oval.")
    (:composition "(set-mode 'sd)\n;; A snowman with a face: three body discs, two eyes, and an arc smile.\n(ellipse-fill 160 185 34 34 7)\n(ellipse-fill 160 135 24 24 7)\n(ellipse-fill 160 100 17 17 7)\n(ellipse-fill 154 96 3 3 0)\n(ellipse-fill 166 96 3 3 0)\n(arc 160 102 8 0.3 2.8 0)"
     :eng-composition "(set-mode 'sd)\n(define (molecule bonds atoms)\n  ;; bonds = list of (x1 y1 x2 y2) sticks; atoms = list of (x y r color) balls.\n  (for-each (lambda (b) (poly (list (list (car b) (cadr b)) (list (caddr b) (cadddr b))) 8)) bonds)\n  (for-each (lambda (a) (ellipse-fill (car a) (cadr a) (caddr a) (caddr a) (cadddr a))) atoms))\n(molecule (list (list 130 120 190 120))\n          (list (list 130 120 18 'red) (list 190 120 12 'white)))"
     :math-composition "(set-mode 'sd)\n;; Approximate a Gaussian blob by stacking translucent-looking concentric discs.\n(for-each (lambda (i)\n            (ellipse-fill 160 120 (- 60 (* i 10)) (- 60 (* i 10)) (+ 1 (modulo i 8))))\n          (iota 6))"
     :cs-composition "(set-mode 'sd)\n;; A traffic light: a dark case rectangle and three coloured lamp discs.\n(polygon-fill (list (list 145 50) (list 175 50) (list 175 190) (list 145 190)) 0)\n(ellipse-fill 160 75 10 10 'red)\n(ellipse-fill 160 120 10 10 'yellow)\n(ellipse-fill 160 165 10 10 'green)"
     :emergent "A snowman with a face, a molecule, a stacked blob, and a traffic light: the same filled disc — stacked, bonded, nested, or lit — composes a character, a chemistry diagram, a gradient blob, and a machine part.")
    (:meta "This is the disc-assembly family — build compound objects by stacking and placing filled circles. Familiar analogs are metaballs in graphics, ball-and-stick molecular models, and the circle-packing of dot art. The composition works because a filled disc is the atomic round solid, so snowmen, atoms, lamps, and blobs all instance it at different centres and radii.")
    (:eng "The audit lens is 'back-to-front order builds the stack' — an SRE probe confirms larger/background discs are painted before smaller/foreground ones, since a later fill hides an earlier one." :math "A disc assembly is a union of metric balls c_i·1_{B(p_i, r_i)}, composited by paint order." :cs "Disc compositing; the shape of every metaball renderer and every ball-and-stick diagram."))
)

(verb
  :name "ngon" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ngon cx cy r n [rot] [color]) -> undefined"
  :summary "Stroke a regular n-sided polygon outline inscribed in a circle of radius r about (cx,cy)."
  :explanation "ngon draws a regular polygon — n equal sides and n equal angles — with all vertices on a circle of radius r. You give the centre, the circumradius, and the side count n; it places n vertices at evenly spaced angles and strokes the closed outline. An optional rotation (radians) turns it, and an optional trailing colour sets the pen. This is the primitive for equilateral triangles (n=3), squares-as-diamonds (n=4), pentagons, hexagons, and up: as n grows the outline approaches a circle. Where polygon wants an explicit vertex list, ngon computes the regular one for you from a single radius, which is exactly what you want for symmetric tiles, gears, dice faces, and nuts-and-bolts iconography. It strokes only; ngon-fill gives the solid. The regularity — n-fold rotational symmetry — is the whole point of the verb."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ngon 160 120 40 6 0 'white)" :note "A regular hexagon outline, circumradius 40, in white.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A row of regular polygons with increasing side count: triangle to heptagon.\n(for-each\n  (lambda (i)\n    (ngon (+ 50 (* i 45)) 120 20 (+ i 3) -1.5708 (+ 1 i)))\n  (iota 5))" :note "Five regular polygons from 3 to 7 sides in a row — a shape-family strip showing n approaching a circle.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A honeycomb: offset rows of regular hexagons.\n(for-each\n  (lambda (row)\n    (for-each\n      (lambda (col)\n        (let ((x (+ 60 (* col 44) (* (modulo row 2) 22)))\n              (y (+ 60 (* row 38))))\n          (ngon x y 22 6 0 (+ 1 (modulo (+ row col) 8)))))\n      (iota 4)))\n  (iota 3))" :note "Three offset rows of hexagons tile a honeycomb — regular hexagons tessellate the plane.")
  )
  :caveats ("n is the side (and vertex) count; n must be at least 3 for a polygon." "r is the circumradius (centre to vertex), not the apothem (centre to edge midpoint); the drawn shape fits a circle of radius r." "rot is optional and precedes color; pass a rotation (e.g. 0 or −π/2 to point a vertex up) to set colour without leaving rotation defaulted." "Outline only; use ngon-fill for a solid regular polygon.")
  :drawbacks ("Only regular polygons — unequal sides or irregular angles need polygon with a computed vertex list." "One-pixel stroke, no width or anti-aliasing." "The circumradius convention means two n-gons with the same r but different n do not share an edge length; matching tiles requires care.")
  :usecases ("Hexagon and triangle tiles for board games and maps." "Dice faces, nuts, bolts, and mechanical iconography." "Stop-sign octagons and regular sign shapes." "The base outline for gears and rosettes.")
  :related ("ngon-fill" "polygon" "ellipse" "star")
  :learn (:concept "The regular n-gon as n vertices evenly spaced on a circle — n-fold rotational symmetry from a single radius and side count, approaching a circle as n grows." :prerequisites ("polygon" "ellipse") :progression "Draw a regular outline with ngon, fill it with ngon-fill, and note that a star is an ngon with two alternating radii.")
  :row-2-audit (

    (:problem "A board-game author is laying out a hex grid for a strategy map. Every cell must be a regular hexagon of the same size, evenly placed, with offset rows that interlock. Hand-listing six vertices per hex across a whole grid is where one mis-sized cell breaks the tiling."
     :program "(set-mode 'sd)\n(ngon 80 100 24 6 0 8)\n(ngon 124 100 24 6 0 8)\n(ngon 102 138 24 6 0 8)"
     :eng-program "(set-mode 'sd)\n(define (hex-grid cols rows r color)\n  ;; One ngon call per cell; shared r guarantees uniform, interlocking hexes.\n  (for-each (lambda (row)\n              (for-each (lambda (col)\n                          (let ((x (+ 50 (* col (* r 1.8)) (* (modulo row 2) (* r 0.9))))\n                                (y (+ 60 (* row (* r 1.6)))))\n                            (ngon x y r 6 0 color)))\n                        (iota cols)))\n            (iota rows)))\n(hex-grid 4 3 22 8)"
     :math-program "(set-mode 'sd)\n;; A regular hexagon's vertices are at angle 2πk/6; r is the circumradius.\n(define (hex cx cy r) (ngon cx cy r 6 0 8))\n(hex 80 100 24) (hex 124 100 24)"
     :cs-program "(set-mode 'sd)\n(define (hex-guard cx cy r n)\n  (if (>= n 3) (ngon cx cy r n 0 8) (error 'ngon-needs-three-sides)))\n(hex-guard 160 120 40 6)"
     :explanation "eng: fold row/col indices into a uniform hex grid with a shared radius. math: state the vertices as evenly spaced angles on the circumcircle. cs: guard n ≥ 3 before drawing a polygon."
     :meta "polygon would force six computed vertices per hex, times the whole grid — the arithmetic ngon exists to hide. ellipse draws a smooth curve, not a six-sided tile. star adds an inner radius the hexagon does not want. ngon is the regular-polygon primitive; the siblings demand manual vertices, curve instead of facet, or add an unwanted radius.")
    (:eng "The audit lens is 'do all cells share size and spacing?' — the smoke test is that changing r in one place resizes the whole grid uniformly, which holds only when each hex is one radius-parameterised call." :math "A regular n-gon has vertices at (cx+r·cos(rot+2πk/n), cy+r·sin(rot+2πk/n)); regularity is the equal angular spacing." :cs "Regular vertex generator plus outline stroke; O(n) vertices, one closed polyline per tile."))
  :row-3-dimension (
    (:setup "Place n items at equal angular spacing around a circle.")
    (:rungs (
       (:domain "ngon"       :code "(set-mode 'sd) (ngon 160 120 40 6 0 'white)")
       (:domain "clock-face" :code "(define (hour-angles) (map (lambda (h) (* h (/ 6.2832 12))) (iota 12)))\n(length (hour-angles))")
       (:domain "roots-of-unity" :code "(define (nth-roots n) (map (lambda (k) (list (cos (* k (/ 6.2832 n))) (sin (* k (/ 6.2832 n))))) (iota n)))\n(length (nth-roots 6))")))
    (:explanation "Rung 1: a regular hexagon's vertices sit at equal angular steps around its circumcircle. Rung 2: a clock face marks twelve positions at equal angular steps around a circle. Rung 3: the n-th roots of unity are n complex numbers evenly spaced on the unit circle. All three share the same shape — n points placed at angles 2πk/n around a centre, the discrete rotational symmetry of the circle.")
    (:meta "The transfer works because a regular n-gon's vertices ARE the n-th roots of unity (scaled and centred) — the canonical n points with n-fold rotational symmetry. Every clock face, evenly divided dial, and root-of-unity set is this equal-angular-division shape. Grounds in book-of-math ch-advanced-04 (groups-symmetry) as the cyclic-group / roots-of-unity shape.")
    (:eng "Every equal-division substrate shares 'the step is 2π/n' — the operator's check is that the n items close the full turn with no gap or overlap." :math "The vertices are r·e^{i(rot+2πk/n)} + centre; they form the orbit of one point under the cyclic group Cₙ." :cs "Equal angular partition; the shape of every clock, dial, and evenly spaced radial layout."))
  :row-4-proof (
    (:claim "A regular n-gon's interior angle is (n−2)·π/n, so the interior angles sum to (n−2)·π and each grows toward π as n increases.")
    (:program "(define pi 3.14159265)\n(define (interior-angle n) (/ (* (- n 2) pi) n))\n(display (< (abs (- (interior-angle 3) (/ pi 3))) 0.0001)) (newline)\n(display (< (abs (- (interior-angle 4) (/ pi 2))) 0.0001)) (newline)\n(define (angle-sum n) (* (- n 2) pi))\n(display (< (abs (- (angle-sum 6) (* 4 pi))) 0.0001))"
     :eng-program "(set-mode 'sd)\n;; Triangle, square, hexagon — all run; each has the predicted corner sharpness.\n(ngon 80 120 30 3 -1.5708 8)\n(ngon 160 120 30 4 -0.7854 8)\n(ngon 240 120 30 6 0 8)"
     :math-program "(define pi 3.14159265)\n(define (interior-angle n) (/ (* (- n 2) pi) n))\n(define (monotone-increasing? ns)\n  (or (null? (cdr ns))\n      (and (< (interior-angle (car ns)) (interior-angle (cadr ns)))\n           (monotone-increasing? (cdr ns)))))\n(monotone-increasing? (list 3 4 5 6 8 12))"
     :cs-program "(define pi 3.14159265)\n(define (approaches-pi? n)\n  ;; As n grows the interior angle nears π (the polygon nears a circle).\n  (< (- pi (/ (* (- n 2) pi) n)) 0.05))\n(list 'n=12 (approaches-pi? 12) 'n=100 (approaches-pi? 100))"
     :invariant "∀ n ≥ 3. interior-angle(n) = (n−2)·π/n  ∧  Σ interior angles = (n−2)·π  (and interior-angle → π as n → ∞)"
     :meta "The pattern is the angle-sum theorem for polygons — a convex n-gon triangulates into n−2 triangles, each contributing π to the interior-angle sum, giving (n−2)·π total and (n−2)·π/n per corner by regularity. Falsified if a regular n-gon's angles summed to anything but (n−2)·π; that would contradict the triangulation into n−2 triangles. book-of-math ch-advanced-13 (topology) grounds the triangulation count; book-of-code ch 05 grounds the inductive angle-sum proof."))
    (:eng "The operator can predict corner sharpness from n alone — more sides means blunter corners nearing a smooth circle — which is why high-n ngons stand in for circles." :math "Interior angle (n−2)π/n increases monotonically to π; the polygon converges to its circumcircle as n → ∞." :cs "Angle-sum-from-triangulation; the same shape as an inductive invariant proved by decomposing into base cases.")
  :row-5-emergence (

    (:base "ngon strokes one regular n-sided outline from a centre, radius, and side count.")
    (:composition "(set-mode 'sd)\n;; A stop sign: a regular octagon with an inner octagon border.\n(ngon 160 120 55 8 0.3927 'red)\n(ngon 160 120 48 8 0.3927 'white)"
     :eng-composition "(set-mode 'sd)\n(define (shape-strip x0 y r sides)\n  ;; A family strip: triangle up to sides-sided, each pointing up.\n  (for-each (lambda (i) (ngon (+ x0 (* i 45)) y r (+ i 3) -1.5708 (+ 1 i)))\n            (iota sides)))\n(shape-strip 50 120 20 5)"
     :math-composition "(set-mode 'sd)\n;; A rosette: rotated copies of one hexagon around a shared centre.\n(let ((cx 160) (cy 120))\n  (for-each (lambda (k) (ngon cx cy 40 6 (* k 0.1309) (+ 1 (modulo k 8))))\n            (iota 8)))"
     :cs-composition "(set-mode 'sd)\n;; A nut-and-bolt icon: a hex outline with a circle bore.\n(ngon 160 120 40 6 0 8)\n(ellipse 160 120 18 18 8)"
     :emergent "A stop sign, a shape-family strip, a rotated rosette, and a hex nut: the same regular-polygon outline — octagon, ascending n, rotated hexagons, or hex-with-bore — composes signage, a teaching figure, an ornament, and a mechanical icon.")
    (:meta "This is the regular-tiling / symmetry family — regular polygons tile the plane (triangles, squares, hexagons) and stack into rosettes and signage. Familiar analogs are hex maps in strategy games, tessellation art, and the regular-polygon vocabulary of signage standards. The composition works because ngon is a self-contained symmetric element, so tilings, rosettes, and icons all instance it at chosen radii, side counts, and rotations.")
    (:eng "The audit lens is 'only 3, 4, and 6 tile the plane gap-free' — an SRE probe on a tiling checks the side count is a tessellating one, since a regular pentagon leaves gaps." :math "Regular tilings exist only for n ∈ {3,4,6} because the interior angle (n−2)π/n must divide 2π evenly." :cs "Regular-element instancing; the shape of every hex grid, tessellation, and rotationally symmetric ornament."))
)

(verb
  :name "ngon-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ngon-fill cx cy r n [rot] [color]) -> undefined"
  :summary "Paint a solid regular n-sided polygon inscribed in a circle of radius r about (cx,cy)."
  :explanation "ngon-fill is the solid counterpart to ngon: same centre, circumradius, side count, optional rotation and colour, but it floods the regular polygon's interior instead of tracing its edge. It builds the n evenly spaced vertices and fills them (the shape is convex, so the fill is unambiguous). Reach for it whenever a regular polygon is a coloured mass: a solid hexagon tile, a filled stop-sign octagon, a die face, a gear hub, a game token. As n grows it fills a smoother-edged disc, so a high-n ngon-fill is a faceted circle. The optional trailing colour defaults to the current pen. Because regular polygons with n ∈ {3,4,6} tessellate, filled ngons are the natural tiles for a coloured board, map, or mosaic."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ngon-fill 160 120 40 6 0.5 3)" :note "A solid hexagon, slightly rotated, filled in palette colour 3.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A solid octagon stop sign with a white inset — filled, not outlined.\n(ngon-fill 160 120 55 8 0.3927 'red)\n(ngon-fill 160 120 47 8 0.3927 'white)" :note "A red filled octagon with a smaller white one inset gives a stop-sign look.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A coloured hex board: offset rows of filled hexagons.\n(for-each\n  (lambda (row)\n    (for-each\n      (lambda (col)\n        (let ((x (+ 60 (* col 42) (* (modulo row 2) 21)))\n              (y (+ 60 (* row 36))))\n          (ngon-fill x y 20 6 0 (+ 1 (modulo (+ row col) 6)))))\n      (iota 4)))\n  (iota 3))" :note "Offset rows of solid hexagons in cycling colours make a filled honeycomb board.")
  )
  :caveats ("n must be at least 3; r is the circumradius (centre to vertex)." "Fill covers whatever was underneath — draw a larger polygon before a smaller inset one." "rot is optional and precedes color; pass a rotation to set colour without leaving rotation defaulted." "A high-n fill approximates a disc but with visible facets at small n; use ellipse-fill for a true circle.")
  :drawbacks ("Regular convex fills only; irregular or concave solids need polygon-fill." "Flat single colour — no gradient to suggest a bevel or a raised tile." "Overlapping filled tiles overdraw shared pixels; matching edges between different-n tiles needs care.")
  :usecases ("Filled hexagon and triangle tiles for coloured boards and maps." "Solid stop-sign octagons and filled sign shapes." "Die faces, game tokens, and gear hubs." "Faceted disc stand-ins at high n.")
  :related ("ngon" "polygon-fill" "ellipse-fill" "star-fill")
  :learn (:concept "Filling a regular polygon — the convex n-vertex shape of ngon flooded solid, tessellating the plane for n ∈ {3,4,6}." :prerequisites ("ngon" "polygon-fill") :progression "Outline a regular polygon with ngon, fill it with ngon-fill, and tile filled hexagons to cover a board.")
  :row-2-audit (

    (:problem "A strategy-game renderer needs to colour each hex cell by its terrain type — green for grass, blue for water — as a solid fill that reads at a glance. Outlined hexes force the player to infer terrain from a label; the author wants the cell itself coloured."
     :program "(set-mode 'sd)\n(ngon-fill 100 100 24 6 0 'green)\n(ngon-fill 148 100 24 6 0 6)\n(ngon-fill 124 138 24 6 0 'green)"
     :eng-program "(set-mode 'sd)\n(define (terrain-hex cx cy r terrain)\n  ;; Map terrain symbol to colour, then fill the cell solid.\n  (let ((color (cond ((eq? terrain 'grass) 'green)\n                     ((eq? terrain 'water) 6)\n                     ((eq? terrain 'sand) 'yellow)\n                     (else 8))))\n    (ngon-fill cx cy r 6 0 color)))\n(terrain-hex 100 100 24 'grass)\n(terrain-hex 148 100 24 'water)"
     :math-program "(set-mode 'sd)\n;; The filled cell is the convex hull of the six vertices, flooded solid.\n(define (cell cx cy r color) (ngon-fill cx cy r 6 0 color))\n(cell 100 100 24 'green) (cell 148 100 24 6)"
     :cs-program "(set-mode 'sd)\n(define (cell-guard cx cy r n color)\n  (if (>= n 3) (ngon-fill cx cy r n 0 color) (error 'ngon-needs-three-sides)))\n(cell-guard 160 120 30 6 'green)"
     :explanation "eng: map a terrain symbol to a colour, then fill the hex solid. math: name the fill as the flooded convex hull of the vertices. cs: guard n ≥ 3 before filling."
     :meta "ngon only outlines, leaving the cell uncoloured. polygon-fill could fill a computed hexagon but demands the six vertices be listed by hand per cell. ellipse-fill fills a disc, which does not tessellate into a gap-free board. ngon-fill is the solid-regular-tile primitive; the siblings under-fill, over-specify, or fail to tessellate.")
    (:eng "The audit lens is 'does the cell colour read the terrain?' — the smoke test is that each hex's fill colour maps to its terrain, which a solid fill shows directly and an outline does not." :math "The filled cell is the flooded interior of the regular hexagon, a convex region tiling the plane." :cs "Convex-polygon scanline fill; O(area) pixels per cell, one span per row."))
  :row-3-dimension (
    (:setup "Assign one uniform value to every point of a regular, tessellating cell.")
    (:rungs (
       (:domain "ngon-fill"   :code "(set-mode 'sd) (ngon-fill 160 120 40 6 0 'green)")
       (:domain "map-region"  :code "(define (color-region cells terrain->color terrain) (map (lambda (c) (cons c (terrain->color terrain))) cells))\n(color-region (list 'h1 'h2) (lambda (t) (if (eq? t 'grass) 'green 'blue)) 'grass)")
       (:domain "partition"   :code "(define (assign-class point boundary) (if (< point boundary) 'A 'B))\n(map (lambda (p) (assign-class p 5)) (list 2 5 8))")))
    (:explanation "Rung 1: every point of a regular hex cell is filled with the terrain's colour. Rung 2: each map region is assigned a single colour by its class. Rung 3: a partition assigns every point to exactly one class by a decision rule. All three share the same shape — a tessellating region assigned one uniform label across its whole extent, the cells partitioning the space.")
    (:meta "The transfer works because a filled tessellation is a partition of the plane into labelled cells — each cell one colour, cells covering everything without overlap. Every choropleth map, region-labelled image, and space partition is this partition-into-labelled-cells shape. Grounds in book-of-math ch-advanced-13 (topology) as the tessellation / partition shape.")
    (:eng "Every tessellation substrate shares 'cells must cover without gaps or overlap' — the operator's check is that adjacent filled cells share edges cleanly." :math "A regular tessellation partitions ℝ² into congruent cells; for n ∈ {3,4,6} the cells fit gap-free." :cs "Space partition with per-cell labels; the shape of every choropleth and every grid-colouring pass."))
  :row-4-proof (
    (:claim "A regular n-gon's filled area is (1/2)·n·r²·sin(2π/n): it scales as r² (quadratic in the circumradius) and increases toward the circle area π·r² as n grows.")
    (:program "(define pi 3.14159265)\n(define (ngon-area r n) (* 0.5 n r r (sin (/ (* 2 pi) n))))\n(define base (ngon-area 10 6))\n(display (< (abs (- (ngon-area 20 6) (* 4 base))) 0.001)) (newline)\n(define hex (ngon-area 10 6))\n(display (< (- (* pi 100) hex) (* pi 100)))"
     :eng-program "(set-mode 'sd)\n;; A hexagon and one with double the radius cover four times the area; both fills run.\n(ngon-fill 90 120 15 6 0 3)\n(ngon-fill 220 120 30 6 0 3)"
     :math-program "(define pi 3.14159265)\n(define (ngon-area r n) (* 0.5 n r r (sin (/ (* 2 pi) n))))\n(define (quadratic-in-r? k n)\n  (< (abs (- (ngon-area (* k 10) n) (* k k (ngon-area 10 n)))) 0.001))\n(and (quadratic-in-r? 2 6) (quadratic-in-r? 3 6) (quadratic-in-r? 2 8))"
     :cs-program "(define pi 3.14159265)\n(define (ngon-area r n) (* 0.5 n r r (sin (/ (* 2 pi) n))))\n(define (approaches-circle? n)\n  ;; The n-gon area nears π·r² as n grows.\n  (< (- (* pi 100) (ngon-area 10 n)) 3))\n(list 'n=12 (approaches-circle? 12) 'n=64 (approaches-circle? 64))"
     :invariant "∀ n ≥ 3, k > 0. area(k·r, n) = k²·area(r, n)  ∧  area(r, n) → π·r² as n → ∞  (area is quadratic in the circumradius and converges to the disc area)"
     :meta "The pattern is the polygon area as a sum of n isosceles triangles, each of area ½·r²·sin(2π/n), giving ½·n·r²·sin(2π/n); as n → ∞ the sin term makes it converge to π·r², the disc area (the classical exhaustion argument). Falsified if the n-gon area did not approach π·r² for large n; that would break Archimedes' method of exhaustion. book-of-math ch-advanced-06 (calculus-integration) grounds the exhaustion limit; book-of-code ch 11 grounds the triangle-sum multiply-accumulate."))
    (:eng "The operator can predict fill cost as r² and know a high-n tile costs about as much as a disc, which is why ngon-fill at large n is a drop-in faceted circle." :math "Area = ½·n·r²·sin(2π/n) → π·r² by Archimedean exhaustion as n → ∞." :cs "Quadratic area with a convergent limit; the same shape as a Riemann sum approaching its integral.")
  :row-5-emergence (

    (:base "ngon-fill paints one solid regular polygon from a centre, radius, and side count.")
    (:composition "(set-mode 'sd)\n;; A gear: a filled hex hub, a ring rim, and an outer toothed n-gon outline.\n(ngon 160 120 55 16 0 8)\n(ring 160 120 45 38 8)\n(ngon-fill 160 120 16 6 0 6)"
     :eng-composition "(set-mode 'sd)\n(define (hex-board cols rows r colors)\n  ;; A filled hex board; each cell coloured by a cycling palette.\n  (for-each (lambda (row)\n              (for-each (lambda (col)\n                          (let ((x (+ 55 (* col (* r 1.9)) (* (modulo row 2) (* r 0.95))))\n                                (y (+ 55 (* row (* r 1.6)))))\n                            (ngon-fill x y r 6 0 (list-ref colors (modulo (+ row col) (length colors))))))\n                        (iota cols)))\n            (iota rows)))\n(hex-board 4 3 20 (list 3 6 'yellow))"
     :math-composition "(set-mode 'sd)\n;; A faceted disc: as n rises the filled polygon fills a smoother circle.\n(ngon-fill 90 120 35 5 -1.5708 6)\n(ngon-fill 220 120 35 20 0 6)"
     :cs-composition "(set-mode 'sd)\n;; A die face: a rounded square token with pips.\n(ngon-fill 160 120 50 4 0.7854 'white)\n(ellipse-fill 145 105 4 4 0)\n(ellipse-fill 160 120 4 4 0)\n(ellipse-fill 175 135 4 4 0)"
     :emergent "A gear, a coloured hex board, a low-n-vs-high-n disc pair, and a die face: the same solid regular polygon — as a hub, a tiled board, a faceted circle, or a token — composes a machine part, a game map, a shape-convergence demo, and a die.")
    (:meta "This is the tessellation-fill family — cover a board with congruent coloured cells or build parts from regular solids. Familiar analogs are choropleth hex maps, mosaic tiling, and the regular-solid tokens of board games. The composition works because ngon-fill is a self-contained solid tile, so boards, hubs, and tokens all instance it at chosen radii, side counts, and colours.")
    (:eng "The audit lens is 'the palette maps to state' — an SRE probe checks each cell's colour reflects its data value, since a filled board communicates entirely through colour." :math "A filled board is a labelled tessellation; each cell is a constant-colour regular polygon covering its patch of the plane." :cs "Coloured tessellation; the shape of every hex-map renderer and every mosaic fill."))
)

(verb
  :name "ring" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ring cx cy rOuter rInner [color]) -> undefined"
  :summary "Outline an annulus about (cx,cy): a pair of concentric circles at radii rOuter and rInner."
  :explanation "ring draws the boundary of an annulus — the flat washer shape between two concentric circles sharing the centre (cx,cy). You give the outer radius and the inner radius; ring strokes both circles, leaving the band between them framed. It is the go-to for anything with a hole through the middle drawn as pure outline: a washer, a donut rim, a dartboard band, a pupil-and-iris, an O. Unlike drawing two separate circles by hand, ring ties the two radii to one centre so they stay concentric by construction. The optional trailing colour sets the pen for both circles; omit it to use the current pen. ring outlines only — to flood the band solid you draw a filled outer disc and punch it, or fill the two radii yourself. Its defining property is that every stroked point lies at exactly rOuter or rInner from the centre."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ring 160 120 50 30 8)" :note "A single annulus: an outer circle of radius 50 and an inner one of radius 30, sharing a centre.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A dartboard: three concentric bands from three rings.\n(ring 160 120 60 45 8)\n(ring 160 120 45 30 'red)\n(ring 160 120 30 15 8)" :note "Nested rings at descending radii make the banded look of a dartboard.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; Ripples: concentric rings of decreasing thickness fanning out from a point.\n(for-each\n  (lambda (k)\n    (let ((ro (+ 12 (* k 12))))\n      (ring 160 120 ro (- ro 3) 6)))\n  (iota 5))" :note "A loop of rings at growing radii draws water ripples spreading from a centre.")
  )
  :caveats ("rOuter must exceed rInner or the band collapses; ring does not check the order for you." "It strokes two circle outlines, not a solid band — the interior between them is left unfilled." "The optional colour is the last argument and applies to both circles; there is no per-circle colour." "The band's visible thickness is rOuter − rInner in pixels; a tiny gap reads as a single thick circle.")
  :drawbacks ("Circular annulus only — no elliptical or squashed ring; use two ellipse calls for that." "No fill option; a solid washer needs a filled disc with a punched hole drawn over it." "Two full-circle strokes cost roughly twice a single circle, which matters in tight loops of many rings.")
  :usecases ("Washers, gaskets, and donut rims in mechanical iconography." "Dartboard, target, and gauge bands." "Ripple and shockwave effects as expanding concentric outlines." "Eye pupil-and-iris and letter-O glyph outlines.")
  :related ("ellipse" "ngon" "arc" "ellipse-fill")
  :learn (:concept "The annulus — the region between two concentric circles, drawn as a paired outline from one centre and two radii." :prerequisites ("ellipse") :progression "Draw a circle with ellipse, add a concentric inner circle to make a ring, then nest rings to band a target.")
  :row-2-audit (

    (:problem "A gauge widget needs a fixed circular track that a coloured needle sweeps over. The author wants the empty track drawn once as a clean band — an outer and inner arc of the dial — so the needle reads against a stable frame, not a smear of hand-placed circles that drift out of concentric."
     :program "(set-mode 'sd)\n(ring 160 130 60 48 8)"
     :eng-program "(set-mode 'sd)\n(define (gauge-track cx cy r width color)\n  ;; One centre, one width — the track can never drift out of concentric.\n  (ring cx cy r (- r width) color))\n(gauge-track 160 130 60 12 8)"
     :math-program "(set-mode 'sd)\n;; The track is the annulus {p : rInner <= |p - c| <= rOuter}; ring strokes its boundary.\n(ring 160 130 60 48 8)"
     :cs-program "(set-mode 'sd)\n(define (track cx cy ro ri color)\n  (if (> ro ri) (ring cx cy ro ri color) (error 'ring-outer-must-exceed-inner)))\n(track 160 130 60 48 8)"
     :explanation "eng: derive the inner radius from one width so the band stays concentric. math: name the track as the annulus between two radii. cs: guard rOuter > rInner before stroking."
     :meta "Two hand-placed ellipse calls could draw the same two circles, but nothing binds them to a shared centre — an edit to one radius silently breaks concentricity. arc draws only part of a circle, not a closed band. ellipse-fill floods a disc with no hole. ring is the concentric-pair primitive: it enforces the shared centre the siblings leave to the author to maintain.")
    (:eng "The audit lens is 'is the band concentric and constant-width?' — the smoke test is that outer and inner circles share a centre, which ring guarantees and two loose ellipse calls do not." :math "The track is the annulus, the set of points whose distance from the centre lies in [rInner, rOuter]; ring strokes its two bounding circles." :cs "Two circle-rasterisations sharing a centre; O(rOuter) boundary pixels, concentricity fixed at the call site."))
  :row-3-dimension (
    (:setup "Bound a region by two thresholds on one scalar field radiating from a centre.")
    (:rungs (
       (:domain "ring"        :code "(set-mode 'sd) (ring 160 120 50 30 8)")
       (:domain "temperature zone (a metaphor)" :code "(define (in-comfort-band? temp) (and (>= temp 68) (<= temp 74))) (list (in-comfort-band? 71) (in-comfort-band? 80))")
       (:domain "distance-field band (the math)" :code "(define (annulus? d ri ro) (and (>= d ri) (<= d ro))) (list (annulus? 40 30 50) (annulus? 20 30 50))")))
    (:explanation "Rung 1: ring paints the two boundaries of a distance band. Rung 2: a thermostat's comfort zone is a band between a low and a high threshold on temperature. Rung 3: the annulus predicate accepts a distance falling between two radii. All three share the shape 'a value lies between a lower and an upper bound on one scalar' — a closed interval on a single measure.")
    (:meta "The transfer works because an annulus is a closed interval [rInner, rOuter] lifted onto the radial distance field: a point is in the ring exactly when its distance falls in that interval, the same set-membership test as any low-and-high band. book-of-math ch-advanced-02 (real-analysis) grounds the interval / band shape.")
    (:eng "Every band substrate shares 'inside iff between a low and a high bound' — the operator checks both thresholds are set and ordered." :math "An annulus is the preimage of a closed interval [rInner, rOuter] under the distance-to-centre map." :cs "A range test on one scalar; the shape of every hysteresis band and every interval filter."))
  :row-4-proof (
    (:claim "The area enclosed by a ring is π·(rOuter² − rInner²): the outer disc's area minus the inner disc's, so it depends only on the difference of squared radii, not on where the hole sits.")
    (:program "(define pi 3.14159265)\n(define (ring-area ro ri) (* pi (- (* ro ro) (* ri ri))))\n(display (< (abs (- (ring-area 50 30) (- (* pi 2500) (* pi 900)))) 0.001))"
     :eng-program "(set-mode 'sd)\n;; A radius-50/30 washer and a radius-40/0 disc enclose the same area; both draw.\n(ring 90 120 50 30 8)\n(ellipse 220 120 40 40 8)"
     :math-program "(define pi 3.14159265)\n(define (ring-area ro ri) (* pi (- (* ro ro) (* ri ri))))\n(define (area-is-difference-of-discs? ro ri)\n  (< (abs (- (ring-area ro ri) (- (* pi ro ro) (* pi ri ri)))) 0.001))\n(and (area-is-difference-of-discs? 50 30) (area-is-difference-of-discs? 60 15))"
     :cs-program "(define pi 3.14159265)\n(define (ring-area ro ri) (* pi (- (* ro ro) (* ri ri))))\n;; Widening the outer radius by the same amount adds more area than widening the inner, since area grows with r.\n(display (> (- (ring-area 51 30) (ring-area 50 30)) (- (ring-area 50 29) (ring-area 50 30))))"
     :invariant "∀ rOuter > rInner ≥ 0. area(ring) = π·rOuter² − π·rInner² = π·(rOuter² − rInner²)  (the annulus area is the difference of the two disc areas)"
     :meta "The pattern is additivity of area under set difference: the annulus is the outer disc minus the inner disc, so its area is the difference of their areas. Falsified if the ring area depended on the centre position or on rInner and rOuter separately rather than through their squares; that would break the translation-invariance of area. book-of-math ch-advanced-06 (calculus-integration) grounds the disc area, ch-advanced-13 the set-difference of measures."))
    (:eng "The operator can size a washer's material by rOuter² − rInner² and know two rings of equal squared-radius-difference use equal ink." :math "area = π·(rOuter² − rInner²), the outer disc minus the inner — additive under set difference." :cs "A constant-time area from two squarings and a subtract; the shape of every donut-mask cost estimate.")
  :row-5-emergence (

    (:base "ring paints one annulus — a pair of concentric circles bounding a band.")
    (:composition "(set-mode 'sd)\n;; A target: alternating rings around a solid bullseye.\n(ring 160 120 55 42 8)\n(ring 160 120 42 29 'red)\n(ring 160 120 29 16 8)\n(ellipse-fill 160 120 14 14 'red)"
     :eng-composition "(set-mode 'sd)\n(define (gauge cx cy r ticks)\n  ;; A dial: a ring track plus radial ticks around it.\n  (ring cx cy r (- r 10) 8)\n  (for-each\n    (lambda (k)\n      (let* ((a (* k (/ 6.28318 ticks)))\n             (x1 (+ cx (* (- r 10) (cos a)))) (y1 (+ cy (* (- r 10) (sin a))))\n             (x2 (+ cx (* r (cos a))))       (y2 (+ cy (* r (sin a)))))\n        (polygon (list (list x1 y1) (list x2 y2)) 8)))\n    (iota ticks)))\n(gauge 160 120 55 12)"
     :math-composition "(set-mode 'sd)\n;; An eye: an iris ring around a filled pupil, on a white sclera disc.\n(ellipse-fill 160 120 45 30 'white)\n(ring 160 120 22 12 6)\n(ellipse-fill 160 120 11 11 0)"
     :cs-composition "(set-mode 'sd)\n;; Shockwave frames: concentric rings at growing radii, thinning as they spread.\n(for-each\n  (lambda (k)\n    (let ((ro (+ 14 (* k 14))))\n      (ring 160 120 ro (- ro (- 5 k)) 6)))\n  (iota 4))"
     :emergent "A target, a ticked gauge, an eye, and a spreading shockwave: the same annulus — as a scoring band, a dial track, an iris, or a ripple front — composes an archery face, an instrument, an eye, and an expanding wave.")
    (:meta "This is the concentric-band family — everything built by nesting or growing annuli around a shared centre. Familiar analogs are tree rings, ripples on water, radar sweeps, and the bands of a planetary ring. The composition works because ring is a self-similar unit that only needs a centre and two radii, so stacking it at different radii yields targets, dials, eyes, and waves with no new machinery.")
    (:eng "The audit lens is 'do the bands stay concentric as they scale?' — an operator animating ripples checks each frame's rings share the emitter's centre so the wave looks circular." :math "A concentric-band figure is a nested family of annuli sharing a centre, partitioning an offset range of the radial field." :cs "Radius-parametrised instancing of one ring unit; the shape of every radial-gauge and ripple renderer."))
)

(verb
  :name "arc" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(arc cx cy r a0 a1 [color]) -> undefined"
  :summary "Stroke a circular arc of radius r about (cx,cy), sweeping from angle a0 to angle a1 in radians."
  :explanation "arc traces part of a circle: the points at radius r from (cx,cy) whose angle runs from a0 to a1, measured in radians. Where ellipse closes a full loop, arc gives you just a slice of that loop — a curved segment, a smile, a rainbow band, a gauge sweep, a pac-man mouth's edge. Angles follow the usual convention: 0 points along +x, and the sweep advances by increasing angle. A full turn is 2π ≈ 6.2832, a half-circle is π ≈ 3.1416, a quarter is π/2. The optional trailing colour sets the pen; omit it for the current one. arc strokes the curve only — it does not draw the two radii to the endpoints, so it is an open curve, not a filled wedge. Its essence is that every stroked point sits at exactly radius r and at some angle in [a0, a1]: a controlled slice of a circle's boundary."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (arc 160 120 40 0 3.14159 11)" :note "A half-circle: an arc of radius 40 swept from angle 0 to π (a rainbow shape).")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A smiley face: two dot eyes and an upturned arc mouth.\n(ellipse-fill 145 105 5 5 0)\n(ellipse-fill 175 105 5 5 0)\n(arc 160 115 25 0.4 2.74 0)" :note "A short arc under two dots reads as a smiling mouth; the sweep sets how wide the smile is.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A sunburst: short arc rays fanned evenly around a centre.\n(for-each\n  (lambda (k)\n    (let ((a (* k 0.7854)))\n      (arc 160 120 46 a (+ a 0.18) 'yellow)))\n  (iota 8))" :note "Eight short arcs spaced by π/4 around the centre make a radiating sunburst.")
  )
  :caveats ("Angles are in radians, not degrees — π ≈ 3.1416 is a half-turn, not 180." "The sweep runs from a0 to a1 by increasing angle; if a1 < a0 the arc may be empty or wrap unexpectedly." "arc strokes the curve only, not the radii to its endpoints — it is not a pie wedge." "Angle 0 points along +x and positive angles advance in screen order; a smile and a frown differ by which side the sweep sits on.")
  :drawbacks ("Circular arcs only — no elliptical or squashed arc; those need a parametric point loop." "Open curve with no fill and no end-caps drawn; a solid sector must add its own radii and fill." "Very short arcs at small radius can read as a single dot; sweep and radius together set visible length.")
  :usecases ("Smiles, frowns, and mouth curves in faces." "Rainbows, gauge sweeps, and progress dials." "Pac-man mouths, moon crescents, and speech-bubble tails." "Sunburst rays and radial tick fans.")
  :related ("ellipse" "ring" "star" "ngon")
  :learn (:concept "The circular arc — a bounded slice of a circle's boundary, given by a centre, a radius, and a start and end angle in radians." :prerequisites ("ellipse") :progression "Draw a full circle with ellipse, cut it to a half with arc from 0 to π, then fan short arcs to build a sunburst.")
  :row-2-audit (

    (:problem "A loading widget needs a progress ring that fills clockwise as a job runs — 0% is an empty track, 100% a full circle, and 40% is a 0.4-of-a-turn sweep. The author needs to draw exactly the swept fraction of a circle, not a full loop and not a straight bar."
     :program "(set-mode 'sd)\n(arc 160 120 45 -1.5708 (+ -1.5708 (* 0.4 6.28318)) 6)"
     :eng-program "(set-mode 'sd)\n(define (progress-arc cx cy r frac color)\n  ;; Start at the top (-π/2) and sweep frac of a full turn.\n  (let ((start -1.5708))\n    (arc cx cy r start (+ start (* frac 6.28318)) color)))\n(progress-arc 160 120 45 0.4 6)"
     :math-program "(set-mode 'sd)\n;; The filled fraction is the arc subtending angle frac·2π from the start.\n(define tau 6.28318)\n(arc 160 120 45 -1.5708 (+ -1.5708 (* 0.4 tau)) 6)"
     :cs-program "(set-mode 'sd)\n(define (progress cx cy r frac color)\n  (let ((f (max 0 (min 1 frac))))\n    (arc cx cy r -1.5708 (+ -1.5708 (* f 6.28318)) color)))\n(progress 160 120 45 0.4 6)"
     :explanation "eng: start at the top and sweep frac of a turn. math: the arc subtends angle frac·2π. cs: clamp frac to [0,1] before mapping it to a sweep."
     :meta "ellipse draws the whole loop, so it cannot show a partial fraction. A polygon bar could show progress but loses the circular dial affordance the design wants. ring frames a full band, not a swept portion. arc is the partial-circle primitive: it draws exactly the angular slice progress demands, which the closed siblings cannot express.")
    (:eng "The audit lens is 'does the sweep match the fraction?' — the smoke test is that frac=0 draws nothing and frac=1 closes the full circle, with the arc length scaling linearly between." :math "The arc subtends a central angle a1 − a0; its length is r·(a1 − a0), proportional to the swept fraction of the turn." :cs "A parametric curve sampled over [a0, a1]; O(r·Δangle) boundary pixels, the sweep clamped to a valid range."))
  :row-3-dimension (
    (:setup "Take a bounded run of one cyclic parameter and realise only that slice of a periodic whole.")
    (:rungs (
       (:domain "arc"          :code "(set-mode 'sd) (arc 160 120 40 0 3.14159 11)")
       (:domain "clock hours (a metaphor)" :code "(define (hours-elapsed start end) (- end start)) (list (hours-elapsed 9 14) (hours-elapsed 0 12))")
       (:domain "angular interval (the math)" :code "(define (subtended a0 a1) (- a1 a0)) (define pi 3.14159265) (list (subtended 0 pi) (subtended 0 (* 2 pi)))")))
    (:explanation "Rung 1: arc realises the circle's boundary only over [a0, a1]. Rung 2: a stretch of a clock face from 9 to 2 is a slice of the twelve-hour cycle. Rung 3: the subtended angle a1 − a0 is the measure of the angular interval. All three share the shape 'a bounded sub-interval of a periodic whole' — a window on a cycle.")
    (:meta "The transfer works because an arc is an interval on the circle group: angle is a cyclic coordinate, and picking [a0, a1] selects one slice of the full 2π period, exactly as choosing a span of hours selects a slice of the clock cycle. book-of-math ch-advanced-08 (trigonometry) grounds the angle-as-cyclic-coordinate shape.")
    (:eng "Every cyclic-slice substrate shares 'pick a start and an end on a repeating dial' — the operator checks the endpoints lie in one period and are ordered." :math "An arc is a connected sub-interval of the circle S¹, parametrised by an angular interval [a0, a1]." :cs "A windowed sample of a periodic function; the shape of every gauge sweep and every phase-window filter."))
  :row-4-proof (
    (:claim "A circular arc's length is r·(a1 − a0): it is directly proportional to both the radius and the swept angle, and a full-turn arc (a1 − a0 = 2π) has length 2π·r, the circle's circumference.")
    (:program "(define pi 3.14159265)\n(define (arc-len r a0 a1) (* r (- a1 a0)))\n(display (< (abs (- (arc-len 40 0 (* 2 pi)) (* 2 pi 40))) 0.001))"
     :eng-program "(set-mode 'sd)\n;; A half-turn arc at radius 40 and a full circle at radius 20 have the same length; both draw.\n(arc 90 120 40 0 3.14159 8)\n(arc 220 120 20 0 6.28318 8)"
     :math-program "(define pi 3.14159265)\n(define (arc-len r a0 a1) (* r (- a1 a0)))\n(define (proportional? r k a0 a1)\n  (< (abs (- (arc-len (* k r) a0 a1) (* k (arc-len r a0 a1)))) 0.001))\n(and (proportional? 40 2 0 pi) (proportional? 30 3 0.5 2.5))"
     :cs-program "(define pi 3.14159265)\n(define (arc-len r a0 a1) (* r (- a1 a0)))\n;; A full-turn arc's length equals the circle circumference 2*pi*r.\n(display (< (abs (- (arc-len 25 0 (* 2 pi)) (* 2 pi 25))) 0.001))"
     :invariant "∀ r ≥ 0, a0 ≤ a1. length(arc) = r·(a1 − a0)  ∧  length(arc) = 2π·r when a1 − a0 = 2π  (arc length is radius times swept angle, reducing to the circumference on a full turn)"
     :meta "The pattern is that radian measure is defined so that arc length equals radius times angle — that is what a radian is. Falsified if a full-turn arc's length differed from 2π·r or if doubling the radius did not double the length; that would mean the angle unit was not radians. book-of-math ch-advanced-08 (trigonometry) grounds the radian definition, ch-advanced-06 the circumference as an integral of the arc-length element."))
    (:eng "The operator can size an arc's ink as r·(a1 − a0) and know a full sweep costs the whole circumference, which sets the pixel budget of a progress ring." :math "length = r·(a1 − a0); the radian is defined by this identity, and a full turn gives 2π·r." :cs "A constant-time length from a subtract and a multiply; the shape of every arc-cost and stroke-budget estimate.")
  :row-5-emergence (

    (:base "arc strokes one slice of a circle's boundary from a start angle to an end angle.")
    (:composition "(set-mode 'sd)\n;; A rainbow: nested half-arcs of growing radius in a palette sweep.\n(arc 160 170 70 3.14159 6.28318 'red)\n(arc 160 170 60 3.14159 6.28318 'yellow)\n(arc 160 170 50 3.14159 6.28318 'green)\n(arc 160 170 40 3.14159 6.28318 6)" :note "")
    (:eng-composition "(set-mode 'sd)\n(define tau 6.28318)\n(define (dial cx cy r frac)\n  ;; A gauge: a full track ring plus a coloured arc showing the reading.\n  (ring cx cy r (- r 8) 8)\n  (arc cx cy (- r 4) -1.5708 (+ -1.5708 (* frac tau)) 'red))\n(dial 160 120 55 0.65)"
     :math-composition "(set-mode 'sd)\n;; A crescent moon: a filled disc with an offset arc suggesting the shadow edge.\n(ellipse-fill 160 120 40 40 'yellow)\n(ellipse-fill 175 120 38 40 0)\n(arc 145 120 40 -1.4 1.4 'yellow)"
     :cs-composition "(set-mode 'sd)\n;; A pac-man: a near-full arc plus its two mouth radii close the wedge.\n(arc 160 120 40 0.6 5.68 'yellow)\n(polygon (list (list 160 120) (list (+ 160 (* 40 (cos 0.6))) (+ 120 (* 40 (sin 0.6))))) 'yellow)\n(polygon (list (list 160 120) (list (+ 160 (* 40 (cos 5.68))) (+ 120 (* 40 (sin 5.68))))) 'yellow)"
     :emergent "A rainbow, a gauge dial, a crescent moon, and a pac-man: the same arc — as a colour band, a reading needle track, a shadow terminator, or a mouth's edge — composes a sky, an instrument, a moon phase, and a game sprite.")
    (:meta "This is the partial-revolution family — figures made by realising only a slice of a circular sweep. Familiar analogs are clock hands' travel, moon phases, protractor angles, and progress dials. The composition works because arc exposes the start and end angle directly, so any figure that lives on a portion of a circle — a mouth, a phase edge, a needle path, a band of sky — is one arc call away.")
    (:eng "The audit lens is 'do start and end angle frame the intended slice?' — an operator animating a dial checks the sweep endpoint tracks the reading and never overshoots the full turn." :math "A partial-revolution figure is the image of a sub-interval of S¹ under the point-on-circle map; the angular endpoints fix the slice." :cs "Endpoint-parametrised sampling of a circular path; the shape of every progress-arc, moon-phase, and gauge renderer."))
)








