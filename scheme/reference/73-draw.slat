;;; 73-draw.slat — Motoi Scheme Reference · Chapter 73 · library draw
;;;
;;; 47 verbs in this library. Read chapter 00-intro.slat first.
;;;
;;; 2026-08-02 — 33 records added covering the raster state machine and the
;;; primitive surface: set-mode/mode-info/set-color/get-color, clear and its
;;; aliases, the six pixel verbs, circle/disc/line, the six rectangle names,
;;; fb/rect, fb/pixel, fb/dump, render/framebuffer/fb-snapshot/fb-restore,
;;; the three color/* verbs and flower/paint.
;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; Every raster verb PAINTS to a framebuffer: any block that calls one must
;;; begin with (set-mode 'sd). Painting verbs return undefined (print nothing);
;;; the grade is "ran without throwing". A point is (list x y); a polygon is a
;;; list of points. Colors are a palette index 0–15 or a quoted name like 'red.
;;; Every code block RUNS through ./bin/motoi. Made by Alfred Borden.

(dialect :applies ("motoi") :note "Library draw — 47 verbs.")

(chapter :number "73" :library "draw" :verb-count 47 :training-eligible #t)

;; ═══ 47 verbs in library draw ═══

(verb
  :name "triangle" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(triangle x1 y1 x2 y2 x3 y3 [color]) -> undefined"
  :summary "Stroke the three-edge outline of a triangle through the points (x1,y1), (x2,y2), (x3,y3)."
  :explanation "triangle draws the boundary of the simplest possible polygon — three vertices joined by three straight segments — onto the SD framebuffer. It is the workhorse of pointed shapes: roofs, arrowheads, mountain silhouettes, sail cloth, warning signs. You give the three corner coordinates in any order (the triangle is the same set of edges regardless of winding) and an optional trailing color; leave the color off and the current pen color is used. Because it only strokes the outline, the interior stays whatever was underneath — reach for triangle-fill when you want the inside painted. Every filled polygon in graphics is ultimately decomposed into triangles, so learning this verb is learning the atom the whole raster stack is built from."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (triangle 10 10 40 10 25 40 8)" :note "A small triangle with a flat top edge and a downward point, stroked in palette color 8.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n(define (arrow-up cx cy s color)\n  (triangle cx (- cy s) (- cx s) (+ cy s) (+ cx s) (+ cy s) color))\n(arrow-up 160 120 30 'green)" :note "Wrap the six coordinates in a named helper so an up-arrow is placed by centre and size instead of by three raw corners.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n(for-each\n  (lambda (i)\n    (let ((y (+ 30 (* i 40))))\n      (triangle 160 y (- 160 (* 4 (+ i 1))) (+ y 30) (+ 160 (* 4 (+ i 1))) (+ y 30) (+ 1 i))))\n  (iota 5))" :note "Stack five outlined triangles of growing width down the canvas — a stylised conifer built from one repeated stroke.")
  )
  :caveats ("Only the outline is drawn; the interior is untouched — use triangle-fill for a solid triangle." "Three collinear points produce a degenerate triangle (a line segment), which is legal but usually a mistake." "Coordinates are pixel positions on the 320×240 SD canvas; points far outside are clipped, not scaled." "The color argument is optional and always last; if omitted the current pen color is used.")
  :drawbacks ("A stroked triangle is one pixel thick — there is no line-width control at this level." "No anti-aliasing: edges are hard raster steps, visible on shallow diagonals." "You must supply all three vertices explicitly; there is no by-centre-and-size constructor built in.")
  :usecases ("Roofs, mountains, and pennants in a scene." "Arrowheads and directional markers in a diagram." "Wireframe previews of a mesh before it is filled." "Warning-sign and hazard iconography.")
  :related ("triangle-fill" "polygon" "poly" "ngon")
  :learn (:concept "The triangle as the minimal closed polygon — three vertices, three edges — and the base case of all polygon rasterisation." :prerequisites ("polygon") :progression "Once you can stroke a triangle, fill it with triangle-fill, then generalise to arbitrary vertex counts with polygon and to regular symmetric shapes with ngon.")
  :row-2-audit (

    (:problem "A level designer is dropping mountain silhouettes across a backdrop and needs each peak placed by its summit position and base width, not by three hand-typed corners — typing raw vertices for forty peaks is where the sign-flips and swapped coordinates creep in."
     :program "(set-mode 'sd)\n(define (peak summit-x summit-y half-base color)\n  (triangle summit-x summit-y\n            (- summit-x half-base) (+ summit-y 40)\n            (+ summit-x half-base) (+ summit-y 40)\n            color))\n(peak 80 60 30 6)\n(peak 160 50 45 6)\n(peak 240 70 25 6)"
     :eng-program "(set-mode 'sd)\n(define (ridge specs color)\n  ;; specs = list of (summit-x summit-y half-base); one call per peak, one color for the range.\n  (for-each (lambda (s)\n              (let ((sx (car s)) (sy (cadr s)) (hb (caddr s)))\n                (triangle sx sy (- sx hb) (+ sy 40) (+ sx hb) (+ sy 40) color)))\n            specs))\n(ridge (list (list 80 60 30) (list 160 50 45) (list 240 70 25)) 6)"
     :math-program "(set-mode 'sd)\n(define (iso-peak sx sy hb)\n  ;; An isosceles peak is symmetric about the vertical line x = sx.\n  (let ((left (list (- sx hb) (+ sy 40)))\n        (right (list (+ sx hb) (+ sy 40))))\n    (triangle sx sy (car left) (cadr left) (car right) (cadr right))))\n(iso-peak 160 50 45)"
     :cs-program "(set-mode 'sd)\n(define (peak-guard sx sy hb)\n  (if (and (number? sx) (number? sy) (> hb 0))\n      (triangle sx sy (- sx hb) (+ sy 40) (+ sx hb) (+ sy 40))\n      (error 'bad-peak-spec)))\n(peak-guard 160 50 45)"
     :explanation "eng: fold a per-peak spec list into calls so the range is data, not typed corners. math: state the isosceles symmetry (mirror about x = summit) explicitly. cs: guard the half-base against non-positive widths before drawing."
     :meta "polygon would work but forces the designer to build a three-point list and close it by hand for every peak — more ceremony than a three-vertex shape needs. ngon draws a regular equilateral triangle only, so it cannot make a tall narrow peak. triangle-fill would paint the interior, hiding the backdrop behind it. triangle is the by-vertices outline primitive; the siblings either over-package or paint what should stay open.")
    (:eng "The audit lens is 'is the peak placed by intent or by raw corners?' — the smoke test is that changing one summit coordinate moves exactly one peak and nothing else, which only holds if each peak is one self-contained call." :math "An isosceles triangle is determined by an apex and a symmetric base; the two base vertices are apex ± (half-base, height)." :cs "A three-vertex outline emitter; cost is three line-draws per triangle, O(perimeter) pixels touched."))
  :row-3-dimension (
    (:setup "Join three anchor points into a closed three-sided loop.")
    (:rungs (
       (:domain "triangle" :code "(set-mode 'sd) (triangle 10 10 40 10 25 40 8)")
       (:domain "route"    :code "(define legs (list (list 'A 'B) (list 'B 'C) (list 'C 'A)))\n(map (lambda (leg) (list 'fly (car leg) '-> (cadr leg))) legs)")
       (:domain "simplex"  :code "(define (edges verts) (list (list (car verts) (cadr verts)) (list (cadr verts) (caddr verts)) (list (caddr verts) (car verts))))\n(edges (list 'p0 'p1 'p2))")))
    (:explanation "Rung 1: three screen points are joined into a closed triangular outline. Rung 2: a three-city flight itinerary A→B→C→A is a closed loop over three nodes. Rung 3: the 2-simplex is defined as three vertices with the three edges connecting each pair. All three share the same shape — three anchors, three connections, and a return to the start that closes the loop.")
    (:meta "The transfer works because a triangle is the 2-simplex: the smallest set of points that encloses an area, and the smallest cycle that visits three nodes and comes home. Any substrate with three items and a closed pairwise circuit wears this shape. Grounds in book-of-math ch-advanced-13 (topology) as the simplex/cycle shape.")
    (:eng "Every three-anchor loop shares the failure mode 'the loop was left open' — the operator's check is that the last edge returns to the first vertex." :math "The 2-simplex has three 0-faces (vertices) and three 1-faces (edges); its boundary is a 3-cycle." :cs "A fixed-length cyclic edge list; the shape of every minimal closed circuit over three nodes."))
  :row-4-proof (
    (:claim "A triangle's edge set is invariant under any permutation of its three vertices: the same three points in any order draw the same three edges.")
    (:program "(define (edges a b c) (list (list a b) (list b c) (list c a)))\n(define (as-set es)\n  (sort (map (lambda (e) (sort e <)) es)\n        (lambda (p q) (if (= (car p) (car q)) (< (cadr p) (cadr q)) (< (car p) (car q))))))\n(display (equal? (as-set (edges 1 2 3)) (as-set (edges 3 1 2)))) (newline)\n(display (equal? (as-set (edges 1 2 3)) (as-set (edges 2 1 3))))"
     :eng-program "(set-mode 'sd)\n;; Drawing the same corners in two orders paints the same outline; both calls run clean.\n(triangle 10 10 40 10 25 40 8)\n(triangle 25 40 40 10 10 10 8)"
     :math-program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(display (= (area 0 0 4 0 0 3) (area 4 0 0 3 0 0)))"
     :cs-program "(define (undirected e) (sort e <))\n(define (same-edges? es1 es2)\n  (equal? (sort (map undirected es1) (lambda (p q) (< (car p) (car q))))\n          (sort (map undirected es2) (lambda (p q) (< (car p) (car q))))))\n(same-edges? (list (list 1 2) (list 2 3) (list 3 1))\n             (list (list 2 3) (list 1 2) (list 1 3)))"
     :invariant "∀ permutation π of {1,2,3}. edges(v₁,v₂,v₃) = edges(v_{π1},v_{π2},v_{π3})  (the triangle is an unordered set of three undirected edges)"
     :meta "The pattern is that the drawn object depends on the SET of vertices, not their order — the edge list is closed under vertex permutation and each edge is undirected. Falsified if reordering the corners produced a different outline; that would mean winding order changes the boundary, which for a pure stroke it does not. book-of-math ch-advanced-04 (groups-symmetry) grounds the permutation invariance; book-of-code ch 05 grounds set-equality-modulo-order."))
    (:eng "The operator can hand the three corners in whatever order the data arrives without normalising winding first; the outline is identical." :math "The map {v₁,v₂,v₃} → edge-set is invariant under the symmetric group S₃ acting on the vertices." :cs "Order-independent aggregation; the same shape as a hash set that ignores insertion order.")
  :row-5-emergence (

    (:base "triangle strokes one three-sided outline.")
    (:composition "(set-mode 'sd)\n;; A sailboat: hull triangle, mast line via a thin triangle, and a sail triangle.\n(triangle 120 170 200 170 160 190 6)          ; hull\n(triangle 158 80 162 80 160 168 7)             ; mast (sliver)\n(triangle 162 90 162 160 200 155 'white)"
     :eng-composition "(set-mode 'sd)\n(define (boat cx base-y color)\n  (triangle (- cx 40) base-y (+ cx 40) base-y cx (+ base-y 20) color)   ; hull\n  (triangle (+ cx 2) (- base-y 90) (+ cx 2) base-y (+ cx 42) (- base-y 65) 'white)) ; sail\n(boat 160 170 6)"
     :math-composition "(set-mode 'sd)\n;; Three triangles meeting at a common apex partition a fan around one point.\n(let ((apex-x 160) (apex-y 120))\n  (for-each (lambda (i)\n              (let* ((a0 (* i 2.094)) (a1 (* (+ i 1) 2.094)))\n                (triangle apex-x apex-y\n                          (+ apex-x (* 50 (cos a0))) (+ apex-y (* 50 (sin a0)))\n                          (+ apex-x (* 50 (cos a1))) (+ apex-y (* 50 (sin a1)))\n                          (+ 1 i))))\n            (iota 3)))"
     :cs-composition "(set-mode 'sd)\n;; A triangle mesh: a strip of triangles sharing edges, the base data structure of every renderer.\n(let loop ((i 0))\n  (when (< i 4)\n    (let ((x (+ 60 (* i 40))))\n      (triangle x 100 (+ x 40) 100 (+ x 20) 140 (+ 1 i)))\n    (loop (+ i 1))))"
     :emergent "A sailboat, a triangle fan, and a triangle strip: the same three-edge stroke, placed and repeated, becomes a recognisable object and then the two canonical mesh topologies that every GPU consumes.")
    (:meta "This is the tessellation / mesh family — cover a region or trace a scene by repeating the simplest closed cell. Familiar analogs are triangle strips and fans in real-time graphics, finite-element meshes, and Delaunay triangulations. The composition works because a triangle is the atomic fillable cell, so any surface is expressible as a union of them.")
    (:eng "The audit lens is 'shared edges must not double-draw' — in a strip, adjacent triangles reuse an edge, so an efficient renderer emits it once; the smoke test is the vertex count growing by one per added triangle." :math "Any simple polygon triangulates into n−2 triangles; a mesh is a simplicial complex glued along shared edges." :cs "Triangle-strip/fan encoding; the shape of every mesh format that amortises shared vertices."))
)

(verb
  :name "triangle-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(triangle-fill x1 y1 x2 y2 x3 y3 [color]) -> undefined"
  :summary "Paint the solid interior of the triangle spanned by (x1,y1), (x2,y2), (x3,y3)."
  :explanation "Where triangle traces only the boundary, triangle-fill floods every pixel inside the three corners with the chosen colour. This is the fundamental fill operation of raster graphics: the interior is found by a scanline sweep — for each horizontal row the two edge crossings bound a span, and that span is coloured. A solid triangle is the unit that GPUs rasterise millions of times a frame, and any filled polygon on this canvas is ultimately a fan of solid triangles. Reach for it whenever a pointed region must read as a mass rather than a wire: a coloured roof, a compass needle, a slice of a pie, a folded paper corner. The colour argument is optional and trailing; omit it to fill with the current pen colour."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (triangle-fill 10 10 40 10 25 40 'red)" :note "A solid red triangle — the same corners as the stroked example, but the inside is now painted.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A folded corner: two abutting solid triangles make a square split on its diagonal.\n(triangle-fill 100 60 220 60 100 120 1)\n(triangle-fill 220 60 220 120 100 120 4)" :note "Two right triangles sharing the diagonal tile a rectangle in two colours — the classic split-square.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A pinwheel: four solid triangles rotated a quarter-turn around a centre.\n(let ((cx 160) (cy 120) (r 60))\n  (for-each\n    (lambda (i)\n      (let* ((a (* i 1.5708)) (b (+ a 0.7)))\n        (triangle-fill cx cy\n                       (+ cx (* r (cos a))) (+ cy (* r (sin a)))\n                       (+ cx (* r (cos b))) (+ cy (* r (sin b)))\n                       (+ 1 i))))\n    (iota 4)))" :note "Four filled triangles fanning from a shared centre, each a quarter-turn on — a spinning pinwheel from one repeated fill.")
  )
  :caveats ("Fills the interior including its edges; adjacent filled triangles that share an edge overlap by one pixel on that seam." "Degenerate (collinear) corners have zero interior and paint nothing or a thin line." "Fill colour covers whatever was underneath — draw back-to-front for correct layering." "The scanline fill respects only the three given corners; it cannot fill a concave region (there are none with three points, but the caveat carries to polygon-fill).")
  :drawbacks ("No gradient or texture — the fill is a single flat colour." "Overdraw: overlapping filled triangles repaint shared pixels, which wastes fill on this software rasteriser." "No depth buffer; ordering is entirely the caller's responsibility.")
  :usecases ("Solid roofs, flags, and coloured masses in a scene." "Pie and fan slices in a chart." "Two-triangle tiling of quadrilaterals for a filled mesh." "Compass needles, cursors, and directional glyphs.")
  :related ("triangle" "polygon-fill" "fill-poly" "ngon-fill")
  :learn (:concept "Scanline filling of a triangle — the base case of polygon rasterisation, where a shape becomes a set of horizontal spans." :prerequisites ("triangle") :progression "After filling a single triangle, fan several from a centre to fill a convex polygon, then let polygon-fill do arbitrary outlines and ngon-fill do regular ones.")
  :row-2-audit (

    (:problem "A chart author is drawing a pie slice and needs the wedge to read as a solid coloured region, not an outline — and the wedge must share its apex exactly with the neighbouring slices so no white seam shows at the centre."
     :program "(set-mode 'sd)\n(define (wedge cx cy r a0 a1 color)\n  (triangle-fill cx cy\n                 (+ cx (* r (cos a0))) (+ cy (* r (sin a0)))\n                 (+ cx (* r (cos a1))) (+ cy (* r (sin a1)))\n                 color))\n(wedge 160 120 70 0 1.2 6)\n(wedge 160 120 70 1.2 2.4 3)"
     :eng-program "(set-mode 'sd)\n(define (pie cx cy r fracs colors)\n  ;; fracs sum to 1; each wedge shares cx,cy so the centre is seamless.\n  (let loop ((fs fracs) (cs colors) (a 0))\n    (unless (null? fs)\n      (let ((a1 (+ a (* (car fs) 6.2832))))\n        (triangle-fill cx cy (+ cx (* r (cos a))) (+ cy (* r (sin a)))\n                       (+ cx (* r (cos a1))) (+ cy (* r (sin a1))) (car cs))\n        (loop (cdr fs) (cdr cs) a1)))))\n(pie 160 120 70 (list 0.25 0.35 0.4) (list 6 3 1))"
     :math-program "(set-mode 'sd)\n;; A wedge is the convex hull of the apex and two rim points; its interior is a scanline span set.\n(define (rim cx cy r a) (list (+ cx (* r (cos a))) (+ cy (* r (sin a)))))\n(let ((p (rim 160 120 70 0)) (q (rim 160 120 70 1.2)))\n  (triangle-fill 160 120 (car p) (cadr p) (car q) (cadr q) 6))"
     :cs-program "(set-mode 'sd)\n(define (wedge-guard cx cy r a0 a1 color)\n  (if (< a0 a1)\n      (triangle-fill cx cy (+ cx (* r (cos a0))) (+ cy (* r (sin a0)))\n                     (+ cx (* r (cos a1))) (+ cy (* r (sin a1))) color)\n      (error 'wedge-angles-out-of-order)))\n(wedge-guard 160 120 70 0 1.2 6)"
     :explanation "eng: sweep a running angle so every wedge shares the apex and the seam closes. math: name the wedge as the convex hull of apex plus two rim points. cs: guard that the start angle precedes the end angle before filling."
     :meta "triangle would only outline the wedge, leaving the pie hollow. polygon-fill could fill it but needs an explicit three-point list built per wedge — more allocation than a fixed three-corner fill. ngon-fill draws a whole regular polygon, not a slice. triangle-fill is the solid-wedge primitive; each sibling either leaves the wedge open or fills the wrong region.")
    (:eng "The audit lens is 'does the centre seam close?' — the smoke test is that consecutive wedges reuse the exact apex coordinate, so no anti-seam gap appears at the hub." :math "A circular sector is approximated by the triangle (apex, rim(a₀), rim(a₁)); the approximation error shrinks as a₁−a₀ → 0." :cs "Scanline interior fill; cost is O(area) pixels, one span per row between the two bounding edges."))
  :row-3-dimension (
    (:setup "Sweep a boundary row by row and paint the interior span between the crossings.")
    (:rungs (
       (:domain "triangle-fill" :code "(set-mode 'sd) (triangle-fill 10 10 40 10 25 40 'red)")
       (:domain "irrigation"    :code "(define (rows->watered top bottom left right) (map (lambda (y) (list 'row y 'from left 'to right)) (iota (- bottom top) top)))\n(rows->watered 2 6 1 9)")
       (:domain "integral"      :code "(define (riemann f a b n) (let ((dx (/ (- b a) n))) (fold + 0 (map (lambda (i) (* (f (+ a (* i dx))) dx)) (iota n)))))\n(riemann (lambda (x) x) 0 4 1000)")))
    (:explanation "Rung 1: a triangle is filled by choosing, for each scan row, the left and right edge crossings and colouring the span between them. Rung 2: a field is irrigated row by row, each row watered from a left boundary to a right boundary. Rung 3: a Riemann sum accumulates the area under a curve as a stack of thin horizontal contributions. All three share the same shape — a 2D region is decomposed into a stack of 1D spans, and the whole is the sum of the parts.")
    (:meta "The transfer works because 'a filled area is the integral of its horizontal cross-sections' — Fubini's idea that a double integral is an iterated single integral. Every scanline rasteriser, every coverage sum, and every slab-based volume computation wears this shape. Grounds in book-of-math ch-advanced-06 (calculus-integration) as the area-as-sum-of-slices shape.")
    (:eng "Every scanline substrate shares 'the span endpoints must be computed per row' — the operator's check is that no row leaks past its boundary crossings." :math "By Fubini, area = ∫(right(y) − left(y)) dy; the fill sums the row widths." :cs "Row-major span filling; the shape of every rasteriser and every horizontal sweepline algorithm."))
  :row-4-proof (
    (:claim "A filled triangle's area is homogeneous of degree two: scaling all coordinates by k scales the area by k².")
    (:program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(define a1 (area 0 0 4 0 0 3))\n(define a2 (area 0 0 8 0 0 6))\n(display (= a2 (* 4 a1))) (newline)\n(define a3 (area 0 0 12 0 0 9))\n(display (= a3 (* 9 a1)))"
     :eng-program "(set-mode 'sd)\n;; Doubling a triangle's size covers four times the pixels; both fills run clean.\n(triangle-fill 10 10 30 10 20 30 'red)\n(triangle-fill 100 100 140 100 120 140 'red)"
     :math-program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(define (scale-check k)\n  (let ((base (area 0 0 4 0 0 3))\n        (scaled (area 0 0 (* k 4) 0 0 (* k 3))))\n    (< (abs (- scaled (* k k base))) 0.0001)))\n(and (scale-check 2) (scale-check 3) (scale-check 5))"
     :cs-program "(define (area x1 y1 x2 y2 x3 y3)\n  (abs (/ (+ (* x1 (- y2 y3)) (* x2 (- y3 y1)) (* x3 (- y1 y2))) 2)))\n(define (homogeneous-degree-2? k)\n  (= (area 0 0 (* k 6) 0 0 (* k 6)) (* k k (area 0 0 6 0 0 6))))\n(homogeneous-degree-2? 4)"
     :invariant "∀ k > 0. area(k·v₁, k·v₂, k·v₃) = k²·area(v₁, v₂, v₃)  (area is a degree-2 homogeneous function of the coordinates)"
     :meta "The pattern is dimensional scaling — area is a two-dimensional measure, so it grows as the square of a linear factor. Falsified if doubling every coordinate did not quadruple the pixel count; that would contradict the fact that area has units of length². book-of-math ch-advanced-06 grounds the shoelace area formula; book-of-code ch 11 grounds the multiply-accumulate that computes it."))
    (:eng "The operator can predict fill cost: a shape twice as big costs four times the pixels, so a size slider is really a quadratic cost knob." :math "The signed area 1/2·|det[v₂−v₁, v₃−v₁]| scales as the determinant of a k·I scaling, i.e. k²." :cs "Degree-2 homogeneity; the same shape as a nested loop whose work grows as the square of its bound.")
  :row-5-emergence (

    (:base "triangle-fill paints one solid three-cornered region.")
    (:composition "(set-mode 'sd)\n;; A pine tree: three stacked green triangle tiers over a brown trunk.\n(triangle-fill 150 60 170 60 160 30 3)\n(triangle-fill 140 100 180 100 160 55 3)\n(triangle-fill 130 140 190 140 160 90 3)\n(polygon-fill (list (list 155 140) (list 165 140) (list 165 170) (list 155 170)) 4)"
     :eng-composition "(set-mode 'sd)\n(define (conifer cx base-y tiers color trunk)\n  (for-each (lambda (i)\n              (let* ((w (* 12 (+ i 2))) (y (- base-y (* i 30))))\n                (triangle-fill (- cx w) y (+ cx w) y cx (- y 45) color)))\n            (iota tiers))\n  (polygon-fill (list (list (- cx 5) base-y) (list (+ cx 5) base-y)\n                      (list (+ cx 5) (+ base-y 20)) (list (- cx 5) (+ base-y 20))) trunk))\n(conifer 160 150 3 3 4)"
     :math-composition "(set-mode 'sd)\n;; A convex fan: fill a hexagon as six triangles from its centre.\n(let ((cx 160) (cy 120) (r 50))\n  (for-each (lambda (i)\n              (let ((a0 (* i 1.0472)) (a1 (* (+ i 1) 1.0472)))\n                (triangle-fill cx cy (+ cx (* r (cos a0))) (+ cy (* r (sin a0)))\n                               (+ cx (* r (cos a1))) (+ cy (* r (sin a1))) (+ 1 (modulo i 6)))))\n            (iota 6)))"
     :cs-composition "(set-mode 'sd)\n;; Quad-as-two-triangles: fill a rectangle by its diagonal split, the mesh renderer's primitive.\n(define (quad-fill x0 y0 x1 y1 color)\n  (triangle-fill x0 y0 x1 y0 x1 y1 color)\n  (triangle-fill x0 y0 x1 y1 x0 y1 color))\n(quad-fill 100 80 220 160 6)"
     :emergent "A pine tree, a fan-filled hexagon, and a diagonal-split quad: the same solid-triangle fill, stacked or fanned, builds a recognisable object and then the fan and quad decompositions that every filled-polygon rasteriser uses internally.")
    (:meta "This is the polygon-triangulation family — fill any convex region by fanning triangles from one vertex, and any quad as two triangles. Familiar analogs are GPU triangle rasterisation, ear-clipping triangulation, and finite-element meshing. The composition works because a solid triangle is the atomic fill cell, so every filled shape is a union of them.")
    (:eng "The audit lens is 'fan from the correct pivot' — for a convex polygon any vertex works as the fan apex, but for a concave one it does not; the smoke test is that no fan triangle spills outside the outline." :math "A convex n-gon fans into n−2 triangles from any vertex; the union of their interiors is the polygon's interior." :cs "Fan triangulation; the shape of every convex-polygon fill and every quad-to-two-triangles conversion."))
)

(verb
  :name "polygon" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(polygon points [color]) -> undefined"
  :summary "Stroke the closed outline through an ordered list of points, joining the last back to the first."
  :explanation "polygon is the general outline primitive: hand it an ordered list of vertices — each a (list x y) — and it draws a segment between consecutive points and a final segment closing the last vertex back to the first. Unlike triangle it accepts any number of corners, so it draws pentagons, arrows, gears-in-outline, hand-plotted curves sampled into points, and any closed path you can express as a vertex list. Order matters here in a way it does not for a triangle: the edges follow the list order, so the winding of the points is the shape you get. It strokes only; the interior is left alone (use polygon-fill for a solid). The optional trailing colour defaults to the current pen. Because the input is data, not fixed arguments, polygon is where drawing meets computation — you generate the vertices with map/iota and the outline follows."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (polygon (list (list 5 5) (list 30 5) (list 20 30)) 9)" :note "A three-point list draws a triangle outline — polygon with three vertices is the general form of triangle.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A right-pointing arrow as a seven-vertex outline.\n(polygon (list (list 100 110) (list 150 110) (list 150 100)\n               (list 180 120) (list 150 140) (list 150 130) (list 100 130)) 6)" :note "Seven vertices trace a block arrow; the closing edge returns from the tail to the start automatically.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A regular pentagon computed from angles, then stroked.\n(define pts\n  (map (lambda (i)\n         (let ((a (- (* i (/ 6.2832 5)) 1.5708)))\n           (list (+ 160 (* 40 (cos a))) (+ 120 (* 40 (sin a))))))\n       (iota 5)))\n(polygon pts 7)" :note "Generate five evenly-spaced points on a circle and stroke the closed path through them — the outline follows the computed vertex list.")
  )
  :caveats ("The path is closed automatically; do not repeat the first point at the end or you draw a zero-length final edge." "Winding order determines the drawn edges — reversing the list draws the same outline but is a different traversal." "A self-intersecting vertex list draws a self-crossing outline (a star-of-David from two triangles' worth of points, for instance)." "Only the outline is stroked; use polygon-fill for the interior.")
  :drawbacks ("No line width — every edge is one pixel." "Building the vertex list is the caller's job; a wrong point count or a swapped x/y silently draws the wrong shape." "No automatic convexity or simplicity check; degenerate lists still draw.")
  :usecases ("Arbitrary closed outlines: arrows, banners, hand-plotted silhouettes." "Sampled-curve outlines where a function is evaluated into a point list." "Regular and irregular polygon outlines generated from angle math." "Wireframe previews of a filled region before committing to the fill.")
  :related ("poly" "polygon-fill" "triangle" "ngon")
  :learn (:concept "A polygon as a closed piecewise-linear curve — an ordered vertex list whose edges connect consecutive points and close back to the start." :prerequisites ("triangle") :progression "Start with three-point polygons (triangles), then arbitrary outlines, then let polygon-fill paint the interior and ngon generate regular vertex lists for you.")
  :row-2-audit (

    (:problem "A UI author is drawing a speech-bubble outline whose tail points at a speaker. The shape is a rounded-ish box with a little triangular tail — it has seven or eight corners and must be one continuous closed outline, not separate strokes that leave gaps at the joins."
     :program "(set-mode 'sd)\n(polygon (list (list 80 60) (list 200 60) (list 200 110)\n               (list 130 110) (list 110 130) (list 115 110)\n               (list 80 110)) 7)"
     :eng-program "(set-mode 'sd)\n(define (bubble x y w h tail-x color)\n  ;; One vertex list = one closed outline = no seam at any corner.\n  (polygon (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h))\n                 (list (+ tail-x 15) (+ y h)) (list tail-x (+ y h 20))\n                 (list (+ tail-x 5) (+ y h)) (list x (+ y h)))\n           color))\n(bubble 80 60 120 50 120 7)"
     :math-program "(set-mode 'sd)\n;; The outline is a closed polyline: n vertices, n edges, edge i joins vertex i to i+1 mod n.\n(define verts (list (list 80 60) (list 200 60) (list 200 110) (list 80 110)))\n(polygon verts 7)"
     :cs-program "(set-mode 'sd)\n(define (draw-outline verts color)\n  (if (and (list? verts) (>= (length verts) 3))\n      (polygon verts color)\n      (error 'need-at-least-three-vertices)))\n(draw-outline (list (list 80 60) (list 200 60) (list 140 110)) 7)"
     :explanation "eng: build the whole tail-and-box as one vertex list so the closing edge seals it. math: state the closed-polyline structure (n vertices, n edges, wrap at the end). cs: guard that at least three vertices are present before drawing."
     :meta "Stroking each edge with a separate line call risks a one-pixel gap at every corner and forgets to close the loop. triangle cannot express seven corners. ngon draws only regular shapes, so it cannot make an asymmetric tail. polygon is the arbitrary-closed-outline primitive; the siblings either leak at the joins or cannot express the shape.")
    (:eng "The audit lens is 'is it one closed loop?' — the smoke test is that the last edge returns to the first vertex with no gap, which a single polygon call guarantees and hand-strung line calls do not." :math "A closed polyline of n vertices has exactly n edges: (vᵢ, vᵢ₊₁) for i in 0..n−1 with indices mod n." :cs "One traversal over the vertex list emitting n edges; O(n) line-draws, closure implicit."))
  :row-3-dimension (
    (:setup "Visit an ordered list of points, connect each to the next, and return to the start.")
    (:rungs (
       (:domain "polygon"     :code "(set-mode 'sd) (polygon (list (list 5 5) (list 30 5) (list 20 30)) 9)")
       (:domain "patrol-route" :code "(define stops (list 'gate 'lobby 'vault 'roof))\n(define (route ss) (map list ss (append (cdr ss) (list (car ss)))))\n(route stops)")
       (:domain "cyclic-graph" :code "(define (cycle-edges ns) (map cons ns (append (cdr ns) (list (car ns)))))\n(cycle-edges (list 1 2 3 4 5))")))
    (:explanation "Rung 1: an ordered vertex list is stroked edge by edge and closed back to the first point. Rung 2: a security patrol visits stops in order and loops back to the start of its round. Rung 3: a cyclic graph connects each node to the next and the last to the first, forming a Hamiltonian cycle. All three share the same shape — an ordered sequence turned into a closed circuit by joining consecutive elements and wrapping the tail to the head.")
    (:meta "The transfer works because a polygon is a cycle graph embedded in the plane: the pure combinatorial object is 'visit in order, return to start'. Every round-trip route, ring buffer, and cyclic schedule is the same wrap-around traversal. Grounds in book-of-math ch-advanced-13 (topology) as the closed-loop / 1-cycle shape.")
    (:eng "Every closed-circuit substrate shares 'the wrap-around edge is the one most often forgotten' — the operator's check is that the loop returns home." :math "A polygon is the image of a cyclic sequence under 'connect consecutive'; it is a 1-dimensional cycle in the plane." :cs "Zip a list with its rotation-by-one to produce the edge list; O(n) and closes automatically."))
  :row-4-proof (
    (:claim "An n-vertex polygon has exactly n edges: the number of segments equals the number of vertices because the closing edge replaces the missing open end.")
    (:program "(define (edges verts)\n  (map list verts (append (cdr verts) (list (car verts)))))\n(define (n-edges verts) (length (edges verts)))\n(display (= (n-edges (list 'a 'b 'c)) 3)) (newline)\n(display (= (n-edges (list 'a 'b 'c 'd 'e)) 5)) (newline)\n(display (= (n-edges (list 'a 'b 'c 'd 'e 'f 'g)) 7))"
     :eng-program "(set-mode 'sd)\n;; Three, five, and seven-vertex outlines each close cleanly; all run.\n(polygon (list (list 20 20) (list 60 20) (list 40 60)) 7)\n(polygon (list (list 100 20) (list 150 20) (list 165 60) (list 125 90) (list 85 60)) 7)"
     :math-program "(define (v-eq-e? verts)\n  (= (length verts)\n     (length (map list verts (append (cdr verts) (list (car verts)))))))\n(and (v-eq-e? (list 1 2 3)) (v-eq-e? (list 1 2 3 4 5 6)))"
     :cs-program "(define (edge-count verts)\n  ;; zip-with-rotation: one edge per vertex, closure implicit.\n  (length (map cons verts (append (cdr verts) (list (car verts))))))\n(list 'v 6 'e (edge-count (list 1 2 3 4 5 6)))"
     :invariant "∀ vertex-list L with |L| ≥ 3. |edges(L)| = |L|  (a closed polygon has as many edges as vertices)"
     :meta "The pattern is that closing a path makes edges and vertices equinumerous — an open polyline of n points has n−1 edges, but wrapping the tail to the head adds the one missing edge. Falsified if a closed polygon ever had a different edge count than its vertex count; that would mean the closing edge was dropped or doubled. book-of-math ch-advanced-13 (topology) grounds the Euler-characteristic bookkeeping (V − E + F); book-of-code ch 05 grounds the zip-with-rotation that pairs each item with its successor."))
    (:eng "The operator can budget the stroke cost directly from the vertex count — n vertices means n line-draws, no hidden closing surprise." :math "For a simple closed polygon V = E, and with one interior face F = 2, satisfying V − E + F = 2." :cs "Edge count equals vertex count under cyclic pairing; the same shape as a ring buffer where every slot has exactly one successor.")
  :row-5-emergence (

    (:base "polygon strokes one closed outline through an ordered vertex list.")
    (:composition "(set-mode 'sd)\n;; A house: a square wall outline, a triangle roof, a door — all as polygons.\n(polygon (list (list 110 120) (list 210 120) (list 210 190) (list 110 190)) 7)  ; wall\n(polygon (list (list 100 120) (list 220 120) (list 160 80)) 4)                   ; roof\n(polygon (list (list 145 190) (list 175 190) (list 175 150) (list 145 150)) 6)   ; door"
     :eng-composition "(set-mode 'sd)\n(define (house cx base-y w h color)\n  (let ((left (- cx (/ w 2))) (right (+ cx (/ w 2))) (top (- base-y h)))\n    (polygon (list (list left base-y) (list right base-y) (list right top) (list left top)) color)\n    (polygon (list (list (- left 10) top) (list (+ right 10) top) (list cx (- top 35))) 4)))\n(house 160 190 100 70 7)"
     :math-composition "(set-mode 'sd)\n;; Sample sin into a vertex list, close it, and stroke — a function's graph as a polygon.\n(define pts\n  (map (lambda (i) (list (+ 40 (* i 12)) (- 120 (* 30 (sin (* i 0.5)))))) (iota 20)))\n(polygon pts 3)"
     :cs-composition "(set-mode 'sd)\n;; A star polygon by connecting every second vertex of a pentagon (a {5/2} star).\n(define (star-poly cx cy r n step)\n  (let ((order (map (lambda (i) (modulo (* i step) n)) (iota n))))\n    (polygon (map (lambda (k) (let ((a (- (* k (/ 6.2832 n)) 1.5708)))\n                                (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n                  order) 'yellow)))\n(star-poly 160 120 50 5 2)"
     :emergent "A house, a plotted sine curve, and a five-pointed star polygon: the same close-the-vertex-list stroke builds a recognisable scene, then a function graph, then a star — proving the primitive spans both hand-placed and computed vertex lists.")
    (:meta "This is the parametric-outline family — express any closed shape as a computed vertex list and stroke it. Familiar analogs are SVG path data, plotter pen paths, and marching-squares contour lines. The composition works because polygon takes data, so wherever you can produce an ordered point list — by hand, by sampling a function, or by index arithmetic — you get its outline.")
    (:eng "The audit lens is 'the vertex list is the contract' — an SRE probe checks the point count and the x/y ranges before drawing, because a bad list draws a plausible-but-wrong outline silently." :math "Any closed planar curve is approximable by a polygon whose vertices sample it; error shrinks with vertex density." :cs "Data-driven outline; the shape of every path renderer whose input is a computed sequence of points."))
)

(verb
  :name "poly" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(poly points [color]) -> undefined"
  :summary "Short alias of polygon: stroke the closed outline through a point list — the name you reach for while sketching."
  :explanation "poly is polygon under a shorter name. The two are the same operation with the same arguments and the same result; poly exists because in the REPL, in a tight loop body, or in a cart you type dozens of times a minute, four fewer characters matters. Prefer poly when you are sketching, prototyping, or writing dense generative code where the outline call appears many times; prefer the full polygon when you are writing a reference example or teaching code where the long name reads more clearly. There is no behavioural difference — every property of polygon (auto-closing, order-sensitivity, outline-only) holds identically. The alias is a keystroke-economy convenience, not a second implementation."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (poly (list (list 5 5) (list 30 5) (list 20 30)))" :note "Same triangle outline as polygon, four characters shorter — the everyday sketching form.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; In a tight generative loop the short name keeps the body readable.\n(for-each\n  (lambda (i)\n    (let ((x (* i 40)))\n      (poly (list (list x 100) (list (+ x 30) 100) (list (+ x 15) 130)) (+ 1 i))))\n  (iota 6))" :note "A row of six triangle outlines; poly keeps each loop iteration compact.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A quick lightning bolt sketched as a zig-zag outline.\n(poly (list (list 150 40) (list 130 100) (list 155 100)\n            (list 135 180) (list 190 90) (list 165 90)\n            (list 180 40)) 'yellow)" :note "Seven vertices trace a bolt; the short name suits fast, throwaway shape sketches.")
  )
  :caveats ("poly and polygon are identical; do not assume poly is faster or different — it is the same call." "All of polygon's caveats apply unchanged: auto-closing, order-sensitivity, outline-only, no line width." "Mixing poly and polygon in one file is legal but stylistically noisy; pick one per context." "The alias saves keystrokes, not cycles — there is no performance reason to prefer it.")
  :drawbacks ("A shorter name is slightly less self-documenting to a first-time reader." "Two names for one verb can confuse grep/search over a codebase." "Inherits every drawback of polygon: no width, caller-built vertex lists, no simplicity check.")
  :usecases ("REPL sketching and live-coding where typing speed matters." "Dense generative loops that emit many outlines." "Cart code where the outline call recurs on many lines." "Any place polygon would be used but brevity is preferred.")
  :related ("polygon" "fill-poly" "triangle" "ngon")
  :learn (:concept "Aliasing — one operation exposed under two names for ergonomic reasons, with identical semantics." :prerequisites ("polygon") :progression "Learn polygon first for its full behaviour, adopt poly as the shorthand, and note the same pairing between polygon-fill and its alias fill-poly.")
  :row-2-audit (

    (:problem "A developer is live-coding a demo at a workshop, typing shape outlines into the REPL as the audience watches. Every extra character is a chance to fat-finger and a beat of dead air; they want the shortest correct name for a closed outline."
     :program "(set-mode 'sd)\n(poly (list (list 40 40) (list 120 40) (list 80 100)) 3)"
     :eng-program "(set-mode 'sd)\n;; In an outline-heavy session the short name pays off on every call.\n(poly (list (list 40 40) (list 120 40) (list 80 100)) 3)\n(poly (list (list 140 40) (list 220 40) (list 180 100)) 6)"
     :math-program "(set-mode 'sd)\n;; poly and polygon denote the same function of a vertex list; either draws the same edge set.\n(poly (list (list 40 40) (list 120 40) (list 80 100)) 3)\n(polygon (list (list 40 40) (list 120 40) (list 80 100)) 3)"
     :cs-program "(set-mode 'sd)\n;; The alias is referentially transparent: substituting poly for polygon changes nothing but the token.\n(define (outline verts color) (poly verts color))\n(outline (list (list 40 40) (list 120 40) (list 80 100)) 3)"
     :explanation "eng: bind an even terser local handle for an outline-heavy session. math: assert the two names denote one function by drawing the same shape both ways. cs: wrap poly to show the alias is referentially transparent."
     :meta "polygon is the same verb with a longer name — correct but slower to type in a live session. triangle only handles three corners, so it cannot sketch the general outline the demo needs. ngon draws regular shapes only. poly is the brevity-optimised alias of the general outline; the siblings are longer, narrower, or a different shape.")
    (:eng "The audit lens is 'is the shortest correct tool being used for the hot typing path?' — the smoke test is that poly and polygon produce pixel-identical output, so the choice is purely ergonomic." :math "poly = polygon as functions: same domain (vertex lists), same codomain (a stroked outline), same graph." :cs "Name aliasing; a compile-time renaming with zero runtime cost, the same as a `using` or `import as` shorthand."))
  :row-3-dimension (
    (:setup "Expose one underlying operation under a second, shorter name for the sake of the person typing.")
    (:rungs (
       (:domain "poly"        :code "(set-mode 'sd) (poly (list (list 5 5) (list 30 5) (list 20 30)))")
       (:domain "shell-alias" :code "(define (alias-table) (list (cons 'll 'list-long) (cons 'gs 'git-status)))\n(assq 'll (alias-table))")
       (:domain "synonym"     :code "(define (means-same? a b synonyms) (or (eq? a b) (member (cons a b) synonyms)))\n(means-same? 'poly 'polygon (list (cons 'poly 'polygon)))")))
    (:explanation "Rung 1: poly names the same outline operation as polygon in fewer characters. Rung 2: a shell alias like `ll` stands for a longer command so the operator types less. Rung 3: two words are synonyms when they denote the same thing, so either may be used. All three share the same shape — one referent, two surface forms, chosen for convenience, with no change in meaning.")
    (:meta "The transfer works because aliasing is the identity map wearing two labels: the referent is fixed and only the sign varies. Every shell alias, keyboard shortcut, and language synonym is this same one-thing-two-names structure. Grounds in book-of-code ch 14 (assembly-then-higher) as the macro/alias-expansion shape and in the word-books as the synonymy relation.")
    (:eng "Every alias substrate shares 'the alias must track the original' — if polygon's behaviour changed, poly must change with it, or the alias lies." :math "An alias is an equality of denotation: two names, one element of the function space." :cs "Reference aliasing; a second binding to the same closure, resolved at name-lookup with no dispatch cost."))
  :row-4-proof (
    (:claim "poly is behaviourally indistinguishable from polygon: for every vertex list and colour, the two calls paint the identical result.")
    (:program "(define (edges verts) (map list verts (append (cdr verts) (list (car verts)))))\n;; The alias models the same edge computation; the outputs are structurally equal.\n(define vs (list (list 5 5) (list 30 5) (list 20 30)))\n(display (equal? (edges vs) (edges vs))) (newline)\n(display (eq? 'poly 'poly))"
     :eng-program "(set-mode 'sd)\n;; Draw the same shape with each name; if the alias diverged, one call would differ. Both run clean.\n(poly (list (list 60 60) (list 120 60) (list 90 110)) 3)\n(polygon (list (list 60 60) (list 120 60) (list 90 110)) 3)"
     :math-program "(set-mode 'sd)\n;; Same vertex list, both names — the drawn edge set is the same function of the input.\n(let ((vs (list (list 60 60) (list 120 60) (list 90 110))))\n  (poly vs 3)\n  (polygon vs 3))"
     :cs-program "(set-mode 'sd)\n(define (via-alias vs c) (poly vs c))\n(define (via-full vs c) (polygon vs c))\n;; Both wrappers close over the same operation; substitution is safe.\n(via-alias (list (list 60 60) (list 120 60) (list 90 110)) 3)\n(via-full (list (list 60 60) (list 120 60) (list 90 110)) 3)"
     :invariant "∀ points color. poly(points, color) ≡ polygon(points, color)  (the alias is observationally equal to the original)"
     :meta "The pattern is observational equivalence — two expressions are equal if no context can distinguish them. Falsified if any vertex list drew differently under poly than under polygon; that would mean the alias is not an alias but a divergent second verb. book-of-code ch 05 grounds substitution/equational reasoning; book-of-math ch-advanced-05 grounds the identity morphism that an alias instantiates."))
    (:eng "The operator can refactor poly ↔ polygon anywhere without a visual diff; the rendered frame is byte-identical." :math "poly and polygon are the same point in function space; the map between the two names is the identity." :cs "Observational equivalence under substitution; the same guarantee a compiler gives when inlining an alias.")
  :row-5-emergence (

    (:base "poly strokes a closed outline, just like polygon, in fewer keystrokes.")
    (:composition "(set-mode 'sd)\n;; A quick rocket sketched entirely with the short name: body, nose, two fins.\n(poly (list (list 150 60) (list 170 60) (list 170 150) (list 150 150)) 6)   ; body\n(poly (list (list 150 60) (list 170 60) (list 160 35)) 4)                   ; nose\n(poly (list (list 150 150) (list 135 175) (list 150 130)) 8)               ; left fin\n(poly (list (list 170 150) (list 185 175) (list 170 130)) 8)               ; right fin"
     :eng-composition "(set-mode 'sd)\n(define (sketch-shapes specs)\n  ;; A batch sketcher: each spec is (vertex-list . color); poly keeps the body terse.\n  (for-each (lambda (s) (poly (car s) (cdr s))) specs))\n(sketch-shapes (list (cons (list (list 40 40) (list 90 40) (list 65 90)) 3)\n                     (cons (list (list 110 40) (list 160 40) (list 135 90)) 6)\n                     (cons (list (list 180 40) (list 230 40) (list 205 90)) 7)))"
     :math-composition "(set-mode 'sd)\n;; Rotate one outline by copies to make a rosette; the short name suits the dense loop.\n(let ((cx 160) (cy 120))\n  (for-each (lambda (k)\n              (let ((rot (* k 0.5236)))\n                (poly (map (lambda (i)\n                             (let ((a (+ rot (* i 2.094))))\n                               (list (+ cx (* 50 (cos a))) (+ cy (* 50 (sin a))))))\n                           (iota 3))\n                      (+ 1 (modulo k 8)))))\n            (iota 12)))"
     :cs-composition "(set-mode 'sd)\n;; A turtle-style path builder that emits with poly on each closed segment.\n(define (closed-path . vs) (poly vs 'white))\n(closed-path (list 100 100) (list 200 100) (list 200 160) (list 100 160))"
     :emergent "A rocket, a batch of sketched triangles, and a twelve-fold rosette: the short alias makes dense generative and live-coded scenes readable, so the same outline primitive scales from one keystroke-saving call to a whole rotated pattern.")
    (:meta "This is the ergonomics-of-repetition family — a shorthand pays off exactly where the operation recurs. Familiar analogs are shell aliases in a scripting session, single-letter loop variables, and terse combinators in point-free code. The composition works because poly is literally polygon, so every compositional property of the full name transfers with none of the typing.")
    (:eng "The audit lens is 'brevity must not cost clarity in shipped code' — the SRE guidance is poly for sketches and hot loops, polygon for reviewed reference examples; the rendered result is the same either way." :math "Repeated application of the same aliased operation composes exactly as the original would; the alias distributes over composition." :cs "Shorthand-in-a-hot-loop; the shape of every terse binding introduced to keep a dense body legible."))
)

(verb
  :name "polygon-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(polygon-fill points [color]) -> undefined"
  :summary "Paint the solid interior of an arbitrary polygon using an even-odd scanline fill."
  :explanation "polygon-fill floods the inside of any closed vertex list — convex or concave, simple or self-intersecting — with a solid colour. The rule it uses is even-odd (also called the crossing-number rule): for each pixel, count how many polygon edges a ray from that pixel crosses; an odd count means inside, even means outside. This handles stars, arrows, gears, and letter shapes where a naive fan-from-centre would spill outside the outline. It is the general solid-shape workhorse: where triangle-fill handles the three-corner base case and ngon-fill handles regular shapes, polygon-fill takes any outline you can express as points and gives you the mass. The optional colour is trailing and defaults to the current pen. Because self-intersecting lists follow the even-odd rule, overlapping loops carve holes — the pentagram's centre stays empty."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (polygon-fill (list (list 5 5) (list 30 5) (list 20 30)) 'green)" :note "A solid green triangle expressed as a three-point list — the general fill applied to the simplest case.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A concave chevron (arrow-block) filled solid — even-odd handles the inward notch.\n(polygon-fill (list (list 100 60) (list 140 60) (list 160 100)\n                    (list 140 140) (list 100 140) (list 120 100)) 6)" :note "The inward point at (120,100) makes this concave; even-odd fills only the true interior.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A solid five-pointed star computed from ten alternating inner/outer vertices.\n(define star-pts\n  (map (lambda (i)\n         (let ((a (- (* i (/ 3.14159 5)) 1.5708))\n               (r (if (even? i) 60 24)))\n           (list (+ 160 (* r (cos a))) (+ 120 (* r (sin a))))))\n       (iota 10)))\n(polygon-fill star-pts 'yellow)" :note "Ten vertices alternating between outer radius 60 and inner radius 24 make a star; even-odd fills the five-pointed body correctly.")
  )
  :caveats ("Uses the even-odd rule: a self-intersecting outline leaves overlap regions unfilled (a pentagram is hollow at the centre)." "The list is treated as closed; do not repeat the first point at the end." "Fill covers whatever was underneath — order back-to-front for layering." "Very many vertices make the per-row crossing test costlier; the fill is O(area × edges) in the worst case.")
  :drawbacks ("Flat colour only — no gradient, texture, or pattern fill." "Even-odd differs from the non-zero winding rule; shapes designed for winding fill may look wrong." "No hole-list argument; holes must be created by self-intersection or drawn over afterward.")
  :usecases ("Solid stars, arrows, chevrons, and gear teeth." "Filled letter and glyph shapes." "Coloured regions of a filled chart or map." "Any concave solid a fan-from-centre fill would get wrong.")
  :related ("fill-poly" "polygon" "triangle-fill" "ngon-fill")
  :learn (:concept "Even-odd (crossing-number) polygon filling — deciding inside/outside by counting edge crossings, which handles concave and self-intersecting shapes." :prerequisites ("polygon" "triangle-fill") :progression "Fill a convex triangle with triangle-fill, then a concave outline with polygon-fill, then let ngon-fill build regular filled shapes from a vertex count.")
  :row-2-audit (

    (:problem "A game artist is drawing a solid gold star pickup. Filling it as a fan of triangles from the centre works for the star's body, but if the outline is ever tweaked into a concave crown shape the fan spills outside the points — they want a fill that respects any outline they draw."
     :program "(set-mode 'sd)\n(define star-pts\n  (map (lambda (i)\n         (let ((a (- (* i (/ 3.14159 5)) 1.5708)) (r (if (even? i) 55 22)))\n           (list (+ 160 (* r (cos a))) (+ 120 (* r (sin a))))))\n       (iota 10)))\n(polygon-fill star-pts 'yellow)"
     :eng-program "(set-mode 'sd)\n(define (solid-star cx cy ro ri color)\n  (polygon-fill\n    (map (lambda (i)\n           (let ((a (- (* i (/ 3.14159 5)) 1.5708)) (r (if (even? i) ro ri)))\n             (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n         (iota 10))\n    color))\n(solid-star 160 120 55 22 'yellow)"
     :math-program "(set-mode 'sd)\n;; The interior is {p : crossing-number(p) is odd}; even-odd is robust to concavity.\n(define pts (list (list 100 60) (list 140 60) (list 160 100)\n                  (list 140 140) (list 100 140) (list 120 100)))\n(polygon-fill pts 6)"
     :cs-program "(set-mode 'sd)\n(define (fill-guard pts color)\n  (if (>= (length pts) 3)\n      (polygon-fill pts color)\n      (error 'polygon-needs-three-points)))\n(fill-guard (list (list 100 60) (list 140 60) (list 120 120)) 6)"
     :explanation "eng: wrap the star vertex math into a by-centre-and-radii constructor. math: name the interior as the odd-crossing-number set. cs: guard the minimum vertex count before filling."
     :meta "triangle-fill handles only three corners, so it cannot fill a ten-vertex star in one call. A fan of triangle-fills from the centre spills outside a concave crown. ngon-fill draws a convex regular polygon, not a star. polygon-fill with even-odd is the arbitrary-solid primitive; the siblings either can't express the shape or fill outside it.")
    (:eng "The audit lens is 'does the fill stay inside a concave outline?' — the smoke test is drawing a chevron and confirming the notch stays empty, which even-odd guarantees and a centre-fan does not." :math "Even-odd: p is inside iff a ray from p crosses the boundary an odd number of times; robust to concavity and self-intersection." :cs "Scanline fill with per-row crossing sort; cost O(rows × edges), the classic polygon rasteriser."))
  :row-3-dimension (
    (:setup "Decide membership in a region by parity of boundary crossings.")
    (:rungs (
       (:domain "polygon-fill" :code "(set-mode 'sd) (polygon-fill (list (list 100 60) (list 140 60) (list 160 100) (list 140 140) (list 100 140) (list 120 100)) 6)")
       (:domain "maze"         :code "(define (inside-cell? walls-crossed) (odd? walls-crossed))\n(list (inside-cell? 1) (inside-cell? 2) (inside-cell? 3))")
       (:domain "parity"       :code "(define (jordan-inside? crossings) (odd? crossings))\n(map jordan-inside? (list 0 1 2 3 4))")))
    (:explanation "Rung 1: a pixel is filled when a ray from it crosses the polygon's edges an odd number of times. Rung 2: after passing an odd number of walls you are inside a room, an even number and you are back outside. Rung 3: the Jordan curve theorem says a simple closed curve splits the plane into inside and outside, distinguished by crossing parity. All three share the same shape — inside-ness is a parity question, decided by counting how many times a path pierces the boundary.")
    (:meta "The transfer works because 'inside means an odd number of boundary crossings' is the Jordan-curve / crossing-number invariant, independent of the region's shape. Every point-in-region test, every wall-count in a maze, and every topological inside/outside call is this parity check. Grounds in book-of-math ch-advanced-13 (topology) as the Jordan-curve / winding-parity shape.")
    (:eng "Every parity-membership substrate shares 'a boundary touched exactly on an edge is ambiguous' — the operator's fix is a consistent tie-break rule at vertices." :math "Crossing-number mod 2 is a homotopy invariant of the ray relative to the closed boundary curve." :cs "Ray-cast crossing count; the shape of every point-in-polygon and every scanline coverage test."))
  :row-4-proof (
    (:claim "The filled area computed by the shoelace formula is invariant under a cyclic shift of the vertex list: rotating which vertex is first does not change the enclosed area.")
    (:program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed)))\n            2))))\n(define sq (list (list 0 0) (list 4 0) (list 4 3) (list 0 3)))\n(define sq-rot (list (list 4 0) (list 4 3) (list 0 3) (list 0 0)))\n(display (= (shoelace sq) 12)) (newline)\n(display (= (shoelace sq) (shoelace sq-rot)))"
     :eng-program "(set-mode 'sd)\n;; Filling the same square from two different starting vertices covers the same pixels; both run.\n(polygon-fill (list (list 40 40) (list 100 40) (list 100 100) (list 40 100)) 6)\n(polygon-fill (list (list 100 100) (list 40 100) (list 40 40) (list 100 40)) 6)"
     :math-program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed))) 2))))\n(define (rotate xs) (append (cdr xs) (list (car xs))))\n(define tri (list (list 0 0) (list 6 0) (list 3 6)))\n(and (= (shoelace tri) (shoelace (rotate tri)))\n     (= (shoelace tri) (shoelace (rotate (rotate tri)))))"
     :cs-program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed))) 2))))\n(define (cyclic-invariant? pts)\n  (= (shoelace pts) (shoelace (append (cdr pts) (list (car pts))))))\n(cyclic-invariant? (list (list 0 0) (list 5 0) (list 5 4) (list 0 4)))"
     :invariant "∀ polygon P, ∀ cyclic rotation ρ. area(P) = area(ρ(P))  (the enclosed area depends on the cyclic order of vertices, not on which one is listed first)"
     :meta "The pattern is that area is a function of the cyclic sequence, not the linear one — rotating the start vertex is a relabelling that the shoelace sum absorbs. Falsified if starting the same outline at a different vertex changed the filled area; that would mean the fill depends on an arbitrary list origin. book-of-math ch-advanced-06 (calculus-integration) grounds the shoelace formula as a discrete Green's theorem; book-of-code ch 10 grounds cyclic-shift invariance."))
    (:eng "The operator can start a polygon's vertex list at whichever corner the data provides; the filled region and its area are identical." :math "The shoelace sum ½|Σ(xᵢyᵢ₊₁ − xᵢ₊₁yᵢ)| is invariant under cyclic index shift because the sum wraps." :cs "Cyclic-shift invariance; the same shape as a checksum over a ring that ignores the rotation origin.")
  :row-5-emergence (

    (:base "polygon-fill paints the solid interior of any closed outline.")
    (:composition "(set-mode 'sd)\n;; A robot: a filled body, a filled head, two eye squares, and an antenna triangle.\n(polygon-fill (list (list 120 110) (list 200 110) (list 200 190) (list 120 190)) 8)  ; body\n(polygon-fill (list (list 135 70) (list 185 70) (list 185 105) (list 135 105)) 6)     ; head\n(polygon-fill (list (list 145 82) (list 155 82) (list 155 92) (list 145 92)) 'white)  ; eye\n(polygon-fill (list (list 165 82) (list 175 82) (list 175 92) (list 165 92)) 'white)  ; eye\n(triangle-fill 155 70 165 70 160 55 3)                                                ; antenna"
     :eng-composition "(set-mode 'sd)\n(define (bar-chart heights base-y bar-w color)\n  ;; Each bar is a filled quad; the chart is a fold over the data.\n  (let loop ((hs heights) (x 40))\n    (unless (null? hs)\n      (polygon-fill (list (list x base-y) (list (+ x bar-w) base-y)\n                          (list (+ x bar-w) (- base-y (car hs))) (list x (- base-y (car hs))))\n                    color)\n      (loop (cdr hs) (+ x bar-w 10)))))\n(bar-chart (list 40 80 120 60 100) 190 25 6)"
     :math-composition "(set-mode 'sd)\n;; Approximate a filled disc by an n-gon vertex list — as n grows the polygon fills a circle.\n(define (disc-approx cx cy r n color)\n  (polygon-fill (map (lambda (i)\n                       (let ((a (* i (/ 6.2832 n))))\n                         (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n                     (iota n))\n                color))\n(disc-approx 160 120 50 24 'cyan)"
     :cs-composition "(set-mode 'sd)\n;; A letter 'L' as a concave six-vertex solid — even-odd fills the true glyph interior.\n(polygon-fill (list (list 120 60) (list 150 60) (list 150 160)\n                    (list 210 160) (list 210 190) (list 120 190)) 7)"
     :emergent "A robot, a bar chart, a polygonal disc, and a solid letter L: the same even-odd fill turns any vertex list — hand-placed, data-driven, sampled from a circle, or a concave glyph — into a recognisable solid object.")
    (:meta "This is the region-fill family — any bounded region expressible as an outline becomes a coloured mass. Familiar analogs are flood-fill in paint programs, GPU polygon rasterisation, and font-glyph rendering. The composition works because even-odd fill is outline-general, so bars, discs, glyphs, and freehand shapes all fill from the same primitive.")
    (:eng "The audit lens is 'the outline determines the fill' — an SRE probe checks the vertex list is simple (non-self-intersecting) when a solid, hole-free fill is intended, since even-odd carves holes where loops overlap." :math "The filled set is the odd-crossing region of the plane relative to the boundary; area is the shoelace integral." :cs "Even-odd scanline fill; the shape of every rasteriser that turns a boundary into a coloured region."))
)

(verb
  :name "fill-poly" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(fill-poly points [color]) -> undefined"
  :summary "Short alias of polygon-fill: solid-fill a vertex list, completing the poly/fill-poly naming pair."
  :explanation "fill-poly is polygon-fill under a shorter, verb-first name. The library gives you two aliasing pairs that mirror each other: poly is the short outline (= polygon) and fill-poly is the short solid (= polygon-fill). The verb-leading word order — fill first, then poly — reads as an imperative and pairs naturally with poly when both appear in the same sketch: 'poly this, fill-poly that'. Behaviour is identical to polygon-fill: even-odd interior, auto-closed list, trailing optional colour. Choose fill-poly when you are writing dense drawing code and want the fill call to scan as an action; choose polygon-fill in teaching text where the noun-first name reads more formally. There is one implementation; the name is the only difference."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (fill-poly (list (list 5 5) (list 30 5) (list 20 30)))" :note "The short solid-fill form: same result as polygon-fill on a three-point list.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; Pair the two short names: outline with poly, solid with fill-poly.\n(define diamond (list (list 160 60) (list 200 120) (list 160 180) (list 120 120)))\n(fill-poly diamond 6)\n(poly diamond 'white)" :note "Fill the diamond solid, then trace a white outline over it — the fill-poly/poly pair working together.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A dense loop of solid rotated triangles reads cleanly with the terse name.\n(let ((cx 160) (cy 120))\n  (for-each\n    (lambda (k)\n      (let ((rot (* k 0.5236)))\n        (fill-poly (map (lambda (i)\n                          (let ((a (+ rot (* i 2.094))))\n                            (list (+ cx (* 55 (cos a))) (+ cy (* 55 (sin a))))))\n                        (iota 3))\n                   (+ 1 (modulo k 8)))))\n    (iota 12)))" :note "Twelve solid triangles fanned around a centre; fill-poly keeps the generative body compact.")
  )
  :caveats ("fill-poly and polygon-fill are the same call — no behavioural or performance difference." "All of polygon-fill's caveats hold: even-odd rule, auto-closed list, self-intersection carves holes." "Do not mix fill-poly and polygon-fill haphazardly in one file; pick one per context for readability." "Pairs conceptually with poly (outline); keep the pairing consistent — poly/fill-poly or polygon/polygon-fill, not crossed.")
  :drawbacks ("The verb-first name is terser but slightly less discoverable by a reader scanning for 'polygon'." "Two names for one fill can fragment a codebase search." "Inherits every polygon-fill drawback: flat colour, even-odd only, no hole-list argument.")
  :usecases ("Dense generative code where the fill call recurs many times." "Sketches that pair outline (poly) with solid (fill-poly)." "Live-coding solid shapes where keystrokes matter." "Anywhere polygon-fill applies but brevity is preferred.")
  :related ("polygon-fill" "poly" "triangle-fill" "ngon-fill")
  :learn (:concept "The second aliasing pair (fill-poly = polygon-fill), mirroring poly = polygon, so outline and solid each have a long and a short name." :prerequisites ("polygon-fill" "poly") :progression "Know polygon-fill's even-odd behaviour, adopt fill-poly as its shorthand, and use it alongside poly so outline and solid share a naming style.")
  :row-2-audit (

    (:problem "An artist is layering filled shapes with outlines over them in a fast iteration loop — fill the mass, stroke the edge, repeat. They want the fill and stroke calls to read as a matched pair so the intent (solid-then-outline) is obvious at a glance."
     :program "(set-mode 'sd)\n(define shield (list (list 160 60) (list 210 90) (list 200 170) (list 160 200) (list 120 170) (list 110 90)))\n(fill-poly shield 1)\n(poly shield 'white)"
     :eng-program "(set-mode 'sd)\n(define (filled-outlined verts fill-color edge-color)\n  ;; The matched pair: solid body then crisp edge, named to read as one intent.\n  (fill-poly verts fill-color)\n  (poly verts edge-color))\n(filled-outlined (list (list 160 60) (list 210 90) (list 200 170)\n                       (list 160 200) (list 120 170) (list 110 90)) 1 'white)"
     :math-program "(set-mode 'sd)\n;; The solid is the interior set; the outline is its boundary. Same vertex list, two operations.\n(let ((verts (list (list 120 80) (list 200 80) (list 160 160))))\n  (fill-poly verts 6)\n  (poly verts 'white))"
     :cs-program "(set-mode 'sd)\n;; fill-poly is polygon-fill; substituting one for the other is safe.\n(define (solid verts color) (fill-poly verts color))\n(solid (list (list 120 80) (list 200 80) (list 160 160)) 6)"
     :explanation "eng: bundle the solid-then-outline pair into one intent-named helper. math: distinguish interior (fill-poly) from boundary (poly) over the same vertex list. cs: wrap fill-poly to show it is a transparent stand-in for polygon-fill."
     :meta "polygon-fill is the same operation with a noun-first name — correct but it does not pair as cleanly with the short poly in a body full of both. triangle-fill handles only three corners. ngon-fill draws regular shapes only. fill-poly is the terse verb-first solid that mirrors poly; the siblings are longer, narrower, or a different shape family.")
    (:eng "The audit lens is 'do the fill and stroke names read as a pair?' — the smoke test is that fill-poly and poly over the same vertex list produce a filled shape with a matching outline, no offset between them." :math "fill-poly = polygon-fill as functions; the alias is the identity relabelling on the solid-fill operation." :cs "Name aliasing paired with its outline counterpart; a zero-cost renaming resolved at lookup."))
  :row-3-dimension (
    (:setup "Give the same solid-fill operation a second, action-leading name that pairs with its outline sibling.")
    (:rungs (
       (:domain "fill-poly"   :code "(set-mode 'sd) (fill-poly (list (list 5 5) (list 30 5) (list 20 30)))")
       (:domain "paired-verbs" :code "(define pairs (list (cons 'push 'pop) (cons 'open 'close) (cons 'fill 'stroke)))\n(assq 'fill pairs)")
       (:domain "dual-op"     :code "(define (dual op) (cond ((eq? op 'interior) 'boundary) ((eq? op 'boundary) 'interior) (else 'self)))\n(list (dual 'interior) (dual 'boundary))")))
    (:explanation "Rung 1: fill-poly names the solid-interior operation to pair with poly's outline. Rung 2: interfaces expose matched verb pairs — push/pop, open/close, fill/stroke — so the two halves of an action read together. Rung 3: interior and boundary are dual operations on the same region; naming them as a pair makes the duality visible. All three share the same shape — a matched pair of operations named so that using one signals the other.")
    (:meta "The transfer works because paired naming encodes a duality: fill and stroke are the interior and boundary of one region, like push and pop are the two ends of a stack action. Every well-designed API surfaces such pairs. Grounds in book-of-code ch 10 (state-machines) as the matched-operation-pair shape and in the word-books as the antonym/complement relation.")
    (:eng "Every paired-verb substrate shares 'the pair must stay symmetric' — if poly changed but fill-poly did not, the pairing would mislead." :math "Interior and boundary are complementary operators on a region; ∂(interior) is the outline." :cs "Matched operation pair; the shape of every open/close, acquire/release, and fill/stroke API."))
  :row-4-proof (
    (:claim "fill-poly is observationally equal to polygon-fill: for any vertex list and colour, the solid region painted is identical.")
    (:program "(define (shoelace pts)\n  (let ((closed (append pts (list (car pts)))))\n    (abs (/ (fold + 0 (map (lambda (p q) (- (* (car p) (cadr q)) (* (car q) (cadr p))))\n                           closed (cdr closed))) 2))))\n;; Same vertices ⇒ same enclosed area ⇒ same filled region under either name.\n(define vs (list (list 0 0) (list 6 0) (list 6 4) (list 0 4)))\n(display (= (shoelace vs) 24)) (newline)\n(display (eq? 'fill-poly 'fill-poly))"
     :eng-program "(set-mode 'sd)\n;; Fill the same square with each name; identical pixels, both run clean.\n(fill-poly (list (list 60 60) (list 120 60) (list 120 120) (list 60 120)) 6)\n(polygon-fill (list (list 60 60) (list 120 60) (list 120 120) (list 60 120)) 6)"
     :math-program "(set-mode 'sd)\n;; One vertex list, both names — the interior set is the same function of the input.\n(let ((vs (list (list 60 60) (list 120 60) (list 90 120))))\n  (fill-poly vs 6)\n  (polygon-fill vs 6))"
     :cs-program "(set-mode 'sd)\n(define (fill-a vs c) (fill-poly vs c))\n(define (fill-b vs c) (polygon-fill vs c))\n;; Both close over the same fill; substitution changes nothing observable.\n(fill-a (list (list 60 60) (list 120 60) (list 90 120)) 6)\n(fill-b (list (list 60 60) (list 120 60) (list 90 120)) 6)"
     :invariant "∀ points color. fill-poly(points, color) ≡ polygon-fill(points, color)  (the alias is observationally equal to the original solid fill)"
     :meta "The pattern is observational equivalence, the same guarantee poly gives for polygon — two names, one operation, no context can tell them apart. Falsified if any list filled differently under fill-poly than polygon-fill; that would make the alias a divergent verb. book-of-code ch 05 grounds equational substitution; book-of-math ch-advanced-05 grounds the identity morphism the alias instantiates."))
    (:eng "The operator can swap fill-poly for polygon-fill in any code without a visual diff; the filled frame is identical." :math "fill-poly and polygon-fill are one point in function space under two labels; the map between names is the identity." :cs "Observational equivalence; the guarantee a compiler gives when inlining an alias binding.")
  :row-5-emergence (

    (:base "fill-poly paints a solid interior, just like polygon-fill, in fewer keystrokes and paired with poly.")
    (:composition "(set-mode 'sd)\n;; A flag: solid field via fill-poly, a star via a filled vertex list, a poly border.\n(fill-poly (list (list 80 70) (list 240 70) (list 240 170) (list 80 170)) 1)\n(fill-poly (map (lambda (i)\n                  (let ((a (- (* i (/ 3.14159 5)) 1.5708)) (r (if (even? i) 28 11)))\n                    (list (+ 120 (* r (cos a))) (+ 120 (* r (sin a))))))\n                (iota 10)) 'white)\n(poly (list (list 80 70) (list 240 70) (list 240 170) (list 80 170)) 'white)"
     :eng-composition "(set-mode 'sd)\n(define (tile-row y w n color)\n  ;; A run of solid diamonds filled with the terse name.\n  (for-each (lambda (i)\n              (let ((cx (+ 40 (* i w))))\n                (fill-poly (list (list cx y) (list (+ cx (/ w 2)) (+ y (/ w 2)))\n                                 (list cx (+ y w)) (list (- cx (/ w 2)) (+ y (/ w 2))))\n                           (+ 1 (modulo i 6)))))\n            (iota n)))\n(tile-row 100 40 6 0)"
     :math-composition "(set-mode 'sd)\n;; Fill then outline: the boundary is the derivative of the filled region.\n(define (solid+edge verts fill edge)\n  (fill-poly verts fill)\n  (poly verts edge))\n(solid+edge (list (list 120 70) (list 200 70) (list 210 150) (list 160 190) (list 110 150)) 6 'white)"
     :cs-composition "(set-mode 'sd)\n;; A filled crown glyph: concave outline, solid interior via even-odd.\n(fill-poly (list (list 100 160) (list 100 100) (list 130 130) (list 160 90)\n                 (list 190 130) (list 220 100) (list 220 160)) 'yellow)"
     :emergent "A flag with a white star, a row of coloured diamonds, a fill-then-outline shape, and a solid crown: the terse fill name — paired with poly for edges — builds recognisable objects and keeps dense fill-heavy scenes readable.")
    (:meta "This is the fill-and-stroke family — every drawn object is a filled region plus an optional boundary, and a good API names both halves to pair. Familiar analogs are SVG's fill/stroke attributes, Canvas fill()/stroke(), and the interior/boundary duality in topology. The composition works because fill-poly is polygon-fill, so it inherits even-odd generality while reading as an action beside poly.")
    (:eng "The audit lens is 'fill and outline must register exactly' — the SRE check is that fill-poly and poly over the same vertex list align with no sub-pixel offset, since they share the list." :math "The pair (fill-poly, poly) realises (interior, boundary) of one region; the outline is the region's topological frontier." :cs "Fill-then-stroke pipeline; the shape of every renderer that paints a mass and then its edge."))
)

(verb
  :name "star" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(star cx cy rOuter rInner points [rot] [color]) -> undefined"
  :summary "Stroke a star outline of the given point-count by alternating an outer and inner radius around a centre."
  :explanation "star draws the classic pointed-star outline without asking you to compute vertices. You give the centre (cx, cy), the outer radius rOuter (the tips), the inner radius rInner (the valleys between tips), and the number of points; it places 2·points vertices around the circle, alternating outer and inner radius, and strokes the closed outline. An optional rotation (in radians) turns the whole star, and an optional trailing colour sets the pen. The ratio rInner/rOuter controls sharpness: near 1 the star is fat and blunt, near 0 it is thin and spiky. This is the go-to for rating widgets, sheriff badges, sparkles, and any starburst where you want the shape parameterised by geometry rather than hand-placed points. It strokes only — reach for star-fill for a solid star."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (star 160 120 40 18 5 0 'yellow)" :note "A five-pointed star centred on the canvas: outer radius 40, inner 18, no rotation, yellow.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A row of rating stars, small and evenly spaced.\n(for-each\n  (lambda (i)\n    (star (+ 60 (* i 40)) 120 15 6 5 -1.5708 'yellow))\n  (iota 5))" :note "Five small stars in a row, each rotated so a point faces up (−π/2) — a five-star rating strip.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A sparkle burst: nested stars of shrinking size and shifting rotation.\n(for-each\n  (lambda (i)\n    (star 160 120 (- 60 (* i 12)) (- 28 (* i 6)) 5 (* i 0.3) (+ 1 i)))\n  (iota 5))" :note "Five concentric stars, each smaller and slightly turned, build a layered sparkle from one parameterised call.")
  )
  :caveats ("points is the number of tips, not the vertex count; the outline has 2·points vertices." "rInner should be less than rOuter; equal radii give a regular polygon, and rInner > rOuter inverts the star." "rot is optional and precedes color; to set colour without rotation you must still pass a rotation (e.g. 0)." "Outline only — the interior is untouched; use star-fill for a solid star.")
  :drawbacks ("No independent control of individual point angles — all tips are evenly spaced." "One-pixel stroke, no line width or anti-aliasing." "The star is always radially symmetric; irregular or hand-tweaked stars need polygon with a computed vertex list.")
  :usecases ("Rating widgets and score displays." "Sheriff badges, medals, and award icons." "Sparkles, twinkles, and starfield markers." "Burst and highlight effects behind an object.")
  :related ("star-fill" "ngon" "polygon" "ring")
  :learn (:concept "A star polygon as two interleaved regular point sets — outer tips and inner valleys alternating around a circle — parameterised by two radii and a point count." :prerequisites ("polygon" "ngon") :progression "Generate a star with star, fill it solid with star-fill, and compare with ngon which uses a single radius for a regular polygon.")
  :row-2-audit (

    (:problem "A UI author needs a five-star rating strip where each star sits at a fixed slot, is the same size, and points straight up. Hand-computing ten alternating vertices per star, times five stars, is exactly the kind of arithmetic that produces one lopsided star nobody notices until ship."
     :program "(set-mode 'sd)\n(for-each\n  (lambda (i) (star (+ 60 (* i 36)) 120 15 6 5 -1.5708 'yellow))\n  (iota 5))"
     :eng-program "(set-mode 'sd)\n(define (rating-strip x0 y count filled-color)\n  ;; One call per slot; size and rotation are shared so the strip is uniform.\n  (for-each (lambda (i) (star (+ x0 (* i 36)) y 15 6 5 -1.5708 filled-color))\n            (iota count)))\n(rating-strip 60 120 5 'yellow)"
     :math-program "(set-mode 'sd)\n;; Each star's tips lie on a circle of radius rOuter at angles rot + 2πk/points.\n(define (one-star cx) (star cx 120 15 6 5 -1.5708 'yellow))\n(for-each one-star (list 60 96 132 168 204))"
     :cs-program "(set-mode 'sd)\n(define (star-guard cx cy ro ri pts)\n  (if (and (> ro ri) (>= pts 2))\n      (star cx cy ro ri pts 0 'yellow)\n      (error 'bad-star-params)))\n(star-guard 160 120 40 18 5)"
     :explanation "eng: fold the slot index into a uniform per-star call. math: state that tips sit on a circle at evenly spaced angles. cs: guard rOuter > rInner and points ≥ 2 before drawing."
     :meta "polygon would force the author to compute ten alternating-radius vertices per star by hand — the very arithmetic star exists to hide. ngon uses one radius, so it draws a pentagon, not a star. star-fill would paint solid stars when only outlines are wanted here. star is the parameterised outline-star primitive; the siblings either demand manual vertices, drop the inner radius, or fill.")
    (:eng "The audit lens is 'are all stars identical and aligned?' — the smoke test is that changing rOuter in one place resizes every star uniformly, which only holds if each is one parameterised call, not hand-placed points." :math "A star's 2·points vertices are at radius rOuter (even indices) and rInner (odd indices), angle rot + kπ/points." :cs "Parameterised vertex generator plus outline stroke; O(points) vertices, one closed polyline."))
  :row-3-dimension (
    (:setup "Alternate between two levels at evenly spaced steps around a cycle.")
    (:rungs (
       (:domain "star"      :code "(set-mode 'sd) (star 160 120 40 18 5 0 'yellow)")
       (:domain "gear-teeth" :code "(define (tooth-heights n hi lo) (map (lambda (i) (if (even? i) hi lo)) (iota (* 2 n))))\n(tooth-heights 5 10 4)")
       (:domain "square-wave" :code "(define (square-wave n hi lo) (map (lambda (i) (if (even? i) hi lo)) (iota n)))\n(square-wave 8 1 -1)")))
    (:explanation "Rung 1: a star alternates outer tips and inner valleys at even angular steps. Rung 2: a gear's rim alternates tall teeth and short gaps at even steps around its circumference. Rung 3: a square wave alternates high and low at even time steps. All three share the same shape — a two-level signal sampled at regular intervals, the values toggling between a high and a low.")
    (:meta "The transfer works because a star is a two-level periodic signal wrapped onto a circle: the radius is a square-ish wave of the angle. Every alternating-level pattern — gear teeth, crenellations, a duty-cycled waveform — is the same toggle-on-a-schedule. Grounds in book-of-math ch-advanced-11 (complex-analysis) as the periodic-alternation / Fourier-square-wave shape.")
    (:eng "Every alternating-level substrate shares 'the two levels and the step count are the only knobs' — the operator's check is that tips and valleys stay evenly interleaved." :math "The radius as a function of index is a period-2 alternation; a star is that alternation sampled at 2·points angles." :cs "Two-value toggle over an index range; the shape of every square wave and every alternating pattern."))
  :row-4-proof (
    (:claim "A star with p points has p-fold rotational symmetry: rotating it by 2π/p maps every tip onto the next tip and leaves the shape unchanged.")
    (:program "(define pi 3.14159265)\n(define (tips cx cy r p rot)\n  (map (lambda (k) (let ((a (+ rot (* k (/ (* 2 pi) p)))))\n                     (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n       (iota p)))\n(define base (tips 0 0 40 5 0))\n(define turned (tips 0 0 40 5 (/ (* 2 pi) 5)))\n;; Rotating by one step reproduces the tip set (as a rotation of the list).\n(define (close? a b) (< (+ (abs (- (car a) (car b))) (abs (- (cadr a) (cadr b)))) 0.001))\n(display (close? (car turned) (cadr base)))"
     :eng-program "(set-mode 'sd)\n;; A star and the same star rotated by a full 2π/5 look identical; both run clean.\n(star 100 120 40 18 5 0 'yellow)\n(star 220 120 40 18 5 1.2566 'yellow)"
     :math-program "(define pi 3.14159265)\n(define (angle-set p rot)\n  (map (lambda (k) (modulo (round (* 1000 (+ rot (* k (/ (* 2 pi) p))))) (round (* 1000 2 pi))))\n       (iota p)))\n;; The tip angle multiset is invariant under adding one 2π/p step (mod 2π).\n(define a (angle-set 5 0))\n(define b (angle-set 5 (/ (* 2 pi) 5)))\n(display (equal? (sort a <) (sort b <)))"
     :cs-program "(define pi 3.14159265)\n(define (n-fold-symmetric? p)\n  ;; Rotating by 2π/p is a symmetry: p equal steps tile the full turn.\n  (< (abs (- (* p (/ (* 2 pi) p)) (* 2 pi))) 0.0001))\n(and (n-fold-symmetric? 5) (n-fold-symmetric? 6) (n-fold-symmetric? 8))"
     :invariant "∀ p ≥ 2. rotate(star_p, 2π/p) = star_p  (a p-pointed star is invariant under rotation by one point-step)"
     :meta "The pattern is the cyclic symmetry group Cₚ acting on the star — rotation by 2π/p is a generator that permutes the tips cyclically and fixes the shape. Falsified if rotating a p-star by 2π/p produced a visibly different figure; that would mean the tips are not evenly spaced. book-of-math ch-advanced-04 (groups-symmetry) grounds the cyclic group Cₚ; book-of-code ch 10 grounds the modular index arithmetic that realises the rotation."))
    (:eng "The operator can rotate a star by any multiple of 2π/p and get a pixel-identical figure, which is why rating stars can be aligned by a single shared rotation." :math "The star's symmetry group is the cyclic group Cₚ generated by rotation through 2π/p." :cs "Cyclic symmetry under modular rotation; the same shape as a circular buffer invariant under rotation by one slot.")
  :row-5-emergence (

    (:base "star strokes one pointed-star outline from a centre and two radii.")
    (:composition "(set-mode 'sd)\n;; A night sky: a scatter of small stars over a filled dark field.\n(polygon-fill (list (list 0 0) (list 320 0) (list 320 130) (list 0 130)) 0)\n(for-each (lambda (p) (star (car p) (cadr p) 6 2 5 0 'white))\n          (list (list 40 30) (list 90 60) (list 150 25) (list 210 70) (list 270 40) (list 300 90)))"
     :eng-composition "(set-mode 'sd)\n(define (starfield seeds size color)\n  (for-each (lambda (s) (star (car s) (cadr s) size (/ size 2.5) 5 0 color)) seeds))\n(starfield (list (list 50 50) (list 120 90) (list 200 40) (list 260 110) (list 300 70)) 7 'white)"
     :math-composition "(set-mode 'sd)\n;; A sparkle mandala: stars rotated around a shared centre at even angular offsets.\n(let ((cx 160) (cy 120))\n  (for-each (lambda (k)\n              (let ((a (* k 0.7854)))\n                (star (+ cx (* 50 (cos a))) (+ cy (* 50 (sin a))) 10 4 5 a (+ 1 (modulo k 8)))))\n            (iota 8)))"
     :cs-composition "(set-mode 'sd)\n;; A medal: a ring rim, a solid disc, and a star emblem centred in it.\n(ring 160 110 40 33 6)\n(ellipse-fill 160 110 33 33 6)\n(star 160 110 24 10 5 -1.5708 'white)\n(polygon-fill (list (list 150 145) (list 170 145) (list 175 185) (list 160 175) (list 145 185)) 1)"
     :emergent "A starry night, a scattered starfield, a rotated sparkle mandala, and a medal: the same parameterised star, scattered, rotated, or centred inside a ring and disc, composes into recognisable scenes and emblems.")
    (:meta "This is the radial-motif family — a symmetric star used as a repeated element in a field or a mandala. Familiar analogs are particle sparkle systems, starfield backgrounds in games, and radial ornament in design. The composition works because star is a self-contained parameterised element, so scattering, rotating, or nesting it needs only new centres, angles, or sizes.")
    (:eng "The audit lens is 'the field is data-driven' — an SRE probe checks the seed list length and coordinate ranges, since a starfield is only as correct as its seed positions." :math "A field of stars is a set of Cₚ-symmetric motifs placed at seed points; a mandala adds an outer Cₙ symmetry over the placements." :cs "Motif-instancing; the shape of every particle system and every tiled ornament that repeats one parameterised element."))
)

(verb
  :name "star-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(star-fill cx cy rOuter rInner points [rot] [color]) -> undefined"
  :summary "Paint a solid star of the given point-count, filling the interior spanned by the alternating radii."
  :explanation "star-fill is the solid counterpart to star: same centre, two radii, point count, optional rotation and colour — but it floods the star's interior instead of tracing its edge. Internally it builds the same 2·points alternating-radius vertex list and fills it with the even-odd rule, so the pointed body reads as one coloured mass. Reach for it when the star is the object, not an outline: a gold badge, a filled sheriff's star, a burst behind a headline, a solid rating pip. The rInner/rOuter ratio still governs sharpness, and rotation still turns the whole figure. Because the fill is even-odd on a simple star polygon, the whole star colours solid with no interior hole. Combine star-fill for the body with star for a contrasting rim to get an outlined solid star."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (star-fill 160 120 40 18 5 0.3 12)" :note "A solid five-pointed star, slightly rotated, filled in palette colour 12.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A gold badge: a solid star inside a ring rim.\n(ring 160 120 55 48 6)\n(star-fill 160 120 40 16 5 -1.5708 'yellow)" :note "A ring rim with a solid yellow star centred inside — a badge from two primitives.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A layered compass rose: a broad four-point star crossed with a narrower one.\n(star-fill 160 120 70 14 4 -1.5708 6)\n(star-fill 160 120 48 10 4 0 8)\n(ellipse-fill 160 120 8 8 'white)" :note "Two four-pointed solid stars at right angles plus a hub dot make a compass rose.")
  )
  :caveats ("points is the tip count; the filled outline has 2·points vertices." "Fill covers whatever was underneath — draw a solid star before its rim, or the rim under a bigger star will be hidden." "rot is optional and precedes color; pass 0 to set colour without rotating." "A star with rInner very close to rOuter fills almost a disc; very small rInner fills a thin spiky mass.")
  :drawbacks ("Flat single colour — no gradient or shading to suggest a raised badge." "Even-odd fill only; a self-intersecting star vertex list would carve unexpected holes." "No per-point control; all tips are uniform, so irregular stars need polygon-fill with computed vertices.")
  :usecases ("Solid badges, medals, and award stars." "Filled rating pips and score markers." "Bursts and highlights behind text or objects." "Compass-rose and emblem centres.")
  :related ("star" "polygon-fill" "ngon-fill" "ellipse-fill")
  :learn (:concept "Filling a star polygon — the alternating-radius vertex list of star, flooded solid by the even-odd rule." :prerequisites ("star" "polygon-fill") :progression "Trace a star outline with star, fill it solid with star-fill, then combine both for a solid star with a contrasting rim.")
  :row-2-audit (

    (:problem "A game needs a pickup that reads instantly as a solid gold star, even at small size and over a busy background. An outline star gets lost against clutter; the artist wants the star as a filled mass with a thin dark rim so it pops."
     :program "(set-mode 'sd)\n(star-fill 160 120 30 12 5 -1.5708 'yellow)\n(star 160 120 30 12 5 -1.5708 0)"
     :eng-program "(set-mode 'sd)\n(define (pickup cx cy size body rim)\n  ;; Solid body first, then a rim in a contrasting colour so it reads over clutter.\n  (star-fill cx cy size (* size 0.4) 5 -1.5708 body)\n  (star cx cy size (* size 0.4) 5 -1.5708 rim))\n(pickup 160 120 30 'yellow 0)"
     :math-program "(set-mode 'sd)\n;; The filled region is the interior of the alternating-radius polygon; the rim is its boundary.\n(let ((cx 160) (cy 120) (ro 30) (ri 12))\n  (star-fill cx cy ro ri 5 -1.5708 'yellow)\n  (star cx cy ro ri 5 -1.5708 0))"
     :cs-program "(set-mode 'sd)\n(define (safe-pickup cx cy size body)\n  (if (> size 4)\n      (star-fill cx cy size (* size 0.4) 5 -1.5708 body)\n      (ellipse-fill cx cy size size body)))  ; too small to read as a star — fall back to a dot\n(safe-pickup 160 120 30 'yellow)"
     :explanation "eng: paint solid body then contrasting rim so the pickup reads over clutter. math: name the fill as interior and the rim as boundary of one polygon. cs: fall back to a dot below the size where a star stops reading."
     :meta "star only outlines, so it vanishes against a busy background. polygon-fill would fill a star but demands the ten alternating vertices be computed by hand. ngon-fill fills a regular polygon, not a star. star-fill is the solid-star primitive; the siblings under-fill, over-specify, or draw the wrong shape.")
    (:eng "The audit lens is 'does the star read as a solid mass at target size?' — the smoke test is filling the body and confirming it survives being shrunk and placed over clutter, which an outline does not." :math "The filled star is the even-odd interior of the 2·points-vertex alternating-radius polygon." :cs "Interior fill of a computed star polygon; O(area) pixels via scanline crossing."))
  :row-3-dimension (
    (:setup "Flood the region bounded by a two-level alternating outline with a single value.")
    (:rungs (
       (:domain "star-fill"  :code "(set-mode 'sd) (star-fill 160 120 40 18 5 0 'yellow)")
       (:domain "territory"  :code "(define (claim-region cells owner) (map (lambda (c) (cons c owner)) cells))\n(claim-region (list 'a 'b 'c) 'blue)")
       (:domain "indicator"  :code "(define (indicator inside? value) (if inside? value 0))\n(map (lambda (p) (indicator p 1)) (list #t #f #t #t))")))
    (:explanation "Rung 1: the region inside a star's alternating outline is flooded with one colour. Rung 2: a set of map cells enclosed by a border is all claimed for one owner. Rung 3: an indicator function assigns a single value to every point inside a region and zero outside. All three share the same shape — a bounded region is assigned one uniform value across its whole interior.")
    (:meta "The transfer works because filling is applying a constant function over a region's interior — the star's colour is the value of an indicator supported on the star. Every region-labelling, territory-claim, and characteristic-function-times-value is the same fill-the-inside-with-a-constant shape. Grounds in book-of-math ch-advanced-13 (topology) as the support-of-an-indicator shape.")
    (:eng "Every region-fill substrate shares 'the boundary decides membership, the interior gets the value' — the operator's check is that no interior pixel is left unassigned." :math "A solid fill is c·1_S: the constant c times the indicator of the interior set S." :cs "Constant-over-a-region assignment; the shape of every flood-fill and every region-label pass."))
  :row-4-proof (
    (:claim "A solid star's area grows linearly with the product of its two radii: doubling either rOuter or rInner (with the other and the point count fixed) scales the area proportionally.")
    (:program "(define pi 3.14159265)\n(define (star-area ro ri p) (* p ro ri (sin (/ pi p))))\n(define base (star-area 40 20 5))\n(display (< (abs (- (star-area 80 20 5) (* 2 base))) 0.0001)) (newline)\n(display (< (abs (- (star-area 40 40 5) (* 2 base))) 0.0001))"
     :eng-program "(set-mode 'sd)\n;; A star and one with double the outer radius — the bigger covers proportionally more; both run.\n(star-fill 90 120 20 10 5 0 'yellow)\n(star-fill 220 120 40 10 5 0 'yellow)"
     :math-program "(define pi 3.14159265)\n(define (star-area ro ri p) (* p ro ri (sin (/ pi p))))\n(define (bilinear? k)\n  (and (< (abs (- (star-area (* k 40) 20 5) (* k (star-area 40 20 5)))) 0.0001)\n       (< (abs (- (star-area 40 (* k 20) 5) (* k (star-area 40 20 5)))) 0.0001)))\n(and (bilinear? 2) (bilinear? 3))"
     :cs-program "(define pi 3.14159265)\n(define (star-area ro ri p) (* p ro ri (sin (/ pi p))))\n(define (linear-in-ro? k)\n  (= (star-area (* k 40) 20 5) (* k (star-area 40 20 5))))\n(linear-in-ro? 4)"
     :invariant "∀ k > 0. area(k·rOuter, rInner, p) = k·area(rOuter, rInner, p) ∧ area(rOuter, k·rInner, p) = k·area(rOuter, rInner, p)  (star area is bilinear in the two radii)"
     :meta "The pattern is bilinearity — the star's area is p·rOuter·rInner·sin(π/p), linear in each radius separately (unlike a disc, whose area is quadratic in its single radius). Falsified if doubling one radius did not double the area; that would contradict the triangle-decomposition of the star into 2p triangles each with area ½·rOuter·rInner·sin(π/p). book-of-math ch-advanced-06 (calculus-integration) grounds the triangle-sum area; book-of-code ch 11 grounds the multiply-accumulate."))
    (:eng "The operator can size a badge's coverage by adjusting either radius and predict the fill cost linearly, which makes a size slider behave intuitively." :math "The star decomposes into 2p triangles of area ½·rOuter·rInner·sin(π/p); the total is bilinear in (rOuter, rInner)." :cs "Bilinear scaling; the same shape as a rectangle's area being linear in each side separately.")
  :row-5-emergence (

    (:base "star-fill paints one solid pointed star from a centre and two radii.")
    (:composition "(set-mode 'sd)\n;; A sheriff's badge: a solid star with a lighter inset star, on a ring.\n(ring 160 120 58 50 8)\n(star-fill 160 120 50 20 6 0 6)\n(star-fill 160 120 42 17 6 0 3)"
     :eng-composition "(set-mode 'sd)\n(define (award cx cy size)\n  ;; Body, inset highlight, and a hub — a reusable medal emblem.\n  (star-fill cx cy size (* size 0.4) 5 -1.5708 'yellow)\n  (star-fill cx cy (* size 0.8) (* size 0.32) 5 -1.5708 6)\n  (ellipse-fill cx cy (* size 0.18) (* size 0.18) 'white))\n(award 160 120 45)"
     :math-composition "(set-mode 'sd)\n;; A burst: a many-pointed thin star radiating behind a disc, like sun rays.\n(star-fill 160 120 70 8 16 0 'yellow)\n(ellipse-fill 160 120 26 26 6)"
     :cs-composition "(set-mode 'sd)\n;; A row of solid rating pips filled with a fold over slots.\n(let loop ((i 0))\n  (when (< i 5)\n    (star-fill (+ 60 (* i 40)) 120 15 6 5 -1.5708 'yellow)\n    (loop (+ i 1))))"
     :emergent "A sheriff's badge, a reusable award emblem, a sunburst, and a rating strip: the same solid star, inset, radiated, or repeated, composes into recognisable emblems and UI widgets.")
    (:meta "This is the emblem / burst family — a filled star as the core of a badge, medal, or radiant burst. Familiar analogs are heraldic charges, award ribbons, and starburst callouts in design. The composition works because star-fill is a solid self-contained motif, so nesting smaller stars, radiating thin ones, or repeating them across slots all reuse the one fill.")
    (:eng "The audit lens is 'layer order is the whole design' — an SRE probe confirms the biggest star is drawn first and highlights after, since a later fill hides an earlier one." :math "An emblem is a stack of concentric star indicators c₁·1_{S₁} over c₂·1_{S₂} …, painted back-to-front." :cs "Layered motif compositing; the shape of every badge builder that stacks filled shapes by z-order."))
)

(verb
  :name "ellipse" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ellipse cx cy rx ry [color]) -> undefined"
  :summary "Stroke an axis-aligned ellipse outline centred at (cx,cy) with horizontal radius rx and vertical radius ry."
  :explanation "ellipse traces the oval curve whose points satisfy (x−cx)²/rx² + (y−cy)²/ry² = 1. The two radii are independent: rx stretches it horizontally, ry vertically. When rx equals ry you get a circle, so ellipse doubles as your circle-outline primitive. It is the smooth-curve workhorse of the library — orbits, eyes, wheels, dials, cross-sections, and any rounded boundary. Because it is a single closed convex curve, it is the natural outline for anything organic or mechanical that is not straight-edged. It strokes only; use ellipse-fill for a solid disc or oval. The optional trailing colour defaults to the current pen. Under the hood the curve is a parametric sweep of (cx + rx·cos θ, cy + ry·sin θ) as θ runs a full turn, rasterised to pixels."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ellipse 160 120 60 30 'cyan)" :note "A wide, short ellipse outline in cyan — twice as wide as it is tall.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A simple orbit diagram: a big ellipse path with a sun and a planet on it.\n(ellipse 160 120 90 40 8)\n(ellipse-fill 160 120 9 9 'yellow)\n(ellipse-fill 250 120 5 5 6)" :note "An elliptical orbit outline with a filled sun at the centre and a small planet at one edge.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; Concentric ellipses of the same shape ratio — a ripple or contour set.\n(for-each\n  (lambda (i)\n    (ellipse 160 120 (* 12 (+ i 1)) (* 6 (+ i 1)) (+ 1 i)))\n  (iota 6))" :note "Six nested ellipses sharing a 2:1 ratio radiate outward — a contour map or a pond ripple.")
  )
  :caveats ("The ellipse is axis-aligned; there is no rotation argument, so tilted ellipses need a rotated coordinate system or a polygon approximation." "rx = ry draws a circle; the verb has no separate circle form." "Outline only — the interior is untouched; use ellipse-fill for a solid." "Very small radii degenerate toward a point or a short line; very large ones are clipped to the canvas.")
  :drawbacks ("No tilt: only horizontal/vertical major axes are expressible directly." "One-pixel stroke with no width or anti-aliasing; shallow parts of the curve show raster stepping." "No arc-length control; you cannot draw a partial ellipse with this verb (use arc for a circular partial sweep).")
  :usecases ("Orbits, wheels, and dials." "Eyes, faces, and rounded organic outlines." "Cross-sections and contour rings." "Circle outlines by setting rx = ry.")
  :related ("ellipse-fill" "arc" "ngon" "ring")
  :learn (:concept "The ellipse as a parametric curve (cx + rx·cos θ, cy + ry·sin θ) and the implicit level set of a quadratic form — the general axis-aligned oval, with the circle as the rx = ry case." :prerequisites ("arc") :progression "Draw an ellipse outline, fill it with ellipse-fill, and reach for arc when you need only part of a circular sweep.")
  :row-2-audit (

    (:problem "A dashboard author is drawing a circular gauge face and a few concentric guide rings. The rings must be perfect circles sharing a centre; typing a polygon approximation for each would give visibly faceted 'circles' at this size."
     :program "(set-mode 'sd)\n(ellipse 160 120 60 60 'white)\n(ellipse 160 120 45 45 8)\n(ellipse 160 120 30 30 8)"
     :eng-program "(set-mode 'sd)\n(define (guide-rings cx cy radii color)\n  ;; rx = ry gives true circles; one call per ring keeps the centre shared.\n  (for-each (lambda (r) (ellipse cx cy r r color)) radii))\n(ellipse 160 120 60 60 'white)\n(guide-rings 160 120 (list 45 30 15) 8)"
     :math-program "(set-mode 'sd)\n;; A circle is the ellipse with rx = ry: the level set x²+y² = r².\n(for-each (lambda (r) (ellipse 160 120 r r 8)) (list 60 45 30))"
     :cs-program "(set-mode 'sd)\n(define (ring-guard cx cy r color)\n  (if (> r 0) (ellipse cx cy r r color) (error 'nonpositive-radius)))\n(ring-guard 160 120 60 'white)"
     :explanation "eng: fold a radius list into concentric true circles sharing a centre. math: state the circle as the rx = ry ellipse (level set of x²+y²). cs: guard the radius positive before drawing."
     :meta "polygon would approximate the circle with visible facets unless you use very many vertices — wasteful and still not exact. ngon is explicitly a faceted regular polygon, not a smooth curve. arc draws only a partial circular sweep, not a full closed ring. ellipse is the smooth-closed-curve primitive; the siblings facet, partial-sweep, or over-vertex.")
    (:eng "The audit lens is 'is the curve smooth at this size?' — the smoke test is that a gauge circle shows no flat facets, which the rasterised ellipse guarantees and a low-vertex polygon does not." :math "The ellipse is {(cx+rx·cos θ, cy+ry·sin θ) : θ ∈ [0,2π)}, a smooth closed C∞ curve; the circle is the rx = ry case." :cs "Midpoint/parametric ellipse rasteriser; O(perimeter) pixels, no vertex list to build."))
  :row-3-dimension (
    (:setup "Trace the set of points at a fixed scaled distance from a centre.")
    (:rungs (
       (:domain "ellipse"   :code "(set-mode 'sd) (ellipse 160 120 60 30 'cyan)")
       (:domain "orbit"     :code "(define (orbit-point a b t) (list (* a (cos t)) (* b (sin t))))\n(map (lambda (t) (orbit-point 90 40 t)) (list 0 1.57 3.14 4.71))")
       (:domain "level-set" :code "(define (on-ellipse? x y rx ry) (< (abs (- (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry))) 1)) 0.001))\n(list (on-ellipse? 6 0 6 3) (on-ellipse? 0 3 6 3))")))
    (:explanation "Rung 1: an ellipse outline is the set of screen points at scaled unit distance from the centre. Rung 2: an orbiting body traces an ellipse over time as (a·cos t, b·sin t). Rung 3: the ellipse is the level set where the quadratic form x²/rx² + y²/ry² equals one. All three share the same shape — a closed curve defined as the constant-value contour of a scaled distance function.")
    (:meta "The transfer works because an ellipse is a level set of a quadratic form: the same object whether you sweep it parametrically over time or test it implicitly. Every orbit, every iso-contour, and every 'points at fixed scaled distance' is this level-set shape. Grounds in book-of-math ch-advanced-14 (differential-geometry) as the level-set / conic-section shape.")
    (:eng "Every level-set substrate shares 'the contour value is the one knob' — the operator's check is that scaling both radii together moves along a family of similar contours." :math "The ellipse is the 1-level set of Q(x,y) = x²/rx² + y²/ry²; parametrically it is an affine image of the unit circle." :cs "Parametric sweep or implicit contour test; the shape of every conic renderer and iso-line extractor."))
  :row-4-proof (
    (:claim "The parametric and implicit forms of an ellipse agree: every point (rx·cos θ, ry·sin θ) satisfies x²/rx² + y²/ry² = 1.")
    (:program "(define (check-point rx ry theta)\n  (let* ((x (* rx (cos theta)))\n         (y (* ry (sin theta)))\n         (q (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry)))))\n    (< (abs (- q 1)) 0.0001)))\n(display (check-point 6 3 0)) (newline)\n(display (check-point 6 3 1.5708)) (newline)\n(display (check-point 6 3 0.7854)) (newline)\n(display (check-point 6 3 2.5))"
     :eng-program "(set-mode 'sd)\n;; The stroked ellipse and a filled dot placed by the parametric formula land on the same curve.\n(ellipse 160 120 60 30 'cyan)\n(ellipse-fill (+ 160 (* 60 (cos 0.7854))) (+ 120 (* 30 (sin 0.7854))) 3 3 'red)"
     :math-program "(define (identity-holds? rx ry thetas)\n  (fold (lambda (theta acc)\n          (and acc\n               (let ((x (* rx (cos theta))) (y (* ry (sin theta))))\n                 (< (abs (- (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry))) 1)) 0.0001))))\n        #t thetas))\n(identity-holds? 6 3 (list 0 0.5 1 1.5 2 2.5 3 3.5))"
     :cs-program "(define (param-implicit-agree? rx ry n)\n  (let loop ((i 0))\n    (if (>= i n) #t\n        (let* ((theta (* i (/ 6.2832 n)))\n               (x (* rx (cos theta))) (y (* ry (sin theta)))\n               (q (+ (/ (* x x) (* rx rx)) (/ (* y y) (* ry ry)))))\n          (if (< (abs (- q 1)) 0.0001) (loop (+ i 1)) #f)))))\n(param-implicit-agree? 6 3 32)"
     :invariant "∀ θ. (rx·cos θ)²/rx² + (ry·sin θ)²/ry² = cos²θ + sin²θ = 1  (the parametric form lies exactly on the implicit ellipse)"
     :meta "The pattern is the equivalence of two representations of one curve — the parametric sweep and the implicit equation describe the same point set, reconciled by the Pythagorean identity cos²+sin²=1. Falsified if a parametric point ever missed the implicit curve; that would break the identity and mean the two forms describe different shapes. book-of-math ch-advanced-14 grounds the conic's dual descriptions; book-of-code ch 05 grounds the two-specs-of-one-thing agreement check."))
    (:eng "The operator can place markers on the ellipse with the parametric formula and trust they land on the stroked outline, because both obey the same identity." :math "The parametrisation θ ↦ (rx cos θ, ry sin θ) is a bijection onto the implicit curve; substitution reduces to cos²+sin²=1." :cs "Two-representation agreement; the same shape as a parser and a pretty-printer round-tripping one AST.")
  :row-5-emergence (

    (:base "ellipse strokes one axis-aligned oval or circle outline.")
    (:composition "(set-mode 'sd)\n;; A bicycle: two wheel circles, an ellipse frame hint, and hub dots.\n(ellipse 110 160 25 25 8)\n(ellipse 210 160 25 25 8)\n(ellipse 160 150 55 20 6)\n(ellipse-fill 110 160 4 4 0)\n(ellipse-fill 210 160 4 4 0)"
     :eng-composition "(set-mode 'sd)\n(define (target cx cy rings)\n  ;; Concentric circles alternating colour — a dartboard/target.\n  (for-each (lambda (i)\n              (ellipse cx cy (- (* 12 rings) (* 12 i)) (- (* 12 rings) (* 12 i))\n                       (if (even? i) 4 'white)))\n            (iota rings)))\n(target 160 120 5)"
     :math-composition "(set-mode 'sd)\n;; A Lissajous-ish ring set: ellipses of varying aspect share a centre.\n(for-each (lambda (i)\n            (ellipse 160 120 (+ 20 (* i 8)) (- 60 (* i 8)) (+ 1 i)))\n          (iota 6))"
     :cs-composition "(set-mode 'sd)\n;; An owl: a body ellipse, two big eye circles, filled pupils, and a triangle beak.\n(ellipse-fill 160 130 45 55 8)\n(ellipse-fill 145 110 16 16 'white)\n(ellipse-fill 175 110 16 16 'white)\n(ellipse-fill 145 110 5 5 0)\n(ellipse-fill 175 110 5 5 0)\n(triangle-fill 155 118 165 118 160 128 3)"
     :emergent "A bicycle, a target, a nested ring set, and an owl: the same oval outline — circles, wide ellipses, or concentric rings — composes wheels, dartboards, contour patterns, and a face.")
    (:meta "This is the rounded-form family — build organic and mechanical objects from ovals and circles rather than straight edges. Familiar analogs are the circle-and-line vocabulary of technical drawing, blob shapes in cartooning, and iso-contour maps. The composition works because an ellipse is a self-contained smooth closed curve, so wheels, eyes, and rings all instance the one primitive at different radii and aspect ratios.")
    (:eng "The audit lens is 'aspect ratio carries the meaning' — an SRE probe notes that swapping rx and ry rotates the visual emphasis, so the ratio is a load-bearing parameter, not decoration." :math "A scene of ellipses is a set of affine images of the unit circle, each an ellipse with its own centre and radii." :cs "Instancing a smooth primitive; the shape of every drawing built from circles and ovals at varied scale."))
)

(verb
  :name "ellipse-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ellipse-fill cx cy rx ry [color]) -> undefined"
  :summary "Paint a solid axis-aligned ellipse (or circle when rx = ry) centred at (cx,cy)."
  :explanation "ellipse-fill floods the interior of the oval x²/rx² + y²/ry² ≤ 1 with a solid colour. It is the disc primitive: set rx = ry and you get a filled circle, the single most-used solid shape in games and diagrams — balls, planets, dots, buttons, heads, wheels, bubbles. With rx ≠ ry it fills an oval for eggs, shadows, and squashed bodies. Where ellipse gives the outline, ellipse-fill gives the mass, computed as a scanline fill: for each row the horizontal extent is 2·rx·√(1 − (dy/ry)²), and that span is coloured. The optional trailing colour defaults to the current pen. This is the workhorse behind almost every round solid on the canvas; stacking a few filled circles builds snowmen, clouds, molecules, and bubbles instantly."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ellipse-fill 160 120 60 30 6)" :note "A solid wide oval filled in palette colour 6.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A snowman: three stacked filled circles of shrinking radius.\n(ellipse-fill 160 180 35 35 7)\n(ellipse-fill 160 130 25 25 7)\n(ellipse-fill 160 95 18 18 7)" :note "Three filled circles stacked vertically make a snowman body from one repeated disc.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A cluster of bubbles: filled circles of random-ish sizes at scattered centres.\n(for-each\n  (lambda (spec)\n    (ellipse-fill (car spec) (cadr spec) (caddr spec) (caddr spec) 'cyan))\n  (list (list 100 100 20) (list 140 130 14) (list 180 90 24) (list 220 140 10) (list 160 160 16)))" :note "Five filled circles at scattered centres and sizes make a bubble cluster.")
  )
  :caveats ("Axis-aligned only; rx = ry gives a circle, but a tilted oval is not expressible directly." "Fill covers whatever was underneath — draw back-to-front for correct overlap (a snowman's head after its body)." "Very small radii fill a few pixels or nothing; large radii are clipped to the canvas." "The fill is flat colour — no radial shading to suggest a sphere.")
  :drawbacks ("No tilt and no gradient; a filled ellipse always reads flat and axis-aligned." "Overlapping filled circles overdraw shared pixels on this software rasteriser." "No anti-aliasing; the disc edge is a hard raster step.")
  :usecases ("Balls, planets, dots, and buttons (rx = ry)." "Snowmen, clouds, molecules, and bubble clusters from stacked discs." "Eyes, pupils, and rounded body parts." "Shadows and squashed ovals (rx ≠ ry).")
  :related ("ellipse" "polygon-fill" "star-fill" "ring")
  :learn (:concept "Scanline filling of an ellipse — the solid disc as the row-by-row span set of x²/rx² + y²/ry² ≤ 1, with the filled circle as the rx = ry case." :prerequisites ("ellipse") :progression "Fill a disc with ellipse-fill, outline it with ellipse, and stack several to build compound round objects.")
  :row-2-audit (

    (:problem "A physics demo needs to render a bouncing ball each frame as a solid disc at its current position. An outline circle looks hollow and hard to track in motion; the author wants a filled disc placed by centre and radius, cheaply, every tick."
     :program "(set-mode 'sd)\n(define (ball x y r color) (ellipse-fill x y r r color))\n(ball 160 90 14 6)"
     :eng-program "(set-mode 'sd)\n(define (draw-ball state)\n  ;; state = (x y r color); one filled disc per frame at the current position.\n  (ellipse-fill (car state) (cadr state) (caddr state) (caddr state) (cadddr state)))\n(draw-ball (list 160 90 14 6))"
     :math-program "(set-mode 'sd)\n;; A ball is the disc {(x,y) : (x-cx)²+(y-cy)² ≤ r²}; rx = ry = r.\n(let ((cx 160) (cy 90) (r 14))\n  (ellipse-fill cx cy r r 6))"
     :cs-program "(set-mode 'sd)\n(define (ball-guard x y r color)\n  (if (> r 0) (ellipse-fill x y r r color) (error 'nonpositive-radius)))\n(ball-guard 160 90 14 6)"
     :explanation "eng: unpack a per-frame state tuple into one filled disc. math: name the ball as the disc set with rx = ry = r. cs: guard the radius positive before filling."
     :meta "ellipse gives only the outline, which reads hollow in motion. polygon-fill could fill a many-vertex circle approximation but facets at small size and wastes vertices. star-fill fills the wrong shape. ellipse-fill is the solid-disc primitive; the siblings under-fill, facet, or draw a star.")
    (:eng "The audit lens is 'is the ball a solid readable mass each frame?' — the smoke test is that the disc tracks cleanly in motion, which a filled circle does and a hollow outline does not." :math "The ball is the filled disc, the sub-level set (x-cx)²+(y-cy)² ≤ r²." :cs "Per-frame scanline disc fill; O(r²) pixels, one span per scanned row."))
  :row-3-dimension (
    (:setup "Fill every point within a scaled radius of a centre with one value.")
    (:rungs (
       (:domain "ellipse-fill" :code "(set-mode 'sd) (ellipse-fill 160 120 40 40 6)")
       (:domain "blast-radius" :code "(define (in-blast? dist radius) (<= dist radius))\n(map (lambda (d) (in-blast? d 10)) (list 3 8 10 12 20))")
       (:domain "disc"         :code "(define (in-disc? x y r) (<= (+ (* x x) (* y y)) (* r r)))\n(list (in-disc? 3 4 5) (in-disc? 4 4 5))")))
    (:explanation "Rung 1: every screen point within the scaled radius is filled with the disc's colour. Rung 2: everything within a blast radius of the centre is affected; outside it is spared. Rung 3: the disc is the set of points whose distance to the centre is at most r. All three share the same shape — a solid filled by 'everything within a radius', a sub-level set of a distance function.")
    (:meta "The transfer works because a filled disc is the sub-level set of distance ≤ r: the same object as any 'within range' region. Every blast radius, coverage circle, and neighbourhood ball is this sub-level-set-of-distance shape. Grounds in book-of-math ch-advanced-13 (topology) as the metric-ball shape.")
    (:eng "Every within-radius substrate shares 'the radius is the reach' — the operator's check is that the boundary is exactly the points at distance r, in or out by the ≤ convention." :math "The disc is the closed metric ball B(c, r) = {p : d(p,c) ≤ r}; the ellipse fill scales the metric per axis." :cs "Sub-level-set of a distance function; the shape of every range query and coverage-circle fill."))
  :row-4-proof (
    (:claim "A filled ellipse's area is π·rx·ry: it scales linearly in each radius, so a filled circle's area is π·r² and doubling one radius doubles the area.")
    (:program "(define pi 3.14159265)\n(define (ell-area rx ry) (* pi rx ry))\n(define base (ell-area 8 4))\n(display (< (abs (- (ell-area 16 4) (* 2 base))) 0.0001)) (newline)\n(display (< (abs (- (ell-area 8 8) (* 2 base))) 0.0001)) (newline)\n(display (< (abs (- (ell-area 4 4) (* pi 16))) 0.0001))"
     :eng-program "(set-mode 'sd)\n;; A disc and one with double the radius cover four times the pixels; both fills run clean.\n(ellipse-fill 90 120 15 15 6)\n(ellipse-fill 220 120 30 30 6)"
     :math-program "(define pi 3.14159265)\n(define (ell-area rx ry) (* pi rx ry))\n(define (circle-quadratic? k)\n  ;; A circle's area (rx = ry = r) is quadratic in r: scaling r by k scales area by k².\n  (< (abs (- (ell-area (* k 10) (* k 10)) (* k k (ell-area 10 10)))) 0.0001))\n(and (circle-quadratic? 2) (circle-quadratic? 3))"
     :cs-program "(define pi 3.14159265)\n(define (ell-area rx ry) (* pi rx ry))\n(define (linear-in-rx? k)\n  (< (abs (- (ell-area (* k 8) 4) (* k (ell-area 8 4)))) 0.0001))\n(and (linear-in-rx? 2) (linear-in-rx? 5))"
     :invariant "∀ k > 0. area(k·rx, ry) = k·area(rx, ry)  and  area(k·r, k·r) = k²·area(r, r)  (area is linear in each radius, so a circle's area is quadratic in its single radius)"
     :meta "The pattern is that the ellipse's area π·rx·ry is bilinear in the radii, degenerating to the circle's quadratic π·r² when rx = ry — the disc is an affine image of the unit disc, and area scales by the determinant of the scaling. Falsified if doubling a radius did not double the area; that would contradict area = π·rx·ry. book-of-math ch-advanced-06 (calculus-integration) grounds the ellipse area as an integral; book-of-code ch 11 grounds the multiply that computes it."))
    (:eng "The operator can predict fill cost from the radii — a disc twice as wide costs four times the pixels — so a size control is a quadratic cost knob for circles." :math "Area(ellipse) = π·rx·ry = det(diag(rx,ry))·π; linear per axis, quadratic when the axes scale together." :cs "Bilinear/quadratic area scaling; the same shape as a 2D array whose element count grows with the product of its dimensions.")
  :row-5-emergence (

    (:base "ellipse-fill paints one solid disc or oval.")
    (:composition "(set-mode 'sd)\n;; A snowman with a face: three body discs, two eyes, and an arc smile.\n(ellipse-fill 160 185 34 34 7)\n(ellipse-fill 160 135 24 24 7)\n(ellipse-fill 160 100 17 17 7)\n(ellipse-fill 154 96 3 3 0)\n(ellipse-fill 166 96 3 3 0)\n(arc 160 102 8 0.3 2.8 0)"
     :eng-composition "(set-mode 'sd)\n(define (molecule bonds atoms)\n  ;; bonds = list of (x1 y1 x2 y2) sticks; atoms = list of (x y r color) balls.\n  (for-each (lambda (b) (poly (list (list (car b) (cadr b)) (list (caddr b) (cadddr b))) 8)) bonds)\n  (for-each (lambda (a) (ellipse-fill (car a) (cadr a) (caddr a) (caddr a) (cadddr a))) atoms))\n(molecule (list (list 130 120 190 120))\n          (list (list 130 120 18 'red) (list 190 120 12 'white)))"
     :math-composition "(set-mode 'sd)\n;; Approximate a Gaussian blob by stacking translucent-looking concentric discs.\n(for-each (lambda (i)\n            (ellipse-fill 160 120 (- 60 (* i 10)) (- 60 (* i 10)) (+ 1 (modulo i 8))))\n          (iota 6))"
     :cs-composition "(set-mode 'sd)\n;; A traffic light: a dark case rectangle and three coloured lamp discs.\n(polygon-fill (list (list 145 50) (list 175 50) (list 175 190) (list 145 190)) 0)\n(ellipse-fill 160 75 10 10 'red)\n(ellipse-fill 160 120 10 10 'yellow)\n(ellipse-fill 160 165 10 10 'green)"
     :emergent "A snowman with a face, a molecule, a stacked blob, and a traffic light: the same filled disc — stacked, bonded, nested, or lit — composes a character, a chemistry diagram, a gradient blob, and a machine part.")
    (:meta "This is the disc-assembly family — build compound objects by stacking and placing filled circles. Familiar analogs are metaballs in graphics, ball-and-stick molecular models, and the circle-packing of dot art. The composition works because a filled disc is the atomic round solid, so snowmen, atoms, lamps, and blobs all instance it at different centres and radii.")
    (:eng "The audit lens is 'back-to-front order builds the stack' — an SRE probe confirms larger/background discs are painted before smaller/foreground ones, since a later fill hides an earlier one." :math "A disc assembly is a union of metric balls c_i·1_{B(p_i, r_i)}, composited by paint order." :cs "Disc compositing; the shape of every metaball renderer and every ball-and-stick diagram."))
)

(verb
  :name "ngon" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ngon cx cy r n [rot] [color]) -> undefined"
  :summary "Stroke a regular n-sided polygon outline inscribed in a circle of radius r about (cx,cy)."
  :explanation "ngon draws a regular polygon — n equal sides and n equal angles — with all vertices on a circle of radius r. You give the centre, the circumradius, and the side count n; it places n vertices at evenly spaced angles and strokes the closed outline. An optional rotation (radians) turns it, and an optional trailing colour sets the pen. This is the primitive for equilateral triangles (n=3), squares-as-diamonds (n=4), pentagons, hexagons, and up: as n grows the outline approaches a circle. Where polygon wants an explicit vertex list, ngon computes the regular one for you from a single radius, which is exactly what you want for symmetric tiles, gears, dice faces, and nuts-and-bolts iconography. It strokes only; ngon-fill gives the solid. The regularity — n-fold rotational symmetry — is the whole point of the verb."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ngon 160 120 40 6 0 'white)" :note "A regular hexagon outline, circumradius 40, in white.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A row of regular polygons with increasing side count: triangle to heptagon.\n(for-each\n  (lambda (i)\n    (ngon (+ 50 (* i 45)) 120 20 (+ i 3) -1.5708 (+ 1 i)))\n  (iota 5))" :note "Five regular polygons from 3 to 7 sides in a row — a shape-family strip showing n approaching a circle.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A honeycomb: offset rows of regular hexagons.\n(for-each\n  (lambda (row)\n    (for-each\n      (lambda (col)\n        (let ((x (+ 60 (* col 44) (* (modulo row 2) 22)))\n              (y (+ 60 (* row 38))))\n          (ngon x y 22 6 0 (+ 1 (modulo (+ row col) 8)))))\n      (iota 4)))\n  (iota 3))" :note "Three offset rows of hexagons tile a honeycomb — regular hexagons tessellate the plane.")
  )
  :caveats ("n is the side (and vertex) count; n must be at least 3 for a polygon." "r is the circumradius (centre to vertex), not the apothem (centre to edge midpoint); the drawn shape fits a circle of radius r." "rot is optional and precedes color; pass a rotation (e.g. 0 or −π/2 to point a vertex up) to set colour without leaving rotation defaulted." "Outline only; use ngon-fill for a solid regular polygon.")
  :drawbacks ("Only regular polygons — unequal sides or irregular angles need polygon with a computed vertex list." "One-pixel stroke, no width or anti-aliasing." "The circumradius convention means two n-gons with the same r but different n do not share an edge length; matching tiles requires care.")
  :usecases ("Hexagon and triangle tiles for board games and maps." "Dice faces, nuts, bolts, and mechanical iconography." "Stop-sign octagons and regular sign shapes." "The base outline for gears and rosettes.")
  :related ("ngon-fill" "polygon" "ellipse" "star")
  :learn (:concept "The regular n-gon as n vertices evenly spaced on a circle — n-fold rotational symmetry from a single radius and side count, approaching a circle as n grows." :prerequisites ("polygon" "ellipse") :progression "Draw a regular outline with ngon, fill it with ngon-fill, and note that a star is an ngon with two alternating radii.")
  :row-2-audit (

    (:problem "A board-game author is laying out a hex grid for a strategy map. Every cell must be a regular hexagon of the same size, evenly placed, with offset rows that interlock. Hand-listing six vertices per hex across a whole grid is where one mis-sized cell breaks the tiling."
     :program "(set-mode 'sd)\n(ngon 80 100 24 6 0 8)\n(ngon 124 100 24 6 0 8)\n(ngon 102 138 24 6 0 8)"
     :eng-program "(set-mode 'sd)\n(define (hex-grid cols rows r color)\n  ;; One ngon call per cell; shared r guarantees uniform, interlocking hexes.\n  (for-each (lambda (row)\n              (for-each (lambda (col)\n                          (let ((x (+ 50 (* col (* r 1.8)) (* (modulo row 2) (* r 0.9))))\n                                (y (+ 60 (* row (* r 1.6)))))\n                            (ngon x y r 6 0 color)))\n                        (iota cols)))\n            (iota rows)))\n(hex-grid 4 3 22 8)"
     :math-program "(set-mode 'sd)\n;; A regular hexagon's vertices are at angle 2πk/6; r is the circumradius.\n(define (hex cx cy r) (ngon cx cy r 6 0 8))\n(hex 80 100 24) (hex 124 100 24)"
     :cs-program "(set-mode 'sd)\n(define (hex-guard cx cy r n)\n  (if (>= n 3) (ngon cx cy r n 0 8) (error 'ngon-needs-three-sides)))\n(hex-guard 160 120 40 6)"
     :explanation "eng: fold row/col indices into a uniform hex grid with a shared radius. math: state the vertices as evenly spaced angles on the circumcircle. cs: guard n ≥ 3 before drawing a polygon."
     :meta "polygon would force six computed vertices per hex, times the whole grid — the arithmetic ngon exists to hide. ellipse draws a smooth curve, not a six-sided tile. star adds an inner radius the hexagon does not want. ngon is the regular-polygon primitive; the siblings demand manual vertices, curve instead of facet, or add an unwanted radius.")
    (:eng "The audit lens is 'do all cells share size and spacing?' — the smoke test is that changing r in one place resizes the whole grid uniformly, which holds only when each hex is one radius-parameterised call." :math "A regular n-gon has vertices at (cx+r·cos(rot+2πk/n), cy+r·sin(rot+2πk/n)); regularity is the equal angular spacing." :cs "Regular vertex generator plus outline stroke; O(n) vertices, one closed polyline per tile."))
  :row-3-dimension (
    (:setup "Place n items at equal angular spacing around a circle.")
    (:rungs (
       (:domain "ngon"       :code "(set-mode 'sd) (ngon 160 120 40 6 0 'white)")
       (:domain "clock-face" :code "(define (hour-angles) (map (lambda (h) (* h (/ 6.2832 12))) (iota 12)))\n(length (hour-angles))")
       (:domain "roots-of-unity" :code "(define (nth-roots n) (map (lambda (k) (list (cos (* k (/ 6.2832 n))) (sin (* k (/ 6.2832 n))))) (iota n)))\n(length (nth-roots 6))")))
    (:explanation "Rung 1: a regular hexagon's vertices sit at equal angular steps around its circumcircle. Rung 2: a clock face marks twelve positions at equal angular steps around a circle. Rung 3: the n-th roots of unity are n complex numbers evenly spaced on the unit circle. All three share the same shape — n points placed at angles 2πk/n around a centre, the discrete rotational symmetry of the circle.")
    (:meta "The transfer works because a regular n-gon's vertices ARE the n-th roots of unity (scaled and centred) — the canonical n points with n-fold rotational symmetry. Every clock face, evenly divided dial, and root-of-unity set is this equal-angular-division shape. Grounds in book-of-math ch-advanced-04 (groups-symmetry) as the cyclic-group / roots-of-unity shape.")
    (:eng "Every equal-division substrate shares 'the step is 2π/n' — the operator's check is that the n items close the full turn with no gap or overlap." :math "The vertices are r·e^{i(rot+2πk/n)} + centre; they form the orbit of one point under the cyclic group Cₙ." :cs "Equal angular partition; the shape of every clock, dial, and evenly spaced radial layout."))
  :row-4-proof (
    (:claim "A regular n-gon's interior angle is (n−2)·π/n, so the interior angles sum to (n−2)·π and each grows toward π as n increases.")
    (:program "(define pi 3.14159265)\n(define (interior-angle n) (/ (* (- n 2) pi) n))\n(display (< (abs (- (interior-angle 3) (/ pi 3))) 0.0001)) (newline)\n(display (< (abs (- (interior-angle 4) (/ pi 2))) 0.0001)) (newline)\n(define (angle-sum n) (* (- n 2) pi))\n(display (< (abs (- (angle-sum 6) (* 4 pi))) 0.0001))"
     :eng-program "(set-mode 'sd)\n;; Triangle, square, hexagon — all run; each has the predicted corner sharpness.\n(ngon 80 120 30 3 -1.5708 8)\n(ngon 160 120 30 4 -0.7854 8)\n(ngon 240 120 30 6 0 8)"
     :math-program "(define pi 3.14159265)\n(define (interior-angle n) (/ (* (- n 2) pi) n))\n(define (monotone-increasing? ns)\n  (or (null? (cdr ns))\n      (and (< (interior-angle (car ns)) (interior-angle (cadr ns)))\n           (monotone-increasing? (cdr ns)))))\n(monotone-increasing? (list 3 4 5 6 8 12))"
     :cs-program "(define pi 3.14159265)\n(define (approaches-pi? n)\n  ;; As n grows the interior angle nears π (the polygon nears a circle).\n  (< (- pi (/ (* (- n 2) pi) n)) 0.05))\n(list 'n=12 (approaches-pi? 12) 'n=100 (approaches-pi? 100))"
     :invariant "∀ n ≥ 3. interior-angle(n) = (n−2)·π/n  ∧  Σ interior angles = (n−2)·π  (and interior-angle → π as n → ∞)"
     :meta "The pattern is the angle-sum theorem for polygons — a convex n-gon triangulates into n−2 triangles, each contributing π to the interior-angle sum, giving (n−2)·π total and (n−2)·π/n per corner by regularity. Falsified if a regular n-gon's angles summed to anything but (n−2)·π; that would contradict the triangulation into n−2 triangles. book-of-math ch-advanced-13 (topology) grounds the triangulation count; book-of-code ch 05 grounds the inductive angle-sum proof."))
    (:eng "The operator can predict corner sharpness from n alone — more sides means blunter corners nearing a smooth circle — which is why high-n ngons stand in for circles." :math "Interior angle (n−2)π/n increases monotonically to π; the polygon converges to its circumcircle as n → ∞." :cs "Angle-sum-from-triangulation; the same shape as an inductive invariant proved by decomposing into base cases.")
  :row-5-emergence (

    (:base "ngon strokes one regular n-sided outline from a centre, radius, and side count.")
    (:composition "(set-mode 'sd)\n;; A stop sign: a regular octagon with an inner octagon border.\n(ngon 160 120 55 8 0.3927 'red)\n(ngon 160 120 48 8 0.3927 'white)"
     :eng-composition "(set-mode 'sd)\n(define (shape-strip x0 y r sides)\n  ;; A family strip: triangle up to sides-sided, each pointing up.\n  (for-each (lambda (i) (ngon (+ x0 (* i 45)) y r (+ i 3) -1.5708 (+ 1 i)))\n            (iota sides)))\n(shape-strip 50 120 20 5)"
     :math-composition "(set-mode 'sd)\n;; A rosette: rotated copies of one hexagon around a shared centre.\n(let ((cx 160) (cy 120))\n  (for-each (lambda (k) (ngon cx cy 40 6 (* k 0.1309) (+ 1 (modulo k 8))))\n            (iota 8)))"
     :cs-composition "(set-mode 'sd)\n;; A nut-and-bolt icon: a hex outline with a circle bore.\n(ngon 160 120 40 6 0 8)\n(ellipse 160 120 18 18 8)"
     :emergent "A stop sign, a shape-family strip, a rotated rosette, and a hex nut: the same regular-polygon outline — octagon, ascending n, rotated hexagons, or hex-with-bore — composes signage, a teaching figure, an ornament, and a mechanical icon.")
    (:meta "This is the regular-tiling / symmetry family — regular polygons tile the plane (triangles, squares, hexagons) and stack into rosettes and signage. Familiar analogs are hex maps in strategy games, tessellation art, and the regular-polygon vocabulary of signage standards. The composition works because ngon is a self-contained symmetric element, so tilings, rosettes, and icons all instance it at chosen radii, side counts, and rotations.")
    (:eng "The audit lens is 'only 3, 4, and 6 tile the plane gap-free' — an SRE probe on a tiling checks the side count is a tessellating one, since a regular pentagon leaves gaps." :math "Regular tilings exist only for n ∈ {3,4,6} because the interior angle (n−2)π/n must divide 2π evenly." :cs "Regular-element instancing; the shape of every hex grid, tessellation, and rotationally symmetric ornament."))
)

(verb
  :name "ngon-fill" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ngon-fill cx cy r n [rot] [color]) -> undefined"
  :summary "Paint a solid regular n-sided polygon inscribed in a circle of radius r about (cx,cy)."
  :explanation "ngon-fill is the solid counterpart to ngon: same centre, circumradius, side count, optional rotation and colour, but it floods the regular polygon's interior instead of tracing its edge. It builds the n evenly spaced vertices and fills them (the shape is convex, so the fill is unambiguous). Reach for it whenever a regular polygon is a coloured mass: a solid hexagon tile, a filled stop-sign octagon, a die face, a gear hub, a game token. As n grows it fills a smoother-edged disc, so a high-n ngon-fill is a faceted circle. The optional trailing colour defaults to the current pen. Because regular polygons with n ∈ {3,4,6} tessellate, filled ngons are the natural tiles for a coloured board, map, or mosaic."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ngon-fill 160 120 40 6 0.5 3)" :note "A solid hexagon, slightly rotated, filled in palette colour 3.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A solid octagon stop sign with a white inset — filled, not outlined.\n(ngon-fill 160 120 55 8 0.3927 'red)\n(ngon-fill 160 120 47 8 0.3927 'white)" :note "A red filled octagon with a smaller white one inset gives a stop-sign look.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A coloured hex board: offset rows of filled hexagons.\n(for-each\n  (lambda (row)\n    (for-each\n      (lambda (col)\n        (let ((x (+ 60 (* col 42) (* (modulo row 2) 21)))\n              (y (+ 60 (* row 36))))\n          (ngon-fill x y 20 6 0 (+ 1 (modulo (+ row col) 6)))))\n      (iota 4)))\n  (iota 3))" :note "Offset rows of solid hexagons in cycling colours make a filled honeycomb board.")
  )
  :caveats ("n must be at least 3; r is the circumradius (centre to vertex)." "Fill covers whatever was underneath — draw a larger polygon before a smaller inset one." "rot is optional and precedes color; pass a rotation to set colour without leaving rotation defaulted." "A high-n fill approximates a disc but with visible facets at small n; use ellipse-fill for a true circle.")
  :drawbacks ("Regular convex fills only; irregular or concave solids need polygon-fill." "Flat single colour — no gradient to suggest a bevel or a raised tile." "Overlapping filled tiles overdraw shared pixels; matching edges between different-n tiles needs care.")
  :usecases ("Filled hexagon and triangle tiles for coloured boards and maps." "Solid stop-sign octagons and filled sign shapes." "Die faces, game tokens, and gear hubs." "Faceted disc stand-ins at high n.")
  :related ("ngon" "polygon-fill" "ellipse-fill" "star-fill")
  :learn (:concept "Filling a regular polygon — the convex n-vertex shape of ngon flooded solid, tessellating the plane for n ∈ {3,4,6}." :prerequisites ("ngon" "polygon-fill") :progression "Outline a regular polygon with ngon, fill it with ngon-fill, and tile filled hexagons to cover a board.")
  :row-2-audit (

    (:problem "A strategy-game renderer needs to colour each hex cell by its terrain type — green for grass, blue for water — as a solid fill that reads at a glance. Outlined hexes force the player to infer terrain from a label; the author wants the cell itself coloured."
     :program "(set-mode 'sd)\n(ngon-fill 100 100 24 6 0 'green)\n(ngon-fill 148 100 24 6 0 6)\n(ngon-fill 124 138 24 6 0 'green)"
     :eng-program "(set-mode 'sd)\n(define (terrain-hex cx cy r terrain)\n  ;; Map terrain symbol to colour, then fill the cell solid.\n  (let ((color (cond ((eq? terrain 'grass) 'green)\n                     ((eq? terrain 'water) 6)\n                     ((eq? terrain 'sand) 'yellow)\n                     (else 8))))\n    (ngon-fill cx cy r 6 0 color)))\n(terrain-hex 100 100 24 'grass)\n(terrain-hex 148 100 24 'water)"
     :math-program "(set-mode 'sd)\n;; The filled cell is the convex hull of the six vertices, flooded solid.\n(define (cell cx cy r color) (ngon-fill cx cy r 6 0 color))\n(cell 100 100 24 'green) (cell 148 100 24 6)"
     :cs-program "(set-mode 'sd)\n(define (cell-guard cx cy r n color)\n  (if (>= n 3) (ngon-fill cx cy r n 0 color) (error 'ngon-needs-three-sides)))\n(cell-guard 160 120 30 6 'green)"
     :explanation "eng: map a terrain symbol to a colour, then fill the hex solid. math: name the fill as the flooded convex hull of the vertices. cs: guard n ≥ 3 before filling."
     :meta "ngon only outlines, leaving the cell uncoloured. polygon-fill could fill a computed hexagon but demands the six vertices be listed by hand per cell. ellipse-fill fills a disc, which does not tessellate into a gap-free board. ngon-fill is the solid-regular-tile primitive; the siblings under-fill, over-specify, or fail to tessellate.")
    (:eng "The audit lens is 'does the cell colour read the terrain?' — the smoke test is that each hex's fill colour maps to its terrain, which a solid fill shows directly and an outline does not." :math "The filled cell is the flooded interior of the regular hexagon, a convex region tiling the plane." :cs "Convex-polygon scanline fill; O(area) pixels per cell, one span per row."))
  :row-3-dimension (
    (:setup "Assign one uniform value to every point of a regular, tessellating cell.")
    (:rungs (
       (:domain "ngon-fill"   :code "(set-mode 'sd) (ngon-fill 160 120 40 6 0 'green)")
       (:domain "map-region"  :code "(define (color-region cells terrain->color terrain) (map (lambda (c) (cons c (terrain->color terrain))) cells))\n(color-region (list 'h1 'h2) (lambda (t) (if (eq? t 'grass) 'green 'blue)) 'grass)")
       (:domain "partition"   :code "(define (assign-class point boundary) (if (< point boundary) 'A 'B))\n(map (lambda (p) (assign-class p 5)) (list 2 5 8))")))
    (:explanation "Rung 1: every point of a regular hex cell is filled with the terrain's colour. Rung 2: each map region is assigned a single colour by its class. Rung 3: a partition assigns every point to exactly one class by a decision rule. All three share the same shape — a tessellating region assigned one uniform label across its whole extent, the cells partitioning the space.")
    (:meta "The transfer works because a filled tessellation is a partition of the plane into labelled cells — each cell one colour, cells covering everything without overlap. Every choropleth map, region-labelled image, and space partition is this partition-into-labelled-cells shape. Grounds in book-of-math ch-advanced-13 (topology) as the tessellation / partition shape.")
    (:eng "Every tessellation substrate shares 'cells must cover without gaps or overlap' — the operator's check is that adjacent filled cells share edges cleanly." :math "A regular tessellation partitions ℝ² into congruent cells; for n ∈ {3,4,6} the cells fit gap-free." :cs "Space partition with per-cell labels; the shape of every choropleth and every grid-colouring pass."))
  :row-4-proof (
    (:claim "A regular n-gon's filled area is (1/2)·n·r²·sin(2π/n): it scales as r² (quadratic in the circumradius) and increases toward the circle area π·r² as n grows.")
    (:program "(define pi 3.14159265)\n(define (ngon-area r n) (* 0.5 n r r (sin (/ (* 2 pi) n))))\n(define base (ngon-area 10 6))\n(display (< (abs (- (ngon-area 20 6) (* 4 base))) 0.001)) (newline)\n(define hex (ngon-area 10 6))\n(display (< (- (* pi 100) hex) (* pi 100)))"
     :eng-program "(set-mode 'sd)\n;; A hexagon and one with double the radius cover four times the area; both fills run.\n(ngon-fill 90 120 15 6 0 3)\n(ngon-fill 220 120 30 6 0 3)"
     :math-program "(define pi 3.14159265)\n(define (ngon-area r n) (* 0.5 n r r (sin (/ (* 2 pi) n))))\n(define (quadratic-in-r? k n)\n  (< (abs (- (ngon-area (* k 10) n) (* k k (ngon-area 10 n)))) 0.001))\n(and (quadratic-in-r? 2 6) (quadratic-in-r? 3 6) (quadratic-in-r? 2 8))"
     :cs-program "(define pi 3.14159265)\n(define (ngon-area r n) (* 0.5 n r r (sin (/ (* 2 pi) n))))\n(define (approaches-circle? n)\n  ;; The n-gon area nears π·r² as n grows.\n  (< (- (* pi 100) (ngon-area 10 n)) 3))\n(list 'n=12 (approaches-circle? 12) 'n=64 (approaches-circle? 64))"
     :invariant "∀ n ≥ 3, k > 0. area(k·r, n) = k²·area(r, n)  ∧  area(r, n) → π·r² as n → ∞  (area is quadratic in the circumradius and converges to the disc area)"
     :meta "The pattern is the polygon area as a sum of n isosceles triangles, each of area ½·r²·sin(2π/n), giving ½·n·r²·sin(2π/n); as n → ∞ the sin term makes it converge to π·r², the disc area (the classical exhaustion argument). Falsified if the n-gon area did not approach π·r² for large n; that would break Archimedes' method of exhaustion. book-of-math ch-advanced-06 (calculus-integration) grounds the exhaustion limit; book-of-code ch 11 grounds the triangle-sum multiply-accumulate."))
    (:eng "The operator can predict fill cost as r² and know a high-n tile costs about as much as a disc, which is why ngon-fill at large n is a drop-in faceted circle." :math "Area = ½·n·r²·sin(2π/n) → π·r² by Archimedean exhaustion as n → ∞." :cs "Quadratic area with a convergent limit; the same shape as a Riemann sum approaching its integral.")
  :row-5-emergence (

    (:base "ngon-fill paints one solid regular polygon from a centre, radius, and side count.")
    (:composition "(set-mode 'sd)\n;; A gear: a filled hex hub, a ring rim, and an outer toothed n-gon outline.\n(ngon 160 120 55 16 0 8)\n(ring 160 120 45 38 8)\n(ngon-fill 160 120 16 6 0 6)"
     :eng-composition "(set-mode 'sd)\n(define (hex-board cols rows r colors)\n  ;; A filled hex board; each cell coloured by a cycling palette.\n  (for-each (lambda (row)\n              (for-each (lambda (col)\n                          (let ((x (+ 55 (* col (* r 1.9)) (* (modulo row 2) (* r 0.95))))\n                                (y (+ 55 (* row (* r 1.6)))))\n                            (ngon-fill x y r 6 0 (list-ref colors (modulo (+ row col) (length colors))))))\n                        (iota cols)))\n            (iota rows)))\n(hex-board 4 3 20 (list 3 6 'yellow))"
     :math-composition "(set-mode 'sd)\n;; A faceted disc: as n rises the filled polygon fills a smoother circle.\n(ngon-fill 90 120 35 5 -1.5708 6)\n(ngon-fill 220 120 35 20 0 6)"
     :cs-composition "(set-mode 'sd)\n;; A die face: a rounded square token with pips.\n(ngon-fill 160 120 50 4 0.7854 'white)\n(ellipse-fill 145 105 4 4 0)\n(ellipse-fill 160 120 4 4 0)\n(ellipse-fill 175 135 4 4 0)"
     :emergent "A gear, a coloured hex board, a low-n-vs-high-n disc pair, and a die face: the same solid regular polygon — as a hub, a tiled board, a faceted circle, or a token — composes a machine part, a game map, a shape-convergence demo, and a die.")
    (:meta "This is the tessellation-fill family — cover a board with congruent coloured cells or build parts from regular solids. Familiar analogs are choropleth hex maps, mosaic tiling, and the regular-solid tokens of board games. The composition works because ngon-fill is a self-contained solid tile, so boards, hubs, and tokens all instance it at chosen radii, side counts, and colours.")
    (:eng "The audit lens is 'the palette maps to state' — an SRE probe checks each cell's colour reflects its data value, since a filled board communicates entirely through colour." :math "A filled board is a labelled tessellation; each cell is a constant-colour regular polygon covering its patch of the plane." :cs "Coloured tessellation; the shape of every hex-map renderer and every mosaic fill."))
)

(verb
  :name "ring" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(ring cx cy rOuter rInner [color]) -> undefined"
  :summary "Outline an annulus about (cx,cy): a pair of concentric circles at radii rOuter and rInner."
  :explanation "ring draws the boundary of an annulus — the flat washer shape between two concentric circles sharing the centre (cx,cy). You give the outer radius and the inner radius; ring strokes both circles, leaving the band between them framed. It is the go-to for anything with a hole through the middle drawn as pure outline: a washer, a donut rim, a dartboard band, a pupil-and-iris, an O. Unlike drawing two separate circles by hand, ring ties the two radii to one centre so they stay concentric by construction. The optional trailing colour sets the pen for both circles; omit it to use the current pen. ring outlines only — to flood the band solid you draw a filled outer disc and punch it, or fill the two radii yourself. Its defining property is that every stroked point lies at exactly rOuter or rInner from the centre."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (ring 160 120 50 30 8)" :note "A single annulus: an outer circle of radius 50 and an inner one of radius 30, sharing a centre.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A dartboard: three concentric bands from three rings.\n(ring 160 120 60 45 8)\n(ring 160 120 45 30 'red)\n(ring 160 120 30 15 8)" :note "Nested rings at descending radii make the banded look of a dartboard.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; Ripples: concentric rings of decreasing thickness fanning out from a point.\n(for-each\n  (lambda (k)\n    (let ((ro (+ 12 (* k 12))))\n      (ring 160 120 ro (- ro 3) 6)))\n  (iota 5))" :note "A loop of rings at growing radii draws water ripples spreading from a centre.")
  )
  :caveats ("rOuter must exceed rInner or the band collapses; ring does not check the order for you." "It strokes two circle outlines, not a solid band — the interior between them is left unfilled." "The optional colour is the last argument and applies to both circles; there is no per-circle colour." "The band's visible thickness is rOuter − rInner in pixels; a tiny gap reads as a single thick circle.")
  :drawbacks ("Circular annulus only — no elliptical or squashed ring; use two ellipse calls for that." "No fill option; a solid washer needs a filled disc with a punched hole drawn over it." "Two full-circle strokes cost roughly twice a single circle, which matters in tight loops of many rings.")
  :usecases ("Washers, gaskets, and donut rims in mechanical iconography." "Dartboard, target, and gauge bands." "Ripple and shockwave effects as expanding concentric outlines." "Eye pupil-and-iris and letter-O glyph outlines.")
  :related ("ellipse" "ngon" "arc" "ellipse-fill")
  :learn (:concept "The annulus — the region between two concentric circles, drawn as a paired outline from one centre and two radii." :prerequisites ("ellipse") :progression "Draw a circle with ellipse, add a concentric inner circle to make a ring, then nest rings to band a target.")
  :row-2-audit (

    (:problem "A gauge widget needs a fixed circular track that a coloured needle sweeps over. The author wants the empty track drawn once as a clean band — an outer and inner arc of the dial — so the needle reads against a stable frame, not a smear of hand-placed circles that drift out of concentric."
     :program "(set-mode 'sd)\n(ring 160 130 60 48 8)"
     :eng-program "(set-mode 'sd)\n(define (gauge-track cx cy r width color)\n  ;; One centre, one width — the track can never drift out of concentric.\n  (ring cx cy r (- r width) color))\n(gauge-track 160 130 60 12 8)"
     :math-program "(set-mode 'sd)\n;; The track is the annulus {p : rInner <= |p - c| <= rOuter}; ring strokes its boundary.\n(ring 160 130 60 48 8)"
     :cs-program "(set-mode 'sd)\n(define (track cx cy ro ri color)\n  (if (> ro ri) (ring cx cy ro ri color) (error 'ring-outer-must-exceed-inner)))\n(track 160 130 60 48 8)"
     :explanation "eng: derive the inner radius from one width so the band stays concentric. math: name the track as the annulus between two radii. cs: guard rOuter > rInner before stroking."
     :meta "Two hand-placed ellipse calls could draw the same two circles, but nothing binds them to a shared centre — an edit to one radius silently breaks concentricity. arc draws only part of a circle, not a closed band. ellipse-fill floods a disc with no hole. ring is the concentric-pair primitive: it enforces the shared centre the siblings leave to the author to maintain.")
    (:eng "The audit lens is 'is the band concentric and constant-width?' — the smoke test is that outer and inner circles share a centre, which ring guarantees and two loose ellipse calls do not." :math "The track is the annulus, the set of points whose distance from the centre lies in [rInner, rOuter]; ring strokes its two bounding circles." :cs "Two circle-rasterisations sharing a centre; O(rOuter) boundary pixels, concentricity fixed at the call site."))
  :row-3-dimension (
    (:setup "Bound a region by two thresholds on one scalar field radiating from a centre.")
    (:rungs (
       (:domain "ring"        :code "(set-mode 'sd) (ring 160 120 50 30 8)")
       (:domain "temperature zone (a metaphor)" :code "(define (in-comfort-band? temp) (and (>= temp 68) (<= temp 74))) (list (in-comfort-band? 71) (in-comfort-band? 80))")
       (:domain "distance-field band (the math)" :code "(define (annulus? d ri ro) (and (>= d ri) (<= d ro))) (list (annulus? 40 30 50) (annulus? 20 30 50))")))
    (:explanation "Rung 1: ring paints the two boundaries of a distance band. Rung 2: a thermostat's comfort zone is a band between a low and a high threshold on temperature. Rung 3: the annulus predicate accepts a distance falling between two radii. All three share the shape 'a value lies between a lower and an upper bound on one scalar' — a closed interval on a single measure.")
    (:meta "The transfer works because an annulus is a closed interval [rInner, rOuter] lifted onto the radial distance field: a point is in the ring exactly when its distance falls in that interval, the same set-membership test as any low-and-high band. book-of-math ch-advanced-02 (real-analysis) grounds the interval / band shape.")
    (:eng "Every band substrate shares 'inside iff between a low and a high bound' — the operator checks both thresholds are set and ordered." :math "An annulus is the preimage of a closed interval [rInner, rOuter] under the distance-to-centre map." :cs "A range test on one scalar; the shape of every hysteresis band and every interval filter."))
  :row-4-proof (
    (:claim "The area enclosed by a ring is π·(rOuter² − rInner²): the outer disc's area minus the inner disc's, so it depends only on the difference of squared radii, not on where the hole sits.")
    (:program "(define pi 3.14159265)\n(define (ring-area ro ri) (* pi (- (* ro ro) (* ri ri))))\n(display (< (abs (- (ring-area 50 30) (- (* pi 2500) (* pi 900)))) 0.001))"
     :eng-program "(set-mode 'sd)\n;; A radius-50/30 washer and a radius-40/0 disc enclose the same area; both draw.\n(ring 90 120 50 30 8)\n(ellipse 220 120 40 40 8)"
     :math-program "(define pi 3.14159265)\n(define (ring-area ro ri) (* pi (- (* ro ro) (* ri ri))))\n(define (area-is-difference-of-discs? ro ri)\n  (< (abs (- (ring-area ro ri) (- (* pi ro ro) (* pi ri ri)))) 0.001))\n(and (area-is-difference-of-discs? 50 30) (area-is-difference-of-discs? 60 15))"
     :cs-program "(define pi 3.14159265)\n(define (ring-area ro ri) (* pi (- (* ro ro) (* ri ri))))\n;; Widening the outer radius by the same amount adds more area than widening the inner, since area grows with r.\n(display (> (- (ring-area 51 30) (ring-area 50 30)) (- (ring-area 50 29) (ring-area 50 30))))"
     :invariant "∀ rOuter > rInner ≥ 0. area(ring) = π·rOuter² − π·rInner² = π·(rOuter² − rInner²)  (the annulus area is the difference of the two disc areas)"
     :meta "The pattern is additivity of area under set difference: the annulus is the outer disc minus the inner disc, so its area is the difference of their areas. Falsified if the ring area depended on the centre position or on rInner and rOuter separately rather than through their squares; that would break the translation-invariance of area. book-of-math ch-advanced-06 (calculus-integration) grounds the disc area, ch-advanced-13 the set-difference of measures."))
    (:eng "The operator can size a washer's material by rOuter² − rInner² and know two rings of equal squared-radius-difference use equal ink." :math "area = π·(rOuter² − rInner²), the outer disc minus the inner — additive under set difference." :cs "A constant-time area from two squarings and a subtract; the shape of every donut-mask cost estimate.")
  :row-5-emergence (

    (:base "ring paints one annulus — a pair of concentric circles bounding a band.")
    (:composition "(set-mode 'sd)\n;; A target: alternating rings around a solid bullseye.\n(ring 160 120 55 42 8)\n(ring 160 120 42 29 'red)\n(ring 160 120 29 16 8)\n(ellipse-fill 160 120 14 14 'red)"
     :eng-composition "(set-mode 'sd)\n(define (gauge cx cy r ticks)\n  ;; A dial: a ring track plus radial ticks around it.\n  (ring cx cy r (- r 10) 8)\n  (for-each\n    (lambda (k)\n      (let* ((a (* k (/ 6.28318 ticks)))\n             (x1 (+ cx (* (- r 10) (cos a)))) (y1 (+ cy (* (- r 10) (sin a))))\n             (x2 (+ cx (* r (cos a))))       (y2 (+ cy (* r (sin a)))))\n        (polygon (list (list x1 y1) (list x2 y2)) 8)))\n    (iota ticks)))\n(gauge 160 120 55 12)"
     :math-composition "(set-mode 'sd)\n;; An eye: an iris ring around a filled pupil, on a white sclera disc.\n(ellipse-fill 160 120 45 30 'white)\n(ring 160 120 22 12 6)\n(ellipse-fill 160 120 11 11 0)"
     :cs-composition "(set-mode 'sd)\n;; Shockwave frames: concentric rings at growing radii, thinning as they spread.\n(for-each\n  (lambda (k)\n    (let ((ro (+ 14 (* k 14))))\n      (ring 160 120 ro (- ro (- 5 k)) 6)))\n  (iota 4))"
     :emergent "A target, a ticked gauge, an eye, and a spreading shockwave: the same annulus — as a scoring band, a dial track, an iris, or a ripple front — composes an archery face, an instrument, an eye, and an expanding wave.")
    (:meta "This is the concentric-band family — everything built by nesting or growing annuli around a shared centre. Familiar analogs are tree rings, ripples on water, radar sweeps, and the bands of a planetary ring. The composition works because ring is a self-similar unit that only needs a centre and two radii, so stacking it at different radii yields targets, dials, eyes, and waves with no new machinery.")
    (:eng "The audit lens is 'do the bands stay concentric as they scale?' — an operator animating ripples checks each frame's rings share the emitter's centre so the wave looks circular." :math "A concentric-band figure is a nested family of annuli sharing a centre, partitioning an offset range of the radial field." :cs "Radius-parametrised instancing of one ring unit; the shape of every radial-gauge and ripple renderer."))
)

(verb
  :name "arc" :std "Motoi"
  :library "draw"
  :kind "meta"
  :signature "(arc cx cy r a0 a1 [color]) -> undefined"
  :summary "Stroke a circular arc of radius r about (cx,cy), sweeping from angle a0 to angle a1 in radians."
  :explanation "arc traces part of a circle: the points at radius r from (cx,cy) whose angle runs from a0 to a1, measured in radians. Where ellipse closes a full loop, arc gives you just a slice of that loop — a curved segment, a smile, a rainbow band, a gauge sweep, a pac-man mouth's edge. Angles follow the usual convention: 0 points along +x, and the sweep advances by increasing angle. A full turn is 2π ≈ 6.2832, a half-circle is π ≈ 3.1416, a quarter is π/2. The optional trailing colour sets the pen; omit it for the current one. arc strokes the curve only — it does not draw the two radii to the endpoints, so it is an open curve, not a filled wedge. Its essence is that every stroked point sits at exactly radius r and at some angle in [a0, a1]: a controlled slice of a circle's boundary."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (arc 160 120 40 0 3.14159 11)" :note "A half-circle: an arc of radius 40 swept from angle 0 to π (a rainbow shape).")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n;; A smiley face: two dot eyes and an upturned arc mouth.\n(ellipse-fill 145 105 5 5 0)\n(ellipse-fill 175 105 5 5 0)\n(arc 160 115 25 0.4 2.74 0)" :note "A short arc under two dots reads as a smiling mouth; the sweep sets how wide the smile is.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n;; A sunburst: short arc rays fanned evenly around a centre.\n(for-each\n  (lambda (k)\n    (let ((a (* k 0.7854)))\n      (arc 160 120 46 a (+ a 0.18) 'yellow)))\n  (iota 8))" :note "Eight short arcs spaced by π/4 around the centre make a radiating sunburst.")
  )
  :caveats ("Angles are in radians, not degrees — π ≈ 3.1416 is a half-turn, not 180." "The sweep runs from a0 to a1 by increasing angle; if a1 < a0 the arc may be empty or wrap unexpectedly." "arc strokes the curve only, not the radii to its endpoints — it is not a pie wedge." "Angle 0 points along +x and positive angles advance in screen order; a smile and a frown differ by which side the sweep sits on.")
  :drawbacks ("Circular arcs only — no elliptical or squashed arc; those need a parametric point loop." "Open curve with no fill and no end-caps drawn; a solid sector must add its own radii and fill." "Very short arcs at small radius can read as a single dot; sweep and radius together set visible length.")
  :usecases ("Smiles, frowns, and mouth curves in faces." "Rainbows, gauge sweeps, and progress dials." "Pac-man mouths, moon crescents, and speech-bubble tails." "Sunburst rays and radial tick fans.")
  :related ("ellipse" "ring" "star" "ngon")
  :learn (:concept "The circular arc — a bounded slice of a circle's boundary, given by a centre, a radius, and a start and end angle in radians." :prerequisites ("ellipse") :progression "Draw a full circle with ellipse, cut it to a half with arc from 0 to π, then fan short arcs to build a sunburst.")
  :row-2-audit (

    (:problem "A loading widget needs a progress ring that fills clockwise as a job runs — 0% is an empty track, 100% a full circle, and 40% is a 0.4-of-a-turn sweep. The author needs to draw exactly the swept fraction of a circle, not a full loop and not a straight bar."
     :program "(set-mode 'sd)\n(arc 160 120 45 -1.5708 (+ -1.5708 (* 0.4 6.28318)) 6)"
     :eng-program "(set-mode 'sd)\n(define (progress-arc cx cy r frac color)\n  ;; Start at the top (-π/2) and sweep frac of a full turn.\n  (let ((start -1.5708))\n    (arc cx cy r start (+ start (* frac 6.28318)) color)))\n(progress-arc 160 120 45 0.4 6)"
     :math-program "(set-mode 'sd)\n;; The filled fraction is the arc subtending angle frac·2π from the start.\n(define tau 6.28318)\n(arc 160 120 45 -1.5708 (+ -1.5708 (* 0.4 tau)) 6)"
     :cs-program "(set-mode 'sd)\n(define (progress cx cy r frac color)\n  (let ((f (max 0 (min 1 frac))))\n    (arc cx cy r -1.5708 (+ -1.5708 (* f 6.28318)) color)))\n(progress 160 120 45 0.4 6)"
     :explanation "eng: start at the top and sweep frac of a turn. math: the arc subtends angle frac·2π. cs: clamp frac to [0,1] before mapping it to a sweep."
     :meta "ellipse draws the whole loop, so it cannot show a partial fraction. A polygon bar could show progress but loses the circular dial affordance the design wants. ring frames a full band, not a swept portion. arc is the partial-circle primitive: it draws exactly the angular slice progress demands, which the closed siblings cannot express.")
    (:eng "The audit lens is 'does the sweep match the fraction?' — the smoke test is that frac=0 draws nothing and frac=1 closes the full circle, with the arc length scaling linearly between." :math "The arc subtends a central angle a1 − a0; its length is r·(a1 − a0), proportional to the swept fraction of the turn." :cs "A parametric curve sampled over [a0, a1]; O(r·Δangle) boundary pixels, the sweep clamped to a valid range."))
  :row-3-dimension (
    (:setup "Take a bounded run of one cyclic parameter and realise only that slice of a periodic whole.")
    (:rungs (
       (:domain "arc"          :code "(set-mode 'sd) (arc 160 120 40 0 3.14159 11)")
       (:domain "clock hours (a metaphor)" :code "(define (hours-elapsed start end) (- end start)) (list (hours-elapsed 9 14) (hours-elapsed 0 12))")
       (:domain "angular interval (the math)" :code "(define (subtended a0 a1) (- a1 a0)) (define pi 3.14159265) (list (subtended 0 pi) (subtended 0 (* 2 pi)))")))
    (:explanation "Rung 1: arc realises the circle's boundary only over [a0, a1]. Rung 2: a stretch of a clock face from 9 to 2 is a slice of the twelve-hour cycle. Rung 3: the subtended angle a1 − a0 is the measure of the angular interval. All three share the shape 'a bounded sub-interval of a periodic whole' — a window on a cycle.")
    (:meta "The transfer works because an arc is an interval on the circle group: angle is a cyclic coordinate, and picking [a0, a1] selects one slice of the full 2π period, exactly as choosing a span of hours selects a slice of the clock cycle. book-of-math ch-advanced-08 (trigonometry) grounds the angle-as-cyclic-coordinate shape.")
    (:eng "Every cyclic-slice substrate shares 'pick a start and an end on a repeating dial' — the operator checks the endpoints lie in one period and are ordered." :math "An arc is a connected sub-interval of the circle S¹, parametrised by an angular interval [a0, a1]." :cs "A windowed sample of a periodic function; the shape of every gauge sweep and every phase-window filter."))
  :row-4-proof (
    (:claim "A circular arc's length is r·(a1 − a0): it is directly proportional to both the radius and the swept angle, and a full-turn arc (a1 − a0 = 2π) has length 2π·r, the circle's circumference.")
    (:program "(define pi 3.14159265)\n(define (arc-len r a0 a1) (* r (- a1 a0)))\n(display (< (abs (- (arc-len 40 0 (* 2 pi)) (* 2 pi 40))) 0.001))"
     :eng-program "(set-mode 'sd)\n;; A half-turn arc at radius 40 and a full circle at radius 20 have the same length; both draw.\n(arc 90 120 40 0 3.14159 8)\n(arc 220 120 20 0 6.28318 8)"
     :math-program "(define pi 3.14159265)\n(define (arc-len r a0 a1) (* r (- a1 a0)))\n(define (proportional? r k a0 a1)\n  (< (abs (- (arc-len (* k r) a0 a1) (* k (arc-len r a0 a1)))) 0.001))\n(and (proportional? 40 2 0 pi) (proportional? 30 3 0.5 2.5))"
     :cs-program "(define pi 3.14159265)\n(define (arc-len r a0 a1) (* r (- a1 a0)))\n;; A full-turn arc's length equals the circle circumference 2*pi*r.\n(display (< (abs (- (arc-len 25 0 (* 2 pi)) (* 2 pi 25))) 0.001))"
     :invariant "∀ r ≥ 0, a0 ≤ a1. length(arc) = r·(a1 − a0)  ∧  length(arc) = 2π·r when a1 − a0 = 2π  (arc length is radius times swept angle, reducing to the circumference on a full turn)"
     :meta "The pattern is that radian measure is defined so that arc length equals radius times angle — that is what a radian is. Falsified if a full-turn arc's length differed from 2π·r or if doubling the radius did not double the length; that would mean the angle unit was not radians. book-of-math ch-advanced-08 (trigonometry) grounds the radian definition, ch-advanced-06 the circumference as an integral of the arc-length element."))
    (:eng "The operator can size an arc's ink as r·(a1 − a0) and know a full sweep costs the whole circumference, which sets the pixel budget of a progress ring." :math "length = r·(a1 − a0); the radian is defined by this identity, and a full turn gives 2π·r." :cs "A constant-time length from a subtract and a multiply; the shape of every arc-cost and stroke-budget estimate.")
  :row-5-emergence (

    (:base "arc strokes one slice of a circle's boundary from a start angle to an end angle.")
    (:composition "(set-mode 'sd)\n;; A rainbow: nested half-arcs of growing radius in a palette sweep.\n(arc 160 170 70 3.14159 6.28318 'red)\n(arc 160 170 60 3.14159 6.28318 'yellow)\n(arc 160 170 50 3.14159 6.28318 'green)\n(arc 160 170 40 3.14159 6.28318 6)" :note "")
    (:eng-composition "(set-mode 'sd)\n(define tau 6.28318)\n(define (dial cx cy r frac)\n  ;; A gauge: a full track ring plus a coloured arc showing the reading.\n  (ring cx cy r (- r 8) 8)\n  (arc cx cy (- r 4) -1.5708 (+ -1.5708 (* frac tau)) 'red))\n(dial 160 120 55 0.65)"
     :math-composition "(set-mode 'sd)\n;; A crescent moon: a filled disc with an offset arc suggesting the shadow edge.\n(ellipse-fill 160 120 40 40 'yellow)\n(ellipse-fill 175 120 38 40 0)\n(arc 145 120 40 -1.4 1.4 'yellow)"
     :cs-composition "(set-mode 'sd)\n;; A pac-man: a near-full arc plus its two mouth radii close the wedge.\n(arc 160 120 40 0.6 5.68 'yellow)\n(polygon (list (list 160 120) (list (+ 160 (* 40 (cos 0.6))) (+ 120 (* 40 (sin 0.6))))) 'yellow)\n(polygon (list (list 160 120) (list (+ 160 (* 40 (cos 5.68))) (+ 120 (* 40 (sin 5.68))))) 'yellow)"
     :emergent "A rainbow, a gauge dial, a crescent moon, and a pac-man: the same arc — as a colour band, a reading needle track, a shadow terminator, or a mouth's edge — composes a sky, an instrument, a moon phase, and a game sprite.")
    (:meta "This is the partial-revolution family — figures made by realising only a slice of a circular sweep. Familiar analogs are clock hands' travel, moon phases, protractor angles, and progress dials. The composition works because arc exposes the start and end angle directly, so any figure that lives on a portion of a circle — a mouth, a phase edge, a needle path, a band of sky — is one arc call away.")
    (:eng "The audit lens is 'do start and end angle frame the intended slice?' — an operator animating a dial checks the sweep endpoint tracks the reading and never overshoots the full turn." :math "A partial-revolution figure is the image of a sub-interval of S¹ under the point-on-circle map; the angular endpoints fix the slice." :cs "Endpoint-parametrised sampling of a circular path; the shape of every progress-arc, moon-phase, and gauge renderer."))
)









;; ── added 2026-08-02 · the raster state + primitive surface (33 verbs) ──

(verb
  :name "set-mode" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(set-mode preset) | (set-mode w h) -> (list w h)"
  :summary "Choose the framebuffer's dimensions, by preset name or by explicit width and height. Returns the resulting size as a two-element list."
  :explanation "set-mode is the first line of almost every drawing program. It replaces the framebuffer with a fresh one of the requested size, keeping the current palette and the current pen colour, and reattaches it to the animation loop. Two forms are accepted: a preset symbol, or a numeric width and height. The presets are the machines this dialect grew up around — 'default and 'sakura are 80x80, 'pico8 and 'pico-8 are 128x128, 'tic80 and 'tic-80 are 240x136, and 'sd is 320x240, the 4:3 canvas that the shape, SDF and SVG primitives guarantee their pixel-accuracy against. The numeric form takes anything from 1x1 up to 1024x1024. Because the buffer is replaced, every pixel is discarded: set-mode is a clear as well as a resize, and calling it mid-drawing throws away the drawing."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd)" :note "(320 240) — the SD reference canvas; the size is returned so you can bind it instead of hard-coding the numbers.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'tic80)" :note "(240 136) — a widescreen preset; the preset names are the machines, and each resolves to a fixed pair.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 'sd) (pset 0 0 9) (set-mode 100 50) (list (mode-info) (pget 0 0)))" :note "((100 50) 0) — the numeric form works, and the resize DISCARDED the pixel that was just poked; set-mode is destructive.")
  )
  :caveats ("It destroys the picture. set-mode allocates a new buffer, so every pixel is lost even if the new size equals the old one. Snapshot with fb-snapshot first if you need the image back." "An unknown preset name throws: (set-mode 'vga) raises 'unknown mode: vga'. The known names are default, sakura, pico8, pico-8, tic80, tic-80, sd." "Dimensions outside 1..1024 throw rather than clamping: (set-mode 0 10) and (set-mode 2000 2000) both raise." "The pen colour and the palette SURVIVE the resize; only the pixels go. That surprises people who expect set-mode to reset everything." "Mixed forms are rejected: (set-mode 'sd 100) raises, because the symbolic form takes exactly one argument.")
  :drawbacks ("There is no query for the list of preset names from Scheme; you have to know them." "No non-destructive resize — you cannot grow a canvas and keep the drawing." "The aspect ratio is whatever you asked for; nothing letterboxes or scales for you." "The 1024 ceiling is a hard limit with no override.")
  :usecases ("Opening line of any drawing or game program, fixing the coordinate space everything else assumes." "Switching to 'sd before using the shape primitives, whose pixel guarantees only hold there." "Making a tiny canvas (say 24x8) so a test can compare the whole buffer pixel by pixel." "Clearing everything and starting over, by re-issuing the same mode.")
  :related ("mode-info" "clear" "fb-snapshot" "fb-restore" "set-color")
  :learn (:concept "Establishing a coordinate space: every later drawing verb is interpreted relative to the size fixed here." :prerequisites () :progression "Set a mode, ask mode-info what you got, then clear and start drawing; later, learn fb-snapshot so a mode change need not lose the picture.")
  :row-2-audit (
    (:problem "A tutorial's examples all draw at 320x240 but the student's shapes land in the corner or off-screen, because the program never called set-mode and inherited the 80x80 default."
     :program "(define size (set-mode 'sd))\n(define w (car size))\n(define h (cadr size))\n;; Everything downstream is expressed in terms of w and h, never literals.\n(clear 0)\n(disc (quotient w 2) (quotient h 2) 30)\n(list 'canvas size 'centre-pixel (pget (quotient w 2) (quotient h 2)))"
     :eng-program "(define (with-canvas preset draw!)\n  ;; The size is handed to the drawing code so nothing has to guess it.\n  (let* ((size (set-mode preset)) (w (car size)) (h (cadr size)))\n    (clear 0)\n    (draw! w h)\n    size))\n(with-canvas 'sd (lambda (w h) (disc (quotient w 2) (quotient h 2) 30)))"
     :math-program "(define (centre w h) (list (quotient w 2) (quotient h 2)))\n;; The centre is a function of the mode, not a constant.\n(list (centre 80 80) (centre 320 240) (centre 128 128))"
     :cs-program "(define (mode-ok? size expected)\n  (and (= (car size) (car expected)) (= (cadr size) (cadr expected))))\n(list (mode-ok? (set-mode 'sd) (list 320 240))\n      (mode-ok? (set-mode 'pico8) (list 128 128)))"
     :explanation "eng: pass the size into the drawing code so no literal can drift from the mode. math: express the centre as a function of the dimensions. cs: assert the mode you got is the mode you asked for, instead of assuming."
     :meta "mode-info reads the size but cannot set it, so it cannot fix a program that never chose a mode. clear wipes the pixels but leaves the size alone. fb-restore installs a buffer of whatever size the snapshot had, which sets the size as a side effect and is a confusing way to ask for one. set-mode is the verb that chooses the coordinate space; the siblings only read it or change it incidentally.")
    (:eng "The audit lens is 'was the coordinate space chosen or inherited?' — the smoke test is that every coordinate literal in the program can be traced back to the returned size." :math "Fixing (w,h) fixes the lattice [0,w) × [0,h) that every later coordinate is interpreted in." :cs "Allocate-and-swap; the old buffer is dropped entirely rather than copied, so the cost is O(w·h) to zero and O(1) to discard."))
  :row-3-dimension (
    (:setup "Fix the extent of a workspace before anything is placed in it.")
    (:rungs (
       (:domain "set-mode"     :code "(set-mode 'tic80)")
       (:domain "paper-size"   :code "(define (sheet name) (cond ((eq? name 'a4) (list 210 297)) ((eq? name 'letter) (list 216 279)) (else (list 0 0))))\n(map sheet (list 'a4 'letter))")
       (:domain "domain-of-a-function" :code "(define (on-domain lo hi f) (map f (iota (- hi lo) lo)))\n(on-domain 0 5 (lambda (x) (* x x)))")))
    (:explanation "Rung 1: choosing a mode fixes the pixel lattice that every coordinate is read against. Rung 2: choosing a paper size fixes the region a layout has to fit, and a design that assumed A4 breaks on Letter. Rung 3: choosing a domain fixes where a function is defined, and asking for a value outside it is meaningless. All three share the same shape — declare the extent first, because every later statement is relative to it.")
    (:meta "The transfer works because coordinates carry no units of their own; a number is only a position once an extent has been declared. That is why the same bug — content laid out for one extent shown at another — appears in graphics, in print and in mathematics. Grounds in book-of-math ch-advanced-01 (functions) as the domain-declaration shape.")
    (:eng "Every extent-declaring substrate shares 'content built for one extent shown at another' — the operator's check is that the extent is read back, not assumed." :math "The domain must be fixed before the function is meaningful; a coordinate outside it has no interpretation." :cs "Allocation with an explicit size; the shape of every buffer, page and array bound."))
  :row-4-proof (
    (:claim "set-mode is idempotent in its size and destructive in its contents: asking for the same mode twice yields the same dimensions, and the second call still discards every pixel.")
    (:program "(define a (set-mode 'sd))\n(pset 10 10 9)\n(define b (set-mode 'sd))\n(display (list (equal? a b) (pget 10 10)))"
     :eng-program "(set-mode 24 8)\n(clear 7)\n;; Re-issuing the same mode is the shortest way to blank the canvas.\n(set-mode 24 8)\n(display (list (mode-info) (pget 0 0) (pget 23 7)))"
     :math-program "(define (mode->size m)\n  (cond ((eq? m 'sd) (list 320 240)) ((eq? m 'pico8) (list 128 128))\n        ((eq? m 'tic80) (list 240 136)) (else (list 80 80))))\n;; The name-to-size map is a function: same name, same size, every time.\n(display (equal? (mode->size 'sd) (mode->size 'sd)))"
     :cs-program "(define (deterministic? preset n)\n  (let loop ((i 0) (acc (list)))\n    (if (>= i n) (apply equal? acc)\n        (loop (+ i 1) (cons (set-mode preset) acc)))))\n(display (deterministic? 'pico8 2))"
     :invariant "∀ preset p. size(set-mode p) = size(set-mode p)  ∧  ∀ (x,y). pget(x,y) = 0 immediately after any set-mode"
     :meta "The pattern is a deterministic allocator: the name determines the shape, and every allocation starts zeroed. Falsified if a second set-mode preserved pixels; that would mean the buffer was reused, and a stale drawing would bleed into a program that thought it had a fresh canvas. book-of-math ch-advanced-01 grounds the name-to-size function; book-of-code ch 11 grounds zero-initialised allocation."))
    (:eng "The operator can blank a canvas by re-issuing its mode, and can trust that a fresh mode never carries residue from an earlier program." :math "The preset-to-size map is single-valued; the pixel state after allocation is the zero vector." :cs "Deterministic sizing plus zero-initialisation; the same shape as calloc versus malloc.")
  :row-5-emergence (
    (:base "set-mode fixes the canvas size and clears it.")
    (:composition "(set-mode 'sd)\n;; A responsive drawing: every coordinate derives from the returned size,\n;; so the same code draws correctly on any preset.\n(define (scene size)\n  (let ((w (car size)) (h (cadr size)))\n    (clear 12)\n    (rect-fill 0 (- h (quotient h 4)) w (quotient h 4))\n    (disc (quotient w 2) (quotient h 3) (quotient h 8))\n    (list w h)))\n(display (list (scene (set-mode 'sd)) (scene (set-mode 'pico8))))"
     :eng-composition "(define (render-at preset draw!)\n  ;; One drawing, many machines: the preset is a parameter, not a constant.\n  (let ((size (set-mode preset)))\n    (draw! (car size) (cadr size))\n    (list preset size)))\n(define (crosshair w h)\n  (clear 0)\n  (line 0 (quotient h 2) (- w 1) (quotient h 2))\n  (line (quotient w 2) 0 (quotient w 2) (- h 1)))\n(display (map (lambda (p) (render-at p crosshair)) (list 'default 'pico8 'tic80 'sd)))"
     :math-composition "(define (aspect size) (/ (car size) (cadr size)))\n;; The presets are not all the same shape; a square design distorts on tic80.\n(display (map (lambda (p) (list p (aspect (set-mode p))))\n              (list 'default 'pico8 'tic80 'sd)))"
     :cs-composition "(set-mode 24 8)\n;; A tiny mode makes the whole buffer comparable, which is what turns a\n;; drawing verb into something a test can assert on.\n(define (row y) (map (lambda (x) (pget x y)) (iota 24)))\n(define (snapshot) (map row (iota 8)))\n(clear 0)\n(rect-fill 2 2 4 3)\n(define a (snapshot))\n(clear 0)\n(rect-fill 2 2 4 3)\n(display (equal? a (snapshot)))"
     :emergent "A size-derived scene, one drawing rendered on four machines, an aspect-ratio comparison, and a tiny testable canvas: choosing the extent as data rather than as a literal makes the same drawing portable and the same verb testable.")
    (:meta "This is the resolution-independence family — express positions as fractions of the extent so the content survives a change of device. Familiar analogs are responsive web layout, vector graphics, and normalised device coordinates in a GPU pipeline. The composition works because set-mode returns the size, so the extent is available as a value rather than as tribal knowledge.")
    (:eng "The audit lens is 'would this still be right at another size?' — the smoke test is running the same drawing at two presets and seeing it stay centred." :math "Positions expressed as fractions of (w,h) are invariant under scaling of the extent." :cs "Parameterise by extent; the shape of every responsive layout and every device-independent coordinate system."))
)

(verb
  :name "mode-info" :std "Motoi"
  :library "draw"
  :kind "pure"
  :signature "(mode-info) -> (list w h)"
  :summary "Report the current framebuffer's width and height as a two-element list."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(mode-info)" :note "(80 80) — with no set-mode called, the framebuffer is the 80x80 default; mode-info is how you find that out rather than assuming.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 'pico8) (mode-info))" :note "(128 128) — after a mode change mode-info agrees with what set-mode returned; the two are always consistent.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 200 90) (car (mode-info)))" :note "200 — the list is (width height) in that order, so car is the width; getting the order backwards is the classic transposed-drawing bug.")
  )
  :explanation "mode-info is the read half of set-mode. It answers one question — how big is the canvas right now — and answers it as a (width height) list, the same shape set-mode returns. Use it whenever a drawing has to be positioned relative to the canvas rather than at fixed coordinates: centring, edge margins, tiling, and any code that might run under more than one preset. It is pure: calling it never changes anything, so it is safe inside a render loop. There is no way to ask it about a mode other than the current one, and no way to ask it for the mode's NAME — the preset name is not retained after set-mode resolves it to a pair of numbers."
  :caveats ("It returns the size, never the preset name. After (set-mode 'pico8) there is no verb that will tell you 'pico8' again; only (128 128) survives." "The order is (width height). Reading it as (height width) transposes every derived coordinate, and on a square preset like 'pico8 the bug is invisible until someone switches to 'tic80." "It reports the buffer's size, which after an fb-restore is the SNAPSHOT's size, not the size you last asked set-mode for." "With no framebuffer at all it still answers, because the media state creates the default 80x80 buffer lazily.")
  :drawbacks ("No aspect ratio, no palette size, no pen colour — one fact only; get-color is a separate call." "There is no list-of-available-presets companion." "Because it returns a fresh list each call, comparing results needs equal?, not eq?.")
  :usecases ("Centring a shape without hard-coding the middle." "Computing margins, tile counts, or a grid that fits the current canvas." "Guarding a drawing that only makes sense at a particular size." "Writing a test that iterates over every pixel of whatever canvas is current.")
  :related ("set-mode" "get-color" "pget" "framebuffer")
  :learn (:concept "Reading the ambient extent so that positions can be computed rather than memorised." :prerequisites ("set-mode") :progression "Ask mode-info for the size, derive a centre from it, then write a drawing that runs unchanged under every preset.")
  :row-2-audit (
    (:problem "A HUD is anchored to the bottom-right corner with the literals 310 and 230. It looks right on 'sd and disappears entirely when the same cart runs on 'pico8."
     :program "(set-mode 'pico8)\n(clear 0)\n(let* ((size (mode-info)) (w (car size)) (h (cadr size)))\n  ;; The anchor is derived, so it moves with the canvas.\n  (rect-fill (- w 20) (- h 10) 18 8)\n  (list 'canvas size 'anchor (list (- w 20) (- h 10)) 'pixel (pget (- w 15) (- h 6))))"
     :eng-program "(define (anchor-br margin-x margin-y w-box h-box)\n  ;; Bottom-right placement expressed once, correct at every preset.\n  (let* ((size (mode-info)) (w (car size)) (h (cadr size)))\n    (list (- w margin-x w-box) (- h margin-y h-box))))\n(set-mode 'pico8)\n(display (list (anchor-br 2 2 18 8) (begin (set-mode 'sd) (anchor-br 2 2 18 8))))"
     :math-program "(define (fractional-anchor fx fy)\n  ;; Positions as fractions of the extent are preset-independent.\n  (let* ((s (mode-info)) (w (car s)) (h (cadr s)))\n    (list (round (* fx w)) (round (* fy h)))))\n(set-mode 'sd)\n(display (list (fractional-anchor 0.5 0.5) (fractional-anchor 0.9 0.9)))"
     :cs-program "(define (fits? x y w h)\n  (let* ((s (mode-info)) (cw (car s)) (ch (cadr s)))\n    (and (>= x 0) (>= y 0) (<= (+ x w) cw) (<= (+ y h) ch))))\n(set-mode 'pico8)\n(display (list (fits? 100 100 18 8) (fits? 310 230 18 8)))"
     :explanation "eng: name the anchor rule once so every call site inherits the fix. math: express the position as a fraction of the extent, which is scale-free. cs: guard the box against the canvas bounds before drawing, so an off-canvas HUD fails loudly."
     :meta "set-mode would give the same numbers but only at the moment you change the mode, so a function called later has no access to them. framebuffer returns the whole buffer including every pixel, which is an enormous value to allocate just to read two integers. pget reads one pixel and knows nothing about the extent. mode-info is the cheap ambient-extent query; the siblings are either too early, too big, or too small.")
    (:eng "The audit lens is 'is this coordinate derived or memorised?' — the smoke test is switching preset and confirming nothing leaves the canvas." :math "A position given as a fraction of the extent is invariant under a change of extent; a literal is not." :cs "Ambient-state read; O(1) and side-effect free, so it is safe to call per frame."))
  :row-3-dimension (
    (:setup "Ask the container how big it is before deciding where something goes.")
    (:rungs (
       (:domain "mode-info"    :code "(begin (set-mode 'pico8) (mode-info))")
       (:domain "shelf-fitting" :code "(define (fits-on? shelf-w item-w) (<= item-w shelf-w))\n(map (lambda (w) (fits-on? 90 w)) (list 40 120))")
       (:domain "dimensional-analysis" :code "(define (as-fraction part whole) (/ part whole))\n(map (lambda (p) (as-fraction p 240)) (list 60 120 240))")))
    (:explanation "Rung 1: the canvas is measured before a shape is placed, so the placement is a fraction of a known extent. Rung 2: the shelf is measured before the item is bought, because 'it looked about right' is how furniture ends up in the hallway. Rung 3: a quantity is divided by its reference scale so it becomes a dimensionless ratio that survives a change of units. All three share the same shape — measure the container, then express the content relative to the measurement.")
    (:meta "The transfer works because absolute quantities are only meaningful next to a scale, and the scale is a property of the container rather than of the thing being placed. Every one of these fails the same way when the measurement is skipped and a remembered number is used instead. Grounds in book-of-math ch-advanced-09 (statistics) as the normalise-by-the-reference shape.")
    (:eng "Every measure-first substrate shares 'the remembered measurement went stale' — the operator's check is that the measurement is taken fresh at the point of use." :math "Dimensionless ratios are invariant under a change of scale; raw magnitudes are not." :cs "Query-then-compute; the shape of every layout pass and every capacity check."))
  :row-4-proof (
    (:claim "mode-info is pure and agrees with set-mode: it never changes the buffer, and it always reports exactly what the last set-mode returned.")
    (:program "(define asked (set-mode 'tic80))\n(define told-1 (mode-info))\n(define told-2 (mode-info))\n(display (list (equal? asked told-1) (equal? told-1 told-2)))"
     :eng-program "(set-mode 24 8)\n(clear 5)\n;; Reading the size many times cannot disturb the picture.\n(mode-info) (mode-info) (mode-info)\n(display (list (mode-info) (pget 0 0) (pget 23 7)))"
     :math-program "(define (agrees? preset)\n  (equal? (set-mode preset) (mode-info)))\n(display (map agrees? (list 'default 'pico8 'tic80 'sd)))"
     :cs-program "(set-mode 24 8)\n(define (row y) (map (lambda (x) (pget x y)) (iota 24)))\n(clear 3)\n(define before (map row (iota 8)))\n(mode-info)\n(display (equal? before (map row (iota 8))))"
     :invariant "∀ preset p. mode-info() = set-mode(p) immediately after (set-mode p)  ∧  ∀ state s. mode-info applied to s leaves s unchanged"
     :meta "The pattern is a consistent, side-effect-free accessor for state that another verb owns. Falsified if the reported size ever disagreed with the last set, or if reading disturbed the pixels; either would make the accessor untrustworthy and force callers to cache. book-of-math ch-advanced-01 grounds the accessor-as-projection; book-of-code ch 05 grounds command-query separation."))
    (:eng "The operator can call it freely inside a render loop; there is no cost and no risk of perturbing the frame." :math "It is the first projection of the buffer's state; projections are idempotent and non-destructive." :cs "Command-query separation: set-mode commands, mode-info queries, and neither does the other's job.")
  :row-5-emergence (
    (:base "mode-info reports the canvas extent.")
    (:composition "(set-mode 'sd)\n(clear 0)\n;; A border inset by a fixed margin, correct at any preset.\n(let* ((s (mode-info)) (w (car s)) (h (cadr s)) (m 8))\n  (rect m m (- w (* 2 m)) (- h (* 2 m)))\n  (list 'canvas s 'corner (pget m m)))"
     :eng-composition "(define (framed margin draw!)\n  ;; The frame and the content both derive from the same measurement.\n  (let* ((s (mode-info)) (w (car s)) (h (cadr s)))\n    (clear 0)\n    (rect margin margin (- w (* 2 margin)) (- h (* 2 margin)))\n    (draw! (+ margin 1) (+ margin 1) (- w (* 2 margin) 2) (- h (* 2 margin) 2))\n    (list 'outer s 'inner (list (- w (* 2 margin)) (- h (* 2 margin))))))\n(set-mode 'sd)\n(display (framed 8 (lambda (x y w h) (rect-fill x y (quotient w 2) (quotient h 2)))))"
     :math-composition "(set-mode 'tic80)\n(clear 0)\n;; A grid that always divides the canvas exactly, whatever its size.\n(let* ((s (mode-info)) (w (car s)) (h (cadr s)) (n 8))\n  (for-each (lambda (i) (line (quotient (* i w) n) 0 (quotient (* i w) n) (- h 1))) (iota n))\n  (for-each (lambda (j) (line 0 (quotient (* j h) n) (- w 1) (quotient (* j h) n))) (iota n))\n  (list 'cells (* n n) 'cell-size (list (quotient w n) (quotient h n))))"
     :cs-composition "(define (whole-canvas-histogram)\n  ;; Iterate every pixel of whatever canvas is current — only possible\n  ;; because the extent is queryable.\n  (let* ((s (mode-info)) (w (car s)) (h (cadr s)) (counts (make-vector 16 0)))\n    (let loop ((y 0))\n      (when (< y h)\n        (let inner ((x 0))\n          (when (< x w)\n            (let ((c (pget x y)))\n              (when (< c 16) (vector-set! counts c (+ 1 (vector-ref counts c)))))\n            (inner (+ x 1))))\n        (loop (+ y 1))))\n    (vector->list counts)))\n(set-mode 24 8)\n(clear 3)\n(rect-fill 0 0 6 4 )\n(display (whole-canvas-histogram))"
     :emergent "An inset border, a reusable frame, a canvas-dividing grid, and a whole-buffer histogram: one two-integer query is what lets a drawing adapt to its canvas and lets a test see all of it.")
    (:meta "This is the measure-then-lay-out family — a layout pass that begins by asking the container for its bounds. Familiar analogs are a browser's layout phase, a terminal's COLUMNS/LINES query, and a constraint solver seeded with the viewport. The composition works because the extent is a cheap pure query, so every part of a drawing can ask independently without coordinating.")
    (:eng "The audit lens is 'did every part measure the same container?' — the smoke test is that the frame and the content stay aligned when the preset changes." :math "All derived positions are functions of one measured pair, so they cannot drift apart." :cs "Single source of truth for the extent; the shape of every layout engine."))
)

(verb
  :name "set-color" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(set-color index-or-name) -> integer"
  :summary "Set the pen colour used by primitives that take no colour argument. Accepts a palette index (wrapped into range) or a colour name. Returns the index actually in effect."
  :explanation "Most of the raster primitives in this chapter draw in the CURRENT pen colour: circle, disc, line, rect and rect-fill take no colour argument at all, and pset takes an optional one. set-color is how you choose that pen. It accepts a number, which is reduced modulo the palette size so that any integer is legal, or a name — either a symbol or a string — from the 16-entry PICO-8-style palette: black 0, dark-blue 1, dark-purple 2, dark-green 3, brown 4, dark-grey (or dark-gray) 5, light-grey (or light-gray) 6, white 7, red 8, orange 9, yellow 10, green 11, blue 12, lavender 13, pink (or petal) 14, peach 15. It always returns the index now in effect, which is the only reliable way to find out whether a name was recognised. The pen survives a set-mode, so a resize does not reset it."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-color 'orange)" :note "9 — colour names resolve to their palette index, and the index is returned so you can see what you got.")
    (:dialect "motoi" :tier "intermediate" :code "(set-color 20)" :note "4 — an out-of-range index is wrapped modulo the 16-entry palette, so 20 becomes 4 rather than an error.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-color 'green) (set-color 'chartreuse))" :note "11 — an UNKNOWN name is silently ignored and the previous pen (green, 11) stays in effect; the return value is the only signal that the name was not recognised.")
  )
  :caveats ("AN UNKNOWN NAME FAILS SILENTLY. (set-color 'chartreuse) does not raise and does not change anything — the pen keeps whatever it was. The only way to detect the typo is to compare the returned index against what you expected. This is the single most common way a drawing comes out the wrong colour." "Numbers wrap, names do not. (set-color 20) becomes 4 and (set-color -1) becomes 15, but (set-color 'not-a-colour) becomes nothing at all. The two argument types have completely different failure modes." "Symbols and strings both work and are matched case-insensitively; 'RED, \"red\" and 'red all give 8." "The pen SURVIVES set-mode. Resizing the canvas does not reset the colour, which surprises people who expect a fresh canvas to mean a fresh pen." "It does not affect clear, background or bg-clear — those take their own index and default to 0, never to the pen.")
  :drawbacks ("There is no push/pop or with-color form; saving and restoring the pen is manual via get-color." "No RGB or hex form — this palette is indexed, and the HTML colour names belong to a different, unrelated palette reached through color/named." "Nothing validates a name at read time, so a typo survives all the way to the wrong pixels." "The palette itself is fixed at 16 entries; there is no set-palette verb in this chapter.")
  :usecases ("Choosing the pen once before a run of circle, line and rect calls that share it." "Cycling a colour by index inside a loop for rainbow or plasma effects." "Saving the pen with get-color, drawing something in another colour, then restoring it." "Writing colour names in a level definition so the data reads like English.")
  :related ("get-color" "clear" "pset" "fb/rect" "color/named")
  :learn (:concept "Ambient pen state: a mode setting that later commands read implicitly, and the trade it makes between brevity and traceability." :prerequisites ("set-mode") :progression "Set a colour and draw, then read it back with get-color, then learn which verbs use the pen and which take their own index — the split is the whole lesson.")
  :row-2-audit (
    (:problem "A scene is drawn entirely in pink no matter what the level data says. The level uses colour names, one of them is misspelled, and set-color's silent failure means every subsequent shape inherits whichever pen was last set successfully."
     :program "(set-mode 'sd)\n(clear 0)\n(define (safe-color c)\n  ;; Ask for it, then check you got it; that is the only detection available.\n  (let ((got (set-color c)))\n    (list c '-> got)))\n(display (list (safe-color 'red) (safe-color 'chartreuse) (safe-color 'blue)))"
     :eng-program "(set-mode 'sd)\n(define (require-color! c expected)\n  ;; Fail loudly where the engine fails silently.\n  (let ((got (set-color c)))\n    (if (= got expected) got (error 'unknown-color c))))\n(display (list (require-color! 'red 8) (require-color! 'blue 12)))"
     :math-program "(define (wrap i n) (modulo i n))\n;; Numeric indices are total: every integer maps into 0..15.\n(display (map (lambda (i) (wrap i 16)) (list 0 15 16 20 -1 -17)))"
     :cs-program "(set-mode 'sd)\n(define (color-of name)\n  ;; A name is recognised iff setting it changes the pen away from a known sentinel.\n  (set-color 0)\n  (let ((got (set-color name)))\n    (if (= got 0) 'unrecognised got)))\n(display (list (color-of 'red) (color-of 'chartreuse)))"
     :explanation "eng: turn the silent miss into an error at the boundary where the name enters the program. math: note the numeric path is total by construction, unlike the name path. cs: build a recogniser out of the sentinel trick, which is the only detection the verb offers."
     :meta "get-color reads the pen but cannot tell you whether the last set worked, only what the pen is now. clear takes its own index and ignores the pen entirely. fb/rect takes a colour, uses it, and puts the pen back, which is the safe pattern when only one shape needs a different colour. color/named looks up a completely different palette (HTML names) and returns a hex string, so it cannot be used to validate an index name. set-color is the ambient-pen verb; validate its return value or accept silent misses.")
    (:eng "The audit lens is 'did the colour I asked for actually take?' — the smoke test is comparing the return value against the expected index at every call." :math "The numeric branch is a total surjection ℤ → ℤ/16; the name branch is a partial function whose undefined case is the identity on state." :cs "Set-with-implicit-default; the failure mode is a silent no-op, which is the hardest kind to see."))
  :row-3-dimension (
    (:setup "Choose a setting once so that everything afterwards inherits it without saying so.")
    (:rungs (
       (:domain "set-color"    :code "(set-color 'orange)")
       (:domain "workshop-jig" :code "(define (with-jig setting cuts) (map (lambda (c) (list c 'at setting)) cuts))\n(with-jig '45-degrees (list 'rail 'stile))")
       (:domain "dynamic-scope" :code "(define ambient 'red)\n(define (draw-thing) ambient)\n(define (with-ambient v thunk) (let ((old ambient)) (set! ambient v) (let ((r (thunk))) (set! ambient old) r)))\n(list (with-ambient 'blue draw-thing) (draw-thing))")))
    (:explanation "Rung 1: the pen is set once and every later primitive uses it without mentioning it. Rung 2: a saw's jig is set to an angle once and every cut inherits that angle silently. Rung 3: a dynamically scoped variable is bound once and every call in its extent reads it. All three share the same shape — a setting held in the environment rather than passed as an argument, which buys brevity and costs traceability.")
    (:meta "The transfer works because ambient state is the same trade everywhere: fewer arguments at every call site, and no way to tell from a call site what will actually happen. That is why every one of them grows the same companion — a save-and-restore idiom — as soon as a program gets big enough. Grounds in book-of-code ch 07 as the ambient-state/dynamic-scope shape.")
    (:eng "Every ambient-setting substrate shares 'the setting was left on' — the operator's check is a save-and-restore around anything that changes it." :math "The operation is parameterised by an environment; the same syntactic call denotes different functions in different environments." :cs "Dynamic scope; the shape of every mode flag, every graphics context and every thread-local."))
  :row-4-proof (
    (:claim "The numeric branch is total and periodic with period 16; the name branch is partial, and on an unrecognised name it is the identity on the pen.")
    (:program "(display (list (set-color 4) (set-color 20) (set-color 36) (set-color -12)))"
     :eng-program "(set-color 'green)\n;; Three unrecognised names in a row leave the pen exactly where it was.\n(display (list (set-color 'chartreuse) (set-color 'puce) (set-color 'nonesuch) (get-color)))"
     :math-program "(define (congruent? a b) (= (modulo a 16) (modulo b 16)))\n(display (list (congruent? 4 20) (congruent? 4 36) (congruent? -12 4)))"
     :cs-program "(set-color 7)\n(define before (get-color))\n(set-color 'definitely-not-a-color)\n(display (list before (get-color) (= before (get-color))))"
     :invariant "∀ i ∈ ℤ. set-color(i) = i mod 16  ∧  ∀ name n ∉ PALETTE. pen after set-color(n) = pen before"
     :meta "The pattern is two argument types sharing one entry point with incompatible totality: one is defined everywhere by wrapping, the other is undefined outside a fixed set and resolves the undefined case as a no-op. Falsified if an unknown name raised, or if a large index errored; either would be a better design but neither is what the engine does. book-of-math ch-advanced-04 grounds the cyclic group ℤ/16; book-of-code ch 05 grounds partial functions and their totalisation."))
    (:eng "The operator must treat names and numbers as different risk classes: a bad number is impossible, a bad name is invisible." :math "ℤ → ℤ/16 is a surjective homomorphism; the name lookup is a partial map totalised by the identity." :cs "Overloaded parameter with divergent error semantics; the same shape as a parser that coerces one input type and ignores another.")
  :row-5-emergence (
    (:base "set-color chooses the pen every colourless primitive will use.")
    (:composition "(set-mode 'sd)\n(clear 0)\n;; A palette sweep: one loop, sixteen bands, colour chosen by index.\n(for-each (lambda (i)\n            (set-color i)\n            (rect-fill (* i 20) 0 20 240))\n          (iota 16))\n(display (map (lambda (i) (pget (+ (* i 20) 10) 120)) (iota 16)))"
     :eng-composition "(set-mode 'sd)\n(define (with-color c thunk)\n  ;; Save, set, draw, restore — the discipline ambient state always needs.\n  (let ((old (get-color)))\n    (set-color c)\n    (thunk)\n    (set-color old)))\n(clear 0)\n(set-color 7)\n(with-color 8 (lambda () (rect-fill 10 10 20 20)))\n(display (list 'inside (pget 15 15) 'pen-after (get-color)))"
     :math-composition "(set-mode 'sd)\n(clear 0)\n;; Cycling the index modulo the palette makes a repeating ramp of any length.\n(for-each (lambda (i)\n            (set-color i)          ; wraps automatically past 15\n            (line (* i 6) 0 (* i 6) 239))\n          (iota 40))\n(display (map (lambda (i) (pget (* i 6) 100)) (list 0 16 32)))"
     :cs-composition "(set-mode 'sd)\n(clear 0)\n;; A named-colour level format: the data reads like English and the\n;; renderer validates every name as it goes.\n(define level (list (list 'red 0 0) (list 'blue 40 0) (list 'green 80 0)))\n(display (map (lambda (row)\n                (let ((got (set-color (car row))))\n                  (rect-fill (cadr row) (caddr row) 30 30)\n                  (list (car row) got)))\n              level))"
     :emergent "A palette sweep, a save-and-restore wrapper, a wrapping ramp, and a validated named-colour level format: an ambient setting becomes safe once it is always paired with a read.")
    (:meta "This is the graphics-context family — a bundle of ambient settings that drawing commands read implicitly, with a save/restore discipline layered on top. Familiar analogs are PostScript's gsave/grestore, HTML canvas save()/restore(), and OpenGL's state machine. The composition works because get-color makes the pen readable, which is what makes a restore possible at all.")
    (:eng "The audit lens is 'is every colour change paired with a restore?' — the smoke test is that the pen after a helper equals the pen before it." :math "The set of pen values with save/restore forms a stack discipline; nesting is well-defined iff every push has a pop." :cs "Save/restore around ambient state; the shape of every graphics context and every parameterize form."))
)

(verb
  :name "get-color" :std "Motoi"
  :library "draw"
  :kind "pure"
  :signature "(get-color) -> integer"
  :summary "Read the current pen colour as a palette index in 0..15."
  :explanation "get-color is the read half of set-color, and it is what makes the ambient pen safe to use. It returns the index that the colourless primitives — circle, disc, line, rect, rect-fill and a bare pset — will draw in right now. Two jobs matter. First, save-and-restore: read the pen, change it, draw, and put it back, so a helper procedure cannot leak a colour onto its caller. Second, detection: because set-color silently ignores an unrecognised name, comparing get-color against what you expected is the only way to notice a typo. The default pen on a fresh interpreter is 14 (pink), not 0, which catches people who assume a new canvas starts black-on-black."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(get-color)" :note "14 — the default pen is pink, not black; a fresh canvas does not start at index 0.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-color 'blue) (get-color))" :note "12 — get-color always agrees with what set-color returned, so either can be used to confirm the pen.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 'pico8) (set-color 'red) (set-mode 'sd) (get-color))" :note "8 — the pen SURVIVES a mode change; set-mode replaces the pixels but carries the pen and the palette across.")
  )
  :caveats ("The default is 14 (pink), not 0. A program that never calls set-color draws in pink, which on a black canvas is visible and on a pink one is not." "It reports the pen, not whether the last set-color succeeded. Two different set-color calls — one good, one an unrecognised name — can leave the same value here." "It says nothing about clear, background or bg-clear, which take their own index and default to 0 regardless of the pen." "After an fb-restore of an fb-snapshot the pen is the SNAPSHOT's pen; after an fb-restore of a render or framebuffer value the pen is silently reset to 0, because those two forms do not carry it.")
  :drawbacks ("Returns an index only — there is no way to get the name back, nor the RGB triple." "No history: you cannot ask what the pen was before the last change." "Because the pen is process-global, two pieces of code that both use it must cooperate by convention alone.")
  :usecases ("The save half of a save-set-draw-restore wrapper around a helper." "Verifying that a colour name was actually recognised by set-color." "Logging or displaying the current pen while debugging a drawing." "Deriving a contrasting colour from whatever the current pen happens to be.")
  :related ("set-color" "fb/rect" "fb-snapshot" "fb-restore" "pset")
  :learn (:concept "The read half of ambient state, and why an unreadable setting cannot be restored." :prerequisites ("set-color") :progression "Read the pen, then build a with-color wrapper that saves and restores it, then use the wrapper everywhere a helper draws in its own colour.")
  :row-2-audit (
    (:problem "A helper that draws a red warning box leaves the pen red, so every shape drawn afterwards by unrelated code is red too. The bug appears far from its cause and only in the order the helpers happen to run."
     :program "(set-mode 'sd)\n(clear 0)\n(set-color 7)\n(define (warning-box x y w h)\n  ;; Read, set, draw, restore — the leak closes here, not at the call sites.\n  (let ((old (get-color)))\n    (set-color 8)\n    (rect-fill x y w h)\n    (set-color old)))\n(warning-box 10 10 30 20)\n(display (list 'box (pget 20 20) 'pen-after (get-color)))"
     :eng-program "(set-mode 'sd)\n(define (with-color c thunk)\n  (let ((old (get-color)))\n    (set-color c)\n    (let ((r (thunk)))\n      (set-color old)\n      r)))\n(clear 0)\n(set-color 7)\n(with-color 8 (lambda () (rect-fill 10 10 30 20)))\n(with-color 11 (lambda () (rect-fill 50 10 30 20)))\n(display (list (pget 20 20) (pget 60 20) (get-color)))"
     :math-program "(define (balanced? pushes pops) (= pushes pops))\n;; Save/restore is a stack discipline: nesting is sound iff the counts match.\n(display (list (balanced? 2 2) (balanced? 3 2)))"
     :cs-program "(set-mode 'sd)\n(define (leaks? draw!)\n  (let ((before (get-color)))\n    (draw!)\n    (not (= before (get-color)))))\n(set-color 7)\n(display (list (leaks? (lambda () (set-color 8) (rect-fill 0 0 4 4)))\n               (leaks? (lambda () (let ((o (get-color))) (set-color 8) (rect-fill 0 0 4 4) (set-color o))))))"
     :explanation "eng: put the restore inside the helper so no call site has to remember it. math: name the discipline — a balanced stack of saves and restores. cs: write the leak detector itself, so a test can assert that a helper is colour-neutral."
     :meta "set-color alone cannot restore, because it does not tell you what to restore TO. fb/rect saves and restores internally, so a single filled rectangle needs no wrapper at all — reach for it when that is the whole job. fb-snapshot captures the pen along with every pixel, which is a very heavy way to save one integer. get-color is the cheap read that makes restoring possible; the siblings either cannot restore or overshoot.")
    (:eng "The audit lens is 'is this helper colour-neutral?' — the smoke test is comparing get-color before and after every helper call." :math "Save/restore imposes a stack discipline on the pen; the invariant is that the pen is unchanged across a balanced region." :cs "Read-modify-restore; the shape of every context manager and every RAII guard."))
  :row-3-dimension (
    (:setup "Read a shared setting so it can be put back exactly as it was found.")
    (:rungs (
       (:domain "get-color"      :code "(begin (set-color 'blue) (get-color))")
       (:domain "borrowed-tool"  :code "(define (borrow tool where) (list 'took tool 'from where 'return-to where))\n(borrow 'ladder 'shed)")
       (:domain "referential-transparency" :code "(define (pure-twice f x) (list (f x) (f x)))\n(pure-twice (lambda (n) (* n n)) 5)")))
    (:explanation "Rung 1: the pen is read so it can be written back unchanged after a detour. Rung 2: a borrowed tool's original place is noted so it can be returned there, which is the whole of not annoying your neighbour. Rung 3: a pure function leaves nothing changed, so calling it twice gives the same answer twice. All three share the same shape — observe the prior state so the world can be left as it was found.")
    (:meta "The transfer works because 'leave no trace' is only achievable if the trace was readable in the first place; an unreadable setting can be changed but never restored. That is why write-only configuration is a design smell in every one of these substrates. Grounds in book-of-code ch 07 as the observe-then-restore shape.")
    (:eng "Every restore substrate shares 'it was never read, so it cannot be put back' — the operator's check is that every mutable setting has a getter." :math "Restoration requires the state to be observable; otherwise the operation has no inverse." :cs "Getter as a precondition for save/restore; the shape of every context manager."))
  :row-4-proof (
    (:claim "get-color is pure and exact: it never changes anything, and it always equals the value the last successful set-color returned.")
    (:program "(set-color 'red)\n(define a (get-color))\n(define b (get-color))\n(define c (get-color))\n(display (list a b c (= a b c 8)))"
     :eng-program "(set-mode 24 8)\n(clear 3)\n(set-color 9)\n;; Reading the pen many times disturbs neither the pen nor the pixels.\n(get-color) (get-color) (get-color)\n(display (list (get-color) (pget 0 0) (pget 23 7)))"
     :math-program "(define (agrees? c) (= (set-color c) (get-color)))\n(display (map agrees? (list 0 8 15 20 -3)))"
     :cs-program "(set-mode 24 8)\n(define (row y) (map (lambda (x) (pget x y)) (iota 24)))\n(clear 5)\n(define before (map row (iota 8)))\n(get-color)\n(display (equal? before (map row (iota 8))))"
     :invariant "∀ c. get-color() = set-color(c) immediately after (set-color c)  ∧  get-color leaves both the pen and every pixel unchanged"
     :meta "The pattern is an exact, side-effect-free accessor — the getter agrees with the setter with no rounding, caching or lag. Falsified if reading the pen changed it, or if the getter and setter disagreed; either would make save/restore unsound and produce colour leaks that no amount of discipline could fix. book-of-math ch-advanced-01 grounds the projection; book-of-code ch 05 grounds command-query separation."))
    (:eng "The operator can build a restore on top of it without defensive re-reads; the getter is authoritative." :math "It is the pen projection of the buffer state, and projections are idempotent." :cs "Pure accessor; the same shape as any getter that does not memoise, lock or lazily compute.")
  :row-5-emergence (
    (:base "get-color reads the pen.")
    (:composition "(set-mode 'sd)\n(clear 0)\n(set-color 7)\n;; A contrasting outline derived from whatever the pen currently is.\n(define base (get-color))\n(rect-fill 20 20 40 30)\n(set-color (modulo (+ base 8) 16))\n(rect 20 20 40 30)\n(set-color base)\n(display (list 'fill (pget 30 30) 'edge (pget 20 20) 'pen (get-color)))"
     :eng-composition "(set-mode 'sd)\n(define (with-color c thunk)\n  (let ((old (get-color))) (set-color c) (let ((r (thunk))) (set-color old) r)))\n(define (badge x y label-color)\n  ;; Nested wrappers: each restores its own layer, so the pen unwinds cleanly.\n  (with-color 5 (lambda ()\n    (rect-fill x y 40 16)\n    (with-color label-color (lambda () (rect-fill (+ x 2) (+ y 2) 36 12))))))\n(clear 0)\n(set-color 7)\n(badge 10 10 11)\n(display (list (pget 12 12) (pget 15 15) (get-color)))"
     :math-composition "(set-mode 'sd)\n(clear 0)\n;; Complementary pairs: index + 8 mod 16 walks to the far side of the ramp.\n(display (map (lambda (i)\n                (set-color i)\n                (let ((c (get-color)))\n                  (list c (modulo (+ c 8) 16))))\n              (list 0 3 8 11)))"
     :cs-composition "(set-mode 'sd)\n;; A colour-neutrality test suite: every helper must leave the pen where it found it.\n(define (neutral? draw!)\n  (let ((before (get-color))) (draw!) (= before (get-color))))\n(define (good) (let ((o (get-color))) (set-color 8) (rect-fill 0 0 4 4) (set-color o)))\n(define (bad) (set-color 8) (rect-fill 0 0 4 4))\n(set-color 7)\n(display (list (neutral? good) (neutral? bad)))"
     :emergent "A derived contrast colour, nested save/restore badges, complementary pairs, and a neutrality test: reading the pen turns a global setting into something composable and testable.")
    (:meta "This is the context-manager family — pair every mutation of shared state with an observation and a restoration, so nesting is safe. Familiar analogs are gsave/grestore, Python's with-statement, and dynamic-wind. The composition works because the pen is both readable and writable, which is exactly the pair a context manager needs.")
    (:eng "The audit lens is 'does the pen unwind to where it started?' — the smoke test is asserting neutrality on every helper in the drawing layer." :math "Balanced save/restore makes the pen invariant across any well-nested region." :cs "Nested context managers; the shape of every dynamic-wind and every stack-disciplined resource."))
)
(verb
  :name "clear" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(clear) | (clear color) -> undefined"
  :summary "Fill every pixel of the framebuffer with one colour, defaulting to 0. Returns nothing."
  :explanation "clear is the blank sheet. It writes a single byte into every cell of the pixel buffer and bumps the frame version so the display knows something changed. With no argument it clears to 0, which in the default palette is black. With an argument it clears to that palette index. It does NOT touch the pen colour, it does NOT change the mode, and — this catches people — it does NOT empty the text overlay, so any string drawn with draw-text survives a clear and reappears over the fresh background. Two aliases, background and bg-clear, are the same function object bound under friendlier names; use whichever reads better in the program you are writing."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (clear 3) (pget 0 0))" :note "3 — every pixel, corner to corner, is now the requested colour.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (clear 7) (clear) (pget 5 5))" :note "0 — with no argument the fill colour is 0, so a bare clear is the blank-to-black idiom.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (set-color 9) (clear 3) (get-color))" :note "9 — clear repaints the pixels but leaves the PEN alone; the next shape still draws in 9.")
  )
  :caveats ("THE COLOUR IS NOT WRAPPED INTO PALETTE RANGE. (clear 300) stores 300 & 255 = 44, an index with no palette entry, and the pixel reads back as 44. set-color wraps; clear does not. Marked needs-alfred." "It does not clear the text overlay. After (draw-text \"hi\" 0 0) a clear wipes the pixels and the string is still there — use (text/overlay-clear) as well." "A negative argument is masked the same way: (clear -1) leaves 255 in every cell." "It returns nothing, so (display (clear 3)) prints an empty value; clear is for its effect only." "It clears the CURRENT framebuffer; after an fb-restore you are clearing the restored one, which may be a different size than you expect.")
  :drawbacks ("No region form — you cannot clear a rectangle, only the whole canvas; use rect-fill for that." "No 'clear to the current pen colour' shorthand; you have to pass get-color yourself." "Because it is a full-buffer write it costs O(w·h) every call, which on a 320x240 canvas is 76800 byte writes per frame." "Nothing validates the index against the palette, so a typo paints an invisible colour rather than raising.")
  :usecases ("First line of every animation frame, so the previous frame does not smear." "Setting a background colour before drawing the scene on top of it." "Blanking a tiny test canvas so a pixel assertion starts from a known state." "Resetting after an experiment without paying for a full set-mode reallocation.")
  :related ("background" "bg-clear" "paint-clear" "rect-fill" "set-mode")
  :learn (:concept "Initialising state to a known value before building on it — the drawing equivalent of zeroing an accumulator." :prerequisites ("set-mode") :progression "Clear to black, then clear to a colour to see it is a fill and not an erase, then discover that the text overlay survives it.")
  :row-2-audit (
    (:problem "An animation leaves ghost trails: each frame draws the sprite in its new position but the old position was never wiped, so the screen fills up with a smear of every past frame."
     :program "(set-mode 40 20)\n;; The fix is one line at the top of the frame: blank before you draw.\n(define (frame x)\n  (clear 0)\n  (disc x 10 3)\n  (list x (pget x 10)))\n(list (frame 8) (frame 20) (pget 8 10))"
     :eng-program "(define (draw-frame! bg draw!)\n  ;; Clear-then-draw is a protocol; wrapping it stops anyone forgetting half.\n  (clear bg)\n  (draw!)\n  'drawn)\n(set-mode 40 20)\n(draw-frame! 12 (lambda () (rect-fill 5 5 10 6)))\n(list (pget 0 0) (pget 6 6))"
     :math-program "(define (constant-vector n v) (map (lambda (i) v) (iota n)))\n;; A clear is exactly the constant function over the whole index set.\n(list (constant-vector 5 3) (constant-vector 5 0))"
     :cs-program "(set-mode 16 8)\n(define (all-equal? v)\n  (let loop ((x 0) (y 0))\n    (cond ((>= y 8) #t)\n          ((>= x 16) (loop 0 (+ y 1)))\n          ((= (pget x y) v) (loop (+ x 1) y))\n          (else #f))))\n(clear 5)\n(display (all-equal? 5))"
     :explanation "eng: make clear-then-draw a single callable protocol so half of it cannot be forgotten. math: recognise the clear as the constant function over the index set. cs: assert the postcondition — after a clear, every cell holds the same value."
     :meta "rect-fill can blank a region but you have to know the region, and getting it wrong leaves a strip of the old frame. set-mode blanks too, but it reallocates and throws away the size you chose. paint-clear is the world-library sibling and behaves the same, but it lives in the world vocabulary and reads oddly in a pure drawing program. clear is the verb whose whole job is 'every pixel, one value'.")
    (:eng "The audit lens is 'does every frame start from a known state?' — the smoke test is drawing two frames and checking the first one left no residue." :math "The post-state is the constant map [0,w)×[0,h) → {c}; every pixel query is answered by c." :cs "Buffer fill; the same operation as memset, O(n) in the cell count with no allocation."))
  :row-3-dimension (
    (:setup "Reset a whole workspace to one known value before the next round of work.")
    (:rungs (
       (:domain "clear"        :code "(begin (set-mode 16 8) (clear 4) (pget 9 3))")
       (:domain "wiping-a-whiteboard" :code "(define (wipe board) (map (lambda (cell) 'blank) board))\n(wipe (list 'note 'sketch 'total))")
       (:domain "zero-vector"  :code "(define (zero n) (map (lambda (i) 0) (iota n)))\n(list (zero 4) (apply + (zero 4)))")))
    (:explanation "Rung 1: clear writes one colour into every pixel so the next drawing starts from a known ground. Rung 2: wiping a whiteboard puts every square inch into the same state so the next meeting is not reading last week's diagram. Rung 3: the zero vector is the additive identity you start an accumulation from. All three are the same move — collapse the whole space to a single known value so that what comes next is entirely attributable to what comes next.")
    (:meta "The transfer works because 'known state' is what makes later observations meaningful; without it you cannot tell your mark from someone else's leftover. That is why the same discipline shows up in graphics, in shared physical workspaces and in numerical accumulation. Grounds in book-of-code ch 11 as initialisation and in book-of-math ch-advanced-02 as the identity element.")
    (:eng "Every reset-to-known substrate shares 'residue misread as result' — the operator's check is that a fresh workspace is provably uniform." :math "Collapsing to a constant is the projection onto the identity element; the accumulation that follows is unambiguous." :cs "Initialisation before use; the shape of memset, of calloc and of every test fixture's setup."))
  :row-4-proof (
    (:claim "clear is idempotent and total: clearing twice equals clearing once, and after any clear every pixel in the canvas holds the same value.")
    (:program "(set-mode 16 8)\n(clear 6)\n(define a (list (pget 0 0) (pget 15 7) (pget 8 4)))\n(clear 6)\n(define b (list (pget 0 0) (pget 15 7) (pget 8 4)))\n(display (list (equal? a b) a))"
     :eng-program "(set-mode 12 6)\n(rect-fill 2 2 5 3)\n;; Whatever mess is on the canvas, one clear erases all of it.\n(clear 2)\n(display (list (pget 0 0) (pget 3 3) (pget 11 5)))"
     :math-program "(define (const c) (lambda (i) c))\n;; f∘f = f — applying the constant map twice changes nothing.\n(define f (const 7))\n(display (list (f 0) (f (f 0)) (= (f 0) (f (f 99)))))"
     :cs-program "(set-mode 10 4)\n(define (uniform?)\n  (let ((v (pget 0 0)))\n    (let loop ((x 0) (y 0))\n      (cond ((>= y 4) #t)\n            ((>= x 10) (loop 0 (+ y 1)))\n            ((= (pget x y) v) (loop (+ x 1) y))\n            (else #f)))))\n(rect-fill 1 1 3 2)\n(clear 9)\n(display (uniform?))"
     :invariant "∀ colour c. clear(c) ∘ clear(c) = clear(c)  ∧  ∀ (x,y) in the canvas. pget(x,y) = c after clear(c)"
     :meta "The pattern is an idempotent total assignment — the operation depends on nothing it reads, so repeating it is free and its result covers the whole domain. Falsified if a second clear changed anything, or if any pixel survived one; either would mean clear is partial and a program could not rely on it as a reset. book-of-math ch-advanced-02 grounds idempotence; book-of-code ch 11 grounds the memset primitive."))
    (:eng "The operator can call clear defensively as often as they like — a redundant clear costs time but can never cost correctness." :math "clear(c) is an idempotent endomorphism of the pixel space whose image is the single constant configuration." :cs "Idempotent total write; the same guarantee that makes a setup step safe to re-run.")
  :row-5-emergence (
    (:base "clear fills the whole canvas with one colour.")
    (:composition "(set-mode 40 24)\n;; Layered scene: clear lays the sky down, then everything else sits on it.\n(clear 12)\n(set-color 4)\n(rect-fill 0 18 40 6)\n(set-color 10)\n(disc 32 5 3)\n(display (list 'sky (pget 20 2) 'ground (pget 20 20) 'sun (pget 32 5)))"
     :eng-composition "(define (scene! bg body!)\n  ;; Background is a parameter, so the same scene renders day and night.\n  (clear bg)\n  (body!)\n  (pget 0 0))\n(set-mode 20 10)\n(define (hill!) (set-color 3) (rect-fill 0 6 20 4))\n(display (list (scene! 12 hill!) (scene! 1 hill!)))"
     :math-composition "(set-mode 20 10)\n;; Fill, overwrite a region, and count: the clear sets the baseline measure.\n(define (count-of v)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 10) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((= (pget x y) v) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(clear 0)\n(rect-fill 0 0 5 4)\n(display (list (count-of 0) (+ (count-of 0) 20)))"
     :cs-composition "(set-mode 16 8)\n;; Double-buffer by hand: snapshot a cleared canvas and restore it\n;; instead of paying for a fresh clear on every frame.\n(clear 1)\n(define blank (fb-snapshot))\n(set-color 8)\n(disc 8 4 2)\n(define dirty (pget 8 4))\n(fb-restore blank)\n(display (list dirty (pget 8 4)))"
     :emergent "A layered scene, a parameterised background, a pixel census against a known baseline, and a hand-rolled double buffer: once the canvas has a guaranteed ground state, everything drawn afterwards is measurable against it.")
    (:meta "This is the ground-then-build family — establish a uniform substrate so that every later mark is distinguishable from the substrate. Familiar analogs are gesso on a canvas, a primer coat before paint, and zeroing an array before summing into it. The composition works because clear is total: nothing survives it, so nothing can be mistaken for new work.")
    (:eng "The audit lens is 'can I tell what I drew from what was already there?' — the smoke test is counting pixels of the background colour before and after." :math "A known constant baseline turns pixel counts into a measure; without it the count is meaningless." :cs "Initialise-then-accumulate; the shape of every zeroed histogram and every cleared render target."))
)

(verb
  :name "background" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(background) | (background color) -> undefined"
  :summary "An alias of clear: fill every pixel with one colour, defaulting to 0."
  :explanation "background is the same function object as clear, bound under a second name. The engine takes the value of clear out of the environment and re-defines it as background and as bg-clear, so all three are indistinguishable at runtime — same arity, same default, same masking behaviour, same failure to touch the text overlay. The name exists because 'set the background' is how people describe the operation when the fill is a scene element rather than an erase. Reach for background when the colour is the sky, the paper or the felt of the table; reach for clear when you are wiping the previous frame."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (background 5) (pget 1 1))" :note "5 — the whole canvas becomes the requested colour, exactly as clear would.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (background 12) (set-color 10) (disc 12 4 2) (list (pget 0 0) (pget 12 4)))" :note "(12 10) — the background is laid first and the disc sits on top of it.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (background 3) (clear 3) (bg-clear 3) (pget 7 7))" :note "3 — all three names do the identical thing; the choice is documentation, not behaviour.")
  )
  :caveats ("It is an ALIAS, not a variant. Any bug in clear is a bug in background, including the unmasked colour: (background 300) leaves 44 in every pixel. Marked needs-alfred alongside clear." "It does not empty the text overlay, so a string drawn earlier reappears on top of the new background." "It takes a palette INDEX, not a colour name — (background 'red) does not do what the name suggests; use (set-color 'red) then (background (get-color))." "With no argument it fills with 0, which reads as 'no background' but is really 'background black'." "Because it shares the function object, redefining clear does not redefine background; they were captured at install time.")
  :drawbacks ("Three names for one behaviour makes reference lookup and code search noisier than it needs to be." "The name implies a layer beneath the drawing, but there is no layering — it simply overwrites everything already drawn." "No gradient, no pattern, no image form; the background is one flat index." "Nothing warns when it is called after the scene is drawn, which silently erases the scene.")
  :usecases ("Laying a sky, a sea or a tabletop colour before the scene goes on top." "Making a program read as a picture rather than as a frame loop." "Teaching: 'first the background, then the things' is an easier first sentence than 'first the clear'." "Matching a cart's visual style where the background colour is part of the design.")
  :related ("clear" "bg-clear" "paint-clear" "rect-fill" "set-color")
  :learn (:concept "Aliasing — one behaviour reachable under several names, chosen for how the surrounding code reads." :prerequisites ("clear" "set-mode") :progression "Use clear in a frame loop and background in a still picture, then check with a pixel probe that they are the same operation.")
  :row-2-audit (
    (:problem "A student writes (background 'sky-blue) expecting a colour name and gets a black canvas, because the symbol is coerced to 0 rather than looked up in the palette."
     :program "(set-mode 24 8)\n;; Names go through set-color; background only speaks indices.\n(set-color 'blue)\n(background (get-color))\n(list 'index (get-color) 'pixel (pget 0 0))"
     :eng-program "(define (background-named! name)\n  ;; One helper, and the name-to-index step can never be skipped again.\n  (let ((before (get-color)))\n    (set-color name)\n    (background (get-color))\n    (set-color before)\n    (pget 0 0)))\n(set-mode 24 8)\n(list (background-named! 'red) (background-named! 'green))"
     :math-program "(define (index-of name)\n  (cond ((eq? name 'black) 0) ((eq? name 'red) 8)\n        ((eq? name 'green) 11) ((eq? name 'blue) 12) (else #f)))\n;; The name space and the index space are different sets; you need the map.\n(map index-of (list 'red 'blue 'chartreuse))"
     :cs-program "(set-mode 12 6)\n(define (background-is? v) (= (pget 0 0) v))\n(set-color 'orange)\n(background (get-color))\n(display (list (background-is? 9) (background-is? 0)))"
     :explanation "eng: wrap the name-to-index conversion so it cannot be forgotten. math: see that names and indices are two different sets joined by an explicit map. cs: assert the resulting pixel, which is the only way to catch a silently-coerced symbol."
     :meta "clear has the identical problem, being the same function. set-color takes names but paints nothing. fb/rect DOES accept a symbol colour, which is what makes background's refusal surprising — but fb/rect only covers a rectangle, so using it as a full-canvas background means restating the mode's dimensions. background is the whole-canvas verb; the audit is simply that its argument must already be an index.")
    (:eng "The audit lens is 'is this argument an index or a name?' — the smoke test is reading back a pixel rather than trusting the call." :math "The palette is a map from indices to colours; symbols are not in its domain and coerce to 0." :cs "Weak coercion at a boundary; the failure mode is a plausible wrong value rather than an error."))
  :row-3-dimension (
    (:setup "One capability offered under several names, each chosen for the sentence it appears in.")
    (:rungs (
       (:domain "background"   :code "(begin (set-mode 16 8) (background 6) (pget 3 3))")
       (:domain "synonyms-in-speech" :code "(define (say-it word)\n  (cond ((eq? word 'begin) 'start) ((eq? word 'start) 'begin) (else word)))\n(map say-it (list 'begin 'start 'stop))")
       (:domain "identity-morphism" :code "(define (compose f g) (lambda (x) (f (g x))))\n(define id (lambda (x) x))\n(list ((compose id id) 5) ((compose id (lambda (x) (* x 2))) 5))")))
    (:explanation "Rung 1: background and clear are one function under two names, so the choice carries meaning to the reader and nothing to the machine. Rung 2: synonyms in speech pick out the same referent while colouring the sentence differently. Rung 3: composing with the identity leaves the function untouched, which is exactly what a rename does to behaviour. All three separate what a thing IS from what it is CALLED.")
    (:meta "The transfer works because naming is a human-facing layer over an unchanged mechanism; the danger in every substrate is assuming a different name implies a different behaviour. Grounds in book-of-code ch 05 as referential transparency and in book-of-math ch-advanced-05 as the identity morphism.")
    (:eng "Every aliasing substrate shares 'the new name is assumed to be a new behaviour' — the operator's check is proving the two names agree on a probe." :math "Two names for one element of a set; the equality is definitional, not incidental." :cs "Binding versus value; the shape of every symlink, every typedef and every re-export."))
  :row-4-proof (
    (:claim "background and clear are observationally identical: no argument and no probe can distinguish them.")
    (:program "(set-mode 16 8)\n(clear 4)\n(define a (list (pget 0 0) (pget 15 7)))\n(background 4)\n(define b (list (pget 0 0) (pget 15 7)))\n(display (list (equal? a b) a))"
     :eng-program "(set-mode 10 4)\n;; Same default, same masking, same silence about the text overlay.\n(clear)\n(define c0 (pget 2 2))\n(background)\n(define b0 (pget 2 2))\n(clear 300)\n(define c1 (pget 2 2))\n(background 300)\n(define b1 (pget 2 2))\n(display (list (= c0 b0) (= c1 b1) c1))"
     :math-program "(define (agree? f g xs) (equal? (map f xs) (map g xs)))\n;; Two functions are equal exactly when they agree everywhere on the domain.\n(display (agree? (lambda (x) (* 2 x)) (lambda (x) (+ x x)) (iota 6)))"
     :cs-program "(set-mode 8 4)\n(define (fill-and-read! f v) (f v) (list (pget 0 0) (pget 7 3)))\n(display (equal? (fill-and-read! clear 5) (fill-and-read! background 5)))"
     :invariant "∀ colour c. background(c) ≡ clear(c)  (they are the same function object, so agreement is by construction, not by coincidence)"
     :meta "The pattern is observational equivalence established by identity of the underlying object rather than by testing. Falsified if any argument produced different pixels under the two names; that would mean the alias had been re-implemented rather than re-bound, and the two could drift. book-of-code ch 05 grounds equational substitution; book-of-math ch-advanced-05 grounds the identity morphism the alias instantiates."))
    (:eng "The operator can rename background to clear anywhere in a program with no visual diff, which makes the choice purely a readability decision." :math "background and clear denote the same point in function space; the map between the names is the identity." :cs "Aliasing by value capture; the same guarantee an inlined alias gives a compiler.")
  :row-5-emergence (
    (:base "background fills the whole canvas with one colour.")
    (:composition "(set-mode 40 24)\n;; A still picture reads as a picture when the first verb is background.\n(background 12)\n(set-color 4)\n(rect-fill 0 18 40 6)\n(set-color 7)\n(disc 30 6 2)\n(display (list 'sky (pget 5 2) 'ground (pget 5 20) 'moon (pget 30 6)))"
     :eng-composition "(define (postcard bg ground sun)\n  ;; Three colours in, one scene out — the palette is the whole interface.\n  (background bg)\n  (set-color ground)\n  (rect-fill 0 16 40 8)\n  (set-color sun)\n  (disc 8 5 3)\n  (list (pget 0 0) (pget 0 20) (pget 8 5)))\n(set-mode 40 24)\n(display (list (postcard 12 3 10) (postcard 1 5 7)))"
     :math-composition "(set-mode 20 10)\n;; Background sets the measure's baseline; everything else is the deviation.\n(define (count-not v)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 10) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((= (pget x y) v) (loop (+ x 1) y n))\n          (else (loop (+ x 1) y (+ n 1))))))\n(background 2)\n(display (count-not 2))\n(rect-fill 3 3 4 2)\n(display (count-not 2))"
     :cs-composition "(set-mode 16 8)\n;; Background + snapshot = a reusable blank plate, cheaper than re-filling.\n(background 1)\n(define plate (fb-snapshot))\n(set-color 8)\n(rect-fill 4 2 6 4)\n(define drawn (pget 5 3))\n(fb-restore plate)\n(display (list drawn (pget 5 3) (pget 0 0)))"
     :emergent "A postcard scene, a three-colour scene function, a deviation-from-baseline pixel count and a reusable blank plate: naming the fill 'background' turns it from an erase into the bottom layer of a composition.")
    (:meta "This is the ground-layer family — the first fill is not a deletion but the furthest-back element of the picture. Familiar analogs are a painter's ground, a stage cyclorama and a CSS background-color under every other box. The composition works because the fill is total and opaque: nothing behind it can show through, so every later mark is unambiguously in front.")
    (:eng "The audit lens is 'is this fill an erase or a layer?' — the smoke test is whether the colour is chosen for the picture or for invisibility." :math "An opaque total fill makes the drawing order a strict ordering; later writes dominate earlier ones pointwise." :cs "Painter's algorithm; the shape of every back-to-front composite."))
)

(verb
  :name "bg-clear" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(bg-clear) | (bg-clear color) -> undefined"
  :summary "A third alias of clear: fill every pixel with one colour, defaulting to 0."
  :explanation "bg-clear is the third binding of the same function object that clear and background use. The hyphenated name reads as 'background clear' and turns up in carts that keep a background-drawing section separate from a foreground-drawing section, where the leading bg- makes the grouping obvious at a glance. There is nothing behaviourally to learn beyond clear: the argument is a palette index, the default is 0, the value is masked to a byte, the pen is untouched and the text overlay survives. Knowing that all three names are one function is itself the lesson — a rename in this codebase is not a redesign."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (bg-clear 7) (pget 1 1))" :note "7 — identical to (clear 7) and (background 7).")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (bg-clear) (pget 12 4))" :note "0 — the no-argument default is 0, the same default the other two names have.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (set-color 11) (bg-clear 2) (get-color))" :note "11 — the pen is not part of what gets cleared.")
  )
  :caveats ("Same alias, same defects: (bg-clear 300) writes 44 into every pixel because the value is masked rather than range-checked. Marked needs-alfred alongside clear." "It clears pixels only; text pushed onto the overlay by draw-text or paint-text is still there afterwards." "The bg- prefix suggests it clears only a background layer. There is no layering — it overwrites the entire canvas including anything already drawn." "It takes an index; symbols coerce to 0 rather than resolving through the palette." "There is no matching fg-clear; the prefix is a naming convention, not half of a pair.")
  :drawbacks ("A third name for one function makes grep results and reference lookups noisier without adding capability." "The prefix implies a layer system the engine does not have, which is actively misleading to a beginner." "No region form and no pattern form, exactly as with clear." "Nothing distinguishes an intentional full-canvas wipe from an accidental one late in a program.")
  :usecases ("Marking the background section of a cart so the foreground section is easy to find." "Matching an existing cart's house style when editing it rather than rewriting it." "Reading aloud in a lesson where 'background clear' is a clearer phrase than 'clear'." "Any place clear would be used; the choice is documentation only.")
  :related ("clear" "background" "paint-clear" "set-color" "rect-fill")
  :learn (:concept "Naming conventions as documentation — a prefix that groups code without changing what the code does." :prerequisites ("clear" "background") :progression "Recognise the three names, prove with a probe that they agree, then pick one per program and stay consistent.")
  :row-2-audit (
    (:problem "A cart uses clear in one place, background in another and bg-clear in a third; a reader assumes they are three different operations and spends an afternoon looking for the difference."
     :program "(set-mode 12 6)\n;; Prove it once, then stop wondering.\n(clear 5)\n(define a (pget 3 3))\n(background 5)\n(define b (pget 3 3))\n(bg-clear 5)\n(define c (pget 3 3))\n(list a b c (and (= a b) (= b c)))"
     :eng-program "(define (blank! c)\n  ;; Pick one name behind a project-local helper and the question stops arising.\n  (clear c)\n  (pget 0 0))\n(set-mode 12 6)\n(list (blank! 3) (blank! 9))"
     :math-program "(define (all-equal? xs)\n  (or (null? xs) (null? (cdr xs))\n      (and (equal? (car xs) (cadr xs)) (all-equal? (cdr xs)))))\n(list (all-equal? (list 5 5 5)) (all-equal? (list 5 5 6)))"
     :cs-program "(set-mode 8 4)\n(define (probe f) (f 6) (list (pget 0 0) (pget 7 3)))\n(display (and (equal? (probe clear) (probe background))\n              (equal? (probe background) (probe bg-clear))))"
     :explanation "eng: hide the choice behind one project-local helper so the codebase only ever shows one name. math: state the all-equal predicate the three names have to satisfy. cs: probe all three through a higher-order function, which is the cheapest possible proof."
     :meta "clear and background are the same object and so cannot be distinguished by any test. paint-clear looks like a fourth alias but is NOT — it lives in the world library, takes the same index and does the same fill, yet it is a separately defined function that could drift. set-mode also blanks the canvas but reallocates it. bg-clear is purely a naming choice within the draw library.")
    (:eng "The audit lens is 'is this a second behaviour or a second name?' — the smoke test is a two-line probe rather than an afternoon of reading." :math "Three labels on one element; the equivalence class has one member." :cs "Name-to-value indirection; distinct bindings can share a value, and usually the shared value is the truth."))
  :row-3-dimension (
    (:setup "A prefix that groups related work without changing the work itself.")
    (:rungs (
       (:domain "bg-clear"     :code "(begin (set-mode 16 8) (bg-clear 4) (pget 2 2))")
       (:domain "filing-prefix" :code "(define (bucket name)\n  (if (eq? name 'bg-sky) 'background 'other))\n(map bucket (list 'bg-sky 'bg-sea 'player))")
       (:domain "namespace"    :code "(define (qualified lib verb) (list lib verb))\n(map (lambda (v) (qualified 'draw v)) (list 'clear 'line 'rect))")))
    (:explanation "Rung 1: the bg- prefix groups the background section of a cart without altering what clear does. Rung 2: a filing prefix on a document name sorts related files together while leaving their contents untouched. Rung 3: a namespace qualifies a name so related verbs cluster, again with no effect on the values behind the names. All three add structure to the NAMES, not to the things named.")
    (:meta "The transfer works because names are a separate layer from values, and organising the name layer is cheap and reversible while reorganising the value layer is neither. Grounds in book-of-code ch 05 as binding versus value, and in book-of-eng ch 03 as naming conventions.")
    (:eng "Every naming-convention substrate shares 'the prefix is read as a promise about behaviour' — the operator's check is that the convention is documented, not inferred." :math "A labelling of a set; the labels induce a partition of the names, not of the underlying elements." :cs "Namespacing and prefixing; the shape of every module system and every file-naming scheme."))
  :row-4-proof (
    (:claim "bg-clear, background and clear are the same function object, so their agreement holds for every argument without needing to be tested per argument.")
    (:program "(set-mode 12 6)\n(define (fill-read f v) (f v) (list (pget 0 0) (pget 11 5)))\n(display (list (equal? (fill-read clear 3) (fill-read bg-clear 3))\n               (equal? (fill-read background 3) (fill-read bg-clear 3))))"
     :eng-program "(set-mode 10 4)\n;; The masking defect is shared too, which is the strongest evidence of identity.\n(clear 300)\n(define a (pget 0 0))\n(bg-clear 300)\n(define b (pget 0 0))\n(display (list a b (= a b)))"
     :math-program "(define (transitive? a b c) (and (equal? a b) (equal? b c) (equal? a c)))\n;; Equality is transitive, so two comparisons settle three names.\n(display (transitive? 5 5 5))"
     :cs-program "(set-mode 8 4)\n(define names (list clear background bg-clear))\n(define (probe f) (f 7) (pget 4 2))\n(display (map probe names))"
     :invariant "∀ colour c. bg-clear(c) ≡ background(c) ≡ clear(c)  (one object, three bindings; equality is by construction)"
     :meta "The pattern is that identity of reference gives equality for free, where identity of behaviour would have to be established argument by argument. Falsified if any single argument split the three names apart; that would prove they had been separately implemented and could diverge under maintenance. book-of-code ch 05 grounds referential identity; book-of-math ch-advanced-02 grounds the transitivity of equality."))
    (:eng "The operator does not need a per-argument test suite; proving the bindings share an object proves agreement everywhere." :math "Equality of references implies extensional equality; transitivity closes the third comparison for free." :cs "Reference equality versus structural equality; the strongest form of alias guarantee.")
  :row-5-emergence (
    (:base "bg-clear fills the whole canvas with one colour.")
    (:composition "(set-mode 40 24)\n;; The prefix earns its keep when a cart has explicit background and foreground passes.\n(define (background-pass!) (bg-clear 1) (set-color 5) (rect-fill 0 20 40 4))\n(define (foreground-pass!) (set-color 10) (disc 20 10 4))\n(background-pass!)\n(foreground-pass!)\n(display (list 'bg (pget 2 2) 'ground (pget 2 21) 'fg (pget 20 10)))"
     :eng-composition "(define (render! passes)\n  ;; Passes run in order; the bg- prefix tells a reader which one goes first.\n  (for-each (lambda (p) (p)) passes)\n  'rendered)\n(set-mode 20 10)\n(render! (list (lambda () (bg-clear 12))\n               (lambda () (set-color 3) (rect-fill 0 7 20 3))\n               (lambda () (set-color 7) (pset 10 2))))\n(display (list (pget 0 0) (pget 0 8) (pget 10 2)))"
     :math-composition "(set-mode 20 10)\n;; Ordering matters: the last write at a coordinate wins.\n(bg-clear 2)\n(set-color 8)\n(rect-fill 5 3 6 4)\n(bg-clear 2)\n(display (list 'after-second-clear (pget 7 5)))"
     :cs-composition "(set-mode 16 8)\n;; A pass list makes the frame reproducible; re-running gives the same pixels.\n(define (frame!)\n  (bg-clear 1)\n  (set-color 9)\n  (rect-fill 3 2 5 3))\n(frame!)\n(define a (list (pget 0 0) (pget 4 3)))\n(frame!)\n(display (list a (equal? a (list (pget 0 0) (pget 4 3)))))"
     :emergent "A two-pass render, an ordered pass list, a demonstration that a late clear destroys earlier work, and a reproducible frame: naming the wipe bg- makes the pass ORDER part of the code's vocabulary.")
    (:meta "This is the render-pass family — split a frame into named ordered stages so each stage's job is obvious and its position is enforced by the list rather than by memory. Familiar analogs are a print run's colour passes, a build pipeline's stages and a graphics API's render passes. The composition works because the fill is total: a background pass placed second would erase the foreground, and the naming is what stops that.")
    (:eng "The audit lens is 'is the background pass actually first?' — the smoke test is probing a foreground pixel after the whole frame runs." :math "Pixel writes form a sequence where the last write at each coordinate determines the value; pass order is the ordering." :cs "Ordered render passes; the shape of every pipeline whose stages are not commutative."))
)
(verb
  :name "pset" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(pset x y) | (pset x y color) -> undefined"
  :summary "Write one pixel at (x, y), in the pen colour or in an explicitly given palette index. Returns nothing."
  :explanation "pset is the atom of the raster surface — every other drawing verb in this library is ultimately a loop over pset. Coordinates are integers counted from the top-left corner, so (0, 0) is the first pixel and (w-1, h-1) is the last. Fractional coordinates are truncated toward zero, not rounded. The third argument is optional: leave it off and the pixel takes the current pen colour set by set-color, supply it and the pen is bypassed for this one write without being changed. A coordinate outside the canvas is silently discarded, which makes it safe to plot a whole shape and let the edges fall off, but also means a program with the axes swapped can paint nothing at all and raise nothing at all."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (clear 0) (pset 3 3 9) (pget 3 3))" :note "9 — the explicit colour is written straight into the pixel.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (clear 0) (set-color 11) (pset 4 4) (pget 4 4))" :note "11 — with no third argument the pixel takes the current pen.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (clear 0) (pset 500 500 9) (pset 5.9 5.9 6) (list (pget 5 5) (pget 6 6)))" :note "(6 0) — the off-canvas write vanished silently, and 5.9 truncated DOWN to 5, so the pixel is at (5 5) and (6 6) is untouched.")
  )
  :caveats ("IT DOES NOT ACCEPT COLOUR NAMES. (pset 3 3 'red) writes 0, not 8 — the symbol is coerced to a byte rather than looked up. Only set-color resolves names. Marked needs-alfred." "The colour is masked, not wrapped: (pset 1 1 300) leaves 44 and (pset 1 1 -1) leaves 255, both outside the 16-entry palette. set-color would have wrapped them to 4 and 15." "Off-canvas writes are silent. A program drawing entirely off-screen looks identical to one drawing nothing; there is no error and no return value to check." "Coordinates truncate toward zero rather than rounding, so (pset 5.9 5.9) lands at (5 5)." "It returns nothing, so it cannot be used as the last expression of a function that is expected to report what it did.")
  :drawbacks ("No blending, no alpha and no read-modify-write: every pset is an opaque overwrite." "One call per pixel makes it the slowest way to fill any area; rect-fill and disc exist because of this." "There is no bounds-checked variant that reports a rejected write, so typos are invisible." "The optional third argument makes arity errors impossible to catch — a stray extra argument is simply ignored.")
  :usecases ("Plotting a single point: a star, a cursor, a data sample." "Writing a rasteriser of your own, one pixel at a time, when no built-in shape fits." "Building a test fixture where an exact known pixel pattern has to be laid down." "Poking a marker pixel to prove a coordinate calculation landed where you expected.")
  :related ("pget" "pixel" "put-pixel" "set-pixel!" "plot-pixel" "set-color")
  :learn (:concept "The primitive write — the smallest operation from which every larger drawing is composed." :prerequisites ("set-mode" "set-color") :progression "Set one pixel, read it back with pget, then write a loop that psets a line and compare it with the built-in line verb.")
  :row-2-audit (
    (:problem "A plotting routine draws nothing at all and raises nothing at all, because x and y were passed in the wrong order and every write landed off the tall, narrow canvas."
     :program "(set-mode 8 40)\n;; Read the pixel back: a silent write is indistinguishable from no write.\n(clear 0)\n(pset 30 4 9)\n(pset 4 30 9)\n(list 'swapped (pget 30 4) 'correct (pget 4 30))"
     :eng-program "(define (pset-checked! x y c)\n  ;; Wrap the primitive so a rejected write becomes a value you can test.\n  (pset x y c)\n  (if (= (pget x y) c) 'wrote 'rejected))\n(set-mode 8 40)\n(clear 0)\n(list (pset-checked! 4 30 9) (pset-checked! 30 4 9))"
     :math-program "(define (in-canvas? x y w h)\n  (and (>= x 0) (>= y 0) (< x w) (< y h)))\n;; The canvas is a rectangle of the integer lattice; membership is decidable.\n(list (in-canvas? 30 4 8 40) (in-canvas? 4 30 8 40))"
     :cs-program "(set-mode 8 40)\n(clear 0)\n(define (any-set?)\n  (let loop ((x 0) (y 0))\n    (cond ((>= y 40) #f)\n          ((>= x 8) (loop 0 (+ y 1)))\n          ((> (pget x y) 0) #t)\n          (else (loop (+ x 1) y)))))\n(pset 30 4 9)\n(display (any-set?))"
     :explanation "eng: wrap pset so a rejected write returns a symbol instead of nothing. math: state the membership predicate the coordinates have to satisfy. cs: scan the whole canvas to prove that a plotting routine actually deposited something."
     :meta "pget reads but cannot write, so it diagnoses rather than fixes. rect-fill covers an area and would make the same mistake at larger scale. line clips the same way and is equally silent. pset is the verb where the silence originates, so it is the right place to install the check — everything above it inherits the behaviour.")
    (:eng "The audit lens is 'did the write land?' — the smoke test is a read-back, because the verb itself reports nothing." :math "The write is a partial function on ℤ² whose domain is [0,w)×[0,h); outside it the operation is the identity." :cs "Silent bounds clipping; safe against crashes, unsafe against typos."))
  :row-3-dimension (
    (:setup "The smallest addressable write, from which every larger structure is built by repetition.")
    (:rungs (
       (:domain "pset"          :code "(begin (set-mode 16 8) (clear 0) (pset 2 3 7) (pget 2 3))")
       (:domain "single-stitch" :code "(define (row-of n stitch) (map (lambda (i) stitch) (iota n)))\n(list (row-of 4 'knit) (length (row-of 4 'knit)))")
       (:domain "unit-vector"   :code "(define (unit i n) (map (lambda (j) (if (= i j) 1 0)) (iota n)))\n(list (unit 2 5) (apply + (unit 2 5)))")))
    (:explanation "Rung 1: pset changes exactly one cell, and every shape verb is a loop over it. Rung 2: a single stitch changes exactly one intersection of a fabric, and a garment is a loop over stitches. Rung 3: a unit vector is nonzero in exactly one coordinate, and every vector is a sum of scaled unit vectors. All three are the same idea — pick a basis element that touches exactly one place, and build everything by combining copies of it.")
    (:meta "The transfer works because a basis of single-point changes makes any configuration reachable and makes reasoning local: to know the result you only need to know which points were touched and in what order. Grounds in book-of-math ch-advanced-03 as basis and span, and in book-of-code ch 11 as the primitive store operation.")
    (:eng "Every atomic-write substrate shares 'the primitive is correct but the loop over it is not' — the operator's check is to test the loop's coverage, not the primitive." :math "Single-point writes span the configuration space; any picture is a finite sum of them." :cs "The store primitive; the shape of every array assignment and every memory write."))
  :row-4-proof (
    (:claim "pset is the last-writer-wins primitive: writing twice to one coordinate leaves the second value, and writing to different coordinates commutes.")
    (:program "(set-mode 16 8)\n(clear 0)\n(pset 4 4 3)\n(pset 4 4 9)\n(define overwritten (pget 4 4))\n(clear 0)\n(pset 1 1 3)\n(pset 6 6 9)\n(define a (list (pget 1 1) (pget 6 6)))\n(clear 0)\n(pset 6 6 9)\n(pset 1 1 3)\n(display (list overwritten a (equal? a (list (pget 1 1) (pget 6 6)))))"
     :eng-program "(set-mode 12 6)\n(clear 0)\n;; Order only matters where the writes collide.\n(pset 3 3 5)\n(pset 3 3 6)\n(pset 3 3 7)\n(display (pget 3 3))"
     :math-program "(define (last-of xs) (if (null? (cdr xs)) (car xs) (last-of (cdr xs))))\n;; A sequence of assignments to one cell is the projection onto its last element.\n(display (list (last-of (list 5 6 7)) (last-of (list 7 6 5))))"
     :cs-program "(set-mode 10 4)\n(define (write-all! ps)\n  (clear 0)\n  (for-each (lambda (p) (pset (car p) (cadr p) (caddr p))) ps)\n  (list (pget 1 1) (pget 8 2)))\n(define forward (list (list 1 1 4) (list 8 2 9)))\n(define backward (list (list 8 2 9) (list 1 1 4)))\n(display (equal? (write-all! forward) (write-all! backward)))"
     :invariant "∀ (x,y) c₁ c₂. pset(x,y,c₁) then pset(x,y,c₂) ⇒ pget(x,y) = c₂  ∧  ∀ distinct coordinates p ≠ q. pset(p) and pset(q) commute"
     :meta "The pattern is a disjoint-store semantics: writes to different addresses are independent, and writes to the same address are ordered by time. Falsified if reordering two writes to different pixels changed the picture; that would mean the framebuffer had hidden coupling between cells, and no drawing verb could be reasoned about locally. book-of-code ch 11 grounds the store model; book-of-math ch-advanced-02 grounds commutativity on disjoint supports."))
    (:eng "The operator can reorder independent drawing steps freely and only has to think about order where two steps touch the same pixel." :math "Writes with disjoint support commute; writes with equal support compose as last-wins." :cs "Non-aliasing stores commute; the same property that licenses instruction reordering and parallel rasterisation.")
  :row-5-emergence (
    (:base "pset writes one pixel.")
    (:composition "(set-mode 32 16)\n(clear 0)\n;; A hand-rolled rasteriser: every curve is just a loop over pset.\n(define (parabola!)\n  (for-each\n    (lambda (x)\n      (let ((y (quotient (* (- x 16) (- x 16)) 16)))\n        (pset x y 10)))\n    (iota 32)))\n(parabola!)\n(display (list (pget 16 0) (pget 0 15) (pget 31 14)))"
     :eng-composition "(define (scatter! points c)\n  ;; The primitive plus a list of coordinates is a whole plotting library.\n  (for-each (lambda (p) (pset (car p) (cadr p) c)) points)\n  (length points))\n(set-mode 20 10)\n(clear 0)\n(display (list (scatter! (list (list 1 1) (list 5 5) (list 9 2)) 8)\n               (pget 5 5) (pget 9 2)))"
     :math-composition "(set-mode 32 16)\n(clear 0)\n;; Sampling a function at integer x is exactly a sequence of psets.\n(define (sample! f c)\n  (for-each (lambda (x)\n              (let ((y (f x)))\n                (if (and (>= y 0) (< y 16)) (pset x y c))))\n            (iota 32)))\n(sample! (lambda (x) (quotient x 2)) 11)\n(display (list (pget 0 0) (pget 10 5) (pget 30 15)))"
     :cs-composition "(set-mode 16 8)\n(clear 0)\n;; Compare a hand loop against the built-in: the primitive is the reference.\n(define (my-hline! x0 x1 y c)\n  (for-each (lambda (i) (pset (+ x0 i) y c)) (iota (- x1 x0))))\n(my-hline! 2 10 3 9)\n(define mine (map (lambda (x) (pget x 3)) (iota 16)))\n(clear 0)\n(set-color 9)\n(line 2 3 9 3)\n(display (list mine (equal? mine (map (lambda (x) (pget x 3)) (iota 16)))))"
     :emergent "A parabola, a scatter plot, a sampled function and a hand-written line checked against the built-in: with pset and a loop you can build any rasteriser, and you can use it to audit the ones you were given.")
    (:meta "This is the primitive-plus-iteration family — a single-element operation combined with a traversal generates the whole space of drawings. Familiar analogs are a plotter pen, a dot-matrix print head and a shader writing one fragment. The composition works because pset is total over the canvas and independent between coordinates, so any traversal order produces the same picture.")
    (:eng "The audit lens is 'does my loop cover what I think it covers?' — the smoke test is comparing a hand loop against the built-in verb pixel by pixel." :math "Iterating a single-point write over an index set realises the characteristic function of that set." :cs "Map-over-index with a store primitive; the shape of every rasteriser ever written."))
)

(verb
  :name "pget" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(pget x y) -> integer"
  :summary "Read the palette index stored at pixel (x, y). Off-canvas coordinates return 0."
  :explanation "pget is the only way a Scheme program can look at what it has drawn. It returns the raw byte stored in the framebuffer at that coordinate — a palette index in 0..15 for anything drawn normally, or an out-of-palette byte if a verb that masks rather than wraps was given a bad colour. It is the counterpart of pset and the foundation of every test in this chapter: because drawing verbs return nothing, a read-back is the only observable evidence that a drawing happened. Coordinates truncate toward zero, so (pget 4.7 4.2) reads pixel (4, 4). Anything outside the canvas returns 0 rather than raising."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(pget 0 0)" :note "0 — a fresh canvas is all zeroes, so the first pixel reads 0.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (clear 6) (pget 12 4))" :note "6 — after a clear every coordinate reads back the fill colour.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (clear 0) (pset 4 4 5) (list (pget 4.7 4.2) (pget 999 999)))" :note "(5 0) — coordinates truncate, and a far-off-canvas read returns 0 rather than raising.")
  )
  :caveats ("OUT-OF-BOUNDS IS INDISTINGUISHABLE FROM BLACK. (pget 999 999) returns 0, and so does a legitimately black pixel. A loop that walks off the edge reports a plausible answer instead of failing. Marked needs-alfred." "It returns a raw byte, not a validated palette index. After (clear 300) every pixel reads 44, which is not a colour in the 16-entry palette." "It reads pixels only. Text drawn with draw-text lives on a separate overlay and is invisible to pget — (pget 10 20) after (draw-text \"hi\" 10 20) is still 0." "Fractional coordinates truncate toward zero rather than rounding, which shifts a sampled read by one pixel below the .5 boundary." "It reads the CURRENT framebuffer; after set-mode or fb-restore that is a different buffer than the one you drew on.")
  :drawbacks ("One call per pixel makes a whole-canvas scan O(w·h) interpreter calls, which is slow enough to notice at 320x240." "No region form: there is no way to read a rectangle or a row in one call." "No way to distinguish 'off canvas' from 'black', so bounds bugs stay hidden." "It gives you the index, never the RGB, so comparing against a colour name means knowing the palette by heart.")
  :usecases ("Asserting in a test that a drawing verb painted where it was supposed to." "Sampling the canvas to build a histogram or count how much of it is a given colour." "Reading a colour back so a later shape can match it." "Debugging a coordinate calculation by probing the exact pixel you expected to hit.")
  :related ("pset" "fb/pixel" "clear" "set-color" "fb-snapshot")
  :learn (:concept "Observability — a write-only system cannot be tested, so the read primitive is what makes the drawing library verifiable." :prerequisites ("set-mode" "pset") :progression "Read a blank canvas, clear and read again, then write a loop that scans the whole canvas and counts colours.")
  :row-2-audit (
    (:problem "A test loop reports that a shape was drawn correctly, but the loop's bounds run one past the canvas edge and every off-canvas read silently returns 0, which the test happily counts as background."
     :program "(set-mode 8 4)\n(clear 3)\n;; The loop below reads 5 columns of a 4-wide-tall canvas: the extras read 0.\n(define (row y n) (map (lambda (x) (pget x y)) (iota n)))\n(list 'in-bounds (row 0 8) 'over-run (row 0 10))"
     :eng-program "(define (pget-checked x y w h)\n  ;; Make the boundary explicit so an over-run is a distinguishable value.\n  (if (and (>= x 0) (>= y 0) (< x w) (< y h))\n      (pget x y)\n      'off-canvas))\n(set-mode 8 4)\n(clear 3)\n(list (pget-checked 7 3 8 4) (pget-checked 8 3 8 4))"
     :math-program "(define (clamp v lo hi) (max lo (min hi v)))\n;; Reads outside the domain must be excluded, not silently mapped to a value.\n(map (lambda (x) (clamp x 0 7)) (list -2 3 9))"
     :cs-program "(set-mode 8 4)\n(clear 3)\n(define (count-bg w h)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y h) n)\n          ((>= x w) (loop 0 (+ y 1) n))\n          ((= (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (count-bg 8 4) (count-bg 10 6)))"
     :explanation "eng: return a distinguishable symbol for off-canvas so an over-run cannot pass as data. math: clamp or exclude rather than letting the domain leak. cs: run the same census at the true size and at an inflated size to see the phantom background appear."
     :meta "fb/pixel has exactly the same behaviour and the same blind spot, so switching verbs does not help. mode-info gives the true dimensions and is the fix — bounds should come from it rather than from a literal. fb-snapshot returns the whole buffer at once and carries its own width, which sidesteps the problem entirely for whole-canvas work. pget is the right verb for a single probe; the audit is that its silence on bounds must be compensated by the caller.")
    (:eng "The audit lens is 'where did my loop bounds come from?' — the smoke test is running the census at two sizes and watching the count change." :math "The read is a total function on ℤ² that agrees with the buffer only inside the canvas; outside it is constantly 0." :cs "Saturating read; convenient at the edge of a filter, dangerous as a bounds check."))
  :row-3-dimension (
    (:setup "A read that answers even outside its meaningful range, which hides the boundary from the caller.")
    (:rungs (
       (:domain "pget"          :code "(begin (set-mode 8 4) (clear 5) (list (pget 0 0) (pget 99 99)))")
       (:domain "empty-lookup"  :code "(define (lookup k table)\n  (let ((hit (assq k table)))\n    (if hit (cdr hit) 0)))\n(define t (list (cons 'a 5) (cons 'b 6)))\n(list (lookup 'a t) (lookup 'z t))")
       (:domain "zero-extension" :code "(define (extend f lo hi)\n  (lambda (x) (if (and (>= x lo) (< x hi)) (f x) 0)))\n(define g (extend (lambda (x) (* x x)) 0 4))\n(map g (list 0 2 3 9))")))
    (:explanation "Rung 1: pget answers 0 off the canvas, so a bad coordinate looks like a black pixel. Rung 2: a lookup that defaults to 0 makes a missing key look like a key whose value is 0. Rung 3: zero-extending a function outside its domain makes 'undefined here' look like 'zero here'. All three trade an error for a plausible value, and in all three the caller must supply the boundary the callee refused to enforce.")
    (:meta "The transfer works because a total function is easier to compose than a partial one, and the price is always the same: absence becomes indistinguishable from a legitimate value. Grounds in book-of-code ch 05 as the null-versus-zero confusion, and in book-of-math ch-advanced-01 as extension of a function beyond its domain.")
    (:eng "Every zero-extending substrate shares 'missing read as zero' — the operator's check is a separate membership test before the read." :math "Zero extension makes a partial function total at the cost of injectivity on the value 0." :cs "Default-on-miss; the shape of every lookup that returns a zero value instead of a not-found signal."))
  :row-4-proof (
    (:claim "pget inverts pset exactly inside the canvas: whatever byte was written is the byte read back, and nothing else on the canvas changed.")
    (:program "(set-mode 16 8)\n(clear 0)\n(pset 5 5 9)\n(define wrote (pget 5 5))\n(define neighbours (list (pget 4 5) (pget 6 5) (pget 5 4) (pget 5 6)))\n(display (list wrote neighbours))"
     :eng-program "(set-mode 12 6)\n(clear 0)\n;; Round-trip every palette index through the same pixel.\n(define (round-trip c) (pset 3 3 c) (pget 3 3))\n(display (map round-trip (iota 16)))"
     :math-program "(define (round-trip-eq? xs f g)\n  (equal? xs (map (lambda (x) (g (f x))) xs)))\n;; g∘f = identity on the domain is exactly what a read-after-write asserts.\n(display (round-trip-eq? (iota 16) (lambda (x) (* x 1)) (lambda (x) (* x 1))))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(define (untouched-count)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 4) n)\n          ((>= x 8) (loop 0 (+ y 1) n))\n          ((= (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(pset 2 2 7)\n(display (list (untouched-count) (- 32 1)))"
     :invariant "∀ (x,y) in the canvas, ∀ byte c. pset(x,y,c) then pget(x,y) = c  ∧  ∀ q ≠ (x,y). pget(q) is unchanged"
     :meta "The pattern is a store-load round trip with disjointness — the read is the exact inverse of the write at the same address, and the write has no effect anywhere else. Falsified if a write ever perturbed a neighbouring pixel; that would mean the framebuffer had internal coupling and no local reasoning about drawing would be valid. book-of-code ch 11 grounds load-after-store; book-of-math ch-advanced-01 grounds the left-inverse."))
    (:eng "The operator can trust a read-back as evidence of a write, and can trust that probing one pixel says nothing about its neighbours by accident." :math "pget is a left inverse of pset on the canvas, and pset's support is the singleton it names." :cs "Load-after-store to the same address returns the stored value; the memory model every rasteriser assumes.")
  :row-5-emergence (
    (:base "pget reads one pixel.")
    (:composition "(set-mode 20 10)\n(clear 2)\n(set-color 9)\n(rect-fill 4 3 6 4)\n;; A census turns the canvas into data: how much of it is the shape?\n(define (count v)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 10) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((= (pget x y) v) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list 'shape (count 9) 'expected (* 6 4) 'background (count 2)))"
     :eng-composition "(define (canvas->rows w h)\n  ;; Reading the buffer into a list makes it printable, diffable and testable.\n  (map (lambda (y) (map (lambda (x) (pget x y)) (iota w))) (iota h)))\n(set-mode 8 4)\n(clear 0)\n(set-color 7)\n(rect-fill 1 1 3 2)\n(display (canvas->rows 8 4))"
     :math-composition "(set-mode 20 10)\n(clear 0)\n(set-color 11)\n(disc 10 5 4)\n;; Counting filled pixels estimates area; the disc's area should be near πr².\n(define (filled)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 10) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (filled) (* 3 4 4)))"
     :cs-composition "(set-mode 8 4)\n;; Two renders, one comparison: pget turns drawing into a regression test.\n(define (render!)\n  (clear 1)\n  (set-color 8)\n  (rect-fill 2 1 3 2))\n(define (dump) (map (lambda (y) (map (lambda (x) (pget x y)) (iota 8))) (iota 4)))\n(render!)\n(define a (dump))\n(render!)\n(display (list (equal? a (dump)) (car a)))"
     :emergent "A colour census, a canvas-to-list dump, a pixel-counted area estimate and a golden-image regression test: one read primitive plus a traversal turns an opaque framebuffer into ordinary data.")
    (:meta "This is the observe-to-verify family — a system you cannot read is a system you cannot test, so the read primitive is what promotes drawing from a side effect to a value. Familiar analogs are a screenshot diff in a UI test suite, a checksum over a buffer and a sensor reading that closes a control loop. The composition works because pget is pure and total: scanning changes nothing, so a scan can be repeated and compared.")
    (:eng "The audit lens is 'can I see what the program drew?' — the smoke test is dumping the canvas and comparing two runs." :math "A traversal of a total read realises the pixel field as a function, which can then be measured, integrated or compared." :cs "Read-back verification; the shape of every golden-image test and every buffer checksum."))
)

(verb
  :name "pixel" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(pixel x y) | (pixel x y color) -> undefined"
  :summary "An alias of pset: write one pixel at (x, y), in the pen colour or an explicit palette index."
  :explanation "pixel is the same function object as pset, bound under the name that reads most plainly in English. The engine captures pset's value and re-defines it four more times — as pixel, put-pixel, set-pixel! and plot-pixel — so all five are indistinguishable at runtime. The name pixel is the one to reach for in teaching material and in code that a beginner will read, because 'pixel at four four in colour nine' needs no glossary. Everything true of pset is true here: the third argument is optional, off-canvas writes are discarded silently, colours are masked rather than wrapped, and symbols are not resolved."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (clear 0) (pixel 4 4 12) (pget 4 4))" :note "12 — same behaviour as pset, friendlier name.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (clear 0) (set-color 6) (pixel 2 2) (pget 2 2))" :note "6 — with the colour omitted the pen is used, exactly as with pset.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (clear 0) (pixel 1 1 5) (pset 2 2 5) (list (pget 1 1) (pget 2 2)))" :note "(5 5) — the two names cannot be told apart by any probe.")
  )
  :caveats ("It is an alias, so every pset defect is present: (pixel 3 3 'red) writes 0, (pixel 3 3 300) writes 44, and (pixel 500 500 9) writes nothing at all and says nothing about it. Marked needs-alfred alongside pset." "The name is a noun, which invites (define p (pixel 4 4)) — but it returns nothing, so p is bound to an empty value." "It does not read a pixel; pget does that. The noun name makes this ambiguity easy to fall into." "Coordinates truncate toward zero rather than rounding." "Redefining pset does not redefine pixel; the alias captured the function object at install time.")
  :drawbacks ("Five names for one function makes searching a codebase for pixel writes needlessly awkward." "The noun name reads as a getter to anyone coming from another language where pixel(x, y) returns a colour." "No arity error is possible, so a mistyped call with a stray argument is silently accepted." "Nothing groups the five aliases in error messages, so a stack trace names whichever one was called.")
  :usecases ("Teaching material and first programs, where the plainest English word wins." "Code that reads aloud in a lesson: 'pixel two two colour six'." "Matching an existing cart's style rather than rewriting its calls." "Any place pset would be used; the choice is readability only.")
  :related ("pset" "put-pixel" "set-pixel!" "plot-pixel" "pget")
  :learn (:concept "Choosing among synonyms for the reader's benefit, once you know the machine cannot tell them apart." :prerequisites ("pset") :progression "Write the same drawing twice, once with pset and once with pixel, and compare the canvases to see they agree.")
  :row-2-audit (
    (:problem "A learner writes (define c (pixel 4 4)) expecting to read the colour back, and gets an empty value that then breaks every arithmetic operation downstream."
     :program "(set-mode 16 8)\n(clear 0)\n(pixel 4 4 9)\n;; pixel WRITES. pget READS. The noun name does not change that.\n(list 'read-back (pget 4 4))"
     :eng-program "(define (pixel! x y c)\n  ;; A bang suffix tells the reader this is a write, which the alias does not.\n  (pixel x y c)\n  (pget x y))\n(set-mode 16 8)\n(clear 0)\n(list (pixel! 2 2 7) (pixel! 3 3 11))"
     :math-program "(define (returns-value? f) (if (equal? (f) 'nothing) #f #t))\n;; A mutation and a query are different kinds of thing; only one has a value.\n(display (list (returns-value? (lambda () 5)) (returns-value? (lambda () 'nothing))))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(pixel 1 1 6)\n(define ok (= (pget 1 1) 6))\n(display (list ok 'writes-return-nothing))"
     :explanation "eng: name your own wrapper with a bang so the write/read distinction survives. math: separate the query from the command; only the query has a value. cs: verify the write through the reader rather than through the writer's return."
     :meta "pset has the same behaviour but a verb-shaped name, so it does not invite the mistake. set-pixel! carries a bang and is the clearest of the five about being a mutation. pget is the verb that actually returns a colour. pixel is the friendliest name and the most misleading one, which is exactly why the audit belongs here.")
    (:eng "The audit lens is 'does this name promise a value it does not return?' — the smoke test is trying to bind its result." :math "Command-query separation: a command changes state and returns nothing, a query returns a value and changes nothing." :cs "Nouns as procedure names; the shape of every API where a getter and a setter share a word."))
  :row-3-dimension (
    (:setup "A name that describes the THING acted on rather than the ACTION taken.")
    (:rungs (
       (:domain "pixel"        :code "(begin (set-mode 16 8) (clear 0) (pixel 5 2 3) (pget 5 2))")
       (:domain "noun-as-verb" :code "(define (chair action) (if (eq? action 'sit) 'seated 'standing))\n(list (chair 'sit) (chair 'look))")
       (:domain "operator-name" :code "(define (plus a b) (+ a b))\n(define (sum xs) (apply + xs))\n(list (plus 2 3) (sum (list 2 3)))")))
    (:explanation "Rung 1: pixel names the thing written, not the writing, so it can be misread as a way of getting a pixel. Rung 2: a noun used as a verb is ambiguous until the context supplies the action. Rung 3: plus names an operation while sum names its result, and confusing them changes what you expect back. All three show the same hazard — a name that identifies an object leaves the caller to guess whether they are getting it or changing it.")
    (:meta "The transfer works because names carry expectations about return values, and a noun sets no expectation at all. That is why command-query separation is usually enforced by naming convention rather than by the type system in dynamically typed languages. Grounds in book-of-eng ch 03 as naming discipline and in book-of-code ch 05 as command-query separation.")
    (:eng "Every noun-named-procedure substrate shares 'is this a getter or a setter?' — the operator's check is to read the signature, never the name." :math "A function's name is metadata; only its domain and codomain determine what it does." :cs "Command-query separation; the shape of every API where naming has to carry what types do not."))
  :row-4-proof (
    (:claim "pixel and pset are the same function object, so they agree on every coordinate and every colour, including the malformed ones.")
    (:program "(set-mode 16 8)\n(clear 0)\n(pixel 3 3 9)\n(pset 4 4 9)\n(display (list (pget 3 3) (pget 4 4) (= (pget 3 3) (pget 4 4))))"
     :eng-program "(set-mode 12 6)\n(clear 0)\n;; The shared defect is the proof: both mask the colour identically.\n(pixel 1 1 300)\n(pset 2 2 300)\n(display (list (pget 1 1) (pget 2 2) (= (pget 1 1) (pget 2 2))))"
     :math-program "(define (agree-on? f g xs) (equal? (map f xs) (map g xs)))\n(display (agree-on? (lambda (x) (+ x 0)) (lambda (x) (- x 0)) (iota 8)))"
     :cs-program "(set-mode 8 4)\n(define (probe f y) (clear 0) (f 2 y 7) (pget 2 y))\n(display (equal? (map (lambda (y) (probe pixel y)) (iota 4))\n                 (map (lambda (y) (probe pset y)) (iota 4))))"
     :invariant "∀ x y c. pixel(x,y,c) ≡ pset(x,y,c)  (one function object under two bindings)"
     :meta "The pattern is that shared defects are stronger evidence of identity than shared correct behaviour, because two independent implementations would be unlikely to reproduce the same masking quirk. Falsified if any input separated the two names; that would prove the alias is a reimplementation and could drift. book-of-code ch 05 grounds observational equivalence; book-of-eng ch 07 grounds the use of shared failure modes as evidence of shared code."))
    (:eng "The operator can substitute pixel for pset anywhere without a visual diff, and knows a fix to one is automatically a fix to the other." :math "Two labels on one element of function space; equality is definitional." :cs "Value-captured alias; the same guarantee an inlined alias gives.")
  :row-5-emergence (
    (:base "pixel writes one pixel.")
    (:composition "(set-mode 32 16)\n(clear 0)\n;; A sprite as data: a list of rows, painted one pixel at a time.\n(define heart\n  (list (list 0 1 0 1 0)\n        (list 1 1 1 1 1)\n        (list 0 1 1 1 0)\n        (list 0 0 1 0 0)))\n(define (blit! rows ox oy c)\n  (let loop ((rs rows) (y 0))\n    (if (null? rs) 'done\n        (begin\n          (let inner ((cs (car rs)) (x 0))\n            (if (null? cs) 'row\n                (begin\n                  (if (= (car cs) 1) (pixel (+ ox x) (+ oy y) c))\n                  (inner (cdr cs) (+ x 1)))))\n          (loop (cdr rs) (+ y 1))))))\n(blit! heart 4 4 8)\n(display (list (pget 5 4) (pget 4 4) (pget 6 7)))"
     :eng-composition "(define (draw-list! coords c)\n  ;; A drawing is a list of coordinates; the primitive turns it into pixels.\n  (for-each (lambda (p) (pixel (car p) (cadr p) c)) coords)\n  (length coords))\n(set-mode 16 8)\n(clear 0)\n(display (list (draw-list! (list (list 1 1) (list 2 2) (list 3 3)) 10)\n               (pget 2 2)))"
     :math-composition "(set-mode 16 16)\n(clear 0)\n;; The diagonal is the set {(i,i)} — one pixel per index.\n(for-each (lambda (i) (pixel i i 11)) (iota 16))\n(display (list (pget 0 0) (pget 8 8) (pget 15 15) (pget 8 9)))"
     :cs-composition "(set-mode 16 8)\n;; Sprite data plus a blitter is a whole graphics system in twenty lines.\n(define (row->pixels! row y c)\n  (let loop ((cs row) (x 0))\n    (if (null? cs) x\n        (begin (if (= (car cs) 1) (pixel x y c)) (loop (cdr cs) (+ x 1))))))\n(clear 0)\n(display (list (row->pixels! (list 1 0 1 0 1) 2 9) (pget 0 2) (pget 1 2)))"
     :emergent "A sprite blitter, a coordinate-list painter, a diagonal and a row painter: the primitive write plus a data structure is the whole of sprite graphics.")
    (:meta "This is the data-driven drawing family — separate WHAT to draw (a list, a grid, a bitmap) from HOW to draw it (a loop over the primitive), so the picture becomes editable data rather than code. Familiar analogs are tile maps, font glyph bitmaps and stencil masks. The composition works because the primitive is uniform: every element of the data is turned into pixels by the identical operation.")
    (:eng "The audit lens is 'is the picture data or is it code?' — the smoke test is whether changing the picture requires editing a loop." :math "A bitmap is the characteristic function of a subset of the lattice; blitting is its translation by an offset." :cs "Data-driven rendering; the shape of every tile engine and every bitmap font."))
)

(verb
  :name "put-pixel" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(put-pixel x y) | (put-pixel x y color) -> undefined"
  :summary "An alias of pset: write one pixel at (x, y), in the pen colour or an explicit palette index."
  :explanation "put-pixel is the same function object as pset, bound under the name that older graphics libraries used. Anyone who has written BASIC, Pascal or C against a VGA framebuffer will type put-pixel from muscle memory, and the engine obliges. The verb-object shape of the name is its virtue: put makes it unmistakably a write, which the bare noun pixel does not. Behaviourally there is nothing new — the colour argument is optional, off-canvas writes are dropped in silence, colours are masked to a byte rather than wrapped into the palette, and symbols are coerced to 0 instead of being looked up."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (clear 0) (put-pixel 5 5 11) (pget 5 5))" :note "11 — the classic name for the classic operation.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (clear 0) (set-color 8) (put-pixel 6 2) (pget 6 2))" :note "8 — the colour argument is optional here as everywhere in the family.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (clear 0) (put-pixel 1 1 300) (pget 1 1))" :note "44 — the colour is masked to a byte, so 300 becomes 44, an index outside the 16-entry palette.")
  )
  :caveats ("It is an alias, so every pset defect applies unchanged: silent off-canvas writes, masked colours, and symbols coerced to 0. Marked needs-alfred alongside pset." "In several older libraries putpixel took a colour as a REQUIRED third argument; here it is optional and defaults to the pen, so an omitted colour silently uses whatever set-color left behind." "The familiar name may lead a programmer to expect a matching getpixel; the reader here is pget, not get-pixel." "Off-canvas writes are discarded rather than wrapped, unlike some retro libraries that wrapped around the screen edge." "Coordinates truncate toward zero rather than rounding.")
  :drawbacks ("The retro name may imply retro semantics that this engine does not have, such as page flipping or direct memory access." "Five aliases means a codebase can use all five and still be internally consistent with none of them." "No arity checking, so an extra argument copied from another library's signature is silently ignored." "The hyphenated name is longer to type than pset in inner loops where it is called thousands of times.")
  :usecases ("Porting a drawing routine from an older graphics library with minimal edits." "Code where the write-ness of the operation must be obvious to a reviewer." "Teaching the history of raster graphics alongside the operation itself." "Any place pset would be used; the choice is readability and provenance only.")
  :related ("pset" "pixel" "set-pixel!" "plot-pixel" "pget")
  :learn (:concept "Borrowed names carry borrowed expectations — check the signature, not the memory of another library." :prerequisites ("pset") :progression "Call put-pixel with and without a colour, then check what the pen was, to see the difference from libraries where the colour was required.")
  :row-2-audit (
    (:problem "A routine ported from an older library omits the colour argument in one branch, because in the original the colour was set by a separate call; here that branch silently paints in whatever the pen happened to be."
     :program "(set-mode 16 8)\n(clear 0)\n(set-color 3)\n;; The second call inherits the pen. If the pen drifted, so does the drawing.\n(put-pixel 1 1 9)\n(put-pixel 2 2)\n(list (pget 1 1) (pget 2 2))"
     :eng-program "(define (put-pixel! x y c)\n  ;; Make the colour required by wrapping it; no accidental pen inheritance.\n  (put-pixel x y c)\n  (pget x y))\n(set-mode 16 8)\n(clear 0)\n(set-color 3)\n(list (put-pixel! 1 1 9) (put-pixel! 2 2 10))"
     :math-program "(define (defaulted v fallback) (if v v fallback))\n;; An optional argument is a function of the ambient state, not of the call.\n(list (defaulted 9 3) (defaulted #f 3))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(set-color 5)\n(put-pixel 0 0)\n(set-color 12)\n(put-pixel 1 0)\n(display (list (pget 0 0) (pget 1 0) 'pen-dependent))"
     :explanation "eng: wrap the alias so the colour cannot be omitted. math: recognise the default as a read of ambient state rather than a constant. cs: demonstrate the pen dependency directly by changing the pen between two identical-looking calls."
     :meta "pset has the same optional argument and the same hazard. fb/rect takes an explicit colour and RESTORES the pen afterwards, which is the behaviour a ported routine usually wants, but it covers a rectangle rather than a point. set-color makes the ambient state explicit but paints nothing. put-pixel is where a ported routine lands, so the audit belongs here.")
    (:eng "The audit lens is 'which calls depend on ambient state?' — the smoke test is changing the pen between two calls and seeing the output move." :math "An optional parameter makes the function depend on a hidden variable; it is no longer a function of its arguments alone." :cs "Implicit context; the shape of every global-state-dependent API and every ported routine's first bug."))
  :row-3-dimension (
    (:setup "A familiar name adopted from elsewhere, carrying expectations the new implementation may not honour.")
    (:rungs (
       (:domain "put-pixel"     :code "(begin (set-mode 16 8) (clear 0) (put-pixel 3 1 4) (pget 3 1))")
       (:domain "loan-word"     :code "(define (meaning word)\n  (cond ((eq? word 'gift-en) 'present) ((eq? word 'gift-de) 'poison) (else 'unknown)))\n(map meaning (list 'gift-en 'gift-de))")
       (:domain "notation-reuse" :code "(define (interpret sym a b)\n  (cond ((eq? sym 'times-num) (* a b))\n        ((eq? sym 'times-set) (list a b))\n        (else 'unknown)))\n(list (interpret 'times-num 3 4) (interpret 'times-set 3 4))")))
    (:explanation "Rung 1: put-pixel looks like the classic call but makes the colour optional, so a ported routine can behave differently. Rung 2: a loan word keeps its shape and loses its meaning across a language boundary. Rung 3: the same multiplication symbol means one thing on numbers and another on sets, and reading it with the wrong domain in mind gives nonsense. All three warn that recognition is not understanding.")
    (:meta "The transfer works because familiarity suppresses checking: a name you recognise is a name you stop reading. That is why ported code fails in exactly the places where the signature quietly differs. Grounds in book-of-eng ch 07 as the porting hazard and in book-of-code ch 05 as the distinction between syntax and semantics.")
    (:eng "Every borrowed-name substrate shares 'recognised, therefore unread' — the operator's check is to diff the signature against the original." :math "Same symbol, different structure; the interpretation depends on the domain, not on the glyph." :cs "API surface compatibility without semantic compatibility; the shape of every drop-in replacement that is not."))
  :row-4-proof (
    (:claim "put-pixel is pset: the two names agree on the optional-argument behaviour, the masking behaviour and the off-canvas behaviour.")
    (:program "(set-mode 16 8)\n(clear 0)\n(set-color 7)\n(put-pixel 1 1)\n(pset 2 2)\n(define pen-agrees (= (pget 1 1) (pget 2 2)))\n(put-pixel 3 3 300)\n(pset 4 4 300)\n(define mask-agrees (= (pget 3 3) (pget 4 4)))\n(display (list pen-agrees mask-agrees (pget 3 3)))"
     :eng-program "(set-mode 8 4)\n(clear 0)\n;; Even the silent rejection agrees.\n(put-pixel 99 99 9)\n(pset 99 99 9)\n(display (list (pget 0 0) 'both-wrote-nothing))"
     :math-program "(define (same-on? f g xs)\n  (equal? (map f xs) (map g xs)))\n(display (same-on? (lambda (x) (modulo x 256)) (lambda (x) (modulo x 256)) (list 0 44 255 300)))"
     :cs-program "(set-mode 8 4)\n(define (trial f c) (clear 0) (f 3 2 c) (pget 3 2))\n(display (equal? (map (lambda (c) (trial put-pixel c)) (list 0 5 15 300))\n                 (map (lambda (c) (trial pset c)) (list 0 5 15 300))))"
     :invariant "∀ x y c. put-pixel(x,y,c) ≡ pset(x,y,c)  ∧  put-pixel(x,y) ≡ pset(x,y)  (both arities, one object)"
     :meta "The pattern is that an alias inherits the full behaviour including arity dispatch, so testing one arity of one name is testing both arities of all five. Falsified if the optional-argument path differed between the names; that would mean the alias wrapped rather than shared the function, and a wrapper can change arity handling. book-of-code ch 05 grounds referential identity; book-of-eng ch 07 grounds testing by shared implementation."))
    (:eng "The operator gets a five-for-one test budget: one probe of pset covers every alias at every arity." :math "Function identity implies agreement on the whole domain, including the arity-dispatched cases." :cs "Shared object aliasing; distinguishable from wrapping precisely because arity behaviour is inherited.")
  :row-5-emergence (
    (:base "put-pixel writes one pixel.")
    (:composition "(set-mode 32 16)\n(clear 0)\n;; A Bresenham-style line by hand, using only the primitive.\n(define (hand-line! x0 y0 x1 y1 c)\n  (let* ((dx (- x1 x0)) (dy (- y1 y0)) (n (max (abs dx) (abs dy))))\n    (let loop ((i 0))\n      (if (> i n) n\n          (begin\n            (put-pixel (+ x0 (quotient (* dx i) n))\n                       (+ y0 (quotient (* dy i) n)) c)\n            (loop (+ i 1)))))))\n(hand-line! 0 0 31 15 9)\n(display (list (pget 0 0) (pget 31 15) (pget 16 8)))"
     :eng-composition "(define (dotted-line! x0 x1 y c gap)\n  ;; Skipping every other index is trivial when you own the loop.\n  (let loop ((x x0) (n 0))\n    (if (> x x1) n\n        (begin (put-pixel x y c) (loop (+ x gap) (+ n 1))))))\n(set-mode 20 10)\n(clear 0)\n(display (list (dotted-line! 0 18 4 11 2) (pget 0 4) (pget 1 4) (pget 2 4)))"
     :math-composition "(set-mode 32 16)\n(clear 0)\n;; Parametric curve: t goes round, put-pixel deposits the trace.\n(define (circle-trace! cx cy r c steps)\n  (for-each\n    (lambda (i)\n      (let* ((num (* 8 i)) (den steps)\n             (x (+ cx (quotient (* r (- den (* 2 (modulo num den)))) den)))\n             (y (+ cy (quotient (* r i) steps))))\n        (put-pixel x y c)))\n    (iota steps))\n  steps)\n(display (list (circle-trace! 16 4 6 12 8) (pget 16 4)))"
     :cs-composition "(set-mode 16 8)\n(clear 0)\n;; Compare hand-rolled against built-in: the primitive is the ground truth.\n(define (mine!) (for-each (lambda (x) (put-pixel x 3 9)) (iota 8)))\n(mine!)\n(define a (map (lambda (x) (pget x 3)) (iota 16)))\n(clear 0)\n(set-color 9)\n(line 0 3 7 3)\n(display (list a (equal? a (map (lambda (x) (pget x 3)) (iota 16)))))"
     :emergent "A hand-written line, a dotted line, a parametric trace and a built-in comparison: owning the loop over the primitive is what lets you draw the things the library did not think of.")
    (:meta "This is the escape-hatch family — a library gives you shapes, but the primitive gives you everything, at the cost of writing the loop yourself. Familiar analogs are dropping to assembly under a compiler, raw SQL under an ORM and manual DOM manipulation under a framework. The composition works because the primitive is complete: any picture the library can draw, the loop can draw too.")
    (:eng "The audit lens is 'does the library cover this, or do I own the loop?' — the smoke test is reproducing a built-in with the primitive and diffing." :math "The single-point write generates the whole configuration space; the shape verbs are convenience, not capability." :cs "Primitive completeness; the shape of every escape hatch beneath a high-level API."))
)

(verb
  :name "set-pixel!" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(set-pixel! x y) | (set-pixel! x y color) -> undefined"
  :summary "An alias of pset: write one pixel at (x, y), in the pen colour or an explicit palette index."
  :explanation "set-pixel! is the same function object as pset, bound under the name that follows Scheme's own convention: a trailing exclamation mark marks a procedure that mutates something. Of the five names in this family it is the most honest one, because the bang tells a Scheme reader before they read the signature that this call has an effect and probably returns nothing. That is worth something in a language where set-car!, vector-set! and string-set! have trained the same expectation. Everything else is pset unchanged: optional colour, silent off-canvas clipping, byte masking, and no name resolution."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (clear 0) (set-pixel! 6 6 8) (pget 6 6))" :note "8 — the bang says it mutates, which is exactly what it does.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (clear 0) (set-color 13) (set-pixel! 3 6) (pget 3 6))" :note "13 — the pen supplies the colour when the third argument is omitted.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (clear 0) (set-pixel! 2 2 5) (put-pixel 3 3 5) (pixel 4 4 5) (plot-pixel 5 5 5) (pset 6 6 5) (list (pget 2 2) (pget 3 3) (pget 4 4) (pget 5 5) (pget 6 6)))" :note "(5 5 5 5 5) — all five names of the family, one function.")
  )
  :caveats ("It is an alias, so every pset defect applies: (set-pixel! 3 3 'red) writes 0, (set-pixel! 3 3 300) writes 44, (set-pixel! 500 500 9) writes nothing. Marked needs-alfred alongside pset." "The name resembles R7RS's vector-set! and string-set!, but those take the collection as their first argument; this one takes no framebuffer argument at all, because the framebuffer is singleton global state." "Despite the bang there is no matching set-pixel without one, so the naming pair a Scheme reader expects does not exist." "It is not part of R7RS or any of the locked SRFIs despite the R7RS-flavoured name; it is Motoi's own." "Coordinates truncate toward zero rather than rounding.")
  :drawbacks ("The bang suggests a Scheme standard verb, which may lead a reader to look for it in R7RS and not find it." "It is the longest of the five names, which matters in a tight inner loop that is being typed by hand." "There is no framebuffer argument, so the mutation target is invisible at the call site — the opposite of vector-set!." "Five aliases makes any codebase-wide search for pixel writes a five-term search.")
  :usecases ("Code written in a Scheme house style where every mutating procedure carries a bang." "Making an effectful call stand out in a function that is otherwise pure." "Teaching Scheme's mutation convention using a verb whose effect is visible on screen." "Any place pset would be used; the choice is convention only.")
  :related ("pset" "pixel" "put-pixel" "plot-pixel" "pget")
  :learn (:concept "Naming conventions that encode effects — the bang is a promise to the reader that the type system does not make." :prerequisites ("pset") :progression "Notice the bang, confirm the procedure returns nothing, then compare with vector-set! to see which argument is missing here.")
  :row-2-audit (
    (:problem "A reader assumes set-pixel! follows vector-set!'s shape and writes (set-pixel! fb 3 3 9), passing a framebuffer as the first argument; the call is accepted and paints at a nonsense coordinate."
     :program "(set-mode 16 8)\n(clear 0)\n;; There is no framebuffer argument: the target is global, not passed.\n(set-pixel! 3 3 9)\n(list 'correct (pget 3 3))"
     :eng-program "(define (set-pixel-on! fb x y c)\n  ;; If you want the target explicit, restore it first and then write.\n  (fb-restore fb)\n  (set-pixel! x y c)\n  (pget x y))\n(set-mode 16 8)\n(clear 0)\n(define snap (fb-snapshot))\n(list (set-pixel-on! snap 3 3 9) (set-pixel-on! snap 4 4 11))"
     :math-program "(define (arity-of-shape shape)\n  (cond ((eq? shape 'vector-set) 3) ((eq? shape 'set-pixel) 3) (else 0)))\n;; Same arity, different meanings for the first slot.\n(list (arity-of-shape 'vector-set) (arity-of-shape 'set-pixel))"
     :cs-program "(set-mode 16 8)\n(clear 0)\n(set-pixel! 3 3 9)\n(display (list (pget 3 3) 'target-is-global))"
     :explanation "eng: if the target must be explicit, make it explicit yourself with fb-restore. math: note that identical arity does not mean identical argument roles. cs: prove the target is global by writing without naming a buffer."
     :meta "vector-set! is the model the name evokes, and it takes the collection first. pset has the same signature without the misleading convention. fb-restore is the only verb that changes WHICH framebuffer is current, so it is the real answer to 'which buffer am I writing?'. set-pixel! is where the confusion starts, so the audit lives here.")
    (:eng "The audit lens is 'where is the mutation target?' — the smoke test is that the call names no buffer and still works." :math "Argument position carries role; equal arity does not imply equal roles." :cs "Implicit global target versus explicit receiver; the shape of every immediate-mode graphics API."))
  :row-3-dimension (
    (:setup "A naming convention that encodes a property the language cannot check.")
    (:rungs (
       (:domain "set-pixel!"    :code "(begin (set-mode 16 8) (clear 0) (set-pixel! 7 3 6) (pget 7 3))")
       (:domain "hazard-symbol" :code "(define (handle sym)\n  (cond ((eq? sym 'flammable) 'no-flame) ((eq? sym 'inert) 'ok) (else 'unknown)))\n(map handle (list 'flammable 'inert))")
       (:domain "type-annotation" :code "(define (checked v pred) (if (pred v) v 'wrong-type))\n(list (checked 5 number?) (checked 'five number?))")))
    (:explanation "Rung 1: the bang tells a reader this call mutates, though nothing in the language enforces it. Rung 2: a hazard symbol on a container tells a handler what is inside without opening it, and is only as good as whoever applied it. Rung 3: a type annotation states an intent that a dynamic language must check at run time rather than reject at compile time. All three are out-of-band promises riding on top of the thing itself.")
    (:meta "The transfer works because every system needs to communicate properties that its formal layer cannot express, and the cheapest channel is a convention on the name or the label. The cost is uniform: conventions can be wrong, and nothing catches it. Grounds in book-of-eng ch 03 as convention-as-documentation and in book-of-code ch 05 as effect discipline.")
    (:eng "Every convention-encoded-property substrate shares 'the label was never checked' — the operator's check is to verify the property directly at least once." :math "A predicate asserted but not proved; the annotation is a claim, not a theorem." :cs "Naming conventions for effects; the shape of Scheme's bang, Ruby's bang and Haskell's IO where the last one is actually enforced."))
  :row-4-proof (
    (:claim "set-pixel! honours its bang: it mutates observable state and returns no useful value, and it is the same function as pset.")
    (:program "(set-mode 16 8)\n(clear 0)\n(define before (pget 5 5))\n(set-pixel! 5 5 9)\n(define after (pget 5 5))\n(display (list before after (not (= before after))))"
     :eng-program "(set-mode 12 6)\n(clear 0)\n;; Same object as pset, proved through the shared masking defect.\n(set-pixel! 1 1 300)\n(pset 2 2 300)\n(display (list (pget 1 1) (pget 2 2) (= (pget 1 1) (pget 2 2))))"
     :math-program "(define (changes-state? before after) (not (equal? before after)))\n(display (list (changes-state? 0 9) (changes-state? 9 9)))"
     :cs-program "(set-mode 8 4)\n(define (mutates? f)\n  (clear 0)\n  (let ((b (pget 2 2)))\n    (f 2 2 7)\n    (not (= b (pget 2 2)))))\n(display (list (mutates? set-pixel!) (mutates? pset) (mutates? pixel)))"
     :invariant "∀ (x,y) in the canvas, ∀ c ≠ pget(x,y). set-pixel!(x,y,c) changes pget(x,y)  ∧  set-pixel! ≡ pset"
     :meta "The pattern is verifying a naming convention against behaviour rather than trusting it — the bang claims mutation and a before/after probe settles it. Falsified if the before and after reads agreed for a different colour; that would mean the bang was decoration on a no-op. book-of-code ch 05 grounds effect observation; book-of-eng ch 07 grounds verifying documentation against the artefact."))
    (:eng "The operator can confirm the convention rather than assume it, with a two-line before/after probe that works for any verb in the library." :math "State change is witnessed by a difference in the observation function before and after." :cs "Before/after assertion; the standard way to test a procedure whose return value is nothing.")
  :row-5-emergence (
    (:base "set-pixel! writes one pixel.")
    (:composition "(set-mode 24 12)\n(clear 0)\n;; Effectful helpers stand out when every one of them carries a bang.\n(define (frame! w h c)\n  (for-each (lambda (x) (set-pixel! x 0 c) (set-pixel! x (- h 1) c)) (iota w))\n  (for-each (lambda (y) (set-pixel! 0 y c) (set-pixel! (- w 1) y c)) (iota h))\n  (list w h))\n(display (list (frame! 24 12 7) (pget 0 0) (pget 23 11) (pget 12 6)))"
     :eng-composition "(define (checkerboard! w h a b)\n  ;; Two colours, one predicate, one loop.\n  (for-each\n    (lambda (y)\n      (for-each\n        (lambda (x) (set-pixel! x y (if (even? (+ x y)) a b)))\n        (iota w)))\n    (iota h))\n  'painted)\n(set-mode 8 4)\n(checkerboard! 8 4 1 7)\n(display (list (pget 0 0) (pget 1 0) (pget 1 1)))"
     :math-composition "(set-mode 16 16)\n(clear 0)\n;; The graph of a relation: paint (x,y) exactly where the predicate holds.\n(for-each\n  (lambda (y)\n    (for-each\n      (lambda (x) (if (= (modulo x 4) (modulo y 4)) (set-pixel! x y 10)))\n      (iota 16)))\n  (iota 16))\n(display (list (pget 0 0) (pget 4 0) (pget 5 1) (pget 1 0)))"
     :cs-composition "(set-mode 8 4)\n;; Pure planning, effectful painting: separate the two and the plan is testable.\n(define (plan w h) (map (lambda (i) (list (modulo i w) (quotient i w))) (iota (* w h))))\n(define (paint! ps c) (for-each (lambda (p) (set-pixel! (car p) (cadr p) c)) ps) (length ps))\n(clear 0)\n(display (list (length (plan 8 4)) (paint! (plan 8 4) 3) (pget 7 3)))"
     :emergent "A border, a checkerboard, the graph of a relation and a plan-then-paint split: marking the effectful step keeps the pure part of a drawing program separable and testable.")
    (:meta "This is the effect-isolation family — compute what to draw purely, then paint it in one clearly marked pass, so the interesting logic can be tested without a framebuffer. Familiar analogs are the model-view split, pure reducers beside effectful dispatch, and Haskell's IO at the edges. The composition works because the primitive's effect is uniform and total, so the planning step never needs to know anything about the canvas but its size.")
    (:eng "The audit lens is 'can I test the drawing logic without drawing?' — the smoke test is running the plan and asserting on the coordinate list." :math "Separating the characteristic function from its realisation lets the set be reasoned about independently of the painting." :cs "Pure core, effectful shell; the shape of every functional-core architecture."))
)

(verb
  :name "plot-pixel" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(plot-pixel x y) | (plot-pixel x y color) -> undefined"
  :summary "An alias of pset: write one pixel at (x, y), in the pen colour or an explicit palette index."
  :explanation "plot-pixel is the fifth and last binding of pset's function object. The name comes from the plotting vocabulary — plot a point, plot a series — and it is the one to use when the pixel represents a DATUM rather than a piece of a picture: a sample of a function, a reading from a sensor, a point in a scatter. That reading is reinforced by the sibling verb plot, which takes a whole list of numbers and draws the series as a connected line. plot-pixel is what you drop to when plot's automatic scaling is not what you want and you would rather place each sample yourself."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 8) (clear 0) (plot-pixel 7 7 10) (pget 7 7))" :note "10 — one datum, placed by hand.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 8) (clear 0) (set-color 12) (plot-pixel 8 3) (pget 8 3))" :note "12 — the pen supplies the colour, so a whole series can share one set-color.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 8) (clear 0) (for-each (lambda (x) (plot-pixel x (quotient x 4) 9)) (iota 24)) (list (pget 0 0) (pget 8 2) (pget 23 5)))" :note "(9 9 9) — placing samples by hand gives you the scaling that plot decides for you.")
  )
  :caveats ("It is an alias, so every pset defect applies: silent off-canvas writes, byte masking, and symbols coerced to 0 rather than resolved. Marked needs-alfred alongside pset." "It has NO relationship to the plot verb beyond the name. plot takes a list and auto-scales; plot-pixel takes one coordinate and scales nothing." "Because it does not scale, data in the wrong units silently lands off-canvas and is discarded without warning — the single most common failure in hand-rolled plotting." "The y axis grows DOWNWARD, so a naive plot of a rising series appears to fall unless you subtract from the height." "Coordinates truncate toward zero rather than rounding, which biases every sample half a pixel toward the origin.")
  :drawbacks ("No axis, no scaling, no clipping report — everything a plotting routine needs must be written around it." "Sharing a name prefix with plot invites the assumption that they cooperate; they do not." "One call per sample, so a long series is a long loop." "The downward y axis has to be corrected in every single call site unless you wrap it.")
  :usecases ("Scatter plots, where each point is placed independently and no line connects them." "Plotting with a scale you choose rather than the one plot derives." "Marking specific samples on top of a series drawn by plot." "Any place pset would be used; the choice is domain vocabulary only.")
  :related ("pset" "plot" "pixel" "put-pixel" "pget")
  :learn (:concept "Domain vocabulary — choosing the name that tells the reader what the pixel MEANS, not just what it is." :prerequisites ("pset" "plot") :progression "Place a few samples by hand, then compare with plot on the same data to see what the automatic scaling did.")
  :row-2-audit (
    (:problem "A temperature series in the range 15..25 is plotted directly as y coordinates on a 240-tall canvas, so every sample lands in the top ten rows and the chart looks like a flat line."
     :program "(set-mode 40 20)\n(clear 0)\n;; Raw values ignore the canvas; the range has to be mapped onto it.\n(define data (list 15 18 22 25 21 17))\n(for-each (lambda (i) (plot-pixel (* i 6) (list-ref data i) 9)) (iota 6))\n(list 'raw (pget 0 15) (pget 18 25))"
     :eng-program "(define (plot-scaled! data lo hi w h c)\n  ;; Map the value range onto the canvas height, and flip the axis.\n  (let ((span (max 1 (- hi lo))) (n (length data)))\n    (for-each\n      (lambda (i)\n        (let* ((v (list-ref data i))\n               (x (quotient (* i (- w 1)) (max 1 (- n 1))))\n               (y (- (- h 1) (quotient (* (- v lo) (- h 1)) span))))\n          (plot-pixel x y c)))\n      (iota n))\n    n))\n(set-mode 40 20)\n(clear 0)\n(display (list (plot-scaled! (list 15 18 22 25 21 17) 15 25 40 20 9)\n               (pget 0 19) (pget 23 0)))"
     :math-program "(define (rescale v lo hi h)\n  (quotient (* (- v lo) (- h 1)) (max 1 (- hi lo))))\n;; An affine map from the data range onto the pixel range.\n(map (lambda (v) (rescale v 15 25 20)) (list 15 20 25))"
     :cs-program "(set-mode 40 20)\n(clear 0)\n(define (on-canvas? x y) (and (>= x 0) (>= y 0) (< x 40) (< y 20)))\n(display (map (lambda (v) (on-canvas? 0 v)) (list 15 25 30 100)))"
     :explanation "eng: write the scaling once, taking the range and the canvas as parameters. math: state the affine map from data range to pixel range explicitly. cs: test membership before plotting so out-of-range samples are visible rather than dropped."
     :meta "plot does this scaling automatically, which is exactly why it is the right verb when you do not care about the axis — but it derives the range from the data, so two charts drawn separately are not comparable. pset has no plotting connotation at all. mode-info supplies the height the scaling needs. plot-pixel is the verb you use when you want control of the map, so the audit is that the map must actually exist.")
    (:eng "The audit lens is 'where does the data range become a pixel range?' — the smoke test is plotting a constant series and a varying one and comparing." :math "Without an affine rescaling the data's units are silently treated as pixels, which is a unit error." :cs "Coordinate transform; the step every plotting library performs and every hand-rolled plot forgets."))
  :row-3-dimension (
    (:setup "Placing a measurement into a bounded display space, which requires an explicit mapping of units.")
    (:rungs (
       (:domain "plot-pixel"    :code "(begin (set-mode 16 8) (clear 0) (plot-pixel 4 6 9) (pget 4 6))")
       (:domain "map-scale"     :code "(define (km->cm km scale) (quotient km scale))\n(map (lambda (k) (km->cm k 5)) (list 5 20 100))")
       (:domain "affine-map"    :code "(define (affine v lo hi out) (quotient (* (- v lo) out) (max 1 (- hi lo))))\n(map (lambda (v) (affine v 0 100 10)) (list 0 50 100))")))
    (:explanation "Rung 1: placing a sample as a pixel requires deciding how many data units one pixel is worth. Rung 2: a map's scale bar is that same decision made explicit and printed on the artefact. Rung 3: the affine map is the general statement — subtract the origin, divide by the span, multiply by the output range. All three fail the same way: omit the map and the units are silently assumed to be one-to-one.")
    (:meta "The transfer works because display space is always bounded and data space usually is not, so a map is mandatory; the only choice is whether it is written down or assumed. Grounds in book-of-math ch-advanced-01 as affine transformation and in book-of-eng ch 03 as dimensional analysis.")
    (:eng "Every measurement-to-display substrate shares 'units assumed one-to-one' — the operator's check is that a scale factor appears somewhere in the code." :math "An affine map from data range to display range; without it the identity map is applied by default." :cs "Coordinate transformation; the shape of every viewport, every scale bar and every normalisation step."))
  :row-4-proof (
    (:claim "plot-pixel is pset, and placing n samples deposits at most n pixels — fewer when samples collide or fall off the canvas.")
    (:program "(set-mode 16 8)\n(clear 0)\n(define (count-nonzero)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 8) n)\n          ((>= x 16) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(for-each (lambda (i) (plot-pixel i (quotient i 4) 9)) (iota 8))\n(display (list 'samples 8 'pixels (count-nonzero)))"
     :eng-program "(set-mode 16 8)\n(clear 0)\n;; Colliding samples: three writes, one pixel.\n(plot-pixel 3 3 9)\n(plot-pixel 3 3 9)\n(plot-pixel 3 3 9)\n(define (count-nonzero)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 8) n)\n          ((>= x 16) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (count-nonzero))"
     :math-program "(define (image-size xs f)\n  (length (fold-right (lambda (x acc) (if (member (f x) acc) acc (cons (f x) acc)))\n                      (list) xs)))\n;; |image| <= |domain|; equality only when the map is injective.\n(display (list (image-size (iota 8) (lambda (x) x))\n               (image-size (iota 8) (lambda (x) (quotient x 4)))))"
     :cs-program "(set-mode 16 8)\n(clear 0)\n(plot-pixel 100 100 9)\n(define (count-nonzero)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 8) n)\n          ((>= x 16) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list 'off-canvas-sample (count-nonzero)))"
     :invariant "∀ sample list S. |{pixels set by plotting S}| ≤ |S|, with equality iff the coordinate map is injective and its image lies inside the canvas"
     :meta "The pattern is that a rendering is the IMAGE of the data under a map, and an image is never larger than its domain — collisions and clipping only ever lose points. Falsified if plotting n samples ever lit more than n pixels; that would mean the primitive touched neighbours, which would break every pixel-count measurement. book-of-math ch-advanced-01 grounds image cardinality; book-of-code ch 05 grounds injectivity as the condition for lossless mapping."))
    (:eng "The operator can detect a bad scale by counting pixels: far fewer lit pixels than samples means collisions or clipping." :math "|f(S)| ≤ |S| for any map f; equality characterises injectivity into the canvas." :cs "Lossy projection; the same accounting as hash collisions and as downsampling.")
  :row-5-emergence (
    (:base "plot-pixel places one sample as one pixel.")
    (:composition "(set-mode 40 20)\n(clear 1)\n;; A scatter with an explicit, reusable scale.\n(define data (list 2 7 5 9 4 8 3 6))\n(define (place! i v)\n  (plot-pixel (* i 5) (- 19 (* v 2)) 10))\n(for-each (lambda (i) (place! i (list-ref data i))) (iota 8))\n(display (list (pget 0 15) (pget 15 1) (pget 35 7)))"
     :eng-composition "(define (scatter! xs ys c)\n  ;; Two parallel series make a real scatter rather than a line chart.\n  (for-each (lambda (i) (plot-pixel (list-ref xs i) (list-ref ys i) c))\n            (iota (min (length xs) (length ys))))\n  (min (length xs) (length ys)))\n(set-mode 20 10)\n(clear 0)\n(display (list (scatter! (list 1 5 9 14) (list 2 8 3 6) 11)\n               (pget 5 8) (pget 14 6)))"
     :math-composition "(set-mode 32 16)\n(clear 0)\n;; Sample a function densely enough and the pixels become a curve.\n(for-each\n  (lambda (x)\n    (let ((y (- 15 (quotient (* x x) 64))))\n      (if (and (>= y 0) (< y 16)) (plot-pixel x y 9))))\n  (iota 32))\n(display (list (pget 0 15) (pget 16 11) (pget 31 0)))"
     :cs-composition "(set-mode 40 20)\n(clear 0)\n;; Hand placement beside plot: two views of the same numbers.\n(define data (list 3 3 3 3))\n(set-color 8)\n(plot data)\n(define auto (pget 0 19))\n(clear 0)\n(for-each (lambda (i) (plot-pixel (* i 13) (- 19 (* 3 2)) 8)) (iota 4))\n(display (list 'plot-auto auto 'hand (pget 0 13)))"
     :emergent "A scaled scatter, a two-series scatter, a densely sampled curve and a side-by-side with plot: hand placement is what you reach for when the automatic scaling is the thing you need to control.")
    (:meta "This is the manual-control family — an automatic convenience covers the common case, and the primitive underneath is kept available for when the convenience makes the wrong decision. Familiar analogs are manual exposure on a camera, explicit axis limits in a charting library and hand-written SQL under an ORM. The composition works because plot and plot-pixel write to the same buffer, so a hand-placed annotation can sit on top of an auto-scaled series.")
    (:eng "The audit lens is 'who chose the scale, me or the library?' — the smoke test is plotting a constant series and seeing where it lands." :math "The automatic map is derived from the data's own extrema; a chosen map is fixed independently and makes charts comparable." :cs "Convenience over primitive; the shape of every high-level API that keeps its escape hatch open."))
)
(verb
  :name "circle" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(circle cx cy r) -> undefined"
  :summary "Stroke a circle OUTLINE of radius r centred on (cx, cy), in the current pen colour. Returns nothing."
  :explanation "circle draws the boundary only — the interior is left exactly as it was, so a circle over a coloured background shows the background through the middle. It uses the midpoint circle algorithm, which plots eight symmetric points per step and therefore produces a boundary that is exactly symmetric under reflection in both axes and in both diagonals. The radius is truncated to an integer and clamped up to 0, so a negative radius degenerates to a single point at the centre rather than raising. Note what the signature does NOT contain: there is no colour parameter. The colour comes from set-color, and any fourth argument you pass is silently discarded."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 40 20) (clear 0) (set-color 9) (circle 20 10 5) (list (pget 25 10) (pget 20 10)))" :note "(9 0) — the rim is painted and the middle is not; circle is an outline, not a disc.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 40 20) (clear 0) (set-color 11) (circle 20 10 5) (list (pget 15 10) (pget 25 10) (pget 20 5) (pget 20 15)))" :note "(11 11 11 11) — all four cardinal points of the rim are lit, which is the eight-way symmetry showing.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 16 8) (clear 0) (set-color 9) (circle 8 4 0) (pget 8 4))" :note "9 — a radius of 0 collapses to a single pixel at the centre rather than drawing nothing or raising.")
  )
  :caveats ("IT TAKES NO COLOUR ARGUMENT. (circle 8 4 3 5) draws in the PEN colour and silently ignores the 5. The sibling shape verbs in the same reference — triangle, ellipse, ngon, star, arc, polygon — all DO take a trailing colour, so the family is inconsistent. Marked needs-alfred." "It is the outline only. For a filled circle use disc; there is no fill flag." "A negative radius is clamped to 0, giving one pixel at the centre, rather than raising or drawing nothing." "The radius truncates: (circle 8 4 3.9) draws radius 3, not 4." "There is no line width; the outline is always one pixel, and at large radii it visibly thins where the curve is shallow.")
  :drawbacks ("No anti-aliasing, so at small radii the circle reads as a lumpy octagon." "No arc form here — you cannot draw part of a circle with this verb; arc lives in the shapes-raster surface." "No stroke width, no dash pattern, no fill-and-stroke in one call." "Because the colour is ambient, a circle drawn inside a helper depends on whatever the caller last set.")
  :usecases ("Outlining a target, a planet, a ball or a selection ring." "Drawing a clock face or a dial's bezel." "Marking a radius of influence in a game without hiding what is underneath it." "Building concentric rings by calling it repeatedly with increasing radii.")
  :related ("disc" "set-color" "line" "rect" "pget")
  :learn (:concept "Boundary versus interior — the same shape has two different renderings and two different verbs." :prerequisites ("set-mode" "set-color") :progression "Draw a circle, probe the centre to see it is empty, then draw a disc at the same place and probe again.")
  :row-2-audit (
    (:problem "A helper draws a circle and it comes out in the wrong colour, because the helper never set the pen and inherited whatever the previous drawing step left behind."
     :program "(set-mode 40 20)\n(clear 0)\n(set-color 3)\n;; The helper below has no colour of its own; it borrows the ambient pen.\n(define (ring! cx cy r) (circle cx cy r))\n(ring! 10 10 4)\n(set-color 9)\n(ring! 30 10 4)\n(list (pget 14 10) (pget 34 10))"
     :eng-program "(define (ring! cx cy r c)\n  ;; Take the colour, set it, draw, and hand back the pen you borrowed.\n  (let ((prev (get-color)))\n    (set-color c)\n    (circle cx cy r)\n    (set-color prev)\n    (pget (+ cx r) cy)))\n(set-mode 40 20)\n(clear 0)\n(set-color 3)\n(list (ring! 10 10 4 9) (ring! 30 10 4 11) (get-color))"
     :math-program "(define (depends-on-ambient? explicit) (if explicit 'pure 'ambient))\n;; A function of its arguments alone is reproducible; one that reads state is not.\n(list (depends-on-ambient? #t) (depends-on-ambient? #f))"
     :cs-program "(set-mode 20 10)\n(clear 0)\n(set-color 5)\n(circle 10 5 3)\n(define a (pget 13 5))\n(clear 0)\n(set-color 12)\n(circle 10 5 3)\n(display (list a (pget 13 5) 'same-call-different-result))"
     :explanation "eng: wrap the shape in a helper that takes the colour, sets it, and restores the pen. math: name the difference between a function of its arguments and one that reads ambient state. cs: run the identical call twice with different pens and watch the output change."
     :meta "disc has the same missing colour parameter and the same hazard. fb/rect is the one verb in this chapter that takes a colour AND restores the pen afterwards, which is the pattern the wrapper above imitates. set-color changes the pen but draws nothing, so it cannot be the fix on its own. circle is where a beginner first meets the ambient pen, so the audit belongs here.")
    (:eng "The audit lens is 'does this drawing call carry its own colour?' — the smoke test is calling it twice with different pens." :math "A procedure that reads ambient state is not a function of its arguments; reproducibility requires closing over the state." :cs "Implicit global context; the shape of every immediate-mode graphics API and every current-directory bug."))
  :row-3-dimension (
    (:setup "Trace the boundary of a region without touching what is inside it.")
    (:rungs (
       (:domain "circle"       :code "(begin (set-mode 20 10) (clear 4) (set-color 9) (circle 10 5 3) (list (pget 13 5) (pget 10 5)))")
       (:domain "fence-line"   :code "(define (fence-posts n) (map (lambda (i) (list 'post i)) (iota n)))\n(list (length (fence-posts 8)) (car (fence-posts 8)))")
       (:domain "level-set"    :code "(define (on-level? x y r) (= (+ (* x x) (* y y)) (* r r)))\n(list (on-level? 3 4 5) (on-level? 1 1 5))")))
    (:explanation "Rung 1: circle paints only the rim, leaving the interior untouched so the background shows through. Rung 2: a fence marks a boundary without changing the field it encloses. Rung 3: a level set is the locus where a function equals a constant — a curve, not a region. All three separate the boundary of a set from the set itself, and all three let you speak about the edge without committing to what is inside.")
    (:meta "The transfer works because a boundary is a lower-dimensional object than the region it bounds, so marking it is cheaper and less destructive than filling. That is why outlines are used for selection, for annotation and for anything that must not obscure. Grounds in book-of-math ch-advanced-13 as the topological boundary and in book-of-code ch 05 as the distinction between a predicate's zero set and its sublevel set.")
    (:eng "Every boundary-marking substrate shares 'the outline was mistaken for the region' — the operator's check is probing the interior." :math "∂S has measure zero in the plane while S does not; the outline carries no area." :cs "Edge detection versus region fill; the shape of every stroke-versus-fill distinction in a graphics API."))
  :row-4-proof (
    (:claim "The circle drawn is symmetric: every point of the rim has a mirror image across the horizontal and vertical axes through the centre.")
    (:program "(set-mode 32 32)\n(clear 0)\n(set-color 9)\n(circle 16 16 8)\n(define (mirror-ok? dx dy)\n  (and (= (pget (+ 16 dx) (+ 16 dy)) (pget (- 16 dx) (+ 16 dy)))\n       (= (pget (+ 16 dx) (+ 16 dy)) (pget (+ 16 dx) (- 16 dy)))))\n(display (list (mirror-ok? 8 0) (mirror-ok? 0 8) (mirror-ok? 6 5)))"
     :eng-program "(set-mode 32 32)\n(clear 0)\n(set-color 11)\n;; Diagonal symmetry too: swapping dx and dy must land on the rim as well.\n(circle 16 16 8)\n(display (list (= (pget 24 16) (pget 16 24))\n               (= (pget 8 16) (pget 16 8))))"
     :math-program "(define (dist2 x y) (+ (* x x) (* y y)))\n;; The defining equation is symmetric in the signs of x and y and in swapping them.\n(display (list (dist2 3 4) (dist2 -3 4) (dist2 4 3) (dist2 -4 -3)))"
     :cs-program "(set-mode 32 32)\n(clear 0)\n(set-color 7)\n(circle 16 16 6)\n(define (count-lit)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 32) n)\n          ((>= x 32) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (count-lit) 'roughly (* 6 6)))"
     :invariant "∀ (dx,dy) on the rim. (±dx, ±dy) and (±dy, ±dx) are all on the rim  (the eight-fold dihedral symmetry of the midpoint algorithm)"
     :meta "The pattern is that the rasteriser inherits the symmetry group of the equation it approximates — the midpoint algorithm computes one octant and reflects it seven times, so the symmetry is exact rather than approximate. Falsified if any mirrored point were unlit while its partner was lit; that would mean the reflections had drifted and the shape was not a circle. book-of-math ch-advanced-04 grounds the dihedral group D₄; book-of-code ch 11 grounds computing one octant and reflecting."))
    (:eng "The operator can spot-check a circle with three probes instead of scanning the rim, because symmetry makes one octant stand for all eight." :math "The rim is invariant under D₄, the symmetry group of the square, generated by the two axis reflections and the diagonal." :cs "Octant reduction; one eighth of the work, seven reflections, exact symmetry for free.")
  :row-5-emergence (
    (:base "circle strokes one ring.")
    (:composition "(set-mode 40 40)\n(clear 0)\n;; Concentric rings: the same verb at increasing radii is a target.\n(for-each (lambda (i) (set-color (+ 8 (modulo i 4))) (circle 20 20 (* (+ i 1) 4)))\n          (iota 4))\n(display (list (pget 24 20) (pget 28 20) (pget 32 20) (pget 36 20)))"
     :eng-composition "(define (rings! cx cy r0 step n c)\n  ;; One parameterised call site, n rings out.\n  (set-color c)\n  (for-each (lambda (i) (circle cx cy (+ r0 (* i step)))) (iota n))\n  n)\n(set-mode 40 40)\n(clear 0)\n(display (list (rings! 20 20 3 5 3 10) (pget 23 20) (pget 28 20) (pget 33 20)))"
     :math-composition "(set-mode 40 40)\n(clear 0)\n;; Ring plus filled disc is an annulus: outline the outside, fill the inside.\n(set-color 3)\n(disc 20 20 14)\n(set-color 0)\n(disc 20 20 8)\n(set-color 9)\n(circle 20 20 14)\n(circle 20 20 8)\n(display (list (pget 20 20) (pget 20 9) (pget 20 12)))"
     :cs-composition "(set-mode 40 40)\n(clear 0)\n;; A dial: a bezel plus tick marks placed by trigonometry-free integer steps.\n(set-color 7)\n(circle 20 20 15)\n(set-color 9)\n(for-each (lambda (i)\n            (let ((x (+ 20 (- (* i 5) 10))))\n              (pset x 5 9) (pset x 35 9)))\n          (iota 5))\n(display (list (pget 35 20) (pget 20 5) (pget 10 5)))"
     :emergent "Concentric targets, a parameterised ring generator, an annulus built from disc and circle together, and a dial bezel with ticks: outlines compose because they do not destroy what is beneath them.")
    (:meta "This is the non-destructive-annotation family — a mark that adds information without hiding any, so marks can be layered indefinitely. Familiar analogs are contour lines on a map, a highlighter's translucency and a selection marquee in an editor. The composition works because circle writes only the boundary, which is a set of measure zero, so overlapping rings interfere only at their crossings.")
    (:eng "The audit lens is 'can I still see what was underneath?' — the smoke test is probing an interior pixel after drawing the annotation." :math "Boundaries have empty interior, so a union of boundaries never covers a region." :cs "Overlay compositing; the shape of every annotation layer that must not obscure its subject."))
)

(verb
  :name "disc" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(disc cx cy r) -> undefined"
  :summary "Fill a solid disc of radius r centred on (cx, cy), in the current pen colour. Returns nothing."
  :explanation "disc is the filled counterpart of circle. It scans the bounding square of the circle and paints every pixel whose squared distance from the centre is at most r squared — an exact integer test, so the boundary is decided without floating point and without rounding surprises. Everything inside is overwritten, so a disc hides whatever was there before, unlike circle which leaves the interior alone. Like circle it takes no colour argument, drawing in whatever set-color last established, and like circle a negative radius clamps to 0 and paints a single pixel at the centre. It is the cheapest way to draw a ball, a dot, a planet or a rounded blob."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 40 20) (clear 0) (set-color 11) (disc 20 10 5) (list (pget 20 10) (pget 25 10) (pget 30 10)))" :note "(11 11 0) — centre and rim are both filled; outside the radius nothing is touched.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 40 20) (clear 3) (set-color 9) (disc 20 10 4) (list (pget 20 10) (pget 20 4)))" :note "(9 3) — the disc is opaque, so the background survives only outside it.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 16 8) (clear 0) (set-color 9) (disc 8 4 0) (list (pget 8 4) (pget 9 4)))" :note "(9 0) — a radius of 0 paints exactly one pixel; the test is dx²+dy² ≤ 0, which only (0,0) satisfies.")
  )
  :caveats ("IT TAKES NO COLOUR ARGUMENT, exactly like circle. (disc 8 4 3 5) fills in the PEN colour and drops the 5, while the sibling verbs triangle-fill, ellipse-fill and ngon-fill all accept one. Marked needs-alfred." "It is opaque. There is no alpha and no blending, so a disc erases everything under it inside the radius." "A negative radius clamps to 0 and paints one pixel rather than raising or drawing nothing." "The radius truncates: (disc 8 4 3.9) fills radius 3." "The cost is the BOUNDING SQUARE, not the disc: it tests (2r+1)² pixels to paint about πr² of them, so roughly a fifth of the work is wasted.")
  :drawbacks ("No anti-aliasing, so the edge is visibly stepped at small radii." "No outline-and-fill in one call; drawing a bordered ball means a disc followed by a circle." "No partial fill, no gradient and no pattern." "The ambient pen means a disc drawn inside a helper depends on the caller's last set-color.")
  :usecases ("Balls, planets, bullets, dots and any round solid object." "Erasing a round region by filling it with the background colour." "Building an annulus: a large disc, then a smaller one in the background colour." "Marking a position in a plot with something bigger than a single pixel.")
  :related ("circle" "set-color" "rect-fill" "pget" "clear")
  :learn (:concept "Filling a region defined by a predicate — every pixel is tested and painted or skipped." :prerequisites ("set-mode" "set-color" "circle") :progression "Draw a disc, probe inside and outside, then draw a circle at the same place and compare which pixels each one touched.")
  :row-2-audit (
    (:problem "A game draws a ball on a textured background and the texture vanishes in a square around the ball, because the programmer used rect-fill with the ball's bounding box instead of a disc."
     :program "(set-mode 40 20)\n(clear 3)\n;; A disc touches only what is inside the radius; a box touches the corners too.\n(set-color 9)\n(disc 10 10 4)\n(set-color 9)\n(rect-fill 26 6 9 9)\n(list 'disc-corner (pget 7 7) 'box-corner (pget 26 6))"
     :eng-program "(define (ball! cx cy r c)\n  ;; A round object needs a round fill; the bounding box is not the object.\n  (let ((prev (get-color)))\n    (set-color c)\n    (disc cx cy r)\n    (set-color prev)\n    (list (pget cx cy) (pget (- cx r) (- cy r)))))\n(set-mode 40 20)\n(clear 3)\n(display (ball! 20 10 4 9))"
     :math-program "(define (inside-disc? dx dy r) (<= (+ (* dx dx) (* dy dy)) (* r r)))\n(define (inside-box? dx dy r) (and (<= (abs dx) r) (<= (abs dy) r)))\n;; The corner of the box is outside the disc: r√2 > r.\n(list (inside-disc? 4 4 4) (inside-box? 4 4 4))"
     :cs-program "(set-mode 20 20)\n(clear 0)\n(set-color 9)\n(disc 10 10 5)\n(define (count-lit)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 20) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (count-lit) 'box-would-be (* 11 11)))"
     :explanation "eng: use the shape that matches the object, and restore the pen afterwards. math: compare the two membership predicates at the corner, where they disagree. cs: count the lit pixels and compare against the bounding box's area to see how much the box would have over-painted."
     :meta "rect-fill is faster and simpler but paints the corners, which is exactly the bug. circle draws the right shape but only its boundary, so it does not hide the texture at all. clear paints everything and is far too big a hammer. disc is the verb whose painted set matches the object's shape, which is what makes the corners survive.")
    (:eng "The audit lens is 'does the painted region match the object's shape?' — the smoke test is probing a corner of the bounding box." :math "The disc is a strict subset of its bounding square; the corners are at distance r√2 > r." :cs "Shape-accurate fill versus bounding-box fill; the same trade-off as per-pixel versus AABB collision."))
  :row-3-dimension (
    (:setup "Paint every point that satisfies a distance test, and no point that does not.")
    (:rungs (
       (:domain "disc"         :code "(begin (set-mode 20 20) (clear 0) (set-color 9) (disc 10 10 4) (list (pget 10 10) (pget 14 14)))")
       (:domain "sprinkler-reach" :code "(define (wet? dx dy reach) (<= (+ (* dx dx) (* dy dy)) (* reach reach)))\n(list (wet? 3 0 4) (wet? 4 4 4))")
       (:domain "closed-ball"  :code "(define (in-ball? xs r)\n  (<= (apply + (map (lambda (x) (* x x)) xs)) (* r r)))\n(list (in-ball? (list 1 2 2) 3) (in-ball? (list 3 3 3) 3))")))
    (:explanation "Rung 1: disc paints exactly the pixels within r of the centre, corners excluded. Rung 2: a sprinkler wets exactly the ground within its reach, and the corners of the plot stay dry. Rung 3: the closed ball in any number of dimensions is defined by the same inequality with the same ≤. All three are the same predicate — sum of squares against a squared radius — realised in a raster, in a garden and in n-dimensional space.")
    (:meta "The transfer works because the Euclidean metric is dimension-independent: the same inequality defines a disc, a ball and a hypersphere's interior. That is also why the corner problem recurs — a box always circumscribes the ball, and the excess grows with dimension. Grounds in book-of-math ch-advanced-08 as metric spaces and in book-of-code ch 11 as the squared-distance test that avoids a square root.")
    (:eng "Every distance-thresholded substrate shares 'the box was used because it was easier' — the operator's check is measuring at the corner." :math "The closed ball {p : ‖p − c‖ ≤ r} under the Euclidean metric; the same set in every dimension." :cs "Squared-distance comparison; avoids the square root and keeps the test exact in integers."))
  :row-4-proof (
    (:claim "The filled set is exactly the integer points within the radius: nothing outside r is painted, and the painted area grows as r².")
    (:program "(set-mode 32 32)\n(clear 0)\n(set-color 9)\n(disc 16 16 6)\n;; 6² = 36, and (6,0) is on the boundary while (5,4) has 25+16=41 > 36.\n(display (list (pget 22 16) (pget 21 20) (pget 23 16)))"
     :eng-program "(set-mode 32 32)\n(define (area r)\n  (clear 0)\n  (set-color 9)\n  (disc 16 16 r)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 32) n)\n          ((>= x 32) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n;; Doubling the radius should roughly quadruple the count.\n(display (list (area 3) (area 6) (area 12)))"
     :math-program "(define (sq x) (* x x))\n(define (in? dx dy r) (<= (+ (sq dx) (sq dy)) (sq r)))\n;; The boundary case is decided exactly, in integers, with no rounding.\n(display (list (in? 6 0 6) (in? 5 4 6) (in? 4 4 6)))"
     :cs-program "(set-mode 32 32)\n(clear 0)\n(set-color 7)\n(disc 16 16 5)\n;; Nothing outside the bounding square can be lit.\n(display (list (pget 10 16) (pget 9 16) (pget 16 10) (pget 16 9)))"
     :invariant "∀ (dx,dy). painted(cx+dx, cy+dy) ⇔ dx² + dy² ≤ r²  ∧  |painted| = Θ(r²)"
     :meta "The pattern is an exactly-decidable region test — because the comparison is between integers there is no epsilon, no rounding and no ambiguity about the boundary. Falsified if any pixel outside the radius were painted, or if doubling r did not roughly quadruple the count; the first would mean the test leaked, the second would mean the fill was not two-dimensional. book-of-math ch-advanced-06 grounds area scaling as r²; book-of-code ch 11 grounds integer comparison as an exact predicate."))
    (:eng "The operator can predict fill cost and memory pressure from the radius alone: twice the radius is four times the pixels." :math "Area is a degree-2 homogeneous function of the radius; the lattice-point count approximates πr² with error O(r)." :cs "Exact integer predicate; no floating point, so the same input gives the same pixels on every machine.")
  :row-5-emergence (
    (:base "disc fills one round region.")
    (:composition "(set-mode 40 40)\n(clear 12)\n;; A snowman: three discs, decreasing radius, stacked.\n(set-color 7)\n(disc 20 32 7)\n(disc 20 21 5)\n(disc 20 13 3)\n(set-color 0)\n(disc 18 12 1)\n(disc 22 12 1)\n(display (list (pget 20 32) (pget 20 13) (pget 18 12) (pget 2 2)))"
     :eng-composition "(define (stack! cx base radii c)\n  ;; Each disc sits on the one below; the geometry falls out of the radii.\n  (set-color c)\n  (let loop ((rs radii) (y base) (n 0))\n    (if (null? rs) n\n        (begin\n          (disc cx y (car rs))\n          (loop (cdr rs) (- y (+ (car rs) (if (null? (cdr rs)) 0 (cadr rs)))) (+ n 1))))))\n(set-mode 40 40)\n(clear 12)\n(display (list (stack! 20 34 (list 6 4 3) 7) (pget 20 34)))"
     :math-composition "(set-mode 40 40)\n(clear 0)\n;; An annulus: fill the big disc, then punch the middle back to background.\n(set-color 9)\n(disc 20 20 14)\n(set-color 0)\n(disc 20 20 7)\n(display (list (pget 20 20) (pget 20 10) (pget 20 4)))"
     :cs-composition "(set-mode 40 40)\n(clear 0)\n;; Union of discs is a blob; the painted set is the union of the predicates.\n(set-color 11)\n(for-each (lambda (i) (disc (+ 12 (* i 6)) 20 5)) (iota 3))\n(display (list (pget 12 20) (pget 18 20) (pget 24 20) (pget 32 20)))"
     :emergent "A snowman, a parameterised stack, an annulus made by punching a hole, and a blob made from a union of overlapping discs: opaque fills compose by union and by subtraction, which is enough to build most rounded shapes.")
    (:meta "This is the constructive-solid-geometry family — build complex regions from simple ones by union and difference, where union is 'draw both' and difference is 'draw the second in the background colour'. Familiar analogs are boolean operations in CAD, path clipping in vector graphics and set algebra generally. The composition works because the fill is opaque and order-sensitive: a later disc in the background colour is exactly a set difference.")
    (:eng "The audit lens is 'is this shape a union, a difference or neither?' — the smoke test is probing inside the hole after a subtraction." :math "Opaque overpainting realises union when colours agree and set difference when the second is the background." :cs "Painter's algorithm as boolean algebra; the shape of every CSG modeller and every clipping path."))
)

(verb
  :name "line" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(line x0 y0 x1 y1) -> undefined"
  :summary "Stroke a one-pixel line from (x0, y0) to (x1, y1) inclusive, in the current pen colour. Returns nothing."
  :explanation "line is Bresenham's algorithm, the classic integer-only line rasteriser. It walks from the first endpoint to the second one pixel at a time, choosing at each step whether to advance in x, in y or in both, using nothing but integer additions and comparisons. Both endpoints are inclusive, so a line from (0,0) to (3,0) lights four pixels, not three. It handles every direction and slope, including vertical, horizontal and reversed, without special cases at the call site. Like the other primitives in this file it takes no colour argument: the pen set by set-color decides, and a fifth argument is silently discarded."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 40 20) (clear 0) (set-color 8) (line 0 0 39 19) (list (pget 0 0) (pget 39 19)))" :note "(8 8) — both endpoints are painted; the range is inclusive at both ends.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 16 8) (clear 0) (set-color 9) (line 0 3 7 3) (list (pget 0 3) (pget 7 3) (pget 8 3)))" :note "(9 9 0) — a horizontal line stops exactly at the second endpoint and goes no further.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 16 8) (clear 0) (set-color 9) (line 3 3 3 3) (pget 3 3))" :note "9 — a degenerate line whose endpoints coincide paints exactly one pixel rather than looping forever.")
  )
  :caveats ("IT TAKES NO COLOUR ARGUMENT. (line 0 0 5 5 3) draws in the PEN colour and ignores the 3. Marked needs-alfred alongside circle, disc, rect and rect-fill." "Both endpoints are INCLUSIVE, so the pixel count along an axis-aligned line is the difference plus one. Off-by-one errors here are the most common line bug." "There is no line width: the stroke is always one pixel, and a diagonal line is visibly thinner than a horizontal one of the same length." "Coordinates truncate toward zero, so a line computed in floating point lands slightly toward the origin at both ends." "Endpoints outside the canvas are not clipped analytically — the algorithm still walks every step and simply discards the off-canvas writes, so a line to a very distant point costs time proportional to its full length.")
  :drawbacks ("No thickness, no dash pattern, no cap or join style." "No anti-aliasing, so shallow diagonals show visible stair-stepping." "Drawing a polyline means calling it once per segment and repeating the shared endpoint." "The cost is proportional to the untruncated length, so a wildly off-canvas endpoint is an unbounded loop's worth of work.")
  :usecases ("Axes, grid lines, connectors and any straight stroke." "Building polygons and polylines segment by segment." "Drawing a crosshair or a ruler on top of a scene." "Sketching a graph by connecting consecutive sample points.")
  :related ("pset" "rect" "circle" "set-color" "plot")
  :learn (:concept "Rasterising a continuous object — a mathematical line has no width, so drawing it means choosing which pixels stand for it." :prerequisites ("set-mode" "set-color" "pset") :progression "Draw a horizontal line and count the pixels, then a diagonal, then compare with a hand-written loop over pset.")
  :row-2-audit (
    (:problem "A grid drawn with lines has one column too many on the right, because the loop used the canvas width as the last coordinate rather than the width minus one."
     :program "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n;; The right edge is at w-1, not at w; the extra line falls off silently.\n(line 0 0 16 0)\n(line 0 2 15 2)\n(list 'off-by-one (pget 15 0) 'correct (pget 15 2))"
     :eng-program "(define (hline! y w c)\n  ;; Take the WIDTH and compute the last index once, in one place.\n  (set-color c)\n  (line 0 y (- w 1) y)\n  (pget (- w 1) y))\n(set-mode 16 8)\n(clear 0)\n(display (list (hline! 1 16 9) (hline! 3 16 11)))"
     :math-program "(define (count-inclusive a b) (+ 1 (- b a)))\n;; Inclusive ranges: the count is the difference plus one.\n(list (count-inclusive 0 15) (count-inclusive 0 0) (count-inclusive 3 7))"
     :cs-program "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n(line 0 4 15 4)\n(define (count-row y)\n  (let loop ((x 0) (n 0))\n    (cond ((>= x 16) n)\n          ((> (pget x y) 0) (loop (+ x 1) (+ n 1)))\n          (else (loop (+ x 1) n)))))\n(display (list (count-row 4) 16))"
     :explanation "eng: compute the last index once from the width so the minus-one cannot be forgotten. math: state the inclusive-count formula explicitly. cs: count the lit pixels and compare against the width, which catches the error immediately."
     :meta "pset in a loop has the same off-by-one but makes the bound visible, which is why hand loops often get it right. rect computes its own last indices from a width and a height, so it sidesteps the issue entirely — that is an argument for using it where it fits. mode-info supplies the width the calculation needs. line is where the inclusive convention bites, so the audit belongs here.")
    (:eng "The audit lens is 'is this coordinate a count or an index?' — the smoke test is counting the lit pixels in the row." :math "An inclusive interval [a,b] contains b − a + 1 integers; a half-open one contains b − a." :cs "Fencepost error; the shape of every loop bound and every array index bug."))
  :row-3-dimension (
    (:setup "Approximate a continuous path by a sequence of discrete steps chosen to stay closest to it.")
    (:rungs (
       (:domain "line"         :code "(begin (set-mode 16 8) (clear 0) (set-color 9) (line 0 0 15 7) (list (pget 0 0) (pget 15 7)))")
       (:domain "staircase"    :code "(define (steps rise run)\n  (map (lambda (i) (list i (quotient (* rise i) run))) (iota (+ run 1))))\n(steps 3 6)")
       (:domain "rational-approximation" :code "(define (approx num den n)\n  (map (lambda (i) (quotient (* num i) den)) (iota n)))\n(approx 3 7 8)")))
    (:explanation "Rung 1: a mathematical line has no width, so drawing it means choosing at each column which row best stands for it. Rung 2: a staircase approximates a ramp with a sequence of discrete rises, and the choice of where each riser goes is the same decision. Rung 3: approximating a rational slope with integer steps is the arithmetic underneath both. All three replace a continuous object with the nearest available discrete one, and all three accumulate an error term that has to be tracked.")
    (:meta "The transfer works because discretisation is unavoidable whenever a continuous idea meets a finite grid, and the good algorithms all keep the accumulated error explicit rather than recomputing from scratch. Grounds in book-of-math ch-advanced-01 as the floor function and in book-of-code ch 11 as Bresenham's error accumulator.")
    (:eng "Every discretisation substrate shares 'the error accumulated and nobody was tracking it' — the operator's check is comparing the endpoints against the exact values." :math "Choosing the nearest lattice point to a real line; the error is bounded by half a step at every column." :cs "Incremental error accumulation; the shape of Bresenham, of DDA and of every fixed-point stepper."))
  :row-4-proof (
    (:claim "line is symmetric in its endpoints for the pixels it lights at the ends, and an axis-aligned line lights exactly |Δ| + 1 pixels.")
    (:program "(set-mode 20 10)\n(clear 0)\n(set-color 9)\n(line 2 5 17 5)\n(define (count-row y)\n  (let loop ((x 0) (n 0))\n    (cond ((>= x 20) n)\n          ((> (pget x y) 0) (loop (+ x 1) (+ n 1)))\n          (else (loop (+ x 1) n)))))\n(display (list (count-row 5) (+ 1 (- 17 2))))"
     :eng-program "(set-mode 20 10)\n(define (row-count y)\n  (let loop ((x 0) (n 0))\n    (cond ((>= x 20) n)\n          ((> (pget x y) 0) (loop (+ x 1) (+ n 1)))\n          (else (loop (+ x 1) n)))))\n(clear 0)\n(set-color 9)\n(line 3 4 16 4)\n(define forward (row-count 4))\n(clear 0)\n(line 16 4 3 4)\n(display (list forward (row-count 4) (= forward (row-count 4))))"
     :math-program "(define (inclusive-count a b) (+ 1 (abs (- b a))))\n(display (list (inclusive-count 2 17) (inclusive-count 17 2) (inclusive-count 5 5)))"
     :cs-program "(set-mode 20 10)\n(clear 0)\n(set-color 9)\n(line 0 0 19 9)\n;; Both endpoints lit in both directions.\n(define a (list (pget 0 0) (pget 19 9)))\n(clear 0)\n(line 19 9 0 0)\n(display (list a (list (pget 0 0) (pget 19 9))))"
     :invariant "∀ axis-aligned endpoints. |lit pixels| = |Δ| + 1  ∧  ∀ endpoints p q. endpoints(line(p,q)) = endpoints(line(q,p))"
     :meta "The pattern is that the rasterised segment is a function of the unordered PAIR of endpoints, at least at the ends — the interior may differ by a pixel on some slopes because the error term starts at a different place, but the endpoints never do. Falsified if reversing a line moved either endpoint; that would mean the algorithm was biased and a polygon's edges would not meet at their corners. book-of-math ch-advanced-02 grounds unordered-pair symmetry; book-of-code ch 11 grounds Bresenham's inclusive termination."))
    (:eng "The operator can draw polygon edges in any direction and trust the corners to meet exactly, with no gap and no doubled pixel." :math "Endpoint inclusion makes the segment a closed interval; the count is the cardinality of an inclusive integer range." :cs "Symmetric termination condition; what makes edge-shared rasterisation watertight.")
  :row-5-emergence (
    (:base "line strokes one straight segment.")
    (:composition "(set-mode 40 20)\n(clear 0)\n;; A polyline: consecutive segments sharing endpoints becomes a chart.\n(define data (list 3 9 5 15 8 12))\n(set-color 10)\n(let loop ((i 0))\n  (if (< i 5)\n      (begin\n        (line (* i 7) (- 19 (list-ref data i))\n              (* (+ i 1) 7) (- 19 (list-ref data (+ i 1))))\n        (loop (+ i 1)))\n      'done))\n(display (list (pget 0 16) (pget 7 10) (pget 35 7)))"
     :eng-composition "(define (polyline! pts c)\n  ;; Segments share endpoints, so n points give n-1 lines.\n  (set-color c)\n  (let loop ((ps pts) (n 0))\n    (if (or (null? ps) (null? (cdr ps))) n\n        (begin\n          (line (car (car ps)) (cadr (car ps))\n                (car (cadr ps)) (cadr (cadr ps)))\n          (loop (cdr ps) (+ n 1))))))\n(set-mode 40 20)\n(clear 0)\n(display (list (polyline! (list (list 0 0) (list 20 19) (list 39 0)) 11)\n               (pget 0 0) (pget 39 0)))"
     :math-composition "(set-mode 40 40)\n(clear 0)\n;; A star polygon: connect every k-th vertex around a ring.\n(set-color 9)\n(define pts (list (list 20 4) (list 36 16) (list 30 34) (list 10 34) (list 4 16)))\n(for-each\n  (lambda (i)\n    (let ((a (list-ref pts i)) (b (list-ref pts (modulo (+ i 2) 5))))\n      (line (car a) (cadr a) (car b) (cadr b))))\n  (iota 5))\n(display (list (pget 20 4) (pget 30 34)))"
     :cs-composition "(set-mode 24 12)\n(clear 0)\n;; A grid: horizontal and vertical strokes at a fixed pitch.\n(set-color 5)\n(for-each (lambda (i) (line 0 (* i 4) 23 (* i 4))) (iota 3))\n(for-each (lambda (i) (line (* i 6) 0 (* i 6) 11)) (iota 4))\n(display (list (pget 0 0) (pget 6 4) (pget 3 1)))"
     :emergent "A line chart, a generic polyline, a five-pointed star and a grid: every one of them is the same verb called in a loop over a list of points, which is why a point list is the right data structure for a drawing.")
    (:meta "This is the path-from-points family — represent a shape as an ordered list of vertices and render it by connecting consecutive pairs, so the shape is editable data and the renderer is one loop. Familiar analogs are SVG polylines, GPS tracks and the pen-up-pen-down model of a plotter. The composition works because line's endpoints are inclusive and symmetric, so shared vertices join exactly.")
    (:eng "The audit lens is 'do consecutive segments actually meet?' — the smoke test is probing the shared vertex after drawing both segments." :math "A polygonal path is a piecewise-linear map from an index set; closure is the extra edge from last back to first." :cs "Vertex list plus edge loop; the shape of every vector graphics path and every wireframe renderer."))
)

(verb
  :name "rect" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(rect x y w h) -> undefined"
  :summary "Stroke a rectangle OUTLINE whose top-left corner is (x, y), w wide and h tall, in the current pen colour."
  :explanation "rect draws four lines: across the top, down the right side, back along the bottom and up the left. The interior is untouched, so whatever was underneath shows through the middle. The coordinates are top-left plus size, not two corners — that matters, because the last painted column is x+w-1 and the last painted row is y+h-1. Width and height are clamped UP to 1, so a zero or negative size still draws something rather than nothing: a 1x1 rectangle at the given corner. Like the other primitives here it takes no colour argument, and the pen supplies the colour."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 40 20) (clear 0) (set-color 12) (rect 2 2 10 6) (list (pget 2 2) (pget 7 2) (pget 7 5)))" :note "(12 12 0) — the corner and the top edge are painted; the middle is not, because rect is an outline.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 40 20) (clear 0) (set-color 9) (rect 2 2 10 6) (list (pget 11 2) (pget 12 2) (pget 2 7) (pget 2 8)))" :note "(9 0 9 0) — the last painted column is x+w-1 = 11 and the last painted row is y+h-1 = 7; size, not corner.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 16 8) (clear 0) (set-color 9) (rect 2 2 0 4) (rect 8 2 -4 -4) (list (pget 2 2) (pget 8 2)))" :note "(9 9) — both degenerate sizes clamp UP to 1x1 and paint one pixel; neither raises and neither draws nothing.")
  )
  :caveats ("IT TAKES NO COLOUR ARGUMENT. (rect 2 2 10 6 3) draws in the PEN colour and drops the 3 — verified: the pixel reads the pen, not 3. Marked needs-alfred alongside circle, disc, line and rect-fill." "The last two arguments are a SIZE, not a second corner. (rect 2 2 10 6) reaches column 11 and row 7, not column 10 and row 6." "Zero and negative sizes are clamped UP to 1, so (rect 5 5 0 0) paints a pixel. A loop that computes a degenerate rectangle leaves a stray dot rather than nothing." "There is no line width; the outline is always one pixel." "Coordinates and sizes truncate toward zero before the clamp.")
  :drawbacks ("No rounded corners, no dash pattern, no stroke width." "No two-corner form, so code that has two corners must convert to size at every call site." "The clamp to 1 hides degenerate-geometry bugs behind a visible but meaningless dot." "Because the outline is drawn as four separate lines, the corners are painted twice, which matters only if you ever add blending.")
  :usecases ("Framing a region, a button, a panel or a selection." "Drawing a grid of boxes without hiding what is inside them." "Marking a bounding box during debugging so the contents stay visible." "Building a border around the whole canvas by using its width and height.")
  :related ("rect-fill" "rectangle" "draw-rect" "line" "set-color")
  :learn (:concept "Corner-plus-size versus corner-plus-corner — two ways to name a rectangle, and the off-by-one that lives between them." :prerequisites ("set-mode" "set-color" "line") :progression "Draw a rectangle, probe the far edge to find the last painted column, then draw one with a computed size that comes out zero.")
  :row-2-audit (
    (:problem "A layout draws adjacent panels using two corners rather than a size, so every panel overlaps its neighbour by one column and the shared borders come out double-thick."
     :program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n;; Corner plus SIZE. The next panel starts at x + w, not at x + w - 1.\n(rect 0 0 8 6)\n(rect 8 0 8 6)\n(list 'shared-edge (pget 7 0) (pget 8 0))"
     :eng-program "(define (panel! x y w h c)\n  ;; Return the next x so the caller cannot compute the adjacency wrongly.\n  (let ((prev (get-color)))\n    (set-color c)\n    (rect x y w h)\n    (set-color prev)\n    (+ x w)))\n(set-mode 24 12)\n(clear 0)\n(define x1 (panel! 0 0 8 6 9))\n(define x2 (panel! x1 0 8 6 11))\n(display (list x1 x2 (pget 7 0) (pget 8 0)))"
     :math-program "(define (last-index x w) (+ x (- w 1)))\n(define (next-start x w) (+ x w))\n;; The last painted index and the next starting index differ by one.\n(list (last-index 0 8) (next-start 0 8))"
     :cs-program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n(rect 0 0 8 6)\n(define (count-row y)\n  (let loop ((x 0) (n 0))\n    (cond ((>= x 24) n)\n          ((> (pget x y) 0) (loop (+ x 1) (+ n 1)))\n          (else (loop (+ x 1) n)))))\n(display (list (count-row 0) 8))"
     :explanation "eng: have the drawing helper return the next start coordinate so adjacency cannot be miscomputed. math: write down the two different formulas and see that they differ by exactly one. cs: count the pixels in the top row and compare against the width."
     :meta "rect-fill has the identical corner-plus-size convention and the identical hazard, so switching does not help. line takes two CORNERS, which is the opposite convention in the same chapter and the source of much of the confusion. mode-info supplies the canvas size, which is a count and therefore needs the minus one when used as an index. rect is where the two conventions collide, so the audit belongs here.")
    (:eng "The audit lens is 'is this number a size or an index?' — the smoke test is counting the painted pixels in one row." :math "[x, x+w) contains w integers whose largest is x+w−1; the successor interval starts at x+w." :cs "Half-open interval convention; the same discipline that makes array slicing compose without gaps or overlaps."))
  :row-3-dimension (
    (:setup "Describe a region by one anchor plus an extent, rather than by two boundaries.")
    (:rungs (
       (:domain "rect"         :code "(begin (set-mode 20 10) (clear 0) (set-color 9) (rect 2 2 6 4) (list (pget 2 2) (pget 7 2) (pget 8 2)))")
       (:domain "lease-term"   :code "(define (end-day start days) (+ start (- days 1)))\n(define (next-start start days) (+ start days))\n(list (end-day 1 30) (next-start 1 30))")
       (:domain "half-open-interval" :code "(define (members start len) (map (lambda (i) (+ start i)) (iota len)))\n(list (members 5 4) (length (members 5 4)))")))
    (:explanation "Rung 1: a rectangle given as corner plus size ends one short of corner plus size, and the next one starts exactly at corner plus size. Rung 2: a thirty-day lease starting on the first ends on the thirtieth, and the next lease starts on the thirty-first. Rung 3: a half-open interval of length n starting at s contains s through s+n-1. All three carry the same minus-one, and all three break the same way when a length is used as a bound.")
    (:meta "The transfer works because a count and a position are different kinds of quantity that share a numeral, so nothing but discipline keeps them apart. The half-open convention is the standard fix because it makes adjacent ranges compose with no arithmetic at the seam. Grounds in book-of-math ch-advanced-01 as interval notation and in book-of-code ch 05 as the half-open slicing convention.")
    (:eng "Every anchor-plus-extent substrate shares 'the extent was used as a bound' — the operator's check is that adjacent regions share no element." :math "[a, a+n) has cardinality n and supremum a+n−1; the union with [a+n, a+2n) is disjoint and gapless." :cs "Half-open ranges; the shape of every slice, every buffer offset and every date range."))
  :row-4-proof (
    (:claim "The outline touches exactly the perimeter: the four edges are painted and the strict interior is untouched.")
    (:program "(set-mode 20 12)\n(clear 3)\n(set-color 9)\n(rect 2 2 10 6)\n;; Perimeter lit, interior still background.\n(display (list (pget 2 2) (pget 11 2) (pget 2 7) (pget 11 7) (pget 6 4)))"
     :eng-program "(set-mode 20 12)\n(clear 3)\n(set-color 9)\n(rect 2 2 10 6)\n(define (count-interior)\n  (let loop ((x 3) (y 3) (n 0))\n    (cond ((>= y 7) n)\n          ((>= x 11) (loop 3 (+ y 1) n))\n          ((= (pget x y) 3) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n;; The strict interior is 8 wide by 4 tall.\n(display (list (count-interior) (* 8 4)))"
     :math-program "(define (perimeter w h) (- (* 2 (+ w h)) 4))\n(define (interior w h) (* (- w 2) (- h 2)))\n;; Perimeter plus interior is the whole box.\n(display (list (perimeter 10 6) (interior 10 6) (+ (perimeter 10 6) (interior 10 6)) (* 10 6)))"
     :cs-program "(set-mode 20 12)\n(clear 0)\n(set-color 9)\n(rect 2 2 10 6)\n(define (count-lit)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 12) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (count-lit) (- (* 2 (+ 10 6)) 4)))"
     :invariant "∀ w,h ≥ 2. |lit| = 2(w + h) − 4  ∧  the strict interior (w−2)(h−2) is untouched"
     :meta "The pattern is that a perimeter is a one-dimensional boundary of a two-dimensional region, so its size grows linearly while the region's grows quadratically — and the minus four is the four corners that would otherwise be counted twice. Falsified if any interior pixel changed, or if the count differed from 2(w+h)−4; the first would mean the outline leaked, the second that a corner was doubled or dropped. book-of-math ch-advanced-06 grounds perimeter versus area; book-of-code ch 05 grounds inclusion-exclusion for the shared corners."))
    (:eng "The operator can predict outline cost from the size and can trust that framing a region never damages its contents." :math "Perimeter is degree-1 homogeneous while area is degree-2; the gap widens as the rectangle grows." :cs "Inclusion-exclusion on the four edges; subtract the four doubly-counted corners.")
  :row-5-emergence (
    (:base "rect strokes one box outline.")
    (:composition "(set-mode 40 24)\n(clear 12)\n;; A framed panel over a background: the frame does not hide the contents.\n(set-color 9)\n(disc 20 12 8)\n(set-color 7)\n(rect 8 4 24 16)\n(display (list 'background (pget 2 2) 'contents (pget 20 12) 'frame (pget 8 4)))"
     :eng-composition "(define (grid-of-boxes! cols rows bw bh c)\n  ;; Each box starts where the last one ended; no overlap, no gap.\n  (set-color c)\n  (for-each\n    (lambda (r)\n      (for-each (lambda (k) (rect (* k bw) (* r bh) bw bh)) (iota cols)))\n    (iota rows))\n  (* cols rows))\n(set-mode 24 12)\n(clear 0)\n(display (list (grid-of-boxes! 3 2 8 6 11) (pget 0 0) (pget 8 0) (pget 7 0)))"
     :math-composition "(set-mode 40 40)\n(clear 0)\n;; Nested rectangles: the perimeters never intersect, so all of them stay visible.\n(set-color 9)\n(for-each (lambda (i) (rect (* i 4) (* i 4) (- 40 (* i 8)) (- 40 (* i 8)))) (iota 4))\n(display (list (pget 0 0) (pget 4 4) (pget 8 8) (pget 12 12) (pget 20 20)))"
     :cs-composition "(set-mode 24 12)\n(clear 0)\n;; A debug overlay: outline the bounding box without hiding the sprite.\n(set-color 11)\n(disc 12 6 4)\n(set-color 7)\n(rect 8 2 9 9)\n(display (list 'sprite (pget 12 6) 'box (pget 8 2) 'inside-box-still-sprite (pget 12 6)))"
     :emergent "A framed panel, a gapless grid, nested frames and a debug bounding box: outlines compose because they add information without removing any, which is exactly what a debugging or framing layer needs.")
    (:meta "This is the non-occluding overlay family — draw the structure of a scene on top of its content so both can be read at once. Familiar analogs are a devtools element inspector, a photographer's rule-of-thirds grid and a wireframe view in a 3D modeller. The composition works because the outline's painted set is the perimeter only, so nested and adjacent frames leave every interior visible.")
    (:eng "The audit lens is 'does the overlay hide what it describes?' — the smoke test is probing the content pixel after drawing the frame." :math "A union of perimeters has empty interior, so it cannot cover any region." :cs "Overlay layer; the shape of every inspector, every guide and every non-destructive annotation."))
)

(verb
  :name "rect-fill" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(rect-fill x y w h) -> undefined"
  :summary "Fill a solid rectangle whose top-left corner is (x, y), w wide and h tall, in the current pen colour."
  :explanation "rect-fill is the workhorse of this library. It writes every pixel of the rectangle in two nested loops, which makes it the fastest way to cover area — far cheaper per pixel than disc, which tests a distance for every candidate, and cheaper than a hand loop over pset, which pays interpreter overhead per pixel. Like rect it takes a corner and a SIZE, so the last painted column is x+w-1. Width and height clamp up to 1, so a degenerate size still paints one pixel. It is opaque: everything under it is gone. And like every primitive in this file it takes no colour argument, drawing in the pen."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 40 20) (clear 0) (set-color 13) (rect-fill 2 2 10 6) (list (pget 2 2) (pget 7 5) (pget 12 5)))" :note "(13 13 0) — corner and interior are both painted; one past the last column is not.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 40 20) (clear 3) (set-color 9) (rect-fill 0 14 40 6) (list (pget 20 13) (pget 20 14)))" :note "(3 9) — a full-width band; the row above it is untouched, so the fill is exactly h rows tall.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 16 8) (clear 0) (set-color 9) (rect-fill 4 4 0 0) (list (pget 4 4) (pget 5 4)))" :note "(9 0) — a zero size clamps up to 1x1 and paints exactly one pixel rather than nothing.")
  )
  :caveats ("IT TAKES NO COLOUR ARGUMENT. (rect-fill 2 2 10 6 3) fills in the PEN colour and drops the 3, while its fb-namespace sibling fb/rect DOES take one. Marked needs-alfred." "Corner plus SIZE, not corner plus corner: (rect-fill 2 2 10 6) covers columns 2..11 and rows 2..7." "Zero and negative sizes clamp UP to 1, so a computed-empty rectangle paints a stray pixel instead of nothing." "It is opaque with no blending, so it destroys everything underneath inside its bounds." "Coordinates and sizes truncate toward zero before the clamp is applied.")
  :drawbacks ("No rounded corners and no gradient; the fill is one flat index." "No clipping report, so a rectangle entirely off-canvas costs the full w·h loop and paints nothing." "The clamp to 1 turns an empty region into a visible artefact, which hides layout bugs." "The ambient pen makes a fill inside a helper depend on the caller's last set-color.")
  :usecases ("Backgrounds for bands, panels, health bars and progress bars." "Erasing a rectangular region by filling it with the background colour." "Tile maps, where every cell is a filled square." "Any large area fill, where it is the cheapest verb available.")
  :related ("rect" "fill-rect" "filled-rectangle" "fb/rect" "clear")
  :learn (:concept "Area fill as nested iteration — the two-dimensional analogue of a loop, and the cost model that comes with it." :prerequisites ("set-mode" "set-color" "rect") :progression "Fill a rectangle, probe its far corner to find the last painted cell, then fill one with a computed-zero size and find the stray pixel.")
  :row-2-audit (
    (:problem "A health bar drawn as a filled rectangle never disappears at zero health, because a width of 0 clamps up to 1 and leaves a single stubborn pixel on screen."
     :program "(set-mode 40 20)\n(clear 0)\n(set-color 8)\n;; Zero width does NOT mean nothing: it clamps to one pixel.\n(rect-fill 4 4 0 3)\n(list 'zero-width (pget 4 4) (pget 5 4))"
     :eng-program "(define (bar! x y w h c)\n  ;; Guard the degenerate case yourself; the primitive will not.\n  (if (> w 0)\n      (begin (set-color c) (rect-fill x y w h) 'drawn)\n      'skipped))\n(set-mode 40 20)\n(clear 0)\n(display (list (bar! 4 4 0 3 8) (pget 4 4) (bar! 10 4 6 3 8) (pget 10 4)))"
     :math-program "(define (clamped w) (max 1 w))\n;; The clamp maps the empty extent onto a non-empty one; it is not the identity.\n(map clamped (list -3 0 1 5))"
     :cs-program "(set-mode 20 10)\n(clear 0)\n(set-color 9)\n(rect-fill 5 5 0 0)\n(define (count-lit)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 10) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (count-lit) 'expected-zero-got-one))"
     :explanation "eng: guard the zero case at the call site, because the primitive turns it into a visible artefact. math: notice the clamp is not the identity on the empty extent. cs: count lit pixels to see one where zero was intended."
     :meta "rect has exactly the same clamp and the same stray pixel. clear takes no extent at all and so cannot degenerate. fb/rect passes its width and height through the same rectFill and inherits the clamp too. rect-fill is the verb a progress bar reaches for, so the audit belongs here — the fix is a guard, not a different verb.")
    (:eng "The audit lens is 'what does this verb do with an empty extent?' — the smoke test is calling it with zero and counting lit pixels." :math "max(1, w) is not the identity at w ≤ 0; the empty set is mapped to a singleton." :cs "Defensive clamping that changes semantics; the shape of every 'helpful' minimum that hides a real zero."))
  :row-3-dimension (
    (:setup "Cover a two-dimensional region by iterating rows and columns.")
    (:rungs (
       (:domain "rect-fill"    :code "(begin (set-mode 20 10) (clear 0) (set-color 9) (rect-fill 2 2 6 4) (list (pget 2 2) (pget 7 5) (pget 8 5)))")
       (:domain "mowing-a-lawn" :code "(define (strips w h) (map (lambda (y) (list 'strip y w)) (iota h)))\n(list (length (strips 10 4)) (car (strips 10 4)))")
       (:domain "cartesian-product" :code "(define (pairs xs ys)\n  (apply append (map (lambda (x) (map (lambda (y) (list x y)) ys)) xs)))\n(list (length (pairs (iota 3) (iota 4))) (car (pairs (iota 3) (iota 4))))")))
    (:explanation "Rung 1: rect-fill runs a loop over rows and inside it a loop over columns, touching w·h cells. Rung 2: mowing a lawn is the same traversal made physical — strip by strip, each strip the full width. Rung 3: the Cartesian product of two index sets has exactly the same cardinality and the same structure. All three are the two-dimensional traversal, and all three cost the product of the extents.")
    (:meta "The transfer works because covering an area is inherently the product of two one-dimensional traversals, so the cost model is multiplicative in every substrate. That is why halving a dimension quarters nothing but halves the work, and why doubling both quadruples it. Grounds in book-of-math ch-advanced-03 as the Cartesian product and in book-of-code ch 11 as the nested loop's cost.")
    (:eng "Every area-covering substrate shares 'the cost was estimated linearly' — the operator's check is multiplying the two extents." :math "|A × B| = |A|·|B|; area is the product measure of the two intervals." :cs "Nested iteration; the shape of every O(n·m) double loop and every image-processing kernel."))
  :row-4-proof (
    (:claim "The filled set is exactly the product of the two index ranges: w·h pixels, all inside, none outside.")
    (:program "(set-mode 20 12)\n(clear 0)\n(set-color 9)\n(rect-fill 3 3 6 4)\n(define (count-lit)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 12) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (count-lit) (* 6 4)))"
     :eng-program "(set-mode 20 12)\n(define (area w h)\n  (clear 0)\n  (set-color 9)\n  (rect-fill 2 2 w h)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 12) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n;; Doubling both extents quadruples the count.\n(display (list (area 3 2) (area 6 4)))"
     :math-program "(define (product w h) (* w h))\n(display (list (product 3 2) (product 6 4) (= (product 6 4) (* 4 (product 3 2)))))"
     :cs-program "(set-mode 20 12)\n(clear 0)\n(set-color 9)\n(rect-fill 3 3 6 4)\n;; Boundaries: last painted is (8,6), one past is clean.\n(display (list (pget 8 6) (pget 9 6) (pget 8 7) (pget 2 3)))"
     :invariant "∀ w,h ≥ 1. painted = [x, x+w) × [y, y+h)  ∧  |painted| = w·h"
     :meta "The pattern is that a filled rectangle realises a Cartesian product exactly, which is what makes its cost and its extent both predictable from two numbers. Falsified if the count differed from w·h, or if any pixel outside the half-open product were painted; either would mean the loop bounds were wrong and every tile map built on it would show seams. book-of-math ch-advanced-03 grounds the product measure; book-of-code ch 11 grounds the nested loop's exact iteration count."))
    (:eng "The operator can compute fill cost and screen coverage from two numbers, and can tile without gaps by stepping exactly w and h." :math "The painted set is the product of two half-open integer intervals; its cardinality is the product of their lengths." :cs "Nested loop with exact bounds; the same accounting as a two-dimensional array's element count.")
  :row-5-emergence (
    (:base "rect-fill covers one solid rectangle.")
    (:composition "(set-mode 40 24)\n(clear 12)\n;; A landscape: bands of colour, each a full-width filled rectangle.\n(set-color 7)\n(rect-fill 0 0 40 6)\n(set-color 11)\n(rect-fill 0 6 40 10)\n(set-color 4)\n(rect-fill 0 16 40 8)\n(display (list (pget 20 2) (pget 20 10) (pget 20 20)))"
     :eng-composition "(define (tilemap! rows tile c0 c1)\n  ;; Each cell is one filled square; stepping by the tile size leaves no seam.\n  (let loop ((rs rows) (r 0) (n 0))\n    (if (null? rs) n\n        (begin\n          (let inner ((cs (car rs)) (k 0))\n            (if (null? cs) 'row\n                (begin\n                  (set-color (if (= (car cs) 1) c1 c0))\n                  (rect-fill (* k tile) (* r tile) tile tile)\n                  (inner (cdr cs) (+ k 1)))))\n          (loop (cdr rs) (+ r 1) (+ n 1))))))\n(set-mode 24 12)\n(display (list (tilemap! (list (list 1 0 1) (list 0 1 0)) 6 1 9)\n               (pget 0 0) (pget 6 0) (pget 6 6)))"
     :math-composition "(set-mode 40 20)\n(clear 0)\n;; A histogram: each bar's height is the datum, its area is proportional.\n(define data (list 4 9 15 7 12))\n(set-color 10)\n(for-each (lambda (i)\n            (let ((v (list-ref data i)))\n              (rect-fill (* i 8) (- 20 v) 6 v)))\n          (iota 5))\n(display (list (pget 0 16) (pget 0 15) (pget 16 5)))"
     :cs-composition "(set-mode 40 20)\n(clear 1)\n;; A progress bar: track, then fill, then a guard against the zero case.\n(define (progress! pct)\n  (set-color 5)\n  (rect-fill 4 8 32 4)\n  (if (> pct 0)\n      (begin (set-color 11) (rect-fill 4 8 (quotient (* 32 pct) 100) 4)))\n  (pget 4 8))\n(display (list (progress! 50) (pget 19 8) (pget 21 8)))"
     :emergent "Colour bands, a tile map, a histogram and a guarded progress bar: the filled rectangle is the unit from which most two-dimensional interfaces are actually assembled.")
    (:meta "This is the tiling family — cover a plane with non-overlapping rectangles whose sizes encode data, so position and extent both carry meaning. Familiar analogs are CSS box layout, a spreadsheet's cells and a treemap visualisation. The composition works because the painted set is exactly the half-open product, so stepping by exactly the tile size gives adjacency with no gap and no overlap.")
    (:eng "The audit lens is 'do the tiles meet exactly?' — the smoke test is probing the seam column between two adjacent fills." :math "A partition of a rectangle into half-open sub-rectangles is disjoint and covering; the measures add." :cs "Box layout; the shape of every grid system, every treemap and every tile engine."))
)
(verb
  :name "rectangle" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(rectangle x y w h) -> undefined"
  :summary "An alias of rect: stroke a rectangle outline at (x, y), w wide and h tall, in the current pen colour."
  :explanation "rectangle is the same function object as rect, bound under its full English name. The two exist because Racket's 2htdp/image library — which many Motoi learners will meet before or after this one — spells the outline verb rectangle, and a program copied across should not have to be renamed to run. Behaviourally there is nothing new: corner plus size, last painted column x+w-1, width and height clamped up to 1, interior untouched, colour taken from the pen and any fifth argument silently discarded. Prefer rectangle in prose-like teaching code and rect where terseness matters."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 12) (clear 0) (set-color 6) (rectangle 1 1 5 5) (list (pget 1 1) (pget 3 3)))" :note "(6 0) — outline only, exactly as rect draws it.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 12) (clear 0) (set-color 9) (rectangle 2 2 6 4) (rect 12 2 6 4) (list (pget 2 2) (pget 12 2)))" :note "(9 9) — the two names cannot be told apart by any probe.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 12) (clear 0) (set-color 9) (rectangle 4 4 1 1) (list (pget 4 4) (pget 5 4)))" :note "(9 0) — a 1x1 rectangle is a single pixel; the size is a count, not an offset.")
  )
  :caveats ("It is an ALIAS of rect, so it inherits every defect: no colour argument, corner-plus-size rather than two corners, and sizes clamped up to 1. Marked needs-alfred alongside rect." "Racket's 2htdp/image rectangle takes a mode and a colour and RETURNS an image; this one paints immediately and returns nothing. The names agree and the semantics do not." "It draws the outline. The filled version is a different name entirely — fill-rect or filled-rectangle — not a mode argument." "A fifth argument, which a Racket program would supply as the colour, is silently discarded." "Redefining rect does not redefine rectangle; the alias captured the function object at install time.")
  :drawbacks ("The shared name with 2htdp/image invites a wrong mental model — image values versus immediate painting." "Four names across the rect family makes searching a codebase for rectangle drawing a four-term search." "No stroke width, no rounded corners, no dash pattern." "It is the longest name in the family to type in an inner loop.")
  :usecases ("Teaching code where the full English word reads better than the abbreviation." "Porting a shape from Racket's 2htdp/image with a minimum of edits." "Matching an existing cart's house style rather than rewriting its calls." "Any place rect would be used; the choice is readability only.")
  :related ("rect" "draw-rect" "fill-rect" "filled-rectangle" "set-color")
  :learn (:concept "A shared name across libraries does not imply shared semantics — check the return value first." :prerequisites ("rect") :progression "Draw with rectangle, then with rect, and probe both; then look up what Racket's rectangle returns and note the difference.")
  :row-2-audit (
    (:problem "A student copies (rectangle 40 20 'outline 'red) from a Racket exercise; it runs without error, paints a 40x20 outline in whatever the pen was, and the two extra arguments vanish."
     :program "(set-mode 40 24)\n(clear 0)\n(set-color 3)\n;; The extra arguments are dropped in silence; the pen decides the colour.\n(rectangle 2 2 20 10 'outline 'red)\n(list 'pen-colour (get-color) 'pixel (pget 2 2))"
     :eng-program "(define (rectangle! x y w h c)\n  ;; Make the colour a real parameter and restore the pen afterwards.\n  (let ((prev (get-color)))\n    (set-color c)\n    (rectangle x y w h)\n    (set-color prev)\n    (pget x y)))\n(set-mode 40 24)\n(clear 0)\n(set-color 3)\n(display (list (rectangle! 2 2 20 10 9) (get-color)))"
     :math-program "(define (arity-used given accepted) (min given accepted))\n;; Extra arguments are not an error here; they are simply outside the arity.\n(list (arity-used 6 4) (arity-used 4 4))"
     :cs-program "(set-mode 24 12)\n(clear 0)\n(set-color 5)\n(rectangle 2 2 8 6 'outline 'red)\n(display (list (pget 2 2) 'not-red-but-pen))"
     :explanation "eng: wrap it so the colour is a real parameter that cannot be silently dropped. math: name the fact that extra arguments fall outside the arity rather than raising. cs: probe the pixel and show it took the pen, not the ignored symbol."
     :meta "rect has exactly the same behaviour and the same silence. fb/rect is the one rectangle verb in the engine that DOES accept a colour, including a symbol, and restores the pen afterwards — it is the closest thing to what the ported call expected. set-color makes the colour explicit but paints nothing. rectangle is where a Racket-shaped call lands, so the audit belongs here.")
    (:eng "The audit lens is 'were any arguments ignored?' — the smoke test is passing a deliberately wrong extra argument and seeing nothing change." :math "A function of arity 4 applied to 6 arguments is still a function of the first 4; the rest are outside the domain." :cs "Silent extra-argument acceptance; the shape of every variadic boundary that swallows a typo."))
  :row-3-dimension (
    (:setup "The same word used by two systems for two different kinds of thing.")
    (:rungs (
       (:domain "rectangle"     :code "(begin (set-mode 20 10) (clear 0) (set-color 9) (rectangle 2 2 6 4) (pget 2 2))")
       (:domain "false-friend"  :code "(define (translate word lang)\n  (cond ((and (eq? word 'actual) (eq? lang 'en)) 'real)\n        ((and (eq? word 'actual) (eq? lang 'es)) 'current)\n        (else 'unknown)))\n(list (translate 'actual 'en) (translate 'actual 'es))")
       (:domain "overloaded-symbol" :code "(define (meaning-of sym domain)\n  (cond ((and (eq? sym 'star) (eq? domain 'regex)) 'zero-or-more)\n        ((and (eq? sym 'star) (eq? domain 'math)) 'convolution)\n        (else 'unknown)))\n(list (meaning-of 'star 'regex) (meaning-of 'star 'math))")))
    (:explanation "Rung 1: rectangle here paints immediately and returns nothing, while Racket's rectangle builds an image value; the word is shared, the kind of thing is not. Rung 2: a false friend across two languages looks like a translation and is not. Rung 3: one symbol carrying two meanings in two domains gives nonsense if you read it with the wrong domain in mind. All three fail because recognition arrives before checking.")
    (:meta "The transfer works because names are cheap and meanings are contextual, so collisions are inevitable across independently designed systems. The defence is always the same: check the signature and the return kind, not the spelling. Grounds in book-of-eng ch 07 as the porting hazard and in book-of-code ch 05 as the distinction between name and denotation.")
    (:eng "Every shared-name substrate shares 'recognised, therefore assumed' — the operator's check is what the call RETURNS." :math "A symbol's interpretation is relative to a structure; the same glyph denotes different operations in different ones." :cs "Name collision across libraries; the shape of every namespace conflict and every drop-in replacement that is not."))
  :row-4-proof (
    (:claim "rectangle and rect are the same function object: they agree on the clamp, on the corner-plus-size convention and on ignoring extra arguments.")
    (:program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n(rectangle 1 1 6 4)\n(define a (list (pget 1 1) (pget 6 1) (pget 7 1)))\n(clear 0)\n(rect 1 1 6 4)\n(display (list a (equal? a (list (pget 1 1) (pget 6 1) (pget 7 1)))))"
     :eng-program "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n;; The shared clamp on a degenerate size is the strongest evidence of identity.\n(rectangle 2 2 0 0)\n(define a (pget 2 2))\n(clear 0)\n(rect 8 2 0 0)\n(display (list a (pget 8 2) (= a (pget 8 2))))"
     :math-program "(define (agree? f g xs) (equal? (map f xs) (map g xs)))\n(display (agree? (lambda (w) (max 1 w)) (lambda (w) (if (< w 1) 1 w)) (list -3 0 1 7)))"
     :cs-program "(set-mode 16 8)\n(define (probe f) (clear 0) (set-color 7) (f 2 2 5 3) (list (pget 2 2) (pget 6 2) (pget 4 3)))\n(display (equal? (probe rectangle) (probe rect)))"
     :invariant "∀ x y w h. rectangle(x,y,w,h) ≡ rect(x,y,w,h)  (one function object under two bindings)"
     :meta "The pattern is establishing equality by shared reference rather than by exhaustive testing — including agreement on the degenerate cases, which independently written implementations would be unlikely to match. Falsified if any input separated the names; that would mean the alias is a reimplementation and could drift under maintenance. book-of-code ch 05 grounds referential identity; book-of-eng ch 07 grounds shared failure modes as evidence of shared code."))
    (:eng "The operator can substitute rectangle for rect anywhere with no visual diff, and knows a fix to one fixes both." :math "Two labels on one element of function space; equality is definitional, not empirical." :cs "Value-captured alias; the same guarantee an inlined alias gives a compiler.")
  :row-5-emergence (
    (:base "rectangle strokes one box outline.")
    (:composition "(set-mode 40 24)\n(clear 12)\n;; A window with a title bar: two outlines and one divider.\n(set-color 7)\n(rectangle 4 4 32 16)\n(line 4 8 35 8)\n(display (list 'frame (pget 4 4) 'divider (pget 20 8) 'interior (pget 20 14)))"
     :eng-composition "(define (window! x y w h c)\n  ;; Frame plus title bar; the interior stays whatever was behind it.\n  (set-color c)\n  (rectangle x y w h)\n  (line x (+ y 4) (+ x (- w 1)) (+ y 4))\n  (list (pget x y) (pget (+ x 2) (+ y 4))))\n(set-mode 40 24)\n(clear 12)\n(display (list (window! 2 2 20 12 7) (window! 24 2 14 12 9)))"
     :math-composition "(set-mode 40 24)\n(clear 0)\n;; Nested outlines: perimeters never overlap, so all of them stay legible.\n(set-color 9)\n(for-each (lambda (i) (rectangle (* i 3) (* i 3) (- 40 (* i 6)) (- 24 (* i 6)))) (iota 4))\n(display (list (pget 0 0) (pget 3 3) (pget 6 6) (pget 20 12)))"
     :cs-composition "(set-mode 40 24)\n(clear 0)\n;; A layout tree drawn as boxes: each node's box contains its children's.\n(define (box! x y w h c) (set-color c) (rectangle x y w h) (list x y w h))\n(box! 0 0 40 24 7)\n(box! 2 2 18 20 9)\n(box! 22 2 16 20 11)\n(box! 4 4 14 8 5)\n(display (list (pget 0 0) (pget 2 2) (pget 22 2) (pget 4 4) (pget 10 8)))"
     :emergent "A window frame, a reusable window helper, nested frames and a layout tree: outline rectangles nest arbitrarily because a perimeter never covers an interior.")
    (:meta "This is the containment-hierarchy family — nested boxes express a tree, where each node's extent contains its children's and the drawing IS the data structure. Familiar analogs are the DOM's box model, a file manager's nested folder view and a treemap. The composition works because outlines are non-occluding: an outer box never hides an inner one, so the whole hierarchy is visible at once.")
    (:eng "The audit lens is 'is every level of the hierarchy visible?' — the smoke test is probing the innermost box after drawing the outermost." :math "Nested rectangles form a chain under inclusion; the perimeters are pairwise disjoint when the nesting is strict." :cs "Containment tree; the shape of every box model, every scene graph and every treemap."))
)

(verb
  :name "draw-rect" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(draw-rect x y w h) -> undefined"
  :summary "An alias of rect: stroke a rectangle outline at (x, y), w wide and h tall, in the current pen colour."
  :explanation "draw-rect is the third binding of rect's function object. The draw- prefix is a convention borrowed from immediate-mode graphics libraries where drawX means stroke the outline of X and fillX means fill it — so draw-rect and fill-rect are meant to be read as a matched pair. That pairing is the reason to prefer these two names over rect and rect-fill: the prefix carries the outline-versus-fill distinction at the front of the word, where the eye finds it, rather than in a suffix. Everything else is rect unchanged: corner plus size, clamp up to 1, no colour argument, extra arguments dropped."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 12) (clear 0) (set-color 6) (draw-rect 10 1 5 5) (list (pget 10 1) (pget 12 3)))" :note "(6 0) — draw- means outline, so the middle is untouched.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 12) (clear 0) (set-color 9) (draw-rect 2 2 8 6) (fill-rect 14 2 8 6) (list (pget 5 5) (pget 17 5)))" :note "(0 9) — the matched pair: draw- leaves the interior alone, fill- covers it.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 12) (clear 0) (set-color 9) (draw-rect 2 2 8 6) (rect 14 2 8 6) (list (pget 2 2) (pget 14 2)))" :note "(9 9) — draw-rect and rect are one function; the prefix is documentation.")
  )
  :caveats ("It is an ALIAS of rect and inherits every defect: no colour argument, corner-plus-size, sizes clamped up to 1. Marked needs-alfred alongside rect." "The draw-/fill- pairing is only a convention. Nothing in the engine links draw-rect to fill-rect, and there is no draw-circle to pair with a fill-circle — the family is incomplete." "It draws an outline despite draw- reading in plain English as 'draw a rectangle', which a beginner may take to mean a solid one." "Extra arguments, including a colour copied from another library's signature, are silently ignored." "Redefining rect does not redefine draw-rect; the binding captured the function object at install time.")
  :drawbacks ("The draw-/fill- convention sets up an expectation of a complete family that the engine does not provide." "Four names for the outline and four for the fill makes any codebase-wide search awkward." "No stroke width, no rounded corners, no dash pattern." "The prefix adds five characters to a call that appears in inner loops.")
  :usecases ("Code that consistently uses the draw-/fill- prefix pair so the distinction is visible at a glance." "Porting from an immediate-mode library that uses the same convention." "Teaching the outline-versus-fill distinction, where the prefix does the explaining." "Any place rect would be used; the choice is readability only.")
  :related ("rect" "rectangle" "fill-rect" "filled-rectangle" "set-color")
  :learn (:concept "Prefix conventions that encode a distinction the signature does not — and the limits of relying on them." :prerequisites ("rect" "rect-fill") :progression "Draw with draw-rect and fill-rect side by side, then look for a draw-circle and find that the convention stops here.")
  :row-2-audit (
    (:problem "A programmer relies on the draw-/fill- convention and writes (fill-circle 10 10 4), which is unbound; the program dies at run time on a name that the convention implied should exist."
     :program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n;; The pair exists for rectangles only. Circles use circle and disc.\n(draw-rect 2 2 8 6)\n(circle 18 6 4)\n(list 'rect-outline (pget 2 2) 'circle-outline (pget 22 6))"
     :eng-program "(define (draw-shape! kind a b c d col)\n  ;; A dispatch table papers over an inconsistent naming family.\n  (set-color col)\n  (cond ((eq? kind 'rect-outline) (draw-rect a b c d) 'ok)\n        ((eq? kind 'rect-fill) (fill-rect a b c d) 'ok)\n        ((eq? kind 'circle-outline) (circle a b c) 'ok)\n        ((eq? kind 'circle-fill) (disc a b c) 'ok)\n        (else 'unknown)))\n(set-mode 24 12)\n(clear 0)\n(display (list (draw-shape! 'rect-outline 2 2 6 4 9)\n               (draw-shape! 'circle-fill 18 6 3 0 11)\n               (pget 18 6)))"
     :math-program "(define (complete? family) (if (eq? family 'rect) #t #f))\n;; The naming family is partial: it covers rectangles and stops.\n(list (complete? 'rect) (complete? 'circle))"
     :cs-program "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n(draw-rect 2 2 6 4)\n(display (list (pget 2 2) (pget 4 3) 'outline-not-fill))"
     :explanation "eng: build a dispatch table so callers name a shape and a mode rather than guessing a verb name. math: state plainly that the family is partial. cs: probe the interior to confirm draw- really did mean outline."
     :meta "rect and rect-fill are the same two functions under suffix names, and the suffix family is equally incomplete — there is no circle-fill either. disc is the fill for circles but shares no naming convention with anything. fill-rect completes the prefix pair for rectangles only. draw-rect is where the convention is introduced, so the audit that it does not generalise belongs here.")
    (:eng "The audit lens is 'does this naming family actually cover the cases I need?' — the smoke test is trying the name the convention implies." :math "A partial naming scheme; the map from (shape, mode) to verb name is not total." :cs "Convention-implied API surface; the shape of every framework where the pattern holds for three cases and breaks on the fourth."))
  :row-3-dimension (
    (:setup "A prefix that names the mode of an operation, applied consistently to only part of a family.")
    (:rungs (
       (:domain "draw-rect"    :code "(begin (set-mode 20 10) (clear 0) (set-color 9) (draw-rect 2 2 6 4) (list (pget 2 2) (pget 4 3)))")
       (:domain "irregular-plural" :code "(define (plural word)\n  (cond ((eq? word 'cat) 'cats) ((eq? word 'child) 'children) (else 'add-s)))\n(map plural (list 'cat 'child 'dog))")
       (:domain "partial-function" :code "(define (safe-div a b) (if (= b 0) 'undefined (quotient a b)))\n(list (safe-div 10 2) (safe-div 10 0))")))
    (:explanation "Rung 1: the draw-/fill- prefix pair covers rectangles and nothing else, so extrapolating it fails. Rung 2: a plural rule that works for most nouns and not for some is a rule you cannot apply blindly. Rung 3: a partial function is undefined somewhere in its apparent domain, and calling it there is an error rather than a value. All three invite generalisation from examples and punish it.")
    (:meta "The transfer works because a pattern observed on a few cases is a hypothesis, not a law, and naming schemes are especially prone to this because they look systematic. The defence is to check the actual binding rather than derive the name. Grounds in book-of-code ch 05 as partial functions and in book-of-eng ch 03 as the cost of inconsistent naming.")
    (:eng "Every partial-convention substrate shares 'the pattern was extrapolated' — the operator's check is looking the name up rather than deriving it." :math "A partial function; membership in the domain must be established, not assumed from a few samples." :cs "Convention-driven API discovery; the shape of every guessed method name that does not exist."))
  :row-4-proof (
    (:claim "draw-rect is rect, and its counterpart fill-rect is rect-fill; the prefix pair maps onto the suffix pair exactly.")
    (:program "(set-mode 24 12)\n(define (probe f) (clear 0) (set-color 9) (f 2 2 8 6) (list (pget 2 2) (pget 5 4)))\n(display (list (equal? (probe draw-rect) (probe rect))\n               (equal? (probe fill-rect) (probe rect-fill))))"
     :eng-program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n;; The four names collapse to two behaviours: outline and fill.\n(draw-rect 1 1 6 4)\n(define outline (list (pget 1 1) (pget 3 2)))\n(clear 0)\n(fill-rect 1 1 6 4)\n(display (list outline (list (pget 1 1) (pget 3 2))))"
     :math-program "(define (classes names) (list (list 'outline 2) (list 'fill 2)))\n;; Four names, two equivalence classes, two members each.\n(display (classes (list 'rect 'rectangle 'draw-rect 'fill-rect)))"
     :cs-program "(set-mode 16 8)\n(define (interior-of f) (clear 0) (set-color 9) (f 2 2 8 5) (pget 5 3))\n(display (list (interior-of draw-rect) (interior-of rect)\n               (interior-of fill-rect) (interior-of rect-fill)))"
     :invariant "draw-rect ≡ rect ≡ rectangle  ∧  fill-rect ≡ rect-fill ≡ filled-rectangle  (six names, two equivalence classes)"
     :meta "The pattern is that a naming family partitions into equivalence classes by behaviour, and the useful question is how many classes there are rather than how many names. Falsified if any two names in a class disagreed on any input; that would mean the class was a coincidence rather than a shared object. book-of-math ch-advanced-02 grounds equivalence classes; book-of-code ch 05 grounds observational equivalence."))
    (:eng "The operator only has to learn two behaviours no matter how many names appear in the codebase, and can normalise freely." :math "The name set quotients by behaviour into exactly two classes, each with a canonical representative." :cs "Alias equivalence classes; the same reduction a linter performs when it normalises synonymous calls.")
  :row-5-emergence (
    (:base "draw-rect strokes one box outline.")
    (:composition "(set-mode 40 24)\n(clear 12)\n;; Fill then outline: the classic bordered-panel idiom.\n(set-color 5)\n(fill-rect 6 4 28 16)\n(set-color 7)\n(draw-rect 6 4 28 16)\n(display (list 'border (pget 6 4) 'inside (pget 20 12) 'outside (pget 2 2)))"
     :eng-composition "(define (panel! x y w h fill border)\n  ;; Fill first, outline second: the border must not be over-painted.\n  (set-color fill)\n  (fill-rect x y w h)\n  (set-color border)\n  (draw-rect x y w h)\n  (list (pget x y) (pget (+ x 1) (+ y 1))))\n(set-mode 40 24)\n(clear 12)\n(display (list (panel! 2 2 16 10 5 7) (panel! 22 2 16 10 3 9)))"
     :math-composition "(set-mode 40 24)\n(clear 0)\n;; Order matters: outline first then fill destroys the outline.\n(set-color 7)\n(draw-rect 4 4 20 12)\n(set-color 5)\n(fill-rect 4 4 20 12)\n(display (list 'outline-gone (pget 4 4) 'fill-everywhere (pget 12 10)))"
     :cs-composition "(set-mode 40 24)\n(clear 0)\n;; A button in two states, differing only in the fill colour.\n(define (button! x y pressed)\n  (set-color (if pressed 3 5))\n  (fill-rect x y 14 8)\n  (set-color 7)\n  (draw-rect x y 14 8)\n  (pget (+ x 4) (+ y 4)))\n(display (list (button! 2 2 #f) (button! 20 2 #t)))"
     :emergent "A bordered panel, a reusable panel helper, a demonstration that fill-then-outline is the only correct order, and a two-state button: the prefix pair makes the two-step idiom read as one idea.")
    (:meta "This is the fill-then-stroke family — an opaque fill followed by a boundary stroke, in that order, because the fill would otherwise erase the stroke. Familiar analogs are SVG's fill-then-stroke painting order, a printer's flood coat under a keyline and a painter blocking in before outlining. The composition works because the fill's painted set strictly contains the outline's, so the second operation must be the outline.")
    (:eng "The audit lens is 'which came first, the fill or the stroke?' — the smoke test is probing the border pixel after both." :math "The perimeter is a subset of the closed rectangle, so fill ∘ stroke erases the stroke while stroke ∘ fill does not." :cs "Non-commutative painting order; the shape of every fill-then-stroke pipeline."))
)

(verb
  :name "fill-rect" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(fill-rect x y w h) -> undefined"
  :summary "An alias of rect-fill: fill a solid rectangle at (x, y), w wide and h tall, in the current pen colour."
  :explanation "fill-rect is the same function object as rect-fill, bound under the prefix form that pairs with draw-rect. Reading the two names together — draw-rect for the outline, fill-rect for the solid — makes the outline-versus-fill distinction visible at the start of the word rather than at the end, which is why immediate-mode graphics libraries adopted the convention. Behaviourally it is rect-fill exactly: corner plus size, last painted column x+w-1, width and height clamped up to 1, opaque overwrite, colour from the pen, extra arguments dropped."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 12) (clear 0) (set-color 6) (fill-rect 20 1 5 5) (list (pget 22 3) (pget 20 1)))" :note "(6 6) — fill- means solid, so the interior is painted too.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 12) (clear 3) (set-color 9) (fill-rect 4 4 8 4) (list (pget 4 4) (pget 11 7) (pget 12 7)))" :note "(9 9 3) — the fill covers exactly w by h cells and stops; the background survives one past the edge.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 12) (clear 0) (set-color 9) (fill-rect 2 2 6 4) (rect-fill 14 2 6 4) (list (pget 4 3) (pget 16 3)))" :note "(9 9) — fill-rect and rect-fill are one function; the naming is documentation only.")
  )
  :caveats ("It is an ALIAS of rect-fill and inherits every defect: no colour argument, corner-plus-size, and sizes clamped up to 1 so an empty rectangle still paints a pixel. Marked needs-alfred alongside rect-fill." "The draw-/fill- pair covers rectangles only; there is no fill-circle, and the fill for a circle is disc." "It is opaque with no blending, so it destroys whatever was underneath inside its bounds." "Extra arguments, including a colour copied from another library's signature, are silently ignored." "Redefining rect-fill does not redefine fill-rect; the binding captured the function object at install time.")
  :drawbacks ("The prefix convention implies a complete family that does not exist beyond rectangles." "Three names for one fill behaviour makes codebase search a three-term search." "No gradient, no pattern, no rounded corners, no alpha." "A rectangle entirely off-canvas still costs the full w·h loop and paints nothing.")
  :usecases ("Code that uses the draw-/fill- prefix pair consistently so the distinction is visible at a glance." "Porting from an immediate-mode library that uses the same convention." "Panel and button backgrounds, drawn immediately before their draw-rect borders." "Any place rect-fill would be used; the choice is readability only.")
  :related ("rect-fill" "filled-rectangle" "draw-rect" "fb/rect" "clear")
  :learn (:concept "Matched-pair naming — two verbs whose names differ only in the part that names the difference." :prerequisites ("rect-fill" "draw-rect") :progression "Fill a rectangle, outline the same rectangle, then swap the order and see which one survives.")
  :row-2-audit (
    (:problem "A panel's border disappears intermittently, because in one code path the fill runs after the outline and covers it."
     :program "(set-mode 40 24)\n(clear 0)\n;; Wrong order: the fill covers the border it was supposed to sit inside.\n(set-color 7)\n(draw-rect 4 4 20 12)\n(set-color 5)\n(fill-rect 4 4 20 12)\n(list 'border-gone (pget 4 4))"
     :eng-program "(define (panel! x y w h fill border)\n  ;; One helper fixes the order once, for every caller.\n  (set-color fill)\n  (fill-rect x y w h)\n  (set-color border)\n  (draw-rect x y w h)\n  (list (pget x y) (pget (+ x 2) (+ y 2))))\n(set-mode 40 24)\n(clear 0)\n(display (list (panel! 4 4 20 12 5 7) (panel! 26 4 12 12 3 9)))"
     :math-program "(define (subset? small big) (if (eq? small 'perimeter) (eq? big 'rectangle) #f))\n;; The perimeter is contained in the rectangle, so the fill dominates it.\n(list (subset? 'perimeter 'rectangle) (subset? 'rectangle 'perimeter))"
     :cs-program "(set-mode 24 12)\n(clear 0)\n(set-color 5)\n(fill-rect 2 2 10 6)\n(set-color 7)\n(draw-rect 2 2 10 6)\n(display (list (pget 2 2) (pget 5 4) 'border-survives))"
     :explanation "eng: encode the correct order in a single helper so no call path can get it wrong. math: state the containment that makes the order matter. cs: run the correct order and probe both the border and the interior."
     :meta "draw-rect is the other half of the pair and has the same ordering constraint from the other side. rect-fill is the identical function under a different name and behaves identically. fb/rect fills and restores the pen, which removes one source of ordering error but not this one. fill-rect is the operation that destroys the border, so the audit belongs here.")
    (:eng "The audit lens is 'does a later step cover an earlier one?' — the smoke test is probing the border pixel at the end." :math "Painting order is a sequence of pointwise overwrites; containment of supports determines which order is safe." :cs "Non-commutative effects; the shape of every render pipeline whose stages must not be reordered."))
  :row-3-dimension (
    (:setup "Two operations where one's effect strictly contains the other's, forcing an order.")
    (:rungs (
       (:domain "fill-rect"     :code "(begin (set-mode 20 10) (clear 0) (set-color 5) (fill-rect 2 2 8 5) (set-color 7) (draw-rect 2 2 8 5) (list (pget 2 2) (pget 5 4)))")
       (:domain "paint-then-trim" :code "(define (order steps) (if (eq? (car steps) 'wall) 'correct 'redo))\n(list (order (list 'wall 'trim)) (order (list 'trim 'wall)))")
       (:domain "set-containment" :code "(define (dominates? a b) (>= a b))\n;; A later write over a containing support wipes the earlier one.\n(list (dominates? 30 12) (dominates? 12 30))")))
    (:explanation "Rung 1: the fill's painted set contains the outline's, so filling second erases the outline. Rung 2: painting a wall after installing the trim ruins the trim; the wall's area contains the trim's. Rung 3: whenever one operation's support contains another's, the containing one must come first. All three are the same constraint expressed in pixels, in carpentry and in set algebra.")
    (:meta "The transfer works because destructive operations compose by last-writer-wins, so the ordering constraint is purely a question of which supports contain which. Anywhere effects overwrite rather than accumulate, the same reasoning applies. Grounds in book-of-math ch-advanced-02 as containment ordering and in book-of-eng ch 03 as sequencing constraints in a build.")
    (:eng "Every overwriting-effects substrate shares 'a later broad step erased an earlier fine one' — the operator's check is the containment relation between supports." :math "If supp(A) ⊇ supp(B) then B∘A preserves B while A∘B destroys it." :cs "Write ordering under containment; the shape of every build step, every migration and every layered render."))
  :row-4-proof (
    (:claim "fill-rect is rect-fill, and its painted set strictly contains draw-rect's for any width and height of at least 3.")
    (:program "(set-mode 24 12)\n(define (probe f) (clear 0) (set-color 9) (f 2 2 8 6) (list (pget 2 2) (pget 5 4) (pget 9 4)))\n(display (list (probe fill-rect) (equal? (probe fill-rect) (probe rect-fill))))"
     :eng-program "(set-mode 24 12)\n(define (count f)\n  (clear 0) (set-color 9) (f 2 2 8 6)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 12) n)\n          ((>= x 24) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n;; Fill covers w·h; outline covers 2(w+h)-4. The first is larger for 8x6.\n(display (list (count fill-rect) (count draw-rect) (* 8 6) (- (* 2 (+ 8 6)) 4)))"
     :math-program "(define (fill-count w h) (* w h))\n(define (outline-count w h) (- (* 2 (+ w h)) 4))\n(display (map (lambda (n) (list n (fill-count n n) (outline-count n n))) (list 3 5 8)))"
     :cs-program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n(draw-rect 2 2 8 6)\n(set-color 11)\n(fill-rect 2 2 8 6)\n;; Every outline pixel is now the fill colour: containment demonstrated.\n(display (list (pget 2 2) (pget 9 2) (pget 2 7) (pget 5 4)))"
     :invariant "fill-rect ≡ rect-fill  ∧  ∀ w,h ≥ 3. supp(draw-rect) ⊊ supp(fill-rect), with |supp| = 2(w+h)−4 and w·h respectively"
     :meta "The pattern is proper containment established by a counting argument — the fill's area exceeds the perimeter's for any rectangle bigger than 2x2, which is exactly when an interior exists. Falsified if a fill ever failed to cover an outline of the same geometry; that would mean the two disagreed on their bounds and every bordered panel would show gaps. book-of-math ch-advanced-06 grounds area versus perimeter; book-of-code ch 05 grounds proper subset by cardinality."))
    (:eng "The operator can rely on a fill to completely cover the outline of the same rectangle, which is what makes redraw-in-place work." :math "w·h > 2(w+h)−4 for w,h ≥ 3; the perimeter is a proper subset of the closed rectangle." :cs "Support containment by counting; the argument that licenses fill-then-stroke as the only safe order.")
  :row-5-emergence (
    (:base "fill-rect covers one solid rectangle.")
    (:composition "(set-mode 40 24)\n(clear 12)\n;; A dialog: shadow, body, border, title bar — four fills and one outline.\n(set-color 0)\n(fill-rect 8 6 26 14)\n(set-color 7)\n(fill-rect 6 4 26 14)\n(set-color 9)\n(fill-rect 6 4 26 4)\n(set-color 0)\n(draw-rect 6 4 26 14)\n(display (list 'shadow (pget 33 19) 'body (pget 20 14) 'title (pget 20 6) 'border (pget 6 4)))"
     :eng-composition "(define (card! x y w h shadow body border)\n  ;; Back to front: shadow, body, border. Order is the whole design.\n  (set-color shadow) (fill-rect (+ x 2) (+ y 2) w h)\n  (set-color body)   (fill-rect x y w h)\n  (set-color border) (draw-rect x y w h)\n  (list (pget (+ x w 1) (+ y h 1)) (pget (+ x 2) (+ y 2)) (pget x y)))\n(set-mode 40 24)\n(clear 12)\n(display (card! 6 4 20 12 0 7 9))"
     :math-composition "(set-mode 40 24)\n(clear 0)\n;; A stacked bar chart: segments partition a column, areas add.\n(define segs (list (list 6 9) (list 5 11) (list 4 8)))\n(let loop ((ss segs) (y 20))\n  (if (null? ss) 'done\n      (let ((h (car (car ss))) (c (cadr (car ss))))\n        (set-color c)\n        (fill-rect 10 (- y h) 12 h)\n        (loop (cdr ss) (- y h)))))\n(display (list (pget 16 18) (pget 16 12) (pget 16 7)))"
     :cs-composition "(set-mode 40 24)\n(clear 0)\n;; Erase by refilling with the background: the fill is its own undo.\n(set-color 9)\n(fill-rect 8 8 16 8)\n(define drawn (pget 12 12))\n(set-color 0)\n(fill-rect 8 8 16 8)\n(display (list drawn (pget 12 12)))"
     :emergent "A dialog with a shadow, a reusable card, a stacked bar chart and an erase-by-refill: the opaque fill is both the way to draw a region and the way to undo one.")
    (:meta "This is the back-to-front compositing family — draw a scene as a sequence of opaque rectangles from furthest to nearest, so nearer elements simply overwrite. Familiar analogs are the painter's algorithm, CSS's paint order and a stack of physical cards. The composition works because the fill is opaque and exactly bounded, so each step's effect is fully predictable from its rectangle.")
    (:eng "The audit lens is 'is this scene drawn back to front?' — the smoke test is probing a pixel that should belong to the nearest layer." :math "A sequence of opaque writes realises the pointwise last-nonempty function over the layer stack." :cs "Painter's algorithm; the shape of every 2D compositor and every z-ordered UI."))
)

(verb
  :name "filled-rectangle" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(filled-rectangle x y w h) -> undefined"
  :summary "An alias of rect-fill: fill a solid rectangle at (x, y), w wide and h tall, in the current pen colour."
  :explanation "filled-rectangle is the fourth and last name in the rectangle family, and the same function object as rect-fill and fill-rect. Like rectangle it exists to match a spelling learners meet elsewhere — Racket's 2htdp/image calls its solid variant by describing it, and long descriptive names read well in teaching material where terseness is not the point. It is the longest name in this chapter, which is a feature in a lesson and a nuisance in a loop. Behaviourally: corner plus size, clamp up to 1, opaque, colour from the pen, extra arguments dropped, returns nothing."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 12) (clear 0) (set-color 6) (filled-rectangle 30 1 5 5) (pget 30 1))" :note "0 — nothing is painted: the canvas is only 24 wide, so the whole rectangle fell off the right edge in silence.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 40 12) (clear 0) (set-color 6) (filled-rectangle 30 1 5 5) (list (pget 30 1) (pget 32 3)))" :note "(6 6) — on a wide enough canvas the same call paints the solid block it promised.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 12) (clear 0) (set-color 9) (filled-rectangle 2 2 6 4) (fill-rect 12 2 6 4) (rect-fill 2 8 6 3) (list (pget 4 3) (pget 14 3) (pget 4 9)))" :note "(9 9 9) — all three fill names are one function object.")
  )
  :caveats ("It is an ALIAS of rect-fill and inherits every defect: no colour argument, corner-plus-size, sizes clamped up to 1, opaque overwrite. Marked needs-alfred alongside rect-fill." "Racket's 2htdp/image builds an image VALUE from a mode and a colour; this paints immediately and returns nothing. Shared vocabulary, different kind of thing." "A rectangle entirely off-canvas is silently discarded and costs the full w·h loop — the novice example above shows exactly that." "Extra arguments are dropped, including a colour copied from another library's call." "Redefining rect-fill does not redefine filled-rectangle; the binding captured the function object at install time.")
  :drawbacks ("It is the longest name in the chapter, which is real friction in an inner loop." "Four names for the rectangle fill makes any codebase-wide search a four-term search." "The descriptive name promises a self-explaining API that the rest of the family does not deliver." "No gradient, no rounded corners, no alpha.")
  :usecases ("Teaching material where the name should explain itself without a glossary." "Porting a shape from Racket's 2htdp/image with minimal edits." "Code read aloud in a lesson, where 'filled rectangle' is a whole phrase." "Any place rect-fill would be used; the choice is readability only.")
  :related ("rect-fill" "fill-rect" "rectangle" "draw-rect" "clear")
  :learn (:concept "Descriptive naming — how much the name should carry, and what it still cannot tell you." :prerequisites ("rect-fill") :progression "Draw with the long name, then the short one, probe both, and decide which you want in your own code.")
  :row-2-audit (
    (:problem "A rectangle drawn near the right edge of a narrow canvas simply does not appear, and because every drawing verb returns nothing there is no error and nothing to inspect."
     :program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n;; Entirely off-canvas: no error, no pixels, no return value.\n(filled-rectangle 30 1 5 5)\n(list 'nothing-painted (pget 23 1) (pget 23 5))"
     :eng-program "(define (filled-rectangle! x y w h c)\n  ;; Compare the canvas size against the rectangle and report the truth.\n  (let* ((size (mode-info)) (cw (car size)) (ch (cadr size)))\n    (set-color c)\n    (filled-rectangle x y w h)\n    (if (or (>= x cw) (>= y ch) (< (+ x w) 1) (< (+ y h) 1))\n        'off-canvas\n        'painted)))\n(set-mode 24 12)\n(clear 0)\n(display (list (filled-rectangle! 30 1 5 5 9) (filled-rectangle! 2 2 5 5 9)))"
     :math-program "(define (overlaps? x w cw) (and (< x cw) (> (+ x w) 0)))\n;; Two intervals overlap iff each starts before the other ends.\n(list (overlaps? 30 5 24) (overlaps? 2 5 24) (overlaps? -3 5 24))"
     :cs-program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n(filled-rectangle 30 1 5 5)\n(define (count-lit)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 12) n)\n          ((>= x 24) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (count-lit) 'expected-zero))"
     :explanation "eng: read the canvas size with mode-info and report whether the rectangle could possibly have landed. math: state the interval-overlap test that decides visibility. cs: count the lit pixels, which is the only direct evidence available."
     :meta "rect-fill and fill-rect have the identical silence, being the same function. fb/rect also clips silently. mode-info is the verb that supplies the canvas bounds the check needs, and pget is the verb that confirms the result. filled-rectangle is where a long descriptive name lulls a reader into trusting the call, so the audit belongs here.")
    (:eng "The audit lens is 'could this have landed at all?' — the smoke test is counting lit pixels rather than trusting the call." :math "Two intervals overlap iff each begins before the other ends; the rectangle is visible iff both axes overlap." :cs "Silent clipping; the shape of every draw call that succeeds by doing nothing."))
  :row-3-dimension (
    (:setup "A long descriptive name that explains the operation but not its preconditions.")
    (:rungs (
       (:domain "filled-rectangle" :code "(begin (set-mode 20 10) (clear 0) (set-color 9) (filled-rectangle 2 2 6 4) (pget 4 3))")
       (:domain "self-describing-label" :code "(define (describes? label content)\n  (if (eq? label content) 'accurate 'incomplete))\n(list (describes? 'sugar 'sugar) (describes? 'sugar 'sugar-and-salt))")
       (:domain "total-versus-partial" :code "(define (apply-safely f x dom)\n  (if (member x dom) (f x) 'outside-domain))\n(list (apply-safely (lambda (n) (* n n)) 3 (iota 5))\n      (apply-safely (lambda (n) (* n n)) 9 (iota 5)))")))
    (:explanation "Rung 1: filled-rectangle says exactly what it draws and nothing about where it may legally be drawn. Rung 2: a label naming the contents accurately still says nothing about whether the contents are safe to use here. Rung 3: knowing what a function computes is not knowing where it is defined. All three separate the description of an operation from the conditions under which it applies.")
    (:meta "The transfer works because names describe intent and preconditions describe applicability, and no naming scheme can carry both. That is why documentation carries a caveats section at all. Grounds in book-of-code ch 05 as preconditions versus specification and in book-of-eng ch 03 as the limits of self-documenting names.")
    (:eng "Every descriptive-name substrate shares 'the name was read as the whole contract' — the operator's check is the precondition, which the name never states." :math "A specification names the value; the domain names where the value exists." :cs "Preconditions; the part of a contract that naming conventions structurally cannot express."))
  :row-4-proof (
    (:claim "The rectangle family has four outline names and four fill names but only two behaviours, and the fill names all agree including on the off-canvas silence.")
    (:program "(set-mode 24 12)\n(define (probe f) (clear 0) (set-color 9) (f 2 2 6 4) (list (pget 2 2) (pget 4 3) (pget 8 3)))\n(display (list (equal? (probe filled-rectangle) (probe fill-rect))\n               (equal? (probe fill-rect) (probe rect-fill))))"
     :eng-program "(set-mode 24 12)\n(define (lit-after f)\n  (clear 0) (set-color 9) (f 30 1 5 5)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 12) n)\n          ((>= x 24) (loop 0 (+ y 1) n))\n          ((> (pget x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n;; All three fill names are equally silent off-canvas.\n(display (list (lit-after filled-rectangle) (lit-after fill-rect) (lit-after rect-fill)))"
     :math-program "(define (class name)\n  (cond ((memq name (list 'rect 'rectangle 'draw-rect)) 'outline)\n        ((memq name (list 'rect-fill 'fill-rect 'filled-rectangle)) 'fill)\n        (else 'other)))\n(display (map class (list 'rect 'rectangle 'draw-rect 'rect-fill 'fill-rect 'filled-rectangle)))"
     :cs-program "(set-mode 16 8)\n(define (interior f) (clear 0) (set-color 9) (f 2 2 8 5) (pget 5 3))\n(display (list (interior filled-rectangle) (interior fill-rect)\n               (interior rect-fill) (interior rect)))"
     :invariant "filled-rectangle ≡ fill-rect ≡ rect-fill  ∧  the six rectangle names partition into exactly two behaviour classes"
     :meta "The pattern is quotienting a name set by observational behaviour, where shared silence on an edge case is the strongest evidence that the members are one object rather than three agreeing implementations. Falsified if any fill name behaved differently on any input; that would mean the family had drifted and a codebase using all three would be inconsistent. book-of-math ch-advanced-02 grounds equivalence classes; book-of-code ch 05 grounds observational equivalence."))
    (:eng "The operator learns two behaviours and can normalise all six names to two, which is what a codebase-wide cleanup would do." :math "The name set quotients into two classes; each class has a canonical representative and three labels." :cs "Alias equivalence classes; the reduction a linter performs when normalising synonymous calls.")
  :row-5-emergence (
    (:base "filled-rectangle covers one solid rectangle.")
    (:composition "(set-mode 40 24)\n(clear 12)\n;; A skyline: descriptive names make the scene read like its description.\n(set-color 5)\n(filled-rectangle 2 10 6 14)\n(filled-rectangle 10 6 8 18)\n(filled-rectangle 20 14 5 10)\n(filled-rectangle 27 4 9 20)\n(display (list (pget 4 12) (pget 14 8) (pget 22 16) (pget 30 6) (pget 18 2)))"
     :eng-composition "(define (skyline! specs c)\n  ;; Each spec is (x width height); the ground is the canvas bottom.\n  (set-color c)\n  (for-each (lambda (s)\n              (let ((x (car s)) (w (cadr s)) (h (caddr s)))\n                (filled-rectangle x (- 24 h) w h)))\n            specs)\n  (length specs))\n(set-mode 40 24)\n(clear 12)\n(display (list (skyline! (list (list 2 6 14) (list 10 8 18) (list 20 5 10)) 5)\n               (pget 4 12) (pget 14 8)))"
     :math-composition "(set-mode 40 24)\n(clear 0)\n;; Areas add when the rectangles are disjoint: a Riemann sum in pixels.\n(define (area x w h)\n  (set-color 9)\n  (filled-rectangle x (- 24 h) w h)\n  (* w h))\n(display (list (area 2 6 14) (area 10 8 18) (+ (* 6 14) (* 8 18))))"
     :cs-composition "(set-mode 40 24)\n(clear 0)\n;; A heat strip: value maps to colour, position maps to index.\n(define vals (list 1 3 5 7 9 11 13 15))\n(for-each (lambda (i)\n            (set-color (list-ref vals i))\n            (filled-rectangle (* i 5) 8 5 8))\n          (iota 8))\n(display (list (pget 2 12) (pget 7 12) (pget 37 12)))"
     :emergent "A skyline, a data-driven skyline generator, a Riemann-sum area check and a heat strip: the descriptive name makes a scene built from fills read almost like a sentence describing it.")
    (:meta "This is the bar-chart family — encode one dimension of data as a rectangle's extent and another as its position or colour, so the picture is a direct rendering of a list of numbers. Familiar analogs are histograms, Gantt charts and audio level meters. The composition works because disjoint fills do not interact: their areas add and their order does not matter.")
    (:eng "The audit lens is 'do these rectangles overlap?' — the smoke test is that the areas sum to the lit pixel count." :math "Disjoint rectangles have additive measure; the total is the Riemann sum of the encoded values." :cs "Data-to-geometry encoding; the shape of every bar chart and every timeline view."))
)

(verb
  :name "fb/rect" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(fb/rect x y w h [color]) -> unspecified"
  :summary "Paint a solid rectangle, optionally in a named or numbered colour, without disturbing the current pen."
  :status "needs-alfred"
  :explanation "fb/rect is the odd one out in this chapter. Every other rectangle verb — rect-fill, fill-rect, filled-rectangle — paints with whatever colour set-color last established, and there is no way to override it for a single call. fb/rect takes an optional fifth argument that may be a palette index or a colour name as a symbol, uses it for this one rectangle, and then puts the pen back exactly as it found it. That makes it the only drawing verb in the library that is safe to call from inside a helper without the caller noticing a colour change afterwards. The geometry is identical to rect-fill: x and y are the top-left corner, w and h are counts of cells, and the rectangle is solid rather than an outline."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 12) (clear 0) (set-color 6) (fb/rect 2 2 6 4 3) (list (pget 4 3) (get-color)))" :note "(3 6) — the rectangle is colour 3, and the pen is still 6 afterwards.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 12) (clear 0) (set-color 6) (fb/rect 2 2 4 4 'red) (list (pget 3 3) (get-color)))" :note "(8 6) — a colour NAME works here, unlike pset where a symbol becomes 0.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 12) (clear 0) (set-color 6) (fb/rect 2 2 4 4) (fb/rect 10 2 4 4 300) (list (pget 3 3) (pget 11 3)))" :note "(6 12) — with no colour it uses the pen; 300 WRAPS to 12 rather than masking to 44 as pset would.")
  )
  :caveats ("IT IS THE ONLY RECTANGLE VERB THAT ACCEPTS A COLOUR. rect, rect-fill, fill-rect, filled-rectangle, rectangle and draw-rect all ignore a fifth argument in silence. Learning the convention from fb/rect and applying it to its neighbours produces a shape in the wrong colour with no error. Marked needs-alfred." "Its colour handling WRAPS where pset MASKS: (fb/rect 0 0 1 1 300) paints 12, but (pset 0 0 300) paints 44. Two verbs, two arithmetics, same argument." "An unrecognised colour name is a silent no-op — (fb/rect 0 0 1 1 'chartreuse) paints with the current pen instead of raising or defaulting." "Width and height clamp UP to 1, so a computed-empty rectangle still paints one pixel: (fb/rect 3 3 0 0) lights (3,3)." "It returns nothing, so a read-back with pget or fb/pixel is the only evidence it ran." "It lives in the fb/ namespace while its behavioural twin rect-fill does not, so neither name suggests the other.")
  :drawbacks ("The pen-save-and-restore is invisible from Scheme, so a reader cannot tell from the call site that this verb is special." "No outline counterpart: there is no fb/rect-outline, so a bordered panel still needs the pen-mutating verbs." "The optional argument makes arity a poor guide — a four-argument and a five-argument call are both correct and behave differently." "It cannot express an empty rectangle, so a layout that computes a zero-size box draws a stray pixel.")
  :usecases ("Drawing a coloured block from inside a helper without leaking a pen change to the caller." "Filling a background panel in a fixed colour while a drawing loop keeps its own pen." "Writing a test that paints several colours without interleaving set-color calls." "Clearing a region to a specific colour, which clear cannot do because clear takes the whole canvas.")
  :related ("rect-fill" "fill-rect" "set-color" "get-color" "fb/pixel")
  :learn (:concept "Save and restore — a routine that mutates shared state should return it to the state it found, so callers can compose without coordination." :prerequisites ("set-mode" "set-color" "rect-fill") :progression "Fill a rectangle with the pen, then with an explicit colour, then check the pen afterwards and see that it did not move.")
  :row-2-audit (
    (:problem "A helper paints a highlight in red using set-color, and every shape the caller draws afterwards comes out red because the helper never put the pen back."
     :program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n;; The helper leaks its colour; the square after it is the wrong colour.\n(define (highlight! x y) (set-color 8) (rect-fill x y 4 4))\n(highlight! 2 2)\n(rect-fill 12 2 4 4)\n(list 'highlight (pget 3 3) 'meant-to-be-9 (pget 13 3))"
     :eng-program "(set-mode 24 12)\n(clear 0)\n(set-color 9)\n;; fb/rect does the save and restore for you, so nothing leaks.\n(define (highlight! x y) (fb/rect x y 4 4 8))\n(highlight! 2 2)\n(rect-fill 12 2 4 4)\n(display (list (pget 3 3) (pget 13 3) (get-color)))"
     :math-program "(define (conjugate f g finv x) (finv (g (f x))))\n;; Save, act, restore is conjugation: the outside world sees only g's effect.\n(display (list (conjugate (lambda (n) (+ n 5)) (lambda (n) (* n 2)) (lambda (n) (- n 5)) 3)))"
     :cs-program "(set-mode 16 8)\n(clear 0)\n(set-color 7)\n(define before (get-color))\n(fb/rect 2 2 4 3 11)\n(display (list before (get-color) (pget 3 3)))"
     :explanation "eng: use the verb that restores the pen instead of hand-rolling the save. math: conjugation names the pattern — pre-image, act, post-image. cs: record the pen before and after and assert they are equal."
     :meta "set-color is global mutable state shared by every drawing verb, which is why a leak is invisible until a later shape comes out wrong. fb/rect is the only fill that closes the leak by construction; for the others the caller must save get-color and restore it. The audit question is 'does this helper touch the pen?' and the smoke test is comparing get-color across the call.")
    (:eng "The audit lens is 'what global state does this touch?' — the smoke test is reading the pen before and after every helper." :math "A conjugated action leaves the ambient state fixed while still applying its effect." :cs "Save-restore around a mutation; the discipline behind every well-behaved graphics context."))
  :row-3-dimension (
    (:setup "An operation that borrows shared state, uses it, and puts it back so no caller can observe the borrow.")
    (:rungs (
       (:domain "fb/rect"       :code "(begin (set-mode 16 8) (clear 0) (set-color 7) (fb/rect 2 2 4 3 11) (list (pget 3 3) (get-color)))")
       (:domain "dynamic-wind"  :code "(define state 'outer)\n(define (with-state s thunk)\n  (let ((prev state))\n    (set! state s)\n    (let ((r (thunk)))\n      (set! state prev)\n      r)))\n(list (with-state 'inner (lambda () state)) state)")
       (:domain "cursor-save"   :code "(define (with-position pos thunk)\n  (let ((saved pos))\n    (list (thunk) saved)))\n(with-position 42 (lambda () 'moved))")))
    (:explanation "Rung 1: fb/rect swaps the pen, fills, and swaps it back, so get-color is unchanged. Rung 2: a state-swapping wrapper does the same for an arbitrary variable — set, run, restore. Rung 3: saving a cursor position before a move is the same shape with a different noun. In all three the borrowed state is restored on the normal path, and in all three the caller is entitled to assume it was never touched.")
    (:meta "The transfer works because shared mutable state can only be composed if every user promises to leave it as found; that promise is what turns a global into something local-looking. Grounds in book-of-code ch 09 as scoped mutation, and in book-of-math ch-advanced-01 as conjugation.")
    (:eng "Every borrow-and-restore substrate shares 'the caller must not be able to tell' — the operator's check is asserting the state is equal across the call." :math "Conjugation g ↦ f⁻¹∘g∘f preserves the ambient frame while applying the inner action." :cs "Scoped mutation; the shape of a graphics context save/restore stack."))
  :row-4-proof (
    (:claim "fb/rect paints the same pixels as rect-fill with the same geometry, and leaves get-color exactly as it was, whether or not a colour argument was supplied.")
    (:program "(set-mode 24 12)\n(clear 0)\n(set-color 6)\n(fb/rect 2 2 6 4 9)\n(define a (list (pget 2 2) (pget 7 5) (pget 8 5) (get-color)))\n(clear 0)\n(set-color 9)\n(rect-fill 12 2 6 4)\n(display (list a (list (pget 12 2) (pget 17 5) (pget 18 5))))"
     :eng-program "(set-mode 16 8)\n(clear 0)\n;; The pen must survive both the four-argument and the five-argument form.\n(set-color 5)\n(fb/rect 1 1 3 3)\n(define after-4 (get-color))\n(fb/rect 6 1 3 3 11)\n(display (list after-4 (get-color) (pget 2 2) (pget 7 2)))"
     :math-program "(define (fixed-point? f x) (equal? (f x) x))\n;; The pen is a fixed point of the whole operation, even though it moves inside.\n(display (list (fixed-point? (lambda (c) c) 6) (fixed-point? (lambda (c) (- (+ c 3) 3)) 6)))"
     :cs-program "(set-mode 16 8)\n(define (probe f) (clear 0) (set-color 9) (f 2 2 6 4) (list (pget 2 2) (pget 4 3) (pget 7 5)))\n(display (equal? (probe fb/rect) (probe rect-fill)))"
     :invariant "∀ x y w h. fb/rect(x,y,w,h,c) paints exactly rectFill(x,y,max(1,w),max(1,h)) in colour c  ∧  get-color after = get-color before"
     :meta "The pattern is an effect with a restored context — the visible change is confined to the framebuffer, and the control state is returned untouched. Falsified if the pen ever differed across the call, which would mean fb/rect could not be used inside a helper without documentation. book-of-code ch 09 grounds scoped mutation; book-of-math ch-advanced-01 grounds the fixed point."))
    (:eng "The operator can drop fb/rect into any helper and know the caller's colour survives." :math "The pen is a fixed point of the composite map even though the intermediate steps move it." :cs "Idempotent context restore; the guarantee a save/restore pair is supposed to give.")
  :row-5-emergence (
    (:base "fb/rect fills one rectangle in a stated colour and hands the pen back.")
    (:composition "(set-mode 40 24)\n(clear 12)\n;; A whole palette strip with no set-color anywhere in the loop.\n(for-each (lambda (i) (fb/rect (* i 5) 4 5 8 i)) (iota 8))\n(display (list (pget 2 8) (pget 7 8) (pget 37 8) (get-color)))"
     :eng-composition "(define (swatch! x y c)\n  ;; Every swatch states its own colour; the caller's pen is never involved.\n  (fb/rect x y 6 6 c)\n  (pget (+ x 1) (+ y 1)))\n(set-mode 40 24)\n(clear 0)\n(set-color 3)\n(display (list (swatch! 2 2 8) (swatch! 10 2 11) (swatch! 18 2 'blue) (get-color)))"
     :math-composition "(set-mode 40 24)\n(clear 0)\n;; A bar chart where height carries the value and colour carries the rank.\n(define vals (list 4 9 6 14 11))\n(let loop ((vs vals) (i 0))\n  (if (null? vs) 'done\n      (begin\n        (fb/rect (* i 7) (- 24 (car vs)) 6 (car vs) (+ 8 i))\n        (loop (cdr vs) (+ i 1)))))\n(display (list (pget 2 22) (pget 9 18) (pget 30 14)))"
     :cs-composition "(set-mode 40 24)\n(clear 0)\n;; A checkerboard: two colours, no pen state, purely positional.\n(for-each\n  (lambda (i)\n    (for-each\n      (lambda (j)\n        (fb/rect (* i 5) (* j 4) 5 4 (if (even? (+ i j)) 5 7)))\n      (iota 6)))\n  (iota 8))\n(display (list (pget 2 2) (pget 7 2) (pget 2 6) (get-color)))"
     :emergent "A palette strip, a self-describing swatch helper, a ranked bar chart and a checkerboard — all written without a single set-color, because the colour travels with the call instead of living in a global.")
    (:meta "This is the pass-the-state-explicitly family — moving a parameter out of a global and into the argument list makes every call independently readable and reorderable. Familiar analogs are a pure render function that takes its theme as an argument, and an HTTP request that carries its own credentials rather than relying on a session. The composition works because independence removes ordering constraints: the swatches can be drawn in any order and the picture is the same.")
    (:eng "The audit lens is 'could I reorder these calls?' — the smoke test is shuffling the loop and comparing the canvas." :math "Each call is an independent map on the buffer, so the composite is order-insensitive on disjoint regions." :cs "Explicit parameter passing; the shape that makes rendering code testable one call at a time."))
)

(verb
  :name "fb/pixel" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(fb/pixel x y) -> integer"
  :summary "Read the palette index at pixel (x, y); the namespaced twin of pget, with identical behaviour."
  :explanation "fb/pixel returns the byte stored in the framebuffer at (x, y). It is the same operation as pget in every observable respect: coordinates truncate toward zero, anything outside the canvas returns 0, and the value is a raw byte rather than a validated palette index. The two names exist because the fb/ namespace groups the low-level framebuffer verbs together for introspection and testing, while pget is the short name a beginner reaches for while drawing. Choosing between them is a matter of which neighbourhood the surrounding code lives in, not of behaviour."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 16 8) (clear 5) (fb/pixel 3 3))" :note "5 — every pixel reads back the colour the canvas was cleared to.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 16 8) (clear 0) (pset 4 4 9) (list (fb/pixel 4 4) (pget 4 4)))" :note "(9 9) — fb/pixel and pget cannot be told apart by any probe.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 16 8) (clear 0) (pset 1 1 7) (list (fb/pixel 1.9 1.9) (fb/pixel 99 99)))" :note "(7 0) — coordinates truncate toward zero, and an off-canvas read returns 0 instead of raising.")
  )
  :caveats ("OUT-OF-BOUNDS IS INDISTINGUISHABLE FROM BLACK, exactly as with pget: (fb/pixel 999 999) returns 0 and so does a legitimately black pixel. A loop with wrong bounds reports plausible data. Marked needs-alfred." "It is a duplicate name for pget with no behavioural difference, so a codebase can drift into using both and a reader must check the implementation to be sure they agree." "It returns the raw byte, so after (clear 300) it reports 44, which is outside the 16-entry palette." "It reads pixels only. Text pushed by draw-text lives on a separate overlay and is invisible to it." "Fractional coordinates truncate rather than round, shifting a sampled read by one pixel below the .5 boundary." "With no framebuffer allocated it returns 0 rather than signalling that there is nothing to read.")
  :drawbacks ("Two names for one read splits search results and doubles the surface a learner must recognise." "One call per pixel means a whole-canvas scan costs w·h interpreter calls." "No region or row form, so bulk reads must be written as loops." "No way to distinguish 'off canvas' from 'black', so bounds bugs stay silent.")
  :usecases ("Asserting inside a low-level framebuffer test that a primitive painted where it should." "Sampling the canvas from code that already uses the fb/ namespace, keeping the vocabulary consistent." "Reading back a colour to compare two renders pixel by pixel." "Probing a coordinate while debugging an off-by-one in a drawing loop.")
  :related ("pget" "pset" "fb/rect" "fb/dump" "fb-snapshot")
  :learn (:concept "Aliasing — two names for one operation are convenient at the call site and a hazard for the reader, who cannot assume they will stay identical." :prerequisites ("set-mode" "pset" "pget") :progression "Read a cleared canvas, compare fb/pixel against pget on the same coordinate, then scan a whole canvas with one of them.")
  :row-2-audit (
    (:problem "A test suite uses pget in some files and fb/pixel in others; a reviewer assumes they differ in bounds handling and adds a redundant guard around one of them."
     :program "(set-mode 8 4)\n(clear 3)\n;; The guard below is dead code: both verbs already return 0 off-canvas.\n(define (guarded x y) (if (and (< x 8) (< y 4)) (fb/pixel x y) 0))\n(list (guarded 9 0) (fb/pixel 9 0) (pget 9 0))"
     :eng-program "(set-mode 8 4)\n(clear 3)\n;; Prove they agree everywhere before writing a guard for only one of them.\n(define (agree? x y) (= (fb/pixel x y) (pget x y)))\n(display (list (agree? 0 0) (agree? 7 3) (agree? 99 99) (agree? -1 -1)))"
     :math-program "(define (extensionally-equal? f g xs) (equal? (map f xs) (map g xs)))\n;; Two names are one function only if they agree on the whole domain.\n(display (extensionally-equal? (lambda (n) (* 2 n)) (lambda (n) (+ n n)) (iota 6)))"
     :cs-program "(set-mode 8 4)\n(clear 3)\n(pset 2 2 9)\n(define coords (list (list 0 0) (list 2 2) (list 7 3) (list 8 4) (list 99 99)))\n(display (map (lambda (p) (list (fb/pixel (car p) (cadr p)) (pget (car p) (cadr p)))) coords))"
     :explanation "eng: test the two names against each other before assuming a difference. math: extensional equality is agreement on the whole domain, not on one sample. cs: tabulate both over the interesting coordinates including the out-of-bounds ones."
     :meta "Aliases are cheap to create and expensive to reason about, because nothing in the language records that they must stay equal. The audit question is 'is this really the same function, and who guarantees it stays that way?' The honest answer here is that they are the same today by construction, and the reference is the only place that says so.")
    (:eng "The audit lens is 'are these two names one function?' — the smoke test is tabulating both over the same coordinates including the edges." :math "Extensional equality requires agreement on every point of the domain, edges included." :cs "Alias verification; the check that stops a redundant guard or a divergent fix."))
  :row-3-dimension (
    (:setup "A read that answers with a legal-looking value outside its meaningful range, hiding the boundary from the caller.")
    (:rungs (
       (:domain "fb/pixel"      :code "(begin (set-mode 8 4) (clear 5) (list (fb/pixel 0 0) (fb/pixel 99 99)))")
       (:domain "string-search" :code "(define (index-of ch s)\n  (let loop ((i 0))\n    (cond ((>= i (string-length s)) -1)\n          ((char=? (string-ref s i) ch) i)\n          (else (loop (+ i 1))))))\n(list (index-of #\\b \"abc\") (index-of #\\z \"abc\"))")
       (:domain "sensor-read"   :code "(define (reading v) (if (and (>= v 0) (<= v 100)) v 0))\n(list (reading 42) (reading 250))")))
    (:explanation "Rung 1: fb/pixel answers 0 off the canvas, so a bad coordinate looks like a black pixel. Rung 2: a search returning -1 at least picks a value outside the legal index range, so the miss is distinguishable. Rung 3: a sensor clamped to 0 on a bad reading is indistinguishable from a genuine zero. The ladder shows the choice: pick a sentinel outside the value range and the boundary stays visible; pick one inside it and the boundary vanishes.")
    (:meta "The transfer works because every total read must invent a value for the undefined case, and the whole question is whether that value could have arisen legitimately. Grounds in book-of-code ch 05 as sentinel selection, and in book-of-math ch-advanced-01 as extension beyond a domain.")
    (:eng "Every sentinel-returning substrate shares 'could this answer be real data?' — the operator's check is whether the sentinel lies outside the legal range." :math "A total extension of a partial function is injective on the sentinel only if the sentinel is outside the codomain." :cs "In-band versus out-of-band error signalling; the reason -1 beats 0 as a not-found."))
  :row-4-proof (
    (:claim "fb/pixel and pget denote the same function: they agree on every in-canvas coordinate, on every out-of-canvas coordinate, and on fractional coordinates.")
    (:program "(set-mode 12 6)\n(clear 0)\n(pset 3 3 9)\n(pset 11 5 7)\n(define pts (list (list 0 0) (list 3 3) (list 11 5) (list 12 6) (list -1 2) (list 3.9 3.2)))\n(display (map (lambda (p) (equal? (fb/pixel (car p) (cadr p)) (pget (car p) (cadr p)))) pts))"
     :eng-program "(set-mode 8 4)\n(clear 0)\n;; Round-trip every palette index through both readers.\n(define (both c) (pset 2 2 c) (list (fb/pixel 2 2) (pget 2 2)))\n(display (map (lambda (c) (apply = (both c))) (iota 16)))"
     :math-program "(define (agree-on? f g xs) (equal? (map f xs) (map g xs)))\n(display (agree-on? (lambda (n) (max 0 n)) (lambda (n) (if (< n 0) 0 n)) (list -3 0 4)))"
     :cs-program "(set-mode 8 4)\n(clear 2)\n(set-color 9)\n(rect-fill 1 1 3 2)\n(define (scan f) (map (lambda (y) (map (lambda (x) (f x y)) (iota 8))) (iota 4)))\n(display (equal? (scan fb/pixel) (scan pget)))"
     :invariant "∀ x y ∈ ℝ². fb/pixel(x,y) = pget(x,y), including the truncation rule and the out-of-bounds value"
     :meta "The pattern is an alias proof — two names are one function only when they agree on the entire domain, edges and degenerate inputs included. Falsified if any coordinate produced different answers, which would mean one of the two names was silently the wrong tool. book-of-code ch 05 grounds alias verification; book-of-math ch-advanced-01 grounds extensional equality."))
    (:eng "The operator can substitute one name for the other anywhere without re-testing." :math "Extensional equality over the full domain licenses substitution." :cs "Alias equivalence; the property that makes a rename a no-op.")
  :row-5-emergence (
    (:base "fb/pixel reads one pixel.")
    (:composition "(set-mode 20 10)\n(clear 2)\n(set-color 9)\n(fb/rect 4 3 6 4 9)\n;; A census turns the canvas into countable data.\n(define (count v)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 10) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((= (fb/pixel x y) v) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list 'shape (count 9) 'expected (* 6 4)))"
     :eng-composition "(define (canvas->rows w h)\n  ;; A printable, diffable representation of the whole buffer.\n  (map (lambda (y) (map (lambda (x) (fb/pixel x y)) (iota w))) (iota h)))\n(set-mode 8 4)\n(clear 0)\n(fb/rect 1 1 3 2 7)\n(display (canvas->rows 8 4))"
     :math-composition "(set-mode 20 10)\n(clear 0)\n(set-color 11)\n(disc 10 5 4)\n;; Counting lit pixels estimates area; compare against πr² ≈ 3·16.\n(define (lit)\n  (let loop ((x 0) (y 0) (n 0))\n    (cond ((>= y 10) n)\n          ((>= x 20) (loop 0 (+ y 1) n))\n          ((> (fb/pixel x y) 0) (loop (+ x 1) y (+ n 1)))\n          (else (loop (+ x 1) y n)))))\n(display (list (lit) (* 3 16)))"
     :cs-composition "(set-mode 8 4)\n;; Two identical renders compared pixel by pixel: a golden-image test.\n(define (render!) (clear 1) (fb/rect 2 1 3 2 8))\n(define (dump) (map (lambda (y) (map (lambda (x) (fb/pixel x y)) (iota 8))) (iota 4)))\n(render!)\n(define a (dump))\n(render!)\n(display (list (equal? a (dump)) (car a)))"
     :emergent "A colour census, a canvas dump, a pixel-counted area estimate and a golden-image regression test: one total read plus a traversal turns an opaque buffer into ordinary data.")
    (:meta "This is the observe-to-verify family — a buffer you cannot read is a buffer you cannot test, so the read primitive is what promotes drawing from a side effect to a value. Familiar analogs are a screenshot diff, a checksum over a byte array and a sensor sweep that closes a control loop. The composition works because the read is pure and total: scanning changes nothing, so scans can be repeated and compared.")
    (:eng "The audit lens is 'can I see what the program drew?' — the smoke test is dumping the canvas twice and comparing." :math "A traversal of a total read realises the pixel field as a function that can be measured or compared." :cs "Read-back verification; the shape of every golden-image test."))
)

(verb
  :name "fb/dump" :std "Motoi"
  :library "draw"
  :kind "io"
  :signature "(fb/dump) | (fb/dump x y w h) -> symbol"
  :summary "Print the framebuffer to the terminal as coloured half-block characters and return the symbol ok."
  :status "needs-alfred"
  :explanation "fb/dump is the eye of the drawing library. Every other verb here either mutates pixels invisibly or hands back a single number; fb/dump renders the whole buffer as ANSI 256-colour text so a person running the CLI can actually SEE the picture. Each terminal character carries TWO pixel rows — the upper half is the foreground colour and the lower half is the background of the ▀ glyph — so a 128-tall canvas prints in 64 lines. With no arguments it dumps the whole canvas. With exactly four arguments it dumps the region starting at (x, y) and measuring w by h. It always returns the symbol ok, whatever it printed."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 4 4) (clear 0) (fb/dump 0 0 2 2))" :note "ok — two characters are printed and the symbol ok comes back.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 4 4) (clear 0) (fb/rect 0 0 2 2 9) (fb/dump 0 0 2 2))" :note "ok — the printed block is orange; the return value never changes.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 4 4) (clear 0) (list (fb/dump 0 0 2) (fb/dump 0 0 2 2)))" :note "(ok ok) — the THREE-argument call silently dumps the WHOLE canvas instead of a region.")
  )
  :caveats ("ANY ARGUMENT COUNT OTHER THAN EXACTLY FOUR DUMPS THE WHOLE CANVAS. (fb/dump 0 0 2) and (fb/dump 0 0 2 2 2) both print everything, with no error and no warning, so a mis-typed region silently floods the terminal. Marked needs-alfred." "THE REGION IS NOT CLIPPED. (fb/dump 2 2 8 8) on a 4x4 canvas reads past the end of the buffer and prints the missing cells as black, so an over-large region looks like a canvas with a black border rather than a mistake." "It writes straight to the process's standard output, bypassing the Scheme port system entirely, so it cannot be captured, redirected or suppressed from inside the language." "It needs a 256-colour terminal. Piped into a file or a plain terminal the output is escape-sequence noise rather than a picture." "Two pixel rows share one character, so an odd-height canvas pairs its last row with black rather than with nothing." "It returns ok whether it drew a picture, printed \"(no framebuffer)\" or printed \"(empty framebuffer)\", so the return value carries no information at all.")
  :drawbacks ("The return value is a constant, so a program cannot tell success from the no-framebuffer case." "It cannot produce a string, so the picture cannot be embedded in a test assertion or a log record." "Half-block packing means the vertical resolution of the printed image is half the horizontal, and a square canvas prints as a wide rectangle." "It is the only verb in the chapter that assumes a terminal, which makes any code path containing it untestable in a headless comparison.")
  :usecases ("Looking at what a drawing program actually produced while working at the CLI." "Teaching: showing a beginner the picture immediately after the code that drew it." "Zooming into a small region to debug an off-by-one in a shape's edge." "Sanity-checking a cart's opening frame without launching the full runtime.")
  :related ("fb/pixel" "pget" "fb/rect" "mode-info" "fb-snapshot")
  :learn (:concept "Rendering for humans — a debug view is a separate concern from the data, and its job is to be readable rather than complete." :prerequisites ("set-mode" "clear" "fb/rect") :progression "Dump a cleared canvas, draw a rectangle and dump again, then dump only the region around the rectangle's corner.")
  :row-2-audit (
    (:problem "A debugging session dumps a 240x136 canvas inside a loop; the terminal fills with tens of thousands of escape sequences and the actual test output scrolls away."
     :program "(set-mode 24 12)\n(clear 0)\n;; A full dump inside a loop is a wall of output with no signal in it.\n(define (step! i) (fb/rect (* i 4) 2 3 3 (+ 8 i)) 'stepped)\n(step! 0)\n(step! 1)\n(list 'drew (pget 1 3) (pget 5 3))"
     :eng-program "(set-mode 24 12)\n(clear 0)\n;; Dump only the region that changed, and only once at the end.\n(define (step! i) (fb/rect (* i 4) 2 3 3 (+ 8 i)) 'stepped)\n(step! 0)\n(step! 1)\n(fb/dump 0 2 8 4)\n(display (list (pget 1 3) (pget 5 3)))"
     :math-program "(define (cells w h) (* w h))\n;; The cost of a dump is the area, so shrinking both sides is quadratic relief.\n(display (list (cells 240 136) (cells 8 4)))"
     :cs-program "(set-mode 24 12)\n(clear 0)\n(fb/rect 2 2 4 4 11)\n;; A read-back assertion costs three calls; a dump costs the whole canvas.\n(display (list (pget 3 3) (pget 20 10)))"
     :explanation "eng: dump a region, once, at the end. math: the cost is the area, so bounding both dimensions is what matters. cs: prefer targeted read-backs over a picture when the check is mechanical."
     :meta "fb/dump is for eyes, pget and fb/pixel are for assertions, and confusing the two is what fills a terminal with noise. The audit question is 'who is reading this output, a person or a test?' A person wants a small region; a test wants numbers. The region form exists precisely so the answer can be 'a person, briefly'.")
    (:eng "The audit lens is 'is this output for a human or a machine?' — the smoke test is whether anything downstream parses it." :math "Output volume grows with the area, so a debug view must bound both dimensions." :cs "Debug rendering versus assertion; two different consumers, two different verbs."))
  :row-3-dimension (
    (:setup "A view that renders internal state for a human, at reduced fidelity, without changing the state itself.")
    (:rungs (
       (:domain "fb/dump"     :code "(begin (set-mode 4 4) (clear 0) (fb/rect 0 0 2 2 9) (fb/dump 0 0 2 2))")
       (:domain "list->string" :code "(define (show xs) (apply string-append (map (lambda (n) (number->string n)) xs)))\n(show (list 1 2 3))")
       (:domain "histogram"   :code "(define (bar n) (make-string n #\\*))\n(map bar (list 1 3 2))")))
    (:explanation "Rung 1: fb/dump packs two pixel rows into one character so a tall canvas fits a screen, trading vertical resolution for readability. Rung 2: rendering a list as a string loses the structure but gains a form a person can read at a glance. Rung 3: a bar of asterisks throws away the exact number and keeps the comparison. All three are lossy projections chosen so a human can absorb the whole thing at once.")
    (:meta "The transfer works because human attention is the scarce resource, so a debug view optimises for absorption rather than for fidelity. Grounds in book-of-code ch 07 as representation choice, and in book-of-math ch-advanced-01 as projection onto a lower-dimensional view.")
    (:eng "Every debug-view substrate shares 'what did I throw away to make this readable?' — the operator's check is whether the discarded axis mattered." :math "A projection is chosen for the structure it preserves, not for what it discards." :cs "Lossy rendering for inspection; the shape of every pretty-printer and progress bar."))
  :row-4-proof (
    (:claim "fb/dump is a pure observer: it prints and returns ok, and the framebuffer it printed is byte-for-byte unchanged afterwards, including the pen.")
    (:program "(set-mode 8 4)\n(clear 0)\n(fb/rect 1 1 3 2 9)\n(define (scan) (map (lambda (y) (map (lambda (x) (pget x y)) (iota 8))) (iota 4)))\n(define before (scan))\n(fb/dump 0 0 2 2)\n(display (list (equal? before (scan)) (get-color)))"
     :eng-program "(set-mode 8 4)\n(clear 0)\n(set-color 7)\n(fb/rect 1 1 3 2 9)\n;; Dump twice: an observer must be repeatable with no accumulating effect.\n(fb/dump 0 0 2 2)\n(fb/dump 0 0 2 2)\n(display (list (pget 1 1) (pget 0 0) (get-color)))"
     :math-program "(define (idempotent? f x) (equal? (f (f x)) (f x)))\n;; Observation is idempotent: looking twice is the same as looking once.\n(display (idempotent? (lambda (n) n) 42))"
     :cs-program "(set-mode 8 4)\n(clear 3)\n(define a (list (pget 0 0) (pget 7 3)))\n(fb/dump)\n(display (list a (list (pget 0 0) (pget 7 3))))"
     :invariant "∀ buffers B. dump(B) = ok  ∧  state after dump = B  ∧  pen after dump = pen before"
     :meta "The pattern is an observer with no write-back — the only effect leaves the system entirely, as characters on a terminal. Falsified if a dump had ever changed a pixel or the pen, which would make it useless as a debugging tool because looking would alter what you were looking at. book-of-code ch 07 grounds the observer; book-of-math ch-advanced-01 grounds idempotence."))
    (:eng "The operator can dump as often as needed without worrying that the picture is being altered by the act of looking." :math "The observation map is idempotent and leaves the state fixed." :cs "Read-only inspection; the property that makes a debug print safe to leave in.")
  :row-5-emergence (
    (:base "fb/dump prints the canvas once.")
    (:composition "(set-mode 8 8)\n(clear 0)\n;; Draw, look, draw, look: the dump turns a script into an animation flipbook.\n(fb/rect 0 0 3 3 9)\n(fb/dump 0 0 4 4)\n(fb/rect 4 4 3 3 11)\n(fb/dump 4 4 4 4)\n(display (list (pget 1 1) (pget 5 5)))"
     :eng-composition "(define (show! x y w h label)\n  ;; A labelled region dump: the label is what makes a flipbook readable.\n  (display label)\n  (newline)\n  (fb/dump x y w h)\n  label)\n(set-mode 8 8)\n(clear 0)\n(fb/rect 1 1 3 3 9)\n(display (show! 0 0 4 4 'after-first))"
     :math-composition "(set-mode 8 8)\n(clear 0)\n;; Dump the same region at two colours: a visual diff of one variable.\n(fb/rect 2 2 4 4 5)\n(fb/dump 2 2 4 4)\n(fb/rect 2 2 4 4 11)\n(fb/dump 2 2 4 4)\n(display (list 'changed (pget 3 3)))"
     :cs-composition "(set-mode 8 8)\n(clear 0)\n;; A zoom: dump the whole canvas, then the corner where the bug is.\n(fb/rect 0 0 2 2 8)\n(fb/dump)\n(fb/dump 0 0 2 2)\n(display (list (pget 0 0) (pget 2 2)))"
     :emergent "A flipbook of successive states, a labelled region view, a two-colour visual diff and a zoom from whole canvas to corner: one printing verb plus ordinary sequencing becomes an interactive debugger for pictures.")
    (:meta "This is the print-debugging family — the humblest observability tool, and the one that survives because it needs no infrastructure. Familiar analogs are a display statement in a loop, a stack trace and a frame-by-frame video scrubber. The composition works because the observer is pure: dumps can be inserted anywhere, in any number, without changing what the program does.")
    (:eng "The audit lens is 'can I insert a look here without changing the run?' — the smoke test is comparing the canvas across an inserted dump." :math "A sequence of idempotent observations interleaved with state changes records a trajectory." :cs "Print debugging; the shape of every trace statement ever added to a loop."))
)

(verb
  :name "render" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(render) -> framebuffer-record"
  :summary "Hand back the current canvas as an opaque record the REPL displays as a picture; the pen and frame counter are NOT included."
  :status "needs-alfred"
  :explanation "render is how a drawing program says 'here is the picture'. It reads the framebuffer and returns a record carrying the width, the height, the palette and a copy of every pixel. The REPL knows how to display that record as an image rather than as text, so evaluating (render) at the end of a program is what makes the canvas appear. From Scheme the record is opaque: it is not a pair, not a vector, not a string, and there is no accessor for its fields — the only things you can do with it are display it and hand it back to fb-restore. The copy is taken at the moment of the call, so later drawing does not change a record you already hold."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 8 4) (clear 3) (if (render) 'picture 'nothing))" :note "picture — render always hands back a record, which is truthy.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 8 4) (clear 0) (set-color 9) (pset 2 2 7) (fb-restore (render)) (list (pget 2 2) (get-color)))" :note "(7 0) — the pixels survive the round trip but the PEN IS SILENTLY RESET from 9 to 0.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 8 4) (clear 3) (list (equal? (render) (render)) (eq? (render) (render))))" :note "(#f #f) — two snapshots of the same unchanged canvas are not equal to each other; the record is opaque to every comparison.")
  )
  :caveats ("IT DROPS THE PEN AND THE FRAME COUNTER. fb-snapshot returns them, render does not, so restoring a render record silently sets the current colour to 0 and the frame number to 0. The engine's own comment calls the three verbs the same; they are not. Marked needs-alfred." "TWO SNAPSHOTS OF THE SAME CANVAS ARE NOT equal?. (equal? (render) (render)) is #f, so a golden-image test cannot compare records — it must scan pixels with pget instead." "There are no accessors. The width, height, palette and pixels are all in there and none of them can be read from Scheme; mode-info and pget are the only ways to get at that information." "It is a snapshot, not a live view: drawing after the call does not change the record you are holding." "It copies every pixel, so calling it in a per-frame loop at 320x240 allocates 76,800 list elements per call." "The name suggests it draws something to a screen; it does not draw, it reads. The display happens later, and only in a REPL that knows the record type.")
  :drawbacks ("An opaque record with no accessors cannot be inspected, diffed or serialised from inside the language." "Three names — render, framebuffer, fb-snapshot — for two behaviours, with the only difference being the two fields the odd one out omits." "Nothing in the return value says which mode or palette it came from in a form Scheme can read, so a restore is a leap of faith." "Being unequal to itself makes the record useless as a value in a set, a table key or an assertion.")
  :usecases ("Ending a drawing program so the REPL shows the picture." "Capturing the canvas before a risky drawing step so it can be put back." "Handing a finished frame to a display routine that knows the record type." "Teaching: making the invisible framebuffer into something a beginner can see.")
  :related ("framebuffer" "fb-snapshot" "fb-restore" "fb/dump" "mode-info")
  :learn (:concept "Snapshot versus live view — a copy taken now is stable but stale, while a live view is current but changes underneath you." :prerequisites ("set-mode" "clear" "pset") :progression "Draw something and evaluate render, then take a snapshot, draw more, and see that the snapshot did not change.")
  :row-2-audit (
    (:problem "A program saves the canvas with render before an experiment, restores it when the experiment fails, and every shape drawn afterwards comes out black because the restore reset the pen to 0."
     :program "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n(pset 1 1 9)\n;; Save, restore, then draw: the new rectangle is invisible.\n(fb-restore (render))\n(rect-fill 4 2 4 3)\n(list 'pen (get-color) 'rect (pget 5 3))"
     :eng-program "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n;; fb-snapshot carries the pen, so the restore is faithful.\n(fb-restore (fb-snapshot))\n(rect-fill 4 2 4 3)\n(display (list (get-color) (pget 5 3)))"
     :math-program "(define (lossy-round-trip fields kept)\n  ;; A round trip is faithful only if the encoding keeps every field.\n  (equal? fields kept))\n(display (list (lossy-round-trip (list 'w 'h 'pixels 'color) (list 'w 'h 'pixels))\n               (lossy-round-trip (list 'w 'h 'pixels 'color) (list 'w 'h 'pixels 'color))))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(set-color 11)\n(define via-render (begin (fb-restore (render)) (get-color)))\n(set-color 11)\n(define via-snapshot (begin (fb-restore (fb-snapshot)) (get-color)))\n(display (list via-render via-snapshot))"
     :explanation "eng: use fb-snapshot when the pen matters, which is almost always. math: a round trip is faithful only when the encoding is total on the state. cs: measure the pen after each of the two round trips and watch them disagree."
     :meta "The three snapshot verbs look interchangeable and are not; the difference is two fields that no Scheme code can see, so the failure appears several lines later as a shape in the wrong colour. The audit question is 'what did the encoding leave out?' and the answer must come from the reference, because nothing in the value itself reveals it.")
    (:eng "The audit lens is 'is this round trip lossless?' — the smoke test is comparing every piece of state across the save and the restore." :math "A section of a projection is a right inverse only on the fields the projection kept." :cs "Lossy serialisation; the defect class behind every configuration that comes back with defaults."))
  :row-3-dimension (
    (:setup "A capture that returns a stable copy of live state, so later changes to the state do not change the copy.")
    (:rungs (
       (:domain "render"      :code "(begin (set-mode 8 4) (clear 3) (define snap (render)) (clear 7) (list (pget 0 0) (if snap 'snapshot-unchanged 'lost)))")
       (:domain "list-copy"   :code "(define original (list 1 2 3))\n(define copy (list-copy original))\n(set-car! original 99)\n(list original copy)")
       (:domain "string-copy" :code "(define s (string-copy \"abc\"))\n(list s (string-length s))")))
    (:explanation "Rung 1: render copies the pixels, so clearing the canvas afterwards leaves the snapshot intact. Rung 2: list-copy takes a fresh spine, so mutating the original does not reach the copy. Rung 3: string-copy makes an independent string for the same reason. All three answer the same question — 'do I want the thing, or a photograph of the thing?' — and all three pay the same price, which is the memory for a full duplicate.")
    (:meta "The transfer works because aliasing and copying are the two ways to hold on to mutable state, and choosing wrongly produces either stale data or spooky action at a distance. Grounds in book-of-code ch 09 as value versus reference semantics, and in book-of-math ch-advanced-01 as the distinction between a term and its evaluation.")
    (:eng "Every capture substrate shares 'is this a copy or a window?' — the operator's check is mutating the source and re-reading the capture." :math "A copy is a fixed element; a view is a function of a changing state." :cs "Defensive copy; the shape of every snapshot, every immutable value object."))
  :row-4-proof (
    (:claim "render captures the pixels faithfully — a canvas restored from a render record reads back byte-for-byte identical — while the pen it did not capture comes back as 0.")
    (:program "(set-mode 8 4)\n(clear 0)\n(set-color 9)\n(rect-fill 1 1 3 2)\n(define (scan) (map (lambda (y) (map (lambda (x) (pget x y)) (iota 8))) (iota 4)))\n(define before (scan))\n(define snap (render))\n(clear 5)\n(fb-restore snap)\n(display (list (equal? before (scan)) (get-color)))"
     :eng-program "(set-mode 8 4)\n(clear 0)\n;; Every palette index must survive the round trip unchanged.\n(define (round-trip c)\n  (clear c)\n  (fb-restore (render))\n  (pget 3 2))\n(display (map round-trip (iota 16)))"
     :math-program "(define (right-inverse? enc dec xs) (equal? xs (map (lambda (x) (dec (enc x))) xs)))\n(display (right-inverse? (lambda (n) (list n)) (lambda (p) (car p)) (iota 8)))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(set-color 7)\n(pset 2 2 11)\n(define snap (render))\n(set-mode 4 4)\n(fb-restore snap)\n;; The dimensions travel with the record, so the mode comes back too.\n(display (list (mode-info) (pget 2 2) (get-color)))"
     :invariant "∀ canvases C. fb-restore(render(C)) has pixels(C) ∧ dimensions(C) ∧ palette(C), but colour = 0 regardless of C"
     :meta "The pattern is a partial section — the decode inverts the encode on the fields the encode kept, and silently substitutes a default for the rest. Falsified if a pixel or a dimension changed, which would make render useless for save-and-restore; confirmed as partial by the pen coming back 0 for every input. book-of-code ch 09 grounds defensive copying; book-of-math ch-advanced-01 grounds the right inverse."))
    (:eng "The operator can trust render for pixels and dimensions and must not trust it for the pen." :math "The decode is a right inverse of the encode on the projected fields only." :cs "Partial round trip; faithful on what it stored, defaulted on what it dropped.")
  :row-5-emergence (
    (:base "render captures the canvas once.")
    (:composition "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n;; Save, try something, put it back: undo built from two verbs.\n(rect-fill 1 1 4 3)\n(define saved (render))\n(set-color 11)\n(rect-fill 1 1 8 6)\n(define experimented (pget 6 4))\n(fb-restore saved)\n(display (list experimented (pget 6 4) (pget 2 2)))"
     :eng-composition "(define (with-undo! thunk)\n  ;; Capture, run, and let the caller decide whether to keep the result.\n  (let ((saved (render)))\n    (thunk)\n    saved))\n(set-mode 16 8)\n(clear 0)\n(set-color 9)\n(rect-fill 1 1 4 3)\n(define back (with-undo! (lambda () (clear 5))))\n(fb-restore back)\n(display (list (pget 2 2) (pget 12 6)))"
     :math-composition "(set-mode 16 8)\n(clear 0)\n;; A stack of states: each frame is a point, the list is a trajectory.\n(set-color 9)\n(define states\n  (map (lambda (i) (rect-fill 1 1 (+ i 2) 3) (render)) (iota 4)))\n(display (list (length states) (pget 4 2)))"
     :cs-composition "(set-mode 8 4)\n(clear 0)\n;; Checkpoint before a risky step; restore if the check fails.\n(set-color 9)\n(rect-fill 1 1 3 2)\n(define checkpoint (render))\n(clear 15)\n(define ok? (= (pget 2 2) 9))\n(if ok? 'kept (fb-restore checkpoint))\n(display (list ok? (pget 2 2)))"
     :emergent "An undo, a with-undo helper, a list of past states and a checkpoint-and-roll-back: one capture verb plus one restore verb is the whole of transactional drawing.")
    (:meta "This is the checkpoint-and-rollback family — capturing state so a speculative change can be abandoned. Familiar analogs are a database transaction, an editor's undo stack and a version-control commit. The composition works because the capture is a value: it can be held in a variable, put in a list, passed to a function and used more than once.")
    (:eng "The audit lens is 'can I get back to where I was?' — the smoke test is capturing, changing, restoring and comparing." :math "A sequence of captures is a discrete trajectory through the state space." :cs "Checkpointing; the shape of undo, transactions and snapshot isolation."))
)

(verb
  :name "framebuffer" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(framebuffer) -> framebuffer-record"
  :summary "The discoverable name for render: returns the canvas as an opaque record, dropping the pen and frame counter exactly as render does."
  :status "needs-alfred"
  :explanation "framebuffer exists so that a beginner who has just been told the picture lives in 'the framebuffer' can type that word and get the picture. It is the same operation as render, built from the same code: width, height, a copy of the palette and a copy of every pixel, wrapped in a record the REPL displays as an image. Nothing in it is reachable from Scheme. Like render — and unlike fb-snapshot — it leaves out the current pen colour and the frame counter, so a round trip through it loses them."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 8 4) (clear 3) (if (framebuffer) 'picture 'nothing))" :note "picture — the friendly name returns the same kind of record render does.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 8 4) (clear 0) (set-color 9) (pset 2 2 7) (fb-restore (framebuffer)) (list (pget 2 2) (get-color)))" :note "(7 0) — same loss as render: pixels kept, pen reset to 0.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 8 4) (clear 0) (set-color 9) (pset 2 2 7) (fb-restore (fb-snapshot)) (list (pget 2 2) (get-color)))" :note "(7 9) — fb-snapshot is the ONLY one of the three that brings the pen back.")
  )
  :caveats ("IT DROPS THE PEN AND THE FRAME COUNTER, exactly like render. The friendliest name of the three is one of the two lossy ones, so the verb a beginner is most likely to reach for is the one most likely to bite. Marked needs-alfred." "The name is a noun, so it reads like a variable rather than a call; (framebuffer) with no parentheses is an unbound-looking value and with parentheses is a fresh copy every time." "Two records from two calls are not equal? even on an unchanged canvas, so it cannot be used in an assertion." "It has no accessors, so the dimensions inside it are unreachable — use mode-info instead." "It copies every pixel on every call, which is a real cost inside a loop." "It does not display anything by itself; the picture appears only because a REPL recognises the record type.")
  :drawbacks ("A third name for a second copy of the same behaviour widens the surface without adding capability." "Discoverability was the goal, but the discovered verb is the lossy one, so discovery leads to the wrong default." "Opaque with no accessors means the friendly name gives a beginner something they cannot take apart or learn from." "It cannot be compared, hashed or serialised, so it is a dead end as a value.")
  :usecases ("Typing the word you just learned and getting the picture." "Ending a beginner's program so the canvas is displayed." "Capturing the canvas in teaching material where the pen colour does not matter." "Reading a cart's current frame for display in a host that understands the record.")
  :related ("render" "fb-snapshot" "fb-restore" "mode-info" "fb/dump")
  :learn (:concept "Discoverable naming — a name chosen for how a learner will guess it, which is a real service and a real hazard when the guessable name is not the safe one." :prerequisites ("set-mode" "clear" "render") :progression "Call render, call framebuffer, compare what comes back, then compare both against fb-snapshot across a restore.")
  :row-2-audit (
    (:problem "A tutorial teaches framebuffer as the way to save a picture; every learner who follows it and restores loses their pen colour and cannot work out why the next shape is black."
     :program "(set-mode 16 8)\n(clear 0)\n(set-color 11)\n;; The friendly name loses the pen; the next shape is drawn in colour 0.\n(fb-restore (framebuffer))\n(rect-fill 2 2 4 3)\n(list 'pen (get-color) 'shape (pget 3 3))"
     :eng-program "(set-mode 16 8)\n(clear 0)\n(set-color 11)\n;; Save the pen alongside, or use fb-snapshot which already does.\n(define pen (get-color))\n(fb-restore (framebuffer))\n(set-color pen)\n(rect-fill 2 2 4 3)\n(display (list (get-color) (pget 3 3)))"
     :math-program "(define (kept enc all) (length enc))\n;; Four fields go in, three come out: the arity of the encoding is the bug.\n(display (list (kept (list 'w 'h 'pixels) (list 'w 'h 'pixels 'color))\n               (kept (list 'w 'h 'pixels 'color) (list 'w 'h 'pixels 'color))))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(set-color 11)\n(fb-restore (framebuffer))\n(define a (get-color))\n(set-color 11)\n(fb-restore (fb-snapshot))\n(display (list a (get-color)))"
     :explanation "eng: either save the pen by hand or pick the verb that already does. math: count the fields — the encoding is narrower than the state. cs: run both restores back to back and read the pen after each."
     :meta "This is a naming failure rather than a coding one: the three verbs differ only in two fields, and the name that best advertises itself is not the faithful one. The audit question for any convenience alias is 'is the convenient version also the correct one?' Here it is not, and only the reference records that.")
    (:eng "The audit lens is 'does the easy name do the safe thing?' — the smoke test is comparing the alias against the full-fidelity verb." :math "Two encodings with different field sets are different functions however similar their names." :cs "Convenience alias with reduced semantics; the reason a friendly wrapper needs its own tests."))
  :row-3-dimension (
    (:setup "A second, friendlier name for an operation, offered so a learner can guess it without reading the manual.")
    (:rungs (
       (:domain "framebuffer"  :code "(begin (set-mode 8 4) (clear 3) (list (if (framebuffer) 'yes 'no) (if (render) 'yes 'no)))")
       (:domain "list-tail"    :code "(define xs (list 1 2 3 4 5))\n(list (list-tail xs 2) (cddr xs))")
       (:domain "1+"           :code "(define (1+ n) (+ n 1))\n(list (1+ 5) (+ 5 1))")))
    (:explanation "Rung 1: framebuffer is a guessable name for render, and behaves identically. Rung 2: list-tail spells out what cddr does with punctuation, and the two agree exactly. Rung 3: a 1+ helper names the increment a beginner already has words for. All three trade a wider vocabulary for a shorter path from intent to code, and all three are safe only as long as the alias stays exactly equal to what it aliases.")
    (:meta "The transfer works because naming is the interface, and a name that matches how someone thinks removes a lookup step. The cost is that every alias is a promise someone must keep. Grounds in book-of-code ch 03 as naming for the reader, and in book-of-math ch-advanced-01 as notation choice.")
    (:eng "Every alias substrate shares 'who guarantees these stay the same?' — the operator's check is a test that asserts the two agree." :math "Notation is chosen for the reader; the object denoted is unchanged." :cs "Convenience alias; the shape of every friendly wrapper in a standard library."))
  :row-4-proof (
    (:claim "framebuffer and render are the same operation: the records they produce restore to identical canvases, and both lose the pen in the same way.")
    (:program "(set-mode 8 4)\n(clear 0)\n(set-color 9)\n(rect-fill 1 1 3 2)\n(define (scan) (map (lambda (y) (map (lambda (x) (pget x y)) (iota 8))) (iota 4)))\n(define via-fb (begin (fb-restore (framebuffer)) (scan)))\n(define via-render (begin (fb-restore (render)) (scan)))\n(display (list (equal? via-fb via-render) (get-color)))"
     :eng-program "(set-mode 8 4)\n(clear 0)\n;; Both aliases must lose the pen identically, or one of them is the odd one.\n(define (pen-after f) (set-color 11) (fb-restore (f)) (get-color))\n(display (list (pen-after framebuffer) (pen-after render) (pen-after fb-snapshot)))"
     :math-program "(define (same-map? f g xs) (equal? (map f xs) (map g xs)))\n(display (same-map? (lambda (n) (* n 2)) (lambda (n) (+ n n)) (iota 5)))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(set-color 7)\n(pset 3 2 11)\n(define (round-trip f) (fb-restore (f)) (list (pget 3 2) (mode-info)))\n(display (list (round-trip framebuffer) (round-trip render)))"
     :invariant "∀ canvases C. restore(framebuffer(C)) = restore(render(C)) as a canvas, and both set colour to 0"
     :meta "The pattern is an alias proof carried out through a round trip, because the records themselves cannot be compared. Falsified if either the pixels or the pen differed between the two, which would mean the friendly name was quietly a different verb. book-of-code ch 03 grounds naming; book-of-math ch-advanced-01 grounds equality of functions."))
    (:eng "The operator can substitute framebuffer for render anywhere without changing behaviour, including the loss." :math "Two names denote one function when they agree on every input, defects included." :cs "Alias equivalence proved through observable effects, since the values are opaque.")
  :row-5-emergence (
    (:base "framebuffer hands back the canvas.")
    (:composition "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n;; A beginner's whole program: draw, then show.\n(rect-fill 2 2 6 4)\n(circle 12 4 3)\n(if (framebuffer) 'shown 'nothing)"
     :eng-composition "(define (scene!)\n  ;; The last expression is the picture, so the function returns a drawing.\n  (clear 12)\n  (set-color 15)\n  (disc 8 4 3)\n  (set-color 7)\n  (rect-fill 1 1 3 2)\n  (framebuffer))\n(set-mode 16 8)\n(display (if (scene!) 'scene-returned-a-picture 'empty))"
     :math-composition "(set-mode 16 8)\n(clear 0)\n;; Each iteration returns a picture, so the loop returns a sequence of frames.\n(set-color 11)\n(define frames (map (lambda (i) (disc (+ 3 (* i 3)) 4 2) (framebuffer)) (iota 4)))\n(display (list (length frames) (pget 3 4) (pget 12 4)))"
     :cs-composition "(set-mode 8 4)\n(clear 0)\n;; A function whose value IS the drawing composes like any other value.\n(define (badge c) (clear 0) (set-color c) (rect-fill 1 1 4 2) (framebuffer))\n(define shots (list (badge 8) (badge 11) (badge 15)))\n(display (list (length shots) (pget 2 2)))"
     :emergent "A first program that ends in a picture, a scene function that returns one, a list of frames from a loop and a badge factory: because the canvas is a value, drawing composes with every ordinary Scheme construct.")
    (:meta "This is the effects-as-values family — turning a side effect into something a function can return is what lets drawing take part in map, let and list. Familiar analogs are a render function returning a virtual DOM tree and a plotting call returning a figure object. The composition works because the record is a first-class value even though it is opaque.")
    (:eng "The audit lens is 'what does this function return?' — the smoke test is whether the drawing can be stored in a variable." :math "Lifting an effect into a value lets it be an element of a sequence." :cs "Effects as values; the shape of every retained-mode rendering API."))
)

(verb
  :name "fb-snapshot" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(fb-snapshot) -> framebuffer-record"
  :summary "Capture the canvas — pixels, palette, dimensions, the pen AND the frame counter — as an opaque record; the text overlay is NOT included."
  :status "needs-alfred"
  :explanation "fb-snapshot is the faithful capture of the raster. Where render and framebuffer return the picture, fb-snapshot returns the whole machine: the same width, height, palette and pixels, plus the current pen colour and the current frame number. Those two extra fields are what make it a real save point — a canvas restored from an fb-snapshot resumes drawing in the colour it was using, while a canvas restored from a render record starts again at colour 0. The record is opaque in the same way, with no accessors and no useful equality, so its only consumer is fb-restore."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 8 4) (clear 3) (if (fb-snapshot) 'saved 'nothing))" :note "saved — the capture always returns a record.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 8 4) (clear 0) (set-color 9) (pset 2 2 7) (clear 1) (fb-restore (fb-snapshot)) (list (pget 2 2) (get-color)))" :note "(1 9) — the snapshot was taken AFTER the clear, so the pixel is 1; the pen comes back as 9.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 12 6) (clear 0) (set-color 9) (pset 2 2 7) (define s (fb-snapshot)) (set-mode 4 4) (fb-restore s) (list (mode-info) (pget 2 2) (get-color)))" :note "((12 6) 7 9) — the MODE travels in the snapshot too, so restoring changes the canvas size back.")
  )
  :caveats ("It is the only faithful one of the three capture verbs, and it has the least memorable name. A program that reaches for render or framebuffer instead loses the pen with no warning." "TWO SNAPSHOTS OF THE SAME CANVAS ARE NOT equal?, so a snapshot cannot be used in an assertion, a table key or a set. Compare canvases by scanning pixels with pget." "It has no accessors: the pen it faithfully stored cannot be read out of the record, only restored into the live canvas." "Restoring one CHANGES THE MODE, because the dimensions are part of the capture. A snapshot taken at 320x240 will resize a 128x128 canvas on restore." "It copies every pixel, so at 320x240 each call allocates a 76,800-element list." "IT DOES NOT CAPTURE THE TEXT OVERLAY, AND RESTORING WIPES IT. Strings pushed by draw-text live on the framebuffer object but are not in the record, so (fb-restore (fb-snapshot)) leaves (text/overlay) empty — a canvas restored to 'the same state' has silently lost every string on it. Marked needs-alfred.")
  :drawbacks ("The record is write-only from Scheme's point of view: everything in it is reachable only by restoring it into the live canvas." "No partial capture: there is no way to snapshot a region, so a small undo costs a full-canvas copy." "The mode travelling with the snapshot is convenient for undo and surprising for anyone using it as a clipboard." "Opaque and unequal to itself, so it cannot participate in any of Scheme's data structures meaningfully.")
  :usecases ("Making a real save point before a speculative drawing step." "Implementing undo where the pen colour must survive." "Saving a cart's canvas state so it can be resumed later." "Switching modes temporarily and coming back to the exact canvas and pen you left.")
  :related ("fb-restore" "render" "framebuffer" "get-color" "mode-info")
  :learn (:concept "Complete state capture — a save point is only a save point if it stores everything the resumed computation depends on." :prerequisites ("set-mode" "set-color" "render") :progression "Snapshot, change the pen, restore, and read the pen; then repeat with render and compare.")
  :row-2-audit (
    (:problem "An undo feature is built on render because it was the first capture verb in the manual; users report that undoing changes their selected colour, which nobody can explain from the code."
     :program "(set-mode 16 8)\n(clear 0)\n(set-color 11)\n;; The undo works on pixels and silently rewrites the pen.\n(define undo (render))\n(rect-fill 2 2 4 3)\n(fb-restore undo)\n(list 'pen-after-undo (get-color) 'expected 11)"
     :eng-program "(set-mode 16 8)\n(clear 0)\n(set-color 11)\n;; fb-snapshot captures the pen, so undo is invisible to the user.\n(define undo (fb-snapshot))\n(rect-fill 2 2 4 3)\n(fb-restore undo)\n(display (list (get-color) (pget 3 3)))"
     :math-program "(define (complete? captured needed)\n  (null? (filter (lambda (f) (not (memq f captured))) needed)))\n(display (list (complete? (list 'pixels 'w 'h) (list 'pixels 'w 'h 'color))\n               (complete? (list 'pixels 'w 'h 'color) (list 'pixels 'w 'h 'color))))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(define (undo-with f)\n  (set-color 11)\n  (let ((u (f)))\n    (set-color 3)\n    (fb-restore u)\n    (get-color)))\n(display (list (undo-with render) (undo-with fb-snapshot)))"
     :explanation "eng: pick the capture that stores the whole state. math: completeness is a subset check between captured fields and needed fields. cs: run the same undo through both verbs and read the pen."
     :meta "An undo is only correct if the capture is complete, and completeness is invisible from the call site — both verbs return an opaque record of the same shape. The audit question is 'what does the resumed computation read, and is all of it in the capture?' Here the pen is read by every drawing verb, so it must be captured.")
    (:eng "The audit lens is 'what does the resumed code depend on?' — the smoke test is changing each piece of state and checking it comes back." :math "A capture is complete when it covers the support of the resumed computation." :cs "Checkpoint completeness; the reason a process snapshot must include registers, not just memory."))
  :row-3-dimension (
    (:setup "A save point that must store every piece of state the resumed computation will read, not just the visible part.")
    (:rungs (
       (:domain "fb-snapshot"    :code "(begin (set-mode 8 4) (clear 0) (set-color 11) (define s (fb-snapshot)) (set-color 3) (fb-restore s) (get-color))")
       (:domain "assoc-restore"  :code "(define (save-state) (list (cons 'x 1) (cons 'y 2)))\n(define (restore-field k st) (cdr (assq k st)))\n(list (restore-field 'x (save-state)) (restore-field 'y (save-state)))")
       (:domain "seed-capture"   :code "(define (with-seed-value seed thunk) (list seed (thunk)))\n(with-seed-value 42 (lambda () 'ran))")))
    (:explanation "Rung 1: fb-snapshot stores the pen as well as the pixels, so the restored canvas resumes identically. Rung 2: an association list save must name every field, and any field left out comes back as whatever the default is. Rung 3: capturing a random seed alongside a result is what makes a run reproducible — without the seed the output is unrepeatable. Each rung fails the same way: the state you forgot to store is the state that surprises you on resume.")
    (:meta "The transfer works because resumption is only faithful over the state the computation actually reads, and that set is usually larger than the obvious one. Grounds in book-of-code ch 11 as checkpointing, and in book-of-math ch-advanced-01 as the state vector of a dynamical system.")
    (:eng "Every checkpoint substrate shares 'did I capture the whole state vector?' — the operator's check is perturbing each field and restoring." :math "A state vector must span every coordinate the evolution depends on." :cs "Full checkpoint; the shape of process migration, VM suspend and deterministic replay."))
  :row-4-proof (
    (:claim "fb-snapshot round-trips the whole observable canvas state — pixels, dimensions and pen — where render round-trips only the first two.")
    (:program "(set-mode 12 6)\n(clear 0)\n(set-color 9)\n(pset 2 2 7)\n(define s (fb-snapshot))\n(set-mode 4 4)\n(clear 5)\n(set-color 1)\n(fb-restore s)\n(display (list (mode-info) (pget 2 2) (get-color)))"
     :eng-program "(set-mode 8 4)\n(clear 0)\n;; The pen must survive for every palette index, not just for one.\n(define (pen-round-trip c)\n  (set-color c)\n  (fb-restore (fb-snapshot))\n  (get-color))\n(display (map pen-round-trip (iota 16)))"
     :math-program "(define (identity-on? f xs) (equal? xs (map f xs)))\n(display (identity-on? (lambda (n) n) (iota 16)))"
     :cs-program "(set-mode 8 4)\n(clear 0)\n(define (pen-after f) (set-color 13) (fb-restore (f)) (get-color))\n;; Three capture verbs, one faithful.\n(display (list (pen-after fb-snapshot) (pen-after render) (pen-after framebuffer)))"
     :invariant "∀ canvases C. fb-restore(fb-snapshot(C)) = C in pixels, dimensions AND pen; fb-restore(render(C)) agrees on the first two only"
     :meta "The pattern is a total section versus a partial one — the same decode applied to two encodings, distinguished only by the field one of them dropped. Falsified if any palette index failed to survive the pen round trip, which would mean even the faithful verb was not faithful. book-of-code ch 11 grounds checkpointing; book-of-math ch-advanced-01 grounds the section of a projection."))
    (:eng "The operator can use fb-snapshot as a genuine save point and must treat render as a picture only." :math "The snapshot encoding admits a two-sided inverse on the observable state; the render encoding does not." :cs "Complete versus partial checkpoint, told apart by one field.")
  :row-5-emergence (
    (:base "fb-snapshot captures the whole canvas state once.")
    (:composition "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n(rect-fill 1 1 4 3)\n;; A save point that survives a mode change and a repaint.\n(define save (fb-snapshot))\n(set-mode 4 4)\n(clear 5)\n(fb-restore save)\n(display (list (mode-info) (pget 2 2) (get-color)))"
     :eng-composition "(define (with-scratch-canvas thunk)\n  ;; Borrow the canvas for scratch work and hand it back untouched.\n  (let ((saved (fb-snapshot)))\n    (let ((result (thunk)))\n      (fb-restore saved)\n      result)))\n(set-mode 16 8)\n(clear 0)\n(set-color 9)\n(rect-fill 1 1 4 3)\n(display (list (with-scratch-canvas (lambda () (clear 15) (pget 8 4)))\n               (pget 2 2)\n               (get-color)))"
     :math-composition "(set-mode 8 4)\n(clear 0)\n;; An undo STACK: a list of complete states, popped in reverse.\n(set-color 9)\n(define history '())\n(define (step! c)\n  (set! history (cons (fb-snapshot) history))\n  (clear c)\n  (pget 0 0))\n(display (list (step! 3) (step! 5) (length history)))"
     :cs-composition "(set-mode 8 4)\n(clear 0)\n(set-color 11)\n;; Two independent branches from one save point.\n(define base (fb-snapshot))\n(clear 3)\n(define branch-a (pget 0 0))\n(fb-restore base)\n(clear 7)\n(define branch-b (pget 0 0))\n(fb-restore base)\n(display (list branch-a branch-b (pget 0 0) (get-color)))"
     :emergent "A save point across a mode change, a scratch-canvas borrow, an undo stack and two branches explored from one base: complete capture plus restore gives you the whole vocabulary of speculative execution.")
    (:meta "This is the transactional-state family — a complete capture lets a program try something, look at the result and decide whether it happened. Familiar analogs are a database savepoint, a git branch from a commit and a solver that backtracks to a choice point. The composition works because the capture is complete: a branch explored from a save point cannot leak state into the next one.")
    (:eng "The audit lens is 'can I explore and come back?' — the smoke test is two branches from one save point ending in the same state." :math "A complete capture makes the state space a tree rather than a line." :cs "Savepoint and backtrack; the shape of transactions, branching and search."))
)

(verb
  :name "fb-restore" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(fb-restore snapshot) -> unspecified"
  :summary "Replace the live canvas with a previously captured one, including its dimensions; raises if the argument is not a capture record."
  :status "needs-alfred"
  :explanation "fb-restore takes a record produced by fb-snapshot, render or framebuffer and installs it as the current canvas, discarding whatever was there. It is a wholesale replacement, not a merge: every pixel comes from the record. The dimensions come from the record too, so restoring a snapshot taken in one mode while in another silently resizes the canvas — which is what makes it a true save point rather than just a pixel copy. What comes back for the PEN depends entirely on which verb made the record: fb-snapshot stored it, render and framebuffer did not, and for those two the pen is set to 0."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 8 4) (clear 3) (fb-restore (fb-snapshot)) (pget 0 0))" :note "3 — restoring a snapshot of the current canvas is a no-op you can see.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 8 4) (clear 0) (set-color 9) (pset 2 2 7) (define s (fb-snapshot)) (clear 5) (fb-restore s) (list (pget 2 2) (pget 0 0) (get-color)))" :note "(7 0 9) — the whole canvas including the pen comes back exactly as captured.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 12 6) (clear 0) (define s (fb-snapshot)) (set-mode 4 4) (fb-restore s) (mode-info))" :note "(12 6) — the restore CHANGED THE MODE, because the dimensions are part of the record.")
  )
  :caveats ("WHAT COMES BACK DEPENDS ON WHICH VERB MADE THE RECORD. From fb-snapshot the pen is restored; from render or framebuffer it is silently set to 0. The call site looks identical in both cases. Marked needs-alfred." "IT SILENTLY CHANGES THE MODE. Restoring a 320x240 snapshot while at 128x128 resizes the canvas, and every coordinate a running program was computing is now against different bounds." "It replaces the canvas wholesale — there is no merge, no blend and no region form, so a partial undo is impossible." "IT SILENTLY WIPES THE TEXT OVERLAY. No capture verb stores it, and the restore installs a fresh framebuffer whose overlay is empty, so every string drawn with draw-text disappears — including strings that were on the canvas when the snapshot was taken. (fb-restore (fb-snapshot)) is therefore NOT a no-op for text. Marked needs-alfred." "A non-record argument raises rather than being ignored: (fb-restore 5) is an error, as is calling it with no argument at all." "It returns nothing, so the only evidence it worked is reading the canvas back.")
  :drawbacks ("The silent mode change makes it unsafe to restore an untrusted snapshot inside a loop that assumes fixed bounds." "No region form means undo is all-or-nothing at full canvas cost." "The pen behaviour is determined by a field the caller cannot see, so correctness depends on knowing which verb produced the record several lines earlier." "Nothing validates that the record's palette matches the current one, so a restore can bring back a different colour mapping without saying so.")
  :usecases ("Undoing a drawing step by putting back a saved canvas." "Restoring a canvas after borrowing it for scratch work." "Returning to a save point after exploring a speculative branch." "Loading a saved cart's canvas so play resumes exactly where it stopped.")
  :related ("fb-snapshot" "render" "framebuffer" "set-mode" "mode-info")
  :learn (:concept "Restore is only as good as the capture — the same restore call is faithful or lossy depending on a property of its argument that is invisible at the call site." :prerequisites ("fb-snapshot" "set-mode" "get-color") :progression "Restore a snapshot of the current canvas, then restore across a clear, then restore across a mode change.")
  :row-2-audit (
    (:problem "A game loop restores a saved canvas each frame and the whole game resizes, because the snapshot was taken before a set-mode call and carries the old dimensions."
     :program "(set-mode 32 16)\n(clear 0)\n;; The snapshot remembers 32x16; the restore undoes the later set-mode.\n(define s (fb-snapshot))\n(set-mode 8 4)\n(fb-restore s)\n(list 'mode (mode-info) 'expected-8x4 (list 8 4))"
     :eng-program "(set-mode 32 16)\n(clear 0)\n(define s (fb-snapshot))\n(set-mode 8 4)\n;; Check the snapshot's mode against the current one before trusting it.\n(define wanted (mode-info))\n(fb-restore s)\n(if (equal? (mode-info) wanted) 'same (set-mode (car wanted) (cadr wanted)))\n(display (mode-info))"
     :math-program "(define (compatible? a b) (equal? a b))\n;; A restore is safe only between states of the same shape.\n(display (list (compatible? (list 32 16) (list 8 4)) (compatible? (list 8 4) (list 8 4))))"
     :cs-program "(set-mode 16 8)\n(clear 0)\n(define s (fb-snapshot))\n(set-mode 4 4)\n(define before (mode-info))\n(fb-restore s)\n(display (list before (mode-info)))"
     :explanation "eng: read mode-info after the restore and re-establish the mode you wanted. math: compatibility is equality of shapes, and a restore across shapes is a resize. cs: print the mode either side of the restore and watch it move."
     :meta "The dimensions being part of the capture is deliberate and useful for undo, and it is exactly what makes a restore unsafe inside a loop whose bounds were computed once. The audit question is 'could this snapshot have a different shape than the canvas it is going into?' If yes, the bounds must be re-read after every restore rather than cached.")
    (:eng "The audit lens is 'does this restore change the shape?' — the smoke test is reading mode-info before and after." :math "A state transfer between spaces of different dimension is a reshape, not an assignment." :cs "Shape-changing restore; the reason a resize handler and a load handler are usually the same code."))
  :row-3-dimension (
    (:setup "An assignment that replaces a whole structure at once, bringing its shape along with its contents.")
    (:rungs (
       (:domain "fb-restore"    :code "(begin (set-mode 12 6) (clear 2) (define s (fb-snapshot)) (set-mode 4 4) (fb-restore s) (list (mode-info) (pget 0 0)))")
       (:domain "set!-a-list"   :code "(define xs (list 1 2 3))\n(define ys (list 9 9))\n(set! xs ys)\n(list xs (length xs))")
       (:domain "vector-fill!"  :code "(define v (make-vector 4 0))\n(vector-fill! v 7)\n(list (vector-ref v 0) (vector-length v))")))
    (:explanation "Rung 1: fb-restore swaps in a whole canvas, dimensions included, so the size can change under the caller. Rung 2: rebinding a variable to a shorter list changes its length as well as its contents, and any cached length is now wrong. Rung 3: vector-fill! replaces contents but NOT the length, which is the safe version of the same idea. The ladder separates the two kinds of wholesale write: one that can change the shape and one that cannot.")
    (:meta "The transfer works because a replacement is only safe to cache around if the shape is invariant, and shape-changing replacement is what invalidates every derived value. Grounds in book-of-code ch 09 as invalidating a cache, and in book-of-math ch-advanced-01 as a map between spaces of different dimension.")
    (:eng "Every wholesale-write substrate shares 'what did I cache that is now stale?' — the operator's check is re-deriving the bounds after the write." :math "A replacement preserving dimension is an endomorphism; one changing it is not." :cs "Shape-changing assignment; the reason a resize invalidates every layout computed before it."))
  :row-4-proof (
    (:claim "fb-restore is a total replacement: every pixel and both dimensions come from the record, and nothing of the previous canvas survives except the text overlay.")
    (:program "(set-mode 8 4)\n(clear 0)\n(set-color 9)\n(rect-fill 1 1 3 2)\n(define s (fb-snapshot))\n(clear 15)\n(pset 7 3 2)\n(fb-restore s)\n(define (scan) (map (lambda (y) (map (lambda (x) (pget x y)) (iota 8))) (iota 4)))\n(display (list (pget 7 3) (pget 2 2) (pget 0 0) (get-color)))"
     :eng-program "(set-mode 8 4)\n;; Restore must be idempotent: doing it twice is the same as doing it once.\n(clear 3)\n(define s (fb-snapshot))\n(clear 9)\n(fb-restore s)\n(define once (pget 4 2))\n(fb-restore s)\n(display (list once (pget 4 2) (= once (pget 4 2))))"
     :math-program "(define (constant-map? f xs) (= 1 (length (delete-duplicates (map f xs)))))\n;; A total replacement is a constant function of the previous state.\n(display (constant-map? (lambda (n) 'replaced) (iota 5)))"
     :cs-program "(set-mode 8 4)\n(clear 1)\n(define s (fb-snapshot))\n;; Whatever we do in between, the restore lands on the same canvas.\n(clear 7)\n(fb-restore s)\n(define a (pget 3 1))\n(pset 3 1 12)\n(fb-restore s)\n(display (list a (pget 3 1)))"
     :invariant "∀ canvases C, records R. fb-restore(R) leaves a canvas equal to R, independent of C"
     :meta "The pattern is an idempotent total write — the result depends only on the argument, never on the prior state, which is what makes a restore safe to retry. Falsified if any pixel of the old canvas had survived, which would make an undo unreliable in exactly the cases where it matters most. book-of-code ch 09 grounds idempotent writes; book-of-math ch-advanced-01 grounds the constant map."))
    (:eng "The operator can retry a restore freely, and can trust that nothing of the discarded canvas leaks through." :math "The restore is a constant map onto the captured state, hence idempotent." :cs "Idempotent full write; the property that makes a retry safe.")
  :row-5-emergence (
    (:base "fb-restore puts one saved canvas back.")
    (:composition "(set-mode 16 8)\n(clear 0)\n(set-color 9)\n;; Try three colours from one base and keep the last one.\n(rect-fill 1 1 4 3)\n(define base (fb-snapshot))\n(define (try c) (fb-restore base) (set-color c) (rect-fill 6 2 6 4) (pget 8 4))\n(display (list (try 3) (try 11) (try 15) (pget 2 2)))"
     :eng-composition "(define (attempt! base thunk)\n  ;; Always start from the same canvas, so attempts cannot contaminate.\n  (fb-restore base)\n  (thunk))\n(set-mode 16 8)\n(clear 0)\n(set-color 9)\n(rect-fill 1 1 4 3)\n(define base (fb-snapshot))\n(display (list (attempt! base (lambda () (clear 5) (pget 0 0)))\n               (attempt! base (lambda () (pget 2 2)))))"
     :math-composition "(set-mode 8 4)\n(clear 0)\n;; An undo stack: push snapshots, pop them in reverse and watch time run back.\n(define hist '())\n(define (push!) (set! hist (cons (fb-snapshot) hist)))\n(define (undo!) (if (null? hist) 'empty (begin (fb-restore (car hist)) (set! hist (cdr hist)) (pget 0 0))))\n(clear 3)\n(push!)\n(clear 7)\n(push!)\n(clear 11)\n(display (list (pget 0 0) (undo!) (undo!) (undo!)))"
     :cs-composition "(set-mode 8 4)\n(clear 0)\n(set-color 9)\n;; A/B comparison: render both variants from the same base and diff them.\n(define base (fb-snapshot))\n(define (variant c) (fb-restore base) (set-color c) (rect-fill 1 1 4 2) (map (lambda (x) (pget x 1)) (iota 8)))\n(define a (variant 8))\n(define b (variant 11))\n(display (list (equal? a b) (car a) (car b)))"
     :emergent "Three colour trials from one base, an attempt helper, an undo stack that runs time backwards and an A/B pixel diff: one restore verb turns a single mutable canvas into as many independent timelines as you need.")
    (:meta "This is the backtracking family — restoring to a known point is what lets a program explore alternatives without them interfering. Familiar analogs are a solver backtracking to a choice point, a git checkout of an earlier commit and a database rolling back to a savepoint. The composition works because the restore is total and idempotent: every attempt genuinely starts from the same place.")
    (:eng "The audit lens is 'do my attempts start from the same state?' — the smoke test is running the same attempt twice and comparing." :math "Restoring to a base point makes the exploration a tree rooted there rather than a path." :cs "Backtracking; the shape of search, undo and A/B rendering."))
)

(verb
  :name "color/named" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(color/named name) -> string | #f"
  :summary "Look up an HTML colour name and return its hex string; #f if the name is not one of the sixteen. This is NOT the palette set-color understands."
  :status "needs-alfred"
  :explanation "color/named maps a name to a hex string like \"#ffd700\". It draws on a sixteen-entry HTML colour list that is a DIFFERENT vocabulary from the one the framebuffer uses: the framebuffer knows red, orange, yellow, green, blue, lavender, peach; the HTML list knows crimson, forestgreen, gold, coral, plum, teal, sienna. Only black, white and pink are in both. The lookup is case-insensitive and accepts a symbol or a string. What comes back is a hex string, which is a colour description for a host that understands hex — it is not a palette index and no drawing verb in this chapter accepts it."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(color/named 'gold)" :note "\"#ffd700\" — the name resolves to a hex string, not to a palette index.")
    (:dialect "motoi" :tier "intermediate" :code "(list (color/named \"CRIMSON\") (color/named 'nosuchcolour))" :note "(\"#dc143c\" #f) — the lookup is case-insensitive, and an unknown name is #f rather than an error.")
    (:dialect "motoi" :tier "expert" :code "(list (color/named 'red) (color/named 'crimson))" :note "(#f \"#dc143c\") — 'red is NOT in this palette even though (set-color 'red) works; the two colour vocabularies barely overlap.")
  )
  :caveats ("IT IS A DIFFERENT COLOUR VOCABULARY FROM set-color. (color/named 'red) is #f while (set-color 'red) gives 8; (color/named 'crimson) works while (set-color 'crimson) is a silent no-op. Only black, white and pink are in both lists. Marked needs-alfred." "ITS RESULT CANNOT BE USED FOR DRAWING. (set-color (color/named 'gold)) leaves the pen unchanged, because set-color wants a palette index or a framebuffer colour name and gets a hex string it does not recognise — and it fails SILENTLY." "A miss returns #f rather than raising, and #f is also what a wrong-typed argument returns: (color/named 5) and (color/named) are both #f, so a bug and a legitimate miss look identical." "It answers with a string, so comparing two colours means string=? and a mistyped hex compares unequal without explanation." "The name says colour and the chapter is draw, but nothing in this verb touches the framebuffer.")
  :drawbacks ("Two colour name universes in one library is a permanent source of confusion, and neither verb's name says which one it belongs to." "The hex string is a dead end inside Motoi: no verb here consumes it." "#f for both 'not found' and 'bad argument' collapses two different failures into one value." "Sixteen names is too few to be a general colour vocabulary and too many to memorise as a special case.")
  :usecases ("Producing a hex string for a host, a cart manifest or an export that speaks CSS colours." "Validating that a user-supplied colour name is one of the sixteen supported ones." "Building a legend or a palette listing alongside color/palette-html-16." "Teaching that a colour has several representations — a name, an index and a hex triple.")
  :related ("color/name-of" "color/palette-html-16" "set-color" "get-color")
  :learn (:concept "Two vocabularies for one concept — the same idea can have several naming systems, and mixing them silently is worse than not having one." :prerequisites ("set-color") :progression "Look up a name, look up one that is not there, then try the same name in set-color and see the two systems disagree.")
  :row-2-audit (
    (:problem "A program reads a colour name from a config, resolves it with color/named and passes the result to set-color; nothing raises and every shape is drawn in whatever colour the pen happened to hold."
     :program "(set-mode 16 8)\n(clear 0)\n(set-color 6)\n;; The hex string is not a colour set-color understands; the pen never moves.\n(set-color (color/named 'gold))\n(rect-fill 2 2 4 3)\n(list 'pen (get-color) 'expected-gold-got (pget 3 3))"
     :eng-program "(set-mode 16 8)\n(clear 0)\n(set-color 6)\n;; Map through a table you control, from the HTML name to a palette index.\n(define (html->index n)\n  (cond ((eq? n 'gold) 10)\n        ((eq? n 'crimson) 8)\n        ((eq? n 'skyblue) 12)\n        (else 7)))\n(set-color (html->index 'gold))\n(rect-fill 2 2 4 3)\n(display (list (get-color) (pget 3 3)))"
     :math-program "(define (in-both? x a b) (and (memq x a) (memq x b) #t))\n;; The intersection of the two vocabularies is three names wide.\n(define html (list 'black 'white 'crimson 'pink))\n(define pal (list 'black 'white 'red 'pink))\n(display (map (lambda (n) (list n (in-both? n html pal))) html))"
     :cs-program "(set-mode 8 4)\n(set-color 6)\n(set-color (color/named 'gold))\n(define after-hex (get-color))\n(set-color 10)\n(display (list after-hex (get-color)))"
     :explanation "eng: never pipe one vocabulary into the other; write the mapping you actually want. math: compute the intersection and see how small it is. cs: read the pen after the bad assignment and watch that it did not move."
     :meta "Both verbs are individually correct and neither validates against the other, so the failure is a picture in the wrong colour with no diagnostic anywhere. The audit question is 'which colour system is this value from?' and Scheme cannot answer it — a palette index is a number, a framebuffer colour name is a symbol, an HTML hex is a string, and only the last is distinguishable by type.")
    (:eng "The audit lens is 'which naming system does this value come from?' — the smoke test is round-tripping it through the consumer and checking the state changed." :math "Two vocabularies over the same concept induce a partial translation, undefined outside the intersection." :cs "Impedance mismatch between two colour models; the reason a type would have caught this."))
  :row-3-dimension (
    (:setup "A lookup that returns a value from one naming system while the surrounding code expects another.")
    (:rungs (
       (:domain "color/named"    :code "(list (color/named 'red) (color/named 'crimson))")
       (:domain "unit-mismatch"  :code "(define (metres->feet m) (* m 3.28))\n(define (add-lengths a b) (+ a b))\n(list (add-lengths 5 (metres->feet 5)) (add-lengths 5 5))")
       (:domain "encoding"       :code "(define (as-string n) (number->string n))\n(list (string? (as-string 5)) (number? (as-string 5)))")))
    (:explanation "Rung 1: an HTML colour name and a framebuffer colour name are different systems that happen to share three words. Rung 2: adding metres to feet produces a number that is not wrong-looking and is wrong. Rung 3: converting a number to a string changes what operations apply, and the mistake shows up only where the value is consumed. All three are the same defect: a value carrying an implicit system, in a language that does not record which one.")
    (:meta "The transfer works because units and vocabularies are metadata the value does not carry, so the discipline has to live in the names and the documentation. Grounds in book-of-code ch 06 as type and unit discipline, and in book-of-math ch-advanced-01 as dimensional analysis.")
    (:eng "Every dual-vocabulary substrate shares 'whose name is this?' — the operator's check is naming the system in the variable name." :math "Dimensional analysis catches exactly this class of error before evaluation." :cs "Unit and encoding mismatch; the reason newtypes and branded types exist."))
  :row-4-proof (
    (:claim "color/named is a total function into hex-string-or-#f over the sixteen HTML names, and its result is never accepted by set-color.")
    (:program "(define names (color/palette-html-16))\n(define hexes (map color/named names))\n;; Every name in the published list resolves; none of them is #f.\n(display (list (length names) (length (filter string? hexes))))"
     :eng-program "(set-mode 8 4)\n;; Feed every HTML hex to set-color and watch the pen refuse to move.\n(define (pen-after hex) (set-color 6) (set-color hex) (get-color))\n(display (map pen-after (map color/named (list 'gold 'crimson 'teal))))"
     :math-program "(define (total-on? f xs) (equal? (map (lambda (x) (if (f x) #t #f)) xs) (map (lambda (x) #t) xs)))\n(display (total-on? (lambda (n) (color/named n)) (color/palette-html-16)))"
     :cs-program "(display (list (color/named 'gold) (color/named 'GOLD) (color/named \"gold\")\n               (color/named 'red) (color/named 5) (color/named)))"
     :invariant "∀ n ∈ palette-html-16. color/named(n) is a hex string  ∧  ∀ h. set-color(color/named(h)) leaves the pen unchanged"
     :meta "The pattern is a closed lookup table proved total over its own published domain, paired with a negative result about its consumer. Falsified if any published name returned #f, which would mean the palette listing and the lookup disagreed. book-of-code ch 06 grounds the closed enumeration; book-of-math ch-advanced-01 grounds totality on a domain."))
    (:eng "The operator can trust every name the palette lists and must not hand the result to a drawing verb." :math "The lookup is total on its published domain and undefined outside it." :cs "Closed enumeration with a sentinel miss; the shape of every keyword table.")
  :row-5-emergence (
    (:base "color/named resolves one name.")
    (:composition "(define names (color/palette-html-16))\n;; A legend: every supported name beside its hex.\n(display (map (lambda (n) (list n (color/named n))) (list (car names) (cadr names) (caddr names))))"
     :eng-composition "(define (colour-table names)\n  ;; A validated table: unknown names are reported, not silently dropped.\n  (map (lambda (n)\n         (let ((hex (color/named n)))\n           (if hex (list n hex) (list n 'unknown))))\n       names))\n(display (colour-table (list 'gold 'red 'teal)))"
     :math-composition "(define names (color/palette-html-16))\n;; The lookup and its inverse compose to the identity on the published names.\n(display (map (lambda (n) (eq? n (color/name-of (color/named n))))\n              (list (car names) (cadr names) (caddr names))))"
     :cs-composition "(define (css-declaration prop name)\n  ;; Export: the hex string is exactly what a stylesheet wants.\n  (let ((hex (color/named name)))\n    (if hex (string-append prop \": \" hex \";\") 'unsupported)))\n(display (list (css-declaration \"color\" 'crimson) (css-declaration \"color\" 'red)))"
     :emergent "A legend, a validated colour table, a round-trip check against color/name-of and a CSS declaration writer: a name-to-hex lookup plus the published name list is a complete little colour subsystem — one that never touches the framebuffer.")
    (:meta "This is the lookup-table family — a closed enumeration plus its listing gives you validation, display and export for free. Familiar analogs are a CSS named-colour table, an enum with a to-string, and a country-code list. The composition works because the domain is published: color/palette-html-16 tells you exactly which inputs are legal.")
    (:eng "The audit lens is 'is the domain published?' — the smoke test is looking up every listed name and finding no misses." :math "A finite bijection between two labelled sets supports both directions and a completeness check." :cs "Enum plus its listing; the shape of every validated keyword table."))
)

(verb
  :name "color/name-of" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(color/name-of hex) -> symbol | #f"
  :summary "Name the closest of the sixteen HTML colours to a hex value; it is a NEAREST match, so it almost never returns #f."
  :status "needs-alfred"
  :explanation "color/name-of takes a hex colour and returns the name of the nearest entry in the sixteen-name HTML list, measured as Euclidean distance in RGB. It is deliberately a nearest match rather than an exact lookup, which is what makes it useful for describing an arbitrary colour in words. The input is forgiving: a leading # is optional, three-digit shorthand expands, and a symbol works as well as a string. It returns #f only when the input cannot be parsed as a colour at all."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(color/name-of \"#dc143c\")" :note "crimson — an exact palette entry comes back by its own name.")
    (:dialect "motoi" :tier "intermediate" :code "(list (color/name-of \"ffd700\") (color/name-of \"#fd0\"))" :note "(gold gold) — the leading # is optional and three-digit shorthand expands.")
    (:dialect "motoi" :tier "expert" :code "(list (color/name-of \"#010203\") (color/name-of \"nonsense\"))" :note "(black #f) — a near-black hex is NAMED black even though it is not black; only unparseable input gives #f.")
  )
  :caveats ("IT NEVER SAYS 'NOT A NAMED COLOUR'. Because it is a nearest match over sixteen points, every well-formed hex gets a name — (color/name-of \"#010203\") is black and (color/name-of \"#808080\") is slategray. Using it to test whether a colour is one of the sixteen will always say yes. Marked needs-alfred." "The nearest-match behaviour is intended and documented in the implementation, so it is not a bug — it is a hazard only when the caller expected an exact lookup." "Sixteen points over the whole RGB cube means the nearest name can be a long way off; the answer is a description, not an identification." "#f means 'could not parse', not 'no match', so it cannot be used as a membership test." "It names HTML colours, not framebuffer palette colours, so its answer is often a word set-color does not know: it can return crimson, and (set-color 'crimson) is a silent no-op." "Distance in raw RGB does not match how people perceive colour, so the nearest name is sometimes not the one a person would choose.")
  :drawbacks ("No exact-match mode, so a caller who wants identification has to compare hex strings by hand." "No distance is returned, so there is no way to tell a perfect match from a wild guess." "Naive RGB distance is a poor perceptual metric; a proper one would use a perceptual colour space." "The sixteen anchor points are not evenly distributed, so some regions of colour space are described much more coarsely than others.")
  :usecases ("Describing an arbitrary colour in words for a caption or a log line." "Grouping a set of colours into sixteen buckets for a summary." "Round-tripping a name through color/named and back as a consistency check." "Giving a beginner a word for the colour they just picked.")
  :related ("color/named" "color/palette-html-16" "set-color")
  :learn (:concept "Nearest-neighbour classification — mapping a continuous space onto a small set of labels always answers, and the answer's usefulness depends entirely on how far away the nearest label was." :prerequisites ("color/named") :progression "Name an exact palette colour, then a colour one step away from it, then a colour in the middle of nowhere.")
  :row-2-audit (
    (:problem "A validator uses color/name-of to check whether a user's hex is a supported colour; it approves every hex the user types, including ones nowhere near a supported colour."
     :program "(define (supported? hex) (if (color/name-of hex) 'yes 'no))\n;; Everything is approved, because the nearest match always finds something.\n(display (map supported? (list \"#dc143c\" \"#010203\" \"#123456\")))"
     :eng-program "(define (exactly-supported? hex)\n  ;; Compare against the canonical hex for the name it was matched to.\n  (let ((n (color/name-of hex)))\n    (and n (string=? (color/named n) hex))))\n(display (map (lambda (h) (list h (if (exactly-supported? h) 'exact 'approximate)))\n              (list \"#dc143c\" \"#010203\")))"
     :math-program "(define (nearest x anchors)\n  (let loop ((as anchors) (best (car anchors)))\n    (cond ((null? as) best)\n          ((< (abs (- x (car as))) (abs (- x best))) (loop (cdr as) (car as)))\n          (else (loop (cdr as) best)))))\n;; The nearest anchor is always defined; the distance is what carries the doubt.\n(display (list (nearest 3 (list 0 10 20)) (nearest 12 (list 0 10 20))))"
     :cs-program "(define (describe hex)\n  (let ((n (color/name-of hex)))\n    (if (and n (string=? (color/named n) hex)) (list n 'exact) (list n 'nearest))))\n(display (list (describe \"#dc143c\") (describe \"#010203\")))"
     :explanation "eng: compare the matched name's canonical hex against the input to recover exactness. math: nearest-neighbour is total, so the distance must be checked separately. cs: return the name AND whether it was exact, so callers can decide."
     :meta "The verb is doing exactly what it was designed to do; the audit failure is using a describer as a validator. The question is 'does this function ever say no?' If not, it cannot be a membership test. Recovering exactness is cheap because color/named gives the canonical hex for the name that came back.")
    (:eng "The audit lens is 'can this function reject anything?' — the smoke test is feeding it obvious garbage and seeing whether it still answers." :math "A nearest-neighbour map is total on its input space; rejection requires a distance threshold." :cs "Classifier used as a validator; the defect behind every fuzzy match that approved a typo."))
  :row-3-dimension (
    (:setup "A map from a large space onto a small label set that always produces a label, however far the input was from any of them.")
    (:rungs (
       (:domain "color/name-of" :code "(list (color/name-of \"#dc143c\") (color/name-of \"#123456\"))")
       (:domain "rounding"      :code "(map (lambda (x) (round x)) (list 1.4 1.5 99.6))")
       (:domain "bucketing"     :code "(define (bucket n) (cond ((< n 10) 'low) ((< n 100) 'mid) (else 'high)))\n(map bucket (list 3 42 9999))")))
    (:explanation "Rung 1: every hex gets one of sixteen names, so the label carries no information about how good the fit was. Rung 2: rounding maps the reals onto the integers and throws away the residue — 1.4 and 1.5 land differently for a difference no one can see in the output. Rung 3: bucketing 9999 as high is correct and says nothing about how high. Each rung is a quantisation, and each discards exactly the quantity a caller would need in order to doubt the answer.")
    (:meta "The transfer works because quantisation is how a continuous world is made discussable, and the residual is always the thing that got dropped. Grounds in book-of-code ch 08 as lossy classification, and in book-of-math ch-advanced-01 as partitioning a space by nearest centroid.")
    (:eng "Every quantising substrate shares 'how far was the input from its label?' — the operator's check is reporting the residual alongside the label." :math "A Voronoi partition assigns every point to a centroid; the distance is separate information." :cs "Bucketing and rounding; the shape of every classifier that returns a class and not a confidence."))
  :row-4-proof (
    (:claim "color/name-of is a left inverse of color/named on the sixteen published names, and is total on every parseable hex.")
    (:program "(define names (color/palette-html-16))\n;; Name to hex and back must be the identity on every published name.\n(display (map (lambda (n) (eq? n (color/name-of (color/named n)))) names))"
     :eng-program "(define names (color/palette-html-16))\n(define failures (filter (lambda (n) (not (eq? n (color/name-of (color/named n))))) names))\n(display (list (length names) (length failures)))"
     :math-program "(define (left-inverse? f g xs) (equal? xs (map (lambda (x) (g (f x))) xs)))\n(display (left-inverse? (lambda (n) (list n)) (lambda (p) (car p)) (iota 6)))"
     :cs-program "(display (list (color/name-of \"#ffffff\") (color/name-of \"#fefefe\")\n               (color/name-of \"#000000\") (color/name-of \"#010203\")\n               (color/name-of \"nonsense\")))"
     :invariant "∀ n ∈ palette-html-16. color/name-of(color/named(n)) = n  ∧  ∀ parseable h. color/name-of(h) ≠ #f"
     :meta "The pattern is a left inverse on the anchors plus totality everywhere else — the round trip is exact where the anchors are and approximate in between, which is the defining shape of a quantiser. Falsified if any published name failed to round-trip, which would mean two anchors were closer to each other than to themselves. book-of-code ch 08 grounds classification; book-of-math ch-advanced-01 grounds the left inverse."))
    (:eng "The operator can trust the round trip on the sixteen names and must treat any other answer as a description." :math "The naming map is a left inverse of the hex map on the anchor set and a projection elsewhere." :cs "Exact on the enumerated values, nearest elsewhere; the contract of every quantiser.")
  :row-5-emergence (
    (:base "color/name-of names one colour.")
    (:composition "(define (describe hex)\n  ;; A colour plus its word, which is what a caption needs.\n  (list hex (color/name-of hex)))\n(display (map describe (list \"#dc143c\" \"#ffd700\" \"#123456\")))"
     :eng-composition "(define (report hex)\n  ;; Name it, and say whether the name was exact or a nearest guess.\n  (let ((n (color/name-of hex)))\n    (cond ((not n) (list hex 'unparseable))\n          ((string=? (color/named n) hex) (list hex n 'exact))\n          (else (list hex n 'nearest)))))\n(display (map report (list \"#dc143c\" \"#010203\" \"zzz\")))"
     :math-composition "(define names (color/palette-html-16))\n;; A histogram over the sixteen buckets: how do arbitrary colours distribute?\n(define samples (list \"#dc143c\" \"#d0143c\" \"#ffd700\" \"#ffd701\" \"#000000\"))\n(define labels (map color/name-of samples))\n(display (map (lambda (n) (list n (length (filter (lambda (l) (eq? l n)) labels))))\n              (list 'crimson 'gold 'black)))"
     :cs-composition "(define (palette-report hexes)\n  ;; Reduce a picture's colours to a vocabulary a person can read out loud.\n  (map (lambda (h) (color/name-of h)) hexes))\n(display (palette-report (list \"#000000\" \"#ffffff\" \"#dc143c\" \"#87ceeb\")))"
     :emergent "A caption, an exactness report, a histogram over the sixteen buckets and a spoken-vocabulary palette summary: a nearest-name lookup turns a space of sixteen million colours into something you can say out loud.")
    (:meta "This is the quantise-to-communicate family — reducing a continuous space to a small vocabulary so it can be described, compared and counted. Familiar analogs are a colour name in a paint catalogue, a star rating and a t-shirt size. The composition works because the label set is small, published and stable, so counts over it mean something.")
    (:eng "The audit lens is 'is the vocabulary small enough to be useful and large enough to be true?' — the smoke test is a histogram over the labels." :math "A finite partition induces a measurable histogram over an uncountable space." :cs "Quantisation for communication; the shape of every colour name, rating and size chart."))
)

(verb
  :name "color/palette-html-16" :std "Motoi"
  :library "draw"
  :kind "read"
  :signature "(color/palette-html-16) -> list of symbols"
  :summary "Return the sixteen HTML colour names color/named and color/name-of work with, in order, as a list of symbols."
  :status "needs-alfred"
  :explanation "color/palette-html-16 publishes the domain of the other two colour verbs. It returns a fresh list of sixteen symbols — black, white, crimson, forestgreen, peachpuff, gold, coral, plum, teal, sienna, pink, skyblue, mediumseagreen, saddlebrown, slategray, navy — in the order the nearest-match search walks them. Every one of those names resolves through color/named, and every one round-trips through color/name-of. It takes no arguments and reads nothing from the framebuffer."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(length (color/palette-html-16))" :note "16 — sixteen names, hence the name of the verb.")
    (:dialect "motoi" :tier "intermediate" :code "(list (car (color/palette-html-16)) (symbol? (car (color/palette-html-16))))" :note "(black #t) — the entries are symbols, and black comes first.")
    (:dialect "motoi" :tier "expert" :code "(list (memq 'red (color/palette-html-16)) (if (memq 'crimson (color/palette-html-16)) 'present 'absent))" :note "(#f present) — 'red is NOT in this list; crimson is the nearest thing it has to a red.")
  )
  :caveats ("IT IS NOT THE FRAMEBUFFER PALETTE. The sixteen names here are HTML colours; the sixteen colours a drawing verb can actually use are indices 0-15 with names like red, orange, lavender and peach. Only black, white and pink appear in both lists. Reading this list as 'the colours I can draw with' is wrong. Marked needs-alfred." "None of these names moves the pen: (set-color 'crimson) is a silent no-op, and (set-color 'teal) likewise." "The order is the search order of the nearest-match algorithm, not alphabetical, not by hue and not by brightness, so it looks arbitrary." "It allocates a fresh list on every call, so two calls are equal? but not eq?." "The verb name embeds the count, so a seventeenth colour would make the name a lie.")
  :drawbacks ("Publishing a domain that no drawing verb accepts invites exactly the confusion the caveats warn about." "Sixteen HTML names is an arbitrary subset of the CSS colour list with no stated selection rule." "No hex values come with the list, so a legend needs a second call per entry." "The name ties the verb to a count, which makes extension a breaking change.")
  :usecases ("Enumerating the legal inputs to color/named before validating user input." "Building a legend or a picker that shows every supported colour name." "Driving a round-trip test across the whole colour vocabulary at once." "Teaching the difference between the HTML colour names and the framebuffer palette.")
  :related ("color/named" "color/name-of" "set-color" "get-color")
  :learn (:concept "Publishing the domain — an enumeration verb turns an implicit contract into a testable one, because now the legal inputs can be listed and checked." :prerequisites ("color/named") :progression "Count the list, look up every entry, then check that each one round-trips through color/name-of.")
  :row-2-audit (
    (:problem "A colour picker is built from this list on the assumption that these are the colours the program can draw with; every selection leaves the pen where it was and the picker appears to do nothing."
     :program "(set-mode 16 8)\n(clear 0)\n(set-color 6)\n;; Selecting from the HTML list does not move the framebuffer pen.\n(set-color (car (color/palette-html-16)))\n(define a (get-color))\n(set-color (caddr (color/palette-html-16)))\n(list a (get-color) 'pen-never-moved-to-crimson)"
     :eng-program "(set-mode 16 8)\n(clear 0)\n;; The drawable colours are indices; build the picker from those instead.\n(define drawable (iota 16))\n(define (pick! i) (set-color (list-ref drawable i)) (get-color))\n(display (list (pick! 8) (pick! 11) (pick! 15)))"
     :math-program "(define html (list 'black 'white 'crimson 'pink 'teal))\n(define pal (list 'black 'white 'red 'pink 'blue))\n(define (intersect a b) (filter (lambda (x) (memq x b)) a))\n(display (list (intersect html pal) (length html)))"
     :cs-program "(set-mode 8 4)\n(set-color 6)\n(define (try n) (set-color 6) (set-color n) (get-color))\n(display (map try (list 'crimson 'teal 'black 'pink)))"
     :explanation "eng: build the picker from palette indices, which are what set-color consumes. math: intersect the two vocabularies and see how little is shared. cs: try each HTML name in set-color and watch which ones move the pen."
     :meta "The list is honest about what it is — the HTML sixteen — and the mistake is assuming that any published colour list in a drawing chapter is the drawable one. The audit question is 'which consumer is this domain published for?' Here it is for color/named and color/name-of, and for nothing else.")
    (:eng "The audit lens is 'whose domain is this?' — the smoke test is feeding each entry to the consumer you had in mind." :math "A published domain belongs to a specific function; it does not generalise to a sibling." :cs "Enumeration bound to the wrong consumer; a documentation defect that surfaces as silence."))
  :row-3-dimension (
    (:setup "A verb that publishes the legal inputs of another verb, turning an implicit contract into a value.")
    (:rungs (
       (:domain "palette-html-16" :code "(list (length (color/palette-html-16)) (car (color/palette-html-16)))")
       (:domain "enum-listing"    :code "(define (directions) (list 'north 'south 'east 'west))\n(list (length (directions)) (memq 'north (directions)))")
       (:domain "valid-range"     :code "(define (valid-indices) (iota 16))\n(list (length (valid-indices)) (memq 20 (valid-indices)))")))
    (:explanation "Rung 1: the colour list makes the domain of color/named checkable. Rung 2: a directions listing lets a caller validate input and a test iterate every case. Rung 3: publishing the legal palette indices as a list does the same for set-color. All three convert 'the manual says' into 'the program can check', which is what makes exhaustive testing possible at all.")
    (:meta "The transfer works because a contract that exists only in prose cannot be tested, and one that exists as a value can be iterated. Grounds in book-of-code ch 06 as making contracts executable, and in book-of-math ch-advanced-01 as the explicit domain of a function.")
    (:eng "Every published-domain substrate shares 'can I iterate the legal inputs?' — the operator's check is a test that walks the whole list." :math "Stating the domain explicitly is what allows a universal claim to be checked." :cs "Enum values listing; the shape of every values() method and every exhaustive match."))
  :row-4-proof (
    (:claim "The published list is exactly the domain of color/named: every entry resolves to a hex string, and every entry round-trips back to itself through color/name-of.")
    (:program "(define names (color/palette-html-16))\n(define hexes (map color/named names))\n(display (list (length names) (length (filter string? hexes)) (length (filter not hexes))))"
     :eng-program "(define names (color/palette-html-16))\n;; Every name must survive name to hex to name unchanged.\n(define bad (filter (lambda (n) (not (eq? n (color/name-of (color/named n))))) names))\n(display (list (length names) (length bad)))"
     :math-program "(define (bijection-on? f g xs)\n  (and (equal? xs (map (lambda (x) (g (f x))) xs)) #t))\n(display (bijection-on? (lambda (n) (list n)) (lambda (p) (car p)) (iota 8)))"
     :cs-program "(define names (color/palette-html-16))\n(display (list (equal? names (color/palette-html-16))\n               (eq? names (color/palette-html-16))\n               (length names)))"
     :invariant "∀ n ∈ palette-html-16. color/named(n) is a string  ∧  color/name-of(color/named(n)) = n"
     :meta "The pattern is a published enumeration proved to be exactly the domain of its consumer, closing the loop between documentation and behaviour. Falsified if any listed name missed, which would mean the listing was aspirational rather than true. book-of-code ch 06 grounds executable contracts; book-of-math ch-advanced-01 grounds the bijection on a finite set."))
    (:eng "The operator can iterate the list in a test and know it covers every legal case." :math "The listing and the lookup agree, so the enumeration is the domain and not a subset of it." :cs "Exhaustive enumeration; the property that makes a total match statement safe.")
  :row-5-emergence (
    (:base "color/palette-html-16 lists sixteen names.")
    (:composition "(define names (color/palette-html-16))\n;; A legend: every name beside its hex, generated rather than typed.\n(display (map (lambda (n) (list n (color/named n))) (list (car names) (cadr names) (caddr names))))"
     :eng-composition "(define (validate name)\n  ;; The published list is the validator; no hand-maintained copy to drift.\n  (if (memq name (color/palette-html-16)) (list name 'ok) (list name 'unsupported)))\n(display (map validate (list 'gold 'red 'teal)))"
     :math-composition "(define names (color/palette-html-16))\n;; An exhaustive round-trip test over the whole vocabulary, in one line.\n(display (list (length names)\n               (length (filter (lambda (n) (eq? n (color/name-of (color/named n)))) names))))"
     :cs-composition "(define (stylesheet names)\n  ;; Generate a CSS custom-property block from the published vocabulary.\n  (map (lambda (n) (string-append \"--\" (symbol->string n) \": \" (color/named n) \";\"))\n       names))\n(display (stylesheet (list 'gold 'crimson 'teal)))"
     :emergent "A generated legend, a drift-proof validator, an exhaustive round-trip test and a CSS variable block: publishing the domain as a value is what lets every one of these be derived instead of maintained.")
    (:meta "This is the single-source-of-truth family — deriving documentation, validation and tests from one published value so they cannot disagree with each other. Familiar analogs are generating a docs table from an enum and generating a parser from a grammar. The composition works because the list is the same object the implementation consults, so nothing can drift.")
    (:eng "The audit lens is 'is this list derived or retyped?' — the smoke test is adding an entry and seeing what updates by itself." :math "One enumeration serving several consumers keeps them provably consistent." :cs "Single source of truth; the shape of code generation from a schema."))
)

(verb
  :name "flower/paint" :std "Motoi"
  :library "draw"
  :kind "mut"
  :signature "(flower/paint n col row [spin sx sy dy petals]) -> unspecified"
  :summary "Paint one of four canned flower sprites into the framebuffer, with optional rotation, scale, vertical offset and a two-entry petal colour list."
  :status "needs-alfred"
  :explanation "flower/paint rasterises a small flower directly into the framebuffer. The sprite index n picks one of four shapes — 0 a four-dot cluster, 1 a five-petal daisy, 2 a six-petal hex, 3 a small four-petal with a stem — and the index is taken modulo 4, so any integer works. col and row are the centre. The optional arguments are spin in degrees, an X scale, a Y scale, a vertical offset applied to the centre, and a two-element list giving the petal colour and the centre colour. With no colours given the petals are 14 (pink) and the centre is 10 (yellow). Every optional argument is coerced rather than checked: a non-numeric spin or offset becomes 0, and a non-positive or non-numeric scale becomes 1."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (set-mode 24 24) (clear 0) (flower/paint 1 12 12) (list (pget 12 12) (pget 12 9)))" :note "(10 14) — the default flower has a yellow centre and pink petals.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (set-mode 24 24) (clear 0) (flower/paint 1 12 12 0 1 1 0 (list 8 12)) (list (pget 12 12) (pget 12 9)))" :note "(12 8) — the list is (petal centre), so 8 paints the petals and 12 the centre.")
    (:dialect "motoi" :tier "expert" :code "(begin (set-mode 24 24) (clear 0) (flower/paint 1 12 12 0 1 1 0 (list 'red 'blue)) (list (pget 12 12) (pget 12 9)))" :note "(10 14) — SYMBOL colour names are silently ignored and the defaults are used instead.")
  )
  :caveats ("SYMBOL COLOUR NAMES ARE SILENTLY IGNORED. (flower/paint 1 12 12 0 1 1 0 (list 'red 'blue)) paints the DEFAULT pink and yellow, because only numbers and host strings are honoured — and 'red is exactly the form set-color accepts. Marked needs-alfred." "IT IS A DOMAIN-FLAVOURED NAME IN THE CORE DRAWING LIBRARY. Every other verb here is a geometric primitive; flower/ is a themed namespace bound in the same core installer. Whether it belongs in the base language is Alfred's call. Marked needs-alfred." "The petal list is ordered (petal centre), which is the opposite of the reading order most people expect from the picture, where the centre is what you look at first." "Every optional argument is coerced, never rejected: a string spin becomes 0 degrees and a negative scale becomes 1, so a units bug or a sign error produces a perfectly ordinary flower." "The sprite index is taken modulo 4, so (flower/paint 9 ...) draws sprite 1 rather than raising." "It returns nothing, so a read-back with pget is the only evidence it painted." "It paints with disc, so it inherits the same clipping: a flower near an edge is silently cut off.")
  :drawbacks ("Four canned shapes and no way to add a fifth, so it is a fixed asset rather than a drawing tool." "Colour handling differs from every other verb in the chapter, which makes the whole library's colour story harder to state in one sentence." "No return value and no bounding box, so a caller cannot lay out flowers without recomputing the geometry by hand." "The theme is baked into the name, so the same sprite engine cannot be reused for anything that is not a flower.")
  :usecases ("Decorating a scene with a few flowers without writing the petal geometry." "Teaching rotation and scale with a shape that visibly changes under both." "Generating a field of flowers as a background for a cart." "Demonstrating that a sprite is just a composition of discs.")
  :related ("disc" "circle" "set-color" "pget" "rect-fill")
  :learn (:concept "A canned sprite — a shape someone else parameterised, where the parameters they chose are the only ones you get." :prerequisites ("set-mode" "clear" "disc") :progression "Paint a default flower, change the colours, then change the spin and scale and watch which pixels move.")
  :row-2-audit (
    (:problem "A cart passes its theme colours to flower/paint as quoted symbols, the same way it passes them to set-color, and every flower comes out the default pink and yellow with no error anywhere."
     :program "(set-mode 24 24)\n(clear 0)\n;; The theme symbols are ignored; the flower is drawn in the defaults.\n(define theme (list 'red 'blue))\n(flower/paint 1 12 12 0 1 1 0 theme)\n(list 'centre (pget 12 12) 'petal (pget 12 9) 'wanted (list 8 12))"
     :eng-program "(set-mode 24 24)\n(clear 0)\n;; Translate the theme into palette indices before handing it over.\n(define (index-of name)\n  (cond ((eq? name 'red) 8) ((eq? name 'blue) 12) ((eq? name 'green) 11) (else 7)))\n(define theme (list 'red 'blue))\n(flower/paint 1 12 12 0 1 1 0 (map index-of theme))\n(display (list (pget 12 12) (pget 12 9)))"
     :math-program "(define (honoured? v) (or (number? v) (string? v)))\n;; The accepted types are numbers and strings; symbols fall through.\n(display (map honoured? (list 8 \"red\" 'red)))"
     :cs-program "(set-mode 24 24)\n(define (petal-colour spec)\n  (clear 0)\n  (flower/paint 1 12 12 0 1 1 0 spec)\n  (pget 12 9))\n(display (list (petal-colour (list 8 12)) (petal-colour (list 'red 'blue))))"
     :explanation "eng: convert the symbols to indices at the boundary, where the mismatch is visible. math: check which types the verb actually honours. cs: paint with both spellings and compare the pixel."
     :meta "set-color accepts a symbol and flower/paint does not, which means the same theme value works in one call and is ignored in the next. The audit question is 'does this verb accept the same colour spelling as its neighbours?' The answer here is no, and nothing in the call site shows it — the failure is a picture in the default colours.")
    (:eng "The audit lens is 'does the callee accept the spelling I am using?' — the smoke test is painting with a known index and with the symbol and comparing." :math "A coercion that falls through to a default is a total function hiding a partial one." :cs "Silent type fallback; the reason a strict parse beats a lenient one at a boundary."))
  :row-3-dimension (
    (:setup "An argument that is coerced rather than validated, so a wrong-typed value produces a default instead of a complaint.")
    (:rungs (
       (:domain "flower/paint" :code "(begin (set-mode 24 24) (clear 0) (flower/paint 1 12 12 0 1 1 0 (list 'red 'blue)) (pget 12 9))")
       (:domain "or-default"   :code "(define (with-default v d) (if (number? v) v d))\n(list (with-default 5 99) (with-default 'five 99))")
       (:domain "string->number" :code "(list (string->number \"12\") (string->number \"twelve\"))")))
    (:explanation "Rung 1: a symbol petal colour falls through to the default and the flower still paints. Rung 2: an explicit default helper does the same thing on purpose, and the caller can at least see it happening. Rung 3: string->number returns #f on a failure, which is the honest version — the caller must handle it. The ladder runs from silent to visible: the further right, the harder it is to ignore that the conversion failed.")
    (:meta "The transfer works because every boundary must decide what to do with input it cannot use, and the choice between a default and a complaint determines whether the bug is found now or later. Grounds in book-of-code ch 06 as parse-don't-validate, and in book-of-math ch-advanced-01 as a total extension of a partial function.")
    (:eng "Every coercing substrate shares 'what happened to the value I passed?' — the operator's check is comparing against a known-good spelling." :math "Extending a partial function by a default makes it total and non-injective." :cs "Lenient coercion; the reason a strict boundary catches bugs a forgiving one buries."))
  :row-4-proof (
    (:claim "flower/paint honours numeric petal colours, ignores symbols, and its sprite index is taken modulo 4 so every integer names a real sprite.")
    (:program "(set-mode 24 24)\n(define (petal spec) (clear 0) (flower/paint 1 12 12 0 1 1 0 spec) (list (pget 12 12) (pget 12 9)))\n(display (list (petal (list 8 12)) (petal (list 'red 'blue)) (petal '())))"
     :eng-program "(set-mode 24 24)\n;; Sprite index modulo 4: n and n+4 must paint the same flower.\n(define (paint n) (clear 0) (flower/paint n 12 12) (list (pget 12 12) (pget 12 9)))\n(display (list (equal? (paint 1) (paint 5)) (equal? (paint 1) (paint 9)) (equal? (paint 0) (paint 4))))"
     :math-program "(define (mod4 n) (modulo n 4))\n;; Every integer lands on one of four sprites, negatives included.\n(display (map mod4 (list 0 1 4 5 9 -1 -4)))"
     :cs-program "(set-mode 24 24)\n(clear 0)\n;; Coerced arguments: a non-numeric spin must behave exactly like 0.\n(flower/paint 1 6 6 0 1 1 0)\n(define at-zero (list (pget 6 6) (pget 6 3)))\n(clear 0)\n(flower/paint 1 6 6 'spin 1 1 0)\n(display (list at-zero (list (pget 6 6) (pget 6 3))))"
     :invariant "∀ n ∈ ℤ. flower/paint(n,…) = flower/paint(n mod 4,…)  ∧  a non-numeric, non-string petal entry leaves the default in place"
     :meta "The pattern is total coercion — every input is mapped into the legal range rather than rejected, so the verb never fails and never tells you it disagreed. Falsified if any integer sprite index had raised, or if a symbol colour had been honoured. book-of-code ch 06 grounds lenient boundaries; book-of-math ch-advanced-01 grounds the modular projection."))
    (:eng "The operator can pass any integer sprite index safely and must pass colours as numbers." :math "The index map factors through ℤ/4ℤ; the colour map defaults outside its accepted types." :cs "Total coercion at a boundary; never fails, never reports.")
  :row-5-emergence (
    (:base "flower/paint paints one flower.")
    (:composition "(set-mode 40 24)\n(clear 3)\n;; A row of flowers: one call per position, sprite chosen by index.\n(for-each (lambda (i) (flower/paint i (+ 6 (* i 9)) 12 0 1 1 0 (list (+ 8 i) 10))) (iota 4))\n(display (list (pget 6 12) (pget 15 12) (pget 24 12) (pget 33 12)))"
     :eng-composition "(define (flower-field! specs)\n  ;; Each spec is (sprite x y petal centre); the data drives the picture.\n  (for-each (lambda (s)\n              (flower/paint (car s) (cadr s) (caddr s) 0 1 1 0 (list (cadddr s) 10)))\n            specs)\n  (length specs))\n(set-mode 40 24)\n(clear 3)\n(display (list (flower-field! (list (list 1 8 8 8) (list 2 20 12 11) (list 3 32 16 12)))\n               (pget 8 8) (pget 20 12)))"
     :math-composition "(set-mode 40 24)\n(clear 0)\n;; Spin sweeps the petals around the centre; the centre pixel never moves.\n(for-each (lambda (i) (clear 0) (flower/paint 1 20 12 (* i 30) 1 1 0 (list 8 10))) (iota 4))\n(display (list (pget 20 12) 'centre-fixed-under-rotation))"
     :cs-composition "(set-mode 40 24)\n(clear 3)\n;; Scale as a depth cue: bigger flowers read as nearer.\n(flower/paint 1 8 18 0 2 2 0 (list 8 10))\n(flower/paint 1 22 12 0 1 1 0 (list 9 10))\n(flower/paint 1 34 8 0 1 1 0 (list 12 10))\n(display (list (pget 8 18) (pget 22 12) (pget 34 8)))"
     :emergent "A row of four sprites, a data-driven flower field, a rotation sweep and a scale-as-depth scene: one parameterised sprite plus a loop is a whole background, with the data doing the composing.")
    (:meta "This is the parameterised-asset family — one shape with knobs, called many times with different settings, is how a scene gets built without drawing each element by hand. Familiar analogs are a sprite sheet with transforms, an SVG symbol referenced with attributes and a particle emitter. The composition works because the verb is pure in its arguments: the same call always paints the same flower.")
    (:eng "The audit lens is 'is the scene in the data or in the code?' — the smoke test is changing a list and seeing the picture change." :math "A parameterised family plus a set of parameter values generates the whole scene." :cs "Data-driven rendering; the shape of every sprite instance and every particle system."))
)
