;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library floor — 2 verbs.")

(chapter :number "27" :library "floor" :verb-count 2 :training-eligible #t)

(verb :name "floor/problem?" :std "Motoi" :library "floor" :tier "core" :kind "pure" :signature "(floor/problem? kind [ctx]) -> boolean"
  :summary "Check whether an escalation kind is currently flagged as a floor-level problem."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(floor/problem? 'inventory-critical)" :note "Ask whether the inventory-critical kind is an active problem.")
    (:dialect "motoi" :tier "intermediate" :code "(define (pause-orders) 'orders-paused)\n(when (floor/problem? 'shipping-delay) (pause-orders))" :note "Guard an action on the state of the escalation. pause-orders is a local stub — replace with a real handler in production.")
    (:dialect "motoi" :tier "expert"       :code "(define (problem-kinds all) (filter (lambda (k) (floor/problem? k)) all))\n(problem-kinds (list 'shipping-delay 'inventory-critical 'nominal))" :note "Filter to only kinds that are currently escalated."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-checkout kind) (if (floor/problem? kind) 'blocked 'proceed))\n(safe-checkout 'shipping-delay)"
     :math-program "(define (severity-index kinds) (length (filter floor/problem? kinds)))\n(severity-index (list 'a 'b 'c))"
     :cs-program "(define (checked-problem? k) (if (symbol? k) (floor/problem? k) (error 'need-symbol)))\n(checked-problem? 'inventory-critical)"
     :problem "Runtime feature-gating needs to know if an escalation is active; predicate returns cleanly."
     :explanation "eng: block/proceed. math: severity count. cs: type-guarded predicate."
     :meta "Reach for floor/problem? and NOT (route/off-domain): route routes; problem? asks.")
    (:eng "Feature gating routes around escalations." :math "Predicate is 0/1 signal for count." :cs "Type-safe predicate."))
  :row-3-dimension (
    (:setup "Predicate on escalation registry state."
     :rungs (
       (:domain "engineering"  :code "(floor/problem? 'shipping-delay)")
       (:domain "mathematics"  :code "(define (severity-index kinds) (length (filter floor/problem? kinds)))\n(severity-index (list 'a 'b 'c))")
       (:domain "cs / dispatch" :code "(define (severity-index kinds) (length (filter floor/problem? kinds)))\n(severity-index (list 'a 'b 'c))"))
     :explanation "Hardcoded, ctx-parameterized, parsed."
     :meta "Registry predicates are universal.")
    (:eng "Escalation registry drives runtime routing." :math "Boolean projection over state." :cs "Predicate pattern."))
  :row-4-proof (
    (:eng-program "(define (deterministic? k) (equal? (floor/problem? k) (floor/problem? k)))\n(deterministic? 'x)"
     :math-program "(define (boolean-typed? k) (boolean? (floor/problem? k)))\n(boolean-typed? 'x)"
     :cs-program "(define (unknown-safe? k) (or (floor/problem? k) (not (floor/problem? k))))\n(unknown-safe? 'never-seen)"
     :claim "floor/problem? is pure and returns #t or #f (never null)."
     :invariant "∀ k. boolean?(floor/problem?(k)) ∧ floor/problem?(k) = floor/problem?(k)"
     :meta "Pattern: pure predicate.")
    (:eng "Predictable branching for feature gates." :math "Boolean-valued function." :cs "Total predicate."))
  :row-5-emergence (
    (:eng-composition "(define (active-problems all) (filter floor/problem? all))\n(active-problems (list 'a 'b 'c))"
     :math-composition "(define (problem-mask kinds) (map (lambda (k) (if (floor/problem? k) 1 0)) kinds))\n(problem-mask (list 'a 'b 'c))"
     :cs-composition "(define (route-if-problem tasks router) (for-each (lambda (t) (when (floor/problem? t) (router t))) tasks))\n(route-if-problem (list 'shipping) (lambda (t) 'routed))"
     :base "floor/problem? is a state predicate."
     :emergent "Compositions: eng filter active, math bit-mask, cs conditional router."
     :meta "Family: escalation-gated pipelines.")
    (:eng "Active-problems filter drives an alert dashboard." :math "Bit masks compose with logical ops." :cs "Conditional routing keeps normal flow uncluttered."))
)

(verb
  :name "floor/mark!" :std "Motoi"
  :library "floor"
  :kind "mut"
  :signature "(floor/mark! kind) -> boolean"
  :summary "Mark a floor-problem kind as active; returns #t."
  :impl-status "wired"
  :impl-file "lib/system/domain-verbs.js"
  :impl-notes "Side-effecting flag setter. Records the given kind symbol as an active floor problem and returns #t. Marking the same kind twice is harmless — it stays marked. Pairs with the reader floor/problem?."
  :explanation "The floor is the operational surface where problems are raised — a spill, a shipping delay, an inventory shortfall. floor/mark! raises one: it records a kind symbol as an active problem and returns #t to confirm. The reader floor/problem? later asks whether a kind is active. Marking is monotone-ish within a session — marking a kind that is already marked leaves it marked."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(floor/mark! 'spill)" :note "Raise the spill problem; returns #t.")
    (:dialect "motoi" :tier "apprentice" :code "(begin (floor/mark! 'leak) (floor/problem? 'leak))" :note "Mark then confirm the problem is active: #t.")
    (:dialect "motoi" :tier "intermediate" :code "(list (floor/mark! 'jam) (floor/mark! 'delay))" :note "Mark two kinds; each returns #t, giving (#t #t).")
    (:dialect "motoi" :tier "expert" :code "(define (raise-all kinds)\n  (for-each floor/mark! kinds)\n  (length kinds))\n(raise-all (list 'spill 'leak 'jam))" :note "Raise a batch of problems; returns the count raised.")
    (:dialect "motoi" :tier "master" :code "(define (mark-idempotent? kind)\n  (floor/mark! kind)\n  (and (floor/problem? kind)\n       (begin (floor/mark! kind) (floor/problem? kind))))\n(mark-idempotent? 'spill)" :note "Marking twice keeps the problem active: #t.")
  )
  :caveats ("The kind is a symbol you choose; there is no fixed catalog of problem kinds." "Marking does not carry a severity or timestamp — it is a plain active flag." "Re-marking an already-active kind is a no-op with respect to state; it stays active.")
  :drawbacks ("There is no clear/unmark shown here; a marked kind stays active for the session." "No context or payload travels with the mark — it is a boolean presence, not a report." "Marking many kinds is one call each; no bulk-mark primitive.")
  :usecases ("Raise an operational problem so downstream guards react." "Flag a condition detected by a sensor or check." "Batch-raise several problems at the start of an incident.")
  :related ("floor/problem?")
  :learn (:concept "Flag setting: raising a named condition that predicates can later test." :prerequisites ("floor/problem?") :progression "Use floor/mark! to raise a condition, then gate actions on it with floor/problem?.")
  :row-2-audit (
    (:eng-program "(begin (floor/mark! 'spill) (floor/problem? 'spill))"
     :math-program "(define (mark-count kinds)\n  (fold (lambda (k acc) (floor/mark! k) (+ acc 1)) 0 kinds))\n(mark-count (list 'a 'b 'c))"
     :cs-program "(define (mark-guarded k)\n  (if (symbol? k) (floor/mark! k) 'bad-kind))\n(mark-guarded 'spill)"
     :problem "A sensor detected a spill on the floor and downstream code must be able to see it. Which verb records the condition so floor/problem? will report it? Not floor/problem? itself (that only reads and would never raise the flag)."
     :explanation "eng: mark then confirm the flag is set. math: folding mark over a list counts the raises. cs: guard the kind is a symbol before marking."
     :meta "Reach for floor/mark! and NOT floor/problem? to raise: mark SETS the flag; problem? only READS it. A read can never make a problem active.")
    (:eng "Detectors mark problems the operator must handle."
     :math "mark : Kind → {active}, returning #t."
     :cs "A boolean flag write into the floor state."))
  :row-3-dimension (
    (:setup "Raise a named flag that later predicates observe."
     :rungs (
       (:domain "floor problem" :code "(floor/mark! 'spill)")
       (:domain "feature toggle" :code "(begin (floor/mark! 'beta) (floor/problem? 'beta))")
       (:domain "dirty bit" :code "(begin (floor/mark! 'stale) (floor/problem? 'stale))"))
     :explanation "Rung 1: raise a floor problem. Rung 2: set a named toggle and read it. Rung 3: set a dirty bit and confirm it. Each writes a named boolean condition."
     :meta "Shape transfers to any named flag that a reader consults.")
    (:eng "Every alerting system marks conditions active."
     :math "A set-membership assertion on a kind space."
     :cs "Setting a bit in a keyed flag map."))
  :row-4-proof (
    (:eng-program "(begin (floor/mark! 'spill) (floor/problem? 'spill))"
     :math-program "(define (mark-implies-problem? k)\n  (floor/mark! k)\n  (floor/problem? k))\n(mark-implies-problem? 'leak)"
     :cs-program "(define (mark-idempotent? k)\n  (floor/mark! k)\n  (floor/mark! k)\n  (floor/problem? k))\n(mark-idempotent? 'jam)"
     :claim "After floor/mark! on a kind, floor/problem? on that kind is true, and marking twice keeps it true."
     :invariant "∀ kind k.  after (floor/mark! k), (floor/problem? k) = #t; a second mark preserves this."
     :meta "Set-then-read consistency, idempotent. Falsifier: a kind marked yet not reported active. Pattern-name: idempotent active flag.")
    (:eng "Mark-then-detect is what makes the alert reliable."
     :math "mark is a right condition for problem? on the same kind."
     :cs "Idempotent set — re-marking never toggles off."))
  :row-5-emergence (
    (:eng-composition "(define (raise-incident kinds)\n  (for-each floor/mark! kinds)\n  (filter floor/problem? kinds))\n(raise-incident (list 'spill 'leak))"
     :math-composition "(define (all-marked? kinds)\n  (for-each floor/mark! kinds)\n  (fold (lambda (k acc) (and acc (floor/problem? k))) #t kinds))\n(all-marked? (list 'a 'b 'c))"
     :cs-composition "(define (mark-and-count kinds)\n  (for-each floor/mark! kinds)\n  (length (filter floor/problem? kinds)))\n(mark-and-count (list 'x 'y))"
     :base "floor/mark! raises one named problem."
     :emergent "An incident-raise primitive emerges: mark a batch of kinds, then read back which are active. Eng: raise and confirm an incident set. Math: all-marked verifies the whole batch. CS: count the active problems."
     :meta "Family: flag-then-query — the shape of feature-flag systems, dirty-tracking, and alarm panels that raise then enumerate active conditions.")
    (:eng "An incident is a batch mark plus a read-back."
     :math "The active set is the image of the marked kinds under problem?."
     :cs "Filter-by-flag enumerates the raised conditions.")))
