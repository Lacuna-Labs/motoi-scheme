;;; 74-image.slat — Motoi Scheme Reference · Chapter 74 · library image
;;;
;;; 9 verbs in this library. Read chapter 00-intro.slat first.
;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; Every code block RUNS through ./bin/motoi. Made by Alfred Borden.
;;;
;;; The img/* constructors are PURE: they build and RETURN an image VALUE and
;;; paint nothing, so they need no (set-mode 'sd). Demonstrate them by wrapping
;;; in image? / image-width / image-height so a block prints a #t or a number.
;;;

(dialect :applies ("motoi") :note "Library image — 9 verbs.")

(chapter :number "74" :library "image" :verb-count 9 :training-eligible #t)

;; ═══ 9 verbs in library image ═══

(verb
  :name "img/circle" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/circle r mode color) -> {image}"
  :summary "Build an image value holding a circle of radius r, filled or outlined, in the given color."
  :explanation "img/circle is the roundest primitive in the image algebra: hand it a radius, a mode ('solid to fill the disc, 'outline to draw only its rim), and a color (a palette index 0–15 or a quoted name like 'red), and it returns an image VALUE — nothing is painted yet. The returned image is a square canvas exactly 2r+1 pixels on a side, with the circle centered inside it; the extra +1 is the center pixel that both the left-to-center and center-to-right radii share. Because it returns a value rather than marking the screen, you compose it: overlay a small circle on a big one for an eye, stack three with above for a snowman, or scatter many with place-image. It is the atom every rounded scene is assembled from, and the query verbs image?, image-width, and image-height read its shape back out."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image? (img/circle 10 'solid 'red))" :note "The simplest use: build a solid red circle of radius 10 and confirm it is a genuine image value — prints #t.")
    (:dialect "motoi" :tier "intermediate" :code "(define eye (overlay (img/circle 2 'solid 'black) (img/circle 6 'solid 'white)))\n(list 'width (image-width eye) 'is-image (image? eye))" :note "Overlay a small black pupil on a larger white sclera to make an eye; the composed image is as wide as the bigger circle, 13 pixels.")
    (:dialect "motoi" :tier "expert" :code "(define (target n)\n  (fold (lambda (i acc)\n          (overlay (img/circle (* (+ i 1) 4) 'outline (if (even? i) 'red 'white)) acc))\n        (img/circle 4 'solid 'red)\n        (iota n)))\n(image-width (target 4))" :note "Fold nested outline rings of growing radius over a solid center to build a bullseye; the outermost ring (radius 20) sets the 41-pixel width.")
  )
  :caveats ("The image is 2r+1 pixels wide, not 2r — the shared center pixel means an even diameter is impossible; ask for r=10 and you get 21, never 20." "Radius must be positive; a zero or negative r has no disc to draw." "'solid fills the whole disc while 'outline draws only the one-pixel rim — do not expect 'outline to leave a thick band." "color accepts a palette index 0–15 or a quoted name; an unknown name falls through to the current color rather than erroring.")
  :drawbacks ("A circle drawn on a chunky SD raster is a stair-stepped approximation, not a smooth curve; at small radii it looks octagonal." "There is no partial arc here — img/circle is always the full 360°; for a wedge or ring segment reach for the raster arc verb instead." "The bounding box is always square, so a circle wastes the four corners of its canvas when overlaid tightly against a rectangle.")
  :usecases ("Eyes, wheels, planets, bubbles, coins — any round sprite element in a game or scene." "The building block of a snowman, a traffic light, or a bullseye when stacked or overlaid." "A soft dot marker for plotting data points on a chart image." "The base disc for a clock face before hands and ticks are overlaid.")
  :related ("img/ellipse" "img/regular-polygon" "img/star" "img/square")
  :learn (:concept "A circle image as a filled or outlined disc packed into a square 2r+1 canvas, returned as a composable value." :prerequisites ("image?" "image-width") :progression "Start by confirming img/circle returns an image; then overlay two circles into an eye; then fold many into rings and stack them with above into rounded scenes.")
  :row-2-audit (
    (:problem "A game artist is building a stoplight sprite and needs three equal round lamps stacked vertically. They keep eyeballing pixel offsets by hand and the lamps drift out of alignment. They want each lamp to be an identical, self-describing image they can stack without arithmetic."
     :program "(define (lamp c) (img/circle 8 'solid c))\n(define light (above (lamp 'red) (above (lamp 'yellow) (lamp 'green))))\n(list 'width (image-width light) 'height (image-height light))"
     :eng-program "(define (make-lamp radius color)\n  (let ((img (img/circle radius 'solid color)))\n    (if (image? img) img (error 'lamp-build-failed color))))\n(define stack (above (make-lamp 8 'red) (above (make-lamp 8 'yellow) (make-lamp 8 'green))))\n(list 'ok (image? stack) 'height (image-height stack))"
     :math-program "(define (lamp-canvas r) (+ (* 2 r) 1))\n(define (stack-height r n) (* n (lamp-canvas r)))\n(list 'each (lamp-canvas 8) 'three-stacked (stack-height 8 3)\n      'matches (= (image-height (above (img/circle 8 'solid 'red) (above (img/circle 8 'solid 'yellow) (img/circle 8 'solid 'green)))) (stack-height 8 3)))"
     :cs-program "(define (typed-lamp? r c) (and (integer? r) (> r 0) (or (symbol? c) (and (integer? c) (>= c 0) (<= c 15)))))\n(if (typed-lamp? 8 'red) (image? (img/circle 8 'solid 'red)) (error 'bad-lamp))"
     :explanation "eng: wrap the constructor so a build failure is caught at the source, not three overlays later. math: predict the stacked height as 3·(2r+1) and confirm the constructor agrees. cs: guard the radius and color domain before building."
     :meta "img/square would give boxy lamps, not round ones. img/ellipse can make a circle but forces you to pass two equal axes and drop the shared-center guarantee. img/regular-polygon at high n approximates a circle but never closes to a true disc. img/circle is the one primitive whose single radius argument encodes 'perfectly round' — picking any sibling makes the artist restate roundness the wrong way.")
    (:eng "The audit lens is 'every lamp must be the same size' — the smoke test is (= (image-width a) (image-width b)) across all three lamps; a mismatch means someone passed a different radius." :math "The canvas side is the affine map r ↦ 2r+1; equal radii give equal canvases, and stacking n of them gives height n·(2r+1)." :cs "A constant-size sprite factory; the same shape as any object pool that must hand out identically-dimensioned instances."))
  :row-3-dimension (
    (:setup "A center point and a single radius that names every point at that distance — one number that fixes a whole rounded region."
     :rungs (
       (:domain "image"   :code "(image-width (img/circle 10 'solid 'red))")
       (:domain "radar"   :code "(define (in-range? cx cy px py radius) (<= (+ (* (- px cx) (- px cx)) (* (- py cy) (- py cy))) (* radius radius)))\n(list (in-range? 0 0 6 8 10) (in-range? 0 0 9 9 10))")
       (:domain "level-set" :code "(define (dist2 x y) (+ (* x x) (* y y)))\n(define (disc? x y r) (<= (dist2 x y) (* r r)))\n(map (lambda (p) (disc? (car p) (cadr p) 5)) '((0 0) (3 4) (5 0) (4 4)))"))
     :explanation "Rung 1: img/circle turns a radius into a filled disc image 2r+1 wide. Rung 2: a radar 'in range?' test asks whether a blip lies within a radius of the station. Rung 3: the level-set predicate keeps exactly the points whose squared distance is at most r². All three share one shape — a disc is the set of points within radius r of a center, and the boundary circle is the level set where distance equals r."
     :meta "The transfer works because a circle is not a shape you draw stroke by stroke; it is a MEMBERSHIP TEST — 'is this point within r of the center?' The image, the radar sweep, and the inequality x²+y² ≤ r² are the same predicate rendered on different substrates. Grounds in book-of-math as the level-set-of-a-distance-function shape.")
     (:eng "Every radius-defined region shares one smoke test: a point exactly r from center is on the boundary, a point at r−1 is inside, a point at r+1 is out — three probes pin the whole region." :math "The disc is { p : ‖p − c‖ ≤ r } and its rim is the level set ‖p − c‖ = r; the Euclidean norm is the single function being thresholded." :cs "A range query on a metric space — the same predicate behind spatial-index radius searches and collision broad-phase circles."))
  :row-4-proof (
    (:claim "The width of a circle image is always 2r+1 — the diameter plus the shared center pixel — and width equals height because the canvas is square."
     :program "(define (check r)\n  (let ((img (img/circle r 'solid 'red)))\n    (and (= (image-width img) (+ (* 2 r) 1))\n         (= (image-width img) (image-height img)))))\n(display (check 5)) (newline)\n(display (check 10)) (newline)\n(display (check 1)) (newline)\n(display (check 23))"
     :eng-program "(define (audit-canvas radii)\n  (map (lambda (r)\n         (let ((w (image-width (img/circle r 'solid 'white))))\n           (list 'r r 'width w 'delta (- w (+ (* 2 r) 1)))))\n       radii))\n(audit-canvas '(1 5 10 20))"
     :math-program "(define (odd-side? r) (odd? (image-width (img/circle r 'solid 'blue))))\n(list 'r5 (odd-side? 5) 'r6 (odd-side? 6) 'r7 (odd-side? 7))"
     :cs-program "(define (contract-circle? r)\n  (let ((img (img/circle r 'solid 3)))\n    (and (image? img)\n         (= (image-width img) (image-height img))\n         (= (image-width img) (+ (* 2 r) 1)))))\n(contract-circle? 12)"
     :invariant "∀ r > 0. image-width(img/circle(r, m, c)) = 2r+1 = image-height(img/circle(r, m, c))"
     :meta "The pattern is a dimension contract that is independent of mode and color — a solid and an outline circle of the same radius have the identical bounding box, so mode is a fill decision, never a size decision. It would be falsified if a radius produced an even side or a non-square canvas; that would mean the center pixel was miscounted and every overlay alignment built on it would drift.")
    (:eng "The consequence is that an artist can compute layout from radii alone before rendering — a circle's footprint is knowable without drawing it." :math "The map r ↦ 2r+1 is strictly monotone and always odd, so no two radii collide and every circle has an exact center pixel." :cs "A total dimension function with no hidden state; the shape of any constructor whose output size is a pure function of its inputs."))
  :row-5-emergence (
    (:base "img/circle alone is one filled or outlined disc on a square canvas."
     :composition "(define head (img/circle 8 'solid 'white))\n(define belly (img/circle 12 'solid 'white))\n(define base (img/circle 16 'solid 'white))\n(define snowman (above head (above belly base)))\n(list 'is-image (image? snowman) 'height (image-height snowman))"
     :eng-composition "(define (snowman-of . radii)\n  (fold (lambda (r acc) (above acc (img/circle r 'solid 'white)))\n        (img/circle (car radii) 'solid 'white)\n        (cdr radii)))\n(image-height (snowman-of 8 12 16))"
     :math-composition "(define radii '(8 12 16))\n(define predicted (apply + (map (lambda (r) (+ (* 2 r) 1)) radii)))\n(define built (image-height (above (img/circle 8 'solid 'white) (above (img/circle 12 'solid 'white) (img/circle 16 'solid 'white)))))\n(list 'predicted predicted 'built built 'agree (= predicted built))"
     :cs-composition "(define (stack-circles radii)\n  (fold (lambda (r acc) (above acc (img/circle r 'solid 'white)))\n        (empty-scene 1 1)\n        radii))\n(image? (stack-circles '(6 9 12 15)))"
     :emergent "A snowman — three discs of decreasing radius stacked bottom-heavy — assembled entirely from one primitive and the vertical above combinator; the same fold builds any bottom-heavy totem of rounded parts."
     :meta "This is the compositional-geometry family: a scene is not a special verb but a fold of atoms under a stacking operator. above is associative, so the snowman's height is exactly the sum of its parts' heights (the math rung proves it), and the identity element empty-scene lets the fold start clean. The same pattern makes bead strings, caterpillars, and totem poles.")
    (:eng "The audit lens is 'the built height must equal the sum of part heights' — if it does not, a part was scaled or clipped by the combinator, which is a fast bug signal." :math "above is an associative monoid operation on images with empty-scene as identity, so folding discs accumulates height additively." :cs "A fold over a list of atoms under an associative combinator — the canonical reduce-to-aggregate pattern, here reducing discs to a figure."))
)

(verb
  :name "img/square" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/square s mode color) -> {image}"
  :summary "Build an image value holding an s×s square, filled or outlined, in the given color."
  :explanation "img/square is the tile-maker of the image algebra. One number s gives both the width and the height, because a square is the shape whose two dimensions are locked equal — so unlike img/rectangle you never pass a second measurement. The mode is 'solid for a filled block or 'outline for a frame, and color is a palette index or a quoted name. The result is a value, not a mark on the screen; s pixels wide by s pixels tall exactly, with no shared-center fudge (a square's edge count is its side, so 20 means 20). Squares are what you reach for when you want axis-aligned, gridded, tessellating parts: game tiles, pixels of a mosaic, windows on a building, cells of a board. Because they pack edge to edge with no gaps, beside and above lay them into rows and grids without any arithmetic."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (img/square 20 'outline 8))" :note "A 20×20 hollow square in palette color 8; asking its width returns exactly 20 — the side you asked for, no off-by-one.")
    (:dialect "motoi" :tier "intermediate" :code "(define tile (img/square 10 'solid 7))\n(define row (beside tile (beside tile tile)))\n(list 'row-width (image-width row) 'tile-height (image-height tile))" :note "Lay three identical 10-pixel tiles side by side; the row is 30 wide because squares abut with no gap.")
    (:dialect "motoi" :tier "expert" :code "(define (checker n)\n  (fold (lambda (i acc) (beside acc (img/square 8 'solid (if (even? i) 0 15))))\n        (img/square 8 'solid 0)\n        (iota n)))\n(image-width (checker 7))" :note "Fold alternating black-and-white cells into a checkerboard strip; eight cells of 8 pixels give a 64-pixel band.")
  )
  :caveats ("s sets BOTH sides — there is no way to make a non-square with this verb; use img/rectangle when width and height differ." "The side is exact (s means s), unlike img/circle's 2r+1 — do not carry the circle's off-by-one intuition over to squares." "'outline draws a one-pixel frame; the interior stays transparent, so overlaying it lets a background show through the middle." "A very small square (s=1 or s=2) is a dot or a tiny block and reads as noise, not a tile.")
  :drawbacks ("A square cannot be rotated by this verb; a diamond needs rotate applied afterward, which enlarges the bounding box." "There is no corner-radius option — every square is hard-cornered, so rounded UI panels need a different construction." "Because the footprint is exactly s, squares tile perfectly but leave no built-in margin; spacing between tiles must be added by hand.")
  :usecases ("Game map tiles and tilesets that must abut without seams." "Pixels of a low-resolution mosaic or a sprite editor's cells." "Windows on a building, cells of a board game, keys of a keyboard sprite." "A solid backdrop panel or a hollow frame around another image via overlay.")
  :related ("img/rectangle" "img/circle" "img/regular-polygon" "img/triangle")
  :learn (:concept "A square image as the width=height special case of a rectangle, sized exactly s, ideal for gap-free tiling." :prerequisites ("image-width" "beside") :progression "Confirm one square's exact width; lay a few side by side with beside; then fold alternating colors into a checkerboard and stack rows into a full grid.")
  :row-2-audit (
    (:problem "A puzzle-game maker is laying out a board of equal cells and needs the cells to abut perfectly with no seam and no overlap. Their first attempt used circles and got round gaps between cells; they need a shape whose footprint tiles the plane exactly."
     :program "(define cell (img/square 12 'solid 6))\n(define board-row (beside cell (beside cell (beside cell cell))))\n(list 'row-width (image-width board-row) 'expected (* 4 12))"
     :eng-program "(define (row-of tile n)\n  (fold (lambda (i acc) (beside acc tile)) tile (iota (- n 1))))\n(define cell (img/square 12 'solid 6))\n(let ((r (row-of cell 4)))\n  (list 'ok (= (image-width r) (* 4 12)) 'width (image-width r)))"
     :math-program "(define (tiles-exactly? s n)\n  (= (image-width (fold (lambda (i acc) (beside acc (img/square s 'solid 6)))\n                        (img/square s 'solid 6) (iota (- n 1))))\n     (* s n)))\n(list 's12-n4 (tiles-exactly? 12 4) 's8-n5 (tiles-exactly? 8 5))"
     :cs-program "(define (typed-cell? s) (and (integer? s) (> s 0)))\n(if (typed-cell? 12) (= (image-width (img/square 12 'solid 6)) 12) (error 'bad-cell))"
     :explanation "eng: a row builder that asserts the seamless width contract after assembly. math: prove that n tiles of side s produce width exactly s·n — no gap, no overlap. cs: guard the side domain before constructing."
     :meta "img/circle leaves round gaps at the corners where four cells meet — it cannot tile the plane. img/regular-polygon at n=6 tiles hexagonally, not on a grid the puzzle wants. img/rectangle would work but forces the maker to pass s twice and restate that the cell is square. img/square is the one primitive whose single side argument both sizes the cell AND asserts it tessellates squarely.")
    (:eng "The audit lens is 'row width must equal cell-count times side' — if beside of n cells is not s·n, a seam or overlap crept in and the tiling is broken." :math "Squares tile the plane because their side is a common edge length; n of them along an axis span exactly n·s with zero remainder." :cs "A gap-free packing along one axis — the same shape as laying fixed-width columns in a table with no inter-column padding."))
  :row-3-dimension (
    (:setup "One measurement that is reused for two dimensions because a constraint forces them equal — a single degree of freedom standing for a two-dimensional object."
     :rungs (
       (:domain "image"   :code "(image-width (img/square 20 'solid 5))")
       (:domain "screen"  :code "(define (aspect w h) (/ w h))\n(define (square-screen? w h) (= (aspect w h) 1))\n(list (square-screen? 480 480) (square-screen? 640 480))")
       (:domain "area"    :code "(define (square-area s) (* s s))\n(define (side-from-area a) (sqrt a))\n(list 'area (square-area 20) 'side-back (side-from-area 400))"))
     :explanation "Rung 1: img/square takes one side s and produces an s×s canvas. Rung 2: a screen is square exactly when its aspect ratio is 1, collapsing two dimensions to one. Rung 3: a square's area is s² and the side is recovered by the square root, again one number governing both extents. All three share one shape — a single parameter fixes a two-dimensional square because the width=height constraint removes the second degree of freedom."
     :meta "The transfer works because 'square' is a constraint, not just a shape: it says width and height are the same variable. Wherever an object is pinned to equal extents — a 1:1 aspect ratio, an area that is a perfect square, a symmetric matrix's dimension — one number does the work of two. Grounds in book-of-math as the equal-constraint / single-degree-of-freedom shape.")
     (:eng "Every equal-extent object shares one smoke test: measure both dimensions and assert they match; a square that reports width ≠ height is corrupt." :math "The square is the diagonal of the (width, height) plane where w = h; its one free parameter is the side s and its area is the parabola s²." :cs "A single field standing for a symmetric pair — the same shape as an n storing both the rows and columns of a square matrix."))
  :row-4-proof (
    (:claim "A square image's width equals its height and both equal the requested side s exactly, regardless of mode."
     :program "(define (check s)\n  (let ((solid (img/square s 'solid 'red))\n        (hollow (img/square s 'outline 'red)))\n    (and (= (image-width solid) s)\n         (= (image-height solid) s)\n         (= (image-width solid) (image-width hollow))\n         (= (image-height solid) (image-height hollow)))))\n(display (check 10)) (newline)\n(display (check 20)) (newline)\n(display (check 1)) (newline)\n(display (check 33))"
     :eng-program "(define (audit-sides sides)\n  (map (lambda (s)\n         (let ((img (img/square s 'solid 4)))\n           (list 's s 'w (image-width img) 'h (image-height img) 'exact (= (image-width img) s))))\n       sides))\n(audit-sides '(1 8 16 40))"
     :math-program "(define (square? img) (= (image-width img) (image-height img)))\n(list (square? (img/square 15 'solid 2)) (square? (img/square 30 'outline 9)))"
     :cs-program "(define (contract-square? s)\n  (let ((img (img/square s 'solid 3)))\n    (and (image? img) (= (image-width img) s) (= (image-height img) s))))\n(contract-square? 12)"
     :invariant "∀ s > 0. image-width(img/square(s, m, c)) = s = image-height(img/square(s, m, c))"
     :meta "The pattern is an equality contract binding two outputs to one input and to each other; mode is orthogonal to size, so a solid and an outline square of side s share a bounding box exactly. Falsified if any side produced width ≠ height or width ≠ s — that would mean the verb silently added padding or an off-by-one, breaking every grid layout that trusts the footprint to be s·s.")
    (:eng "The consequence is that a tile's footprint is knowable from its side alone, so a grid's total size is (side·cols)×(side·rows) with no rendering needed." :math "The identity map on the diagonal w=h: input s determines the point (s, s), which is why one number suffices." :cs "A constructor whose two output dimensions are provably equal — the invariant a square-matrix or square-canvas type would enforce."))
  :row-5-emergence (
    (:base "img/square alone is one s×s filled or hollow block."
     :composition "(define (grid n cell)\n  (let ((row (fold (lambda (i acc) (beside acc cell)) cell (iota (- n 1)))))\n    (fold (lambda (i acc) (above acc row)) row (iota (- n 1)))))\n(define board (grid 4 (img/square 12 'solid 6)))\n(list 'width (image-width board) 'height (image-height board))"
     :eng-composition "(define (windows floors per-floor)\n  (let* ((pane (img/square 6 'solid 'yellow))\n         (row (fold (lambda (i acc) (beside acc pane)) pane (iota (- per-floor 1)))))\n    (fold (lambda (i acc) (above acc row)) row (iota (- floors 1)))))\n(image-height (windows 3 5))"
     :math-composition "(define (grid-side n s)\n  (image-width (let ((row (fold (lambda (i acc) (beside acc (img/square s 'solid 6))) (img/square s 'solid 6) (iota (- n 1)))))\n                 (fold (lambda (i acc) (above acc row)) row (iota (- n 1))))))\n(list 'n4-s12 (grid-side 4 12) 'predicted (* 4 12) 'agree (= (grid-side 4 12) (* 4 12)))"
     :cs-composition "(define (tessellate n s color)\n  (let ((row (fold (lambda (i acc) (beside acc (img/square s 'solid color))) (img/square s 'solid color) (iota (- n 1)))))\n    (image? (fold (lambda (i acc) (above acc row)) row (iota (- n 1))))))\n(tessellate 5 8 3)"
     :emergent "A grid — a full n×n board built by folding squares into a row with beside, then folding rows into a stack with above; the same double-fold makes a chessboard, a spreadsheet, a building facade, or a pixel canvas."
     :meta "This is the tessellation family: a two-dimensional tiling is a fold-of-folds under two orthogonal combinators (beside for the inner axis, above for the outer). Squares are the tile that admits this cleanly because they pack with zero gap, so the grid's side is exactly n·s (the math rung proves it). The same nested fold generalizes to any gap-free tile.")
    (:eng "The audit lens is 'grid side = n · cell side' on both axes — a mismatch means a row or column dropped or overlapped a tile." :math "A regular tiling of the plane by squares; the grid is the Cartesian product of a horizontal and a vertical fold." :cs "A nested fold building a 2D array from a 1D atom — the row-major construction behind every raster and tile map."))
)

(verb
  :name "img/rectangle" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/rectangle w h mode color) -> {image}"
  :summary "Build an image value holding a w-wide by h-tall rectangle, filled or outlined, in the given color."
  :explanation "img/rectangle is the two-freedom cousin of img/square: width and height are supplied independently, so it draws any axis-aligned box, from a tall thin bar to a wide flat band. Pass width w, height h, a mode ('solid or 'outline), and a color, and it returns an image value exactly w×h — the width you asked for, the height you asked for, no adjustment. It is the workhorse behind anything with a long straight run and a definite thickness: bar-chart columns, health meters, window sills, the stripes of a flag, the trunk of a tree. Because width and height move separately, it also expresses proportion and aspect ratio, which a square cannot. As a value it composes with beside for side-by-side bars and above for stacked bands, and its footprint is fully predictable, which makes it the reliable measuring stick of a laid-out scene."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-height (img/rectangle 30 10 'solid 12))" :note "A 30-wide, 10-tall solid rectangle in palette color 12; querying its height returns exactly 10 — the second argument, untouched.")
    (:dialect "motoi" :tier "intermediate" :code "(define bar (img/rectangle 40 6 'solid 'green))\n(list 'w (image-width bar) 'h (image-height bar))" :note "A wide, thin green bar; width and height are independent, so 40 and 6 come back exactly as given.")
    (:dialect "motoi" :tier "expert" :code "(define (bar-chart heights)\n  (apply beside (map (lambda (h) (img/rectangle 8 h 'solid 'blue)) heights)))\n(image-width (bar-chart '(10 25 15 30 20)))" :note "Map five data values to columns of fixed width 8 but data-driven height, then beside them into a chart; five 8-wide bars make a 40-wide chart.")
  )
  :caveats ("w and h are separate — swapping them rotates the box 90°, which is a common and silent mistake; the first argument is always the width." "The footprint is exact (w means w, h means h), like img/square and unlike img/circle's 2r+1." "'outline draws a one-pixel frame; a thick border needs an outline over a slightly smaller solid, or two nested rectangles." "A degenerate rectangle with h=1 is a horizontal bar and with w=1 a vertical bar — usable, but consider img/line for a pure 1-pixel run.")
  :drawbacks ("No rounded corners and no rotation from this verb; a tilted or pill-shaped box needs rotate or a composition applied afterward." "Only axis-aligned rectangles are expressible; a parallelogram or trapezoid must be built from a polygon primitive." "Stacking many bars with beside gives no inter-bar gap, so a bar chart's spacing must be added deliberately with spacer images.")
  :usecases ("Bar-chart and histogram columns whose height encodes data." "Health bars, progress bars, and loading meters in a game HUD." "The stripes of a flag, the sill of a window, the plank of a shelf." "The trunk of a tree or the body of a building before round or triangular parts are overlaid.")
  :related ("img/square" "img/line" "img/ellipse" "img/circle")
  :learn (:concept "A rectangle image with independent width and height, the general axis-aligned box that a square specializes." :prerequisites ("img/square" "image-height") :progression "Start from a square, then free the two dimensions to make a bar; map data to bar heights and beside them into a chart; stack colored bands into a flag with above.")
  :row-2-audit (
    (:problem "A dashboard maker is drawing a horizontal progress bar that must show a fraction filled. They need the filled portion's width to be exactly the fraction times the full width, so a 40% bar is visibly 40% and a reader can trust the pixels. Hand-tuning widths per value keeps drifting."
     :program "(define (progress full-w h frac color)\n  (img/rectangle (round (* full-w frac)) h 'solid color))\n(let ((bar (progress 100 8 0.4 'green)))\n  (list 'filled-width (image-width bar) 'expected 40))"
     :eng-program "(define (progress-bar full-w h frac color)\n  (let ((fw (max 0 (min full-w (round (* full-w frac))))))\n    (let ((bar (img/rectangle (max 1 fw) h 'solid color)))\n      (list 'frac frac 'width (image-width bar) 'clamped (<= (image-width bar) full-w)))))\n(progress-bar 100 8 0.4 'green)"
     :math-program "(define (fill-width full-w frac) (round (* full-w frac)))\n(define (linear? full-w)\n  (= (fill-width full-w 0.5) (* 2 (fill-width full-w 0.25))))\n(list 'w40-at-0.4 (fill-width 100 0.4) 'linear (linear? 100))"
     :cs-program "(define (safe-frac f) (max 0.0 (min 1.0 f)))\n(define (progress full-w h f)\n  (image-width (img/rectangle (max 1 (round (* full-w (safe-frac f)))) h 'solid 'green)))\n(list (progress 100 8 0.4) (progress 100 8 1.5) (progress 100 8 -0.2))"
     :explanation "eng: clamp the fraction to [0,1] and never let the fill exceed the track. math: show the fill width is linear in the fraction — 0.5 gives twice 0.25. cs: guard the fraction domain so out-of-range inputs cannot draw a negative or over-long bar."
     :meta "img/square cannot represent a fractional width without also shrinking the height, which would collapse the bar. img/line has no thickness to read as a meter. img/ellipse is round and cannot show a crisp filled fraction. img/rectangle is the one primitive whose independent width encodes a fraction while its fixed height keeps the bar readable.")
    (:eng "The audit lens is 'filled width = round(fraction · track width)' — a probe at 0%, 50%, 100% must give 0, half, full; anything else means the mapping is wrong." :math "The fill is the linear map frac ↦ round(frac · W), monotone and clamped to [0, W]." :cs "A value-to-pixel scale with clamping — the same shape as any gauge that maps a bounded quantity onto a fixed track."))
  :row-3-dimension (
    (:setup "Two independent extents multiplied into an area — a length and a breadth that vary separately and together measure how much."
     :rungs (
       (:domain "image"  :code "(image-height (img/rectangle 40 6 'solid 2))")
       (:domain "room"   :code "(define (floor-area w h) (* w h))\n(define (fits-carpet? room-w room-h carpet-w carpet-h) (and (<= carpet-w room-w) (<= carpet-h room-h)))\n(list 'area (floor-area 40 6) 'fits (fits-carpet? 40 6 30 5))")
       (:domain "product" :code "(define (rect-area w h) (* w h))\n(define (aspect w h) (/ w h))\n(list 'area (rect-area 40 6) 'aspect (aspect 40 6))"))
     :explanation "Rung 1: img/rectangle takes a width and a height independently to size a box. Rung 2: a room's floor is a width by a height, and a carpet fits when both extents are within the room's. Rung 3: a rectangle's area is the product w·h and its aspect is the ratio w/h. All three share one shape — two orthogonal degrees of freedom whose product is an area and whose ratio is a proportion."
     :meta "The transfer works because a rectangle is the CARTESIAN PRODUCT of two intervals: [0,w] × [0,h]. Anything with two independent one-dimensional extents — a floor plan, a screen resolution, a matrix's shape — is this same product. Grounds in book-of-math as the product-of-two-intervals / area shape.")
     (:eng "Every two-extent object shares one smoke test: the two dimensions are independent, so changing one must not change the other; a rectangle whose height moved when you set its width is broken." :math "The rectangle is the product set [0,w] × [0,h]; its measure is w·h and its shape is the pair (w, h) up to scaling." :cs "A record of two independent fields whose product is derived — the shape of every width×height dimension type and 2D extent."))
  :row-4-proof (
    (:claim "A rectangle image reports back exactly the width and height it was built with, independently, and mode does not change either."
     :program "(define (check w h)\n  (let ((solid (img/rectangle w h 'solid 'red))\n        (hollow (img/rectangle w h 'outline 'red)))\n    (and (= (image-width solid) w)\n         (= (image-height solid) h)\n         (= (image-width solid) (image-width hollow))\n         (= (image-height solid) (image-height hollow)))))\n(display (check 30 10)) (newline)\n(display (check 5 40)) (newline)\n(display (check 1 1)) (newline)\n(display (check 64 3))"
     :eng-program "(define (audit-dims pairs)\n  (map (lambda (p)\n         (let ((img (img/rectangle (car p) (cadr p) 'solid 4)))\n           (list 'asked p 'got (list (image-width img) (image-height img))\n                 'exact (and (= (image-width img) (car p)) (= (image-height img) (cadr p))))))\n       pairs))\n(audit-dims '((30 10) (5 40) (64 3)))"
     :math-program "(define (independent? )\n  (let ((a (img/rectangle 30 10 'solid 1))\n        (b (img/rectangle 50 10 'solid 1)))\n    (and (= (image-height a) (image-height b))\n         (not (= (image-width a) (image-width b))))))\n(independent?)"
     :cs-program "(define (contract-rect? w h)\n  (let ((img (img/rectangle w h 'solid 3)))\n    (and (image? img) (= (image-width img) w) (= (image-height img) h))))\n(contract-rect? 40 12)"
     :invariant "∀ w > 0, h > 0. image-width(img/rectangle(w, h, m, c)) = w ∧ image-height(...) = h"
     :meta "The pattern is an independence contract — two outputs each equal to its own input, with no cross-talk and no dependence on mode. Falsified if setting the width changed the reported height, or if an outline box differed in footprint from a solid one; that would mean the two extents are secretly coupled and every proportion-sensitive layout (charts, meters) would be untrustworthy.")
    (:eng "The consequence is that a bar's data-driven height and a chart's fixed width can be reasoned about separately, which is exactly what a plotting layout needs." :math "The map (w, h) ↦ (w, h) is the identity on the extent pair, so each dimension is recovered exactly." :cs "A constructor with orthogonal, independently-recoverable dimensions — the contract a (width, height) value type guarantees."))
  :row-5-emergence (
    (:base "img/rectangle alone is one axis-aligned box of a chosen width and height."
     :composition "(define (flag)\n  (above (img/rectangle 60 12 'solid 1)\n         (above (img/rectangle 60 12 'solid 15)\n                (img/rectangle 60 12 'solid 8))))\n(list 'width (image-width (flag)) 'height (image-height (flag)))"
     :eng-composition "(define (stripes colors band-w band-h)\n  (fold (lambda (c acc) (above acc (img/rectangle band-w band-h 'solid c)))\n        (img/rectangle band-w band-h 'solid (car colors))\n        (cdr colors)))\n(image-height (stripes '(1 15 8 12) 60 8))"
     :math-composition "(define bands '(1 15 8))\n(define band-h 12)\n(define predicted (* (length bands) band-h))\n(define built (image-height (above (img/rectangle 60 band-h 'solid 1) (above (img/rectangle 60 band-h 'solid 15) (img/rectangle 60 band-h 'solid 8)))))\n(list 'predicted predicted 'built built 'agree (= predicted built))"
     :cs-composition "(define (flag-of colors w each-h)\n  (fold (lambda (c acc) (above acc (img/rectangle w each-h 'solid c)))\n        (empty-scene w 1)\n        colors))\n(image? (flag-of '(1 15 8 12 3) 60 8))"
     :emergent "A tricolor flag — three equal-width bands stacked with above; widen it to any striped banner by folding a color list, and the same construction yields loading screens, gradient ramps, and layered terrain bands."
     :meta "This is the layered-band family: a striped image is a fold of equal-width rectangles under above. Because every band shares the width, the composite width stays constant while the height accumulates (the math rung proves height = bands · band-h). The same fold, turned sideways under beside, produces a column of vertical stripes or a segmented bar.")
    (:eng "The audit lens is 'total height = band count · band height and width is constant across bands' — a varying width means a band was mis-sized." :math "A stack of congruent-width rectangles under the associative above operator; heights sum, width is invariant." :cs "A fold accumulating uniform bands — the same shape as concatenating fixed-height rows into a framebuffer or a striped texture."))
)

(verb
  :name "img/triangle" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/triangle s mode color) -> {image}"
  :summary "Build an image value holding an equilateral, point-up triangle of side length s, filled or outlined, in the given color."
  :explanation "img/triangle draws the first shape that is not a box: an equilateral triangle standing on its base with its apex pointing up. A single argument s sets the side length — all three sides are equal because the triangle is equilateral — and the verb returns an image value whose width is s+1 (the base plus its endpoint pixel) and whose height is the triangle's altitude, roughly s·√3/2. It is where you reach for a peak, a roof, a mountain, an arrowhead, a tree's canopy, or a warning sign. Point-up is the natural orientation for anything that rises; flip it with rotate for a downward wedge or a play-button. Because a triangle's bounding box wastes its two lower corners (the shape narrows to a point at the top), overlaying it on a square gives the classic house, and stacking a few gives a fir tree — compositions the box primitives cannot make on their own."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (img/triangle 30 'solid 'green))" :note "A solid green equilateral triangle of side 30; its width is 31 — the base of 30 plus the pixel that closes it.")
    (:dialect "motoi" :tier "intermediate" :code "(define roof (img/triangle 30 'solid 'red))\n(define wall (img/square 30 'solid 8))\n(list 'roof-w (image-width roof) 'wall-w (image-width wall) 'aligned (= (image-width roof) (image-width wall)))" :note "A roof triangle and a wall square of matching span; because side 30 gives width 31 for both, they stack cleanly into a house.")
    (:dialect "motoi" :tier "expert" :code "(define (arrow-up) (above (img/triangle 16 'solid 'yellow) (img/rectangle 6 14 'solid 'yellow)))\n(image? (arrow-up))" :note "An up-arrow built from a triangular head over a thin rectangular shaft; the point-up default makes it read as 'up' with no rotation.")
  )
  :caveats ("The triangle is always equilateral and point-up; a right triangle, isosceles, or scalene shape needs a general polygon primitive, not this verb." "Width is s+1 but height is the altitude s·√3/2 (about 0.87·s), so the bounding box is taller-narrow, not square — do not assume width equals height." "For a downward-pointing wedge, apply rotate 180 afterward; this verb has no orientation argument." "'outline draws the three edges only; the interior stays clear so a background shows through the middle of the triangle.")
  :drawbacks ("On a chunky raster the slanted edges stair-step visibly, and a small triangle can look jagged or lopsided." "The two lower corners of the bounding box are always empty, so a triangle overlaid against a rectangle leaves triangular gaps that must be planned around." "No control over apex angle — every triangle is 60-60-60, so a steep spire or a shallow ramp is impossible without a polygon.")
  :usecases ("Roofs of houses, spires, and the classic square-plus-triangle building." "Fir trees and mountains built by stacking or overlaying triangles." "Arrowheads, play buttons, and directional markers (point-up by default, rotated for other directions)." "Warning-sign and hazard glyphs where the triangle is the canonical outline.")
  :related ("img/regular-polygon" "img/square" "img/star" "img/circle")
  :learn (:concept "An equilateral point-up triangle image sized by its side, the first non-rectangular primitive and the building block of roofs and peaks." :prerequisites ("img/square" "image-height") :progression "Confirm a triangle's s+1 width; match it to a square of the same side and overlay into a house; then stack triangles into a tree and rotate one into an arrow.")
  :row-2-audit (
    (:problem "A scene builder is drawing a row of houses and needs each roof to sit flush on its wall with no overhang and no gap. The roofs kept overhanging because the builder sized the triangle side and the square side by different numbers. They want the roof's span to match the wall's span by construction."
     :program "(define side 30)\n(define house (above (img/triangle side 'solid 'red) (img/square side 'solid 8)))\n(list 'roof-w (image-width (img/triangle side 'solid 'red))\n      'wall-w (image-width (img/square side 'solid 8))\n      'flush (image? house))"
     :eng-program "(define (house side wall-color roof-color)\n  (let ((roof (img/triangle side 'solid roof-color))\n        (wall (img/square side 'solid wall-color)))\n    (if (>= (image-width roof) (image-width wall))\n        (above roof wall)\n        (error 'roof-too-narrow side))))\n(image? (house 30 8 'red))"
     :math-program "(define (roof-span s) (image-width (img/triangle s 'solid 'red)))\n(define (wall-span s) (image-width (img/square s 'solid 8)))\n(define (overhang s) (- (roof-span s) (wall-span s)))\n(list 'overhang-30 (overhang 30) 'overhang-20 (overhang 20))"
     :cs-program "(define (house-safe side)\n  (if (and (integer? side) (> side 0))\n      (above (img/triangle side 'solid 'red) (img/square side 'solid 8))\n      (error 'bad-side side)))\n(image? (house-safe 30))"
     :explanation "eng: assert the roof span is at least the wall span before stacking, else refuse. math: measure the overhang as roof-width minus wall-width; sharing s keeps it a constant 1 pixel. cs: guard the side domain before building the house."
     :meta "img/square gives a flat top, not a peak — it cannot be a roof. img/regular-polygon at n=3 is a triangle but is sized by circumradius, not side, so matching it to a wall means converting radius to side. img/star and img/circle are the wrong silhouette entirely. img/triangle is the one primitive sized by the same 'side' number as the square, so a roof and a wall of the same s align by construction."
     )
    (:eng "The audit lens is 'roof span ≥ wall span, ideally equal' — the smoke test compares the two widths, and a mismatch means the roof will overhang or leave the wall edges bare." :math "Both roof and wall are sized by side s: the triangle spans s+1 and the square spans s, so their widths differ by exactly one pixel for any s." :cs "A shared-parameter alignment — two constructors driven by one dimension so their footprints stay in lockstep."))
  :row-3-dimension (
    (:setup "Three equal sides meeting at three equal angles — the smallest rigid figure, defined entirely by one length."
     :rungs (
       (:domain "image"    :code "(image-width (img/triangle 30 'solid 'green))")
       (:domain "truss"    :code "(define (equilateral? a b c) (and (= a b) (= b c)))\n(define (rigid? sides) (= (length sides) 3))\n(list 'equilateral (equilateral? 30 30 30) 'rigid (rigid? '(30 30 30)))")
       (:domain "geometry" :code "(define (tri-altitude s) (* s (/ (sqrt 3) 2)))\n(define (tri-area s) (* (/ 1 2) s (tri-altitude s)))\n(list 'altitude (tri-altitude 30) 'area (tri-area 30))"))
     :explanation "Rung 1: img/triangle turns one side length into an equilateral silhouette. Rung 2: a truss is equilateral when its three members are equal, and three members already make it rigid — the minimum bracing. Rung 3: the geometry gives the altitude s·√3/2 and the area from one side. All three share one shape — three equal sides at 60° fully determine an equilateral triangle from a single number."
     :meta "The transfer works because a triangle is the SIMPLEX in two dimensions: the fewest points (three) that enclose an area, and equilateral pins them with one parameter. That minimality is why triangles brace bridges, mesh 3D models, and tile the plane — the shape is the irreducible rigid unit. Grounds in book-of-math as the 2-simplex / minimal-rigid-figure shape.")
     (:eng "Every equilateral figure shares one smoke test: all three sides must measure equal; a truss or triangle where one side differs is not equilateral and its symmetry claims break." :math "An equilateral triangle is fixed by one side s: altitude = s·√3/2, area = (√3/4)·s², all angles 60°." :cs "The 2-simplex — the minimal cell of a triangular mesh and the base case of barycentric interpolation."))
  :row-4-proof (
    (:claim "A triangle image's width is its side plus one (base plus closing pixel), independent of mode, and its height is strictly less than its width because the altitude is only about 0.87 of the side."
     :program "(define (check s)\n  (let ((t (img/triangle s 'solid 'green)))\n    (and (= (image-width t) (+ s 1))\n         (< (image-height t) (image-width t)))))\n(display (check 10)) (newline)\n(display (check 20)) (newline)\n(display (check 30)) (newline)\n(display (check 41))"
     :eng-program "(define (audit-tri sides)\n  (map (lambda (s)\n         (let ((t (img/triangle s 'solid 4)))\n           (list 's s 'w (image-width t) 'h (image-height t) 'w-exact (= (image-width t) (+ s 1)))))\n       sides))\n(audit-tri '(10 20 30 40))"
     :math-program "(define (shorter-than-wide? s)\n  (let ((t (img/triangle s 'solid 2)))\n    (< (image-height t) (image-width t))))\n(list (shorter-than-wide? 20) (shorter-than-wide? 40))"
     :cs-program "(define (contract-tri? s)\n  (let ((solid (img/triangle s 'solid 3))\n        (hollow (img/triangle s 'outline 3)))\n    (and (image? solid)\n         (= (image-width solid) (+ s 1))\n         (= (image-width solid) (image-width hollow)))))\n(contract-tri? 30)"
     :invariant "∀ s > 0. image-width(img/triangle(s, m, c)) = s+1 ∧ image-height(...) < image-width(...)"
     :meta "The pattern is a shape-signature contract: width tracks the base linearly while height tracks the altitude, and because √3/2 < 1 the box is always wider than it is tall for an equilateral. Falsified if a triangle came back as tall as it is wide (that would be a different apex angle, not equilateral) or if the outline version had a different footprint from the solid one — either would mean the silhouette is not the 60-60-60 triangle it claims."
     )
    (:eng "The consequence is that a builder can predict a roof's span from its side and know it will be shorter than it is wide, so it caps a wall without towering over it." :math "Width = s+1 (base), height = ⌈s·√3/2⌉, and √3/2 ≈ 0.866 < 1 forces height < width for every side." :cs "A constructor whose two dimensions follow different linear laws of one input — a non-square aspect fixed by the shape's geometry."))
  :row-5-emergence (
    (:base "img/triangle alone is one equilateral point-up peak."
     :composition "(define (tree)\n  (above (img/triangle 24 'solid 'green)\n         (above (img/triangle 30 'solid 'green)\n                (img/rectangle 8 12 'solid 8))))\n(list 'is-image (image? (tree)) 'height (image-height (tree)))"
     :eng-composition "(define (fir tiers base-side)\n  (let ((canopy (fold (lambda (i acc)\n                        (above (img/triangle (- base-side (* i 6)) 'solid 'green) acc))\n                      (img/triangle base-side 'solid 'green)\n                      (iota tiers))))\n    (above canopy (img/rectangle 8 12 'solid 8))))\n(image? (fir 3 30))"
     :math-composition "(define (mountain-range sides)\n  (apply beside (map (lambda (s) (img/triangle s 'solid 6)) sides)))\n(define widths (map (lambda (s) (+ s 1)) '(20 30 25)))\n(list 'total-width (image-width (mountain-range '(20 30 25))) 'sum-of-parts (apply + widths))"
     :cs-composition "(define (peaks sides)\n  (fold (lambda (s acc) (beside acc (img/triangle s 'solid 6)))\n        (empty-scene 1 1)\n        sides))\n(image? (peaks '(15 22 18 30 12)))"
     :emergent "A fir tree — stacked triangles of decreasing side over a rectangular trunk — and, laid side by side, a mountain range; the same primitive stacks into peaks or lines up into a skyline."
     :meta "This is the peaked-silhouette family: rising forms are folds of triangles, either vertical (above, giving a layered canopy) or horizontal (beside, giving a range). The triangle contributes the 'up' that boxes lack, and because its width is the predictable s+1 (Row 4), a range's total width is the exact sum of the parts (the math rung confirms it). The same fold makes bunting, saw-tooth waves, and crystal facets."
     )
    (:eng "The audit lens is 'range width = sum of (side+1) across peaks' — a shortfall means two triangles overlapped instead of abutting." :math "A beside-fold of triangles: widths sum because the combinator lays them edge to edge; above-fold stacks a self-similar canopy." :cs "A fold of the 2-simplex under a layout combinator — the same shape as composing mesh triangles into a strip or fan."))
)

(verb
  :name "img/star" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/star r mode color) -> {image}"
  :summary "Build an image value holding a classic five-pointed star of outer radius r, filled or outlined, in the given color."
  :explanation "img/star is the ready-made five-pointed star — the shape of a sheriff's badge, a gold sticker, a rating, a flag emblem, a twinkle in a night sky. You give it the outer radius r (the distance from center to a point's tip), a mode, and a color, and it returns an image value on a square canvas 2r+1 pixels on a side, because the star's five tips reach r in every direction and the bounding box is the circle that encloses them. It is the fixed, most-recognizable member of the star family: five points, the standard inner-to-outer ratio that makes it read as 'a star' rather than a spiky blob. When you want any other number of points, or an unusual spikiness, you graduate to img/star-poly; img/star is the one you reach for when you just want the familiar star and nothing to tune."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (img/star 15 'solid 'yellow))" :note "A solid yellow five-pointed star of outer radius 15; its bounding box is 31 pixels square, since 2·15+1 spans tip to tip.")
    (:dialect "motoi" :tier "intermediate" :code "(define badge (overlay (img/star 8 'solid 'yellow) (img/circle 14 'solid 1)))\n(list 'width (image-width badge) 'is-image (image? badge))" :note "Overlay a small gold star on a blue disc to make a badge; the disc (radius 14, width 29) sets the composite footprint.")
    (:dialect "motoi" :tier "expert" :code "(define (rating n)\n  (apply beside (map (lambda (i) (img/star 8 'solid 'yellow)) (iota n))))\n(image-width (rating 5))" :note "Lay n identical stars side by side into a rating widget; five 17-wide stars make an 85-pixel strip.")
  )
  :caveats ("Five points is fixed — img/star cannot make a six- or seven-pointed star; that is img/star-poly's job." "r is the OUTER radius (center to tip); the inner radius is set internally to the standard ratio, so you cannot tune spikiness here." "The bounding box is a square 2r+1 wide, but the star only fills the area inside its points — the four corners and the gaps between points are empty." "'outline traces the ten-segment star outline; the interior stays clear so overlays show through the middle.")
  :drawbacks ("On a chunky raster the fine points can blunt or lose a pixel at small radii, making a small star look like a pentagon." "No control over the inner radius means every img/star has the same spikiness; a chunkier or thinner star needs img/star-poly." "Like all pointed shapes it wastes most of its square bounding box, so tight packing against neighbors leaves visible gaps.")
  :usecases ("Rating widgets, gold stickers, and score indicators." "Sheriff badges, flag emblems, and decorative seals." "Twinkling stars in a night-sky scene, scattered with place-image." "A reward or power-up sprite in a game, often overlaid on a disc.")
  :related ("img/star-poly" "img/regular-polygon" "img/circle" "img/triangle")
  :learn (:concept "A canonical five-pointed star image sized by outer radius, the fixed member of the star family before the tunable img/star-poly." :prerequisites ("img/circle" "overlay") :progression "Confirm a star's 2r+1 square box; overlay one on a disc for a badge; beside several into a rating; then move to img/star-poly when five points is not enough.")
  :row-2-audit (
    (:problem "A game is showing a five-star rating and the designer wants every star identical and evenly spaced, and the whole widget to have a predictable width so it can be centered in a HUD. Sizing stars by trial and error kept giving an unpredictable total width."
     :program "(define (rating n r)\n  (apply beside (map (lambda (i) (img/star r 'solid 'yellow)) (iota n))))\n(let ((w (image-width (rating 5 8))))\n  (list 'stars 5 'each (image-width (img/star 8 'solid 'yellow)) 'total w))"
     :eng-program "(define (rating-widget filled total r)\n  (let ((row (apply beside\n                    (map (lambda (i) (img/star r 'solid (if (< i filled) 'yellow 8)))\n                         (iota total)))))\n    (list 'width (image-width row) 'filled filled 'of total)))\n(rating-widget 3 5 8)"
     :math-program "(define (star-box r) (+ (* 2 r) 1))\n(define (widget-width n r) (* n (star-box r)))\n(list 'each (star-box 8) 'five (widget-width 5 8)\n      'matches (= (widget-width 5 8) (image-width (apply beside (map (lambda (i) (img/star 8 'solid 'yellow)) (iota 5))))))"
     :cs-program "(define (safe-rating n r)\n  (if (and (integer? n) (> n 0) (> r 0))\n      (image-width (apply beside (map (lambda (i) (img/star r 'solid 'yellow)) (iota n))))\n      (error 'bad-rating (list n r))))\n(safe-rating 5 8)"
     :explanation "eng: draw filled vs empty stars by index to show a partial rating. math: predict widget width as n·(2r+1) and confirm the build agrees. cs: guard the count and radius before assembling the row."
     :meta "img/star-poly could make a five-pointed star but forces you to also pass the point count and manage the inner radius — extra knobs the rating does not need. img/regular-polygon gives a pentagon, not a star. img/circle is round, not pointed. img/star is the zero-configuration five-pointed star, so the rating's only variables are count and radius, and its width is exactly n·(2r+1)."
     )
    (:eng "The audit lens is 'widget width = star count · (2r+1)' — the smoke test multiplies out, and a mismatch means a star was a different size or the row overlapped." :math "Each star's box is 2r+1; n of them beside give n·(2r+1) because the combinator abuts bounding boxes." :cs "A uniform-sprite row whose total extent is a closed-form product of count and per-item size."))
  :row-3-dimension (
    (:setup "Points equally spaced around a circle, alternating between an outer and an inner radius to make a pointed rosette."
     :rungs (
       (:domain "image"    :code "(image-width (img/star 15 'solid 'yellow))")
       (:domain "clock"    :code "(define (tick-angle i n) (* i (/ 360 n)))\n(map (lambda (i) (tick-angle i 5)) (iota 5))")
       (:domain "polar"    :code "(define (star-vertex i outer inner)\n  (let ((r (if (even? i) outer inner)) (theta (* i (/ 3.14159 5))))\n    (list (* r (cos theta)) (* r (sin theta)))))\n(map (lambda (i) (star-vertex i 15 6)) (iota 4))"))
     :explanation "Rung 1: img/star places five tips around a center at radius r. Rung 2: a clock's tick marks sit at equal angular steps 360/n around the face. Rung 3: the polar formula alternates outer and inner radii at evenly spaced angles to trace the star's ten vertices. All three share one shape — vertices sampled at equal angular intervals around a circle, which is exactly what makes a star, a clock face, or any radial rosette."
     :meta "The transfer works because a star is a POLAR FUNCTION sampled on a schedule: angle steps by a fixed increment and the radius toggles outer/inner. Anything laid out around a center at equal angles — clock ticks, pie slices, gear teeth, radar spokes — is the same equal-angular-sampling shape. Grounds in book-of-math as the polar-sampling / roots-of-unity-on-a-circle shape.")
     (:eng "Every radial layout shares one smoke test: consecutive features must be one equal angular step apart; a star or clock with uneven spacing between points is malformed." :math "The tips are at angles 2πk/5 for k=0..4 on the outer circle; alternating an inner radius at the half-steps gives the ten-vertex star polygon." :cs "Equal-angular sampling of a polar function — the same shape as generating the nth roots of unity or laying out a radial menu."))
  :row-4-proof (
    (:claim "A five-pointed star's bounding box is a square 2r+1 wide (tip to tip through the center), independent of mode."
     :program "(define (check r)\n  (let ((s (img/star r 'solid 'yellow)))\n    (and (= (image-width s) (+ (* 2 r) 1))\n         (= (image-width s) (image-height s)))))\n(display (check 8)) (newline)\n(display (check 15)) (newline)\n(display (check 20)) (newline)\n(display (check 5))"
     :eng-program "(define (audit-star radii)\n  (map (lambda (r)\n         (let ((s (img/star r 'solid 4)))\n           (list 'r r 'w (image-width s) 'square (= (image-width s) (image-height s)))))\n       radii))\n(audit-star '(5 8 15 20))"
     :math-program "(define (tip-to-tip? r)\n  (= (image-width (img/star r 'solid 2)) (+ (* 2 r) 1)))\n(list (tip-to-tip? 10) (tip-to-tip? 15) (tip-to-tip? 20))"
     :cs-program "(define (contract-star? r)\n  (let ((solid (img/star r 'solid 3))\n        (hollow (img/star r 'outline 3)))\n    (and (image? solid)\n         (= (image-width solid) (+ (* 2 r) 1))\n         (= (image-width solid) (image-width hollow)))))\n(contract-star? 15)"
     :invariant "∀ r > 0. image-width(img/star(r, m, c)) = 2r+1 = image-height(img/star(r, m, c))"
     :meta "The pattern is that the bounding box is governed by the OUTER radius alone — the inner radius and the point count shape the silhouette inside the box but never the box itself, so a star and a same-radius circle share a footprint. Falsified if a star's box were not square or not 2r+1; that would mean a tip reached past r or fell short, breaking any layout that reserves a 2r+1 slot for it."
     )
    (:eng "The consequence is that a star occupies exactly the same slot as a circle of the same radius, so badges (star over disc) and ratings reserve a knowable box." :math "All five tips lie on the circle of radius r, so the tightest enclosing box is that circle's box, 2r+1 square." :cs "A constructor whose footprint is fixed by one extremal parameter (the outer radius) regardless of interior detail."))
  :row-5-emergence (
    (:base "img/star alone is one five-pointed star on a square canvas."
     :composition "(define (sheriff)\n  (overlay (img/star 10 'outline 'black)\n           (overlay (img/star 12 'solid 'yellow)\n                    (img/circle 16 'solid 8))))\n(list 'is-image (image? (sheriff)) 'width (image-width (sheriff)))"
     :eng-composition "(define (star-band n r)\n  (fold (lambda (i acc) (beside acc (img/star r 'solid 'white)))\n        (img/star r 'solid 'white)\n        (iota (- n 1))))\n(image-width (star-band 5 10))"
     :math-composition "(define (band-width n r) (* n (+ (* 2 r) 1)))\n(define built (image-width (fold (lambda (i acc) (beside acc (img/star 10 'solid 'white))) (img/star 10 'solid 'white) (iota 4))))\n(list 'predicted (band-width 5 10) 'built built 'agree (= (band-width 5 10) built))"
     :cs-composition "(define (constellation rs)\n  (fold (lambda (r acc) (beside acc (img/star r 'solid 'white)))\n        (empty-scene 1 1)\n        rs))\n(image? (constellation '(6 10 8 12 5)))"
     :emergent "A sheriff's badge — an outlined star over a filled star over a disc — and a star band, a row of stars for a flag canton or a rating; the same star becomes an emblem when nested or a stripe of stars when repeated."
     :meta "This is the emblem / repeated-motif family: a single recognizable glyph is either nested under overlay (concentric layers registering on a shared center to make a seal) or repeated under beside (a band whose width is the exact sum of slots, per Row 4). Because every star's footprint is a knowable 2r+1 box, both the concentric registration and the linear tiling are predictable. The same construction makes rosettes, medals, and flag cantons."
     )
    (:eng "The audit lens is 'nested stars share a center, banded stars sum their boxes' — a badge whose layers drift means the overlay centers disagreed." :math "Overlay registers images on a common center (concentric radii); beside sums bounding boxes (linear tiling)." :cs "A glyph composed two ways — z-stacked for an emblem, list-tiled for a band — the two canonical uses of a reusable sprite."))
)

(verb
  :name "img/star-poly" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/star-poly r points mode color) -> {image}"
  :summary "Build an image value holding an n-pointed star with the given number of points and outer radius r, filled or outlined."
  :explanation "img/star-poly is the parameterized star: where img/star fixes five points, this one lets you name the point count. Pass the outer radius r, the number of points, a mode, and a color, and you get a star with exactly that many tips arranged evenly around the circle of radius r. Four points make a compass rose or a sparkle; six points make a Star of David silhouette; seven or nine points make an unusual seal; a high count approaches a spiky sunburst. The bounding box stays a square 2r+1 wide because the tips all reach r regardless of how many there are — the point count reshapes the silhouette inside a fixed box. Reach for it whenever five is the wrong number: a sparkle effect, a national-flag star with the local point count, a snowflake's arms, or a difficulty-scaling reward that adds a point per tier."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (img/star-poly 15 7 'outline 'cyan))" :note "A seven-pointed outlined cyan star of outer radius 15; the box is 31 square, the same as any radius-15 star.")
    (:dialect "motoi" :tier "intermediate" :code "(define sparkle (img/star-poly 12 4 'solid 'white))\n(list 'points 4 'width (image-width sparkle) 'is-image (image? sparkle))" :note "A four-pointed white star reads as a sparkle or a compass rose; the point count changes the silhouette but not the 25-pixel box.")
    (:dialect "motoi" :tier "expert" :code "(define (star-ladder radius counts)\n  (map (lambda (p) (list p (image-width (img/star-poly radius p 'solid 3)))) counts))\n(star-ladder 15 '(4 5 6 7 8))" :note "Sweep the point count from four to eight at a fixed radius; every star reports the same width because the outer radius alone fixes the box.")
  )
  :caveats ("points must be at least 3 to form a star; fewer than three tips is not a closed star polygon." "Only the point COUNT is tunable here, not the inner-radius ratio — the spikiness is chosen internally to look star-like at each count." "The bounding box is 2r+1 square regardless of point count, so a many-pointed star does not grow; it just packs more tips into the same box." "A very high point count on a small radius blurs into a gear or a disc as the tips crowd together and lose definition on a chunky raster.")
  :drawbacks ("More points mean shallower notches between them, so at high counts the star reads as a spiky circle rather than a distinct star." "No independent control of inner radius means you cannot make a thin needle-star or a fat blunt-star at a given point count." "Odd point counts have no mirror symmetry across the horizontal, so they can look tilted unless rotated deliberately.")
  :usecases ("Sparkle and twinkle effects (four- or six-pointed) in particle systems." "Flag stars and seals that use a non-five point count." "Snowflake arms (six-pointed) and compass roses (four- or eight-pointed)." "Difficulty or tier indicators that add a point per level.")
  :related ("img/star" "img/regular-polygon" "img/circle" "img/triangle")
  :learn (:concept "A star polygon with a caller-chosen point count at a fixed outer radius, generalizing img/star's fixed five." :prerequisites ("img/star" "img/regular-polygon") :progression "Start from the five-pointed img/star; free the point count with img/star-poly; sweep counts to see the box stay fixed; then use it for sparkles, snowflakes, and flag stars.")
  :row-2-audit (
    (:problem "A particle artist wants a sparkle effect where each sparkle has a random number of points between four and eight but a consistent size so the effect looks uniform. Different point counts kept changing the sprite size and the sparkles jittered in scale."
     :program "(define (sparkle points r) (img/star-poly r points 'solid 'white))\n(map (lambda (p) (list 'points p 'width (image-width (sparkle p 10)))) '(4 5 6 7 8))"
     :eng-program "(define (uniform-sparkles counts r)\n  (let ((widths (map (lambda (p) (image-width (img/star-poly r p 'solid 'white))) counts)))\n    (list 'widths widths 'all-equal (apply = widths))))\n(uniform-sparkles '(4 5 6 7 8) 10)"
     :math-program "(define (box r) (+ (* 2 r) 1))\n(define (invariant-box? counts r)\n  (apply = (cons (box r) (map (lambda (p) (image-width (img/star-poly r p 'solid 2))) counts))))\n(invariant-box? '(4 6 8) 10)"
     :cs-program "(define (safe-star r points)\n  (if (and (> r 0) (integer? points) (>= points 3))\n      (image-width (img/star-poly r points 'solid 'white))\n      (error 'bad-star (list r points))))\n(safe-star 10 6)"
     :explanation "eng: confirm every sparkle's width is equal across the point counts so the effect is scale-uniform. math: assert the box equals 2r+1 for every count. cs: guard that the point count is at least three."
     :meta "img/star is stuck at five points, so it cannot vary the sparkle shape. img/regular-polygon makes convex polygons with no notches — not sparkles. img/circle has no points at all. img/star-poly is the one primitive that varies the point count while the outer radius holds the size constant, which is exactly the 'same size, different points' the effect needs."
     )
    (:eng "The audit lens is 'all sparkles share a width regardless of point count' — the smoke test asks (apply = widths); a stray value means a sparkle was sized by something other than r." :math "The outer radius alone fixes the enclosing box 2r+1, so point count is a shape parameter orthogonal to size." :cs "A family of sprites varying in silhouette but constant in footprint — the shape of a skinnable icon set with a fixed slot."))
  :row-3-dimension (
    (:setup "A count n of features spread evenly around a circle, where n is a free parameter and the radius is fixed."
     :rungs (
       (:domain "image"   :code "(image-width (img/star-poly 15 6 'solid 'cyan))")
       (:domain "gear"    :code "(define (tooth-angle i teeth) (* i (/ 360 teeth)))\n(map (lambda (i) (tooth-angle i 6)) (iota 6))")
       (:domain "modular" :code "(define (nth-root-angle k n) (* k (/ 360 n)))\n(map (lambda (k) (nth-root-angle k 8)) (iota 8))"))
     :explanation "Rung 1: img/star-poly spreads n tips evenly around the circle of radius r. Rung 2: a gear's teeth sit at 360/n intervals, so n is the tooth count. Rung 3: the n-th roots of unity are n points at equal angles 360k/n on the unit circle. All three share one shape — n features placed at equal angular steps around a center, where n is the free count and the geometry is otherwise fixed."
     :meta "The transfer works because n equally-spaced points on a circle is the ROOTS-OF-UNITY schedule with n as the only variable. A star, a gear, a polygon, a clock with n ticks, a pie with n slices — all are the same angular partition 2π/n. img/star-poly exposes that n directly, which is why it is the tunable member of the family. Grounds in book-of-math as the cyclic-group / n-fold-symmetry shape.")
     (:eng "Every n-fold radial layout shares one smoke test: exactly n features, each one 360/n degrees from the next; a count-off around the shape must return n." :math "The n tips are at angles 2πk/n (k=0..n−1) — the argument of the n-th roots of unity — with the star's inner radius interleaved at the half-steps." :cs "A parameterized angular partition — the same shape as generating n-gon vertices, FFT twiddle factors, or a radial menu of n items."))
  :row-4-proof (
    (:claim "The bounding box of an n-pointed star is 2r+1 square for every point count — the outer radius alone fixes the size, and the point count only reshapes the interior."
     :program "(define (check r p)\n  (let ((s (img/star-poly r p 'solid 'cyan)))\n    (and (= (image-width s) (+ (* 2 r) 1))\n         (= (image-width s) (image-height s)))))\n(display (check 15 4)) (newline)\n(display (check 15 6)) (newline)\n(display (check 15 9)) (newline)\n(display (check 20 5))"
     :eng-program "(define (audit-counts r counts)\n  (map (lambda (p)\n         (let ((s (img/star-poly r p 'solid 4)))\n           (list 'points p 'w (image-width s) 'box-ok (= (image-width s) (+ (* 2 r) 1)))))\n       counts))\n(audit-counts 15 '(4 5 6 7 8))"
     :math-program "(define (box-invariant? r counts)\n  (apply = (map (lambda (p) (image-width (img/star-poly r p 'solid 2))) counts)))\n(list (box-invariant? 12 '(4 5 6 7)) (box-invariant? 20 '(5 8 11)))"
     :cs-program "(define (contract-star-poly? r p)\n  (let ((s (img/star-poly r p 'solid 3)))\n    (and (image? s)\n         (= (image-width s) (+ (* 2 r) 1))\n         (= (image-width s) (image-height s)))))\n(contract-star-poly? 15 7)"
     :invariant "∀ r > 0, points ≥ 3. image-width(img/star-poly(r, points, m, c)) = 2r+1 = image-height(...)"
     :meta "The pattern is that size and shape are ORTHOGONAL parameters: r controls the box, point count controls the silhouette, and neither leaks into the other. Falsified if adding a point changed the width — that would mean a tip escaped the radius-r circle, breaking the promise that a star reserves the same slot as its circumscribing circle no matter how many points it grows."
     )
    (:eng "The consequence is that a HUD can swap a five-pointed star for a seven-pointed one without relayout, since both fill the identical 2r+1 slot." :math "All tips lie on the circle of radius r for any n, so the enclosing box is that circle's box independent of n." :cs "Orthogonal parameters — one sizes, one shapes — the clean separation a well-designed sprite constructor provides."))
  :row-5-emergence (
    (:base "img/star-poly alone is one n-pointed star at a fixed radius."
     :composition "(define (snowflake)\n  (overlay (img/star-poly 6 6 'solid 'white)\n           (img/star-poly 14 6 'outline 'cyan)))\n(list 'is-image (image? (snowflake)) 'width (image-width (snowflake)))"
     :eng-composition "(define (point-ladder r max-points)\n  (fold (lambda (p acc) (beside acc (img/star-poly r p 'solid 'white)))\n        (img/star-poly r 3 'solid 'white)\n        (iota (- max-points 3) 4)))\n(image? (point-ladder 10 8))"
     :math-composition "(define (all-same-box r counts)\n  (let ((ws (map (lambda (p) (image-width (img/star-poly r p 'solid 6))) counts)))\n    (list 'widths ws 'uniform (apply = ws) 'expected (+ (* 2 r) 1))))\n(all-same-box 12 '(4 5 6 7 8))"
     :cs-composition "(define (burst r counts)\n  (fold (lambda (p acc) (overlay (img/star-poly r p 'outline 'yellow) acc))\n        (img/circle 4 'solid 'yellow)\n        counts))\n(image? (burst 15 '(4 6 8 12)))"
     :emergent "A snowflake — a small solid six-pointed star nested in a larger outlined one — and a starburst built by overlaying stars of many point counts on a common center; the tunable point count turns one primitive into snowflakes, sunbursts, and compass roses."
     :meta "This is the parameterized-motif family: because the point count is a free knob, a single verb spans a whole visual vocabulary, and because every star shares the 2r+1 box (Row 4), overlaying different counts registers them perfectly on one center. Nesting counts makes a snowflake; sweeping counts makes a ladder; overlaying many makes a burst. The same knob-driven overlay makes mandalas and kaleidoscope cells."
     )
    (:eng "The audit lens is 'overlaid stars share a center and a box, so a burst stays centered' — drift means two stars had different radii." :math "A pencil of star polygons through one center, parameterized by point count, all inscribed in the radius-r circle." :cs "A parameter sweep composed by overlay — one knob generating a family, then z-stacking the family into a composite glyph."))
)

(verb
  :name "img/ellipse" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/ellipse w h mode color) -> {image}"
  :summary "Build an image value holding an ellipse of width w and height h, filled or outlined, in the given color."
  :explanation "img/ellipse is the stretched circle. Where img/circle has one radius and is perfectly round, an ellipse has two independent extents — a horizontal width w and a vertical height h — and fills the oval that fits snugly in that w×h box. When w equals h you get a circle (up to rounding); when they differ you get an egg, a lens, a puddle, a planet's ring seen at an angle, a cartoon eye. It returns an image value exactly w wide by h tall, and the oval touches all four edges of that box at its midpoints. Reach for it when roundness is not uniform: soft blobs, clouds, eyes, shadows, and any organic shape that a hard rectangle or a perfect circle would make too stiff. Because it is a value, it composes — two ellipses above each other make a cloud, a wide flat one under a sprite makes a drop shadow."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (img/ellipse 40 20 'solid 'blue))" :note "A wide blue ellipse, 40 across and 20 tall; its width comes back as exactly 40, the horizontal extent you set.")
    (:dialect "motoi" :tier "intermediate" :code "(define eye (overlay (img/circle 3 'solid 'black) (img/ellipse 20 12 'solid 'white)))\n(list 'width (image-width eye) 'height (image-height eye))" :note "A round black pupil overlaid on a white ellipse makes an almond eye; the ellipse sets the 20×12 footprint.")
    (:dialect "motoi" :tier "expert" :code "(define (shadow-under sprite)\n  (above sprite (img/ellipse (image-width sprite) 6 'solid 8)))\n(image? (shadow-under (img/circle 10 'solid 'red)))" :note "Compute a drop shadow as a flat ellipse the same width as the sprite above it; the shadow's width is read from the sprite, so they always match.")
  )
  :caveats ("w and h are independent — passing them equal gives a circle, but the general case is an oval, so do not assume roundness." "The oval touches its box edges only at the four midpoints; the corners of the w×h box are empty, like a circle's corners." "'outline draws the elliptical rim only; the interior stays clear so overlays show through." "For a perfect circle prefer img/circle, which guarantees the 2r+1 symmetric box; an ellipse with w=h may round to a slightly lopsided disc.")
  :drawbacks ("On a chunky raster the curved sides stair-step, and a very flat ellipse (h much smaller than w) can look like a lens with jagged tips." "No rotation from this verb — a tilted ellipse (an oval on a diagonal) needs rotate applied afterward, enlarging the box." "There is no way to set the two radii from the center directly; you think in width and height, not semi-axes, which can trip up a math-minded caller.")
  :usecases ("Eyes, especially almond or half-closed eyes, overlaid with a pupil." "Clouds, puddles, blobs, and soft organic shapes." "Drop shadows — a flat ellipse under a sprite." "Planet rings, lenses, and any circle seen in perspective.")
  :related ("img/circle" "img/rectangle" "img/regular-polygon" "img/square")
  :learn (:concept "An ellipse image as a circle with two independent extents, the oval that a circle specializes when width equals height." :prerequisites ("img/circle" "img/rectangle") :progression "Start from img/circle's single radius; free the two extents with img/ellipse; overlay a pupil for an eye; then use a flat ellipse as a shadow sized from another sprite.")
  :row-2-audit (
    (:problem "An animator is adding a drop shadow under a bouncing sprite and wants the shadow to always be as wide as the sprite but flat, so it reads as a shadow on the ground rather than a second body. Hardcoding a shadow width kept mismatching when the sprite changed size."
     :program "(define (with-shadow sprite)\n  (above sprite (img/ellipse (image-width sprite) 6 'solid 8)))\n(let ((s (with-shadow (img/circle 12 'solid 'red))))\n  (list 'is-image (image? s) 'width (image-width s)))"
     :eng-program "(define (grounded sprite shadow-h)\n  (let ((shadow (img/ellipse (image-width sprite) shadow-h 'solid 8)))\n    (if (= (image-width shadow) (image-width sprite))\n        (above sprite shadow)\n        (error 'shadow-width-mismatch))))\n(image? (grounded (img/square 20 'solid 'red) 5))"
     :math-program "(define (shadow-flat? w h) (< h w))\n(define (shadow-for sprite h)\n  (let ((sw (image-width sprite)))\n    (list 'sprite-w sw 'shadow-w (image-width (img/ellipse sw h 'solid 8)) 'flat (shadow-flat? sw h))))\n(shadow-for (img/circle 12 'solid 'red) 6)"
     :cs-program "(define (safe-shadow sprite h)\n  (if (and (image? sprite) (> h 0))\n      (img/ellipse (image-width sprite) h 'solid 8)\n      (error 'bad-shadow)))\n(image-width (safe-shadow (img/circle 12 'solid 'red) 6))"
     :explanation "eng: assert the shadow width equals the sprite width before stacking. math: verify the shadow is flat (height < width) and width-matched. cs: guard the sprite is an image and the height is positive."
     :meta "img/circle would force a round shadow as wide as it is tall — too fat to read as a ground shadow. img/rectangle gives a hard-edged bar, not a soft blob. img/square is even more rigid. img/ellipse is the one primitive that takes an independent width (matched to the sprite) and a small independent height (to flatten it), which is exactly the flat-oval a shadow needs."
     )
    (:eng "The audit lens is 'shadow width = sprite width and shadow height < shadow width' — the smoke test compares the two widths and checks flatness; a mismatch means the shadow will look detached." :math "The shadow is an ellipse with semi-axes (sprite-width/2, small); flatness is the ratio h/w ≪ 1." :cs "A derived sprite whose one dimension is read from another — a dependency that keeps two images in sync by construction."))
  :row-3-dimension (
    (:setup "A circle stretched by two possibly-different scale factors — one shape governed by two independent radii."
     :rungs (
       (:domain "image"   :code "(list (image-width (img/ellipse 40 20 'solid 'blue)) (image-height (img/ellipse 40 20 'solid 'blue)))")
       (:domain "orbit"   :code "(define (orbit-point theta a b) (list (* a (cos theta)) (* b (sin theta))))\n(map (lambda (t) (orbit-point t 40 20)) '(0 1.57 3.14))")
       (:domain "quadratic" :code "(define (on-ellipse? x y a b) (<= (+ (/ (* x x) (* a a)) (/ (* y y) (* b b))) 1))\n(map (lambda (p) (on-ellipse? (car p) (cadr p) 20 10)) '((0 0) (20 0) (0 10) (15 8)))"))
     :explanation "Rung 1: img/ellipse draws the oval with horizontal extent 40 and vertical extent 20. Rung 2: a planet's elliptical orbit is traced by (a·cosθ, b·sinθ) with two semi-axes a and b. Rung 3: the ellipse's defining inequality x²/a² + y²/b² ≤ 1 keeps exactly the points inside the oval. All three share one shape — a circle scaled independently along two axes, so one shape carries two radii."
     :meta "The transfer works because an ellipse is the AFFINE STRETCH of a circle: take the unit disc and scale x by a and y by b. Wherever a round thing is squashed by different amounts on two axes — an orbit, a viewport with non-square pixels, a Gaussian with unequal variances — it is this same anisotropic scaling of a circle. Grounds in book-of-math as the affine-image-of-a-circle / anisotropic-scaling shape.")
     (:eng "Every stretched-round object shares one smoke test: it degenerates to a circle when the two axes are equal, so setting a = b must recover a symmetric disc." :math "The ellipse is the image of the unit circle under the diagonal map diag(a, b); its equation is x²/a² + y²/b² = 1." :cs "An anisotropically-scaled circle — the same shape as a 2D Gaussian with a diagonal covariance or a circle under non-uniform pixel aspect."))
  :row-4-proof (
    (:claim "An ellipse image reports back exactly the width and height it was built with, independently, and mode does not change the footprint; when w = h the box is square."
     :program "(define (check w h)\n  (let ((e (img/ellipse w h 'solid 'blue)))\n    (and (= (image-width e) w)\n         (= (image-height e) h))))\n(display (check 40 20)) (newline)\n(display (check 20 40)) (newline)\n(display (check 30 30)) (newline)\n(display (check 50 6))"
     :eng-program "(define (audit-ellipse pairs)\n  (map (lambda (p)\n         (let ((e (img/ellipse (car p) (cadr p) 'solid 4)))\n           (list 'asked p 'got (list (image-width e) (image-height e)))))\n       pairs))\n(audit-ellipse '((40 20) (20 40) (30 30)))"
     :math-program "(define (square-when-equal? s)\n  (let ((e (img/ellipse s s 'solid 2)))\n    (= (image-width e) (image-height e))))\n(list (square-when-equal? 20) (square-when-equal? 30))"
     :cs-program "(define (contract-ellipse? w h)\n  (let ((solid (img/ellipse w h 'solid 3))\n        (hollow (img/ellipse w h 'outline 3)))\n    (and (image? solid) (= (image-width solid) w) (= (image-height solid) h)\n         (= (image-width solid) (image-width hollow)))))\n(contract-ellipse? 40 20)"
     :invariant "∀ w > 0, h > 0. image-width(img/ellipse(w, h, m, c)) = w ∧ image-height(...) = h"
     :meta "The pattern is the same independence contract as the rectangle — the ellipse inscribes in its w×h box and touches all four edges, so the box (and thus the reported extents) equals the requested pair regardless of mode. Falsified if the two extents were coupled or if the oval failed to fill its box; that would mean an ellipse could not be sized to match a sprite (Row 2's shadow) reliably."
     )
    (:eng "The consequence is that an ellipse can be sized to match another image's width exactly, which is what makes width-matched shadows and lenses possible." :math "The ellipse is inscribed in the w×h rectangle and tangent to it at four midpoints, so its bounding box is exactly that rectangle." :cs "A constructor sharing the rectangle's orthogonal-extent contract, with a rounded rather than boxy fill."))
  :row-5-emergence (
    (:base "img/ellipse alone is one oval inscribed in a w×h box."
     :composition "(define (cloud)\n  (above (img/ellipse 24 12 'solid 'white)\n         (beside (img/ellipse 20 16 'solid 'white)\n                 (img/ellipse 24 16 'solid 'white))))\n(list 'is-image (image? (cloud)) 'width (image-width (cloud)))"
     :eng-composition "(define (puff-cloud widths base-h)\n  (apply beside (map (lambda (w) (img/ellipse w base-h 'solid 'white)) widths)))\n(image-width (puff-cloud '(16 24 20 14) 14))"
     :math-composition "(define ws '(16 24 20))\n(define predicted (apply + ws))\n(define built (image-width (apply beside (map (lambda (w) (img/ellipse w 14 'solid 'white)) ws))))\n(list 'predicted predicted 'built built 'agree (= predicted built))"
     :cs-composition "(define (blob-row widths)\n  (fold (lambda (w acc) (beside acc (img/ellipse w 12 'solid 'white)))\n        (empty-scene 1 1)\n        widths))\n(image? (blob-row '(14 20 16 22 12)))"
     :emergent "A cloud — several overlapping ovals of varied widths clustered together — which generalizes to any soft lumpy silhouette: foam, smoke, foliage, a sheep's fleece; the ellipse's roundness-with-two-radii is the atom of organic shapes."
     :meta "This is the organic-silhouette family: soft natural forms are clusters of overlapping ellipses, because an ellipse alone is already the 'round but not rigid' atom. Beside-folding ellipses of varied width sums their boxes (the math rung proves the total width) while their curved tops merge into a lumpy edge. The same clustering makes bushes, sheep, and smoke puffs."
     )
    (:eng "The audit lens is 'a beside-row of ellipses has width equal to the sum of their widths' — a shortfall means two puffs overlapped instead of abutting in the box model." :math "A union of overlapping ellipses; the bounding box is the sum of widths under beside, the max of heights per row." :cs "A fold of soft atoms under a layout combinator — the organic counterpart to tiling hard squares."))
)

(verb
  :name "img/regular-polygon" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/regular-polygon r n mode color) -> {image}"
  :summary "Build an image value holding a regular n-sided polygon with circumradius r, filled or outlined, in the given color."
  :explanation "img/regular-polygon draws the convex n-gon: n equal sides and n equal angles, its vertices sitting evenly on a circle of radius r (the circumradius). Pass the circumradius, the side count n, a mode, and a color. n=3 is an equilateral triangle, n=4 a diamond, n=5 a pentagon, n=6 a hexagon, and as n grows the polygon smooths toward the circle it is inscribed in. It returns an image value on a square 2r+1 canvas — the box of the circumscribing circle — because every vertex reaches exactly r from the center. This is the convex cousin of img/star-poly: same equal-angle vertex schedule, but the vertices connect directly instead of alternating in to inner points, so there are no notches. Reach for it for hexagonal tiles, stop-sign octagons, pentagonal panels, gems, dice faces, and anything with clean rotational symmetry."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (img/regular-polygon 20 6 'solid 'magenta))" :note "A solid magenta hexagon with circumradius 20; the box is 41 pixels square, matching the circle of radius 20 that carries its vertices.")
    (:dialect "motoi" :tier "intermediate" :code "(define stop (img/regular-polygon 18 8 'solid 'red))\n(list 'sides 8 'width (image-width stop) 'is-image (image? stop))" :note "An eight-sided regular polygon is a stop-sign octagon; the vertex count is the only thing separating it from a hexagon or a pentagon.")
    (:dialect "motoi" :tier "expert" :code "(define (n-gon-ladder r counts)\n  (map (lambda (n) (list n (image-width (img/regular-polygon r n 'outline 3)))) counts))\n(n-gon-ladder 15 '(3 4 5 6 8 12))" :note "Sweep the side count at a fixed circumradius; the width stays 31 for every polygon because the circumradius alone fixes the box.")
  )
  :caveats ("r is the CIRCUMRADIUS (center to vertex), not the apothem (center to edge-midpoint), so the polygon's flat-to-flat width is smaller than 2r." "n must be at least 3; a two-sided polygon is degenerate." "As n grows the polygon approaches its circumscribing circle, so at high n on a small radius it is visually indistinguishable from img/circle." "The starting vertex angle is fixed internally, so a polygon may sit point-up or flat-side-up depending on n; use rotate to reorient.")
  :drawbacks ("Only regular (equilateral, equiangular) polygons are expressible; an irregular or star polygon needs a different primitive." "The circumradius convention means matching a polygon's flat width to a neighbor requires converting apothem to circumradius by hand." "On a chunky raster the edges of a high-n polygon stair-step just like a circle, so past a point adding sides buys no visible smoothness.")
  :usecases ("Hexagonal map tiles for strategy games and honeycombs." "Stop-sign octagons, pentagon panels, and traffic-sign silhouettes." "Gems, dice faces, and crystal shapes with clean symmetry." "The base outline of a wheel, gear blank, or bolt head before detail is overlaid.")
  :related ("img/star-poly" "img/triangle" "img/circle" "img/square")
  :learn (:concept "A regular convex n-gon image inscribed in a circle of radius r, the notch-free convex counterpart to img/star-poly." :prerequisites ("img/circle" "img/star-poly") :progression "Confirm an n-gon's 2r+1 box; sweep n to watch it approach a circle; overlay two for a gem; then tile hexagons into a honeycomb.")
  :row-2-audit (
    (:problem "A board-game maker is building a hex-grid map and needs every hexagon the same size with a predictable bounding box so tiles line up in a grid. Sizing hexagons by their flat-to-flat width kept fighting the circumradius the constructor actually uses."
     :program "(define hex (img/regular-polygon 20 6 'solid 'green))\n(list 'circumradius 20 'box-width (image-width hex) 'expected (+ (* 2 20) 1))"
     :eng-program "(define (hex-tile r color)\n  (let ((h (img/regular-polygon r 6 'solid color)))\n    (if (= (image-width h) (+ (* 2 r) 1)) h (error 'hex-box-unexpected))))\n(image? (hex-tile 20 'green))"
     :math-program "(define (circumradius->box r) (+ (* 2 r) 1))\n(define (apothem r n) (* r (cos (/ 3.14159 n))))\n(list 'box (circumradius->box 20) 'flat-half (apothem 20 6))"
     :cs-program "(define (safe-ngon r n)\n  (if (and (> r 0) (integer? n) (>= n 3))\n      (image-width (img/regular-polygon r n 'solid 'green))\n      (error 'bad-ngon (list r n))))\n(safe-ngon 20 6)"
     :explanation "eng: assert the hexagon's box equals 2r+1 before trusting it in the grid. math: relate the circumradius box to the apothem (flat half-width) so the maker can convert. cs: guard that n ≥ 3 and r is positive."
     :meta "img/star-poly with six points gives a notched Star-of-David silhouette, not a solid tile — it will not tessellate. img/circle leaves round gaps at a hex grid's seams. img/square is the wrong symmetry for a hex map. img/regular-polygon at n=6 is the one primitive that draws the convex hexagon a hex grid is built from, sized by the circumradius the grid math expects."
     )
    (:eng "The audit lens is 'box width = 2·circumradius+1 for every tile' — the smoke test multiplies out, and any deviation means a tile was sized by apothem or edge length by mistake." :math "Vertices lie on the circumscribing circle of radius r, so the box is 2r+1; the flat width is 2r·cos(π/n), smaller than the box." :cs "A fixed-footprint tile parameterized by circumradius — the size convention a hex-grid layout engine must agree on."))
  :row-3-dimension (
    (:setup "n points equally spaced on a circle, connected in order into a closed convex boundary."
     :rungs (
       (:domain "image"    :code "(image-width (img/regular-polygon 20 6 'solid 'magenta))")
       (:domain "dial"     :code "(define (marks n) (map (lambda (k) (* k (/ 360 n))) (iota n)))\n(marks 6)")
       (:domain "roots"    :code "(define (vertex k n r) (list (* r (cos (* 2 3.14159 (/ k n)))) (* r (sin (* 2 3.14159 (/ k n))))))\n(map (lambda (k) (vertex k 6 20)) (iota 6))"))
     :explanation "Rung 1: img/regular-polygon connects n vertices on the radius-r circle into a convex n-gon. Rung 2: a dial's marks sit at 360/n around the face, the same equal partition. Rung 3: the vertices are r·(cos 2πk/n, sin 2πk/n) — the n-th roots of unity scaled by r. All three share one shape — n points at equal angular steps on a circle, connected or marked in order."
     :meta "The transfer works because a regular polygon IS the convex hull of the n-th roots of unity, scaled by r. This is the same angular-partition schedule as a star (img/star-poly) and a clock, but with the vertices joined directly rather than alternating inward. Any n-fold symmetric convex form — a nut, a gem facet ring, a radial gauge — is this shape. Grounds in book-of-math as the cyclic-group / regular-polygon-from-roots-of-unity shape.")
     (:eng "Every n-fold convex figure shares one smoke test: n equal sides and n equal angles; measuring any two sides or two angles and finding them unequal means it is not regular." :math "The n vertices are r·exp(2πik/n) for k=0..n−1; the polygon is their convex hull, with interior angle (n−2)·180/n." :cs "The convex hull of scaled roots of unity — the same vertex set behind n-gon meshing and radial UI layouts."))
  :row-4-proof (
    (:claim "A regular n-gon's bounding box is 2r+1 square for every side count, because all n vertices lie on the circle of radius r; mode does not change it."
     :program "(define (check r n)\n  (let ((p (img/regular-polygon r n 'solid 'magenta)))\n    (and (= (image-width p) (+ (* 2 r) 1))\n         (= (image-width p) (image-height p)))))\n(display (check 20 3)) (newline)\n(display (check 20 6)) (newline)\n(display (check 20 8)) (newline)\n(display (check 15 5))"
     :eng-program "(define (audit-ngon r counts)\n  (map (lambda (n)\n         (let ((p (img/regular-polygon r n 'solid 4)))\n           (list 'n n 'w (image-width p) 'box-ok (= (image-width p) (+ (* 2 r) 1)))))\n       counts))\n(audit-ngon 20 '(3 4 5 6 8))"
     :math-program "(define (box-fixed? r counts)\n  (apply = (map (lambda (n) (image-width (img/regular-polygon r n 'solid 2))) counts)))\n(list (box-fixed? 20 '(3 6 8)) (box-fixed? 15 '(4 5 12)))"
     :cs-program "(define (contract-ngon? r n)\n  (let ((p (img/regular-polygon r n 'solid 3)))\n    (and (image? p)\n         (= (image-width p) (+ (* 2 r) 1))\n         (= (image-width p) (image-height p)))))\n(contract-ngon? 20 6)"
     :invariant "∀ r > 0, n ≥ 3. image-width(img/regular-polygon(r, n, m, c)) = 2r+1 = image-height(...)"
     :meta "The pattern matches img/star-poly exactly: the CIRCUMRADIUS fixes the box, the side count only reshapes the interior boundary. Falsified if adding a side changed the width — that would mean a vertex left the radius-r circle, contradicting the definition of the circumradius and breaking any grid that reserves a 2r+1 slot per polygon."
     )
    (:eng "The consequence is that a pentagon and a hexagon of the same circumradius drop into the same tile slot, so a map can mix polygon types without relayout." :math "Every vertex is at distance r from center, so the tightest enclosing box is the circumscribing circle's box, 2r+1, for all n." :cs "A footprint fixed by one extremal parameter — the circumradius — independent of the vertex count."))
  :row-5-emergence (
    (:base "img/regular-polygon alone is one convex n-gon inscribed in a radius-r circle."
     :composition "(define (gem)\n  (overlay (img/regular-polygon 8 6 'solid 'white)\n           (overlay (img/regular-polygon 14 6 'solid 'cyan)\n                    (img/regular-polygon 18 6 'outline 'white))))\n(list 'is-image (image? (gem)) 'width (image-width (gem)))"
     :eng-composition "(define (honeycomb-row n r)\n  (fold (lambda (i acc) (beside acc (img/regular-polygon r 6 'outline 'yellow)))\n        (img/regular-polygon r 6 'outline 'yellow)\n        (iota (- n 1))))\n(image-width (honeycomb-row 5 12))"
     :math-composition "(define (row-width n r) (* n (+ (* 2 r) 1)))\n(define built (image-width (fold (lambda (i acc) (beside acc (img/regular-polygon 12 6 'outline 'yellow))) (img/regular-polygon 12 6 'outline 'yellow) (iota 4))))\n(list 'predicted (row-width 5 12) 'built built 'agree (= (row-width 5 12) built))"
     :cs-composition "(define (shape-ladder r counts)\n  (fold (lambda (n acc) (beside acc (img/regular-polygon r n 'solid 6)))\n        (empty-scene 1 1)\n        counts))\n(image? (shape-ladder 12 '(3 4 5 6 8)))"
     :emergent "A faceted gem — concentric hexagons in graded colors registering on one center — and a honeycomb row of hexagons; the same convex n-gon nests into a jewel or tiles into a comb depending on whether it is overlaid or repeated."
     :meta "This is the concentric / tessellation family, the convex twin of the star's emblem family. Overlaying same-n polygons of graded radius on one center makes a faceted gem (the 2r+1 box guarantees registration, Row 4); repeating one polygon under beside makes a strip whose width is the exact sum of boxes. Hexagons specifically tessellate the plane, so the honeycomb generalizes to a full offset hex grid."
     )
    (:eng "The audit lens is 'nested polygons share a center; tiled polygons sum their boxes' — a gem whose facets drift means the overlay centers disagreed." :math "Concentric hulls of scaled roots of unity (a gem) versus a linear beside-tiling (a comb); registration by shared box, extent by summed boxes." :cs "One convex atom composed two ways — z-stacked into a facet stack or list-tiled into a grid row — the polygon analog of the star's two uses."))
)

(verb
  :name "img/line" :std "Motoi"
  :library "image"
  :kind "meta"
  :signature "(img/line len color) -> {image}"
  :summary "Build an image value holding a horizontal line of length len, one pixel tall, in the given color."
  :explanation "img/line is the thinnest primitive in the library: a single horizontal stroke. You give it a length len and a color — there is no mode, because a one-pixel line has no interior to fill, so it is neither solid nor outline, just the stroke itself. It returns an image value exactly len pixels wide and 1 pixel tall. It is the atom of anything ruled: an underline beneath a label, a divider between sections, the staff lines of sheet music, the ground line of a scene, a wireframe edge, a progress track before a fill sits on it, the axis of a tiny chart. Because it is a value one pixel high, stacking it with above at intervals rules a grid, and setting it beneath a shape with above draws a baseline. For a thicker rule use img/rectangle with height 1-plus; img/line is specifically the hairline."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(list (image-width (img/line 40 'white)) (image-height (img/line 40 'white)))" :note "A 40-pixel white line; its width is 40 and its height is exactly 1 — a line has no thickness.")
    (:dialect "motoi" :tier "intermediate" :code "(define (underline width) (img/line width 12))\n(list 'rule-width (image-width (underline 60)) 'rule-height (image-height (underline 60)))" :note "An underline is just a line sized to the width of whatever it sits beneath; here a 60-wide rule one pixel tall.")
    (:dialect "motoi" :tier "expert" :code "(define (ruled-lines n width gap)\n  (fold (lambda (i acc) (above acc (above (img/rectangle width gap 'solid 0) (img/line width 'white))))\n        (img/line width 'white)\n        (iota n)))\n(image? (ruled-lines 4 60 3))" :note "Stack lines separated by transparent-black spacer bands to rule a sheet of notebook paper or a music staff.")
  )
  :caveats ("There is no mode argument — a one-pixel line has no interior, so passing 'solid or 'outline is neither needed nor accepted; the signature is (img/line len color)." "The line is always horizontal and always exactly 1 pixel tall; for a vertical line rotate it 90°, and for a thick rule use img/rectangle." "Height is invariably 1 regardless of len, so a line's footprint is len×1 — do not expect any vertical extent." "A length of 1 is a single dot; very short lines read as points, not strokes.")
  :drawbacks ("Only horizontal — a diagonal or vertical line requires rotate, which enlarges the bounding box and may anti-alias the stroke on a chunky raster." "One pixel tall means it can disappear against a busy background or at small display scales; a visible divider often needs img/rectangle with a height of two or three." "No dashes, no caps, no thickness options — it is the plainest possible stroke, so styled rules must be composed by hand.")
  :usecases ("Underlines beneath labels and headings." "Dividers and separators between UI sections or list rows." "The staff lines of sheet music and the rules of notebook paper." "The ground line, horizon, or baseline of a scene, and the axis of a small chart.")
  :related ("img/rectangle" "img/square" "img/circle" "img/triangle")
  :learn (:concept "A one-pixel horizontal line image sized by length, the hairline atom of rules, dividers, and baselines." :prerequisites ("img/rectangle" "image-height") :progression "Confirm a line is len×1; use one as an underline sized to a label; stack several with above to rule a grid or a staff; rotate one for a vertical divider.")
  :row-2-audit (
    (:problem "A UI maker is putting an underline beneath text labels of varying widths and wants each underline to be exactly as wide as its label — no shorter, no wider. Fixed-width underlines kept over- or under-running the different labels."
     :program "(define (underlined label-w)\n  (above (img/rectangle label-w 10 'solid 8)\n         (img/line label-w 'white)))\n(let ((u (underlined 48)))\n  (list 'is-image (image? u) 'width (image-width u)))"
     :eng-program "(define (rule-for element)\n  (let ((line (img/line (image-width element) 'white)))\n    (if (= (image-width line) (image-width element))\n        (above element line)\n        (error 'rule-width-mismatch))))\n(image? (rule-for (img/rectangle 48 10 'solid 8)))"
     :math-program "(define (rule-len w) (image-width (img/line w 'white)))\n(define (exact? w) (= (rule-len w) w))\n(list 'w48 (exact? 48) 'w120 (exact? 120))"
     :cs-program "(define (safe-line len)\n  (if (and (integer? len) (> len 0))\n      (img/line len 'white)\n      (error 'bad-line len)))\n(image-width (safe-line 48))"
     :explanation "eng: size the line from the element's own width and assert they match before stacking. math: verify the line length equals the requested width exactly. cs: guard the length is a positive integer."
     :meta "img/rectangle with height 1 could also draw the rule, but it forces a redundant second dimension for a shape that has no thickness. img/square is inherently two-dimensional and cannot be one pixel tall without also being one pixel wide. img/circle and the pointed shapes are the wrong silhouette. img/line is the one primitive whose single length argument IS the underline, with the height fixed at 1 by definition."
     )
    (:eng "The audit lens is 'line length = label width' — the smoke test compares the two widths; a mismatch means the underline will over- or under-run the text it belongs to." :math "The line is the degenerate rectangle of height 1; its length is the sole free extent and equals the requested width." :cs "A derived hairline sized from another element's width — a one-dimensional dependency keeping the rule in sync."))
  :row-3-dimension (
    (:setup "A one-dimensional extent — a pure length with no breadth, the degenerate limit of a rectangle as its height goes to one."
     :rungs (
       (:domain "image"    :code "(image-width (img/line 40 'white))")
       (:domain "timeline" :code "(define (span start end) (- end start))\n(define (mark-at t start scale) (* (- t start) scale))\n(list 'span (span 0 40) 'mark (mark-at 10 0 2))")
       (:domain "interval" :code "(define (length-of a b) (abs (- b a)))\n(define (contains? a b x) (and (>= x a) (<= x b)))\n(list 'len (length-of 0 40) 'in (contains? 0 40 25))"))
     :explanation "Rung 1: img/line is a stroke whose only dimension is its length. Rung 2: a timeline is a one-dimensional axis where a span is an end minus a start and marks sit at scaled offsets. Rung 3: an interval [a,b] on the number line has length |b−a| and a membership test. All three share one shape — a one-dimensional extent measured by a single length, with position along it the only coordinate."
     :meta "The transfer works because a line is the ONE-DIMENSIONAL object: a segment of the real line, carrying only length and position. Anything that is fundamentally an axis — a timeline, a ruler, a progress track, a number-line interval — is this same 1D extent. It is the base case of the dimension ladder (line → rectangle → box). Grounds in book-of-math as the interval / 1-dimensional-measure shape.")
     (:eng "Every one-dimensional extent shares one smoke test: it has exactly one meaningful measure (length) and one coordinate (position); a 'line' reporting a second extent is not one-dimensional." :math "A line segment is an interval [0, len] of measure len; its only invariant is length and its only coordinate is arc position." :cs "A 1D range — the same shape as a timeline, a scrollbar track, or a segment in interval arithmetic."))
  :row-4-proof (
    (:claim "A line's height is always exactly 1 regardless of length, and its width equals the requested length — it is the height-1 degenerate rectangle."
     :program "(define (check len)\n  (let ((l (img/line len 'white)))\n    (and (= (image-width l) len)\n         (= (image-height l) 1))))\n(display (check 10)) (newline)\n(display (check 40) ) (newline)\n(display (check 1)) (newline)\n(display (check 200))"
     :eng-program "(define (audit-lines lens)\n  (map (lambda (len)\n         (let ((l (img/line len 'white)))\n           (list 'len len 'w (image-width l) 'h (image-height l) 'thin (= (image-height l) 1))))\n       lens))\n(audit-lines '(1 10 40 200))"
     :math-program "(define (height-invariant? lens)\n  (apply = (cons 1 (map (lambda (len) (image-height (img/line len 'white))) lens))))\n(height-invariant? '(5 40 100 250))"
     :cs-program "(define (contract-line? len)\n  (let ((l (img/line len 3)))\n    (and (image? l) (= (image-width l) len) (= (image-height l) 1))))\n(contract-line? 40)"
     :invariant "∀ len > 0. image-width(img/line(len, c)) = len ∧ image-height(img/line(len, c)) = 1"
     :meta "The pattern is a collapsed dimension: one extent is free (length) and the other is pinned to the constant 1, which is exactly what makes a line one-dimensional. Falsified if any length produced a height other than 1 — that would mean the line has thickness and is really a rectangle, dissolving the distinction between img/line and img/rectangle."
     )
    (:eng "The consequence is that a divider's footprint is len×1 for certain, so a layout can budget exactly one row of pixels for every rule." :math "The line is the interval [0, len] embedded as a 1-tall strip; height is the constant 1, width the variable len." :cs "A constructor with one variable and one constant dimension — the degenerate rectangle that defines the one-dimensional case."))
  :row-5-emergence (
    (:base "img/line alone is one horizontal hairline of a chosen length."
     :composition "(define (staff)\n  (fold (lambda (i acc)\n          (above acc (above (img/rectangle 60 4 'solid 0) (img/line 60 'white))))\n        (img/line 60 'white)\n        (iota 4)))\n(list 'is-image (image? (staff)) 'height (image-height (staff)))"
     :eng-composition "(define (grid-lines rows width gap)\n  (fold (lambda (i acc) (above acc (above (img/rectangle width gap 'solid 0) (img/line width 'white))))\n        (img/line width 'white)\n        (iota rows)))\n(image? (grid-lines 5 80 6))"
     :math-composition "(define rows 4)\n(define gap 4)\n(define built (image-height (fold (lambda (i acc) (above acc (above (img/rectangle 60 gap 'solid 0) (img/line 60 'white)))) (img/line 60 'white) (iota rows))))\n(define predicted (+ 1 (* rows (+ gap 1))))\n(list 'predicted predicted 'built built 'agree (= predicted built))"
     :cs-composition "(define (rule-sheet n width)\n  (fold (lambda (i acc) (above acc (above (img/rectangle width 5 'solid 0) (img/line width 'white))))\n        (empty-scene width 1)\n        (iota n)))\n(image? (rule-sheet 6 80))"
     :emergent "A ruled sheet — evenly spaced hairlines separated by transparent gaps — which is at once notebook paper, a music staff, a table grid's horizontal rules, and the gridlines of a chart; one hairline repeated on a schedule becomes any ruled surface."
     :meta "This is the ruling / periodic-structure family: a ruled surface is a hairline convolved with a regular spacing, built by folding line-plus-gap units under above. Because each line is exactly 1 tall and each gap a known height, the total height is a closed form (the math rung proves it: 1 + rows·(gap+1)). The same periodic fold makes ledger lines, seismograph traces, and the horizontal scanlines of a CRT effect."
     )
    (:eng "The audit lens is 'total height = 1 + rows · (gap + 1)' — a mismatch means a line or a gap was the wrong height, throwing off the ruling's regularity." :math "A one-dimensional stroke stacked at a fixed period; the composite is a periodic function of position, its height the sum of the period over the rows." :cs "A fold of a hairline-plus-spacer unit under above — the periodic-tiling pattern behind grids, staves, and scanline effects."))
)
