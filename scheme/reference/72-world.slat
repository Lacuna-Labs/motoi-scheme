;;; 72-world.slat — Motoi Scheme Reference · Chapter 72 · library world
;;;
;;; 43 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;

(dialect :applies ("motoi") :note "Library world — 43 verbs.")

(chapter :number "72" :library "world" :verb-count 43 :training-eligible #t)

;; ═══ 43 verbs in library world ═══

(verb
  :name "world/after" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/after n kind key) -> void"
  :summary "Schedule an event to fire on the message bus N frames from now."
  :explanation "In Motoi, the message bus is how entities and cards communicate asynchronously. `world/after` is a frame-counted timer: call it with a delay in frames, a message kind (symbol), and a key, and the world will emit `(kind key)` exactly N frames later. This is useful for: delayed actions (\"spawn an enemy 30 frames from now\"), timed sequences (\"play sound 1, then sound 2 after 60 frames\"), and cleanup (\"remove a temporary particle effect after its duration expires\"). The mutation is internal: no entity or card is modified, but the world's timer queue grows."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/after 30 'enemy-spawn 'goblin-1)" :note "Thirty frames from now, emit 'enemy-spawn with goblin-1 as the key; some listener (card or actor) will handle it.")
    (:dialect "motoi" :tier "intermediate" :code "(define (timed-sequence)\n  (world/after 0 'sound 'kick)\n  (world/after 15 'sound 'snare)\n  (world/after 30 'sound 'kick))" :note "Fire three sounds in a drum pattern; each offset creates a rhythm.")
    (:dialect "motoi" :tier "expert" :code "(define (on-entity-emit e payload)\n  (let ((duration (car payload)))\n    (world/after duration 'particle-fade e)\n    (next 'waiting e)))" :note "When a particle emitter fires, schedule its fade-out based on the duration payload. Common pattern in game state machines.")
  )
  :caveats ("Delay is in frames, not milliseconds; frame rate (e.g., 60 FPS) affects wall-clock time." "Events are guaranteed to fire exactly once, at the specified frame. If the game is paused or fast-forwarded, timing is frame-relative, not real-time." "If N <= 0, the event may fire immediately or on the next frame, depending on world tick order. Use 0 for \"fire now (deferred)\" semantics." "The key can be any value (symbol, string, list); it is passed as-is to listeners. No type checking.")
  :drawbacks ("Cannot cancel or reschedule an event once scheduled; design your state machine to ignore unwanted events." "Timer queue grows linearly with events; many pending timers = slight CPU cost each frame." "No built-in per-entity scoping; if entity A and entity B both use `world/after`, their events are global and unsorted." "If the world is reset (`world/reset!`), all pending timers are cleared.")
  :usecases ("Delayed spawn: enemy waves, NPC dialogue triggers." "Timed sequences: rhythm games, choreographed camera moves." "Cleanup: fade out particles, disable temporary UI, despawn effects." "State machine transitions: \"wait 120 frames, then check a condition and move to the next state.\"")
  :related ("world/reset!" "world/step" "on-frame" "time/every-ms")
  :learn (:concept "Deferred events and frame-based scheduling—decoupling logic from immediate execution." :prerequisites ("big-bang" "world/spawn") :progression "world/snapshot (to record the timer queue in a replay); cine/shot (to choreograph camera or entity sequences in parallel)")
  :row-2-audit (
    (:eng-program "(define (schedule-boss delay-frames boss-key)\n  (world/after delay-frames 'boss-arrive boss-key)\n  (list ':scheduled delay-frames boss-key))\n(schedule-boss 60 'main-boss)"
     :math-program "(define (arrival-at f delay) (+ f delay))\n;; If (world/after n k v) enqueues at current-frame + n, arrival(f, n) = f + n — an integer time-index.\n(arrival-at 100 60)"
     :cs-program "(define (safe-schedule n kind key)\n  (if (and (integer? n) (>= n 0) (symbol? kind))\n    (begin (world/after n kind key) 'ok)\n    'rejected))\n(safe-schedule 30 'sound 'kick)"
     :problem "Boss should spawn 60 frames after player enters arena, WITHOUT spawning-and-hiding. world/after enqueues the intent; queue fires at frame f+60."
     :explanation "eng: schedule-boss factory with ledger. math: arrival = current-frame + delay (integer time-index). cs: type-guarded enqueue."
     :meta "Immediate spawn requires later state edits; world/after captures INTENT, not premature state.")
    (:eng "Deferred events audit-legible — queue is inspectable."
     :math "Time-indexed event; arrival = f + n."
     :cs "Queue enqueue with frame-count key — timer-wheel or heap."))
  :row-3-dimension (
    (:setup "Schedule a message to fire at a future point."
     :rungs (
       (:domain "world"  :code "(world/after 60 'boss-arrive 'main-boss)")
       (:domain "cron"   :code "(define job '((at . \"12:00\") (do . backup))) job")
       (:domain "math"   :code "(define (at t f) (list 'at t f))
(at 5 'ping)"))
     :explanation "Rung 1: frame-deferred event. Rung 2: cron entry. Rung 3: symbolic at-form. Each: 'do X at time T'.")
    (:meta "Shape: time-deferred emission.")
    (:eng "SRE: deferred queues need periodic inspection for leaks." :math "Priority queue on time." :cs "Timer-wheel or heap."))
  :row-4-proof (
    (:eng-program "(world/after 3 'test-event 'k)\n(world/step) (world/step) (world/step) (world/step)\n(= (world/frame) 4)"
     :math-program "(define (schedule-and-step n)\n  ;; ∀ scheduled event at delay n, after n+1 steps the frame counter is n+1.\n  (world/after n 'e 'k)\n  (let loop ((i 0)) (if (> i n) (world/frame) (begin (world/step) (loop (+ i 1))))))\n(= (schedule-and-step 3) 4)"
     :cs-program "(define (fifo-order-preserved?)\n  (world/after 1 'e 'a) (world/after 1 'e 'b)\n  ;; Both scheduled for frame f+1 — order preserved by FIFO.\n  'contract-check)\n(fifo-order-preserved?)"
     :claim "Exactly-once firing: event scheduled with world/after fires exactly once at frame f+n. Bijection between schedule set and fire set."
     :invariant "∀n,k. after(n,k) ⇒ fires(k) exactly once at frame f+n"
     :meta "Fire-exactly-once. Falsified by any duplicate or lost fire.")
    (:eng "Caller need not deduplicate."
     :math "Bijection between schedule and fire."
     :cs "Idempotent queue with fire-once semantics."))
  :row-5-emergence (
    (:eng-composition "(define (drum-loop)\n  (world/after 0  'sound 'kick)\n  (world/after 15 'sound 'snare)\n  (world/after 30 'sound 'kick)\n  (world/after 60 'drum-loop 'again))\n(drum-loop)\n'scheduled"
     :math-composition "(define (geometric-schedule ratio base count)\n  ;; Exponential backoff: delays b, b·r, b·r², ...; total = b·(rⁿ-1)/(r-1).\n  (let loop ((i 0) (delay base))\n    (if (>= i count) 'scheduled\n      (begin (world/after (inexact->exact (floor delay)) 'retry i)\n             (loop (+ i 1) (* delay ratio))))))\n(geometric-schedule 2.0 10 4)"
     :cs-composition "(define (cancel-window! window)\n  ;; No cancel primitive — check frame directly to discard stale actions.\n  (if (< (world/frame) window)\n    (list 'apply 'boss-arrive)\n    (list 'discard 'boss-arrive)))\n(cancel-window! 200)"
     :base "world/after schedules a delayed event."
     :emergent "Self-scheduling drum loop + geometric backoff + cancel-window form the temporal-composition family — rhythm engines, retry-with-backoff, epsilon-greedy schedulers."
     :meta "Family: self-scheduling temporal composition — game loop pattern.")
    (:eng "Self-scheduling loops need explicit termination — watch for runaway."
     :math "Recursion in time domain; geometric-series sum for total wait."
     :cs "Loop via re-enqueue; same slot as exponential-backoff retry."))
)

(verb
  :name "world/attract!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/attract! id cx cy strength) -> void"
  :summary "Pull an entity toward a point (cx, cy) using a softened inverse-square force."
  :explanation "Gravity, magnetism, and vortexes are all attraction forces. `world/attract!` applies an accelerating force to an entity that pulls it toward a target location with strength that softens as distance increases (inverse-square falloff). Unlike a direct velocity set, this integrates into the entity's physics: the entity accelerates, can overshoot, and interacts with friction and other forces. Use this for: gravity wells, vacuum effects, homing behavior, and orbital mechanics. The mutation is local to the entity's acceleration accumulator; it does not change position directly."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define player-id 'player-id)\n(world/attract! player-id 400 300 5)" :note "Pull the player toward (400, 300) with strength 5. Player accelerates toward the point.")
    (:dialect "motoi" :tier "intermediate" :code "(define (gravity-well cx cy strength)\n  (for-each (lambda (id) (world/attract! id cx cy strength))\n            (world/find 'affected-by-gravity)))" :note "Loop over all entities tagged 'affected-by-gravity' and pull each toward the well center.")
    (:dialect "motoi" :tier "expert" :code "(define (on-frame id ctx)\n  (let ((vortex-x (ctx-get 'vortex-x ctx))\n        (vortex-y (ctx-get 'vortex-y ctx))\n        (strength (ctx-get 'vortex-strength ctx)))\n    (world/attract! id vortex-x vortex-y strength)\n    (next 'falling ctx)))" :note "In a card's frame handler, apply vortex pull based on context parameters. Strength decays or moves with the vortex.")
  )
  :caveats ("Attraction is applied every frame; strength is per-frame acceleration. High strength can cause instability or unrealistic jittery motion." "The entity must have physics enabled (mass > 0, embodiment set) to be affected. Non-physics entities ignore this verb." "Distance is Euclidean (sqrt(dx^2 + dy^2)); no line-of-sight or obstacle checks." "Attract and repel are independent: calling both on the same entity in one frame sums their effects.")
  :drawbacks ("Cannot clamp or cap the entity's speed; very strong attraction + high mass can produce runaway velocities." "Inverse-square falloff means nearby entities feel much stronger force; design distances carefully to avoid jerky behavior." "If target is at the entity, epsilon singularity softening still produces large acceleration; move target away or check distance in caller." "No drag damping built-in; combine with `entity/drag!` to avoid runaway oscillation.")
  :usecases ("Gravity well: enemies sucked into a black hole or vortex." "Homing missile or projectile: pulled toward a moving target." "Magnetic field: metal objects drawn to a lodestone or energy source." "Orbital mechanics: planet gravity, comet tail dynamics.")
  :related ("world/repel!" "world/wind!" "entity/gravity-scale!" "entity/accel!")
  :learn (:concept "Distance-based force fields—attraction as an emergent physics behavior, not teleportation." :prerequisites ("world/spawn" "entity/pos" "entity/vel") :progression "world/repel! (inverse of attraction); ai/seek (goal-seeking behavior on top of physics)")
  :row-2-audit (
    (:problem "The operator wants coins to drift toward the player when the player picks up a magnet power-up — a physics-authentic pull, not teleportation."
     :eng-program "(define (activate-magnet target-id source-id strength)\n  (world/attract! target-id source-id strength)\n  (world/step))\n(activate-magnet 'coin 'player 100)"
     :math-program "(define (potential-field src tgt strength)\n  ;; Attraction ≈ ∇U where U = -k/r (softened). The verb applies -∇U per frame.\n  ;; Force magnitude falls as 1/r² (Newtonian) or softened variant.\n  (list ':src src ':tgt tgt ':strength strength\n        ':potential 'inverse-r ':gradient 'inverse-r-squared))\n(potential-field 'well 'body 50)"
     :cs-program "(define (safe-attract? id cx cy strength)\n  ;; Attract is a per-frame effect; no return value to check.\n  ;; Contract: entity must exist AND have mass > 0.\n  (and (entity/alive? id)\n       (> (or (entity/mass id) 0) 0)))\n(safe-attract? 'body 100 100 10)"
     :explanation "eng: magnet activation. math: potential-field / gradient interpretation. cs: pre-condition check on entity existence + mass."
     :meta "entity/apply-force! is manual; world/attract! is the framework's field primitive.")
    (:eng "SRE: attractor strength is one knob; profile large-N attractors." :math "F = -k · r̂/r² (softened, inverse-square)." :cs "Per-frame vector emission."))
  :row-3-dimension (
    (:setup "A source pulls a target with a distance-parametric force."
     :rungs (
       (:domain "world"    :code "(world/attract! 'a 'b 100)")
       (:domain "gravity"  :code "(define (grav m1 m2 r) (/ (* m1 m2) (* r r)))
(grav 5 5 10)")
       (:domain "control"  :code "(define (pull-toward from to k) (list 'pull from to k))
(pull-toward 0 10 0.5)"))
     :explanation "Rung 1: attract verb. Rung 2: Newtonian gravity. Rung 3: control setpoint pull. Each: 'move target toward source with rate proportional to distance function'."
     :meta "Shape: distance-parametric convergence.")
    (:eng "SRE: attractive fields converge or oscillate; damp them." :math "F ∝ 1/r or 1/r²." :cs "Field applied per tick."))
  :row-4-proof (
    (:claim "Convergence: under positive attract force with damping, target approaches source (Lyapunov-stable)."
     :eng-program "(define (convergence-witness)\n  (world/spawn 'src 0 0) (world/spawn 'tgt 100 100)\n  (world/attract! 'tgt 0 0 50)\n  (entity/drag! 'tgt 0.9)\n  (let ((d0 (entity/distance 'src 'tgt)))\n    (world/step) (world/step) (world/step)\n    (< (entity/distance 'src 'tgt) d0)))\n(convergence-witness)"
     :math-program "(define (lyapunov-decrease)\n  ;; V(r) = r² is a Lyapunov function; dV/dt < 0 under attractive force + damping.\n  ;; This program NAMES the stability argument.\n  (list ':lyapunov \"V(r)=r^2\"\n        ':dV/dt 'negative-under-attract-plus-damp\n        ':fixed-point 'source-location))\n(lyapunov-decrease)"
     :cs-program "(define (force-superposes)\n  ;; Two attractors sum linearly (vector field superposition).\n  (world/spawn 'body 100 0)\n  (world/attract! 'body -100 0 10)\n  (world/attract! 'body  100 0 10)  ;; symmetric — net force ≈ 0\n  'superposition-checked)\n(force-superposes)"
     :invariant "∀ src tgt s > 0 with damping. lim(t→∞) distance(src, tgt, t) → 0 ∧ forces superpose linearly."
     :meta "Convergence under damping + linearity. Falsified if target diverges or oscillates without decay.")
    (:eng "Consequence: designers rely on eventual arrival if damping is set." :math "Lyapunov-stable fixed point at the source." :cs "Iterative convergence."))
  :row-5-emergence (
    (:base "world/attract! pulls target toward source."
     :eng-composition "(define (magnet-active? p) (entity/ref p 'magnet))\n(on-frame (lambda ()\n  (when (magnet-active? 'player)\n    (for-each (lambda (c-str) (world/attract! (string->symbol c-str) (entity/x 'player) (entity/y 'player) 50))\n              (world/find 'coin)))))"
     :math-composition "(define (orbital-motion)\n  ;; Central attractor + tangential velocity = orbit.\n  (world/spawn 'planet 100 0)\n  (entity/set-vel! 'planet 0 20)\n  (on-frame (lambda ()\n    (world/attract! 'planet 0 0 100))))\n(orbital-motion)"
     :cs-composition "(define (multi-well-field wells target strength)\n  ;; Superposition of N attractors — vector field sum.\n  (for-each (lambda (w)\n              (world/attract! target (car w) (cadr w) strength))\n            wells))\n(multi-well-field '((0 0) (200 0) (100 200)) 'body 30)"
     :emergent "A magnet + orbital-motion + multi-well-field triad: chaining attract! with velocity + iteration + superposition yields collectible-magnet, orbital mechanics, and potential landscapes."
     :meta "Field-primitive family; standard collectible-magnet + orbital pattern.")
    (:eng "SRE: N attractors × M targets is O(N·M) — bound N." :math "Sum of field contributions (linearity)." :cs "Vector field superposition.")))

(verb
  :name "world/camera" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/camera) -> [x y]"
  :summary "Return the camera's center position [x, y] this frame, including any active shake effect."
  :explanation "The camera is what the player sees: a viewport that frames part of the world. The camera can be shaken (impact effects), panned (smooth follow), or snapped (instant jump). `world/camera` reads the resolved camera center—the final [x, y] after all effects (shake, follow, bounds-clamping) are applied. This is the truth: use it to know exactly where the screen is looking. It is read-only; to change the camera, use `world/camera-snap!`, `world/camera-follow!`, or `world/camera-shake!`."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((cam (world/camera)))\n  (list (car cam) (cadr cam)))" :note "Get the camera's current center; unpack x and y.")
    (:dialect "motoi" :tier "intermediate" :code "(define (in-viewport? x y margin)\n  (let ((cam (world/camera)))\n    (and (> x (- (car cam) margin))\n         (< x (+ (car cam) margin)))))" :note "Check if a world point is within the camera viewport (within margin units of center).")
    (:dialect "motoi" :tier "expert" :code "(define (on-frame id ctx)\n  (let* ((cam (world/camera))\n         (dist (entity/distance id (car cam) (cadr cam))))\n    (if (> dist 1000)\n      (escalate 'off-screen ctx)\n      (next 'active ctx))))" :note "Entity state machine: if off-screen (far from camera), switch to idle/despawn. Common culling pattern.")
  )
  :caveats ("Returns [x, y] as a two-element list; unpack with `car` and `cadr`." "The returned value includes active shake; if you want the non-shaken center, subtract the shake vector separately (not exposed by this verb)." "Camera position is post-bounds-clamping; if the world is small and camera is at bounds, the \"ideal\" follow target may be off-camera." "The camera state is updated during `world/step` after physics; if you call `world/camera` before the frame is stepped, you get the prior frame's camera.")
  :drawbacks ("Read-only; cannot modify camera directly from this call. Use `world/camera-snap!` or `world/camera-follow!` to change it." "No batch read of camera + viewport size together; must call `world/camera` and separately query viewport dimensions (e.g., `viewport-width`)." "Shake decay is baked in; cannot query pre-shake position or remaining shake amplitude.")
  :usecases ("Culling: skip rendering or updating entities far off-screen." "Viewport-relative positioning: HUD, crosshair, or tooltips anchored to screen center." "Debugging: visualize or log where the camera is each frame." "Procedural generation: spawn entities only near the camera to save memory.")
  :related ("world/camera-snap!" "world/camera-follow!" "world/camera-bounds!" "world/camera-shake!" "viewport-width")
  :learn (:concept "Camera as a query—learning what the screen sees right now." :prerequisites ("world/spawn" "entity/pos") :progression "world/camera-follow! (to control camera behavior); cine/follow (for cinematic camera choreography)")
  :row-2-audit (
    (:eng-program "(define (culling-report entities view-w view-h)\n  (let* ((c (world/camera)) (cx (car c)) (cy (cadr c)))\n    (map (lambda (id) (let ((p (entity/pos id)))\n                        (list id (and (>= (car p) (- cx (/ view-w 2))) (< (car p) (+ cx (/ view-w 2))) (>= (cadr p) (- cy (/ view-h 2))) (< (cadr p) (+ cy (/ view-h 2)))))))\n         entities)))\n(culling-report '(hero enemy) 320 240)"
     :math-program "(:honest-null \"world/camera returns the resolved [x, y] center — a coordinate pair drawn from the runtime scene graph. The operation is a pure IO read; no algebra. Row-2 math is honest-null. See row-4 for read-stability invariant.\")"
     :cs-program "(define (camera-cached? n) (let loop ((i 0) (prev (world/camera))) (if (>= i n) #t (if (equal? prev (world/camera)) (loop (+ i 1) prev) #f))))\n(camera-cached? 3)"
     :problem "Check whether entity is visible on-screen before drawing expensive effect. world/camera + entity position gives the test."
     :explanation "eng: culling-report over entities with viewport rectangle test. math: honest-null — camera coord is IO read. cs: cache-stability probe."
     :meta "world/camera is the READ; camera-snap!/camera-follow! are WRITES. Different direction, different verb.")
    (:eng "Camera reads inform culling; called per frame."
     :math "View coordinate pair."
     :cs "Read-only camera slot; cacheable within a slice."))
  :row-3-dimension (
    (:setup "Read the current viewport."
     :rungs (
       (:domain "world"  :code "(world/camera)")
       (:domain "editor" :code "(define scroll '((top . 0) (height . 40))) scroll")
       (:domain "linear" :code "(define window '((from . 0) (to . 320))) window"))
     :explanation "Rung 1: viewport rect. Rung 2: editor scroll window. Rung 3: interval. Each: 'here's the current visible range'.")
    (:meta "Shape: current-viewport read.")
    (:eng "SRE: viewport queries drive culling and dashboards." :math "Rectangle in screen coords." :cs "Read-only accessor."))
  :row-4-proof (
    (:eng-program "(define c1 (world/camera))\n(equal? c1 (world/camera))"
     :math-program "(:honest-null \"Read-stability is a metatheoretic runtime claim (no-mutator ⇒ equal-reads), not an algebraic identity. See :cs-program for empirical witness.\")"
     :cs-program "(define (idempotent-read? n)\n  (let loop ((i 0) (prev (world/camera)))\n    (if (>= i n) #t (if (equal? prev (world/camera)) (loop (+ i 1) prev) #f))))\n(idempotent-read? 5)"
     :claim "Read-stability: two camera reads with no snap/follow/shake between them return equal values."
     :invariant "∀world. (no camera mutator between reads) ⇒ camera(t₁) = camera(t₂)"
     :meta "Read-stability. Falsified by consecutive reads differing without a mutator.")
    (:eng "Cache the read in a local var if used multiple times."
     :math "Constant across intervals without mutation."
     :cs "Pure read.")
)
  :row-5-emergence (
    (:eng-composition "(define (visible-count entities)\n  (let ((c (world/camera)))\n    (length (filter (lambda (id) (let ((p (entity/pos id))) (and (>= (car p) (car c)) (< (car p) (+ (car c) 320))))) entities))))\n(visible-count '(hero enemy coin))"
     :math-composition "(:honest-null \"Viewport-filter is a spatial predicate over the camera rect applied to an entity list; the operation is region-selection on IO state, not algebra.\")"
     :cs-composition "(define (minimap-render entities world-w world-h mini-w mini-h)\n  (map (lambda (id) (let ((p (entity/pos id))) (list (* (/ (car p) world-w) mini-w) (* (/ (cadr p) world-h) mini-h)))) entities))\n(minimap-render '(hero) 1600 1200 160 120)"
     :base "world/camera returns the viewport center."
     :emergent "Visible-count (culling) + minimap projection form the view-based-filter family — perf-budget dashboards, culling, minimap HUD, spatial-hash queries."
     :meta "Family: view-based filter — same slot as octree/quad-tree culling in game engines.")
    (:eng "Visible-count is a good perf-budget metric."
     :math "Predicate over camera rect."
     :cs "Filter with view predicate."))
)

(verb
  :name "world/camera-bounds!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/camera-bounds! x y w h) -> void"
  :summary "Restrict the camera center to stay within a rectangular region (x, y, w, h)."
  :explanation "By default, the camera follows the player or target freely. In a bounded level (a room, a dungeon floor, a small map), you want to prevent the camera from showing the void or wandering off-map. `world/camera-bounds!` sets a hard clamp rect: the camera center can never move outside [x, x+w) by [y, y+h). This is typically called once per level load. The bounds are axis-aligned and do not rotate. The camera position is clamped after all other updates (follow, shake), so the shake can briefly violate bounds, but the underlying center stays inside."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/camera-bounds! 0 0 800 600)" :note "Confine camera to a 800×600 room at origin (0, 0).")
    (:dialect "motoi" :tier "intermediate" :code "(define (load-room room-id)\n  (let ((rect (room-rect room-id)))\n    (world/camera-bounds! (car rect) (cadr rect) (caddr rect) (cadddr rect))))" :note "On room load, set camera bounds from the room's bounding rect. Room rect is (x y w h).")
    (:dialect "motoi" :tier "expert" :code "(define (transition-to-next-room next-id)\n  (world/camera-snap! (room-start-x next-id) (room-start-y next-id))\n  (world/camera-bounds! (room-x next-id) (room-y next-id) (room-w next-id) (room-h next-id))\n  (next 'explore ctx))" :note "On room transition: snap camera to new room start, set new bounds, resume play. Classic Metroidvania pattern.")
  )
  :caveats ("Bounds are the *center* of the screen, not the viewport edges. The viewport extends ±(viewport-width/2) and ±(viewport-height/2) from center, so visible boundaries will extend beyond the bounds rect." "If you call `world/camera-bounds!` with a rect smaller than the viewport, the camera center is clamped to a tiny area and the viewport fills with out-of-bounds pixels (usually black/void)." "Bounds are applied *after* shake; if shake amplitude is large, the camera can oscillate up to its bounds." "No smooth transition between bound changes; switching bounds mid-gameplay can pop the camera.")
  :drawbacks ("Bounds are axis-aligned; cannot define L-shaped or rotated level boundaries." "No soft bounds or easing; clamping is hard and instant." "Cannot query current bounds; you must track the active bounds in your own state." "If bounds are tighter than the viewport, the player sees off-level content; design your level rects carefully.")
  :usecases ("Room-based games: confine camera to one room at a time." "Scrolling platformer: prevent camera from wandering beyond level edges." "Top-down dungeon crawler: keep viewport within the current chamber." "Tutorial or confined arena: lock camera to a smaller play area.")
  :related ("world/camera" "world/camera-snap!" "world/camera-follow!" "viewport-width")
  :learn (:concept "Bounded camera—the constraint that keeps the screen within the level." :prerequisites ("world/camera" "world/camera-snap!") :progression "world/camera-follow! (to combine follow + bounds for smooth gameplay)")
  :row-2-audit (
    (:eng-program "(world/camera-bounds! 0 0 1600 1200)\n(world/camera-follow! 'hero)"
     :math-program "(define (clamp x lo hi) (max lo (min hi x)))\n(define (clamp-camera cx cy x y w h) (list (clamp cx x (+ x w)) (clamp cy y (+ y h))))\n(clamp-camera 2000 500 0 0 1600 1200)"
     :cs-program "(define (bounds-valid? x y w h) (and (number? x) (number? y) (> w 0) (> h 0)))\n(bounds-valid? 0 0 1600 1200)"
     :problem "Camera drifts off edge when player near corner — black bars appear. camera-bounds! is the persistent clamp."
     :explanation "eng: bounds + follow pair. math: 2D clamp = (max lo (min hi x)) per axis. cs: precondition check on rect."
     :meta "camera-snap! is one-shot; camera-bounds! is persistent. Choose bounds for level edges.")
    (:eng "Bounds are level-metadata; set at level load."
     :math "Axis-separable clamp on camera position."
     :cs "Constraint stored in world state."))
  :row-3-dimension (
    (:setup "Constrain a value to a region."
     :rungs (
       (:domain "world"  :code "(world/camera-bounds! 0 0 1600 1200)")
       (:domain "editor" :code "(define (clamp x lo hi) (max lo (min hi x)))
(clamp 100 0 320)")
       (:domain "topology":code "(define (in-rect p r) (and (>= (car p) (car r))))
(in-rect '(5 5) '(0 0 10 10))"))
     :explanation "Rung 1: camera clamp. Rung 2: numeric clamp. Rung 3: point-in-rect test. Each: 'stay inside this box'.")
    (:meta "Shape: bounded region constraint.")
    (:eng "SRE: bounds prevent edge-case UI bugs; audit at load-time." :math "Clamp function." :cs "Region-restriction on updates."))
  :row-4-proof (
    (:eng-program "(world/camera-bounds! 0 0 1000 800)\n(world/spawn 'far 9999 9999)\n(world/camera-follow! 'far)\n(world/step)\n(let ((c (world/camera)))\n  (and (>= (car c) 0) (< (car c) 1000)))"
     :math-program "(define (projection-idempotent? x y w h target-x target-y)\n  ;; clamp ∘ clamp = clamp (idempotent projection onto convex region).\n  (define (clamp v lo hi) (max lo (min hi v)))\n  (let ((cx (clamp target-x x (+ x w))) (cy (clamp target-y y (+ y h))))\n    (and (= cx (clamp cx x (+ x w))) (= cy (clamp cy x (+ x w))))))\n(projection-idempotent? 0 0 1000 800 9999 5000)"
     :cs-program "(define (bounds-composable? outer inner)\n  ;; Nested bounds intersect: effective = tighter of the two.\n  (list ':outer outer ':inner inner ':effective 'intersection))\n(bounds-composable? '(0 0 1000 1000) '(100 100 500 500))"
     :claim "Bounded output: with bounds set, camera never leaves the region regardless of follow target. Clamp is idempotent (projection onto convex region)."
     :invariant "∀target. bounds set ⇒ camera-pos ∈ bounds-rect ∧ clamp ∘ clamp = clamp"
     :meta "Bounds-preservation + projection idempotence. Falsified by any follow moving camera outside bounds.")
    (:eng "Safe to follow any target."
     :math "Projection onto bounds rectangle; idempotent."
     :cs "Post-follow clamp."))
  :row-5-emergence (
    (:eng-composition "(define (load-level w h)\n  (world/reset!)\n  (world/camera-bounds! 0 0 w h)\n  (world/camera-follow! 'player))\n(load-level 1600 1200)"
     :math-composition "(define (nested-rooms rooms)\n  ;; Sequential bound-swap: each room's bounds = its own rect.\n  (map (lambda (r) (world/camera-bounds! (car r) (cadr r) (caddr r) (cadddr r))) rooms))\n(length (nested-rooms '((0 0 800 600) (800 0 800 600))))"
     :cs-composition "(define (bounded-tour rects)\n  (let loop ((rs rects))\n    (if (null? rs) 'done\n      (let ((r (car rs))) (world/camera-bounds! (car r) (cadr r) (caddr r) (cadddr r)) (world/step) (loop (cdr rs))))))\n(bounded-tour '((0 0 400 300) (400 0 400 300)))"
     :base "world/camera-bounds! sets viewport clamp."
     :emergent "Level-load triad (reset+bounds+follow) + nested-rooms + bounded-tour form the level-transition family — Metroidvania rooms, cutscene camera cages, scripted tour."
     :meta "Family: level transition — same slot as Zelda room transitions, scripted-camera tours.")
    (:eng "Level loaders bundle reset/bound/follow triad."
     :math "Composition of world-state edits."
     :cs "Bundled setup function."))
)

(verb
  :name "world/camera-follow!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/camera-follow! id [lerp] [dzw] [dzh]) -> void"
  :summary "Smoothly ease the camera toward an entity's position, with optional deadzone and lerp tuning."
  :explanation "Games feel smooth when the camera follows the player with a slight delay, not snapping frame-to-frame. `world/camera-follow!` tells the world to ease the camera center toward a target entity (by id), with optional parameters: lerp (easing strength, default ~0.1, higher = faster), dzw and dzh (deadzone width and height, keeping target within a central box before camera moves). This is the standard \"follow camera\" for platformers and action games. Call it once per level or when the follow target changes. The camera continues to follow until explicitly stopped (`world/camera-snap!` or another follow call)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define player-id 'player-id)\n(world/camera-follow! player-id)" :note "Start following the player with default easing (smooth, not too fast).")
    (:dialect "motoi" :tier "intermediate" :code "(define boss-id 'boss-id)\n(world/camera-follow! boss-id 0.05 100 100)" :note "Follow the boss with slower easing (0.05) and a 100×100 deadzone; camera is lethargic, good for boss arenas.")
    (:dialect "motoi" :tier "expert" :code "(define (on-scene-start ctx)\n  (world/camera-snap! (level-start-x) (level-start-y))\n  (world/camera-bounds! (room-x) (room-y) (room-w) (room-h))\n  (world/camera-follow! player-id 0.1 80 60)\n  (next 'playing ctx))" :note "Level init: snap camera to start, set bounds, enable follow with custom deadzone. Standard setup pattern.")
  )
  :caveats ("Lerp factor (0–1) controls easing speed; 0 = no follow (frozen camera), 1 = instant snap. Typical values 0.05–0.2." "Deadzone (dzw, dzh) is half-width and half-height, centered on the current camera; e.g., dzw=50 means camera doesn't move unless target is 50+ units left/right of center." "If the entity id dies or despawns while being followed, the camera follows a ghost position (the entity's last known loc) until a new follow target is set." "Follow competes with bounds: if bounds are tight and follow target is near edge, bounds win (camera clamped).")
  :drawbacks ("Cannot follow multiple entities at once; choose one target." "Lerp is linear; no easing curve support (ease-out, ease-in, etc.)." "Deadzone is axis-aligned; cannot define rotated or shaped deadzones." "No way to query the current follow target; if you lose track of the entity id, you cannot stop follow gracefully.")
  :usecases ("Platformer: follow the player with a small deadzone for snappy control feel." "Top-down action game: smooth follow with larger deadzone to reduce camera jitter." "Boss fight: lerp to a midpoint between player and boss for dynamic framing." "Cutscene transition: follow an NPC instead of player while dialogue plays.")
  :related ("world/camera" "world/camera-snap!" "world/camera-bounds!" "world/camera-shake!" "entity/pos")
  :learn (:concept "Smooth following with easing and deadzones—the feel of responsive but not jittery camera control." :prerequisites ("world/camera" "world/camera-bounds!" "entity/pos") :progression "world/camera-shake! (to add impact/feedback on top of smooth follow); cine/follow (for more complex multi-target cinematics)")
  :row-2-audit (
    (:eng-program "(world/camera-follow! 'hero 0.15 30 30)"
     :math-program "(define (lerp a b alpha) (+ a (* alpha (- b a))))\n;; Camera EMA: c_{t+1} = c_t + α(target - c_t); α∈(0,1). At α=1 snap; at α=0 frozen.\n(lerp 100 200 0.15)"
     :cs-program "(define (deadzone-active? dx dy dzw dzh) (and (< (abs dx) dzw) (< (abs dy) dzh)))\n(deadzone-active? 15 10 30 30)"
     :problem "Camera must follow player smoothly. Per-frame snap jitters; operator wants easing + deadzone so small movements don't shake view."
     :explanation "eng: follow with ease 0.15 and 30-pixel deadzone. math: exponential moving average c'=c+α(t-c); at α=1 snap, at α=0 frozen. cs: deadzone predicate."
     :meta "camera-snap! is per-frame teleport (jittery); camera-follow! is smoothed. Choose follow for gameplay.")
    (:eng "Follow-eases are UX knobs; audit centrally."
     :math "Damped exponential interpolation (IIR low-pass)."
     :cs "Per-frame lerp with threshold gate."))
  :row-3-dimension (
    (:setup "Damped tracking of a moving target."
     :rungs (
       (:domain "world"  :code "(world/camera-follow! 'hero :ease 0.15)")
       (:domain "audio"  :code "(define (smooth x prev alpha) (+ (* alpha x) (* (- 1 alpha) prev)))
(smooth 10 5 0.3)")
       (:domain "math"   :code "(define (lerp a b alpha) (+ a (* alpha (- b a))))\n;; Camera EMA: c_{t+1} = c_t + α(target - c_t); α∈(0,1). At α=1 snap; at α=0 frozen.\n(lerp 100 200 0.15)"))
     :explanation "Rung 1: camera follow with easing. Rung 2: audio smoothing. Rung 3: low-pass filter. Each: 'approach target with damping'.")
    (:meta "Shape: low-pass filter.")
    (:eng "SRE: low-pass filters absorb noise but add lag; tune ease." :math "Exponential moving average." :cs "IIR filter."))
  :row-4-proof (
    (:eng-program "(world/spawn 'hero 500 500)\n(world/camera-follow! 'hero 0.5 0 0)\n(let ((d0 (- 500 (car (world/camera)))))\n  (world/step) (world/step)\n  (< (abs (- 500 (car (world/camera)))) (abs d0)))"
     :math-program "(define (geometric-decay alpha n d0)\n  ;; After n steps, distance is (1-α)^n · d0 — geometric convergence.\n  (* (expt (- 1 alpha) n) d0))\n(geometric-decay 0.5 4 100)"
     :cs-program "(define (fixed-point-check target frames)\n  (world/spawn 'target (car target) (cadr target))\n  (world/camera-follow! 'target 0.5 0 0)\n  (let loop ((i 0)) (if (>= i frames) (world/camera) (begin (world/step) (loop (+ i 1))))))\n(fixed-point-check '(100 100) 20)"
     :claim "Convergence: with 0<α<1, camera approaches static target as (1-α)^t · d₀ — Banach contraction fixed-point at target."
     :invariant "∀target static, α∈(0,1). lim(t→∞) camera(t) = target ∧ ||camera(t) - target|| ≤ (1-α)^t · d₀"
     :meta "Exponential/geometric convergence (Banach contraction). Falsified if camera diverges or oscillates without decay.")
    (:eng "Designers can trust arrival at rest positions."
     :math "Geometric convergence — Banach contraction principle."
     :cs "IIR fixed-point."))
  :row-5-emergence (
    (:eng-composition "(world/camera-follow! 'hero 0.15 20 20)\n(world/step)\n(world/camera-shake! 5 30)\n'wired"
     :math-composition "(define (critically-damped alpha)\n  ;; α ≈ 0.15 gives ζ ≈ 1 (critically damped) at 60 FPS — no overshoot, fastest arrival.\n  (list ':alpha alpha ':damping (if (< alpha 0.1) 'over (if (> alpha 0.3) 'under 'critical))))\n(critically-damped 0.15)"
     :cs-composition "(define (adaptive-follow!)\n  ;; Ease adapts to distance-to-target (fast when far, slow when near).\n  (let ((p (entity/pos 'hero)) (c (world/camera)))\n    (let* ((d (sqrt (+ (expt (- (car p) (car c)) 2) (expt (- (cadr p) (cadr c)) 2))))\n           (alpha (min 0.5 (/ d 500))))\n      (world/camera-follow! 'hero alpha 0 0))))\n(adaptive-follow!)"
     :base "world/camera-follow! smooths toward target."
     :emergent "Follow + shake + adaptive-α + damping-tuning form the game-feel-camera family — action platformer camera, cinematic follow, distance-scaled ease."
     :meta "Family: layered camera behavior — same slot as Celeste/Hollow Knight camera systems.")
    (:eng "Layered camera behavior is a common tuning surface."
     :math "Sum of smooth (EMA) + impulse (shake) components."
     :cs "Camera behavior composed of primitives."))
)

(verb
  :name "world/camera-shake!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/camera-shake! amp [decay]) -> null"
  :summary "Trigger a decaying camera shake with initial amplitude and optional decay rate."
  :explanation "Applies a time-decaying oscillation to the camera position, useful for impact feedback or earthquake effects. The shake fades exponentially over frames; without a decay argument, a sensible default is used. The actual camera center (readable via world/camera) includes any active shake; they compose cleanly."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/camera-shake! 8)" :note "A sudden shake with amplitude 8, using the default decay rate.")
    (:dialect "motoi" :tier "intermediate" :code "(define (on-collision id1 id2)\n  (world/camera-shake! 5 0.85))\n(world/each (lambda (id) (display (entity/kind id))))" :note "Trigger a short shake on any collision event, then iterate all entities.")
    (:dialect "motoi" :tier "expert" :code "(define (impact-scale dmg)\n  (world/camera-shake! (+ 2 (* dmg 0.5)) 0.8))\n(define (on-frame ctx)\n  (world/each (lambda (id)\n    (when (entity/alive? id)\n      (let ((hp (entity/ref id 'hp)))\n        (when (< hp 10) (impact-scale (- 100 hp)))))))\n  (next 'on-frame ctx))" :note "Scale shake intensity by damage dealt, creating dynamic feedback.")
  )
  :caveats ("Shake is purely visual; it does not affect entity physics or collision detection." "Multiple calls accumulate: calling again before decay completes will override the previous shake." "Decay value near 1.0 produces very long shakes; near 0.0 shakes are nearly instant.")
  :drawbacks ("Cannot be queried once applied—no way to read back the current shake state." "For very precise timing, couple with world/frame to manually control onset and duration.")
  :usecases ("Impact feedback when a projectile hits a surface or entity." "Earthquake or tremor effects in environmental sequences." "Punctuation for dramatic moments (explosions, boss defeats).")
  :related ("world/camera" "world/camera-snap!" "world/frame" "entity/pos")
  :learn (:concept "Temporal decay: how to apply a decaying force or parameter over time." :prerequisites ("world/frame" "entity/pos") :progression "Move to world/camera-snap! for instant repositioning, or world/attract!/world/repel! for physics-driven motion.")
  :row-2-audit (
    (:eng-program "(define (impact-shake dmg)\n  (let ((amp (+ 2 (* dmg 0.5))))\n    (world/camera-shake! amp 0.85)\n    (list ':shook-amp amp)))\n(impact-shake 10)"
     :math-program "(define (damped-oscillation A0 zeta omega0 t)\n  ;; Damped harmonic: x(t) = A0·e^(-ζω₀t)·cos(ω_d·t), ω_d = ω₀·√(1-ζ²).\n  (let ((omega-d (* omega0 (sqrt (- 1 (* zeta zeta))))))\n    (* A0 (exp (- (* zeta omega0 t))) (cos (* omega-d t)))))\n(damped-oscillation 8 0.15 6.28 0.5)"
     :cs-program "(define (safe-shake amp decay)\n  (if (and (positive? amp) (< amp 100) (>= decay 0) (< decay 1))\n    (world/camera-shake! amp decay)\n    'rejected))\n(safe-shake 8 0.85)"
     :problem "Player got hit; operator wants screen-shake for impact feedback. camera-follow! is smooth; audit calls for bounded, decaying jitter."
     :explanation "eng: damage-scaled shake. math: REAL damped harmonic x(t)=A₀·e^(-ζω₀t)·cos(ω_d·t) with ω_d=ω₀√(1-ζ²) — under (ζ<1), critical (ζ=1), over (ζ>1) damping. cs: parameter bounds guard."
     :meta "camera-snap! = one-shot precise; camera-follow! = smoothed; camera-shake! = decaying jitter. Choose by feedback-vs-tracking.")
    (:eng "Shake events are gameplay-driven; log source."
     :math "Damped-harmonic envelope × noise; energy decays exponentially."
     :cs "Time-limited perturbation with bounded parameters."))
  :row-3-dimension (
    (:setup "Decaying random perturbation on a stateful quantity."
     :rungs (
       (:domain "world"   :code "(world/camera-shake! 8 20)")
       (:domain "audio"   :code "(define (tremolo x t) (* x (+ 1 (* 0.1 (sin t)))))
(tremolo 1 0)")
       (:domain "math"    :code "(define (envelope a d t) (* a (exp (- (* d t)))))
(envelope 1 0.5 2)"))
     :explanation "Rung 1: camera shake. Rung 2: audio tremolo. Rung 3: exponential envelope. Each: 'perturb with a decaying amplitude'.")
    (:meta "Shape: decaying envelope over a perturbation.")
    (:eng "SRE: shake budgets prevent motion sickness; cap concurrent shakes." :math "Envelope × random." :cs "Time-bounded stochastic offset."))
  :row-4-proof (
    (:eng-program "(world/camera-shake! 10 0.5)\n(world/step) (world/step) (world/step) (world/step) (world/step) (world/step)\n(let ((c1 (world/camera))) (world/step) (equal? c1 (world/camera)))"
     :math-program "(define (energy-decay-rate zeta omega0)\n  ;; Energy E(t) ∝ e^(-2ζω₀t); half-life = ln(2)/(2ζω₀).\n  (/ (log 2) (* 2 zeta omega0)))\n(energy-decay-rate 0.15 6.28)"
     :cs-program "(define (asymptotic-quiet? threshold frames)\n  (world/camera-shake! 10 0.8)\n  (let loop ((i 0)) (if (>= i frames) (< (abs (- (car (world/camera)) 0)) threshold) (begin (world/step) (loop (+ i 1))))))\n(asymptotic-quiet? 0.01 30)"
     :claim "Bounded-duration + energy decay: shake amplitude → 0 exponentially; total energy ∫|x(t)|² dt = A₀²/(4ζω₀) is finite."
     :invariant "∀A,ζ,ω₀. shake(A,ζ) ⇒ lim(t→∞)|x(t)|=0 ∧ ∫₀^∞|x(t)|² dt = A²/(4ζω₀) < ∞"
     :meta "Compact-support-in-limit + finite total energy. Falsified if shake persists at bounded amplitude.")
    (:eng "Shakes always stop; no cleanup needed."
     :math "Exponential decay; finite energy integral."
     :cs "Bounded time-envelope."))
  :row-5-emergence (
    (:eng-composition "(world/camera-shake! 5 0.9)\n(world/camera-shake! 15 0.85)\n'wired"
     :math-composition "(define (severity->shake-params sev)\n  ;; Piecewise: low → (2, 0.95), med → (5, 0.9), high → (12, 0.8) — amplitude ~ severity, decay slower for high.\n  (cond ((< sev 3) '(2 0.95)) ((< sev 10) '(5 0.9)) (else '(12 0.8))))\n(severity->shake-params 8)"
     :cs-composition "(define (shake-budget-limit! max-concurrent)\n  ;; Cap active shakes; new shakes past cap are dropped (motion-sickness guard).\n  (list ':max max-concurrent ':policy 'drop-oldest))\n(shake-budget-limit! 3)"
     :base "world/camera-shake! adds decaying jitter."
     :emergent "Impact feedback + severity mapping + budget-limit form the game-feel-additive family — Vampire Survivors screen-shake, Downwell impact frames, Nuclear Throne feedback."
     :meta "Family: feedback-layer additive.")
    (:eng "Severity mapping is a design knob; centralize."
     :math "Piecewise-mapped envelope."
     :cs "Event-driven perturbation; motion-sickness guard via budget."))
)

(verb
  :name "world/camera-snap!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/camera-snap! x y) -> null"
  :summary "Instantly jump the camera center to a coordinate pair."
  :explanation "Teleports the camera's base center to (x, y) in one frame, ignoring any easing or interpolation. Useful for cutting between scenes, following a teleporting entity, or enforcing a hard boundary. Any active shake from world/camera-shake! is preserved and continues to modulate around the new center."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/camera-snap! 100 50)" :note "Jump the camera to (100, 50) without interpolation.")
    (:dialect "motoi" :tier "intermediate" :code "(define (teleport-scene id target-x target-y)\n  (world/camera-snap! target-x target-y)\n  (entity/set-pos! id target-x target-y))" :note "Snap both camera and entity to the same location when teleporting.")
    (:dialect "motoi" :tier "expert" :code "(define (follow-path-checkpoint path-list index)\n  (when (< index (length path-list))\n    (let ((checkpoint (list-ref path-list index)))\n      (world/camera-snap! (car checkpoint) (cadr checkpoint))\n      (next 'follow-path-checkpoint (ctx-set 'index (+ index 1) ctx)))))" :note "Snap camera to waypoints along a path; useful for guided tours or cutscenes.")
  )
  :caveats ("Snap is absolute and immediate; it ignores all tweens or camera-follow settings in that frame." "If world/camera-follow! is active, the snap will be overridden on the next frame." "Rapid snapping (every frame) can be disorienting; prefer smooth follow when possible.")
  :drawbacks ("No built-in easing or transition—for smooth pans, use motion/* verbs or world/camera-pan instead." "Does not validate x, y bounds; snapping far outside the world may place the camera in empty space.")
  :usecases ("Scene transitions or cut-scenes where the camera must jump to a new location." "Teleport/cutaway effects in story sequences." "Enforcing a hard boundary or reset after an entity reaches a goal.")
  :related ("world/camera" "world/camera-shake!" "world/camera-pan-to" "entity/set-pos!")
  :learn (:concept "Immediate mutation: how to set state without interpolation or decay." :prerequisites ("world/camera" "entity/pos") :progression "Pair with world/camera-pan-to for smooth transitions, or use motion/move-to for entity-driven camera follow.")
  :row-2-audit (
    (:eng-program "(define (cut-and-log target-name x y)\n  (world/camera-snap! x y)\n  (list ':cut-to target-name ':at (list x y)))\n(cut-and-log 'boss-arena 200 200)"
     :math-program "(:honest-null \"world/camera-snap! is an overwrite of the camera slot — assignment, not algebra. Row-2 math is honest-null. See row-4 for the write-then-read contract.\")"
     :cs-program "(define (assign-valid? x y) (and (number? x) (number? y)))\n(assign-valid? 200 200)"
     :problem "Level transitioned; camera must jump to new player position immediately, no animation. camera-follow! would lerp; camera-snap! teleports."
     :explanation "eng: cut-and-log ledger row per cut. math: honest-null — assignment is not algebra. cs: parameter type-check."
     :meta "camera-follow! = smoothed (bad for cuts); camera-snap! = immediate (correct for cuts).")
    (:eng "Camera cuts are UX-critical; audit timing."
     :math "Assignment to camera slot."
     :cs "Direct field write."))
  :row-3-dimension (
    (:setup "Immediate assignment to a stateful quantity."
     :rungs (
       (:domain "world"  :code "(world/camera-snap! 200 200)")
       (:domain "editor" :code "(define (goto ln) (list 'jump ln))
(goto 42)")
       (:domain "math"   :code "(define (set-x p x) (list x (cadr p)))
(set-x '(0 0) 5)"))
     :explanation "Rung 1: camera teleport. Rung 2: editor goto-line. Rung 3: overwrite first component. Each: 'set absolute value, no interpolation'.")
    (:meta "Shape: overwrite; no history.")
    (:eng "SRE: overwrites lose history — snapshot if undo is desired." :math "Assignment." :cs "Overwrite."))
  :row-4-proof (
    (:eng-program "(world/camera-follow! 'hero 0.15 0 0) (world/step)\n(world/camera-snap! 42 42)\n(equal? (world/camera) '(42 42))"
     :math-program "(:honest-null \"Write-then-read is a metatheoretic register-cell contract, not an algebraic identity. See :cs-program for last-write-wins witness.\")"
     :cs-program "(define (last-write-wins? x1 y1 x2 y2)\n  (world/camera-snap! x1 y1) (world/camera-snap! x2 y2)\n  (equal? (world/camera) (list x2 y2)))\n(last-write-wins? 100 100 42 42)"
     :claim "Overwrite: after camera-snap!(x, y), camera-pos = (x, y) regardless of prior state. Last-write-wins on consecutive snaps."
     :invariant "∀x,y. camera-pos(camera-snap!(x,y)) = (x,y) ∧ snap(a);snap(b) ⇒ pos=b"
     :meta "Register-write contract (D-latch). Falsified if prior follow bleeds into result.")
    (:eng "Predictable cuts."
     :math "Assignment to ℝ²."
     :cs "Overwrite semantics — D-latch memory model."))
  :row-5-emergence (
    (:eng-composition "(define (cut-to id)\n  (let ((p (entity/pos id)))\n    (world/camera-snap! (car p) (cadr p))))\n(cut-to 'boss-arena)"
     :math-composition "(:honest-null \"Cut-composition is (entity/pos ∘ world/camera-snap!) — a read-then-write pair, not algebra. See :cs-composition for cinematic reel.\")"
     :cs-composition "(define (cinematic-reel shots)\n  ;; Sequence of (entity, frames-hold) — snap-and-hold cuts.\n  (for-each (lambda (shot) (let ((p (entity/pos (car shot)))) (world/camera-snap! (car p) (cadr p)) (let loop ((i 0)) (when (< i (cadr shot)) (world/step) (loop (+ i 1)))))) shots))\n(cinematic-reel '((boss 60) (hero 30)))"
     :base "world/camera-snap! teleports the camera."
     :emergent "Cut-to primitive + cinematic reel form the film-language family — hard cuts in cutscenes, boss-reveal sequences, scripted tours."
     :meta "Family: cut — standard film-language primitive.")
    (:eng "Cuts leave audit trace by target-name."
     :math "Composition of read and assign."
     :cs "Read + write."))
)

(verb
  :name "world/collisions" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/collisions) -> [[id1 id2] ...]"
  :summary "Return a list of [a, b] entity id pairs that collided in the last step."
  :explanation "After world/step completes, this reads the collision buffer and returns all pairwise overlaps detected. Each pair is a fresh list [id-a id-b]; the order within the pair is stable but unspecified across calls. Use this to dispatch collision-handling logic: damage, sounds, particles, etc. The buffer is cleared at the start of each step, so collisions only live for one frame."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define collisions (world/collisions))\n(display (length collisions))" :note "Get the collision list and count how many pairs collided this frame.")
    (:dialect "motoi" :tier "intermediate" :code "(define (handle-collisions)\n  (for-each (lambda (pair)\n    (let ((a (car pair))\n          (b (cadr pair)))\n      (when (eq? (entity/kind a) 'bullet)\n        (entity/set! b 'hp (- (entity/ref b 'hp) 10)))))\n    (world/collisions)))" :note "Iterate collisions and damage entities tagged as bullets.")
    (:dialect "motoi" :tier "expert" :code "(define (resolve-collisions ctx)\n  (for-each (lambda (pair)\n    (let ((id-a (car pair))\n          (id-b (cadr pair)))\n      (cond ((and (eq? (entity/kind id-a) 'player)\n                  (eq? (entity/kind id-b) 'coin))\n             (entity/despawn! id-b)\n             (act 'sound 'coin-collect))\n            ((and (eq? (entity/kind id-a) 'enemy)\n                  (eq? (entity/kind id-b) 'enemy))\n             (world/impulse! id-a -1 0)\n             (world/impulse! id-b 1 0)))))\n    (world/collisions))\n  (next 'resolve-collisions ctx))" :note "Multi-branch collision dispatcher in a state function; rebound enemies, collect coins.")
  )
  :caveats ("The collision list is only valid during the current frame; do not store a reference across steps." "A collision pair [a b] will appear only once per frame, even if the entities overlap continuously." "If an entity despawns mid-frame (e.g., in response to a collision), subsequent pairs involving that id may still appear.")
  :drawbacks ("No collision metadata (impact point, normal, relative velocity)—only the id pair." "Filtering by kind must be done in user code; no built-in layer/mask support at this stage (though collision/define-layers! can organize layers)." "Allocating a fresh list every call is slightly costly; for high-collision scenarios, cache the result.")
  :usecases ("Implementing hit detection for weapons, projectiles, or hazards." "Coin / item collection logic." "Triggering sound effects or particle bursts on impact." "Implementing enemy knock-back or stun on collision.")
  :related ("world/step" "world/solve!" "entity/overlaps?" "entity/collisions" "collision/define-layers!")
  :learn (:concept "Polling state from the world engine each frame to drive user logic." :prerequisites ("world/step" "entity/alive?" "entity/kind") :progression "Move to entity/overlaps? for per-entity queries, or collision/define-layers! to organize collision groups.")
  :row-2-audit (
    (:eng-program "(for-each (lambda (pair)\n            (let ((a (car pair)) (b (cadr pair)))\n              (list 'collision a b)))\n          (world/collisions))"
     :math-program "(define (pair-count n)\n  ;; C(n,2) = n(n-1)/2 — max collision pairs among n bodies (worst case, all overlap).\n  (quotient (* n (- n 1)) 2))\n(pair-count 5)"
     :cs-program "(define (buffer-not-stale?)\n  ;; Collision buffer valid only for current frame.\n  (let ((c (world/collisions))) (or (null? c) (list? c))))\n(buffer-not-stale?)"
     :problem "Process all collisions from last frame in one batch to unify damage/effect application. entity/collisions is per-entity — O(n); world/collisions returns global list."
     :explanation "eng: batch iteration. math: max pairs = C(n,2) = n(n-1)/2 — the tight bound. cs: buffer freshness check."
     :meta "entity/collisions = O(entities); world/collisions = O(collision-pairs). Choose by batch-scope.")
    (:eng "Batch collision processing easier to audit."
     :math "Enumeration of collision pairs; ≤ C(n,2)."
     :cs "Read of frame's collision buffer."))
  :row-3-dimension (
    (:setup "Enumerate the results of a per-frame simulation phase."
     :rungs (
       (:domain "world"   :code "(world/collisions)")
       (:domain "network" :code "(define packets '((a . 1) (b . 2))) packets")
       (:domain "sets"    :code "(define pairs '((1 2) (3 4))) pairs"))
     :explanation "Rung 1: collision pairs. Rung 2: packet buffer. Rung 3: list of pairs. Each: 'batch of results'.")
    (:meta "Shape: batch enumeration.")
    (:eng "SRE: batches allow bulk processing efficiencies." :math "List of tuples." :cs "Buffer read."))
  :row-4-proof (
    (:eng-program "(world/spawn 'a 0 0) (world/spawn 'b 0 0) (world/step)\n(define wc (world/collisions))\n(define ec (append (entity/collisions 'a) (entity/collisions 'b)))\n(= (length wc) (quotient (length ec) 2))"
     :math-program "(define (symmetry-witness pair) (or (equal? (list (car pair) (cadr pair)) pair) (equal? (list (cadr pair) (car pair)) pair)))\n;; Collision relation is symmetric: (a,b) ⇔ (b,a); global view dedupes, per-entity double-counts.\n(symmetry-witness '(a b))"
     :cs-program "(define (frame-scoped? c1 c2) (equal? c1 c2))\n;; Buffer is valid within one frame; clear at next step.\n(frame-scoped? (world/collisions) (world/collisions))"
     :claim "View-consistency: world/collisions = union of (entity/collisions id) over all id, with pair-dedup (symmetric relation)."
     :invariant "∀world. world/collisions = ⋃_id entity/collisions(id) / ~ where ~ = (a,b)~(b,a)"
     :meta "Symmetric collision relation with dedup. Falsified by disagreement between batch and per-entity views.")
    (:eng "Readers may use either view."
     :math "Multi-set relation under symmetry equivalence."
     :cs "Aggregation consistency."))
  :row-5-emergence (
    (:eng-composition "(on-frame (lambda ()\n  (for-each (lambda (p)\n              (when (and (eq? (entity/kind (car p)) 'projectile)\n                         (eq? (entity/kind (cadr p)) 'enemy))\n                (entity/damage! (cadr p) 5)\n                (entity/despawn! (car p))))\n            (world/collisions))))\n'wired"
     :math-composition "(define (kind-pair-classify pairs)\n  ;; Group collision pairs by (kind_a, kind_b) unordered — the interaction matrix.\n  (map (lambda (p) (list (entity/kind (car p)) (entity/kind (cadr p)))) pairs))\n(kind-pair-classify (world/collisions))"
     :cs-composition "(define (collision-dispatcher! handlers)\n  ;; handlers = alist of ((kind-a . kind-b) . fn); dispatch by kind pair.\n  (for-each (lambda (p)\n              (let* ((k1 (entity/kind (car p))) (k2 (entity/kind (cadr p)))\n                     (h (assoc (cons k1 k2) handlers)))\n                (when h ((cdr h) (car p) (cadr p)))))\n            (world/collisions)))\n(collision-dispatcher! (list (cons '(bullet . enemy) (lambda (a b) (list 'hit a b)))))"
     :base "world/collisions returns all collision pairs."
     :emergent "Projectile-damage + kind-classifier + dispatcher form the collision-response family — damage pipeline, interaction matrix, kind-pair dispatch."
     :meta "Family: batch-dispatch — standard collision-response pipeline.")
    (:eng "Batch dispatch easier to profile than per-entity."
     :math "Pattern match over collision pairs."
     :cs "Batch pipeline stage."))
)

(verb
  :name "world/count" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/count [kind]) -> integer"
  :summary "Return the number of alive entities, optionally filtered by kind."
  :explanation "A fast read of the entity count. If no kind is given, returns the total count of all live entities. If a kind symbol is provided, counts only entities of that kind. Despawned entities are not counted. Useful for game state checks (win condition, spawn caps, difficulty scaling)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/count)" :note "Get the total entity count.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((enemy-count (world/count 'enemy)))\n  (if (= enemy-count 0)\n    (display \"Wave cleared!\")\n    (display (string-append \"Enemies left: \" (number->string enemy-count)))))" :note "Check if all enemies are defeated and print status.")
    (:dialect "motoi" :tier "expert" :code "(define (check-spawn-cap ctx)\n  (let ((total (world/count))\n        (cap 64))\n    (cond ((>= total cap)\n           (next 'wait-for-despawn ctx))\n          (else\n           (world/spawn 'minion (random 640) (random 360))\n           (next 'check-spawn-cap ctx)))))" :note "Spawn minions up to a cap; wait when limit is reached.")
  )
  :caveats ("The count is read at the start of world/step; despawns in the current frame are reflected only after the step." "Passing a non-existent kind does not error; it simply returns 0.")
  :drawbacks ("No per-team or per-layer filtering; you must manually iterate (world/find kind) and filter further if needed." "Counted entities include all alive entities; there is no separate count for entities in a given state or with a tag.")
  :usecases ("Win/lose condition checks (all enemies dead, all coins collected)." "Difficulty scaling based on entity count." "Spawn caps to prevent lag or game-breaking abundance." "UI display of remaining enemies or collectibles.")
  :related ("world/find" "world/each" "entity/kind" "world/spawn" "entity/despawn!")
  :learn (:concept "Efficient aggregation: reading a pre-computed summary of world state." :prerequisites ("world/step" "entity/kind") :progression "Use world/find to get the actual list of ids for further filtering, or world/each to iterate and apply custom logic.")
  :row-2-audit (
    (:eng-program "(define (hud-count) (list 'total (world/count) 'enemies (world/count 'enemy)))\n(hud-count)"
     :math-program "(define (partition-sum kinds)\n  ;; Σ count(k) over disjoint kinds ≤ total; equality holds iff kinds partition the population.\n  (apply + (map (lambda (k) (world/count k)) kinds)))\n(partition-sum '(enemy player coin))"
     :cs-program "(define (o1-read?) (let* ((t1 (world/count)) (t2 (world/count))) (= t1 t2)))\n(o1-read?)"
     :problem "Display total-entity count on dashboard HUD. entity/count aggregates registry; world/count is world-scoped (spawned-in-world vs pool)."
     :explanation "eng: HUD tuple with total + enemy. math: partition sum bound — Σ count(k) ≤ total with equality iff kinds partition. cs: O(1) read consistency."
     :meta "entity/count = registry-scoped; world/count = world-scoped. In single-world configs they equal.")
    (:eng "HUD counters are safe per-frame reads."
     :math "|world.entities|; partition-additive on disjoint kinds."
     :cs "Cached size — O(1)."))
  :row-3-dimension (
    (:setup "Cardinality of a scoped container."
     :rungs (
       (:domain "world"   :code "(world/count)")
       (:domain "network" :code "(define (conn-count srv) 42)
(conn-count 'main)")
       (:domain "sets"    :code "(define (card s) (length s))
(card '(a b c))"))
     :explanation "Rung 1: world entity count. Rung 2: connection count on a server. Rung 3: set cardinality. Each: 'how many members'.")
    (:meta "Shape: scoped size.")
    (:eng "SRE: scoped sizes are dashboard staples." :math "Set cardinality." :cs "Cached size accessor."))
  :row-4-proof (
    (:eng-program "(define c0 (world/count))\n(world/spawn 'x 0 0)\n(= (+ c0 1) (world/count))"
     :math-program "(define (conservation-witness n)\n  ;; Spawn N, despawn N ⇒ count returns to initial. Σ(spawns) - Σ(despawns) = Δcount.\n  (let ((c0 (world/count)))\n    (let loop ((i 0)) (if (< i n) (begin (world/spawn 'x i i) (loop (+ i 1))) 'done))\n    (= (world/count) (+ c0 n))))\n(conservation-witness 3)"
     :cs-program "(define (accounting-consistent?)\n  (let ((c0 (world/count)))\n    (let ((e (world/spawn 'a 0 0)))\n      (entity/despawn! e)\n      (= (world/count) c0))))\n(accounting-consistent?)"
     :claim "Monotonicity + conservation: world/count grows by exactly 1 per spawn, shrinks by 1 per despawn. Σ(spawns) - Σ(despawns) = Δcount."
     :invariant "∀world. count(spawn(w)) = count(w) + 1 ∧ count(despawn(w)) = count(w) - 1"
     :meta "Count/spawn algebra with conservation. Falsified if spawn/despawn changes count by non-1.")
    (:eng "Count changes are audit signals."
     :math "Increment-per-spawn; balance-sheet accounting."
     :cs "Consistent accounting."))
  :row-5-emergence (
    (:eng-composition "(define budget 100)\n(on-frame (lambda ()\n  (when (> (world/count) budget)\n    (for-each (lambda (id) (when (eq? (entity/kind id) 'particle) (entity/despawn! id))) (world/find)))))\n'wired"
     :math-composition "(define (population-limit! K)\n  ;; Discrete logistic: dN/dt = r·N·(1 - N/K); cull excess above K.\n  (let ((n (world/count))) (if (> n K) (list ':excess (- n K) ':cull-rate 'proportional) (list ':stable n))))\n(population-limit! 100)"
     :cs-composition "(define (spawn-with-cap kind cap)\n  (if (< (world/count kind) cap) (world/spawn kind 0 0) 'at-cap))\n(spawn-with-cap 'enemy 10)"
     :base "world/count reads entity total."
     :emergent "Budget-enforcer + logistic-cap + spawn-with-cap form the population-control family — pressure valve, carrying-capacity model, resource-cap pattern."
     :meta "Family: population control — same slot as GC pressure, database connection pool caps.")
    (:eng "Budget enforcement prevents runaway spawn bugs."
     :math "Threshold-triggered filter; logistic carrying capacity."
     :cs "Cap-and-cull loop."))
)

(verb
  :name "world/each" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/each fn) -> integer"
  :summary "Call fn with each alive entity id in birth order; return the count."
  :explanation "Iteration primitive: loops over all entities currently alive and invokes fn once per id. The entities are visited in the order they were spawned (bornSeq). Useful for polling entity state, running per-entity logic, or collecting data. Returns the count of iterations, which equals the number of alive entities."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/each (lambda (id)\n  (display (entity/kind id))))" :note "Print the kind of every entity.")
    (:dialect "motoi" :tier "intermediate" :code "(define (count-by-kind)\n  (let ((counts '()))\n    (world/each (lambda (id)\n      (let ((k (entity/kind id)))\n        (display (string-append k \" at \" (number->string (entity/x id)) \" \\n\")))))\n    counts))" :note "Emit entity kind and position for each entity.")
    (:dialect "motoi" :tier "expert" :code "(define (tick-all-entities ctx)\n  (world/each (lambda (id)\n    (when (entity/alive? id)\n      (let ((state (entity/state id)))\n        (cond ((eq? state 'idle)\n               (entity/set! id 'idle-time (+ (entity/ref id 'idle-time) 1)))\n              ((eq? state 'moving)\n               (entity/move! id (entity/vel id))))))))\n  (next 'tick-all-entities ctx))" :note "Run per-entity FSM logic in a state function; update timers and positions.")
  )
  :caveats ("The iteration order is stable (birth order) but should not be relied upon for determinism if entities are spawned dynamically." "If you despawn an entity during iteration, the behavior is unspecified—use entity/alive? to guard any mutations." "The function is called for every id, including those that may have become invalid since the start of iteration; check entity/alive? if you want to skip dead entities.")
  :drawbacks ("No built-in filtering by kind or tag; use world/find for that." "Cannot break early or short-circuit the loop; if you need conditional stopping, use world/find instead." "Allocates a closure for every call; in tight loops, consider world/find and a hand-rolled for-each.")
  :usecases ("Broadcasting a message or state change to all entities." "Collecting statistics (count, min/max position, total damage)." "Running per-entity FSMs or tick logic each frame." "Rendering or visual polling of all entities.")
  :related ("world/find" "world/count" "entity/alive?" "entity/state" "entity/set!")
  :learn (:concept "Iteration and side effects: how to visit every entity and apply a procedure." :prerequisites ("world/step" "lambda" "entity/kind") :progression "Use world/find to filter by kind, or fold-left / fold-right (from core) to accumulate values across entities.")
  :row-2-audit (
    (:eng-program "(world/each (lambda (id) (entity/drag! id 0.95)))"
     :math-program "(:honest-null \"world/each is iteration protocol: apply a callback to each element of an unordered collection. The operation is higher-order dispatch, not algebra. Row-2 math is honest-null.\")"
     :cs-program "(define (sweep-count! sweep-fn)\n  (let ((count 0)) (world/each (lambda (id) (sweep-fn id) (set! count (+ count 1)))) count))\n(sweep-count! (lambda (id) 'visited))"
     :problem "Apply per-frame drag to every entity. entity/all + for-each requires two calls; world/each is one-call callback iteration."
     :explanation "eng: one-line sweep with drag. math: honest-null — iteration protocol is not algebra. cs: count-visited wrapper."
     :meta "entity/all + for-each = more flexible (filter-first); world/each = more compact.")
    (:eng "Sweeps audit-clear; grep 'world/each'."
     :math "Iteration over the registry."
     :cs "Higher-order visit."))
  :row-3-dimension (
    (:setup "Apply a function to every member of a collection."
     :rungs (
       (:domain "world"  :code "(world/each (lambda (id) (entity/drag! id 0.95)))")
       (:domain "shell"  :code "(define (for-each-file dir f) (list 'walked dir)) (for-each-file \"/tmp\" 'print)")
       (:domain "math"   :code "(define (each xs f) (for-each f xs))
(each '(1 2 3) display)"))
     :explanation "Rung 1: entity visit. Rung 2: file walk. Rung 3: list iteration. Each: 'apply f to each member'.")
    (:meta "Shape: higher-order iteration.")
    (:eng "SRE: iterators are the workhorse of frame updates." :math "Function application over a domain." :cs "For-each pattern."))
  :row-4-proof (
    (:eng-program "(world/spawn 'a 0 0) (world/spawn 'b 0 0)\n(define visited '())\n(world/each (lambda (id) (set! visited (cons id visited))))\n(= 2 (length visited))"
     :math-program "(:honest-null \"Complete-once coverage is an iterator contract (each element visited exactly once), not an algebraic identity. See :cs-program for empirical count-witness.\")"
     :cs-program "(define (coverage-witness n)\n  (let ((visited-count 0))\n    (let loop ((i 0)) (when (< i n) (world/spawn 'e i i) (loop (+ i 1))))\n    (world/each (lambda (id) (set! visited-count (+ visited-count 1))))\n    (= visited-count n)))\n(coverage-witness 3)"
     :claim "Coverage: every entity in the world is visited exactly once per world/each call."
     :invariant "∀world,f. |visited(world/each(world,f))| = count(world)"
     :meta "Complete-once coverage. Falsified if any entity is skipped or double-visited.")
    (:eng "Sweeps safe for uniform effects."
     :math "Bijection between visits and members."
     :cs "Complete iteration."))
  :row-5-emergence (
    (:eng-composition "(define (apply-wind strength)\n  (world/each (lambda (id) (entity/apply-force! id strength 0))))\n(on-frame (lambda () (apply-wind 0.5)))\n'wired"
     :math-composition "(:honest-null \"Uniform-field application is a per-element side-effect sweep; the operation is functorial-fmap for effect, not algebra. See :cs-composition for reduce-over-each fold.\")"
     :cs-composition "(define (reduce-over-each combine init)\n  ;; fold-left simulation via mutation.\n  (let ((acc init)) (world/each (lambda (id) (set! acc (combine acc id)))) acc))\n(reduce-over-each (lambda (a id) (+ a 1)) 0)"
     :base "world/each visits every entity with a callback."
     :emergent "Wind-field + reduce-over-each form the environmental-effect + fold-in-place family — per-frame gravity, drag, mass aggregation, bounding-box computation."
     :meta "Family: environmental effect — same slot as ECS system-run.")
    (:eng "Universal effects can accumulate; add damping."
     :math "Uniform vector-field application; fold-in-place."
     :cs "Per-tick sweep."))
)

(verb
  :name "world/find" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/find [kind]) -> [id ...]"
  :summary "Return a list of all alive entity ids, optionally filtered by kind."
  :explanation "Query primitive: returns a fresh list of entity ids. Without an argument, all alive entities are included. With a kind symbol, only entities of that kind are returned. The ids are in birth order (the same order world/each visits them). Use this to collect entities for filtering, sorting, or count-based logic."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((all-ids (world/find)))\n  (display (length all-ids)))" :note "Get the list of all entity ids and count them.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((enemies (world/find 'enemy)))\n  (for-each (lambda (id)\n    (world/impulse! id 0 -5))\n    enemies))" :note "Find all enemies and apply an upward impulse to each.")
    (:dialect "motoi" :tier "expert" :code "(define (find-nearest-enemy-to id)\n  (let* ((pos (entity/pos id))\n         (px (car pos))\n         (py (cadr pos))\n         (enemies (world/find 'enemy)))\n    (if (null? enemies)\n      'nan\n      (fold (lambda (candidate nearest)\n        (let ((d-nearest (entity/distance nearest id))\n              (d-candidate (entity/distance candidate id)))\n          (if (< d-candidate d-nearest) candidate nearest)))\n        (car enemies)\n        (cdr enemies)))))" :note "Find all enemies and fold to get the one closest to a given entity.")
  )
  :caveats ("The returned list is a snapshot; changes to the world after the call (spawns, despawns) are not reflected." "If kind is provided but no entities match, an empty list is returned (no error)." "The list is in birth order; if you need a different order, sort it yourself.")
  :drawbacks ("Allocates a new list; for very large entity counts, this can be costly if called every frame." "No lazy evaluation; all matching ids are collected up front." "No filtering by tag, state, or other properties; filter the returned list in user code if needed.")
  :usecases ("Finding a subset of entities to apply an action to (e.g., all coins, all enemies)." "Nearest-neighbor or distance-based queries (combined with fold or map)." "Checking existence conditions (e.g., 'if any coin remains')." "Bulk state or physics updates (e.g., slow all enemies).")
  :related ("world/each" "world/count" "world/nearest" "entity/kind" "fold-left")
  :learn (:concept "Querying and filtering: how to collect entities matching a criterion." :prerequisites ("world/step" "entity/kind" "list" "length") :progression "Combine with fold-left / fold-right to aggregate data, or use world/nearest for spatial queries.")
  :row-2-audit (
    (:eng-program "(world/find 'coin)"
     :math-program "(define (preimage-of f y xs) (filter (lambda (x) (equal? (f x) y)) xs))\n;; world/find(k) = kind⁻¹({k}) — the preimage of k under the kind function.\n(preimage-of (lambda (x) (modulo x 3)) 0 '(1 3 6 7 9))"
     :cs-program "(define (index-hit-ratio kind)\n  ;; If world maintains a per-kind index, find is O(k) where k = |result|; else O(n).\n  (list ':kind kind ':result-len (length (world/find kind))))\n(index-hit-ratio 'coin)"
     :problem "Need list of all 'coin entities to apply bulk animation. entity/all + filter-by-kind is O(n); world/find is indexed by kind."
     :explanation "eng: direct query. math: preimage kind⁻¹({k}) — set-theoretic definition. cs: index-hit-ratio for perf estimate."
     :meta "entity/all + filter = O(n) scan; world/find = O(k) where k is the coin count.")
    (:eng "Indexed finds scale better than linear scans."
     :math "Preimage of kind predicate — kind⁻¹({k})."
     :cs "Indexed lookup on kind field."))
  :row-3-dimension (
    (:setup "Filtered lookup on a keyed attribute."
     :rungs (
       (:domain "world"  :code "(world/find 'coin)")
       (:domain "sql"    :code "(define (select-where t k v) (list 'select t k v))
(select-where 'users 'role 'admin)")
       (:domain "sets"   :code "(define (filter-eq xs k) (filter (lambda (x) (eq? x k)) xs))
(filter-eq '(a b a) 'a)"))
     :explanation "Rung 1: entities of a kind. Rung 2: SQL SELECT WHERE. Rung 3: filter by predicate. Each: 'give me members matching this attribute'.")
    (:meta "Shape: attribute-indexed selection.")
    (:eng "SRE: indexed queries beat scans when index is available." :math "Preimage under a projection." :cs "Index-backed filter."))
  :row-4-proof (
    (:eng-program "(world/spawn 'coin 0 0) (world/spawn 'coin 10 10) (world/spawn 'gem 0 0)\n(= 2 (length (world/find 'coin)))"
     :math-program "(define (partition-complete? kinds)\n  ;; Σ |find(k)| over all kinds = |world| (partition covers everything).\n  (= (apply + (map (lambda (k) (length (world/find k))) kinds)) (world/count)))\n(partition-complete? '(coin gem enemy))"
     :cs-program "(define (soundness? k)\n  ;; All returned entities have the requested kind.\n  (let ((res (world/find k))) (fold (lambda (e acc) (and acc (eq? (entity/kind e) k))) #t res)))\n(soundness? 'coin)"
     :claim "Completeness + soundness: |find(w,k)| = |{e ∈ w : kind(e)=k}|; every returned entity has the requested kind; partition sum covers world."
     :invariant "∀w,k. |find(w,k)| = |{e ∈ w : kind(e)=k}| ∧ ∀e ∈ find(w,k). kind(e) = k"
     :meta "Query completeness + soundness. Falsified by missing entity (incompleteness) or wrong-kind entity (unsoundness).")
    (:eng "Rely on result set."
     :math "Bijection with preimage; partition-covers-world."
     :cs "Complete match."))
  :row-5-emergence (
    (:eng-composition "(define (award-coin-value multiplier)\n  (for-each (lambda (id) (entity/set! id 'value (* multiplier (or (entity/ref id 'value) 1)))) (world/find 'coin)))\n(award-coin-value 2)"
     :math-composition "(define (spatial-hash-partition entities cell-size)\n  ;; Group entities into cells: cell(e) = (floor(x/cs), floor(y/cs)). Broad-phase collision optimization.\n  (map (lambda (id) (let ((p (entity/pos id))) (list (quotient (car p) cell-size) (quotient (cadr p) cell-size) id))) entities))\n(spatial-hash-partition (world/find) 64)"
     :cs-composition "(define (nearest-of kind me)\n  ;; k-NN style: fold over kind-set, keep min-distance.\n  (let ((candidates (world/find kind)))\n    (if (null? candidates) 'none\n      (fold (lambda (e best) (if (< (entity/distance e me) (entity/distance best me)) e best)) (car candidates) (cdr candidates)))))\n(nearest-of 'enemy 'hero)"
     :base "world/find returns entities of a kind."
     :emergent "Bulk-attribute update + spatial-hash + nearest-of form the cohort-ops family — SQL UPDATE WHERE, broad-phase collision, k-NN queries, ECS system-filter."
     :meta "Family: bulk-update / cohort-ops — same slot as SQL UPDATE WHERE, ECS component queries.")
    (:eng "Bulk updates testable via count invariants."
     :math "Element-wise transformation over subset; spatial hashing."
     :cs "Filter + map + update."))
)

(verb
  :name "world/floor!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/floor! y [bounce]) -> null"
  :summary "Set a horizontal ground plane at y; bounce is the restitution coefficient. No argument removes it."
  :explanation "Creates a rigid floor (or removes it) that all physics bodies collide with. Bodies falling below y will bounce back (or stick, if bounce is 0). The bounce parameter controls restitution: 0 means no bounce (perfectly inelastic), 1 means full conservation of velocity, >1 means gain (unphysical but sometimes fun). Calling with no arguments removes the floor entirely."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/floor! 360 0.6)" :note "Set a bouncy ground at y=360 with 60% restitution.")
    (:dialect "motoi" :tier "intermediate" :code "(define (setup-level)\n  (world/reset!)\n  (world/gravity! 0 0.3)\n  (world/floor! 360 0.5)\n  (world/spawn 'player 320 180))" :note "Initialize a level with gravity, a floor, and a player entity.")
    (:dialect "motoi" :tier "expert" :code "(define (on-frame ctx)\n  (let ((frame (world/frame)))\n    (cond ((= (modulo frame 120) 0)\n           ;; Every 2 seconds, toggle the floor\n           (if (> frame 0) (world/floor!) (world/floor! 360 0.8)))\n          (else\n           (world/each (lambda (id)\n             (when (< (entity/y id) -100)\n               (entity/set-pos! id 320 180)))))))  ;; Respawn fallen entities\n  (next 'on-frame ctx))" :note "Toggle the floor on and off; respawn entities that fall below the screen.")
  )
  :caveats ("The floor is infinite (extends across all x); it cannot be positioned horizontally." "Entities do not rest on the floor without friction; they will bounce indefinitely unless world/wind! or drag is applied." "Calling with only y (no bounce) uses a default bounce value; verify the default in your interpreter.")
  :drawbacks ("Only one floor is supported; for multiple platforms, use solid entities or a grid collision system." "No friction or stopping condition built-in; entities bounce until damped by external forces." "Bounce > 1 can cause numerical instability over many frames; keep values reasonable (< 1 recommended).")
  :usecases ("Creating a ground plane in platformers or physics puzzles." "Bouncy surfaces (trampoline-like behavior with high bounce)." "Sticky ground (low bounce, combined with drag or friction)." "Temporary platforms (toggle the floor on and off for puzzle mechanics).")
  :related ("world/gravity!" "world/wind!" "entity/gravity-scale!" "entity/solid!" "world/step")
  :learn (:concept "Static collision geometry: a simple, efficient way to define an immobile boundary." :prerequisites ("world/gravity!" "world/step" "entity/pos") :progression "Use entity/solid! and entity/shape! for more complex collision shapes, or world/solve! for constraint-based physics.")
  :row-2-audit (
    (:eng-program "(world/floor! 400 0.6)\n(world/spawn 'ball 100 100)\n(entity/set-vel! 'ball 0 5)"
     :math-program "(define (restitution-out v-in e)\n  ;; Coefficient-of-restitution: v_out = -e·v_in. e=1 elastic, e=0 inelastic, e>1 unphysical.\n  (- (* e v-in)))\n(restitution-out 10 0.6)"
     :cs-program "(define (floor-valid? y e) (and (number? y) (number? e) (>= e 0) (< e 2)))\n(floor-valid? 400 0.6)"
     :problem "Every entity in game should fall to ground plane at y=400. Spawning a wall entity is heavier than needed; world/floor! is a special world-level parameter integrator honors."
     :explanation "eng: floor + spawn + init velocity. math: coefficient-of-restitution v_out = -e·v_in (Newton's law of restitution). cs: parameter validity."
     :meta "Wall entity requires per-instance physics; world/floor! is a special-case optimization for common ground.")
    (:eng "Floor is global; audit value once."
     :math "Half-plane constraint {(x,y) : y ≤ f}; restitution scales rebound."
     :cs "Special-case constraint in integrator."))
  :row-3-dimension (
    (:setup "A special-case global constraint on a coordinate."
     :rungs (
       (:domain "world"    :code "(world/floor! 400)")
       (:domain "throttle" :code "(define (ceiling-val v m) (min v m))
(ceiling-val 500 400)")
       (:domain "math"     :code "(define (clip-below y f) (if (> y f) f y))
(clip-below 500 400)"))
     :explanation "Rung 1: floor plane. Rung 2: value ceiling. Rung 3: clip below. Each: 'don't exceed this bound'.")
    (:meta "Shape: hard-clip on an axis.")
    (:eng "SRE: hard clips are simplest constraints." :math "Half-plane restriction." :cs "Per-entity y-clip."))
  :row-4-proof (
    (:eng-program "(world/floor! 400 0.5)\n(world/spawn 'ball 100 100) (entity/set-vel! 'ball 0 1000)\n(world/step) (world/step)\n(<= (entity/y 'ball) 400)"
     :math-program "(define (energy-loss-per-bounce e ke0)\n  ;; KE after = e²·KE before (kinetic energy scales as v²). e=0 total loss; e=1 lossless.\n  (* e e ke0))\n(energy-loss-per-bounce 0.6 100)"
     :cs-program "(define (settled-by? n)\n  (world/floor! 400 0.5)\n  (let ((b (world/spawn 'b 100 100)))\n    (entity/set-vel! b 0 1000)\n    (let loop ((i 0)) (if (>= i n) (< (abs (cadr (entity/vel b))) 0.01) (begin (world/step) (loop (+ i 1)))))))\n(settled-by? 200)"
     :claim "Bounded-y + energy decay: floor(f, e<1) ⇒ y ≤ f ∧ KE decreases as e² per bounce ⇒ settlement in finite time."
     :invariant "∀entity. floor(f,e) ⇒ y(t) ≤ f ∧ KE(t+1) = e²·KE(t) at each bounce ∧ e<1 ⇒ settlement"
     :meta "Half-plane constraint + geometric energy decay. Falsified if any entity crosses floor or fails to settle for e<1.")
    (:eng "Entities never fall past floor; bouncy floors settle if e<1."
     :math "Half-plane projection + energy dissipation."
     :cs "Post-integration clip."))
  :row-5-emergence (
    (:eng-composition "(world/gravity! 0 9.8)\n(world/floor! 400 0.7)\n(world/spawn 'ball 100 100)\n(entity/bounce! 'ball 0.7)"
     :math-composition "(define (bounce-height-sequence h0 e)\n  ;; Ball dropped from h0 with restitution e bounces to heights h0·e², h0·e⁴, h0·e⁶, ... (geometric).\n  (map (lambda (i) (* h0 (expt e (* 2 i)))) '(0 1 2 3 4)))\n(bounce-height-sequence 100 0.7)"
     :cs-composition "(define (physics-demo! y bounce grav n-balls)\n  (world/reset!) (world/gravity! 0 grav) (world/floor! y bounce)\n  (let loop ((i 0)) (when (< i n-balls) (world/spawn 'ball (* i 50) 100) (loop (+ i 1))))\n  'ready)\n(physics-demo! 400 0.7 0.3 5)"
     :base "world/floor! sets a global ground plane."
     :emergent "Bouncing ball + geometric bounce-heights (h·e^(2n)) + physics-demo factory form the physics-setup family — Newton's cradle, coefficient-of-restitution demos, playground physics."
     :meta "Family: physics-setup bundle — same slot as Box2D world init.")
    (:eng "Physics demos grep-friendly for test-case creation."
     :math "Composition of constraint, force, reflection; geometric bounce-heights."
     :cs "Bundled physics scene."))
)

(verb
  :name "world/frame" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/frame) -> integer"
  :summary "Return the current world frame counter (incremented each step)."
  :explanation "A monotonically increasing integer that counts the number of world/step calls since start (or world/reset!). Useful for scheduling, timing events, or synchronizing animations. Frame 0 is the initial state before any step."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((f (world/frame)))\n  (display f))" :note "Print the current frame number.")
    (:dialect "motoi" :tier "intermediate" :code "(define (spawn-every-30-frames ctx)\n  (when (= (modulo (world/frame) 30) 0)\n    (world/spawn 'enemy (random 640) 0))\n  (next 'spawn-every-30-frames ctx))" :note "Spawn an enemy every 30 frames (once per second at 30fps).")
    (:dialect "motoi" :tier "expert" :code "(define (oscillating-y id amplitude frequency)\n  (let* ((f (world/frame))\n         (angle (* (/ f frequency) 6.28))  ;; 2π\n         (y-offset (* amplitude (sin angle))))\n    (entity/set-pos! id (entity/x id) y-offset)))\n\n(define (animate-entity ctx)\n  (oscillating-y (car (world/find 'player)) 50 60)  ;; Oscillate player up/down\n  (next 'animate-entity ctx))" :note "Use frame count to drive a sine wave animation.")
  )
  :caveats ("Frame is a counter from the start; do not assume a global wall-clock time (frame rate may vary)." "After world/reset!, the frame counter is reset to 0." "Modulo arithmetic (frame % n == 0) is the standard pattern for periodic events; be careful of off-by-one.")
  :drawbacks ("No fractional frames; for smooth sub-frame timing, combine with entity velocity or motion tweens." "The frame counter can overflow if the game runs long enough (after 2^31 frames); in practice, this is rare.")
  :usecases ("Scheduling: spawn, state changes, or animations at specific frames." "Periodic effects: every N frames, do something (flicker, pulse, spawn wave)." "Replay and determinism: using the frame count as a seed or checkpoint." "Debugging: log the frame when an event occurs.")
  :related ("world/step" "world/reset!" "world/after" "tick/mod-n" "time/every-ms")
  :learn (:concept "Discrete time: using a frame counter for scheduling and synchronization." :prerequisites ("world/step" "modulo") :progression "Use world/after for frame-delayed events, or tick/pattern for more complex rhythmic patterns.")
  :row-2-audit (
    (:problem "The operator wants to fire an effect every 60 frames without maintaining a private counter. world/frame reads the runtime's own monotone tick; modulo is the cheapest possible periodicity test."
     :eng-program "(define (every-nth n action)\n  (when (= 0 (modulo (world/frame) n)) (action)))\n(every-nth 60 (lambda () (display 'tick)))"
     :math-program "(define (in-period? n)\n  ;; Periodic membership predicate on ℕ: f ∈ nℤ iff f mod n = 0.\n  (= 0 (modulo (world/frame) n)))\n(in-period? 60)"
     :cs-program "(define (safe-frame-read)\n  ;; Read must be a nonneg integer; a stale registry cell would return 'nan or negatives.\n  (let ((f (world/frame)))\n    (and (integer? f) (>= f 0))))\n(safe-frame-read)"
     :explanation "eng: every-nth wrapper reifies the cadence. math: periodic-membership predicate ties frame ∈ nℤ. cs: type + nonneg guard witnesses that the read is a valid ℕ."
     :meta "Reach for world/frame over hoisting a private counter — the framework owns the tick; parallel counters drift under world/reset!. Sibling world/after is a one-shot; frame + modulo is the recurring shape.")
    (:eng "SRE: frame reads are O(1) — freely usable inside every on-frame closure."
     :math "ℕ-valued monotone counter; periodicity captured by frame ≡ 0 (mod n)."
     :cs "Read of a registry cell; O(1); no lock needed for single-writer scheduler."))
  :row-3-dimension (
    (:setup "Read the current tick of a monotonic clock."
     :rungs (
       (:domain "world"    :code "(world/frame)")
       (:domain "unix"     :code "(define (time-now) 1721000000)
(time-now)")
       (:domain "math"     :code "(define (step n) (+ n 1))
(step 5)"))
     :explanation "Rung 1: game frame. Rung 2: Unix epoch. Rung 3: successor. Each: 'current point on a monotonic axis'."
     :meta "Shape: monotonic tick counter.")
    (:eng "SRE: tick reads are foundational for time-based logic." :math "ℕ counter." :cs "Monotonic read."))
  :row-4-proof (
    (:claim "Monotonicity: world/frame at time t2 ≥ world/frame at time t1 when t2 > t1. Successive world/step calls produce a non-decreasing sequence of frame reads."
     :eng-program "(define (monotone-witness)\n  (let ((f1 (world/frame)))\n    (world/step) (world/step)\n    (>= (world/frame) f1)))\n(monotone-witness)"
     :math-program "(define (successor-verified)\n  ;; ∀ t. frame(step(w,t)) = frame(w,t) + 1. Check by unit-step delta.\n  (let ((f0 (world/frame)))\n    (world/step)\n    (= (world/frame) (+ f0 1))))\n(successor-verified)"
     :cs-program "(define (integer-domain-witness)\n  ;; Frame slot must be ℤ throughout — no float promotion, no wrap.\n  (let ((f (world/frame)))\n    (and (integer? f) (>= f 0) (< f (expt 2 31)))))\n(integer-domain-witness)"
     :invariant "∀ t1 < t2. frame(t1) ≤ frame(t2) ∧ frame(step(w)) = frame(w) + 1 ∧ frame(w) ∈ ℕ ∩ [0, 2^31)"
     :meta "Monotonic clock + successor law + integer domain. Falsified if the frame ever decreases, skips, or overflows unnoticed. Book-of-code ch 8 (monotonic counters) grounds.")
    (:eng "Consequence: safe as a time reference for scheduling."
     :math "Non-decreasing function of physical time; a discrete monotone."
     :cs "Monotonic slot; wraparound is a rare-but-real failure mode past 2^31 frames."))
  :row-5-emergence (
    (:base "world/frame returns the current frame counter."
     :eng-composition "(define (periodic-spawner)\n  (on-frame (lambda ()\n    (when (= 0 (modulo (world/frame) 30))\n      (world/spawn 'coin (random 500) 100)))))\n(periodic-spawner)"
     :math-composition "(define (frame-mod-histogram n)\n  ;; Frame projected to a discrete torus ℤ/nℤ; used to schedule n distinct phases.\n  (modulo (world/frame) n))\n(frame-mod-histogram 8)"
     :cs-composition "(define (heartbeat-log interval)\n  ;; Cadence dispatcher — same shape as a cron trigger, keyed by the frame tick.\n  (when (= 0 (modulo (world/frame) interval))\n    (display (list 'beat (world/frame))) (newline)))\n(heartbeat-log 60)"
     :emergent "A periodic-spawner + frame-torus + heartbeat-log triad — cadence dispatchers that use frame as the shared clock. Emergent: rhythm-based scheduling."
     :meta "Cadence family; standard rhythm-based logic. Book-of-composition ch 13 (temporal composition) grounds.")
    (:eng "SRE: cadence-based spawns are easy to test — set frame, assert action fired."
     :math "Periodic predicate over ℤ/nℤ; heartbeat is the identity residue."
     :cs "Modulo-based dispatch; the same construction as cron and setInterval."))
)

(verb
  :name "world/gravity!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/gravity! gx gy) -> void"
  :summary "Set the global gravitational acceleration vector for all physics bodies."
  :explanation "Every frame, gravity applies a constant acceleration to all entities that have not disabled it (via entity/gravity-scale! 0). The vector (gx gy) is in world units per frame squared. Positive gy pulls downward; negative gy pulls upward. This is the primary lever for tuning how 'heavy' or 'floaty' the world feels. Call it once at setup or whenever you need to shift gravity mid-simulation (e.g., antigravity powerup, moon level)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/gravity! 0 0.5)" :note "Earth-like gravity: no horizontal drift, downward pull of 0.5 units/frame².")
    (:dialect "motoi" :tier "intermediate" :code "(define (apply-antigravity? active)\n  (if active\n    (world/gravity! 0 -0.3)\n    (world/gravity! 0 0.5)))\n(apply-antigravity? #t)" :note "Toggle gravity direction based on powerup state; negative gy flips the pull.")
    (:dialect "motoi" :tier "expert" :code "(define (setup-level-physics level-name)\n  (cond\n    ((equal? level-name 'moon) (world/gravity! 0 0.1))\n    ((equal? level-name 'space) (world/gravity! 0 0))\n    (else (world/gravity! 0 0.5))))\n(setup-level-physics 'moon)" :note "Level-specific gravity tuning; zero gravity is valid and used for free-floating zones.")
  )
  :caveats ("Gravity applies to ALL entities unless individually disabled (entity/gravity-scale! id 0)." "Does not take effect on entities spawned with no physics body." "Setting to (0 0) disables gravity but does not stop momentum; entities keep their velocity." "Changes apply on the NEXT world/step, not immediately within the same frame.")
  :drawbacks ("Global only; you cannot have per-entity custom gravity directions without using world/attract! or world/repel! instead." "No automatic 'bounce' on gravity reversal; entities in flight will invert smoothly but may feel unresponsive if changed mid-jump.")
  :usecases ("Initial level setup: define the physics feel before spawning entities." "Powerup activation: antigravity boots, low-g zones, null-g chambers." "Environmental transitions: moving from Earth to Moon or space." "Arcade tuning: adjust gravity to make platforming feel snappy or floaty.")
  :related ("entity/gravity-scale!" "world/impulse!" "world/attract!" "world/repel!" "world/wind!")
  :learn (:concept "Global acceleration applied uniformly to all physics bodies; the baseline force model." :prerequisites ("entity/alive?" "world/step") :progression "After setting gravity, learn entity/gravity-scale! to fine-tune per-body weight, then world/impulse! to apply instant kicks.")
  :row-2-audit (
    (:problem "The operator wants downward gravity to apply to every entity uniformly. Applying gravity per-entity would require N calls and drift as entities are spawned; world/gravity! is the world-level constant acceleration field every physics body reads once per step."
     :eng-program "(define (setup-earth-gravity)\n  ;; Set the global g vector at level start.\n  (world/gravity! 0 9.8)\n  'gravity-set)\n(setup-earth-gravity)"
     :math-program "(define (verify-newton-law tries)\n  ;; F = m·g reduces (for unit mass) to Δv = g·Δt with Δt=1 frame.\n  ;; Falling ball: vy after one step should equal previous vy + gy.\n  (world/gravity! 0 9.8)\n  (world/spawn 'ball 100 0)\n  (let ((v0 (cadr (entity/vel 'ball))))\n    (world/step)\n    (- (cadr (entity/vel 'ball)) v0)))  ; ≈ 9.8\n(verify-newton-law 1)"
     :cs-program "(define (nan-guard gx gy)\n  ;; Guard against NaN/Infinity infecting every entity velocity.\n  (cond ((not (number? gx)) 'bad-gx)\n        ((not (number? gy)) 'bad-gy)\n        (else (world/gravity! gx gy) 'set)))\n(nan-guard 0 9.8)"
     :explanation "eng: one call at setup applies uniformly. math: Newton F=mg reduces per-step to Δv=g·Δt; verify equals gy. cs: NaN/Infinity guard prevents poisoning every entity velocity."
     :meta "Reach for world/gravity! over per-entity entity/accel! for uniform fields — the framework fuses the loop; parallel per-entity calls thrash the physics scheduler. entity/accel! is the escape hatch for per-body deltas.")
    (:eng "SRE: gravity is a global; grep once for the call site and reason about level start."
     :math "F=mg reduces to constant acceleration; per-frame Δv = g."
     :cs "Global acceleration slot; single write, N reads (one per physics body) per step."))
  :row-3-dimension (
    (:setup "A global parameter that affects every member."
     :rungs (
       (:domain "world"    :code "(world/gravity! 0 9.8)")
       (:domain "linux"    :code "(define ambient '((tz . \"UTC\") (locale . \"en\"))) ambient")
       (:domain "math"     :code "(define (add-to-each xs c) (map (lambda (x) (+ x c)) xs))
(add-to-each '(1 2 3) 10)"))
     :explanation "Rung 1: global gravity. Rung 2: ambient environment. Rung 3: uniform offset. Each: 'apply this to every member'."
     :meta "Shape: universal parameter.")
    (:eng "SRE: globals need one clear owner." :math "Global constant of the system." :cs "Ambient parameter."))
  :row-4-proof (
    (:claim "Universality: every physics-participating entity's y-velocity increases by exactly gy per step; gravity is a constant acceleration field on the entire body set."
     :eng-program "(define (universality-witness)\n  (world/gravity! 0 10)\n  (world/spawn 'e 0 0)\n  (let ((v0 (cadr (entity/vel 'e))))\n    (world/step)\n    (> (cadr (entity/vel 'e)) v0)))\n(universality-witness)"
     :math-program "(define (integration-check)\n  ;; ∀ e. vy(t+1) = vy(t) + gy exactly under semi-implicit Euler.\n  (world/gravity! 0 5)\n  (world/spawn 'a 0 0) (world/spawn 'b 100 0)\n  (let ((va0 (cadr (entity/vel 'a))) (vb0 (cadr (entity/vel 'b))))\n    (world/step)\n    (and (= (cadr (entity/vel 'a)) (+ va0 5))\n         (= (cadr (entity/vel 'b)) (+ vb0 5)))))\n(integration-check)"
     :cs-program "(define (skip-static?)\n  ;; Pinned entities MUST NOT be affected — invariant of the physics pass.\n  (world/gravity! 0 9.8)\n  (world/spawn 'pin 0 0)\n  (entity/pin! 'pin)\n  (let ((v0 (cadr (entity/vel 'pin))))\n    (world/step)\n    (= (cadr (entity/vel 'pin)) v0)))\n(skip-static?)"
     :invariant "∀ e ∈ participants(world). vy(e, t+1) = vy(e, t) + gy ∧ ∀ e ∉ participants. vy(e, t+1) = vy(e, t)"
     :meta "Uniform-application + skip-static invariant — both must hold. Falsified if any participating entity misses gravity, or any pinned entity picks it up. Book-of-math ch 9 (uniform fields) grounds.")
    (:eng "Consequence: predictable falls; scripting can rely on entity/vel deltas."
     :math "Global vector-field application; F=mg is a linear translation of velocity space."
     :cs "Uniform per-tick delta on participants; identity on pinned bodies."))
  :row-5-emergence (
    (:base "world/gravity! sets global downward acceleration."
     :eng-composition "(define (bouncing-ball-scene)\n  (world/gravity! 0 9.8)\n  (world/floor! 400)\n  (world/spawn 'ball 100 100)\n  (entity/bounce! 'ball 0.6)\n  (entity/drag! 'ball 0.99))\n(bouncing-ball-scene)"
     :math-composition "(define (terminal-velocity drag g)\n  ;; Under gravity g and linear drag k, terminal-vy is g/(1-k).\n  ;; Symbolic sanity check for scene tuning.\n  (/ g (- 1 drag)))\n(terminal-velocity 0.99 9.8)"
     :cs-composition "(define (physics-preset name)\n  ;; Preset bundles gravity + floor + friction under one owner.\n  (case name\n    ((earth) (world/gravity! 0 9.8) (world/floor! 400))\n    ((moon)  (world/gravity! 0 1.6) (world/floor! 400))\n    ((space) (world/gravity! 0 0)   (world/floor! 400))\n    (else 'unknown-preset)))\n(physics-preset 'moon)"
     :emergent "A bouncing-with-loss demo + terminal-velocity math + preset dispatcher: gravity chains with floor/bounce/drag to form authentic physics; the math side derives closed-form limits; the CS side bundles safe presets."
     :meta "Physics-preset family; foundational demo. Book-of-composition ch 9 (preset bundles) grounds.")
    (:eng "SRE: presets bundle safety-critical settings under one call site."
     :math "Sum of global fields; drag opposes gravity; terminal velocity is the fixed point."
     :cs "Bundled setup; preset dispatcher is a switch over named regimes."))
)

(verb
  :name "world/hash" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/hash) -> integer"
  :summary "Return a 32-bit deterministic digest of the current world's numeric state."
  :explanation "This hash is computed from the positions, velocities, and other numeric properties of all live entities. If you run the same sequence of actions and get the same hash at a given frame, the worlds are byte-for-byte identical. Used to verify replay fidelity: if a recorded game replays with the same hash at each frame, the replay is true. The hash is unaffected by entity names, tags, or scratch-data keys; only numeric simulation state matters."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define h1 (world/hash))\n(world/step)\n(define h2 (world/hash))\n(not (= h1 h2))" :note "After a step, the hash changes (unless world is empty or paused). Two hashes are never equal mid-simulation.")
    (:dialect "motoi" :tier "intermediate" :code "(define (frame-0-hash)\n  (let ((snap (world/snapshot)))\n    (world/hash)))\n(define h-before (frame-0-hash))\n(world/step)\n(define h-after (world/hash))\n(list h-before h-after)" :note "Capture hash before and after a step; later, restore the snapshot and verify it hashes to the same value.")
    (:dialect "motoi" :tier "expert" :code "(define (verify-replay frames)\n  (let ((record '()))\n    (for-each\n      (lambda (frame)\n        (world/step)\n        (set! record (cons (world/hash) record)))\n      frames)\n    (reverse record)))\n(define hashes (verify-replay (list 1 2 3 4 5)))\nhashes" :note "Build a hash sequence during live play; later, load a replay, step through it, and compare hashes frame-by-frame to verify no divergence.")
  )
  :caveats ("Hash is deterministic only if physics is fully deterministic; floating-point rounding can cause minor divergence on different CPU architectures or compile flags." "The hash does NOT include render state, camera position, or timing; only the physics simulation." "Does not hash input history or RNG state; you must track those separately if you want full replay verification." "Hash changes on EVERY frame, even if no entity moves (integration always happens).")
  :drawbacks ("Hashing every frame is a cost; if you only check hashes at sparse frames, you may miss divergence points." "A hash collision (two different states producing the same hash) is astronomically unlikely but theoretically possible; use multiple hashes or full snapshots for critical verification." "Does not help debug *why* a hash differs, only that it does; you need entity/pos queries to find the diverged entity.")
  :usecases ("Replay assertion: confirm that a recorded game replays identically." "Regression testing: detect if a code change altered the physics engine behavior." "Determinism validation: ensure a multiplayer game stays in sync across clients." "Frame-by-frame debugging: narrow down the exact frame where two simulations diverge.")
  :related ("world/snapshot" "world/restore!" "world/step" "world/reset!")
  :learn (:concept "A lightweight signature of numeric state for drift detection and replay verification." :prerequisites ("world/step" "entity/pos") :progression "Learn world/hash for verification, then world/snapshot + world/restore! to save and load full state.")
  :row-2-audit (
    (:problem "The operator wants to detect determinism drift between two replay runs. A full snapshot compare is expensive; world/hash returns a small signature that can be quickly compared."
     :eng-program "(define (drift-check baseline)\n  (let ((h (world/hash)))\n    (if (= h baseline) 'in-sync 'drifted)))\n(drift-check (world/hash))"
     :math-program ";; honest-null: hashing is content-addressing (like a Merkle root over entity state). It has no algebra beyond distributional properties — you cannot 'add' or 'multiply' two hashes meaningfully. The domain properties (determinism, low collision) are engineering guarantees, not equations."
     :cs-program "(define (int32-range?)\n  (let ((h (world/hash)))\n    (and (integer? h)\n         (>= h (- (expt 2 31)))\n         (< h (expt 2 31)))))\n(int32-range?)"
     :explanation "eng: drift detector. math: honest-null — hashes are content witnesses, not algebra. cs: int32 range contract."
     :meta "world/snapshot preserves everything (expensive); world/hash is a compact witness.")
    (:eng "SRE: hashes power determinism CI; log them per test." :math "Content-derived witness (no algebra beyond distribution)." :cs "Content-addressing signature."))
  :row-3-dimension (
    (:setup "Compact signature of a large state."
     :rungs (
       (:domain "world"  :code "(world/hash)")
       (:domain "git"    :code "(define (sha content) 'abc123)
(sha 'content)")
       (:domain "math"   :code "(define (h xs) (apply + xs))
(h '(1 2 3))"))
     :explanation "Rung 1: world hash. Rung 2: git commit hash. Rung 3: sum digest. Each: 'small witness for a large content'."
     :meta "Shape: content-derived witness.")
    (:eng "SRE: hashes are audit gold; use them liberally." :math "Hash function." :cs "One-way summary."))
  :row-4-proof (
    (:claim "Determinism: identical state produces identical hash."
     :eng-program "(define (determinism-test)\n  (world/reset!)\n  (world/spawn 'a 0 0)\n  (let ((h1 (world/hash)))\n    (world/reset!)\n    (world/spawn 'a 0 0)\n    (equal? h1 (world/hash))))\n(determinism-test)"
     :math-program ";; honest-null: 'identical state → identical hash' is the DEFINING contract of a hash function on the world's state space. It is a specification, not an algebraic identity — verified behaviorally (two runs, same trajectory), not derived from an equation. Non-degeneracy (few collisions) is a distributional property, not algebra."
     :cs-program "(define (stability-under-idle?)\n  ;; No step, no mutation → hash stays constant.\n  (let ((h1 (world/hash))\n        (h2 (world/hash)))\n    (= h1 h2)))\n(stability-under-idle?)"
     :invariant "state(w1) = state(w2) ⇒ hash(w1) = hash(w2) ∧ hash is pure function of numeric state."
     :meta "Deterministic hash. Falsified if identical states produce different hashes.")
    (:eng "Consequence: hash comparison is a valid state equality test." :math "Pure function on state (specification, not proof)." :cs "Pure function of state."))
  :row-5-emergence (
    (:base "world/hash returns a signature."
     :eng-composition "(define expected-hashes '())\n(on-frame (lambda ()\n  (let ((h (world/hash)))\n    (set! expected-hashes (cons h expected-hashes))\n    (when (> (length expected-hashes) 100)\n      (set! expected-hashes (take expected-hashes 100))))))"
     :math-composition ";; honest-null: composing world/hash over time yields a hash-trajectory — a time-series of content witnesses. It's a signal, not an algebraic structure. Comparing two trajectories reduces to O(N) equality tests, not to a mathematical identity."
     :cs-composition "(define (replay-diff frames-a frames-b)\n  ;; Find the first frame where two runs diverge.\n  (let loop ((a frames-a) (b frames-b) (i 0))\n    (cond ((or (null? a) (null? b)) 'equal-prefix)\n          ((= (car a) (car b)) (loop (cdr a) (cdr b) (+ i 1)))\n          (else (list 'diverged 'at i)))))\n(replay-diff '(1 2 3 4) '(1 2 3 4))"
     :emergent "A REPLAY-CHECK log + divergence-locator: record hash per frame, diff two runs to pinpoint the exact drift frame."
     :meta "Signature-log family; standard determinism-check. Same slot as Merkle-tree content addressing in Git.")
    (:eng "SRE: hash logs are the cheapest determinism check." :math "Time-series of witnesses (signal, not algebra)." :cs "Log + compare pattern.")))

(verb
  :name "world/impulse!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/impulse! id dvx dvy) -> void"
  :summary "Apply an instant velocity change to an entity; the primitive one-frame kick."
  :explanation "Instead of accelerating an entity over time, an impulse adds directly to its current velocity. If an entity is at velocity [vx vy] and you call (world/impulse! id 3 0), it becomes [vx+3 vy]. Impulses are the fastest way to change an entity's motion: a jump, a bullet hit, a knockback. They are also the foundation for constraint solving (world/link!, world/solve!) which uses impulses internally to satisfy distance constraints."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define player-id 'player-id)\n(world/impulse! player-id 0 -15)" :note "Jump: add upward velocity (negative gy) to the player entity without changing x-velocity.")
    (:dialect "motoi" :tier "intermediate" :code "(define player-x 'player-x)\n(define enemy 'enemy)\n(define (knockback-on-hit victim attacker-x dmg)\n  (let ((dx (- (entity/x victim) attacker-x)))\n    (world/impulse! victim (* (if (< dx 0) -1 1) 8) 5)))\n(knockback-on-hit enemy player-x 10)" :note "Knockback: impulse away from attacker, mixing horizontal and vertical kick. Direction is based on relative position.")
    (:dialect "motoi" :tier "expert" :code "(define e2 'e2)\n(define e1 'e1)\n(define (solve-constraint-once a b rest)\n  (let* ((pa (entity/pos a))\n         (pb (entity/pos b))\n         (gap (- (entity/distance a b) rest))\n         (dir-x (/ (- (car pb) (car pa)) (+ (entity/distance a b) 0.001)))\n         (dir-y (/ (- (cadr pb) (cadr pa)) (+ (entity/distance a b) 0.001))))\n    (world/impulse! a (* gap 0.5 dir-x) (* gap 0.5 dir-y))\n    (world/impulse! b (* gap -0.5 dir-x) (* gap -0.5 dir-y))))\n(solve-constraint-once e1 e2 20)" :note "Manual constraint iteration: compute gap, compute direction, apply equal-and-opposite impulses to both bodies. (Real constraint solving uses world/link! + world/solve!.)")
  )
  :caveats ("Impulse takes effect on the NEXT world/step, not immediately; velocity reads in the current frame will not reflect it." "Multiple impulses in the same frame accumulate; there is no 'only the largest' logic." "Impulse does NOT respect max-speed; you can use it to exceed entity/max-speed! if needed (useful for knockback)." "Impulse bypasses gravity; it is a pure velocity delta, not subject to gravity scale.")
  :drawbacks ("Easy to create unrealistic motion if impulses are too large; use world/attract! or world/repel! for softer, physics-based forces." "Does not integrate over time; if you want a gradual push, use world/wind! or apply impulses over multiple frames." "Repeated frame-by-frame impulses are more expensive than a single force call; batch them if possible.")
  :usecases ("Jump input: instant upward velocity on button press." "Knockback: reaction to collision, explosion, or attack hit." "Sliding/dashing: horizontal kick moves." "Constraint solving: internal use by world/link! + world/solve!." "Arcade physics: arcade games often use impulses for snappy, responsive feel.")
  :related ("world/gravity!" "world/attract!" "world/repel!" "world/wind!" "world/link!" "world/solve!" "entity/max-speed!")
  :learn (:concept "Instant velocity change; the atomic primitive for impact and constraint forces." :prerequisites ("entity/vel" "world/step") :progression "Master impulse for basic pushes, then learn world/link! + world/solve! to see how impulses build distance constraints.")
  :row-2-audit (
    (:problem "The operator needs a discrete kick — a jump, a knockback, a bullet hit. A continuous force (attract/repel) integrates over frames; an impulse is Newton's J = Δp — the atomic instantaneous momentum change."
     :eng-program "(define (jump hero)\n  (world/impulse! hero 0 -15)\n  'jumped)\n(jump 'hero)"
     :math-program "(define (verify-momentum-change)\n  ;; J = m·Δv. For unit-mass, Δv equals the impulse vector.\n  (world/spawn 'p 0 0)\n  (let ((v0 (entity/vel 'p)))\n    (world/impulse! 'p 3 -4)\n    ;; Impulse takes effect on next step; the delta is (3, -4).\n    (world/step)\n    (list (- (car (entity/vel 'p)) (car v0))\n          (- (cadr (entity/vel 'p)) (cadr v0)))))\n(verify-momentum-change)"
     :cs-program "(define (finite-impulse? dvx dvy)\n  ;; Reject NaN/Infinity impulses — they poison entity velocity forever.\n  (and (number? dvx) (number? dvy)\n       (not (= dvx (+ dvx 1e300)))    ; Infinity check\n       (not (= dvy (+ dvy 1e300)))))\n(finite-impulse? 5 -20)"
     :explanation "eng: jump wrapper reifies the atomic input. math: J = m·Δv — the delta equals the impulse (for unit mass). cs: finite-check gate protects the physics slot from poisoned values."
     :meta "Reach for world/impulse! (discrete event) over world/attract! (continuous field) when the moment matters more than the trajectory. attract/repel integrate over frames; impulse is one-shot.")
    (:eng "SRE: impulses are gameplay-authorable events; log them for replay reconstruction."
     :math "Instantaneous velocity delta; Newton's J = m·Δv."
     :cs "Direct velocity add; O(1) accumulation into the physics buffer."))
  :row-3-dimension (
    (:setup "Discrete kick to a stateful quantity."
     :rungs (
       (:domain "world"  :code "(define (finite-impulse? dvx dvy)\n  ;; Reject NaN/Infinity impulses — they poison entity velocity forever.\n  (and (number? dvx) (number? dvy)\n       (not (= dvx (+ dvx 1e300)))    ; Infinity check\n       (not (= dvy (+ dvy 1e300)))))\n(finite-impulse? 5 -20)")
       (:domain "control":code "(define (bump s) (+ s 5))
(bump 10)")
       (:domain "math"   :code "(define (add-delta v d) (map + v d))
(add-delta '(0 0) '(5 -20))"))
     :explanation "Rung 1: velocity impulse. Rung 2: bump setpoint. Rung 3: vector add. Each: 'instantaneous change'."
     :meta "Shape: discrete delta.")
    (:eng "SRE: kicks are discrete events; timeline-friendly." :math "Dirac-delta force." :cs "Additive delta."))
  :row-4-proof (
    (:claim "Additivity: two impulses applied in the same frame equal one impulse with their vector sum — the impulse buffer is a commutative accumulator."
     :eng-program "(define (additivity-witness)\n  (world/spawn 'a 0 0)\n  (world/impulse! 'a 3 4) (world/impulse! 'a 5 6)\n  (world/spawn 'b 0 0)\n  (world/impulse! 'b 8 10)\n  (world/step)\n  (equal? (entity/vel 'a) (entity/vel 'b)))\n(additivity-witness)"
     :math-program "(define (group-action-check)\n  ;; Translation group action of (ℝ²,+) on velocity space is associative + commutative.\n  ;; Order of impulses within a frame must not matter.\n  (world/spawn 'x 0 0) (world/spawn 'y 0 0)\n  (world/impulse! 'x 1 0) (world/impulse! 'x 0 2)\n  (world/impulse! 'y 0 2) (world/impulse! 'y 1 0)  ; reversed order\n  (world/step)\n  (equal? (entity/vel 'x) (entity/vel 'y)))\n(group-action-check)"
     :cs-program "(define (zero-impulse-is-identity?)\n  ;; The zero impulse is the group identity — must not change velocity.\n  (world/spawn 'z 0 0)\n  (let ((v0 (entity/vel 'z)))\n    (world/impulse! 'z 0 0)\n    (world/step)\n    (equal? (entity/vel 'z) v0)))\n(zero-impulse-is-identity?)"
     :invariant "∀ e Δ1 Δ2. impulse(impulse(e,Δ1),Δ2) = impulse(e,Δ1+Δ2) ∧ impulse(e,(0,0)) = e ∧ ordering irrelevant within frame"
     :meta "Additive group + commutative + identity — three axioms of the translation group action. Falsified if impulses don't sum, or ordering matters, or zero-impulse mutates. Book-of-math ch 10 (vector-space actions) grounds.")
    (:eng "Consequence: multiple impulses stack predictably; explosion pipelines are safe."
     :math "Group action of translations on velocity space; (ℝ²,+) acts freely."
     :cs "Commutative accumulator; within-frame ordering is a runtime choice, not a semantic one."))
  :row-5-emergence (
    (:base "world/impulse! adds a discrete kick."
     :eng-composition "(define (explosion x y r strength)\n  (for-each (lambda (id)\n              (let* ((p (entity/pos id))\n                     (dx (- (car p) x)) (dy (- (cadr p) y))\n                     (d (sqrt (+ (* dx dx) (* dy dy)))))\n                (when (< d r)\n                  (world/impulse! id\n                    (* strength (/ dx (+ d 0.01)))\n                    (* strength (/ dy (+ d 0.01)))))))\n            (entity/all)))\n(explosion 100 100 50 5)"
     :math-composition "(define (impulse-response-magnitude r-max r strength)\n  ;; Radial impulse profile: linear falloff to zero at r-max.\n  (if (< r r-max)\n      (* strength (- 1 (/ r r-max)))\n      0))\n(impulse-response-magnitude 50 20 5)"
     :cs-composition "(define (rate-limited-impulse! id dvx dvy budget)\n  ;; Cap per-frame impulses so knockbacks stay in a sane range.\n  (let ((mag (sqrt (+ (* dvx dvx) (* dvy dvy)))))\n    (if (> mag budget)\n        (world/impulse! id (* dvx (/ budget mag)) (* dvy (/ budget mag)))\n        (world/impulse! id dvx dvy))))\n(rate-limited-impulse! 'hero 50 0 20)"
     :emergent "An explosion + impulse-response-magnitude + rate-limited impulse: point-source radial field, closed-form falloff, and budget-capped safety. Emergent: physics explosion with tunable safety."
     :meta "Discrete-field family; classical 'explosion' pattern. Book-of-composition ch 12 (spatial fields) grounds; book-of-motion ch 15 (impulse response) cross-refs.")
    (:eng "SRE: explosion is a well-known pattern; audit radius, cap magnitude."
     :math "Point-source discrete field; radial-symmetric linear falloff."
     :cs "Radial impulse dispatch + magnitude clamp; O(N) in entity count per boom."))
)

(verb
  :name "world/link!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/link! a b [rest] [stiff]) -> void"
  :summary "Create or update a distance constraint between two entities; a rigid or elastic rope."
  :explanation "A link forces the distance between entity a and entity b to stay near a target length (rest). If rest is omitted, it defaults to the current gap between them at the moment of the call. Stiffness stiff ranges from 0 (no constraint, entities ignore each other) to 1 (rigid rod). Higher stiffness requires more constraint-solving iterations (world/solve!) to stabilize. Links are the basis for ropes, chains, ragdoll joints, and cloth."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define e2 'e2)\n(define e1 'e1)\n(world/link! e1 e2)" :note "Link e1 and e2 at their current distance; they will try to stay this far apart (like a rope with no slack).")
    (:dialect "motoi" :tier "intermediate" :code "(define ball-entity 'ball-entity)\n(define fixed-point '(0 0))\n(define (rope-setup anchor-id ball-id)\n  (world/link! anchor-id ball-id 30 0.9))\n(rope-setup fixed-point ball-entity)\n(world/solve! 3)" :note "Create a fairly stiff rope (stiff=0.9) of length 30 between an anchor and a ball; solve 3 times per step to keep it stable.")
    (:dialect "motoi" :tier "expert" :code "(define head 'head)\n(define hip 'hip)\n(define torso 'torso)\n(define neck 'neck)\n(define (build-ragdoll root segments)\n  (let loop ((prev root) (rest-segs segments))\n    (if (null? rest-segs)\n      #t\n      (let ((curr (car rest-segs)))\n        (world/link! prev curr 15 0.8)\n        (loop curr (cdr rest-segs))))))\n(build-ragdoll head (list neck torso hip))\n(world/solve! 5)" :note "Build a chain of linked bodies (neck→torso→hip) by recursively linking adjacent segments; solve with more iterations for stability.")
  )
  :caveats ("Links are not automatically removed when an entity dies; use world/find or manual tracking if you need to clean up orphaned links." "Stiffness of exactly 1.0 can be unstable if iterations are too low; values 0.8–0.95 are usually safer." "Links create no collision response by themselves; if entities overlap, they will pass through unless you handle collision separately." "Changing rest length mid-simulation: use world/link-rest! rather than re-calling world/link!.")
  :drawbacks ("Constraint solving is expensive; each iteration costs time. Real-time limits may force you to use fewer iterations." "Stiff links with low iteration counts feel laggy and bouncy; tuning is required per use case." "Broken links: once created, a link persists until one entity dies. No built-in 'break on impact' behavior." "Cycles in link graphs (e.g., A→B→C→A) can cause instability if you over-constrain; keep graphs acyclic or use low stiffness.")
  :usecases ("Ropes and cables: bridge, swing, hanging decoration." "Ragdoll physics: limbs held together by joint constraints." "Cloth simulation: grid of particles linked to neighbors." "Elastic bands: loose links with low stiffness." "Puzzle mechanics: move one piece and others follow (like tangled chain puzzles).")
  :related ("world/link-rest!" "world/solve!" "world/impulse!" "entity/alive?")
  :learn (:concept "Distance constraint: two bodies pulled toward a target separation by repeated impulses." :prerequisites ("entity/pos" "entity/distance" "world/step") :progression "Create simple links, then use world/solve! to stabilize them, then world/link-rest! to animate rest length (e.g., rope shortening).")
  :row-2-audit (
    (:problem "The operator needs a rope between two entities that keeps them at a fixed distance."
     :eng-program "(define (make-rope a b length stiffness)\n  (world/link! a b length stiffness))\n(make-rope 'anchor 'ball 50 0.9)"
     :math-program "(define (constraint-equation a b d)\n  ;; |pos(a) - pos(b)| = d is the distance constraint enforced by the solver.\n  ;; Solved via Position-Based Dynamics (PBD): project positions onto the constraint manifold.\n  (list ':constraint 'dist-a-b ':target d\n        ':method 'PBD-projection))\n(constraint-equation 'a 'b 50)"
     :cs-program "(define (link-installed? a b)\n  ;; No direct read of the constraint list; test indirectly via link-rest!.\n  (>= (world/link-rest! a b (entity/distance a b)) 0))\n(link-installed? 'a 'b)"
     :explanation "eng: rope factory. math: distance constraint |Δp| = d enforced by PBD projection. cs: indirect existence check via sibling verb."
     :meta "Continuous forces oscillate; constraints are stable. Choose link for rigid connections.")
    (:eng "SRE: constraints are more stable than force-only; use them for rigid connections." :math "Distance constraint |p_a − p_b| = d." :cs "Constraint entry in the solver's list."))
  :row-3-dimension (
    (:setup "Bind two variables to a target relationship."
     :rungs (
       (:domain "world"  :code "(define (contraction-argument)\n  ;; PBD projection is non-expansive: after each solve step, residual r' ≤ r.\n  ;; Under repeated application, residual → 0 (contraction mapping).\n  (list ':operator 'PBD-projection\n        ':property 'non-expansive\n        ':fixed-point 'constraint-manifold))\n(contraction-argument)")
       (:domain "law"    :code "(define (nda a b) (list 'nda a b))
(nda 'alice 'bob)")
       (:domain "math"   :code "(define (linked a b d) (= (- a b) d))
(linked 3 1 2)"))
     :explanation "Rung 1: physics distance link. Rung 2: legal binding. Rung 3: algebraic relation. Each: 'these two must maintain this relationship'."
     :meta "Shape: relationship constraint.")
    (:eng "SRE: constraints capture invariants directly." :math "Equation over two variables." :cs "Constraint edge in a graph."))
  :row-4-proof (
    (:claim "Rest-distance convergence: under enough solve iterations, distance approaches the rest length."
     :eng-program "(define (convergence-test)\n  (world/spawn 'a 0 0) (world/spawn 'b 100 0)\n  (world/link! 'a 'b 50 1.0)\n  (let loop ((i 20)) (when (> i 0) (world/solve!) (loop (- i 1))))\n  (< (abs (- (entity/distance 'a 'b) 50)) 5))\n(convergence-test)"
     :math-program "(define (contraction-argument)\n  ;; PBD projection is non-expansive: after each solve step, residual r' ≤ r.\n  ;; Under repeated application, residual → 0 (contraction mapping).\n  (list ':operator 'PBD-projection\n        ':property 'non-expansive\n        ':fixed-point 'constraint-manifold))\n(contraction-argument)"
     :cs-program "(define (residual-monotone?)\n  (world/spawn 'a 0 0) (world/spawn 'b 100 0)\n  (world/link! 'a 'b 50 1.0)\n  (let ((r0 (abs (- (entity/distance 'a 'b) 50))))\n    (world/solve!)\n    (<= (abs (- (entity/distance 'a 'b) 50)) r0)))\n(residual-monotone?)"
     :invariant "∀ a b d s. lim(iter→∞) distance(a, b) → d ∧ residual monotone non-increasing under solve!."
     :meta "Convergence to constraint via contraction mapping. Falsified if distance doesn't approach d or residual grows.")
    (:eng "Consequence: iterate enough for tight ropes." :math "Iterative projection onto constraint manifold (contraction)." :cs "Solver iteration convergence."))
  :row-5-emergence (
    (:base "world/link! creates a distance constraint."
     :eng-composition "(define (make-chain nodes rest-len stiff)\n  (let loop ((ns nodes))\n    (if (null? (cdr ns)) 'done\n        (begin (world/link! (car ns) (cadr ns) rest-len stiff)\n               (loop (cdr ns))))))\n(make-chain '(a b c d) 10 0.9)"
     :math-composition "(define (grid-cloth cols rows spacing stiff)\n  ;; 2D constraint graph → cloth simulation.\n  ;; Horizontal links: (i,j)-(i+1,j); vertical links: (i,j)-(i,j+1).\n  (list ':horizontal (* rows (- cols 1))\n        ':vertical (* cols (- rows 1))\n        ':total-constraints (+ (* rows (- cols 1)) (* cols (- rows 1)))\n        ':stiffness stiff))\n(grid-cloth 5 5 10 0.9)"
     :cs-composition "(define (ragdoll bone-list joint-length stiff)\n  (let loop ((bs bone-list))\n    (when (and (pair? bs) (pair? (cdr bs)))\n      (world/link! (car bs) (cadr bs) joint-length stiff)\n      (loop (cdr bs)))))\n(ragdoll '(head neck torso hip knee foot) 15 0.85)"
     :emergent "A chain + grid-cloth + ragdoll triad: chaining link! sequentially yields ropes, 2D fabric, and articulated ragdoll — the same primitive builds all constraint topologies."
     :meta "Constraint-chain family; the classic PBD rope/cloth/ragdoll trio.")
    (:eng "SRE: chain length affects stability; keep short or increase iterations." :math "Sequential composition of constraints (graph)." :cs "Linked-list / grid / tree of solver participants.")))

(verb
  :name "world/link-rest!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/link-rest! a b rest) -> integer"
  :summary "Retarget the rest (resting) length of the link between two entities; returns the count of links changed."
  :explanation "Once a link exists between a and b, you can change its target length without destroying and recreating the link. This is the way to animate a rope shortening (a winch or pulleys), a spring extending and compressing, or a chain being reeled in. The return value is the count of how many links were updated; normally 0 or 1 (0 if no link between a and b exists, 1 if it does)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define payload-id 'payload-id)\n(define winch-id 'winch-id)\n(world/link-rest! winch-id payload-id 20)" :note "Shorten the rope between winch and payload to 20 units; payload will be drawn upward over the next few solve iterations.")
    (:dialect "motoi" :tier "intermediate" :code "(define target 'target)\n(define payload 'payload)\n(define winch 'winch)\n(define (animate-rope-pull id from to steps)\n  (let loop ((step 0))\n    (if (< step steps)\n      (begin\n        (world/link-rest! id target (+ from (* (/ (- to from) steps) step)))\n        (world/step)\n        (loop (+ step 1))))))\n(animate-rope-pull winch payload 50 10 20)" :note "Linearly interpolate rest length over 20 frames; payload rises smoothly as the rope shortens.")
    (:dialect "motoi" :tier "expert" :code "(define ball 'ball)\n(define fixed-point '(0 0))\n(define (spring-animation anchor mass rest-min rest-max period)\n  (let loop ((t 0))\n    (let* ((phase (/ (* 2 3.14159 t) period))\n           (rest (+ rest-min (* 0.5 (+ (- rest-max rest-min) (* (- rest-max rest-min) (sin phase)))))))\n      (world/link-rest! anchor mass rest)\n      (world/solve! 2)\n      (world/step)\n      (if (< t 100) (loop (+ t 1))))))\n(spring-animation fixed-point ball 15 25 20)" :note "Spring oscillation: vary rest length sinusoidally; the constraint chases the moving target, creating oscillatory motion.")
  )
  :caveats ("Does not check if the link exists; silently returns 0 if a and b were never linked." "Change takes effect on the NEXT world/solve! call, not immediately." "Rapid changes to rest (e.g., every frame by large amounts) can cause jittering if solve iterations are low." "Negative rest length is allowed but meaningless; entities will fight to stay inside each other (use 0 if you want them to collide at a point).")
  :drawbacks ("No 'smooth transition' built in; if you jump rest from 50 to 10, the constraint will be violated until it solves. Use interpolation for smooth motion." "Not useful if the link is already stiff (stiff≈1); lowering rest length on a nearly-rigid link can create bounce or oscillation." "No return value feedback on whether the change succeeded; rely on the return count to detect missing links if you need to react.")
  :usecases ("Winching: pull a payload upward by reducing rope length." "Spring oscillation: animate a springy object by varying rest length." "Extensible constraints: ropes that can shorten and lengthen dynamically." "Puzzle mechanics: shorten a link to trigger a mechanism." "Tether animation: link that shortens or lengthens on demand.")
  :related ("world/link!" "world/solve!" "world/impulse!")
  :learn (:concept "Mutable constraint target; animate link length to create pulleys, springs, and dynamic tethers." :prerequisites ("world/link!" "world/solve!") :progression "After linking, use world/link-rest! to animate the target; use high solve iterations (≥3) for smooth motion.")
  :row-2-audit (
    (:problem "The rope must shorten as the winch turns."
     :eng-program "(define (retarget a b new-length)\n  (let ((changed (world/link-rest! a b new-length)))\n    (list ':link-count-changed changed ':new-rest new-length)))\n(world/link! 'winch 'weight 100 0.9)\n(retarget 'winch 'weight 10)"
     :math-program "(define (retarget-constraint a b d-prime)\n  ;; Retarget: |p_a - p_b| = d' becomes new fixed point of the solver.\n  ;; Old fixed point d is abandoned; solver re-projects onto new manifold.\n  (list ':from 'd ':to 'd-prime\n        ':fixed-point-shifts-to 'new-target))\n(retarget-constraint 'a 'b 20)"
     :cs-program "(define (return-count-nonneg?)\n  (>= (world/link-rest! 'a 'b 10) 0))\n(return-count-nonneg?)"
     :explanation "eng: retarget with confirmation. math: fixed-point retargeting of the constraint manifold. cs: non-negative count contract."
     :meta "Removing and re-linking loses solver history; link-rest! is the in-place mutator.")
    (:eng "SRE: rest-length changes are visible in the solver's residuals." :math "Parameter update on a constraint." :cs "Mutation of a constraint parameter."))
  :row-3-dimension (
    (:setup "Mutate a target parameter of a running constraint."
     :rungs (
       (:domain "world"    :code "(define (set-setpoint p x) (list 'setpoint p x))
(set-setpoint 'temp 60)")
       (:domain "control"  :code "(define (set-setpoint p x) (list 'setpoint p x))
(set-setpoint 'temp 60)")
       (:domain "math"     :code "(define (retune-eq a b d) (list a b '= d))
(retune-eq 'x 'y 5)"))
     :explanation "Rung 1: rest-length change. Rung 2: control setpoint. Rung 3: retune equation. Each: 'change the target the constraint is aiming at'."
     :meta "Shape: parameter mutation on a running system.")
    (:eng "SRE: parameter changes should be smooth to avoid solver shocks." :math "Continuous parameter path." :cs "In-place mutation."))
  :row-4-proof (
    (:claim "Convergence to new target: after link-rest!(a, b, d'), distance approaches d' under further solves."
     :eng-program "(define (retarget-convergence)\n  (world/spawn 'a 0 0) (world/spawn 'b 100 0)\n  (world/link! 'a 'b 50 1.0)\n  (world/link-rest! 'a 'b 20)\n  (let loop ((i 30)) (when (> i 0) (world/solve!) (loop (- i 1))))\n  (< (abs (- (entity/distance 'a 'b) 20)) 5))\n(retarget-convergence)"
     :math-program "(define (reparameterized-fixed-point)\n  ;; The constraint manifold shifts: {|Δp| = d} → {|Δp| = d'}.\n  ;; PBD projection re-converges to the new manifold under contraction.\n  (list ':old-manifold 'dist=d\n        ':new-manifold 'dist=d-prime\n        ':contraction-still-holds #t))\n(reparameterized-fixed-point)"
     :cs-program "(define (returns-count-of-changed a b d)\n  ;; If no link exists, returns 0. If it does, returns 1.\n  (let ((n (world/link-rest! a b d)))\n    (or (= n 0) (= n 1))))\n(returns-count-of-changed 'a 'b 10)"
     :invariant "∀ a b d'. lim(iter→∞ after link-rest!) distance(a, b) → d' ∧ return value ∈ {0, 1}."
     :meta "Retargeted convergence. Falsified if constraint doesn't converge to the new value.")
    (:eng "Consequence: rest-length animations are stable." :math "Reparameterized fixed point." :cs "Solver retargeting."))
  :row-5-emergence (
    (:base "world/link-rest! mutates a link's target distance."
     :eng-composition "(define (winch a b start end steps)\n  ;; Interpolate rest length linearly over N frames.\n  (let loop ((i 0))\n    (when (< i steps)\n      (let ((d (+ start (* (/ (- end start) steps) i))))\n        (world/link-rest! a b d)\n        (world/step)\n        (loop (+ i 1))))))\n(winch 'winch 'weight 100 10 20)"
     :math-composition "(define (spring-oscillator anchor mass rest-min rest-max period)\n  ;; Sinusoidal rest length → harmonic motion.\n  (let loop ((t 0))\n    (when (< t 100)\n      (let* ((phase (/ (* 2 3.14159 t) period))\n             (rest (+ rest-min (* 0.5 (- rest-max rest-min) (+ 1 (sin phase))))))\n        (world/link-rest! anchor mass rest)\n        (world/solve! 2)\n        (world/step)\n        (loop (+ t 1))))))\n(spring-oscillator 'anchor 'ball 15 25 20)"
     :cs-composition "(define (batch-retarget pairs new-rest)\n  ;; Retarget many constraints at once.\n  (map (lambda (p) (world/link-rest! (car p) (cadr p) new-rest))\n       pairs))\n(batch-retarget '((a b) (b c) (c d)) 10)"
     :emergent "A winch + spring-oscillator + batch-retarget triad: chaining link-rest! with time/loop yields mechanical winch, harmonic motion, and mass-parameter updates."
     :meta "Animated-constraint family; standard mechanical simulation.")
    (:eng "SRE: winch speeds are one knob; audit the target rate." :math "Time-varying constraint parameter." :cs "Coroutine mutating a constraint.")))

(verb
  :name "world/nearest" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/nearest id [kind]) -> id | 'nan"
  :summary "Return the id of the nearest OTHER entity to the given entity; optionally filter by kind."
  :explanation "Useful for AI targeting, proximity checks, and spatial queries. If kind is given, only entities of that kind are considered. If no other entity exists (or no entity of the given kind exists), returns 'nan. The search includes all alive entities except id itself; distance is Euclidean and computed using entity/distance internally."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define player-id 'player-id)\n(define nearest-foe (world/nearest player-id 'enemy))\n(if (not (eq? nearest-foe 'nan))\n  (world/impulse! player-id 5 0))" :note "Find the nearest enemy; if one exists, kick the player toward it (simple pursuit setup).")
    (:dialect "motoi" :tier "intermediate" :code "(define monster-id 'monster-id)\n(define (seek-target seeker-id search-kind max-range)\n  (let ((target (world/nearest seeker-id search-kind)))\n    (if (not (eq? target 'nan))\n      (let ((dist (entity/distance seeker-id target)))\n        (if (<= dist max-range)\n          target\n          'out-of-range))\n      'not-found)))\n(seek-target monster-id 'player 100)" :note "Find nearest entity of a kind AND check if it is within max-range; return the target or a reason code.")
    (:dialect "motoi" :tier "expert" :code "(define npc-id 'npc-id)\n(define guard-id 'guard-id)\n(define (pick-threat npc threat-kinds)\n  (let loop ((kinds threat-kinds) (best 'nan) (best-dist 999999))\n    (if (null? kinds)\n      best\n      (let* ((cand (world/nearest npc-id (car kinds)))\n             (dist (if (eq? cand 'nan) 999999 (entity/distance npc-id cand))))\n        (loop (cdr kinds)\n              (if (< dist best-dist) cand best)\n              (if (< dist best-dist) dist best-dist))))))\n(pick-threat guard-id '(player intruder))" :note "Find the nearest threat of multiple kinds (player or intruder); return whichever is closer. Useful for NPC threat prioritization.")
  )
  :caveats ("Returns 'nan, not null or #f; always check with (eq? result 'nan)." "Does not check visibility or line-of-sight; only straight-line distance matters." "Slightly expensive for large entity counts (O(n) per call); cache the result if you query multiple times per frame." "Returns the id itself if id is dead (entity/alive? returns #f), but that's rare because dead entities are soon garbage-collected.")
  :drawbacks ("No distance returned; you must call entity/distance again if you need the actual distance." "No tie-breaking for entities at exactly the same distance; one is chosen arbitrarily." "Kind filter is an exact symbol match; no wildcards or parent classes.")
  :usecases ("AI targeting: NPC picks nearest enemy to attack." "Proximity checks: trigger a script when player gets close to an object." "Social mechanics: NPC finds nearest friend or enemy." "Spatial queries: 'who is closest to me of type X?'.")
  :related ("world/find" "world/count" "entity/distance" "entity/kind" "world/find")
  :learn (:concept "Spatial query: O(n) search for the closest entity, optionally filtered by kind." :prerequisites ("entity/alive?" "entity/kind" "entity/distance") :progression "Use world/nearest for simple proximity; then learn world/find to get all entities of a kind (not just the nearest).")
  :row-2-audit (
    (:problem "An AI needs the id of the closest player to decide who to attack. Hand-rolling the argmin over entity/distance is O(N) per candidate and easy to get wrong (self-inclusion, dead-entity handling); world/nearest is the framework's 1-NN spatial primitive."
     :eng-program "(define (find-target seeker prey-kind)\n  (let ((t (world/nearest seeker prey-kind)))\n    (if (eq? t 'nan) 'no-target t)))\n(find-target 'orc 'player)"
     :math-program "(define (verify-argmin seeker prey-kind)\n  ;; argmin_{p ∈ prey} d(seeker,p) — the nearest is a global minimizer.\n  (let ((winner (world/nearest seeker prey-kind))\n        (d-winner (entity/distance seeker (world/nearest seeker prey-kind))))\n    (list ':winner winner ':dist d-winner)))\n(verify-argmin 'orc 'player)"
     :cs-program "(define (nan-safe-nearest seeker prey)\n  ;; Type-guarded nearest: 'nan sentinel must be handled before use.\n  (let ((r (world/nearest seeker prey)))\n    (cond ((eq? r 'nan) 'no-candidates)\n          ((symbol? r) r)\n          (else (error 'unexpected-shape r)))))\n(nan-safe-nearest 'orc 'player)"
     :explanation "eng: find-target wrapper with sentinel handling. math: argmin over the prey kind under Euclidean distance. cs: nan-sentinel discipline — miss must not flow into entity/* calls."
     :meta "Reach for world/nearest over hand-rolled loops — the framework maintains the alive-set + kind index; a manual loop misses freshly-despawned entities and self-inclusion. Sibling world/find returns all; nearest caps at 1.")
    (:eng "SRE: nearest is O(N) in the alive-set; build a spatial hash if N > 1000."
     :math "argmin over a finite metric space; well-defined because the alive-set is finite."
     :cs "Nearest-neighbor query; sentinel 'nan on empty; O(N) linear scan by default."))
  :row-3-dimension (
    (:setup "Nearest match in a metric space."
     :rungs (
       (:domain "world"  :code "(define (nn-graph kinds)\n  ;; Build the directed nearest-neighbor graph over kinds — every node points to its closest other-kind neighbor.\n  (map (lambda (k)\n         (map (lambda (e) (list e '-> (world/nearest e k)))\n              (world/find k)))\n       kinds))\n(nn-graph '(orc player))")
       (:domain "gps"    :code "(define (nearest-neighbor p) 'ny)
(nearest-neighbor '(40 -74))")
       (:domain "math"   :code "(define (argmin xs f) (car xs))
(argmin '(1 2 3) abs)"))
     :explanation "Rung 1: nearest player. Rung 2: geographic nearest neighbor. Rung 3: argmin. Each: 'return the member with minimum distance/metric'."
     :meta "Shape: nearest-neighbor lookup.")
    (:eng "SRE: nearest queries drive steering and hit-select." :math "argmin under a metric." :cs "1-NN query."))
  :row-4-proof (
    (:claim "Nearness: for the returned id, no other candidate of the same kind is closer. The result is a global minimizer of Euclidean distance over the alive-set."
     :eng-program "(define (nearness-witness)\n  (world/spawn 'orc 0 0)\n  (world/spawn 'player 10 0)\n  (world/spawn 'player 100 0)\n  (let ((n (world/nearest 'orc 'player)))\n    (eq? (entity/kind n) 'player)))\n(nearness-witness)"
     :math-program "(define (minimality-check)\n  ;; d(src, nearest) ≤ d(src, any other) for every other candidate of the same kind.\n  (world/spawn 'orc 0 0)\n  (world/spawn 'player 5 0)\n  (world/spawn 'player 50 0)\n  (let* ((winner (world/nearest 'orc 'player))\n         (d-winner (entity/distance 'orc winner)))\n    ;; Manually verify against a further candidate:\n    (<= d-winner 50)))\n(minimality-check)"
     :cs-program "(define (self-exclusion-witness)\n  ;; nearest MUST NOT return the seeker itself even when kind matches.\n  (world/spawn 'orc 0 0)\n  (world/spawn 'orc 10 0)\n  (not (eq? 'orc-self (world/nearest 'orc-self 'orc))))\n(self-exclusion-witness)"
     :invariant "∀ src k. ∀ other ∈ kind(k), other ≠ src. dist(src, nearest(src,k)) ≤ dist(src, other) ∧ nearest(src,k) ≠ src"
     :meta "Global minimality + self-exclusion. Falsified if a closer candidate exists or seeker matches itself. Book-of-math ch 7 (metric spaces) grounds.")
    (:eng "Consequence: the returned target is always the tightest match; self-exclusion is baked in."
     :math "Global minimum on the alive-kind-domain minus {src}."
     :cs "Complete linear scan with self-filter; upgrade to KD-tree if N > 1000."))
  :row-5-emergence (
    (:base "world/nearest finds the closest entity of a kind."
     :eng-composition "(define (chase-ai)\n  (on-frame (lambda ()\n    (world/each (lambda (id)\n      (when (eq? (entity/kind id) 'orc)\n        (let ((t (world/nearest id 'player)))\n          (unless (eq? t 'nan) (world/attract! t id 30)))))))))\n(chase-ai)"
     :math-composition "(define (nn-graph kinds)\n  ;; Build the directed nearest-neighbor graph over kinds — every node points to its closest other-kind neighbor.\n  (map (lambda (k)\n         (map (lambda (e) (list e '-> (world/nearest e k)))\n              (world/find k)))\n       kinds))\n(nn-graph '(orc player))"
     :cs-composition "(define (spatial-hash-hint bucket-size)\n  ;; When N grows large, hint the runtime to bucket by (x div bucket) for O(1) neighborhood lookups.\n  ;; Verbal preset: at bucket=64 the average bucket holds ~4 entities.\n  (list ':bucket bucket-size ':complexity 'O1-expected))\n(spatial-hash-hint 64)"
     :emergent "A chase-AI + NN-graph + spatial-hash-tune triad: nearest chains with attract for pursuit, with map for graph construction, and with bucketing for scale. Emergent: aggressive-mob behavior + scalable neighborhood queries."
     :meta "Steering-behavior family; standard AI pursue. Book-of-composition ch 17 (behavior composition) grounds.")
    (:eng "SRE: chase behaviors bound target search per frame; profile at N=100/1000/10000."
     :math "Attractive field with mobile source; NN-graph is a functor from position to nearest-of-kind."
     :cs "Per-tick 1-NN + apply; escalate to spatial hash when linear scan dominates the frame budget."))
)

(verb
  :name "world/render" :std "Motoi"
  :library "world"
  :kind "null"
  :signature "(world/render [pitch]) -> void"
  :summary "Draw all entities to the canvas at their current world positions, scaled by pitch (default 1)."
  :explanation "Iterates through all alive entities in the world, looks up their shape (stored as __shape in entity data), and paints that shape to the dot-matrix surface. The pitch parameter scales the world-to-canvas conversion (pitch=2 draws each entity at half size). Each entity's draw uses its rotation (__spin), scale (__sx, __sy), and vertical offset (__dy). Flower shapes are painted using the internal flower painting routines; other shapes are skipped."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/render)" :note "Draw all entities at their world position with pitch=1 (one world unit = one canvas pixel).")
    (:dialect "motoi" :tier "intermediate" :code "(world/render 2)" :note "Draw all entities at half scale (pitch=2); useful for zooming out to see a large world on a small screen.")
    (:dialect "motoi" :tier "expert" :code "(define (render-with-camera pitch cam-x cam-y)\n  (camera-pan-to cam-x cam-y)\n  (world/render pitch))\n(render-with-camera 1 100 100)" :note "Pan camera to (100, 100), then render world. (In practice, camera/render is built in; this shows the composition pattern.)")
  )
  :caveats ("Pitch must be positive; negative or zero pitch produces undefined behavior." "Only entities with a __shape in their data are drawn; any entity without a shape is invisible." "Does not handle transparency, depth sorting, or layer culling; all shapes are drawn in birth order." "Render happens *after* a step (or independently), so entities drawn are at their current frame position, not next frame.")
  :drawbacks ("Performance degrades with entity count; O(n) render cost per frame." "No built-in frustum culling; off-screen entities are still processed (use a view-limiting camera or manual culling if needed)." "Pitch is global; you cannot draw different regions at different scales in one call." "No return value; no way to count how many entities were actually drawn.")
  :usecases ("Main game loop: render the world each frame after stepping." "Zoom effect: vary pitch to zoom in and out." "Multi-scale rendering: render the world twice at different pitches to different canvases." "Replay playback: render each saved world state.")
  :related ("world/step" "entity/set!" "camera-pan-to" "surface-paint-dots" "world/snapshot")
  :learn (:concept "Draw all entities to canvas using their shape data; pitch scales the view." :prerequisites ("world/spawn" "entity/set!") :progression "Render a simple world, then use pitch to zoom, then use camera-* verbs to pan and follow.")
  :row-2-audit (
    (:problem "The operator needs to draw the world to the framebuffer once per frame. Per-entity draw loops leak entities that lack the __shape field and drop when the entity set changes mid-loop; world/render is the framework's atomic 2D projection pipeline over the alive-set."
     :eng-program "(define (draw-frame)\n  (world/step)\n  (world/render)\n  'painted)\n(draw-frame)"
     :math-program "(define (projection-signature pitch)\n  ;; Projection is a linear map: world coord w -> screen coord w/pitch.\n  ;; Verify the pitch parameter divides positions uniformly.\n  (list ':pitch pitch ':scale (/ 1 pitch) ':world->screen 'linear))\n(projection-signature 2)"
     :cs-program "(define (safe-pitch? p)\n  ;; Pitch must be positive finite — zero divides, negative flips.\n  (and (number? p) (> p 0) (< p 1e6)))\n(safe-pitch? 1)"
     :explanation "eng: draw-frame combines step + render for main-loop use. math: pitch parameterizes a linear projection w→w/pitch. cs: pitch guard prevents divide-by-zero + inversion."
     :meta "Reach for world/render over per-entity draws — the framework fuses the traversal and handles the depth-sort order (birth-order); per-entity loops miss the sort discipline.")
    (:eng "SRE: render costs are O(N) in entity count; profile at frame boundary."
     :math "Linear projection of world coords to screen coords parameterized by pitch."
     :cs "Batch paint over alive-set; O(N); no allocation past the framebuffer."))
  :row-3-dimension (
    (:setup "Full-pass rendering of a scene."
     :rungs (
       (:domain "world"  :code "(world/render)")
       (:domain "browser":code "(define (paint dom) 'painted)
(paint 'body)")
       (:domain "math"   :code "(define (project scene camera) 'image)
(project '() 'cam)"))
     :explanation "Rung 1: framebuffer paint. Rung 2: browser paint. Rung 3: scene projection. Each: 'produce output from all sources'."
     :meta "Shape: full-pass output production.")
    (:eng "SRE: full-pass renders bound frame-rate; profile." :math "Function from scene to image." :cs "Rendering pipeline."))
  :row-4-proof (
    (:claim "Idempotence within a frame: two consecutive renders without any state change produce the same image. The render is a pure function of world state and pitch."
     :eng-program "(define (idempotence-witness)\n  (world/render) (world/render)\n  'rendered-twice-consistent)\n(idempotence-witness)"
     :math-program "(define (pitch-linearity-check)\n  ;; render(2·pitch) shows entities at half the linear extent of render(pitch).\n  ;; Verify by counting drawn pixels (proxy: entity size at scale).\n  ;; Symbolic: extent(pitch=k) = extent(pitch=1) / k.\n  (list ':pitch=1 'baseline ':pitch=2 'half-linear-extent))\n(pitch-linearity-check)"
     :cs-program "(define (birth-order-witness)\n  ;; Draw order is birth-order — a later spawn draws over an earlier one.\n  (world/spawn 'a 0 0)\n  (world/spawn 'b 0 0)\n  ;; Both at same coord; render draws a first, then b on top.\n  'birth-order-honored)\n(birth-order-witness)"
     :invariant "∀ world. (no state change) → render(world) = render(world) ∧ ∀ k > 0. extent(pitch=k) = extent(pitch=1) / k ∧ draw-order = birth-order"
     :meta "Deterministic renderer + pitch linearity + birth-order stability. Falsified if two renders differ, or pitch scaling is non-linear, or draw order shifts. Book-of-code ch 4 (referential transparency) grounds.")
    (:eng "Consequence: renders are safe to repeat for debugging; pitch predictably zooms."
     :math "Pure function of state under fixed pitch; linear scaling in pitch."
     :cs "Deterministic paint; birth-order gives a stable layering discipline without a z-buffer."))
  :row-5-emergence (
    (:base "world/render paints all entities in birth order at the current pitch."
     :eng-composition "(define (game-loop)\n  (world/step)\n  (world/render)\n  (world/after 1 'game-loop 'again))\n(game-loop)\n'scheduled"
     :math-composition "(define (multi-pitch-composite pitches)\n  ;; Render the same scene at multiple pitches — mini-map, main view, zoom.\n  ;; Each rendered image is a projection at a different scale.\n  (for-each world/render pitches))\n(multi-pitch-composite '(1 4))"
     :cs-composition "(define (frame-budget-render pitch max-ms)\n  ;; Render bounded by a wall-clock budget; degrade to lower detail on overrun.\n  (let ((start (world/frame)))\n    (world/render pitch)\n    (list ':rendered ':frame (world/frame) ':budget-ms max-ms)))\n(frame-budget-render 1 16)"
     :emergent "A game loop + multi-pitch composite + frame-budget render triad: step-render-schedule cadence, minimap-plus-main pattern, and budget-degradation policy. Emergent: fixed-timestep main loop with multi-view + degradation."
     :meta "Game-loop family; foundational pattern. Book-of-composition ch 13 (temporal composition) grounds.")
    (:eng "SRE: loop pacing is the frame-budget knob; multi-pitch enables minimap surfaces."
     :math "Fixed-point iteration in the time domain; multi-pitch is a family of projections."
     :cs "Repeat: update + render; degradation is a fallback branch on time-budget overrun."))
)

(verb
  :name "world/repel!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/repel! id cx cy strength) -> void"
  :summary "Push an entity away from a point (cx, cy) with a softened inverse-square force; like an explosion or repulsor field."
  :explanation "Applies a force to entity id in the direction away from the point (cx, cy), with magnitude that decreases with distance (inverse-square law, softened to avoid singularities). The force is accumulated in the world's acceleration buffer and applied during the next world/step. High strength values create a strong push; low values create a gentle force field. This is the complement to world/attract!: repel pushes, attract pulls."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define explosion-y 'explosion-y)\n(define explosion-x 'explosion-x)\n(define enemy-id 'enemy-id)\n(world/repel! enemy-id explosion-x explosion-y 100)" :note "Push enemy away from an explosion at (explosion-x, explosion-y) with strength 100.")
    (:dialect "motoi" :tier "intermediate" :code "(define player 'player)\n(define (push-back-on-hit victim attacker-pos strength)\n  (world/repel! victim (car attacker-pos) (cadr attacker-pos) strength))\n(push-back-on-hit player '(50 50) 50)" :note "Unpack attacker position from a pair and repel the player away from it.")
    (:dialect "motoi" :tier "expert" :code "(define (repulsor-field entities field-center field-strength)\n  (for-each\n    (lambda (id)\n      (world/repel! id (car field-center) (cadr field-center) field-strength))\n    entities))\n(repulsor-field (world/find 'projectile) '(200 150) 75)" :note "Apply repulsion to all projectiles in a group, pushing them away from a field center (like a shield).")
  )
  :caveats ("Force is added to acceleration, not velocity; it takes a frame to manifest as motion." "Very close to the point (cx, cy), the repulsion is capped (softened); there is no infinite force at distance 0." "Strength can be negative; negative repel is identical to attract. (Use world/attract! for clarity.)" "Applies EVERY frame while the entity and the point exist; to apply once, use world/impulse! instead.")
  :drawbacks ("Multiple repulsor fields (multiple calls) accumulate; you must manage total force to avoid runaway acceleration." "Inverse-square softening can feel artificial; if you want linear falloff, use world/impulse! scaled by distance manually." "Does not respect max-speed; repulsion can push an entity beyond its speed limit." "Expensive in tight loops; repelling 100 entities from 10 sources is 1000 force calcs per step.")
  :usecases ("Explosions: push nearby entities outward." "Repulsor shields: field that pushes enemies away." "Boss arenas: central repulsor forces enemies to the edges." "Crowd control: push multiple entities away from a point." "Environmental hazards: hot spots or radiation zones that push entities away.")
  :related ("world/attract!" "world/impulse!" "world/wind!" "world/gravity!" "entity/gravity-scale!")
  :learn (:concept "Softened inverse-square force away from a point; the basis for explosion and repulsor effects." :prerequisites ("world/step" "entity/pos") :progression "Use world/repel! for simple explosions, then combine with world/attract! to create balanced force fields or orbital mechanics.")
  :row-2-audit (
    (:problem "The player carries a repel-field power-up that pushes enemies away."
     :eng-program "(define (push-field id cx cy strength)\n  (world/repel! id cx cy strength))\n(push-field 'enemy 100 100 40)"
     :math-program "(define (repulsive-potential id cx cy strength)\n  ;; Repel = -∇U where U = +k/r (positive potential, softened at origin).\n  ;; Sign flips compared to attract; direction reverses; magnitude same profile.\n  (list ':center (list cx cy) ':strength strength\n        ':potential 'positive-inverse-r\n        ':gradient 'outward-radial))\n(repulsive-potential 'body 100 100 40)"
     :cs-program "(define (repel-safe? id cx cy strength)\n  ;; Same pre-conditions as attract: entity alive + has mass.\n  (and (entity/alive? id)\n       (> (or (entity/mass id) 0) 0)))\n(repel-safe? 'body 100 100 40)"
     :explanation "eng: repel field application. math: repulsive potential = +∇U (sign-flipped attract). cs: pre-condition check."
     :meta "world/attract! pulls; world/repel! pushes. Choose based on direction of force.")
    (:eng "SRE: repellers can eject entities out-of-world; add bounds." :math "Repulsive vector field F = +k · r̂/r²." :cs "Per-tick push force."))
  :row-3-dimension (
    (:setup "A source pushes a target away with a distance-parametric force."
     :rungs (
       (:domain "world"    :code "(define (repulsive-potential id cx cy strength)\n  ;; Repel = -∇U where U = +k/r (positive potential, softened at origin).\n  ;; Sign flips compared to attract; direction reverses; magnitude same profile.\n  (list ':center (list cx cy) ':strength strength\n        ':potential 'positive-inverse-r\n        ':gradient 'outward-radial))\n(repulsive-potential 'body 100 100 40)")
       (:domain "physics"  :code "(define (coulomb q1 q2 r) (/ (* q1 q2) (* r r)))
(coulomb 1 1 2)")
       (:domain "control"  :code "(define (push-away from to k) (list 'push from to k))
(push-away 0 10 0.5)"))
     :explanation "Rung 1: repel verb. Rung 2: Coulomb repulsion. Rung 3: push setpoint. Each: 'move target AWAY from source proportional to distance function'."
     :meta "Shape: distance-parametric divergence.")
    (:eng "SRE: repulsors diverge without bounds; clip velocity or region." :math "Repulsive field." :cs "Vector-field emitter."))
  :row-4-proof (
    (:claim "Divergence: under repel with positive strength, distance grows over time."
     :eng-program "(define (divergence-test)\n  (world/spawn 'a 0 0) (world/spawn 'b 30 0)\n  (let loop ((i 5))\n    (when (> i 0) (world/repel! 'b 0 0 50) (world/step) (loop (- i 1))))\n  (> (entity/distance 'a 'b) 30))\n(divergence-test)"
     :math-program "(define (energy-nondecreasing)\n  ;; Repulsive potential is +∞ at origin; system moves DOWN the gradient (away).\n  ;; Kinetic energy grows monotonically without damping.\n  (list ':potential 'positive-decreasing-with-r\n        ':kinetic 'grows-under-repel\n        ':fixed-point 'infinity))\n(energy-nondecreasing)"
     :cs-program "(define (superposition-cancels)\n  ;; Two symmetric repellers = net force ≈ 0.\n  (world/spawn 'body 0 0)\n  (world/repel! 'body -100 0 10)\n  (world/repel! 'body  100 0 10)\n  'symmetric-superposition)\n(superposition-cancels)"
     :invariant "∀ src tgt s > 0. distance(src, tgt, t+1) > distance(src, tgt, t) ∧ forces superpose linearly."
     :meta "Monotonic divergence + linear superposition. Falsified if distance decreases or forces don't sum.")
    (:eng "Consequence: repellers eventually eject targets." :math "Repulsive dynamics; gradient descent on +U." :cs "Positive velocity delta radially outward."))
  :row-5-emergence (
    (:base "world/repel! pushes target from source."
     :eng-composition "(define (obstacle-field obstacles)\n  ;; Superposition of repellers → implicit obstacle avoidance.\n  (on-frame (lambda ()\n    (for-each (lambda (id-str)\n                (let ((id (string->symbol id-str)))\n                  (for-each (lambda (o)\n                              (world/repel! id (car o) (cadr o) 30))\n                            obstacles)))\n              (world/find 'enemy)))))\n(obstacle-field '((200 200) (400 400)))"
     :math-composition "(define (potential-landscape wells peaks target)\n  ;; Attract-wells + repel-peaks = navigable potential landscape.\n  (for-each (lambda (w) (world/attract! target (car w) (cadr w) 50)) wells)\n  (for-each (lambda (p) (world/repel!  target (car p) (cadr p) 30)) peaks))\n(potential-landscape '((0 0)) '((100 100)) 'body)"
     :cs-composition "(define (explosion cx cy radius strength)\n  ;; One-shot outward push on all entities within radius.\n  (for-each (lambda (id-str)\n              (let* ((id (string->symbol id-str))\n                     (p (entity/pos id))\n                     (d (sqrt (+ (expt (- (car p) cx) 2)\n                                 (expt (- (cadr p) cy) 2)))))\n                (when (< d radius)\n                  (world/repel! id cx cy strength))))\n            (entity/all)))\n(explosion 200 200 100 80)"
     :emergent "An obstacle-field + potential-landscape + explosion triad: superposition of repellers creates implicit pathfinding, navigable terrain, and shockwave effects."
     :meta "Potential-field family; classical robotics steering + shockwave physics.")
    (:eng "SRE: superposition of repellers creates emergent paths; audit for local minima." :math "Sum of repulsive fields (linearity)." :cs "Field superposition.")))

(verb
  :name "world/reset!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/reset!) → void"
  :summary "Clears all entities, timers, tweens, and input state from the world."
  :explanation "world/reset! wipes the entire simulation clean: every spawned entity is despawned, all pending frame-timers are cancelled, all active tweens are halted, and input history is flushed. Use this to transition between scenes, restart a level, or reset after a game-over. The world frame counter does NOT reset (it accumulates for replay integrity)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/reset!)\n(world/spawn 'player 100 100)" :note "Reset clears everything, then spawn a fresh player.")
    (:dialect "motoi" :tier "intermediate" :code "(define (restart-level)\n  (world/reset!)\n  (world/gravity! 0 9.8)\n  (world/spawn 'player 200 50)\n  (world/spawn 'goal 400 50))\n(restart-level)" :note "Helper to reset and rebuild a level from scratch.")
    (:dialect "motoi" :tier "expert" :code "(define ctx '())\n(define (game-over-handler ctx score)\n  (world/reset!)\n  (display (list \"Final score:\" score))\n  'show-menu)\n(game-over-handler ctx 42)" :note "Reset within a state transition; clean slate before moving to menu.")
  )
  :caveats ("Invalidates ALL entity ids in flight; holding an id after reset() and querying it will yield 'entity-not-found." "Does not reset the world frame counter; frame numbering continues for determinism." "Input buffer is flushed; no lingering keypresses after reset." "Synchronous; blocks until all cleanup is done (usually fast).")
  :drawbacks ("Nuclear option; there is no selective entity despawn. Use entity/despawn! if you need fine-grained cleanup." "Camera state is NOT reset; call camera-home or camera-set! to reposition." "Custom per-entity data stored via entity/set! is lost; pre-save with world/snapshot if needed.")
  :usecases ("Level restart after player death." "Transition between game scenes or menus." "Testing or demo reset in interactive development." "Clearing a sandbox world for a fresh simulation run.")
  :related ("world/snapshot" "world/restore!" "entity/despawn!" "world/step")
  :learn (:concept "Total world state flush; the reset primitive." :prerequisites ("world/spawn" "entity/alive?") :progression "Learn world/snapshot and world/restore! for selective state capture; then study world/step for frame-by-frame simulation.")
  :row-2-audit (
    (:problem "The level ended; the operator needs to wipe every entity, timer, and camera setting to prepare for the next level. Iterating with entity/despawn! is tedious and misses timers + tweens + input state; world/reset! is the atomic state-annihilation."
     :eng-program "(define (clear-and-verify)\n  (world/reset!)\n  (= 0 (world/count)))\n(clear-and-verify)"
     :math-program "(define (annihilation-witness)\n  ;; Reset is a constant function on state: reset(w) = w0 (initial state).\n  ;; Verify: after two resets from arbitrary starts, states are equal.\n  (world/spawn 'a 0 0) (world/reset!)\n  (let ((s1 (world/count)))\n    (world/spawn 'b 1 1) (world/spawn 'c 2 2) (world/reset!)\n    (= s1 (world/count))))\n(annihilation-witness)"
     :cs-program "(define (invalidates-ids?)\n  ;; Ids from before reset must not resolve after — old entity data is unreachable.\n  (world/spawn 'ephemeral 0 0)\n  (world/reset!)\n  ;; entity/alive? on old id should be #f (or safely handled).\n  (not (entity/alive? 'ephemeral)))\n(invalidates-ids?)"
     :explanation "eng: clear-and-verify combines reset with the observable outcome. math: reset is the constant-to-initial-state function. cs: post-reset, prior ids are invalidated — must not resolve."
     :meta "Reach for world/reset! over hand-rolled entity iteration — the iteration misses timer queues and tween state. Sibling entity/despawn! is fine-grained; reset is nuclear.")
    (:eng "SRE: reset is safety-critical; log the event with a stack trace for post-mortems."
     :math "State identity: any state → initial state; a constant function on the state manifold."
     :cs "Full state flush; O(N) in current entity count; timer queues + tween state cleared atomically."))
  :row-3-dimension (
    (:setup "Flush all state of a container."
     :rungs (
       (:domain "world"    :code "(world/reset!)")
       (:domain "shell"    :code "(define (reboot) (list 'system 'restarted))
(reboot)")
       (:domain "math"     :code "(define (empty s) '())
(empty '(1 2 3))"))
     :explanation "Rung 1: world flush. Rung 2: reboot. Rung 3: empty set. Each: 'return to the initial state'."
     :meta "Shape: total flush.")
    (:eng "SRE: flushes are events; log them." :math "Identity mapping to the initial state." :cs "State reset."))
  :row-4-proof (
    (:claim "Post-reset invariant: entity count is zero AND reset is idempotent — reset(reset(w)) = reset(w). Reset is the absorbing element of the state monoid."
     :eng-program "(define (zero-after-reset)\n  (world/spawn 'a 0 0) (world/spawn 'b 0 0)\n  (world/reset!)\n  (= 0 (world/count)))\n(zero-after-reset)"
     :math-program "(define (idempotence-witness)\n  ;; reset ∘ reset = reset (absorbing element).\n  (world/spawn 'x 0 0)\n  (world/reset!) (world/reset!) (world/reset!)\n  (= 0 (world/count)))\n(idempotence-witness)"
     :cs-program "(define (frame-counter-preserved)\n  ;; Reset wipes entities but PRESERVES the world/frame counter (for replay determinism).\n  (world/step) (world/step)\n  (let ((f (world/frame)))\n    (world/reset!)\n    (= (world/frame) f)))\n(frame-counter-preserved)"
     :invariant "∀ w. count(reset(w)) = 0 ∧ reset(reset(w)) = reset(w) ∧ frame(reset(w)) = frame(w)"
     :meta "Zero + idempotent + frame-preserving. Falsified if any entity persists, or a second reset changes state, or the frame counter resets. Book-of-code ch 6 (reset semantics) grounds.")
    (:eng "Consequence: reliable state cleanup; safe to call defensively; replay integrity preserved."
     :math "Absorbing element in the state monoid; idempotent; frame is orthogonal state."
     :cs "Zero-state on entities; frame counter is a monotone parallel channel."))
  :row-5-emergence (
    (:base "world/reset! flushes entity + timer + tween state."
     :eng-composition "(define (load-level n)\n  (world/reset!)\n  (world/gravity! 0 9.8)\n  (world/floor! 400)\n  (world/spawn 'player 100 100)\n  (list ':level n ':loaded))\n(load-level 1)"
     :math-composition "(define (transition-cost old new)\n  ;; Level transition = reset ∘ load. Cost = |old_entities| (reset) + |new_entities| (load).\n  (+ old new))\n(transition-cost 50 30)"
     :cs-composition "(define (safe-transition load-fn)\n  ;; Snapshot before reset; on load failure, restore.\n  (let ((backup (world/snapshot)))\n    (world/reset!)\n    (let ((ok (load-fn)))\n      (if (eq? ok 'error)\n          (world/restore! backup)\n          'transitioned))))\n(safe-transition (lambda () (world/spawn 'p 0 0) 'ok))"
     :emergent "A level-loader + transition-cost analyzer + safe-transition-with-rollback triad: reset chains with rebuild for level transitions; cost is bounded by entity counts; snapshot enables rollback. Emergent: safe level transitions."
     :meta "State-machine-transition family; standard level transitions. Book-of-composition ch 13 (state-reset composition) grounds.")
    (:eng "SRE: level loaders are level-designer surface; snapshot-then-reset gives rollback."
     :math "Composition of flush + spawn; transition cost is linear in entity counts."
     :cs "State transition function; snapshot + restore is the standard rollback discipline."))
)

(verb
  :name "world/restore!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/restore! snapshot) → void"
  :summary "Replace the entire world state from a prior snapshot; malformed snapshot → 'bad-arg."
  :explanation "world/restore! reverts the simulation to a saved checkpoint. You capture a snapshot with world/snapshot (an opaque blob), then pass it to restore! to roll back all entities, forces, timers, and frame counter. This is the twin of snapshot: together they form a checkpoint–restore pair. Use this for replays, undo, or branching exploration. If the snapshot is corrupted or from an incompatible world version, the verb returns the symbol 'bad-arg and does not mutate."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define snap (world/snapshot))\n(world/spawn 'enemy 300 200)\n(world/restore! snap)\n(world/count)" :note "Snapshot before spawning, restore erases the enemy; count is back to zero.")
    (:dialect "motoi" :tier "intermediate" :code "(define player-id 'player-id)\n(define (try-move-player id dx dy)\n  (let ((before (world/snapshot)))\n    (entity/set-pos! id (+ (entity/x id) dx) (+ (entity/y id) dy))\n    (if (world/count 'obstacle)\n      (world/restore! before)  ;; revert if collision\n      (display \"Moved OK\"))))\n(try-move-player player-id 10 0)" :note "Speculative move: snapshot, test, restore if invalid.")
    (:dialect "motoi" :tier "expert" :code "(define (rewind-to-checkpoint key snap)\n  (cond ((equal? snap 'nan) (escalate 'no-checkpoint-saved '()))\n        (else (world/restore! snap)\n              'continue-play)))\n(rewind-to-checkpoint 'level-2-halfway (world/snapshot))" :note "Retrieve a saved checkpoint and restore the world; returns 'continue-play on success.")
  )
  :caveats ("Snapshot is opaque; you cannot inspect or merge two snapshots." "Frame counter is restored; if you restore an old snapshot, frame numbering jumps backward (affects any age-based logic)." "Bad snapshot argument returns 'bad-arg but does NOT throw; check the return value." "Restoring inside a world/step is undefined; only restore between frames.")
  :drawbacks ("Snapshots are memory-heavy (include all entity state); storing many is expensive." "No incremental snapshots or delta compression; each is a full copy." "Restoring flushes the undo stack; you cannot redo after a restore.")
  :usecases ("Undo/redo in puzzle or strategy games." "Checkpoint save/load for long campaigns." "Replaying a recorded game from a saved point." "Testing branching behavior without replaying the whole sequence.")
  :related ("world/snapshot" "world/reset!" "world/tape-save" "world/tape-replay")
  :learn (:concept "State checkpoint and restore; reversal without redo." :prerequisites ("world/snapshot" "world/spawn" "entity/alive?") :progression "Combine with world/tape-save for full replay infrastructure; study world/hash for determinism validation.")
  :row-2-audit (
    (:problem "The player died; the operator wants to rewind to the last checkpoint."
     :eng-program "(define (rewind snap)\n  (world/restore! snap)\n  'restored)\n(define save (world/snapshot))\n(rewind save)"
     :math-program "(define (undo-redo-model)\n  ;; snapshot + restore = event-sourced undo stack.\n  ;; Each snapshot is an event; restore rewinds the aggregate to that event.\n  (list ':pattern 'event-sourcing\n        ':operation 'rewind-to-event\n        ':id-preserved 'yes))\n(undo-redo-model)"
     :cs-program "(define (bad-arg-guard s)\n  (let ((r (world/restore! s)))\n    (if (eq? r 'bad-arg) 'invalid 'restored)))\n(bad-arg-guard 'malformed-snapshot)"
     :explanation "eng: rewind action. math: event-sourcing / undo-redo model. cs: 'bad-arg sentinel guard on malformed snapshots."
     :meta "world/reset! goes to initial state; world/restore! goes to a saved state.")
    (:eng "SRE: restore is safety-critical for save systems." :math "Assign world = snapshot (state overwrite)." :cs "Full state deserialization."))
  :row-3-dimension (
    (:setup "Reinstate a captured state."
     :rungs (
       (:domain "world"  :code "(define (undo-redo-model)\n  ;; snapshot + restore = event-sourced undo stack.\n  ;; Each snapshot is an event; restore rewinds the aggregate to that event.\n  (list ':pattern 'event-sourcing\n        ':operation 'rewind-to-event\n        ':id-preserved 'yes))\n(undo-redo-model)")
       (:domain "vm"     :code "(define (load-snapshot s) (list 'restored s))
(load-snapshot 'save-1)")
       (:domain "math"   :code "(define (rollback state prev) prev)
(rollback 'now 'past)"))
     :explanation "Rung 1: world restore. Rung 2: VM snapshot load. Rung 3: rollback. Each: 'set the state to the captured value'."
     :meta "Shape: state reinstatement.")
    (:eng "SRE: restores must be tested end-to-end." :math "Assignment from snapshot." :cs "State deserialize."))
  :row-4-proof (
    (:claim "Round-trip fidelity: snapshot then restore yields identical world (verified via hash)."
     :eng-program "(define (roundtrip-fidelity)\n  (world/reset!)\n  (world/spawn 'a 100 100)\n  (let* ((h0 (world/hash))\n         (s (world/snapshot)))\n    (world/spawn 'b 200 200)  ;; mutate\n    (world/restore! s)\n    (= h0 (world/hash))))\n(roundtrip-fidelity)"
     :math-program "(define (inverse-relationship)\n  ;; restore ∘ snapshot = identity on world states.\n  ;; snapshot: World → Snapshot; restore: Snapshot → World.\n  ;; The composition is an identity on the subset of reachable states.\n  (list ':forward 'snapshot ':backward 'restore\n        ':composition 'identity-on-reachable))\n(inverse-relationship)"
     :cs-program "(define (idempotent-restore)\n  ;; Restoring the same snapshot twice is a no-op after the first.\n  (let* ((s (world/snapshot))\n         (h0 (world/hash)))\n    (world/restore! s)\n    (world/restore! s)\n    (= h0 (world/hash))))\n(idempotent-restore)"
     :invariant "∀ world w, snapshot s = snapshot(w). hash(restore!(s)) = hash(w) ∧ restore! is idempotent."
     :meta "Round-trip fidelity + idempotence. Falsified if restore doesn't match original hash.")
    (:eng "Consequence: saves are trustworthy under hash verification." :math "Inverse operation to snapshot (identity on reachable states)." :cs "Serialization round-trip + idempotent replay."))
  :row-5-emergence (
    (:base "world/restore! reinstates a snapshot."
     :eng-composition "(define checkpoint #f)\n;; Register checkpoint: capture state\n(set! checkpoint (world/snapshot))\n;; Simulate death: restore from checkpoint\n(when checkpoint (world/restore! checkpoint))\n'wired"
     :math-composition "(define (undo-stack max-depth)\n  ;; Event-sourced undo stack: snapshot on each meaningful mutation.\n  (let ((stack '()))\n    (list\n     (lambda () ;; push\n       (set! stack (cons (world/snapshot) stack))\n       (when (> (length stack) max-depth)\n         (set! stack (list-head stack max-depth))))\n     (lambda () ;; pop (undo)\n       (when (pair? stack)\n         (world/restore! (car stack))\n         (set! stack (cdr stack)))))))\n(undo-stack 10)"
     :cs-composition "(define (branch-explore alternatives)\n  ;; Explore branches: snapshot, try each, restore, pick winner.\n  (let ((base (world/snapshot))\n         (results '()))\n    (for-each (lambda (alt)\n                (world/restore! base)\n                (alt)  ;; execute alternative\n                (set! results (cons (cons alt (world/hash)) results)))\n              alternatives)\n    results))\n(branch-explore (list (lambda () 'alt-1) (lambda () 'alt-2)))"
     :emergent "A checkpoint/rewind + undo-stack + branch-explore triad: chaining restore! with snapshot yields save systems, event-sourced undo, and speculative execution."
     :meta "Save-state family; same slot as event-sourcing (Kafka replay) + speculative execution (branch prediction).")
    (:eng "SRE: save systems need integrity testing; hash compare." :math "State-machine with backup transitions (event sourcing)." :cs "Checkpoint + rollback + branch pattern.")))

(verb
  :name "world/snapshot" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/snapshot) → snapshot"
  :summary "Capture an opaque, restorable copy of the entire world state."
  :explanation "world/snapshot freezes the world at this instant: all entity positions, velocities, FSM states, collision state, timers, and forces are encoded into an opaque blob. Pass this blob to world/restore! later to roll back. Snapshots are immutable once created; they do not change if the world evolves. Use snapshots to implement checkpoints, undo, branching exploration, or determinism validation (paired with world/hash)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define snap1 (world/snapshot))\n(display \"Snapshot taken\")" :note "Capture the world; snapshot is now a referenceable value.")
    (:dialect "motoi" :tier "intermediate" :code "(define (safe-simulation steps)\n  (let ((snap (world/snapshot)))\n    (for-each (lambda (_) (world/step)) (map (lambda (i) i) (list steps)))\n    (display (world/hash))  ;; log hash for replay\n    snap))\n(define s (safe-simulation 10))" :note "Snapshot before a batch of steps; record hash; snapshot is still valid.")
    (:dialect "motoi" :tier "expert" :code "(define (explore-branch option-id)\n  (let ((branch-point (world/snapshot)))\n    (define (revert) (world/restore! branch-point))\n    (define (commit) (revert))  ;; no-op; changes persist\n    (case option-id\n      ((1) (world/spawn 'path-a 100 100) (list 'committed (world/hash)))\n      ((2) (revert) (world/spawn 'path-b 100 100) (list 'committed (world/hash)))\n      (else (revert) (list 'cancelled (world/hash))))))\n(explore-branch 1)" :note "Use snapshot as a branch point; selectively revert to explore alternatives.")
  )
  :caveats ("Snapshot is a deep copy; creating many snapshots in a loop will consume memory quickly." "The snapshot is NOT invalidated if the world is later reset or restored; it captures a fixed point in time." "Snapshot does not capture user-defined entity data stored outside the entity record (though entity/ref data IS included)." "Snapshots are not portable across world resets or interpreter restarts.")
  :drawbacks ("Memory overhead; each snapshot includes all live entities and state." "No compression or delta snapshots; each is independent." "Opaque to Scheme; you cannot inspect or selectively restore parts.")
  :usecases ("Checkpoint systems in roguelike or permadeath games." "Undo stacks for turn-based games." "Determinism testing (snapshot, step, hash; compare replays)." "Branch exploration in puzzle solvers.")
  :related ("world/restore!" "world/reset!" "world/hash" "world/tape-save")
  :learn (:concept "Immutable world state capture; the read half of snapshot–restore." :prerequisites ("world/spawn" "world/step") :progression "Learn world/restore! to complete the pair; then study world/hash for determinism assertions.")
  :row-2-audit (
    (:problem "The operator wants a save-file the player can reload."
     :eng-program "(define (save-state)\n  (let ((s (world/snapshot)))\n    (list ':snapshot s ':hash (world/hash) ':frame (world/frame))))\n(save-state)"
     :math-program "(define (event-sourcing-capture)\n  ;; snapshot = 'capture' event in event-sourcing terminology.\n  ;; Snapshot is opaque, immutable, and can be replayed via restore.\n  (list ':pattern 'event-sourcing\n        ':operation 'capture-checkpoint\n        ':immutable 'yes))\n(event-sourcing-capture)"
     :cs-program "(define (snapshot-total?)\n  ;; Always returns a value (opaque blob), never fails.\n  (let ((s (world/snapshot)))\n    (not (eq? s 'error))))\n(snapshot-total?)"
     :explanation "eng: annotated save with metadata. math: event-sourcing capture semantics. cs: totality — snapshot always returns a value."
     :meta "world/hash is a signature; world/snapshot is a full capture.")
    (:eng "SRE: snapshots cost memory ∝ world size; audit at capture." :math "Full state serialization." :cs "Serialize world into opaque blob."))
  :row-3-dimension (
    (:setup "Full-fidelity capture of state."
     :rungs (
       (:domain "world"  :code ";; honest-null: hashing is content-addressing (like a Merkle root over entity state). It has no algebra beyond distributional properties — you cannot 'add' or 'multiply' two hashes meaningfully. The domain properties (determinism, low collision) are engineering guarantees, not equations.")
       (:domain "db"     :code "(define (backup db) (list 'backup db))
(backup 'main)")
       (:domain "math"   :code "(define (freeze x) x)
(freeze '(1 2 3))"))
     :explanation "Rung 1: world snapshot. Rung 2: db backup. Rung 3: freeze. Each: 'capture the current state as a value'."
     :meta "Shape: state capture.")
    (:eng "SRE: snapshots are the foundation of save systems." :math "Full state read." :cs "Serialize."))
  :row-4-proof (
    (:claim "Read-stability: two snapshots with no state change have equal hashes; snapshot is immutable."
     :eng-program "(define (read-stability)\n  (let* ((s1 (world/snapshot))\n         (s2 (world/snapshot))\n         (h1 (begin (world/restore! s1) (world/hash)))\n         (h2 (begin (world/restore! s2) (world/hash))))\n    (= h1 h2)))\n(read-stability)"
     :math-program "(define (idempotent-under-idle)\n  ;; snapshot is a pure function on world state; equal inputs → equal outputs.\n  ;; Under no-writer semantics, sequential reads are equivalent.\n  (list ':property 'pure-read\n        ':witness 'hash-equality-across-reads))\n(idempotent-under-idle)"
     :cs-program "(define (snapshot-immutable-post-capture)\n  ;; Snapshot doesn't change if the world evolves after capture.\n  (let* ((s (world/snapshot))\n         (h0 (begin (world/restore! s) (world/hash))))\n    (world/step)  ;; world advances\n    (let ((h1 (begin (world/restore! s) (world/hash))))\n      (= h0 h1))))  ;; snapshot still gives same restored state\n(snapshot-immutable-post-capture)"
     :invariant "∀ world w. no-writer(t1, t2) ⇒ hash(restore!(snapshot(t1))) = hash(restore!(snapshot(t2))) ∧ snapshot immutable after capture."
     :meta "Read stability + capture immutability. Falsified if snapshots differ without state change or mutate later.")
    (:eng "Consequence: snapshot is safe to test/repeat and store long-term." :math "Pure function of state; captured values are immutable." :cs "Deterministic capture + persistent blob."))
  :row-5-emergence (
    (:base "world/snapshot captures full state."
     :eng-composition "(define history '())\n(on-frame (lambda ()\n  (set! history (cons (world/snapshot) history))\n  (when (> (length history) 300)\n    (set! history (list-head history 300)))))"
     :math-composition "(define (rewind-buffer max-frames)\n  ;; Ring buffer of snapshots → bounded rewind (like DVR).\n  ;; Space complexity: O(N × world-size).\n  (list ':buffer-shape 'ring\n        ':max-frames max-frames\n        ':operation 'push-and-evict))\n(rewind-buffer 300)"
     :cs-composition "(define (differential-snapshot base current)\n  ;; Compute a delta from base snapshot to current state (application-level).\n  ;; NOTE: motoi snapshots are opaque; a real delta impl requires structural access.\n  (list ':base-hash (begin (world/restore! base) (world/hash))\n        ':current-hash (world/hash)))\n(let ((s (world/snapshot))) (differential-snapshot s s))"
     :emergent "A REWIND buffer + differential-snapshot marker: chaining snapshot with a ring buffer yields time-scrub / DVR functionality; hash-diff enables drift detection."
     :meta "Snapshot-buffer family; same slot as VCR / DVR / event-sourced audit logs.")
    (:eng "SRE: snapshot buffers cost memory linear in frames; bound them." :math "Time-indexed sequence of immutable states." :cs "Ring buffer of snapshots + optional hash-diff.")))

(verb
  :name "world/solve!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/solve! [iters]) → frame"
  :summary "Project all constraint links to satisfy distance and rest goals; optional iteration count (1–64) → current frame."
  :explanation "world/solve! iteratively relaxes all active links (distance constraints, pin joints, rest links) toward their target lengths and configurations. Each call to solve! runs a fixed number of constraint-projection passes (default 1, max 64) to push linked entities toward equilibrium. This is typically called once per world/step as part of the physics pipeline, but you can call it explicitly for multi-step constraint solving or interactive deformation. Returns the current frame number."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/spawn 'anchor 100 100)\n(world/spawn 'bob 150 100)\n(world/link! (world/find 'anchor) (world/find 'bob) 50)\n(world/solve!)" :note "Create a linked pair and solve constraints once.")
    (:dialect "motoi" :tier "intermediate" :code "(define (multi-step-solve steps iters)\n  (for-each (lambda (_) \n              (world/step)\n              (world/solve! iters))\n            (list steps)))\n(multi-step-solve 5 4)" :note "Each frame: step physics, then solve constraints with 4 iterations for stiffness.")
    (:dialect "motoi" :tier "expert" :code "(define (input-pressed? btn) #f)\n(define user-input '())\n(define (interactive-constraint-relax user-input)\n  (let ((id (world/find 'cursor)))\n    (when (input-pressed? 'mouse-drag)\n      (entity/set-pos! id (input/x) (input/y))))\n  (world/step)\n  (world/solve! 8)  ;; high iteration count for real-time feel\n  (world/frame))\n(interactive-constraint-relax user-input)" :note "Move a constrained node interactively; high solver iterations keep links tight.")
  )
  :caveats ("solve! must be called AFTER world/step in the frame to resolve new constraints." "Iteration count > 64 is clamped to 64; you cannot request unbounded iterations." "Links must be created with world/link! or world/link-rest! before solve! can affect them." "Solving does not advance time or apply forces; it only corrects positions.")
  :drawbacks ("High iteration counts (>16) add noticeable CPU cost per frame." "Constraint chains (A–B–C) require multiple iterations to converge; deep chains are slow." "Conflicting constraints (impossible link geometry) may oscillate or jitter instead of settling." "solve! does not handle all constraint types; some require entity/set-pos! or manual impulse application.")
  :usecases ("Physics-based ropes, chains, and soft-body deformation." "Pin-joint interactive manipulation (dragging nodes)." "Cloth or fabric simulation with distance constraints." "Real-time mechanical linkages (gears, levers, joints).")
  :related ("world/step" "world/link!" "world/link-rest!" "world/impulse!" "entity/set-pos!")
  :learn (:concept "Iterative constraint projection; the solver phase of the physics pipeline." :prerequisites ("world/spawn" "world/link!" "world/step") :progression "Combine with world/link-rest! for rest angles; study world/impulse! for direct force control.")
  :row-2-audit (
    (:problem "The rope is stretchy — the operator needs to run additional solver iterations per frame to tighten it."
     :eng-program "(define (tighten-constraints iters)\n  (world/step)\n  (let loop ((i iters))\n    (when (> i 0) (world/solve!) (loop (- i 1)))))\n(tighten-constraints 3)"
     :math-program "(define (gauss-seidel-analogy)\n  ;; Each solve! = one Gauss-Seidel pass over the constraint list:\n  ;; project positions onto each constraint in sequence, then loop.\n  ;; Analogous to iterative linear-system solvers.\n  (list ':method 'gauss-seidel\n        ':operation 'project-per-constraint\n        ':convergence 'contraction))\n(gauss-seidel-analogy)"
     :cs-program "(define (iter-clamped?)\n  ;; Requested iters > 64 are clamped to 64.\n  (let ((r (world/solve! 100)))\n    (integer? r)))\n(iter-clamped?)"
     :explanation "eng: manual solver-loop for tighter constraints. math: Gauss-Seidel analogy for constraint projection. cs: iter-count clamping contract."
     :meta "world/step is the standard tick; world/solve! is the manual iteration knob.")
    (:eng "SRE: solve iterations trade CPU for constraint tightness." :math "Iterative constraint projection." :cs "One Gauss-Seidel pass."))
  :row-3-dimension (
    (:setup "One iteration of a convergent process."
     :rungs (
       (:domain "world"  :code "(define (grid-cloth cols rows spacing stiff)\n  ;; 2D constraint graph → cloth simulation.\n  ;; Horizontal links: (i,j)-(i+1,j); vertical links: (i,j)-(i,j+1).\n  (list ':horizontal (* rows (- cols 1))\n        ':vertical (* cols (- rows 1))\n        ':total-constraints (+ (* rows (- cols 1)) (* cols (- rows 1)))\n        ':stiffness stiff))\n(grid-cloth 5 5 10 0.9)")
       (:domain "linear" :code "(define (jacobi-step x A b) x)
(jacobi-step '(0) '((1)) '(1))")
       (:domain "math"   :code "(define (newton-step x f g) (- x (/ (f x) (g x))))
(newton-step 1 (lambda (x) x) (lambda (x) 1))"))
     :explanation "Rung 1: constraint solve pass. Rung 2: Jacobi iteration. Rung 3: Newton step. Each: 'one step of a convergent iteration'."
     :meta "Shape: single iterative step.")
    (:eng "SRE: iterative solvers approach a fixed point; monitor residuals." :math "Iteration step." :cs "Convergent-loop primitive."))
  :row-4-proof (
    (:claim "Monotone tightening: after solve!, constraint residual is ≤ residual before (non-expansive)."
     :eng-program "(define (residual-monotone-test)\n  (world/spawn 'a 0 0) (world/spawn 'b 100 0)\n  (world/link! 'a 'b 50 1.0)\n  (let ((d0 (entity/distance 'a 'b)))\n    (world/solve!)\n    (<= (abs (- (entity/distance 'a 'b) 50)) (abs (- d0 50)))))\n(residual-monotone-test)"
     :math-program "(define (banach-fixed-point-analogy)\n  ;; PBD projection is a contraction: ||T(x) - T(y)|| ≤ ||x - y||.\n  ;; Banach: unique fixed point on the constraint manifold.\n  (list ':operator 'PBD-projection\n        ':property 'contraction\n        ':theorem 'Banach-fixed-point))\n(banach-fixed-point-analogy)"
     :cs-program "(define (returns-frame?)\n  ;; solve! returns the current frame number (per signature).\n  (integer? (world/solve!)))\n(returns-frame?)"
     :invariant "∀ world. residual(solve!(world)) ≤ residual(world) ∧ return value is current frame."
     :meta "Non-expansive iteration (contraction). Falsified if solve increases residual.")
    (:eng "Consequence: safe to iterate solve!." :math "Contraction toward fixed point (Banach)." :cs "Non-expansive step."))
  :row-5-emergence (
    (:base "world/solve! applies one solver iteration."
     :eng-composition "(define (adaptive-solve target-residual max-iters)\n  ;; Iterate until residual drops below threshold or budget exhausted.\n  (let loop ((i 0))\n    (world/solve!)\n    ;; residual is application-level; abstracted here.\n    (if (>= i max-iters) 'budget-exhausted\n        (loop (+ i 1)))))\n(adaptive-solve 0.1 16)"
     :math-composition "(define (multi-frame-convergence total-frames iters-per-frame)\n  ;; Total convergence work = frames × iters.\n  ;; Under contraction, error decays exponentially: e_n ≤ c^n · e_0.\n  (list ':total-passes (* total-frames iters-per-frame)\n        ':decay 'exponential-c^n))\n(multi-frame-convergence 60 4)"
     :cs-composition "(define (stiffness-schedule frame)\n  ;; Adjust iter count based on frame budget.\n  (cond ((< frame 60)  8)   ;; startup: more iters to settle\n        ((< frame 300) 4)   ;; normal: budget-friendly\n        (else          2))) ;; steady-state: minimal\n(let loop ((f 0)) (when (< f 10) (world/solve! (stiffness-schedule f)) (loop (+ f 1))))"
     :emergent "An adaptive-solve + multi-frame-convergence + stiffness-schedule triad: chaining solve! with a loop + budget yields tight ropes, exponential error decay, and dynamic performance tuning."
     :meta "Iterative-refinement family; standard PBD stiffness + budgeted iteration.")
    (:eng "SRE: iteration counts are performance knobs." :math "Fixed-point iteration (contraction mapping)." :cs "Loop of solver steps + budget.")))

(verb
  :name "world/spawn" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/spawn kind x y [w] [h]) → id"
  :summary "Create a new entity of a given kind at (x, y) with optional width/height → entity id; bad coordinate → 'bad-arg."
  :explanation "world/spawn instantiates a new actor (entity) in the simulation. The kind is a symbol naming the entity type; x and y are the starting position. Optional width and height define the entity's AABB (bounding box); if omitted, a default 1×1 box is used. The verb returns a unique id that can be used with entity/* verbs to query or modify the entity. Bad coordinates (NaN, Infinity, out-of-bounds) return 'bad-arg instead. Spawned entities start alive, untagged, and in a neutral FSM state."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define p (world/spawn 'player 100 100))\n(display p)" :note "Spawn a player at (100, 100); p is now a valid entity id.")
    (:dialect "motoi" :tier "intermediate" :code "(define (spawn-enemies count)\n  (map (lambda (i) (world/spawn 'enemy (+ 50 (* i 80)) 150))\n       (list count)))\n(define enemy-ids (spawn-enemies 5))" :note "Spawn multiple enemies in a row; returns a list of ids.")
    (:dialect "motoi" :tier "expert" :code "(define (arena-setup)\n  (define player (world/spawn 'player 400 300 20 20))\n  (world/gravity! 0 0.5)\n  (for-each (lambda (i) \n              (world/spawn 'obstacle (random-range 0 800) (random-range 100 300) 40 20))\n            (list 10))\n  (display (world/count)))\n(arena-setup)" :note "Full arena setup: spawn player with explicit size, set gravity, spawn obstacles.")
  )
  :caveats ("x, y must be finite numbers; NaN or Infinity → 'bad-arg." "Coordinates outside the world bounds may spawn but render off-screen." "Width/height default to 1 if omitted; use explicit values for proper collision." "Entities are born in bornSeq order; iteration order is deterministic." "The same kind can be spawned many times; kind is just a label.")
  :drawbacks ("No built-in entity pooling or reuse; each spawn allocates fresh memory." "Spawning many entities per frame (>1000) may cause frame-rate drops." "No 'despawn-all-of-kind'; use world/find + entity/despawn! to clean up selectively." "Default size (1×1) is tiny; forgetting to set width/height causes invisible hitboxes.")
  :usecases ("Spawning player at level start." "Procedural enemy waves or bullet patterns." "Dynamic obstacles or collectibles." "Creating visual markers or debug nodes.")
  :related ("entity/despawn!" "entity/set-pos!" "world/find" "world/each" "world/count")
  :learn (:concept "Entity birth; the fundamental creation primitive." :prerequisites ("world/step" "entity/alive?") :progression "Learn entity/set-pos!, entity/set-vel!, and entity/set! to configure spawned entities; then use world/each to iterate and update.")
  :row-2-audit (
    (:problem "The operator needs to create a new entity at a given position and get a stable handle back. entity/make requires a caller-supplied id and can collide; world/spawn is the framework's factory — it allocates a fresh id and inserts into the entity registry."
     :eng-program "(define (spawn-and-tag kind x y)\n  (let ((id (world/spawn kind x y)))\n    (entity/set! id 'tag 'fresh)\n    id))\n(spawn-and-tag 'orc 200 200)"
     :math-program "(define (registry-injection-check)\n  ;; Spawn is an injection into the id-space: distinct calls yield distinct ids.\n  (let ((a (world/spawn 'x 0 0))\n        (b (world/spawn 'x 0 0)))\n    (not (eq? a b))))\n(registry-injection-check)"
     :cs-program "(define (bad-arg-guard x y)\n  ;; NaN / Infinity coords must return 'bad-arg, not silently corrupt.\n  (let ((r (world/spawn 'e x y)))\n    (if (eq? r 'bad-arg) 'guarded 'ok)))\n(bad-arg-guard 0 0)"
     :explanation "eng: spawn-and-tag combines factory + initial-state write. math: spawn is an injective function into id-space. cs: bad-arg sentinel protects against NaN/Infinity coords."
     :meta "Reach for world/spawn over entity/make when you don't need to pre-name the id — auto-generated ids never collide. Sibling entity/make is for pre-declared entities (test fixtures, level manifests).")
    (:eng "SRE: spawn is safe under high load; profile for spawn storms (bullets, particles)."
     :math "Registry insertion with fresh-key generation; injective on the call sequence."
     :cs "Insert with id generation; O(1) expected on a hash-backed store."))
  :row-3-dimension (
    (:setup "Create a new entity in a registry."
     :rungs (
       (:domain "world"  :code "(world/spawn 'orc 200 200)")
       (:domain "shell"  :code "(define (mktemp) 'tmp-abc123)
(mktemp)")
       (:domain "math"   :code "(define (fresh) 42)
(fresh)"))
     :explanation "Rung 1: entity spawn. Rung 2: tempfile creation. Rung 3: fresh symbol. Each: 'produce a new member with an auto-assigned id'."
     :meta "Shape: name-generating construction.")
    (:eng "SRE: name-generation must be fresh; audit for collisions." :math "Insertion with fresh key." :cs "Auto-id insert."))
  :row-4-proof (
    (:claim "Uniqueness + count-increment: spawn returns a fresh id not previously in the registry, and increments world/count by exactly 1."
     :eng-program "(define (uniqueness-witness)\n  (let ((a (world/spawn 'x 0 0))\n        (b (world/spawn 'x 0 0)))\n    (not (equal? a b))))\n(uniqueness-witness)"
     :math-program "(define (count-monotone-witness)\n  ;; ∀ spawn. count(after spawn) = count(before spawn) + 1.\n  (let ((c0 (world/count)))\n    (world/spawn 'e 0 0)\n    (= (world/count) (+ c0 1))))\n(count-monotone-witness)"
     :cs-program "(define (alive-immediately?)\n  ;; Spawn must produce an alive entity, not a stale/pending record.\n  (let ((id (world/spawn 'e 0 0)))\n    (entity/alive? id)))\n(alive-immediately?)"
     :invariant "∀ w. spawn(w) → id ∉ registry(w) ∧ count(spawn(w)) = count(w) + 1 ∧ alive?(id) = #t"
     :meta "Freshness + count-increment + immediate-alive. Falsified if a spawn returns an existing id, or count doesn't advance, or the entity is stillborn. Book-of-code ch 5 (id generation) grounds.")
    (:eng "Consequence: safe to spawn without checking for collision; count tracks population precisely."
     :math "Injection of new keys; a bijection between call sequence and id sequence."
     :cs "Fresh-name generator; O(1) alive check via registry lookup."))
  :row-5-emergence (
    (:base "world/spawn creates a fresh entity in the registry."
     :eng-composition "(define (wave n kind x y)\n  (let loop ((i 0))\n    (when (< i n)\n      (world/spawn kind (+ x (* i 30)) y)\n      (loop (+ i 1)))))\n(wave 10 'orc 100 100)"
     :math-composition "(define (grid-population w h dx dy kind)\n  ;; Cartesian product spawn: |w|·|h| entities on a lattice.\n  (let loop-x ((x 0))\n    (when (< x w)\n      (let loop-y ((y 0))\n        (when (< y h)\n          (world/spawn kind (* x dx) (* y dy))\n          (loop-y (+ y 1))))\n      (loop-x (+ x 1)))))\n(grid-population 5 3 40 40 'block)"
     :cs-composition "(define (spawn-with-budget kind x y)\n  ;; Respect the animation budget — degrade gracefully under load.\n  (if (> (cadr (animation/budget)) 0)\n      (world/spawn kind x y)\n      'budget-exhausted))\n(spawn-with-budget 'particle 0 0)"
     :emergent "A spawn-wave + grid-population + budgeted-spawn triad: linear cohort, Cartesian lattice, and back-pressure-aware factory. Emergent: level population with degradation."
     :meta "Population-generator family; standard level population. Book-of-composition ch 10 (cohort ops) grounds.")
    (:eng "SRE: population functions are audit-friendly; grep for spawn sites."
     :math "Family of spawns parameterized by index; grid-populate = 2D unfold."
     :cs "Loop of spawns; budget-aware variant is back-pressure-safe."))
)

(verb
  :name "world/step" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/step) → frame"
  :summary "Advance the world by one frame: integrate physics, apply tweens, detect collisions, flush despawns → current frame number."
  :explanation "world/step is the heartbeat of the physics and animation loop. In one call it: (1) integrates velocities and forces into positions (Verlet or semi-implicit Euler), (2) applies active tweens (animated values), (3) detects entity–entity and entity–geometry collisions, (4) flushes despawn requests from the prior frame. It then returns the new frame number. Call world/step once per game frame, typically inside a on-tick or big-bang loop. The frame counter increments by 1 each step."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/step)\n(world/step)\n(display (world/frame))" :note "Two steps; frame counter now reads 2.")
    (:dialect "motoi" :tier "intermediate" :code "(define (game-loop)\n  (when (world/running?)\n    (world/step)\n    (for-each (lambda (id) (display (entity/pos id))) (entity/all))))\n(game-loop)" :note "Main loop: step, then iterate over all entities to update logic.")
    (:dialect "motoi" :tier "expert" :code "(define (physics-tick)\n  (world/step)\n  (for-each (lambda (pair)\n              (let ((a (car pair)) (b (cadr pair)))\n                (on-collision a b)))\n            (world/collisions))\n  (world/each (lambda (id)\n                (when (entity/alive? id)\n                  (let ((state (entity/state id)))\n                    (case state\n                      ((moving) (move-update id))\n                      ((idle) (idle-update id)))))))\n(physics-tick))" :note "Full tick: step, process collisions, update each entity's state machine.")
  )
  :caveats ("Calling world/step from within a collision handler or entity callback is undefined; step between frames only." "Entities despawned via entity/despawn! in the current frame are not removed until the next world/step; queries still see them as alive." "Collision detection is discrete; fast-moving small entities may pass through gaps." "Forces and gravity are applied cumulatively; 0 0 gravity still requires an explicit world/gravity! call to set." "Tweens and animations progress by 1/60 of their duration per frame (assuming 60 FPS); frame rate sensitivity can be an issue.")
  :drawbacks ("Fixed time-step; no delta-time scaling. All physics assumes 1 frame ≈ constant dt." "Step cost grows with entity count; 1000+ entities per frame may stall." "Collision callbacks are synchronous and not cancelable." "Determinism relies on all forces and impulses being applied in the same order; randomness breaks replays.")
  :usecases ("Main game-loop heartbeat." "Physics-based puzzle or platformer simulation." "Collision detection in real-time games." "Time-step synchronization for replay recording.")
  :related ("world/spawn" "world/collisions" "world/gravity!" "world/frame" "entity/despawn!")
  :learn (:concept "Discrete time stepping; one frame of physics and animation." :prerequisites ("world/spawn" "entity/alive?") :progression "Learn world/collisions to handle collision pairs; then world/gravity! and entity forces for dynamic behavior.")
  :row-2-audit (
    (:problem "The operator wants to advance the simulation by one frame — integrate positions from velocities under Δt=1, apply tweens, resolve collisions, fire scheduled events. Hand-rolling per-entity Euler misses collision + despawn passes; world/step is the framework's atomic integrator."
     :eng-program "(define (advance-one)\n  (world/step)\n  (world/frame))\n(advance-one)"
     :math-program "(define (euler-check)\n  ;; Semi-implicit Euler: p(t+1) = p(t) + v(t+1)·Δt.\n  ;; With v=1, a=0, position advances by 1 per step.\n  (world/gravity! 0 0)\n  (world/spawn 'e 0 0)\n  (entity/set-vel! 'e 1 0)\n  (let ((x0 (car (entity/pos 'e))))\n    (world/step)\n    (- (car (entity/pos 'e)) x0)))\n(euler-check)"
     :cs-program "(define (reentrancy-guard)\n  ;; step is not safe inside collision handlers — recursive entry breaks invariants.\n  'call-only-between-frames)\n(reentrancy-guard)"
     :explanation "eng: advance-one composes step + frame read. math: semi-implicit Euler with Δt=1 — unit velocity moves by 1 per step. cs: reentrancy is a documented constraint."
     :meta "Reach for world/step over per-entity Euler when you need collision + tween + despawn coordination — the framework's step fuses all passes.")
    (:eng "SRE: step is the frame budget owner; profile at N=100/1000/10000 entities."
     :math "Discrete time-advance under Δt=1 with semi-implicit Euler on position + velocity."
     :cs "One tick of the simulation loop; not reentrant."))
  :row-3-dimension (
    (:setup "Advance a simulation by one discrete unit."
     :rungs (
       (:domain "world"  :code "(world/step)")
       (:domain "os"     :code "(define (scheduler-tick) 'ticked)
(scheduler-tick)")
       (:domain "math"   :code "(define (next state f) (f state))
(next 0 (lambda (n) (+ n 1)))"))
     :explanation "Rung 1: game step. Rung 2: OS scheduler tick. Rung 3: state transition. Each: 'advance one discrete unit of time'."
     :meta "Shape: single-step advance.")
    (:eng "SRE: step is the primary work unit; timing-critical." :math "Δt = 1." :cs "Discrete transition."))
  :row-4-proof (
    (:claim "Frame monotonicity + integration linearity: world/frame increases by exactly 1 per step, and constant-velocity → N steps advance position by N·v."
     :eng-program "(define (monotone-witness)\n  (let ((f0 (world/frame)))\n    (world/step)\n    (= (+ f0 1) (world/frame))))\n(monotone-witness)"
     :math-program "(define (linearity-witness)\n  ;; Under a=0 and constant v, N steps advance position by N·v.\n  (world/gravity! 0 0)\n  (world/spawn 'p 0 0)\n  (entity/set-vel! 'p 2 0)\n  (world/step) (world/step) (world/step)\n  (= (car (entity/pos 'p)) 6))\n(linearity-witness)"
     :cs-program "(define (determinism-witness)\n  ;; Two runs from identical seeds must produce identical states.\n  (world/reset!) (world/spawn 'a 0 0) (entity/set-vel! 'a 3 0)\n  (world/step) (world/step)\n  (equal? (entity/pos 'a) '(6 0)))\n(determinism-witness)"
     :invariant "∀ w. frame(step(w)) = frame(w) + 1 ∧ ∀ p (const-v). pos(step^N(p)) - pos(p) = N·v ∧ deterministic-given-seed"
     :meta "Increment + linearity + determinism — three pillars of a physics stepper. Falsified by frame skip, non-linearity, or non-determinism. Book-of-code ch 8 (monotonic counters) grounds.")
    (:eng "Consequence: frame counter is reliable; position advances predictably; replay is deterministic."
     :math "+1 increment; semi-implicit Euler linear under constant velocity."
     :cs "Deterministic tick; identical seeds produce identical traces."))
  :row-5-emergence (
    (:base "world/step advances one frame of physics + collisions + tweens."
     :eng-composition "(define (fixed-timestep)\n  (world/step)\n  (world/render)\n  (world/after 1 'fixed-timestep 'again))\n(fixed-timestep)\n'scheduled"
     :math-composition "(define (integrate-until pred)\n  ;; Iterate step until predicate on state holds. Trajectory = orbit of the step map.\n  (let loop ()\n    (if (pred) 'converged (begin (world/step) (loop)))))\n(integrate-until (lambda () (> (world/frame) 100)))"
     :cs-composition "(define (step-with-timeout budget)\n  ;; Bounded stepping — cap at a frame budget to keep replays finite.\n  (let ((start (world/frame)))\n    (let loop ()\n      (when (< (- (world/frame) start) budget)\n        (world/step) (loop)))))\n(step-with-timeout 60)"
     :emergent "A fixed-timestep loop + integrate-until + bounded-step triad: step chains with render for main loops, with predicates for convergence sims, with counters for bounded replays. Emergent: multiple loop disciplines."
     :meta "Game-loop family; fundamental pattern. Book-of-composition ch 13 (temporal composition) grounds.")
    (:eng "SRE: fixed-timestep loops decouple physics from render; bounded step is replay-safe."
     :math "Discrete-time dynamical system; iterate-until-fixed-point is standard."
     :cs "Loop with fixed cadence; timeout gate protects against runaway sims."))
)

(verb
  :name "world/sway-all!" :std "Motoi"
  :library "world"
  :kind "null"
  :signature "(world/sway-all! tag period amplitude) → count"
  :summary "Oscillate all entities bearing a tag with sinusoidal phase-offset rotation; returns the number of entities affected."
  :explanation "world/sway-all! creates a wave of swaying motion across all entities tagged with a given tag. Each entity oscillates with a sine curve parameterized by period (frame count per cycle) and amplitude (max rotation angle in radians). The phase is offset by each entity's birth order (bornSeq) to create a staggered, flowing effect. The motion is stored in each entity's '__spin' data slot and must be applied to rendering/animation by the caller. Returns the count of entities that matched the tag."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/spawn 'flower 100 100)\n(entity/tag! (world/find 'flower) 'sway)\n(world/sway-all! 'sway 60 0.5)\n(display (world/sway-all! 'sway 60 0.5))" :note "Tag a flower, then sway all tagged flowers with 60-frame period and 0.5 amplitude; count is 1.")
    (:dialect "motoi" :tier "intermediate" :code "(define (create-grass field-size)\n  (for-each (lambda (i)\n              (let ((id (world/spawn 'grass (* i 20) 200)))\n                (entity/tag! id 'wind-sway)))\n            (list field-size))\n  (world/sway-all! 'wind-sway 40 0.3))\n(create-grass 10)" :note "Create a field of grass, tag them, sway in unison with phase offsets.")
    (:dialect "motoi" :tier "expert" :code "(define (rhythm-sway beat-period)\n  (let ((count (world/sway-all! 'dancer 60 0.2)))\n    (when (> count 0)\n      (world/each (lambda (id)\n                    (when (entity/tag? id 'dancer)\n                      (let ((spin (entity/ref id '__spin)))\n                        (when (not (equal? spin 'nan))\n                          (sprite-rotate-animation id spin)))))))))\n(rhythm-sway 60)" :note "Sway dancers, then apply their __spin values to sprite rotations for visual effect.")
  )
  :caveats ("world/sway-all! only computes and stores the oscillation; it does NOT render or animate. The caller must read '__spin' and apply it." "The phase offset formula (0.37 scaling factor) is fixed; you cannot customize the inter-entity phase spacing." "Entities spawned after calling sway-all! will inherit the phase offset formula based on their bornSeq, which may look wrong." "Amplitude is in radians; 0.5 radians ≈ 28 degrees. Very large amplitudes (>π) may cause visual aliasing." "Tag must be a symbol or string; other types are coerced to string.")
  :drawbacks ("The '__spin' value is overwritten each frame; you cannot accumulate or blend multiple sways on the same entity." "No built-in damping or easing; oscillation is pure sine with no decay." "Period must be > 0; period ≤ 0 causes undefined behavior." "The verb is undocumented in the source; behavior inferred from inline code.")
  :usecases ("Gentle swaying grass or plant fields." "Synchronized dancing or choreography in rhythm games." "Wave-like crowd motion or NPC formations." "Visual feedback for wind or water currents.")
  :related ("entity/tag!" "entity/untag!" "entity/ref" "world/each" "world/frame")
  :learn (:concept "Phase-coherent oscillation across a group; staggered sine waves." :prerequisites ("entity/tag!" "world/spawn" "world/each") :progression "Learn entity/ref to retrieve the '__spin' value; combine with sprite animation to render the sway.")
  :row-2-audit (
    (:problem "The operator wants a field of grass to sway in the wind."
     :eng-program "(define (setup-sway tag period amp)\n  (let ((count (world/sway-all! tag period amp)))\n    (list ':entities-swayed count ':tag tag)))\n(setup-sway 'grass 60 0.02)"
     :math-program "(define (phase-shifted-sine i t period)\n  ;; sway_i(t) = amp * sin(2*pi*t/period + 0.37*i)\n  ;; where 0.37 is the fixed inter-entity phase offset per bornSeq.\n  (let* ((amp 0.02)\n         (phase (* 0.37 i))\n         (angle (+ (/ (* 2 3.141592653589793 t) period) phase)))\n    (* amp (sin angle))))\n(phase-shifted-sine 3 10 60)"
     :cs-program "(define (returns-count?)\n  (integer? (world/sway-all! 'nothing-tagged 60 0.02)))\n(returns-count?)"
     :explanation "eng: batch sway setup with count. math: phase-shifted sinusoid parameterization. cs: integer-count return contract."
     :meta "Manual per-entity oscillation loses phase-coherence; world/sway-all! coordinates it.")
    (:eng "SRE: sway is a cheap cosmetic effect; profile if entity count is high." :math "Sinusoidal oscillation across a group." :cs "Batch phase-shifted animation."))
  :row-3-dimension (
    (:setup "Apply a phase-coherent oscillation to a group."
     :rungs (
       (:domain "world"    :code "(define (harmonic-motion-bound amp)\n  ;; |amp · sin(θ)| ≤ amp for any θ, since sin ∈ [-1, 1].\n  (list ':property 'bounded-oscillation\n        ':max amp\n        ':source 'sin-range))\n(harmonic-motion-bound 0.5)")
       (:domain "audio"    :code "(define (chorus voices) (list 'chorus voices))
(chorus 3)")
       (:domain "math"     :code "(define (osc i t) (sin (+ t (* 0.3 i))))
(osc 0 1)"))
     :explanation "Rung 1: entity sway. Rung 2: audio chorus. Rung 3: phase-shifted sinusoid. Each: 'many oscillators with staggered phases'."
     :meta "Shape: phase-shifted oscillator array.")
    (:eng "SRE: coherent oscillation looks more natural than independent." :math "Family of phase-shifted sinusoids." :cs "Batch-parameterized animation."))
  :row-4-proof (
    (:claim "Amplitude bound: __spin values never exceed the amplitude (sin ∈ [-1,1])."
     :eng-program "(define (amplitude-bound-test)\n  (world/spawn 'g 100 100)\n  (entity/tag! 'g 'sway)\n  (world/sway-all! 'sway 60 0.5)\n  (let loop ((i 30) (worst 0))\n    (if (= i 0) (< worst 0.51)\n        (let ((spin (entity/ref 'g '__spin)))\n          (world/step)\n          (loop (- i 1) (max worst (abs (or spin 0))))))))\n(amplitude-bound-test)"
     :math-program "(define (harmonic-motion-bound amp)\n  ;; |amp · sin(θ)| ≤ amp for any θ, since sin ∈ [-1, 1].\n  (list ':property 'bounded-oscillation\n        ':max amp\n        ':source 'sin-range))\n(harmonic-motion-bound 0.5)"
     :cs-program "(define (zero-entities-safe?)\n  ;; sway-all! on a tag with no members returns 0 without crashing.\n  (= 0 (world/sway-all! 'nothing-tagged 60 0.5)))\n(zero-entities-safe?)"
     :invariant "∀ e ∈ tagged. |spin(e, t)| ≤ amp ∧ sway-all!('empty', p, a) = 0."
     :meta "Bounded oscillation + zero-entities safe. Falsified if sway exceeds amplitude or crashes on empty tag.")
    (:eng "Consequence: sway is bounded — no runaway." :math "sin ∈ [-1, 1]; harmonic motion bound." :cs "Amplitude-bounded oscillator."))
  :row-5-emergence (
    (:base "world/sway-all! oscillates a tagged group."
     :eng-composition "(define (plant-and-sway kind n spacing tag period amp)\n  (let loop ((i 0))\n    (when (< i n)\n      (let ((g (world/spawn kind (* i spacing) 300)))\n        (entity/tag! g tag))\n      (loop (+ i 1))))\n  (world/sway-all! tag period amp))\n(plant-and-sway 'grass 20 10 'sway 60 0.3)"
     :math-composition "(define (multi-frequency-layers layers)\n  ;; Multiple sway calls with different periods → composite wave.\n  ;; NOTE: each call overwrites __spin; layering requires application logic.\n  (for-each (lambda (l)\n              (world/sway-all! (car l) (cadr l) (caddr l)))\n            layers))\n(multi-frequency-layers '((grass 60 0.3) (leaves 90 0.2)))"
     :cs-composition "(define (sway-driven-render tag period amp)\n  ;; Apply sway then rely on renderer to read __spin.\n  (world/sway-all! tag period amp)\n  (world/render))\n(sway-driven-render 'flag 40 0.4)"
     :emergent "A plant-and-sway + multi-frequency-layers + sway-driven-render triad: chaining sway-all! with spawn/tag/render yields grass fields, layered wind, and animated banners."
     :meta "Group-oscillator family; standard environmental animation.")
    (:eng "SRE: batch animations are the cheapest way to fill a scene." :math "Group action of oscillators." :cs "Batch animation + render coupling.")))

(verb
  :name "world/tape-audio" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/tape-audio) -> list"
  :summary "Return the audio events recorded on the latest tape frame as a list of (kind channel gain) rows; silent frame returns the empty list."
  :explanation "The tape is a record of every frame that has been rendered or simulated. Each frame captures audio events—sounds played, their channel (track), and gain (volume). world/tape-audio retrieves those events from the most recent frame, allowing you to inspect what sounds occurred, when they occurred, and at what volume. This is useful for debugging audio timing, exporting audio logs, or triggering secondary effects based on recorded sounds."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/tape-audio)" :note "Returns all audio events from the last frame, e.g., ((kick main 0.8) (snare 1 0.6)).")
    (:dialect "motoi" :tier "intermediate" :code "(define latest-audio (world/tape-audio))\n(define audio-count (length latest-audio))\n(if (> audio-count 0)\n  (display (list \"Frame had\" audio-count \"sounds\")))" :note "Count the number of audio events in the latest frame and log it if any occurred.")
    (:dialect "motoi" :tier "expert" :code "(define (filter pred xs)\n  (let loop ((xs xs) (acc '()))\n    (cond ((null? xs) (reverse acc))\n          ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc)))\n          (else (loop (cdr xs) acc)))))\n(define (extract-audio-by-channel target-channel)\n  (let ((audio-events (world/tape-audio)))\n    (filter (lambda (evt)\n              (equal? (cadr evt) target-channel))\n            audio-events)))\n(define drum-sounds (extract-audio-by-channel 'drums))" :note "Filter tape audio to find all events on a specific channel; useful for post-processing or logging.")
  )
  :caveats ("Returns an empty list if the tape is empty (no frames recorded yet) or if the latest frame has no audio events." "The tape is a history of what was recorded; this verb only reads the latest frame, not the full history. Use world/tape-frames to get the frame count if you need to iterate." "Audio events are structured as (kind channel gain); if any field is missing in the source, it is replaced with the symbol 'none, not null." "Tape recording must be active; if world/tape-recording? returns false, tape-audio returns whatever was last recorded.")
  :drawbacks ("Reading tape data does not reset or advance the tape; repeated calls return the same frame until the tape steps." "No filtering or searching inside tape-audio; you must filter the result with filter or fold if you need a subset." "The tape is a linear record; you cannot access past frames via tape-audio (only the latest). To access history, use world/tape-hash or world/tape-frames and consider storing snapshots.")
  :usecases ("Debug audio timing by logging which sounds occurred in a given frame." "Post-process a recorded tape to extract sound metadata for analysis or export." "Trigger visual effects (e.g., screen flash) synchronized to recorded audio events." "Audit a performance: check that the expected sounds were played at the expected times.")
  :related ("world/tape-record!" "world/tape-stop!" "world/tape-recording?" "world/tape-frames" "world/tape-hash")
  :learn (:concept "Tape as a persistent record of simulation state, and audio events as a subset of that record." :prerequisites ("world/tape-record!" "world/frame") :progression "After learning tape-audio, study world/tape-replay to re-render recorded frames, and world/tape-save to persist a tape to disk.")
  :row-2-audit (
    (:problem "A rhythm-game replay must be audited for missed cues; the operator needs only the audio slice of the last frame, not the full entity dump."
     :eng-program "(define (last-frame-audio-report)\n  (let ((evts (world/tape-audio)))\n    (list ':frame (world/frame) ':n-audio (length evts) ':events evts)))\n(last-frame-audio-report)"
     :math-program "(define (audio-subset-of-frames?)\n  (<= (length (world/tape-audio)) (length (world/tape-frames))))\n(audio-subset-of-frames?)"
     :cs-program "(define (safe-audio-read)\n  (let ((r (world/tape-audio)))\n    (if (list? r) r (error 'audio-not-list r))))\n(safe-audio-read)"
     :explanation "eng: annotated frame + audio audit tuple. math: subset invariant witness (|audio| ≤ |frames|). cs: type-guarded read that fails fast on schema drift."
     :meta "Reach for world/tape-audio and NOT world/tape-frames: frames is the full state including entities, cameras, hashes; audio is the projection. Wrong verb bloats the diagnostic and misses the sonic story.")
    (:eng "Filtered views make audio-driven replay debugging tractable." :math "Projection π_audio of the tape monomorphism." :cs "Read-only view; no mutation of the tape buffer."))
  :row-3-dimension (
    (:setup "Filtered view of a compound stream — project one lane out of a multi-lane record."
     :rungs (
       (:domain "world"    :code "(world/tape-audio)")
       (:domain "log"      :code "(define (filter-lvl logs l) (list 'filtered l))
(filter-lvl 'all 'error)")
       (:domain "math"     :code "(define (proj-key xs k) (map (lambda (x) (cdr (assq k x))) xs))\n(proj-key (list (list (cons 'a 1)) (list (cons 'a 2))) 'a)"))
     :explanation "Rung 1: tape's audio lane. Rung 2: log-level filter. Rung 3: association-list key projection. All three shape as 'give me only entries matching this facet'."
     :meta "Shape: filtered projection / lane extraction.")
    (:eng "SRE: filtered views are diagnostic staples — one lane at a time." :math "Preimage of a projection: π: A×B×C → B." :cs "Filter accessor; no side effect."))
  :row-4-proof (
    (:claim "Subset invariant: |tape-audio| ≤ |tape-frames| at every observation."
     :eng-program "(world/tape-clear!) (world/tape-record!) (world/step) (world/step)\n(<= (length (world/tape-audio)) (length (world/tape-frames)))"
     :math-program "(define (subset-witness)\n  (let ((a (world/tape-audio)) (f (world/tape-frames)))\n    (list ':|A| (length a) ':|F| (length f) ':subset? (<= (length a) (length f)))))\n(subset-witness)"
     :cs-program "(define (probe-idempotent)\n  ;; Read is pure: two reads with no step between agree.\n  (equal? (world/tape-audio) (world/tape-audio)))\n(probe-idempotent)"
     :invariant "∀ tape. |π_audio(tape)| ≤ |tape| ∧ read(t)=read(t) when tape frozen"
     :meta "Subset + idempotence. Falsified if audio holds events unknown to frames or a repeated read differs.")
    (:eng "Consequence: an audio-only diff is a subset of a frame-diff." :math "⊆ relation from projection + read-purity for the observer." :cs "Filter is a monomorphism into the tape record."))
  :row-5-emergence (
    (:base "world/tape-audio filters the audio events of the latest frame."
     :eng-composition "(define (sonic-summary)\n  (let ((evts (world/tape-audio)))\n    (list ':loud (filter (lambda (e) (> (caddr e) 0.7)) evts)\n          ':quiet (filter (lambda (e) (<= (caddr e) 0.7)) evts))))\n(sonic-summary)"
     :math-composition "(define (audio-fold init f)\n  ;; Sum event count by channel — reduce over the audio projection.\n  (fold f init (world/tape-audio)))\n(audio-fold '() (lambda (acc e) (cons (cadr e) acc)))"
     :cs-composition "(define (audio-hasher)\n  ;; Tag each audio event with a synthetic id; cheap content-signature.\n  (map (lambda (e i) (list ':id i ':evt e)) (world/tape-audio) (iota (length (world/tape-audio)))))\n(audio-hasher)"
     :emergent "A sonic-history diagnostic: chaining tape-audio with filter/fold/tag yields loudness classifiers, per-channel counts, and content signatures — the audio-replay-analysis family."
     :meta "Filtered-replay family; same shape as Kafka topic-projection or a Datadog log-facet.")
    (:eng "Filtered replays shrink the audit surface — you look at one lane." :math "Fold / classifier over a projection." :cs "Projection query composable with filter, fold, tag.")))

(verb
  :name "world/tape-clear!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/tape-clear!) → #t"
  :summary "Discard the replay tape and disarm recording; always returns true."
  :explanation "world/tape-clear! resets the replay recording system. If a replay is currently recording (via world/tape-record!), it is halted and all frames are discarded. The tape buffer is emptied. Calling world/tape-clear! when no tape is active is a no-op. This is useful to free memory or restart recording from a clean state. Always returns true (a success marker)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/tape-clear!)" :note "Clear any active tape; tape is now empty.")
    (:dialect "motoi" :tier "intermediate" :code "(define (record-and-save filename)\n  (world/tape-clear!)\n  (world/tape-record!)\n  (for-each (lambda (_) (world/step)) (list 100))\n  (let ((tape (world/tape-save)))\n    (display (list \"Saved\" (length tape) \"frames\"))))\n(record-and-save \"demo.tape\")" :note "Clear old tape, record new frames, save to file.")
    (:dialect "motoi" :tier "expert" :code "(define execute-attempt (lambda args (list \"execute-attempt\" args)))\n(define goal-reached? (lambda args (list \"goal-reached?\" args)))\n(define (try-solution attempt-id)\n  (let ((snap (world/snapshot)))\n    (world/tape-clear!)\n    (world/tape-record!)\n    (execute-attempt attempt-id)\n    (let ((tape (world/tape-save)))\n      (if (goal-reached?) \n        (list 'success tape)\n        (begin\n          (world/tape-clear!)\n          (world/restore! snap)\n          (list 'failed-attempt attempt-id))))))\n(try-solution 5)" :note "Clear tape, attempt a solution, save if successful, or revert and clear if not.")
  )
  :caveats ("world/tape-clear! does not clear the snapshot; use world/snapshot separately." "Calling clear while a replay is being played back (world/tape-replay) may cause undefined behavior." "The tape is lost immediately; there is no undo for the clear operation." "Clearing a tape does not free memory in all implementations; rely on garbage collection.")
  :drawbacks ("Once cleared, the recorded frames are unrecoverable; no rollback." "If you want to preserve a recording, you must call world/tape-save BEFORE clearing." "Clearing does not reset the frame counter or entities; only the tape buffer is flushed.")
  :usecases ("Starting a fresh replay recording session." "Freeing memory before a large simulation." "Abandoning a failed replay attempt." "Resetting the tape subsystem for a new level or mode.")
  :related ("world/tape-record!" "world/tape-save" "world/tape-replay" "world/snapshot" "world/restore!")
  :learn (:concept "Tape lifecycle; clearing and resetting the recording buffer." :prerequisites ("world/tape-record!" "world/tape-save") :progression "Combine with world/tape-record! and world/tape-save to build a full record–save–replay workflow.")
  :row-2-audit (
    (:problem "A physics sim ran to completion; the operator failed the acceptance test and wants a completely clean slate before the next attempt — no residual frames poisoning the next replay."
     :eng-program "(define (reset-lab)\n  (world/tape-clear!)\n  (list ':cleared? (zero? (length (world/tape-frames))) ':armed? (world/tape-recording?)))\n(reset-lab)"
     :math-program "(define (annihilator?)\n  ;; clear! is the absorbing element of the tape-write monoid.\n  (world/tape-clear!)\n  (equal? (world/tape-frames) '()))\n(annihilator?)"
     :cs-program "(define (safe-clear)\n  (let ((r (world/tape-clear!)))\n    (if (eq? r #t) 'ok (error 'clear-returned-non-true r))))\n(safe-clear)"
     :explanation "eng: cleared+armed status report. math: witness that clear is the annihilator (∅ result). cs: contract check on the boolean return."
     :meta "Reach for world/tape-clear! and NOT world/tape-stop!: stop disarms but preserves; clear ERASES. Choose by 'discard or preserve'.")
    (:eng "Clear is destructive; log the operator + timestamp." :math "Absorbing element: clear ∘ record* = clear." :cs "Idempotent buffer wipe with #t contract."))
  :row-3-dimension (
    (:setup "Erase the accumulated contents of a buffer."
     :rungs (
       (:domain "world"   :code "(world/tape-clear!)")
       (:domain "shell"   :code "(define (rm-buf) (list 'cleared))
(rm-buf)")
       (:domain "math"    :code "(define (zero-out xs) '())
(zero-out '(1 2 3))"))
     :explanation "Rung 1: tape reset. Rung 2: shell buffer flush. Rung 3: zero-out. All three: 'erase the accumulator'."
     :meta "Shape: buffer reset / annihilation.")
    (:eng "Buffer resets are destructive; audit the caller." :math "Zero element in the monoid of tape writes." :cs "Buffer flush; O(1) or O(n) depending on impl."))
  :row-4-proof (
    (:claim "Zero post-condition + idempotence: after tape-clear!, frames is ∅ and clearing twice equals clearing once."
     :eng-program "(world/tape-record!) (world/step) (world/step)\n(world/tape-clear!)\n(null? (world/tape-frames))"
     :math-program "(define (annihilate-twice?)\n  (world/tape-clear!)\n  (let ((h1 (world/tape-hash)))\n    (world/tape-clear!)\n    (= h1 (world/tape-hash))))\n(annihilate-twice?)"
     :cs-program "(define (recording-off-after-clear?)\n  (world/tape-record!) (world/tape-clear!)\n  (not (world/tape-recording?)))\n(recording-off-after-clear?)"
     :invariant "∀ world w. frames(clear!(w))=∅ ∧ clear!∘clear! = clear! ∧ recording?(clear!(w))=#f"
     :meta "Empty + idempotent + disarmed. Falsified if any frame persists or a repeat clear diverges.")
    (:eng "Consequence: clear reliably returns to the origin state." :math "Absorbing + idempotent element." :cs "Zero-state buffer; safe to call blindly."))
  :row-5-emergence (
    (:base "world/tape-clear! empties the buffer and disarms recording."
     :eng-composition "(define (start-fresh-session)\n  (world/tape-clear!)\n  (world/tape-record!)\n  (list ':fresh? (= 1 (length (world/tape-frames)))))\n(start-fresh-session)"
     :math-composition "(define (attempt-loop max-attempts good?)\n  ;; Rehearse-a-run scaffold: attempt, snapshot, decide, clear.\n  (let loop ((k 0))\n    (if (>= k max-attempts) 'gave-up\n        (begin (world/tape-clear!) (world/tape-record!)\n               (world/step) (world/step)\n               (if (good?) 'passed (loop (+ k 1)))))))\n(attempt-loop 3 (lambda () #t))"
     :cs-composition "(define (with-fresh-tape thunk)\n  ;; Bracket wrapper: enter clean, run, leave state.\n  (world/tape-clear!)\n  (world/tape-record!)\n  (let ((r (thunk)))\n    (world/tape-stop!)\n    (list ':result r ':frames (length (world/tape-frames)))))\n(with-fresh-tape (lambda () (world/step) 'done))"
     :emergent "A session-boundary primitive: chaining clear!+record!+stop! yields fresh-attempt bracket + bounded-retry loop + rehearsal scaffold — the session-boundary family."
     :meta "Session-boundary family; same slot as fresh git branch, mktemp dir, transaction begin.")
    (:eng "Sessions demarcate audit boundaries and keep replays uncontaminated." :math "State-machine transition to the initial state." :cs "Reset + arm bracket.")))

(verb
  :name "world/tape-frames" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/tape-frames) -> number"
  :summary "Returns the count of frames currently held in the motion tape."
  :explanation "The motion tape is a rolling buffer that records entity state and camera position at each simulation step. This verb answers: how many frames are stored right now? Use it to check whether a recording exists, or to plan replay logic. An empty tape returns 0."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (world/tape-record! 300)\n  (world/step)\n  (world/step)\n  (display (world/tape-frames)))" :note "After two steps of recording, the tape holds 3 frames (initial capture + 2 steps).")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-record! 500)\n  (world/each (lambda (id) (entity/move! id 1 0)))\n  (world/step)\n  (if (> (world/tape-frames) 100)\n    (world/tape-stop!)\n    'keep-recording))" :note "Check frame count mid-recording to decide when to halt; avoids unbounded memory.")
    (:dialect "motoi" :tier "expert" :code "(define (replay-checkpoint ctx)\n  (let ((saved-tape (world/tape-save)))\n    (if (null? saved-tape)\n      (escalate 'no-tape-to-save null)\n      (begin\n        (display (list 'saved (length saved-tape) 'frames))\n        (next 'idle (ctx-set 'last-tape saved-tape ctx))))))" :note "Use frame count implicitly via `world/tape-save` length to verify a checkpoint was captured before moving on.")
  )
  :caveats ("Returns 0 if tape is not armed (read-only; does not arm the tape)." "Count includes the initial frame captured by `world/tape-record!`." "If a rolling-window cap was set, old frames may be discarded; this reflects only current length, not total ever-recorded.")
  :drawbacks ("Does not tell you whether recording is currently active; use `world/tape-recording?` for that." "No way to query individual frame metadata from Scheme; use `world/tape-save` to inspect the full structure.")
  :usecases ("Deciding whether to serialize a checkpoint (non-empty tape exists)." "Throttling or stopping recording when tape reaches a size threshold." "Debugging: asserting that motion was captured before a replay attempt.")
  :related ("world/tape-recording?" "world/tape-record!" "world/tape-save" "world/tape-clear!" "world/tape-stop!")
  :learn (:concept "Reading transient state—the tape is a side-effect resource, and this verb lets you inspect its size." :prerequisites ("world/frame" "world/step") :progression "Once comfortable with frame queries, move to `world/tape-record!` to arm recording, then `world/tape-save` to serialize.")
  :row-2-audit (
    (:problem "A user-session recording is filling memory; the operator wants to decide whether to keep recording or halt based on the current frame count."
     :eng-program "(define (session-throttle limit)\n  (let ((n (world/tape-frames)))\n    (cond ((>= n limit) (world/tape-stop!) 'halted)\n          (else 'continue))))\n(session-throttle 500)"
     :math-program "(define (discrete-time-index)\n  ;; Frame count IS discrete time; used for time-indexed replay lookup.\n  (let ((t (world/tape-frames)))\n    (list ':t t ':nonneg? (>= t 0))))\n(discrete-time-index)"
     :cs-program "(define (nonneg-int-contract)\n  (let ((n (world/tape-frames)))\n    (and (integer? n) (>= n 0))))\n(nonneg-int-contract)"
     :explanation "eng: throttle-when-full policy. math: recognize frame-count as a discrete-time coordinate on the tape. cs: type + range contract on the read."
     :meta "Reach for world/tape-frames and NOT world/tape-hash: hash is a signature (small, no size info); frames tells you HOW MANY. Choose by 'count vs signature'.")
    (:eng "Frame counts inform memory planning + throttling policy." :math "Cardinality of the recorded event log." :cs "Read of a non-negative counter."))
  :row-3-dimension (
    (:setup "Enumerate the size of a growing buffer — a monotonic counter of accumulated events."
     :rungs (
       (:domain "world"  :code "(world/tape-frames)")
       (:domain "log"    :code "(define (get-log) '())
(get-log)")
       (:domain "math"   :code "(define (contents xs) xs)
(contents '(1 2 3))"))
     :explanation "Rung 1: tape-frame count. Rung 2: log-entry count. Rung 3: list length. Each: 'how much have I accumulated?'."
     :meta "Shape: buffer enumeration / cardinality query.")
    (:eng "Enumerations are foundational diagnostics." :math "Cardinal number of the recorded sequence." :cs "Buffer read; O(1) or O(n) depending on impl."))
  :row-4-proof (
    (:claim "Monotonicity while recording: |frames(step(w))| = |frames(w)| + 1."
     :eng-program "(world/tape-clear!) (world/tape-record!)\n(define n0 (length (world/tape-frames)))\n(world/step)\n(= (+ n0 1) (length (world/tape-frames)))"
     :math-program "(define (monotone-across-k k)\n  (world/tape-clear!) (world/tape-record!)\n  (let loop ((i 0)) (when (< i k) (world/step) (loop (+ i 1))))\n  (= (+ k 1) (length (world/tape-frames))))\n(monotone-across-k 5)"
     :cs-program "(define (bounded-by-capacity? cap)\n  (world/tape-clear!) (world/tape-record! cap)\n  (let loop ((i 0)) (when (< i (* 2 cap)) (world/step) (loop (+ i 1))))\n  (<= (length (world/tape-frames)) cap))\n(bounded-by-capacity? 10)"
     :invariant "∀ recording w. |frames(step(w))| = |frames(w)| + 1 while unbounded; |frames(w)| ≤ cap otherwise"
     :meta "Increment + capacity-bound. Falsified if step skips a frame or the rolling window exceeds cap.")
    (:eng "Frame count is reliable timing metadata." :math "Successor function on ℕ." :cs "Consistent append + bounded rolling window."))
  :row-5-emergence (
    (:base "world/tape-frames returns the count of frames in the tape."
     :eng-composition "(define (record-and-report n)\n  (world/tape-clear!) (world/tape-record!)\n  (let loop ((k n)) (when (> k 0) (world/step) (loop (- k 1))))\n  (world/tape-stop!)\n  (list ':recorded (length (world/tape-frames)) ':target n))\n(record-and-report 30)"
     :math-composition "(define (fps-estimate elapsed-ms)\n  ;; Empirical fps = frames / seconds; discrete time / continuous time.\n  (let ((n (world/tape-frames)))\n    (if (> elapsed-ms 0) (/ (* n 1000) elapsed-ms) 'undefined)))\n(fps-estimate 1000)"
     :cs-composition "(define (progress-hud target)\n  ;; UI probe: report progress toward a frame goal.\n  (let ((n (world/tape-frames)))\n    (list ':n n ':target target ':pct (if (> target 0) (/ n target) 0))))\n(progress-hud 100)"
     :emergent "A record-diagnostic triad: chaining tape-frames with clear/record/stop + timing + UI-progress yields session-report + fps-estimator + progress-HUD — the recording-diagnostic family."
     :meta "Record-cycle family; same slot as ffmpeg -frames + performance-counter.")
    (:eng "Recording sessions are audit-clear with a frame-count report." :math "Cardinality → time; ratio yields rate." :cs "Buffer + counter + estimator triad.")))

(verb
  :name "world/tape-hash" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/tape-hash) -> number"
  :summary "Returns a 32-bit digest (hash) of the entire motion tape for integrity checking."
  :explanation "When you replay a recording, you want to assert that the same input and world snapshot produce the same output tape. This verb computes a fast hash over all frames. Two tapes with the same hash have the same entity positions, kinds, and sprite assignments (and thus should render identically). Use it to validate replay determinism or to detect corruption."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (world/tape-record! 200)\n  (world/step)\n  (world/step)\n  (let ((h1 (world/tape-hash)))\n    (display h1)))" :note "Compute the hash of a short 3-frame recording to verify it is captured.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-record! 1000)\n  (let loop ((i 0)) (when (< i 50) (world/step) (loop (+ i 1))))\n  (let ((h-live (world/tape-hash)))\n    (world/tape-stop!)\n    (if (equal? h-live 0)\n      (escalate 'hash-empty null)\n      (display (list 'tape-hash h-live)))))" :note "Stop recording and check that the hash is non-zero (tape has content).")
    (:dialect "motoi" :tier "expert" :code "(define (validate-replay ctx)\n  (let ((saved-tape (world/tape-save))\n        (h-original (ctx-get 'replay-hash ctx)))\n    (begin\n      (world/tape-clear!)\n      (world/tape-record! 5000)\n      ;; (simulate replay path here)\n      (let ((h-replay (world/tape-hash)))\n        (if (= h-original h-replay)\n          (next 'success (ctx-set 'verified #t ctx))\n          (escalate 'replay-mismatch (list h-original h-replay)))))))" :note "Store the original tape hash, then replay and compare. Mismatch means non-determinism or corrupted input.")
  )
  :caveats ("Hash is 32-bit; collisions are theoretically possible but vanishingly rare in practice." "Hash changes if *any* entity position, kind, or sprite differs between two recordings—even sub-pixel deltas." "Hash is computed over the current tape state; it changes as frames are added (rolling window may discard old frames).")
  :drawbacks ("Does not identify *which* frame or entity caused a mismatch; only signals that tapes differ." "Requires full tape in memory; cannot stream-validate very long recordings." "If tape is empty, hash is well-defined but not useful for asserting content (use `world/tape-frames > 0` first).")
  :usecases ("Regression testing: assert that a replay of a saved tape produces bit-identical output." "Deduplication: store only the hash of a checkpoint, not the full tape, and verify replay matches." "Detecting silent corruption in tape serialization or deserialization.")
  :related ("world/tape-save" "world/tape-frames" "world/tape-record!" "world/tape-stop!")
  :learn (:concept "Determinism verification—the hash is a compact witness to the tape's content, enabling offline assertion without storing megabytes of frame data." :prerequisites ("world/tape-frames" "world/tape-recording?") :progression "Combine with `world/tape-save` to build a checkpoint system: save hash + frame count, discard raw tape, then validate replay determinism.")
  :row-2-audit (
    (:problem "A game-demo replay is checked into version control; the reviewer must verify that today's build produces the same tape as yesterday's — cheaper than diffing megabytes of frames."
     :eng-program "(define (golden-check golden-hash)\n  (world/tape-clear!) (world/tape-record!)\n  (world/step) (world/step) (world/step)\n  (let ((h (world/tape-hash)))\n    (list ':expected golden-hash ':actual h ':pass? (= golden-hash h))))\n(golden-check 12345)"
     :math-program "(define (hash-collision-probe n)\n  ;; Same tape produces same hash across n independent captures.\n  (let loop ((i 0) (prev #f))\n    (if (>= i n) 'all-agree\n        (begin (world/tape-clear!) (world/tape-record!) (world/step)\n               (let ((h (world/tape-hash)))\n                 (cond ((not prev) (loop (+ i 1) h))\n                       ((= h prev) (loop (+ i 1) h))\n                       (else 'diverged)))))))\n(hash-collision-probe 3)"
     :cs-program "(define (bytevector-round-trip)\n  ;; Hash must be encodable/decodable losslessly as a number.\n  (let ((h (world/tape-hash)))\n    (and (integer? h) (= h (+ h 0)))))\n(bytevector-round-trip)"
     :explanation "eng: CI-style golden-hash gate. math: repeatability probe (hash collisions must be rare for identical inputs). cs: number contract + identity check."
     :meta "Reach for world/tape-hash and NOT world/tape-frames: frames is O(bytes); hash is O(1) storage. Choose by 'archive vs signature'.")
    (:eng "Hashes are the primary determinism-CI signal." :math "H : Tape → ℤ₃₂; deterministic pure map." :cs "Digest; one-way compression of content."))
  :row-3-dimension (
    (:setup "Compact content witness — small identifier standing for large content."
     :rungs (
       (:domain "world"  :code "(world/tape-hash)")
       (:domain "git"    :code "(define (sha1 c) 'abc)
(sha1 'blob)")
       (:domain "math"   :code "(define (digest xs) (apply + xs))
(digest '(1 2 3))"))
     :explanation "Rung 1: tape digest. Rung 2: git blob SHA. Rung 3: additive checksum. All three: 'small representative of large content'."
     :meta "Shape: content-addressable signature.")
    (:eng "Signatures beat storage for verification pipelines." :math "Hash function; ideally 2nd-preimage resistant." :cs "One-way summary; O(1) storage per tape."))
  :row-4-proof (
    (:claim "Determinism: hash is a pure function of tape content. hash(tape₁) = hash(tape₂) whenever tape₁ = tape₂."
     :eng-program "(world/tape-clear!) (world/tape-record!) (world/step) (world/step)\n(define h1 (world/tape-hash))\n(world/tape-clear!) (world/tape-record!) (world/step) (world/step)\n(= h1 (world/tape-hash))"
     :math-program "(define (idempotent-hash?)\n  ;; Reading twice with no writes must agree.\n  (= (world/tape-hash) (world/tape-hash)))\n(idempotent-hash?)"
     :cs-program "(define (empty-tape-defined?)\n  (world/tape-clear!)\n  (let ((h (world/tape-hash)))\n    (integer? h)))\n(empty-tape-defined?)"
     :invariant "∀ tape a b. a=b ⇒ hash(a)=hash(b) ∧ hash idempotent within a frozen slice"
     :meta "Determinism + idempotence + total. Falsified if identical tapes hash differently or repeated reads diverge.")
    (:eng "Hash equality is a valid witness of tape equality." :math "Referential transparency of pure hash on immutable content." :cs "Pure function of tape; no side effects."))
  :row-5-emergence (
    (:base "world/tape-hash returns a compact content-signature."
     :eng-composition "(define golden 12345)\n(define (regression-guard)\n  (let ((h (world/tape-hash)))\n    (if (= h golden) 'pass (list 'fail 'expected golden 'got h))))\n(regression-guard)"
     :math-composition "(define (diff-frame-locator ref-hashes)\n  ;; Given a list of per-frame ref hashes, find the first frame that diverges.\n  (let loop ((k 0) (rs ref-hashes))\n    (if (null? rs) 'ok-so-far\n        (let ((live (world/tape-hash)))\n          (if (= live (car rs)) (loop (+ k 1) (cdr rs))\n              (list 'diverged 'at-frame k))))))\n(diff-frame-locator (list 12345))"
     :cs-composition "(define (hash-log-tail max-entries)\n  ;; Rolling log of recent hashes for post-mortem inspection.\n  (define ring '())\n  (define (push h) (set! ring (cons h (if (>= (length ring) max-entries)\n                                          (reverse (cdr (reverse ring)))\n                                          ring))))\n  (push (world/tape-hash))\n  ring)\n(hash-log-tail 5)"
     :emergent "A determinism-CI triad: chaining tape-hash with a golden fixture + per-frame diff-locator + rolling log yields regression-gate + bug-repro-locator + observability — the content-addressable-CI family."
     :meta "Golden-hash family; same slot as git blob compare + content-addressable storage in IPFS.")
    (:eng "Golden hashes are the cheapest regression check." :math "Equivalence-class membership via hash." :cs "Golden-fixture + diff + observability triad.")))

(verb
  :name "world/tape-lcamera" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/tape-lcamera) -> (list number number number) | 'none"
  :summary "Returns the local (operator) viewport camera position and zoom from the most recent tape frame."
  :explanation "The tape records not only entity state but also where the camera was looking at each frame. The local camera is the viewport controlled by the operator during live playback. This verb returns `[x y k]` (x-coord, y-coord, zoom factor) from the latest frame, or the symbol `'none` if no camera was in scope (headless mode or camera verbs not installed). Use it to preserve and restore the operator's viewpoint during replay."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (world/tape-record! 500)\n  (camera-pan 100 50)\n  (world/step)\n  (let ((cam (world/tape-lcamera)))\n    (display cam)))" :note "After panning the camera and stepping, the tape records the new camera position. Retrieve it to confirm capture.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-record! 1000)\n  (let loop ((i 0)) (when (< i 30) (world/step) (loop (+ i 1))))\n  (let ((cam (world/tape-lcamera)))\n    (cond ((equal? cam 'none)\n           (display 'headless))\n          (else\n           (display (list 'camera-at (car cam) (cadr cam) 'zoom (caddr cam)))))))" :note "Check whether camera was recorded; if headless, `'none` is returned.")
    (:dialect "motoi" :tier "expert" :code "(define (restore-operator-view ctx)\n  (let ((cam (world/tape-lcamera)))\n    (if (equal? cam 'none)\n      (next 'idle ctx)\n      (begin\n        (camera-snap! (car cam) (cadr cam))\n        (camera-zoom-to (caddr cam))\n        (next 'replay-ready (ctx-set 'viewport cam ctx))))))" :note "After loading a saved tape, restore the operator's exact viewpoint: pan to x/y and set zoom, enabling \"show me that again\" to replay from the operator's perspective.")
  )
  :caveats ("Returns `'none` if no frames are recorded (tape is empty)." "Returns `'none` if recording was active but camera verbs were not installed or never called." "Reflects only the *latest* frame's camera; earlier frames' cameras are only accessible via `world/tape-save`." "Camera values are in world coordinates, not screen coordinates.")
  :drawbacks ("No way to query intermediate frame cameras from Scheme directly; use `world/tape-save` to extract the full history." "If camera was never set during recording, you lose the operator's implicit starting view.")
  :usecases ("Preserving the operator's field of view across a replay: save the camera position and restore it at play-back time." "Headless testing: detect whether a recording was made in a GUI context (camera present) vs. server-side (no camera)." "Choreography validation: confirm that a sequence was recorded with a specific camera framing.")
  :related ("camera-pan" "camera-zoom-to" "camera-snap!" "world/tape-save" "world/tape-frames")
  :learn (:concept "Auxiliary state in motion capture—the tape records not just the world, but the operator's vantage point, enabling full replay fidelity." :prerequisites ("world/tape-record!" "camera-pan" "camera-zoom-to") :progression "Use this to anchor replay to the operator's saved view; then explore `world/tape-save` to inspect frame-by-frame camera history.")
  :row-2-audit (
    (:problem "An animation replay must reproduce not only entity motion but the operator's viewpoint (camera pan and zoom). Without lcamera, playback shows correct motion in a wrong-viewpoint window."
     :eng-program "(define (viewpoint-tag)\n  (let ((cam (world/tape-lcamera)))\n    (list ':cam cam ':has-cam? (not (eq? cam 'none)))))\n(viewpoint-tag)"
     :math-program (:honest-null "Camera IO is a labeled tuple (x y zoom) or the tag 'none — no algebra beyond alignment with the tape frame index. See lcamera as auxiliary lane read, not a computation.")
     :cs-program "(define (safe-lcamera-restore)\n  (let ((cam (world/tape-lcamera)))\n    (cond ((eq? cam 'none) 'no-camera-recorded)\n          ((and (list? cam) (= (length cam) 3)) (list 'ready cam))\n          (else (error 'lcamera-bad-shape cam)))))\n(safe-lcamera-restore)"
     :explanation "eng: viewpoint capture for report. math: HONEST-NULL — camera position is not algebra. cs: shape-guarded restore preparation."
     :meta "Reach for world/tape-lcamera and NOT world/tape-frames: frames = entities; lcamera = operator viewpoint. Wrong choice loses the demo's perspective.")
    (:eng "Camera trajectories are essential for demo playback fidelity." :math "Honest-null — camera coord is not algebra; it's an auxiliary lane." :cs "Aux tape-lane read; opaque triple or 'none."))
  :row-3-dimension (
    (:setup "Auxiliary recorded lane — a labeled parallel slice of a multi-lane recording."
     :rungs (
       (:domain "world"  :code "(define (restore-operator-view ctx)\n  (let ((cam (world/tape-lcamera)))\n    (if (equal? cam 'none)\n      (next 'idle ctx)\n      (begin\n        (camera-snap! (car cam) (cadr cam))\n        (camera-zoom-to (caddr cam))\n        (next 'replay-ready (ctx-set 'viewport cam ctx))))))")
       (:domain "audio"  :code "(define (get-track n) '())
(get-track 1)")
       (:domain "math"   :code "(define (lane data k) '())
(lane 'x 'sub)"))
     :explanation "Rung 1: camera lane. Rung 2: audio subtrack. Rung 3: named sublane. All three: 'a labeled slice of a multi-lane recording'."
     :meta "Shape: aux-lane read / parallel-channel accessor.")
    (:eng "Aux lanes are essential for high-fidelity replay." :math "Honest-null — a data lane, not a computation." :cs "Auxiliary channel; independent of the main lane."))
  :row-4-proof (
    (:claim "Lane discipline: lcamera returns a 3-tuple (x y zoom) or the atom 'none — never a partial or malformed structure."
     :eng-program "(let ((cam (world/tape-lcamera)))\n  (or (eq? cam 'none)\n      (and (list? cam) (= (length cam) 3))))"
     :math-program (:honest-null "The claim is a shape invariant on aux-lane output — not an algebraic law. Camera coordinates are opaque IO; no ∀ over reals.")
     :cs-program "(define (typed?) (let ((cam (world/tape-lcamera)))\n  (or (eq? cam 'none)\n      (and (list? cam) (number? (car cam))\n           (number? (cadr cam)) (number? (caddr cam))))))\n(typed?)"
     :invariant "∀ observation. lcamera ∈ {'none} ∪ (ℝ × ℝ × ℝ)"
     :meta "Sum-type discipline. Falsified if lcamera returns any other shape.")
    (:eng "Lane can be zipped with frames when non-'none." :math "Honest-null — shape claim only, no algebraic law." :cs "Sum-type contract enforced at call boundary."))
  :row-5-emergence (
    (:base "world/tape-lcamera reads the local (operator) camera lane."
     :eng-composition "(define (replay-with-camera-preserved)\n  (let ((cam (world/tape-lcamera)))\n    (if (eq? cam 'none)\n        'headless-run\n        (list 'reset-camera (car cam) (cadr cam) (caddr cam)))))\n(replay-with-camera-preserved)"
     :math-composition (:honest-null "No math composition — the lane composes with world/tape-frames as parallel-zip; the composition is structural, not algebraic.")
     :cs-composition "(define (viewport-report)\n  ;; Detect whether the recording was made headed or headless.\n  (let ((cam (world/tape-lcamera)))\n    (if (eq? cam 'none)\n        (list ':mode 'headless)\n        (list ':mode 'headed ':x (car cam) ':y (cadr cam) ':zoom (caddr cam)))))\n(viewport-report)"
     :emergent "A demo-playback + viewport-report pair: chaining lcamera with restore-camera + head/headless detection yields high-fidelity replay + build-environment audit."
     :meta "Demo-playback family; same slot as OBS Studio scene state + browser viewport metadata.")
    (:eng "Demo playback needs aux lanes for fidelity + provenance." :math "Honest-null — no algebra." :cs "Multi-lane playback + capability detection.")))

(verb
  :name "world/tape-record!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/tape-record! [cap]) -> #t"
  :summary "Arm the motion tape and capture the current world frame; optionally set a rolling-window capacity."
  :explanation "Begin recording the world's motion. Each call to `world/step` appends a new frame to the tape. You can supply an optional capacity `cap` (a positive integer) to limit memory: once the tape reaches `cap` frames, older frames roll off. If `cap` is omitted or non-finite, the tape grows without bound. Always returns `true`. Call `world/tape-stop!` to halt recording (tape is retained), or `world/tape-clear!` to discard it."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (world/tape-record! 100)\n  (world/step)\n  (world/step)\n  (display (world/tape-frames)))" :note "Record with a cap of 100 frames. After two steps, tape holds 3 frames (init + 2 steps). Display shows 3.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-record!)\n  (let loop ((i 0)) (when (< i 60)\n    (world/each (lambda (id)\n      (entity/move! id (random-range -2 2) (random-range -2 2))))\n    (world/step) (loop (+ i 1))))\n  (let ((n (world/tape-stop!)))\n    (display (list 'recorded n 'frames))))" :note "Unbounded recording (no cap): move entities randomly for 60 steps, then stop and report the final frame count.")
    (:dialect "motoi" :tier "expert" :code "(define (record-scene ctx)\n  (world/tape-clear!)\n  (world/tape-record! 5000)\n  (let ((loop-count (ctx-get 'loops ctx)))\n    (if (= loop-count 0)\n      (begin\n        (display 'recording-started)\n        (next 'animate (ctx-set 'loops 1 ctx)))\n      (if (< (world/tape-frames) 4800)\n        (next 'animate (ctx-set 'loops (+ loop-count 1) ctx))\n        (next 'save-checkpoint (ctx-set 'tape (world/tape-save) ctx))))))" :note "Orchestrate a multi-frame recording: arm the tape, loop until near capacity, then save checkpoint. Capacity acts as a guard against runaway memory.")
  )
  :caveats ("Calling `world/tape-record!` again discards the prior tape unconditionally." "The initial capture (frame 0) happens synchronously; do not call during `world/each` or entity mutations." "Capacity is in frames, not bytes; a cap of 1000 may consume significant memory depending on entity count." "If `cap` argument is non-numeric or ≤ 0, capacity defaults to unlimited (0 in internal code, treated as no-limit).")
  :drawbacks ("Memory cost grows linearly with frame count and entity count; unbounded recording can exhaust heap." "No built-in compression or streaming to disk; the tape is always in-memory." "If you want to record multiple independent takes, you must manually save each tape (via `world/tape-save`) before arming a new recording.")
  :usecases ("Motion capture for replay: record a choreography sequence, then play it back deterministically." "Debugging: record a trace of entity motion to replay a failure scenario." "Live demo: arm recording, run a scene, then show the replay to an audience." "Rolling buffer for crash diagnostics: record the last N frames in a production system so you can replay the incident.")
  :related ("world/tape-stop!" "world/tape-clear!" "world/tape-recording?" "world/tape-frames" "world/tape-save" "world/step")
  :learn (:concept "Side-effect management—the tape is a mutable resource that you arm, fill, and query. Understanding this pattern is key to building deterministic replay systems." :prerequisites ("world/step" "world/frame") :progression "Once recording works, learn `world/tape-stop!` to halt, then `world/tape-save` to serialize, then `world/tape-hash` to validate.")
  :row-2-audit (
    (:problem "A sensor-trace capture must arm the tape before the sensor comes online. If the operator forgets tape-record! before the first sensor read, the trace begins mid-stream and later diagnostics diverge."
     :eng-program "(define (arm-then-connect-sensor cap)\n  (world/tape-record! cap)\n  (list ':armed? (world/tape-recording?) ':cap cap ':t0 (world/frame)))\n(arm-then-connect-sensor 2000)"
     :math-program "(define (event-sourcing-arm)\n  ;; Arming is the entry event in an event-sourced session.\n  (world/tape-record!)\n  (list ':pattern 'event-sourcing ':op 'arm ':t0 (world/tape-frames)))\n(event-sourcing-arm)"
     :cs-program "(define (arm-and-verify)\n  (let ((r (world/tape-record!)))\n    (and (eq? r #t) (world/tape-recording?))))\n(arm-and-verify)"
     :explanation "eng: sensor-capture bootstrap with timestamp. math: recognize arm as the entry event of the session. cs: contract check on the boolean return + mode read."
     :meta "Reach for world/tape-record! and NOT world/tape-clear!: record! ARMS; clear! ERASES. Wrong verb before a session either drops the trace or wipes it.")
    (:eng "Recording is a mode flag; log the transition + timestamp." :math "Boolean mode transition + entry event." :cs "Arm-with-optional-capacity; #t contract."))
  :row-3-dimension (
    (:setup "Arm a recording mode — flip the writer to append-on-step."
     :rungs (
       (:domain "world"  :code "(world/tape-record!)")
       (:domain "video"  :code "(define (rec) 'recording)
(rec)")
       (:domain "math"   :code "(define (arm mode) (list 'armed mode))
(arm 'record)"))
     :explanation "Rung 1: tape arm. Rung 2: video rec button. Rung 3: mode arm. All three: 'enable ongoing capture'."
     :meta "Shape: mode change → recording.")
    (:eng "Mode changes are audit-critical; timestamp them." :math "State transition to armed state in a 2-state FSM." :cs "Boolean flag set; capacity optional."))
  :row-4-proof (
    (:claim "Post-condition: after tape-record!, recording? = #t ∧ frames grows on each step."
     :eng-program "(world/tape-clear!) (world/tape-record!)\n(world/tape-recording?)"
     :math-program "(define (grows-after-arm?)\n  (world/tape-clear!)\n  (let ((n0 (length (world/tape-frames))))\n    (world/tape-record!)\n    (world/step)\n    (> (length (world/tape-frames)) n0)))\n(grows-after-arm?)"
     :cs-program "(define (double-arm-replaces?)\n  ;; Arming again discards the prior tape unconditionally.\n  (world/tape-record!) (world/step) (world/step)\n  (let ((n1 (length (world/tape-frames))))\n    (world/tape-record!)\n    (< (length (world/tape-frames)) n1)))\n(double-arm-replaces?)"
     :invariant "∀ w. recording?(record!(w))=#t ∧ frames(step(record!(w))) grows ∧ record!∘record! = record! ∘ clear!"
     :meta "Post-condition + monotone growth + replace-semantics. Falsified if arm doesn't set the flag or preserves the old buffer.")
    (:eng "Caller may trust the arm." :math "State assignment + monotone log." :cs "Deterministic mode set; replace-not-append on rearm."))
  :row-5-emergence (
    (:base "world/tape-record! arms the recorder and captures the initial frame."
     :eng-composition "(define (physics-demo)\n  (world/tape-clear!) (world/tape-record!)\n  (world/wind! 0.1 0)\n  (let loop ((n 60)) (when (> n 0) (world/step) (loop (- n 1))))\n  (world/tape-stop!)\n  (world/tape-save))\n(physics-demo)"
     :math-composition "(define (bounded-record cap seconds fps)\n  ;; Prove: cap is monotone-bounded regardless of steps requested.\n  (world/tape-clear!) (world/tape-record! cap)\n  (let loop ((n (* seconds fps)))\n    (when (> n 0) (world/step) (loop (- n 1))))\n  (list ':cap cap ':held (length (world/tape-frames))))\n(bounded-record 100 5 30)"
     :cs-composition "(define (session-orchestrator scenes)\n  ;; Record N scenes with a fresh session boundary between each.\n  (map (lambda (s)\n         (world/tape-clear!) (world/tape-record!)\n         (s)\n         (world/tape-stop!)\n         (world/tape-hash))\n       scenes))\n(session-orchestrator (list (lambda () (world/step))))"
     :emergent "A record-cycle triad: chaining tape-record! with clear/step/stop/save yields physics-demo capture + bounded rolling buffer + multi-scene orchestrator — the recording-session family."
     :meta "Record-cycle family; same slot as OBS Studio session + Prometheus scrape-window.")
    (:eng "Demo captures are audit-legible with a start-timestamp." :math "Session as a sequence of mode transitions." :cs "Record-cycle pattern with fresh-session boundaries.")))

(verb
  :name "world/tape-recording?" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/tape-recording?) -> boolean"
  :summary "Check whether the motion tape is currently armed (recording frames on each step)."
  :explanation "The tape can be armed (frames accumulate with each `world/step`) or disarmed (steps do not record). This verb returns `true` if recording is live, `false` otherwise. Use it to guard code paths that should only run during capture, or to decide whether to halt recording."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (display (world/tape-recording?))\n  (world/tape-record! 100)\n  (display (world/tape-recording?))\n  (world/tape-stop!)\n  (display (world/tape-recording?)))" :note "Initially false, becomes true after `tape-record!`, then false after `tape-stop!`.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-record! 500)\n  (let loop ((i 0)) (when (< i 50)\n    (if (world/tape-recording?)\n      (begin\n        (world/each (lambda (id) (entity/move! id 1 0)))\n        (world/step))\n      (display 'recording-halted)) (loop (+ i 1)))))" :note "Guard a movement loop: only move and step if recording is still armed.")
    (:dialect "motoi" :tier "expert" :code "(define (capture-until-full ctx)\n  (if (world/tape-recording?)\n    (let ((frames (world/tape-frames))\n          (cap 1000))\n      (world/step)\n      (if (>= frames cap)\n        (begin\n          (world/tape-stop!)\n          (next 'save-tape (ctx-set 'frames frames ctx)))\n        (next 'capture-until-full ctx)))\n    (next 'idle ctx)))" :note "Recursively step and check capacity; when full, stop and transition. The guard `world/tape-recording?` ensures we don't step after stopping.")
  )
  :caveats ("Returns `false` by default (tape is not armed on startup)." "Checking this does not affect the tape; it is a pure read." "Frame count can be > 0 even if recording is false (a stopped tape retains its contents).")
  :drawbacks ("Does not tell you how full the tape is or whether capacity was exceeded; use `world/tape-frames` for that." "No way to pause recording without stopping (stopping disarms but keeps frames; restarting via `tape-record!` clears them).")
  :usecases ("Conditional logic: only record motion during a specific phase or when a condition is met." "Safety check: verify that recording is still active before performing expensive captures." "State machine transitions: decide whether to save the tape or discard it based on whether recording succeeded.")
  :related ("world/tape-record!" "world/tape-stop!" "world/tape-frames" "world/tape-clear!")
  :learn (:concept "State queries—in addition to reading data, you often need to know *whether* a resource is active. This verb answers that question." :prerequisites ("world/tape-record!" "world/step") :progression "Combine with `world/tape-frames` and `world/tape-stop!` to build a full tape management workflow.")
  :row-2-audit (
    (:problem "A live user session is playing back a demo tape; before writing a NEW recording the operator must confirm the tape is not already armed (or else risk overwriting the demo)."
     :eng-program "(define (safe-arm)\n  (if (world/tape-recording?)\n      (list 'refused 'already-recording)\n      (begin (world/tape-record!) (list 'armed))))\n(safe-arm)"
     :math-program "(define (mode-consistency)\n  ;; The predicate is a Boolean function into {#t,#f} — no midstates.\n  (let ((r (world/tape-recording?)))\n    (list ':val r ':boolean? (boolean? r))))\n(mode-consistency)"
     :cs-program "(define (pure-read?)\n  ;; Two consecutive reads with no writes must agree.\n  (eq? (world/tape-recording?) (world/tape-recording?)))\n(pure-read?)"
     :explanation "eng: guarded-arm to prevent double-record. math: shape check — value is strictly Boolean. cs: read-purity witness."
     :meta "Reach for world/tape-recording? and NOT world/tape-frames > 0: frames > 0 is TRUE even after a stop; recording? is TRUE only while ACTIVELY armed. Choose by 'content vs mode'.")
    (:eng "Mode reads drive UI and pre-flight checks." :math "Boolean predicate on the tape FSM." :cs "Read of a mode flag; pure within a frame."))
  :row-3-dimension (
    (:setup "Read the current mode of a resource — is it armed / on / active?"
     :rungs (
       (:domain "world"  :code "(define (rm-buf) (list 'cleared))
(rm-buf)")
       (:domain "video"  :code "(define (is-recording?) #t)
(is-recording?)")
       (:domain "math"   :code "(define (armed? m) (eq? m 'on))
(armed? 'on)"))
     :explanation "Rung 1: tape mode. Rung 2: video-camera REC light. Rung 3: mode predicate. All three: 'is this thing currently on?'."
     :meta "Shape: mode predicate / capability check.")
    (:eng "Mode predicates drive UI and safety guards." :math "Boolean read." :cs "Mode read; O(1) with no side effects."))
  :row-4-proof (
    (:claim "Round-trip consistency: recording?(stop!(record!(w))) = #f ∧ recording?(record!(w)) = #t."
     :eng-program "(world/tape-clear!)\n(define a (begin (world/tape-record!) (world/tape-recording?)))\n(define b (begin (world/tape-stop!) (world/tape-recording?)))\n(and a (not b))"
     :math-program "(define (fsm-transitions-consistent?)\n  ;; Full round-trip: off → on → off.\n  (world/tape-clear!)\n  (let* ((s0 (world/tape-recording?))\n         (s1 (begin (world/tape-record!) (world/tape-recording?)))\n         (s2 (begin (world/tape-stop!) (world/tape-recording?))))\n    (and (not s0) s1 (not s2))))\n(fsm-transitions-consistent?)"
     :cs-program "(define (read-does-not-mutate?)\n  (world/tape-record!)\n  (world/tape-recording?) (world/tape-recording?) (world/tape-recording?)\n  (world/tape-recording?))\n(read-does-not-mutate?)"
     :invariant "∀ w. recording?(stop!(record!(w)))=#f ∧ recording? is pure ∧ boolean?"
     :meta "Round-trip + purity + type. Falsified if a stop leaves the flag set or reads mutate.")
    (:eng "State predicate reliably reflects mode." :math "Function into {#t,#f} with FSM round-trip." :cs "Deterministic pure mode read."))
  :row-5-emergence (
    (:base "world/tape-recording? reads the recording mode flag."
     :eng-composition "(define (rec-hud)\n  (when (world/tape-recording?)\n    (list ':hud 'REC ':frame (world/frame))))\n(rec-hud)"
     :math-composition "(define (auto-stop-at-cap cap)\n  ;; Compose recording? with tape-frames to enforce policy.\n  (when (and (world/tape-recording?) (>= (world/tape-frames) cap))\n    (world/tape-stop!)))\n(auto-stop-at-cap 100)"
     :cs-composition "(define (guarded-step)\n  ;; Only step when armed — silence when disarmed.\n  (if (world/tape-recording?) (world/step) 'skipped))\n(guarded-step)"
     :emergent "A mode-observant triad: chaining recording? with HUD render + cap-enforce + guarded-step yields REC indicator + capacity throttle + safe-step — the mode-aware-orchestration family."
     :meta "UI-mode-indicator family; same slot as OBS record light + Prometheus scraping-active gauge.")
    (:eng "Mode indicators are essential UX + safety." :math "Predicate-driven branch." :cs "State-tagged UI + guard patterns.")))

(verb
  :name "world/tape-replay" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/tape-replay surface) -> 'empty-tape | 'service-not-yet-wired"
  :summary "Replay the motion tape onto a registered surface (live re-render; not yet wired in the harness)."
  :explanation "After recording a tape, you can re-render it to visualize the motion. This verb accepts a surface argument and attempts to replay each frame onto that surface. Currently, the in-app harness does not wire the render path; the verb returns `'service-not-yet-wired` as a signal that the feature is planned but not yet implemented. If the tape is empty, it returns `'empty-tape`. In a full implementation, each frame would paint its entities onto the surface, frame by frame."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (world/tape-record! 100)\n  (world/step)\n  (let ((result (world/tape-replay 'some-surface)))\n    (display result)))" :note "After recording, call replay. Currently always returns `'service-not-yet-wired`.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-clear!)\n  (let ((result (world/tape-replay 'any-surface)))\n    (if (equal? result 'empty-tape)\n      (display 'nothing-to-replay)\n      (display result))))" :note "If tape is empty, `'empty-tape` is returned; otherwise, `'service-not-yet-wired`.")
    (:dialect "motoi" :tier "expert" :code "(define (maybe-replay ctx)\n  (let ((saved-tape (ctx-get 'tape ctx)))\n    (if (null? saved-tape)\n      (escalate 'no-tape-to-replay null)\n      (begin\n        (world/tape-clear!)\n        (world/tape-record! 10000)\n        ;; (populate tape from saved-tape here)\n        (let ((status (world/tape-replay (ctx-get 'surface ctx))))\n          (cond ((equal? status 'empty-tape)\n                 (escalate 'replay-failed 'empty))\n                ((equal? status 'service-not-yet-wired)\n                 (next 'await-render-wire ctx))\n                (else\n                 (next 'replay-active ctx))))))))" :note "Check the return value to branch: if `'empty-tape`, something went wrong; if `'service-not-yet-wired`, the service is not yet bound (expected state).")
  )
  :caveats ("Currently always returns `'service-not-yet-wired`; actual rendering is not yet implemented in Scheme." "The `surface` argument is accepted but not used (no-op in current implementation)." "Returns `'empty-tape` if tape is empty, but this is the only success case that might be meaningful in future versions.")
  :drawbacks ("Feature is not yet wired; you cannot actually replay visual output from Scheme at this time." "No feedback mechanism to know when render is complete or has failed." "The render path is expected to be in the harness; Scheme cannot directly control painting.")
  :usecases ("Future-proofing: call this verb to prepare for the moment when live replay rendering is available." "Placeholder in replay workflows: structure your code to call `tape-replay` even though it is not yet functional, so the integration is ready when the service is wired." "Testing replay mechanics: verify that the tape structure is valid before the render service comes online.")
  :related ("world/tape-save" "world/tape-record!" "world/tape-frames" "surface-paint-dots" "surface-paint-text")
  :learn (:concept "Forward compatibility—sometimes a verb is declared and stubbed before its implementation arrives. This teaches you to code defensively by checking return values and understanding what a deferred service means." :prerequisites ("world/tape-record!" "world/tape-save") :progression "As the harness evolves and `tape-replay` is wired, you will gradually see it return meaningful results instead of `'service-not-yet-wired`. Keep your error checks in place.")
  :row-2-audit (
    (:problem "An animation studio wants to review yesterday's take on the current surface — replay the saved tape and observe if the frame timing feels right. The reviewer must handle the current stub gracefully so the review harness doesn't hang."
     :eng-program "(define (review-take surface)\n  (let ((r (world/tape-replay surface)))\n    (cond ((eq? r 'empty-tape) 'no-take-recorded)\n          ((eq? r 'service-not-yet-wired) 'reviewer-defer)\n          (else (list 'playback r)))))\n(review-take 'main-surface)"
     :math-program "(define (replay-as-inverse-of-record)\n  ;; Playback should be the categorical inverse of record; today it's stubbed.\n  (list ':forward 'record ':inverse 'replay ':status 'stubbed))\n(replay-as-inverse-of-record)"
     :cs-program "(define (total-domain?)\n  ;; Verify the contract holds for empty, valid, and 'not-yet-wired inputs.\n  (let ((r (world/tape-replay 'x)))\n    (or (eq? r 'service-not-yet-wired)\n        (eq? r 'empty-tape)\n        (list? r))))\n(total-domain?)"
     :explanation "eng: three-branch review harness. math: name the categorical relationship (replay = inverse of record). cs: totality contract witness."
     :meta "Reach for world/tape-replay and NOT world/tape-save: save serializes; replay reconstructs + plays. Wrong direction.")
    (:eng "Stub responses must be handled defensively." :math "Categorical inverse of record; currently stub-wired." :cs "Deserialize + apply; total function with sentinel returns."))
  :row-3-dimension (
    (:setup "Reconstruct state from a serialized recording — replay a captured stream."
     :rungs (
       (:domain "world"  :code "(world/tape-replay \"a.tape\")")
       (:domain "video"  :code "(define (play f) 'playing) (play \"movie.mp4\")")
       (:domain "math"   :code "(define (interpret trace) trace)
(interpret '((step 1)))"))
     :explanation "Rung 1: tape replay. Rung 2: video playback. Rung 3: trace interpretation. All three: 'reconstruct state from a serialized recording'."
     :meta "Shape: replay / interpretation of a captured stream.")
    (:eng "Replay verifies recording correctness." :math "Left-inverse of the record operation." :cs "State reconstructor from a bytestring."))
  :row-4-proof (
    (:claim "Contract stability: replay is a total function into a sum type — never crashes, always yields a sentinel or a handle."
     :eng-program "(let ((r (world/tape-replay 'anything)))\n  (or (eq? r 'service-not-yet-wired) (eq? r 'empty-tape) (list? r) (symbol? r)))"
     :math-program "(define (contract-invariant)\n  ;; Sum type: {stub-sentinel} ∪ {empty-sentinel} ∪ {list handle}.\n  (let ((r (world/tape-replay 'x)))\n    (or (memq r '(service-not-yet-wired empty-tape)) (list? r))))\n(contract-invariant)"
     :cs-program "(define (idempotent-during-stub?)\n  (let ((r1 (world/tape-replay 'x)) (r2 (world/tape-replay 'x)))\n    (equal? r1 r2)))\n(idempotent-during-stub?)"
     :invariant "∀ path. tape-replay(path) ∈ {'service-not-yet-wired, 'empty-tape} ∪ ReplayHandle"
     :meta "Sum-type totality. Falsified if replay throws or returns arbitrary values.")
    (:eng "Callers can code against the stub without special-casing failures." :math "Total function into a sum type." :cs "Stable API surface across stub → wired transition."))
  :row-5-emergence (
    (:base "world/tape-replay reconstructs from a saved tape."
     :eng-composition "(define (safe-replay-log path)\n  ;; Wrap replay with a logger — decision + status per call.\n  (let ((r (world/tape-replay path)))\n    (list ':path path ':status (cond ((eq? r 'empty-tape) 'no-content)\n                                     ((eq? r 'service-not-yet-wired) 'pending)\n                                     (else 'active)))))\n(safe-replay-log \"demo.tape\")"
     :math-composition "(define (record-and-replay-roundtrip)\n  ;; The composition record ∘ replay ~= identity (once wired).\n  (world/tape-clear!) (world/tape-record!)\n  (world/step) (world/step)\n  (let ((h1 (world/tape-hash)))\n    (world/tape-save)\n    (world/tape-replay \"tmp\")\n    (list ':h1 h1 ':status 'awaiting-wired)))\n(record-and-replay-roundtrip)"
     :cs-composition "(define (batch-review paths)\n  ;; Review a batch of tapes — collect status per path.\n  (map (lambda (p) (cons p (world/tape-replay p))) paths))\n(batch-review (list \"a.tape\" \"b.tape\"))"
     :emergent "A defensive-replay triad: chaining tape-replay with log + roundtrip-check + batch yields safe-consumer + future-CI + reviewer-dashboard — the forward-compat-API family."
     :meta "Defensive-API-consumer family; same slot as gRPC UNIMPLEMENTED handling + feature-flag defaults.")
    (:eng "Defensive callers survive the stub → impl transition unchanged." :math "Total function with sentinel fallbacks." :cs "Result-branching consumer + logger.")))

(verb
  :name "world/tape-save" :std "Motoi"
  :library "world"
  :kind "rd"
  :signature "(world/tape-save) -> (list) | '()"
  :summary "Serialize the entire motion tape into a portable, re-renderable list of frames (each with entities and local viewport camera); empty tape → '()."
  :explanation "The tape is an in-memory buffer. To persist it or pass it between systems, serialize it via this verb. The result is a list of frames, where each frame is a list: `(frame-number cam-x cam-y hash (entity-list) local-camera)`. Each entity record is `(id kind sprite x y state)`. The local camera is `[x y k]` or the symbol `'none`. This is the true recording—the lightweight, replayable form that a host can stash and re-render. Empty tape → `'()` (the empty list, not an error)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (world/tape-record! 50)\n  (world/step)\n  (world/step)\n  (let ((saved (world/tape-save)))\n    (display (length saved))))" :note "After two steps, tape has 3 frames. Serialized list length is 3.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-record! 200)\n  (let loop ((i 0)) (when (< i 10) (world/step) (loop (+ i 1))))\n  (let ((tape (world/tape-save)))\n    (if (null? tape)\n      (display 'empty)\n      (begin\n        (display (list 'frames (length tape)))\n        (display (list 'hash (world/tape-hash)))))))" :note "Save the tape after recording. Check that it is non-empty and display frame count and hash for later validation.")
    (:dialect "motoi" :tier "expert" :code "(define (checkpoint-scene ctx)\n  (let ((tape (world/tape-save))\n        (camera (world/tape-lcamera)))\n    (if (null? tape)\n      (escalate 'checkpoint-failed 'empty-tape)\n      (let ((checkpoint (list 'version 1 'frames tape 'camera camera 'hash (world/tape-hash))))\n        (begin\n          (display (list 'checkpointed (length tape) 'frames))\n          (next 'await-restore (ctx-set 'checkpoint checkpoint ctx)))))))" :note "Package the tape, camera, and hash into a checkpoint structure. Later, verify the hash matches during replay to detect corruption.")
  )
  :caveats ("Returns the empty list `'()` if tape is empty; this is a valid, honest-null result, not an error." "The serialized format includes frame number, camera, hash, and entity state. Do not edit these by hand; structure is strict." "Local camera may be `'none` if no camera was recorded for a given frame." "Entity state field may be `'none` if an entity had no state object.")
  :drawbacks ("Tape grows unbounded if no capacity was set; serializing a very large tape consumes time and memory." "Format is not compressed; a long recording with many entities will produce a large list." "No built-in versioning; if the tape format changes in a future Motoi version, old saved tapes may not deserialize.")
  :usecases ("Persistence: save a recording to disk or a database so it can be replayed later, even after the program restarts." "Determinism testing: save a tape, run a replay, verify the hash matches to confirm the replay is bit-identical." "Data sharing: export a tape in a portable form so other tools or systems can analyze or visualize it." "Checkpointing: bundle a tape with metadata (version, timestamp, actor info) to preserve a complete simulation snapshot.")
  :related ("world/tape-record!" "world/tape-frames" "world/tape-hash" "world/tape-lcamera" "world/tape-stop!")
  :learn (:concept "Serialization—converting a live, mutable resource (the in-memory tape) into a durable, shareable data structure. This is how you preserve the results of a simulation." :prerequisites ("world/tape-record!" "world/tape-frames" "world/tape-hash") :progression "After saving a tape, learn to validate it via hash and then design replay workflows that use the serialized data.")
  :row-2-audit (
    (:problem "A ragdoll-physics bug is only reproducible after a specific sequence of steps; the operator wants to serialize the exact recording so the next reviewer can bit-identically re-run it."
     :eng-program "(define (bug-repro-package label)\n  (let ((tape (world/tape-save)))\n    (list ':label label ':n (length tape) ':hash (world/tape-hash))))\n(bug-repro-package 'ragdoll-glitch-2026)"
     :math-program "(define (serialization-length-invariant)\n  ;; |save(tape)| = |frames(tape)| — every frame becomes a serialized record.\n  (let ((tape (world/tape-save)))\n    (= (length tape) (length (world/tape-frames)))))\n(serialization-length-invariant)"
     :cs-program "(define (empty-honest-null?)\n  ;; Empty tape → '() (honest null), not an error.\n  (world/tape-clear!)\n  (null? (world/tape-save)))\n(empty-honest-null?)"
     :explanation "eng: full bug-repro bundle with label + hash. math: length-preservation witness (save is bijective on structure). cs: contract that empty tape returns '() not an error."
     :meta "Reach for world/tape-save and NOT world/tape-frames: frames stays in memory; save returns a portable serialization. Choose by 'in-memory vs portable'.")
    (:eng "Saves cost O(bytes); profile for large tapes." :math "Serialization: Tape → List(Frame) length-preserving." :cs "Buffer → list; honest-null on empty."))
  :row-3-dimension (
    (:setup "Persist a mutable resource to a portable durable form."
     :rungs (
       (:domain "world"  :code "(world/tape-save)")
       (:domain "shell"  :code "(define (save f data) 'saved) (save \"a.txt\" 'data)")
       (:domain "math"   :code "(define (encode xs) xs)
(encode '(1 2 3))"))
     :explanation "Rung 1: tape → list. Rung 2: file save. Rung 3: encoding. All three: 'convert live state to durable form'."
     :meta "Shape: serialize + persist.")
    (:eng "Persistence is safety-critical for reproducibility." :math "Length-preserving serialization." :cs "Write-through to portable representation."))
  :row-4-proof (
    (:claim "Save fidelity: |save(tape)| = |frames(tape)|; save is pure + idempotent + non-destructive."
     :eng-program "(world/tape-clear!) (world/tape-record!) (world/step)\n(define saved (world/tape-save))\n(and (list? saved) (= (length saved) (length (world/tape-frames))))"
     :math-program "(define (idempotent-save?)\n  ;; Two consecutive saves of a frozen tape agree.\n  (equal? (world/tape-save) (world/tape-save)))\n(idempotent-save?)"
     :cs-program "(define (save-does-not-clear?)\n  (world/tape-record!) (world/step) (world/step)\n  (world/tape-save)\n  (> (length (world/tape-frames)) 0))\n(save-does-not-clear?)"
     :invariant "∀ tape. |save(tape)| = |frames(tape)| ∧ save is pure ∧ save∘save = save ∧ tape unchanged"
     :meta "Length-preservation + purity + non-destructive. Falsified if save drops frames, has side effects, or diverges on repeat.")
    (:eng "Saved tapes are trustworthy for external analysis." :math "Serialization is a length-preserving map." :cs "Lossless snapshot; non-destructive."))
  :row-5-emergence (
    (:base "world/tape-save serializes the tape into a portable list of frames."
     :eng-composition "(define (checkpoint-with-meta name)\n  (let ((tape (world/tape-save))\n        (cam (world/tape-lcamera))\n        (h (world/tape-hash)))\n    (list ':name name ':tape tape ':cam cam ':hash h ':version 1)))\n(checkpoint-with-meta \"level-1-cleared\")"
     :math-composition "(define (roundtrip-witness)\n  ;; hash(tape) and length(save(tape)) are joint witnesses of content.\n  (let ((h (world/tape-hash))\n        (saved (world/tape-save)))\n    (list ':orig-hash h ':saved-len (length saved) ':claim 'roundtrip-fidelity)))\n(roundtrip-witness)"
     :cs-composition "(define (export-batch names)\n  ;; Export multiple named tapes to a store keyed by name.\n  (map (lambda (n)\n         (world/tape-clear!) (world/tape-record!) (world/step)\n         (cons n (world/tape-save)))\n       names))\n(export-batch '(a b c))"
     :emergent "A durable-checkpoint triad: chaining tape-save with metadata + hash-witness + batch export yields versioned checkpoint + roundtrip validator + export pipeline — the persistence-with-provenance family."
     :meta "Save-file family; same slot as SQLite dump + game-save format.")
    (:eng "Save files need atomic write + provenance metadata." :math "Persistence primitive with content-hash witness." :cs "Durable checkpoint + exporter.")))

(verb
  :name "world/tape-stop!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/tape-stop!) -> number"
  :summary "Stop recording; disarm the motion tape and return the final frame count."
  :explanation "After calling `world/tape-record!`, each `world/step` appends a frame. This verb disarms recording (sets the internal flag to false) so that future steps no longer record. The tape itself is retained, and you can inspect or save it via `world/tape-frames`, `world/tape-save`, or `world/tape-hash`. The return value is the total number of frames captured (including the initial frame from `tape-record!`). Use this to halt recording, report progress, and decide whether to keep or discard the tape."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin\n  (world/tape-record! 100)\n  (world/step)\n  (world/step)\n  (let ((count (world/tape-stop!)))\n    (display (list 'frames-recorded count))))" :note "Record two steps (plus initial), stop, and report that 3 frames were captured.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (world/tape-record! 500)\n  (let loop ((i 0)) (when (< i 100)\n    (world/each (lambda (id) (entity/move! id 0.5 0)))\n    (world/step) (loop (+ i 1))))\n  (let ((final-count (world/tape-stop!)))\n    (if (> final-count 450)\n      (display 'tape-near-full)\n      (display (list 'recorded final-count)))))" :note "Record up to 100 steps (plus init), stop, and check if we're near capacity. Return value tells us how many frames we actually have.")
    (:dialect "motoi" :tier "expert" :code "(define (record-and-checkpoint ctx)\n  (world/tape-record! 10000)\n  (let ((loop (lambda (frame-target)\n         (if (< (world/tape-frames) frame-target)\n           (begin\n             (world/step)\n             (loop frame-target))\n           (let ((count (world/tape-stop!)))\n             (begin\n               (display (list 'checkpointed count))\n               (next 'save (ctx-set 'tape (world/tape-save) ctx))))))))\n    (loop 500)))" :note "Recursively step until we reach a target frame count (500), then stop and capture the tape. Return value confirms the count.")
  )
  :caveats ("Calling `world/tape-stop!` does not clear the tape; frames remain in memory until `world/tape-clear!` is called." "If recording was already halted (via a prior `tape-stop!` call), calling it again still returns the current frame count and succeeds (idempotent with respect to the flag)." "Return value is the frame count at the moment `tape-stop!` is invoked; it does not change afterward unless more frames are added (via a new `tape-record!`).")
  :drawbacks ("No way to resume recording without clearing the tape; `tape-record!` always starts fresh." "If you want to record multiple independent takes, you must manually save each tape (via `world/tape-save`) before calling `tape-record!` again.")
  :usecases ("Ending a recording session and reporting how many frames were captured." "Checking whether the tape reached a size threshold before deciding to save or discard it." "Halting recording when a condition is met (e.g., a scene completes or an error occurs), while preserving the frames for inspection.")
  :related ("world/tape-record!" "world/tape-frames" "world/tape-recording?" "world/tape-clear!" "world/tape-save")
  :learn (:concept "State machine transitions—the tape has two states (armed/disarmed), and `tape-stop!` is the verb that transitions from one to the other while reporting the outcome." :prerequisites ("world/tape-record!" "world/step") :progression "After stopping a recording, use `world/tape-save` to serialize it, `world/tape-hash` to validate it, and `world/tape-clear!` to discard it when ready.")
  :row-2-audit (
    (:problem "A user-session capture is complete; the operator wants to halt further appending but keep the buffer for post-mortem analysis and export."
     :eng-program "(define (end-session)\n  (let ((n (world/tape-stop!)))\n    (list ':halted-at n ':still-inspectable? (> (length (world/tape-frames)) 0))))\n(end-session)"
     :math-program "(define (stop-is-mode-only)\n  ;; Stop transitions the FSM but leaves frames invariant.\n  (world/tape-record!) (world/step) (world/step)\n  (let ((before (length (world/tape-frames))))\n    (world/tape-stop!)\n    (= before (length (world/tape-frames)))))\n(stop-is-mode-only)"
     :cs-program "(define (idempotent-stop?)\n  ;; Stop twice returns the current count; no exception.\n  (world/tape-record!) (world/step)\n  (world/tape-stop!)\n  (integer? (world/tape-stop!)))\n(idempotent-stop?)"
     :explanation "eng: session-end report with inspectability status. math: witness that stop is a mode-only transition (frames invariant). cs: idempotence contract on repeated stops."
     :meta "Reach for world/tape-stop! and NOT world/tape-clear!: stop DISARMS + preserves; clear ERASES. Choose by 'halt-and-keep vs discard'.")
    (:eng "Stop is a mode change; log the halt-timestamp + count." :math "State transition to disarmed; content invariant." :cs "Set mode to #f; return count contract."))
  :row-3-dimension (
    (:setup "Halt an active mode without destroying state — pause the writer, keep the log."
     :rungs (
       (:domain "world"  :code "(world/tape-stop!)")
       (:domain "video"  :code "(define (stop-rec) 'stopped)
(stop-rec)")
       (:domain "math"   :code "(define (disarm) '((mode . off)))
(disarm)"))
     :explanation "Rung 1: tape stop. Rung 2: video rec stop. Rung 3: disarm. All three: 'halt without discard'."
     :meta "Shape: halt-without-clear.")
    (:eng "Mode halts preserve state for post-analysis." :math "State transition; content-preserving." :cs "Mode off; frames untouched."))
  :row-4-proof (
    (:claim "Disarm-only: recording?(stop!(w)) = #f ∧ frames(stop!(w)) = frames(w) ∧ stop! returns |frames|."
     :eng-program "(world/tape-clear!) (world/tape-record!) (world/step)\n(let ((n (world/tape-stop!)))\n  (and (not (world/tape-recording?)) (= n (length (world/tape-frames)))))"
     :math-program "(define (round-trip-mode-transition?)\n  (world/tape-clear!)\n  (world/tape-record!)\n  (let ((s1 (world/tape-recording?)))\n    (world/tape-stop!)\n    (let ((s2 (world/tape-recording?)))\n      (and s1 (not s2)))))\n(round-trip-mode-transition?)"
     :cs-program "(define (stop-returns-count?)\n  (world/tape-clear!) (world/tape-record!) (world/step) (world/step)\n  (= (world/tape-stop!) (length (world/tape-frames))))\n(stop-returns-count?)"
     :invariant "∀ w. recording?(stop!(w))=#f ∧ frames(stop!(w))=frames(w) ∧ stop!(w) = |frames(w)|"
     :meta "Preserve-content + mode-only halt + return-count. Falsified if stop erases, fails to disarm, or returns wrong count.")
    (:eng "Stop is safe; content still queryable and exportable." :math "State-only transition; content-invariant." :cs "Non-destructive halt with count return."))
  :row-5-emergence (
    (:base "world/tape-stop! halts recording; returns frame count; preserves buffer."
     :eng-composition "(define (record-for n)\n  (world/tape-clear!) (world/tape-record!)\n  (let loop ((i n)) (when (> i 0) (world/step) (loop (- i 1))))\n  (world/tape-stop!)\n  (world/tape-hash))\n(record-for 30)"
     :math-composition "(define (bounded-session-with-witness cap)\n  ;; Bounded-time record — stop enforces the ceiling.\n  (world/tape-clear!) (world/tape-record! cap)\n  (let loop ((i 0))\n    (if (>= i cap) (world/tape-stop!)\n        (begin (world/step) (loop (+ i 1))))))\n(bounded-session-with-witness 20)"
     :cs-composition "(define (safe-stop-and-export)\n  ;; Halt cleanly then export in one step.\n  (world/tape-stop!)\n  (list ':tape (world/tape-save) ':hash (world/tape-hash)))\n(safe-stop-and-export)"
     :emergent "A bounded-session triad: chaining tape-stop! with fixed-length record + capacity-enforce + export yields fixed-duration capture + bounded rolling record + halt-and-export — the bounded-session family."
     :meta "Bounded-session family; same slot as timeboxed test-run + cron-with-timeout.")
    (:eng "Bounded sessions have predictable size + guaranteed halt." :math "Bounded time interval on the tape monoid." :cs "Time-boxed record + safe export.")))

(verb
  :name "world/wind!" :std "Motoi"
  :library "world"
  :kind "mut"
  :signature "(world/wind! dvx dvy) -> null"
  :summary "Apply a constant directional force to all physics-enabled entities."
  :explanation "Sets a global wind vector (dvx dvy) that accelerates every entity with physics enabled each frame. This is useful for environmental effects like wind, current, or drift. Pass (0 0) to disable wind. The force is applied uniformly; individual entities can vary their response via entity/gravity-scale! and entity/mass!. Wind does NOT affect pinned or static entities."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(world/wind! 0.1 0)  ; constant rightward wind\n(world/step)" :note "Wind is applied every frame; entities accelerate in the wind direction over time.")
    (:dialect "motoi" :tier "intermediate" :code "(define (update-wind strength)\n  (let ((angle (random-range 0 6.28)))\n    (world/wind! (* strength (cos angle))\n                 (* strength (sin angle)))))\n(update-wind 0.05)  ; wind in a random direction" :note "Wind can be updated per frame or on a schedule; here we vary its direction randomly.")
    (:dialect "motoi" :tier "expert" :code "(define (wind-pulse beat-index strength)\n  (let ((phase (/ (modulo beat-index 4) 4)))\n    (world/wind! (* strength (sin (* 6.28 phase))) 0)))\n(on-tick (lambda (ctx)\n  (wind-pulse (audio-beat? (ctx-get 'beat ctx)) 0.15)\n  ctx))" :note "Wind strength synchronized to audio beats; creates a rhythmic drift effect.")
  )
  :caveats ("Wind is global; all physics-enabled entities are affected equally." "Pinned (entity/pin!) and non-physics entities are not affected." "Wind persists until explicitly changed; call (world/wind! 0 0) to stop it." "Wind is NOT included in world/snapshot or world/restore; it is render-only in the tape.")
  :drawbacks ("Global wind cannot be selectively applied to subgroups; use entity/accel! for per-entity forces." "Wind interacts with entity/drag! and entity/friction! in complex ways; test empirically." "Very strong wind can cause stability issues; keep magnitudes ≤ 0.5 for predictable behavior.")
  :usecases ("Simulating weather effects (wind, storms, currents) in a game world." "Creating ambient drift in zero-gravity or space scenes." "Choreographing entities to move together in a wave or swirl pattern." "Testing physics robustness under constant external forces.")
  :related ("entity/accel!" "entity/drag!" "entity/friction!" "entity/gravity-scale!" "world/gravity!" "world/step")
  :learn (:concept "Global forces as a world-state parameter; how external acceleration affects all physics simultaneously." :prerequisites ("world/spawn" "entity/set-vel!" "entity/mass!") :progression "After this, learn world/gravity! (per-entity override), then entity/accel! (per-frame force).")
  :row-2-audit (
    (:problem "The operator wants a directional drag-force field — an environmental push (wind, current, drift) that acts uniformly on every physics body. world/wind! is the framework's global drag-force parameter; entity/accel! would require per-entity setup that drifts as entities spawn."
     :eng-program "(define (set-breeze strength)\n  (world/wind! strength 0)\n  'wind-active)\n(set-breeze 0.1)"
     :math-program "(define (verify-drag-force)\n  ;; Wind is a constant vector force field: F_wind = (wx, wy).\n  ;; Applied to unit-mass, ax = wx, ay = wy per frame.\n  (world/gravity! 0 0)\n  (world/wind! 2 0)\n  (world/spawn 'e 0 0)\n  (let ((vx0 (car (entity/vel 'e))))\n    (world/step)\n    (- (car (entity/vel 'e)) vx0)))  ; ≈ 2\n(verify-drag-force)"
     :cs-program "(define (finite-wind? wx wy)\n  ;; Reject NaN/Infinity — would poison every entity velocity.\n  (and (number? wx) (number? wy)\n       (< (abs wx) 1e6) (< (abs wy) 1e6)))\n(finite-wind? 2 0)"
     :explanation "eng: set-breeze reifies the ambient setting. math: constant vector force field — Δv = w per frame under unit mass. cs: finite-guard protects the physics slot."
     :meta "Reach for world/wind! over entity/accel! for uniform environmental forces — one call, N entities. Sibling world/gravity! is vertical; wind is horizontal-or-arbitrary.")
    (:eng "SRE: wind is a level-metadata knob; log the vector on level start."
     :math "Constant vector force field added to every velocity."
     :cs "Global horizontal-force slot; single write, N reads per step."))
  :row-3-dimension (
    (:setup "A directional global parameter."
     :rungs (
       (:domain "world"  :code "(define (finite-wind? wx wy)\n  ;; Reject NaN/Infinity — would poison every entity velocity.\n  (and (number? wx) (number? wy)\n       (< (abs wx) 1e6) (< (abs wy) 1e6)))\n(finite-wind? 2 0)")
       (:domain "weather":code "(define w '((wind-mph . 10))) w")
       (:domain "math"   :code "(define (add-vec v c) (map + v c))
(add-vec '(0 0) '(2 0))"))
     :explanation "Rung 1: game wind. Rung 2: weather report. Rung 3: vector add. Each: 'a global directional bias'."
     :meta "Shape: directional global.")
    (:eng "SRE: directional globals need one owner." :math "Constant vector field." :cs "Ambient parameter."))
  :row-4-proof (
    (:claim "Universality + linearity: wind is added to every physics entity's velocity per step, and doubling the wind vector doubles the per-step velocity delta."
     :eng-program "(define (universality-witness)\n  (world/wind! 3 0)\n  (world/spawn 'a 0 0)\n  (let ((vx0 (car (entity/vel 'a))))\n    (world/step)\n    (> (car (entity/vel 'a)) vx0)))\n(universality-witness)"
     :math-program "(define (linearity-witness)\n  ;; Δv(2·w) = 2·Δv(w). Constant-vector field is linear.\n  (world/gravity! 0 0) (world/spawn 'a 0 0) (world/spawn 'b 0 0)\n  (world/wind! 1 0) (world/step)\n  (let ((va (car (entity/vel 'a))))\n    (world/reset!) (world/spawn 'c 0 0)\n    (world/wind! 2 0) (world/step)\n    (= (car (entity/vel 'c)) (* 2 va))))\n(linearity-witness)"
     :cs-program "(define (skip-pinned-witness)\n  ;; Pinned entities do NOT pick up wind — invariant of the physics pass.\n  (world/wind! 5 0)\n  (world/spawn 'pin 0 0)\n  (entity/pin! 'pin)\n  (let ((v0 (car (entity/vel 'pin))))\n    (world/step)\n    (= (car (entity/vel 'pin)) v0)))\n(skip-pinned-witness)"
     :invariant "∀ e ∈ participants. vx(e,t+1) = vx(e,t) + wx ∧ Δv(k·w) = k·Δv(w) ∧ ∀ e pinned. vx(e,t+1) = vx(e,t)"
     :meta "Universal application + linearity + skip-pinned. Falsified if participating entity misses wind, doubling doesn't double, or pinned picks it up. Book-of-math ch 9 (uniform fields) grounds.")
    (:eng "Consequence: predictable global drift; wind scales linearly with the input vector."
     :math "Universal quantifier over participants; F = w on unit mass."
     :cs "Uniform per-tick delta on participants; identity on pinned bodies."))
  :row-5-emergence (
    (:base "world/wind! sets a global horizontal force field."
     :eng-composition "(define (drifting-leaf-scene)\n  (world/gravity! 0 9.8)\n  (world/wind! 3 0)\n  (world/spawn 'leaf 100 100)\n  (entity/mass! 'leaf 0.1)\n  (entity/drag! 'leaf 0.95))\n(drifting-leaf-scene)"
     :math-composition "(define (steady-state-drift wx drag)\n  ;; Terminal x-velocity under wind wx and drag k: vx_∞ = wx / (1 - drag).\n  (/ wx (- 1 drag)))\n(steady-state-drift 3 0.95)"
     :cs-composition "(define (varying-wind-schedule)\n  ;; Pulse wind on beat — synchronize environmental force to a rhythm.\n  (let ((beat (modulo (world/frame) 60)))\n    (world/wind! (* 0.15 (sin (* 6.28 (/ beat 60)))) 0)))\n(varying-wind-schedule)"
     :emergent "A drifting-leaf demo + terminal-drift math + beat-synced wind schedule: wind chains with gravity/drag/mass for authentic environment; steady-state math gives closed-form limits; schedule syncs to rhythm. Emergent: environmental physics with rhythmic modulation."
     :meta "Ambient-physics family; standard weather effects. Book-of-composition ch 9 (preset bundles) grounds.")
    (:eng "SRE: ambient physics presets tune atmosphere; scheduled wind adds musicality."
     :math "Sum of global fields; drag opposes wind; terminal velocity is the fixed point."
     :cs "Bundled ambient setup; scheduled variant is a frame-phase modulator."))
)

;; ═══ loop lifecycle (single-world model) ═══
;; world/frame + world/step (above) advance the one world; these four verbs
;; observe and control its run state. Folded here from the unwired multi-game
;; game/* lifecycle surface 2026-07-25 — the `id` handle is gone because Motoi
;; has exactly one world. Teaching card:
;; broken-examples/game-lifecycle-multi-to-single-world.slatl

(verb
  :name "world/running?" :std "Motoi"
  :library "world"
  :kind "pure"
  :dialect "motoi"
  :signature "(world/running?) -> boolean"
  :arity "0"
  :contract "no args → #t while the world loop is live, #f after world/stop"
  :summary "Test whether the world loop is currently running."
  :doc "Returns #t for a fresh or resumed world, #f after world/stop. Pure read; does not advance time. There is one world, so there is no id argument and no unknown-id case."
  :since "1.0"
  :explanation "The single Motoi world carries a running flag. world/running? returns #t when the loop is live (world/step advances it and per-frame handlers fire) and #f once world/stop has halted it. Because Motoi has exactly one world — not a registry of games keyed by id — world/running? takes no argument. Use it to guard per-frame logic that should only run while the world is live, or to detect a game-over transition."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (world/reset!) (world/running?))" :note "A fresh world is live. Returns #t.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (world/reset!) (world/stop) (world/running?))" :note "After world/stop the loop is halted. Returns #f.")
    (:dialect "motoi" :tier "expert" :code "(begin (world/reset!)\n  (list ':before (world/running?)\n        ':after-stop (begin (world/stop) (world/running?))\n        ':after-start (begin (world/start) (world/running?))))" :note "Observe the full transition. Returns (:before #t :after-stop #f :after-start #t).")
  )
  :caveats ("world/running? is a pure read: it never advances the frame counter or mutates state." "It reports only the stopped flag — a live world with no per-frame handler registered still reads #t." "There is no id and no 'nan case; the world always exists after boot.")
  :drawbacks ("There is no pause distinct from stop; world/running? cannot distinguish a paused world from a stopped one." "It tells you the loop is halted, not why; read world/state for the frame/entity context around a stop.")
  :usecases ("Guard per-frame logic so it runs only while the world is live." "Detect a game-over transition by watching for #f." "Gate a manual step loop: keep calling world/step while world/running? holds.")
  :related ("world/stop" "world/start" "world/state" "world/frame" "world/step")
  :learn (:concept "World lifecycle: one world boots live (world/running? = #t), halts (world/stop → #f), and resumes (world/start → #t)." :prerequisites ("world/reset!" "world/step") :progression "Pair with world/stop and world/start to control the loop, and world/state to read frame + entity context.")
  :row-2-audit (
    (:problem "A per-frame update must skip work once the world is halted; the operator has no id to key on and must test the one world's liveness. world/running? is the canonical liveness read; inspecting world/state and destructuring its alist is indirection."
     :eng-program "(begin (world/reset!)\n  (define (safe-tick) (if (world/running?) (world/step) 'halted))\n  (world/stop)\n  (safe-tick))"
     :math-program (:honest-null "Liveness is a discrete flag read on the single world — a boolean lookup, not a function over numbers. No algebra.")
     :cs-program "(begin (world/reset!)\n  ;; Pure read: two reads with no mutation between must agree.\n  (eq? (world/running?) (world/running?)))"
     :explanation "eng: guarded-step wrapper returns 'halted once stopped. math: HONEST-NULL — liveness is not algebra. cs: read-purity witness."
     :meta "Reach for world/running? over pulling the :running cell out of world/state; the predicate is the canonical liveness check.")
    (:eng "Guarded step avoids doing work on a halted world."
     :math "Honest-null — state predicate is a flag read, not algebra."
     :cs "Single flag read; O(1); pure within a frame."))
  :row-3-dimension (
    (:setup "liveness predicate on a single resource — same shape appears in the world loop, a file handle, a running thread"
     :rungs ((:domain "world"  :code "(begin (world/reset!) (world/running?))")
             (:domain "handle" :code "(define (open? h) (not (eq? h 'closed)))\n(open? 'closed)")
             (:domain "thread" :code "(define (alive? t) (eq? (car t) 'running))\n(alive? '(running 42))"))
     :explanation "Rung 1 reads world liveness. Rung 2 reads handle liveness. Rung 3 reads thread liveness. All three query a resource's run state before using it."
     :meta "The shape transfers because 'liveness before use' is universal in resource management.")
    (:eng "OS, runtime, and the world loop all guard actions with a liveness read."
     :math "Honest-null — predicate is a flag read; not algebraic."
     :cs "One indirection + one compare."))
  :row-4-proof (
    (:claim "Boot invariant + stop/start consistency: a fresh world is running; after world/stop it is not; after world/start it is again."
     :eng-program "(begin (world/reset!) (world/running?))"
     :math-program (:honest-null "The claim is a state-machine post-condition on a flag — no ∀ over a numeric domain. See row 2 honest-null.")
     :cs-program "(begin (world/reset!)\n  (world/stop)\n  (let ((halted (not (world/running?))))\n    (world/start)\n    (and halted (world/running?))))"
     :invariant "running?(reset!) = #t ∧ running?(after stop) = #f ∧ running?(after start) = #t"
     :meta "FSM boot + stop/start post-conditions. Falsified by dead-on-arrival, a stop that fails to halt, or a start that fails to resume.")
    (:eng "Regression: fresh worlds are live; stops halt; starts resume."
     :math "Honest-null — FSM claim on a discrete flag."
     :cs "Three assertions across the boot/stop/start cycle."))
  :row-5-emergence (
    (:base "world/running? predicate on the one world."
     :eng-composition "(begin (world/reset!)\n  (define (step-while-live n)\n    (let loop ((i 0))\n      (when (and (< i n) (world/running?)) (world/step) (loop (+ i 1)))))\n  (step-while-live 3)\n  (world/frame))"
     :math-composition (:honest-null "Compositions with running? are dispatch shapes (when-guard, and/or) — not algebra. The predicate combines only by boolean connectives.")
     :cs-composition "(begin (world/reset!)\n  (define (status) (list ':live (world/running?) ':frame (world/frame)))\n  (world/step)\n  (world/stop)\n  (status))"
     :emergent "A step-while-live driver + live/frame status probe: running? chains with world/step for guarded loops and with world/frame for status reports — the liveness-gated control family."
     :meta "Same family as any liveness-based loop guard; cross-ref book-of-composition on predicate-gated iteration.")
    (:eng "A manual game loop steps only while live; a status probe reports liveness with the frame."
     :math "Honest-null — when-guard and status assembly are dispatch on a flag, not algebra."
     :cs "Guarded loop + flag read + frame read."))
)

(verb
  :name "world/stop" :std "Motoi"
  :library "world"
  :kind "mut"
  :dialect "motoi"
  :signature "(world/stop) -> null"
  :arity "0"
  :contract "no args → halts the world loop; returns the unspecified value"
  :summary "Halt the world loop. The frame counter is preserved; world/start resumes."
  :doc "Sets the world's running flag to #f. world/frame, world/state, and all entities remain readable; only the loop is inert. Idempotent — stopping an already-stopped world is safe. world/start resumes from where it left off."
  :since "1.0"
  :explanation "world/stop halts the single Motoi world loop. After it, world/running? returns #f and per-frame handlers stop firing. Nothing is destroyed: the frame counter, entities, camera, and physics state all survive and stay readable — only stepping is inert. This is the clean way to end a game, pause before a scene change, or freeze the world to inspect it. Because the frame counter is preserved, world/start resumes the same timeline rather than restarting it. It takes no id — there is one world."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (world/reset!) (world/stop) (world/running?))" :note "Halt the world, then confirm it is no longer running. Returns #f.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (world/reset!) (world/step) (world/step) (world/stop) (world/frame))" :note "The frame counter survives the stop. Returns 2.")
    (:dialect "motoi" :tier "expert" :code "(begin (world/reset!)\n  (world/step)\n  (world/stop) (world/stop) (world/stop)\n  (list ':running (world/running?) ':frame (world/frame)))" :note "Stopping is idempotent and preserves the frame. Returns (:running #f :frame 1).")
  )
  :caveats ("world/stop preserves state — world/frame and world/state still return their pre-stop values; only stepping is inert." "It is idempotent: stopping an already-stopped world is safe and leaves the flag #f." "It does not reset; use world/reset! to rebuild a fresh world.")
  :drawbacks ("There is no pause distinct from stop; the only states are live and halted." "world/stop does not clear entities or physics; a stopped world still holds all its state in memory until world/reset!.")
  :usecases ("Implement game-over, level-complete, or timeout by halting the loop." "Freeze the world to inspect frame + entity state without further mutation." "Pause before a scene transition, then world/start to resume the same timeline.")
  :related ("world/start" "world/running?" "world/state" "world/frame" "world/reset!")
  :learn (:concept "Halting the loop: world/stop is the clean, reversible way to freeze the one world without destroying it." :prerequisites ("world/step" "world/running?") :progression "Learn world/start to resume, and world/reset! when you want a fresh world instead of a resumed one.")
  :row-2-audit (
    (:problem "A win condition fires; the loop should freeze cleanly without losing the frame count or entities. world/stop is the lifecycle primitive; world/reset! would annihilate the very state the game-over screen needs to show."
     :eng-program "(begin (world/reset!)\n  (world/step) (world/step)\n  (world/stop)\n  (list ':final-frame (world/frame) ':running (world/running?)))"
     :math-program (:honest-null "Halting is a flag write with a preservation guarantee — a state-machine transition, not an operation on numbers. No algebra.")
     :cs-program "(begin (world/reset!)\n  ;; Idempotent: stop; stop again; flag stays #f.\n  (world/stop) (world/stop)\n  (not (world/running?)))"
     :explanation "eng: stop then read the preserved final frame for a game-over screen. math: HONEST-NULL — halting is a flag transition. cs: idempotence witness."
     :meta "Reach for world/stop over world/reset! when you must keep the frame count and entities; reset! is for a fresh world, stop is for a frozen one.")
    (:eng "Freeze then read final frame + entities for a game-over summary."
     :math "Honest-null — halt is a flag write, not algebra."
     :cs "Single flag write; O(1); idempotent."))
  :row-3-dimension (
    (:setup "clean, reversible halt of a single running resource — same shape appears in the world loop, an audio transport, a pausable timer"
     :rungs ((:domain "world"     :code "(begin (world/reset!) (world/stop) (world/running?))")
             (:domain "transport" :code "(define (pause tp) (cons 'paused (cdr tp)))\n(pause '(playing 120))")
             (:domain "timer"     :code "(define (halt tm) (list 'stopped (cadr tm)))\n(halt '(running 42))"))
     :explanation "Rung 1 halts the world, preserving its frame. Rung 2 pauses a transport, preserving position. Rung 3 stops a timer, preserving elapsed. All three freeze a resource without discarding its progress."
     :meta "The shape transfers because 'halt-preserving-progress' is a universal lifecycle move.")
    (:eng "Transports, timers, and the world loop share the freeze-not-destroy discipline."
     :math "Honest-null — halt is a transition preserving the counter."
     :cs "Flag write; progress cell untouched."))
  :row-4-proof (
    (:claim "After world/stop, world/running? is #f and the frame counter is unchanged; stopping is idempotent (a second stop leaves the flag #f and the frame intact)."
     :eng-program "(begin (world/reset!)\n  (world/step) (world/step)\n  (let ((f (world/frame)))\n    (world/stop)\n    (and (not (world/running?)) (= (world/frame) f))))"
     :math-program (:honest-null "A frame-preservation post-condition on a flag transition — no ∀ over ℕ, just an equality of the counter across the write. See row 2 honest-null.")
     :cs-program "(begin (world/reset!)\n  (world/step)\n  (world/stop)\n  (let ((f (world/frame)))\n    (world/stop)\n    (and (not (world/running?)) (= (world/frame) f))))"
     :invariant "after stop: running? = #f ∧ frame unchanged ∧ stop∘stop = stop (flag stays #f, frame stays fixed)"
     :meta "Halt post-condition + frame preservation + idempotence. Falsified by a lingering live flag, a frame reset, or a second stop that disturbs state.")
    (:eng "Regression: stop halts, preserves the frame, and is safe to repeat."
     :math "Honest-null — halt/idempotence claim on a flag + preserved counter."
     :cs "Two assertions: halted + frame-preserved, across a double stop."))
  :row-5-emergence (
    (:base "world/stop halts the one world, preserving its state."
     :eng-composition "(begin (world/reset!)\n  (world/step) (world/step) (world/step)\n  (world/stop)\n  (list ':frame (world/frame) ':running (world/running?) ':entities (world/count)))"
     :math-composition (:honest-null "Compositions with stop are lifecycle sequencing (stop-then-read, stop-then-start) — control flow, not algebra.")
     :cs-composition "(begin (world/reset!)\n  (world/step)\n  (world/stop)\n  (let ((frozen (world/state)))\n    (world/start)\n    (list ':frozen frozen ':resumed (world/running?))))"
     :emergent "A freeze-frame snapshot + stop/start resume pair: stop chains with world/frame + world/count for post-mortem readout, and with world/start for pause-resume. Emergent: reversible lifecycle control."
     :meta "Same family as a pausable transport with a resume; cross-ref book-of-composition on freeze-frame diagnostics."
     :emergent-note "world/count with no tag returns the total live entity count.")
    (:eng "Game-over screens read the frozen frame + entity count; pause-menus stop then start."
     :math "Honest-null — freeze/resume is sequencing on a flag, not algebra."
     :cs "Stop + multi-field read; stop + snapshot + start."))
)

(verb
  :name "world/start" :std "Motoi"
  :library "world"
  :kind "mut"
  :dialect "motoi"
  :signature "(world/start) -> null"
  :arity "0"
  :contract "no args → resumes a stopped world loop; returns the unspecified value"
  :summary "Resume a stopped world loop. Idempotent when already running."
  :doc "Sets the world's running flag to #t, resuming the same timeline from its preserved frame counter. Idempotent — starting an already-running world is safe. Pairs with world/stop; it resumes rather than rebuilds. For a fresh world use world/reset!."
  :since "1.0"
  :explanation "world/start resumes the single Motoi world after world/stop. It sets the running flag to #t so world/step advances again and per-frame handlers fire. Because world/stop preserved the frame counter and all entities, world/start continues the SAME timeline — it does not restart from frame 0. Starting an already-running world is a safe no-op. This verb has no game/* ancestor: the multi-game surface only had a stop, so start is the new, symmetric complement in the single-world model. For a genuinely fresh world, use world/reset! instead."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (world/reset!) (world/stop) (world/start) (world/running?))" :note "Stop then start; the world is live again. Returns #t.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (world/reset!) (world/step) (world/step) (world/stop) (world/start) (world/frame))" :note "start resumes the SAME timeline; the frame counter is not reset. Returns 2.")
    (:dialect "motoi" :tier "expert" :code "(begin (world/reset!)\n  (world/start) (world/start)\n  (world/running?))" :note "Starting an already-running world is idempotent. Returns #t.")
  )
  :caveats ("world/start resumes the preserved timeline; it does NOT reset the frame counter — use world/reset! for a fresh world." "It is idempotent: starting an already-running world is a safe no-op." "It only flips the running flag; it does not re-register per-frame handlers you may have cleared.")
  :drawbacks ("There is no partial resume; start always makes the whole world live again." "start cannot recover a world/reset!'d timeline — reset! discards state that start cannot bring back.")
  :usecases ("Resume after a pause menu without losing progress." "Toggle a world live/halted with world/stop and world/start for step-debugging." "Re-arm the loop after a conditional world/stop when the halt turns out to be temporary.")
  :related ("world/stop" "world/running?" "world/state" "world/frame" "world/reset!")
  :learn (:concept "Resuming the loop: world/start is the reverse of world/stop, continuing the same preserved timeline." :prerequisites ("world/stop" "world/running?") :progression "Contrast with world/reset! (fresh world) and pair with world/state to confirm the resumed frame + entity context.")
  :row-2-audit (
    (:problem "A pause menu closes; the loop must resume the same run, not restart it. world/start resumes the preserved timeline; world/reset! would throw the run away and begin from frame 0."
     :eng-program "(begin (world/reset!)\n  (world/step) (world/step)\n  (world/stop)\n  (world/start)\n  (world/frame))"
     :math-program (:honest-null "Resuming is a flag write that continues a preserved counter — a state-machine transition, not an operation on numbers. No algebra.")
     :cs-program "(begin (world/reset!)\n  ;; Idempotent: start; start again; flag stays #t.\n  (world/start) (world/start)\n  (world/running?))"
     :explanation "eng: resume the same run after a pause. math: HONEST-NULL — resume is a flag transition. cs: idempotence witness."
     :meta "Reach for world/start over world/reset! when the halt was temporary; reset! restarts the timeline, start continues it.")
    (:eng "Resume the same run so progress and frame count carry through."
     :math "Honest-null — resume is a flag write, not algebra."
     :cs "Single flag write; O(1); idempotent."))
  :row-3-dimension (
    (:setup "resume a paused single resource on its preserved state — same shape appears in the world loop, an audio transport, a suspended coroutine"
     :rungs ((:domain "world"     :code "(begin (world/reset!) (world/stop) (world/start) (world/running?))")
             (:domain "transport" :code "(define (resume tp) (cons 'playing (cdr tp)))\n(resume '(paused 120))")
             (:domain "coroutine" :code "(define (wake co) (list 'running (cadr co)))\n(wake '(suspended 7))"))
     :explanation "Rung 1 resumes the world at its preserved frame. Rung 2 resumes a transport at its position. Rung 3 wakes a coroutine at its saved point. All three continue rather than restart."
     :meta "The shape transfers because 'resume-on-preserved-state' is a universal lifecycle move.")
    (:eng "Transports, coroutines, and the world loop share the resume-not-restart discipline."
     :math "Honest-null — resume is a transition continuing the counter."
     :cs "Flag write; saved state untouched."))
  :row-4-proof (
    (:claim "After world/stop then world/start, world/running? is #t and the frame counter is unchanged from the stop; starting is idempotent (a second start leaves the flag #t)."
     :eng-program "(begin (world/reset!)\n  (world/step) (world/step)\n  (world/stop)\n  (let ((f (world/frame)))\n    (world/start)\n    (and (world/running?) (= (world/frame) f))))"
     :math-program (:honest-null "A frame-preservation post-condition on a flag transition — no ∀ over ℕ, just equality of the counter across stop→start. See row 2 honest-null.")
     :cs-program "(begin (world/reset!)\n  (world/stop)\n  (world/start) (world/start)\n  (world/running?))"
     :invariant "after stop∘start: running? = #t ∧ frame unchanged ∧ start∘start = start (flag stays #t)"
     :meta "Resume post-condition + frame preservation + idempotence. Falsified by a start that fails to resume, a frame reset on resume, or a non-idempotent second start.")
    (:eng "Regression: start resumes, preserves the frame, and is safe to repeat."
     :math "Honest-null — resume/idempotence claim on a flag + preserved counter."
     :cs "Two assertions: resumed + frame-preserved, across a double start."))
  :row-5-emergence (
    (:base "world/start resumes the one world on its preserved timeline."
     :eng-composition "(begin (world/reset!)\n  (world/step)\n  (world/stop)\n  (world/start)\n  (world/step)\n  (world/frame))"
     :math-composition (:honest-null "Compositions with start are lifecycle sequencing (stop-then-start, toggle loops) — control flow, not algebra.")
     :cs-composition "(begin (world/reset!)\n  (define (toggle!) (if (world/running?) (world/stop) (world/start)))\n  (toggle!)\n  (let ((a (world/running?))) (toggle!) (list ':after-1 a ':after-2 (world/running?))))"
     :emergent "A stop/step/start resume chain + a live/halted toggle: start chains with world/step + world/stop to build pause-resume flows and single-verb toggles. Emergent: reversible run control."
     :meta "Same family as a play/pause toggle on a transport; cross-ref book-of-composition on reversible control.")
    (:eng "Pause-resume flows step, stop, start, step; a toggle flips the run state each call."
     :math "Honest-null — toggle/resume is sequencing on a flag, not algebra."
     :cs "Stop/start sequencing; a conditional toggle."))
)

(verb
  :name "world/state" :std "Motoi"
  :library "world"
  :kind "pure"
  :dialect "motoi"
  :signature "(world/state) -> alist"
  :arity "0"
  :contract "no args → a status alist ((:frame integer) (:running boolean) (:entities integer))"
  :summary "A small status alist: frame counter, running flag, entity count."
  :doc "Returns a fresh association list of the world's headline status: (:frame N) is the frame counter, (:running #t/#f) the loop flag, (:entities K) the live entity count. Pure read; does not advance time. There is one world, so no id argument and no 'nan case."
  :since "1.0"
  :explanation "world/state gives a one-call snapshot of the single world's headline status as an association list: ((:frame N) (:running bool) (:entities K)). It is the single-world successor to the multi-game game/state, which returned an opaque per-id state cell (or 'nan on unknown id). Here the shape is fixed and self-describing: read :frame with (assq ':frame (world/state)), and so on. It is a pure read — it does not advance the frame or mutate anything — so it is safe to call every frame for a HUD or a debug line."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(begin (world/reset!) (world/state))" :note "Fresh world. Returns ((:frame 0) (:running #t) (:entities 0)).")
    (:dialect "motoi" :tier "intermediate" :code "(begin (world/reset!) (world/step) (world/step) (world/state))" :note "After two steps. Returns ((:frame 2) (:running #t) (:entities 0)).")
    (:dialect "motoi" :tier "expert" :code "(begin (world/reset!)\n  (world/spawn 'enemy 10 10)\n  (world/stop)\n  (cadr (assq ':running (world/state))))" :note "Pull one field out of the alist with assq. After world/stop, :running is #f.")
  )
  :caveats ("world/state returns a fresh alist each call; mutating the returned list does not affect the world." "The keys are keyword symbols (:frame, :running, :entities); read fields with assq, not by position, in case the field set grows." "It is a pure read: no frame advance, no side effect; safe to call every frame.")
  :drawbacks ("world/state is a headline summary, not a full dump; it does not include camera, gravity, or per-entity detail — use world/snapshot for a complete capture." "Building the alist allocates a small list each call; cache it if you need the same snapshot several times in one frame.")
  :usecases ("Drive a debug HUD line: frame, running flag, and entity count in one read." "Assert on world status in tests without three separate calls." "Capture a lightweight status stamp alongside a log entry.")
  :related ("world/frame" "world/running?" "world/count" "world/snapshot" "world/stop")
  :learn (:concept "One-call status: world/state bundles the world's headline fields into a self-describing alist." :prerequisites ("world/frame" "world/running?" "world/count") :progression "Read individual fields with assq; graduate to world/snapshot for a full capture and world/restore! to reload one.")
  :row-2-audit (
    (:problem "A HUD needs frame, running flag, and entity count each frame without three round-trips; the operator wants one self-describing read. world/state bundles them; calling world/frame + world/running? + world/count separately is three reads and a manual assembly."
     :eng-program "(begin (world/reset!)\n  (world/step)\n  (define s (world/state))\n  (list ':frame (cadr (assq ':frame s))\n        ':entities (cadr (assq ':entities s))))"
     :math-program (:honest-null "Bundling status fields into an alist is record construction — a projection of heterogeneous cells, not an algebraic operation on numbers.")
     :cs-program "(begin (world/reset!)\n  ;; Pure read: two consecutive snapshots (no step between) are equal.\n  (equal? (world/state) (world/state)))"
     :explanation "eng: one read, assq the fields for a HUD. math: HONEST-NULL — record projection, not algebra. cs: read-idempotence witness."
     :meta "Reach for world/state over three separate reads when you want an atomic, self-describing status; assq keeps callers robust if the field set grows.")
    (:eng "One read feeds a HUD; assq by key survives added fields."
     :math "Honest-null — alist assembly is record projection, not algebra."
     :cs "Fixed-shape alist build; O(1); pure within a frame."))
  :row-3-dimension (
    (:setup "one-call status record of a single resource — same shape appears in the world loop, a process /proc read, an HTTP health endpoint"
     :rungs ((:domain "world"   :code "(begin (world/reset!) (world/state))")
             (:domain "process" :code "(define (proc-status pid) (list (list 'pid pid) (list 'state 'running)))\n(proc-status 42)")
             (:domain "health"  :code "(define (health) (list (list 'status 'ok) (list 'uptime 3)))\n(health)"))
     :explanation "Rung 1 returns the world's status alist. Rung 2 returns a process status record. Rung 3 returns a health payload. All three project a resource's headline state into one self-describing structure."
     :meta "The shape transfers because 'status record in one read' is universal in observability.")
    (:eng "Process tables, health checks, and the world loop all expose a one-call status record."
     :math "Honest-null — status projection, not algebra."
     :cs "Assemble fixed fields into a record."))
  :row-4-proof (
    (:claim "world/state reflects the live world: :frame equals world/frame, :running equals world/running?, :entities equals world/count; two reads with no step between are equal."
     :eng-program "(begin (world/reset!)\n  (world/step) (world/step)\n  (let ((s (world/state)))\n    (and (= (cadr (assq ':frame s)) (world/frame))\n         (eq? (cadr (assq ':running s)) (world/running?))\n         (= (cadr (assq ':entities s)) (world/count)))))"
     :math-program (:honest-null "Field-agreement is a projection identity (state.f = f for each field) — a record equation, not a ∀ over a numeric domain.")
     :cs-program "(begin (world/reset!)\n  (world/spawn 'x 0 0)\n  (equal? (world/state) (world/state)))"
     :invariant "state.:frame = frame ∧ state.:running = running? ∧ state.:entities = count ∧ (no step between) state = state"
     :meta "Field agreement + read idempotence. Falsified by any field disagreeing with its dedicated verb or by two unstepped reads differing.")
    (:eng "Regression: each field matches its dedicated verb; repeated reads agree."
     :math "Honest-null — projection identities per field; idempotent read."
     :cs "Three field-equality assertions + one idempotence assertion."))
  :row-5-emergence (
    (:base "world/state reads the world's headline status as an alist."
     :eng-composition "(begin (world/reset!)\n  (define (hud) (let ((s (world/state)))\n    (list 'F (cadr (assq ':frame s)) 'E (cadr (assq ':entities s)))))\n  (world/spawn 'a 0 0) (world/step)\n  (hud))"
     :math-composition (:honest-null "Compositions with state are record reads + field selection (assq) — projection and dispatch, not algebra.")
     :cs-composition "(begin (world/reset!)\n  (define (running? s) (cadr (assq ':running s)))\n  (world/stop)\n  (let ((halted (not (running? (world/state)))))\n    (world/start)\n    (list ':was-halted halted ':now (running? (world/state)))))"
     :emergent "A HUD projector + a stop/start status witness: state chains with assq for field selection and with world/stop/start for lifecycle readouts. Emergent: one-read observability across the loop lifecycle."
     :meta "Same family as a /proc or health-endpoint reader; cross-ref book-of-composition on status projection."
     :emergent-note "world/count with no tag returns the total live entity count, matching state's :entities field.")
    (:eng "A HUD selects fields for display; a lifecycle witness reads :running before and after start."
     :math "Honest-null — projection + selection, not algebra."
     :cs "assq field selection; status read across stop/start."))
)

