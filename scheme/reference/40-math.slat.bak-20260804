     :composition "(list (numerator 3/4) (denominator 3/4))"
     :eng-composition "(define (align-decimals qs) (let ((max-d (apply max (map denominator qs)))) (map (lambda (q) (/ (* (numerator q) max-d) (denominator q) max-d)) qs)))\n(align-decimals (list 1/2 1/3 1/4))"
     :math-composition "(define (harmonic-sum n) (let loop ((i 1) (acc 0)) (if (> i n) acc (loop (+ i 1) (+ acc (/ 1 i))))))\n(let ((h (harmonic-sum 5))) (list 'num (numerator h) 'den (denominator h)))"
     :cs-composition "(define (bounded-den? q cap) (<= (denominator q) cap))\n(bounded-den? 22/7 100)"
     :emergent "component-split. Eng: align rationals to common denominator. Math: harmonic-sum denominator inspection. CS: denominator-cap admission control."
     :meta "Belongs to the family of accessor patterns. See book-of-composition ch 3.")
