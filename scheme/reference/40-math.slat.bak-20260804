(verb :name "numerator" :std "R7RS-small"       :library "math" :tier "core" :kind "pure" :signature "(numerator x) -> integer"
  :summary "Numerator of a rational (JS integers: x). R7RS §6.2.6."
  :provenance "R7RS §6.2.6; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(numerator 3/4)" :note "3.")
    (:dialect "motoi" :tier "intermediate" :code "(numerator 6)" :note "6 — integers are k/1.")
    (:dialect "motoi" :tier "expert" :code "(define (scale-num q k) (/ (* (numerator q) k) (denominator q)))\n(scale-num 3/4 8)" :note "Scale a rational by k using its numerator directly. Returns 6.")
  )
  :row-2-audit (
    (:problem "A fraction display extracts the top of 3/4 for rendering." :program "(numerator 3/4)"
     :eng-program "(define (show-fraction q) (list (numerator q) '/ (denominator q)))\n(show-fraction 22/7)"
     :math-program "(define (reconstruct? q) (= q (/ (numerator q) (denominator q))))\n(and (reconstruct? 3/4) (reconstruct? 6) (reconstruct? -5/8))"
     :cs-program "(define (safe-numerator x) (if (rational? x) (numerator x) (error 'not-rational)))\n(safe-numerator 3/4)"
     :explanation "Returns 3. Eng: render the top of a fraction. Math: numerator/denominator reconstruct the original rational. CS: type-guarded read."
     :meta "numerator is the correct verb (R7RS). Manual (car ...) doesn't work — rationals are not lists.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: field access."
     :rungs (
       (:domain "math/*" :code "(numerator 3/4)")
       (:domain "mailing address (a metaphor domain — read the street number field)" :code "(define (street-num addr) (list 'street-of addr))")
       (:domain "math — first coordinate of a rational encoded as (n, d)" :code "(define (first-coord p) (list p))")
     )
     :explanation "Each rung extracts a named field from a compound."
     :meta "The shape transfers because field-access is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "For integer n, numerator(n) = n." :program "(= (numerator 6) 6)"
     :eng-program "(define (integers-fixed?) (and (= (numerator 6) 6) (= (numerator -3) -3) (= (numerator 0) 0)))\n(integers-fixed?)"
     :math-program "(define (canonical-sign? q) (or (>= (numerator q) 0) (< q 0)))\n(and (canonical-sign? 3/4) (canonical-sign? -3/4))"
     :cs-program "(define (numerator-idempotent-on-int? n) (= (numerator (numerator n)) (numerator n)))\n(and (numerator-idempotent-on-int? 6) (numerator-idempotent-on-int? -2))"
     :invariant "∀ n ∈ ℤ. numerator(n) = n" :meta "Integer case: integers are k/1 so the numerator is the integer itself. Sign lives in the numerator. See book-of-math ch 6 (rationals).")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
   
    (:base "Chain numerator with denominator to reassemble." :composition "(list (numerator 3/4) (denominator 3/4))"
     :eng-composition "(define (as-mixed q) (let ((n (numerator q)) (d (denominator q))) (list (quotient n d) (/ (remainder n d) d))))\n(as-mixed 7/3)"
     :math-composition "(define (sum-numerators qs) (apply + (map numerator qs)))\n(sum-numerators (list 1/5 2/5 3/5))"
     :cs-composition "(define (reduced? q) (= 1 (gcd (abs (numerator q)) (denominator q))))\n(list (reduced? 3/4) (reduced? 6/8))"
     :emergent "component-split. Eng: split an improper fraction into whole + fractional parts. Math: sum of numerators over a common-denominator list. CS: reduced-form check via gcd of numerator and denominator." :meta "Belongs to the family of accessor patterns. See book-of-composition ch 3.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "denominator" :std "R7RS-small"     :library "math" :tier "core" :kind "pure" :signature "(denominator x) -> integer"
  :summary "Denominator of a rational (JS: always 1). R7RS §6.2.6."
  :provenance "R7RS §6.2.6; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(denominator 3/4)" :note "4.")
    (:dialect "motoi" :tier "intermediate" :code "(denominator 6)" :note "1.")
    (:dialect "motoi" :tier "expert" :code "(define (lcd . qs) (let loop ((qs qs) (acc 1)) (if (null? qs) acc (loop (cdr qs) (/ (* acc (denominator (car qs))) (gcd acc (denominator (car qs))))))))\n(lcd 1/2 1/3 1/6)" :note "Least common denominator across a list of rationals.")
  )
