(define t2 (+ (* 20 40) (* 20 5) (* 3 40) (* 3 5)))
(= t1 t2)" :invariant "∀ (a1a0), (b1b0) two-digit. product = a1·b1·100 + a1·b0·10 + a0·b1·10 + a0·b0" :meta "Distributivity of multiplication over addition. If broken, the model would show an inconsistent product. See book-of-math ch 3 (place value and distribution)."
     :eng-program "(= (* 23 45) 1035)"
     :math-program "(define (distributive? a b)\n  (let ((tens-a (quotient a 10)) (ones-a (modulo a 10))\n        (tens-b (quotient b 10)) (ones-b (modulo b 10)))\n    (= (* a b)\n       (+ (* tens-a 10 tens-b 10)\n          (* tens-a 10 ones-b)\n          (* ones-a tens-b 10)\n          (* ones-a ones-b)))))\n(distributive? 23 45)"
     :cs-program "(define (check-area-model a b)\n  (= (* a b)\n     (+ (* (- a (modulo a 10)) (- b (modulo b 10)))\n        (* (- a (modulo a 10)) (modulo b 10))\n        (* (modulo a 10) (- b (modulo b 10)))\n        (* (modulo a 10) (modulo b 10)))))\n(check-area-model 37 82)")
