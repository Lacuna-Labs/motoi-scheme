(verb
  :name "math/e" :std "Motoi"
  :library "math"
  :kind "value"
  :dialect "motoi"
  :signature "math/e -> number"
  :arity "0 (constant)"
  :contract "Math.E (approximately 2.718281828459045)"
  :summary "Euler's number e — the base of the natural logarithm."
  :doc "A bound value, not a procedure. Use in exponential decay / growth expressions and as the base of (math/log ...) which defaults to natural log."
  :since "1.0"
  :examples (
