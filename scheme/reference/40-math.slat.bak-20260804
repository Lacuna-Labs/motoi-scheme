(verb
  :name "math/clamp" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/clamp x lo hi) -> number"
  :arity "3"
  :contract "x, lo, hi real with lo <= hi → number in [lo,hi]"
  :summary "Clip x into the closed interval [lo, hi]."
  :doc "Returns lo if x < lo, hi if x > hi, else x. If lo > hi the behavior is Math.min(hi, Math.max(lo, x)) which returns hi."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/clamp 15 0 10)" :note "15 exceeds the upper bound, clamped to 10.")
    (:dialect "motoi" :tier "intermediate" :code "(math/clamp -3 0 100)" :note "-3 below the lower bound, clamped to 0.")
    (:dialect "motoi" :tier "expert" :code "(define (health-percent hp) (math/clamp (/ hp 100.0) 0 1))\n(health-percent 137)" :note "Normalize a health value into [0,1] for a UI bar. Returns 1.")
  )
  :related ("math/lerp" "math/min" "math/max")
  :row-2-audit (
    (:problem "A slider input must stay within [0, 100] regardless of user drag." :program "(math/clamp 137 0 100)" :explanation "Clip to the range → 100." :meta "math/clamp is the correct verb. Manual (max lo (min hi x)) works but the named verb is auditable."
     :eng-program "(define (safe-volume v) (math/clamp v 0 11))
(safe-volume 15)"
     :math-program "(define (to-unit x) (math/clamp x 0 1))
(to-unit 1.4)")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: value clipping."
     :rungs (
       (:domain "math/*" :code "(math/clamp 15 0 10)")
       (:domain "volume knob (a metaphor domain — volume can't go past 11)" :code "(math/clamp 137 0 100)")
       (:domain "math — projection onto a convex interval" :code "(= (math/clamp (math/clamp 15 0 10) 0 10) (math/clamp 15 0 10))")
     )
     :explanation "Each rung projects a value into a bounded interval."
     :meta "The shape transfers because 'stay in range' is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "clamp is idempotent." :program "(= (math/clamp (math/clamp 15 0 10) 0 10) (math/clamp 15 0 10))" :invariant "∀ x lo hi. clamp(clamp(x,lo,hi),lo,hi) = clamp(x,lo,hi)" :meta "Projection idempotence. If broken, repeated application would drift. See book-of-math ch 10."
     :math-program "(= (math/clamp 5 0 10) 5)"
     :cs-program "(= (math/clamp -3 0 100) 0)")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain clamp with a lerp for a smooth-bounded interpolator." :composition "(define (safe-lerp a b t) (math/lerp a b (math/clamp t 0 1)))
