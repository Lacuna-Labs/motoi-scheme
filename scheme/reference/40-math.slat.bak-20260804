(verb
  :name "math/pct" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/pct n d) -> number"
  :summary "Compute n as a percentage of d; return 'nan if d is zero."
  :explanation "Percentage is a ratio scaled to 100. This verb divides n by d and multiplies by 100, giving you the fractional part of d that n represents. It is useful in tutorials, dashboards, and any context where you need to express one quantity as a share of a whole. When the denominator is zero, the result is the symbolic atom 'nan to signal undefined behavior without throwing."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/pct 25 100)" :note "Returns 25.0 — a quarter of a whole.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((score 87) (max-score 100))\n  (display (math/pct score max-score)))" :note "Bind variables from user input or state, then compute the percentage inline.")
    (:dialect "motoi" :tier "expert" :code "(define (grade-to-pct raw-marks total-marks)\n  (let ((pct (math/pct raw-marks total-marks)))\n    (cond ((equal? pct 'nan) 'error-div-by-zero)\n          ((>= pct 90) 'A)\n          ((>= pct 80) 'B)\n          (else 'C))))\n(grade-to-pct 78 100)" :note "Wrap math/pct in a decision tree; check for 'nan before branching on numeric ranges.")
  )
  :caveats ("Returns the symbolic atom 'nan (not a number), not a floating-point NaN; use equal? to test for it." "Division by zero returns 'nan silently; the verb does not escalate or throw." "Result is exact only for ratios that are exact; floating-point inputs yield floating-point results.")
  :drawbacks ("If you need percentages rounded to a fixed decimal place, compose with math/round afterward." "Does not validate that d is positive; negative denominators yield negative percentages.")
  :usecases ("Progress bars and completion meters (items-done / items-total)." "Grade-to-letter conversion and rubric thresholds." "Resource utilization (memory-used / memory-total)." "Survey or poll result aggregation (responses-for-choice / total-responses).")
  :related ("math/round" "math/avg" "math/sum")
  :learn (:concept "Percentages as scaled ratios; handling undefined division." :prerequisites ("(core)/divide" "(core)/number?") :progression "Once comfortable with math/pct, move to math/round to format percentages for display, then to math/avg and math/sum for aggregating multiple percentages.")
  :row-2-audit (
    (:problem "A scoring dashboard needs to display raw/max as a percentage." :program "(define (as-pct raw max) (math/pct raw max))
(as-pct 87 100)"
     :eng-program "(define (progress done total) (math/pct done total))\n(map (lambda (p) (list (car p) '% (math/pct (car p) (cadr p)))) '((3 4) (5 8) (10 10)))"
     :math-program "(math/pct 1 4)"
     :cs-program "(define (safe-pct n d)\n  (let ((p (math/pct n d)))\n    (if (equal? p 'nan) 0 p)))\n(list (safe-pct 25 100) (safe-pct 5 0))"
     :explanation "Apply n/d × 100 with 'nan protection for d=0. Eng: batch progress meters. Math: 1/4 = 25%. CS: default to 0 when the denominator is zero." :meta "math/pct is the correct verb because it handles div-by-zero and returns 'nan symbolically. Doing (* 100 (/ n d)) crashes on d=0.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: normalized-ratio."
     :rungs (
       (:domain "math/*" :code "(math/pct 25 100)")
       (:domain "battery level (a metaphor domain — current charge as % of full)" :code "(define (charge cur cap) (list cur cap))")
       (:domain "math — ratio scaled to [0, 100]" :code "(define (ratio-100 n d) (list n d))")
     )
     :explanation "Each rung normalizes two values into a percentage."
     :meta "The shape transfers because 'ratio to whole' is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "pct(n, d) = 100 · (n/d) when d ≠ 0." :program "(< (abs (- (math/pct 25 100) 25)) 1e-9)"
     :eng-program "(< (abs (- (math/pct 25 100) 25)) 1e-9)"
     :math-program "(define (whole-is-100? d) (= (math/pct d d) 100))\n(and (whole-is-100? 40) (whole-is-100? 7) (whole-is-100? 100))"
     :cs-program "(define (pct-scales? n d k)\n  (< (abs (- (math/pct n d) (math/pct (* k n) (* k d)))) 1e-9))\n(pct-scales? 3 8 5)"
     :invariant "∀ n ∈ ℝ, d ≠ 0. pct(n, d) = 100·n/d" :meta "Closed-form pct identity. If broken, the coefficient 100 is missing. See book-of-math ch 6.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain pct with a threshold check." :composition "(define (pass? raw max threshold-pct)
  (let ((p (math/pct raw max)))
    (and (not (equal? p 'nan)) (>= p threshold-pct))))
(pass? 87 100 80)"
     :eng-composition "(define (grade raw max)\n  (let ((p (math/pct raw max)))\n    (cond ((equal? p 'nan) 'error)\n          ((>= p 90) 'A) ((>= p 80) 'B) ((>= p 70) 'C) (else 'F))))\n(map (lambda (r) (grade r 100)) '(95 82 71 50))"
     :math-composition "(define (share-table parts total)\n  (map (lambda (p) (list p (math/pct p total))) parts))\n(share-table '(2 3 5) 10)"
     :cs-composition "(define (bar-length p width)\n  (round (* width (/ (math/pct p 100) 100))))\n(map (lambda (p) (list p 'bar (bar-length p 20))) '(25 50 100))"
     :emergent "pct-plus-threshold: percentage gates a boolean." :meta "Belongs to the family of ratio-gated decisions. See book-of-composition ch 12.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb
  :name "math/place-value" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/place-value n) -> a-list | 'nan"
  :summary "Decompose an integer into a list of (digit place) pairs; non-integers return 'nan."
  :explanation "Place-value decomposition breaks a whole number into its constituent digits and their place magnitudes (ones, tens, hundreds, etc.). The output is an association list where each pair is (digit place-exponent), e.g., 307 becomes ((3 2) (0 1) (7 0)). This is a curriculum verb designed to teach the structure of positional notation and to help with number sense. Non-integers and invalid inputs return 'nan."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/place-value 305)" :note "Returns ((3 2) (0 1) (5 0)), showing 3 hundreds, 0 tens, 5 ones.")
    (:dialect "motoi" :tier "intermediate" :code "(define (fold-left f init xs)\n  (let loop ((xs xs) (acc init))\n    (if (null? xs) acc (loop (cdr xs) (f acc (car xs))))))\n(define (sum-of-place-values n)\n  (fold-left (lambda (acc pair) (+ acc (* (car pair) (expt 10 (cadr pair)))))\n            0\n            (math/place-value n)))\n(sum-of-place-values 142)" :note "Reconstruct the number by folding over the a-list; validates that decomposition is reversible.")
    (:dialect "motoi" :tier "expert" :code "(define (digit-at-place n place-exp)\n  (let ((decomp (math/place-value n)))\n    (cond ((equal? decomp 'nan) 'nan)\n          (else (let ((pair (assoc place-exp decomp)))\n                  (if pair (car pair) 0))))))\n(digit-at-place 4028 1)" :note "Look up a specific place in the decomposition using assoc; returns 0 if the place is absent (e.g., tens digit of 4028 is 2, not 0).")
  )
  :caveats ("Only accepts integers; 3.14 or any fractional input returns 'nan." "Includes leading zeros; 305 includes (0 1) for the absent tens place." "The a-list does not sort; order depends on digit traversal." "Negative integers: behavior is *[verify]* — confirm whether negation is dropped or preserved.")
  :drawbacks ("For teaching only; use math/pct or arithmetic for actual numeric work." "Inefficient for very large numbers (though Motoi integers are usually bounded)." "Does not handle scientific notation or other bases (binary, hexadecimal).")
  :usecases ("Elementary-school place-value lessons and base-10 understanding." "Building intuition for regrouping and carrying in addition/subtraction." "Digit-sum and digit-product problems (sum-of-digits, multiplication of place digits)." "Visualizing number structure in educational interfaces.")
  :related ("math/round-to-place" "math/mixed-number" "exact/float->rat")
  :learn (:concept "Positional notation and place-value decomposition." :prerequisites ("(core)/number?" "(core)/list" "(core)/assoc") :progression "After understanding place-value, learn math/round-to-place to see how place values guide rounding decisions, then move to exact/float->rat for rational representation.")
  :row-2-audit (
    (:problem "A pedagogy tool needs to show the ones, tens, and hundreds of 305." :program "(define (decompose n) (math/place-value n))
(decompose 305)"
     :eng-program "(define (decompose n) (math/place-value n))\n(map decompose '(7 42 305))"
     :math-program "(math/place-value 142)"
     :cs-program "(define (digit-count n)\n  (let ((pv (math/place-value n)))\n    (if (equal? pv 'nan) 'nan (length pv))))\n(list (digit-count 5) (digit-count 305) (digit-count 40028))"
     :explanation "Return the association list ((3 2) (0 1) (5 0)). Eng: decompose several numbers. Math: 142 = 1 hundred 4 tens 2 ones. CS: number of digits is the length of the decomposition." :meta "math/place-value is the correct verb because it emits the digit-place pair list. digit-at gives one digit at a time — this gives them all with places.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: full positional decomposition."
     :rungs (
       (:domain "math/*" :code "(math/place-value 305)")
       (:domain "time (a metaphor domain — 3h 5m 20s from 11120 seconds)" :code "(define (hms secs) (list secs))")
       (:domain "math — decomposition into basis vectors" :code "(define (in-basis n b) (list n b))")
     )
     :explanation "Each rung breaks a compound value into positional pieces."
     :meta "The shape transfers because 'decompose into positional basis' is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
   
    (:claim "Summing digit×10^place returns the original." :program "(define pv (math/place-value 305))\n(define total (fold (lambda (pair acc) (+ acc (* (car pair) (expt 10 (cadr pair))))) 0 pv))\n(= 305 total)"
     :eng-program "(define (rebuild n)\n  (fold (lambda (p acc) (+ acc (* (car p) (expt 10 (cadr p))))) 0 (math/place-value n)))\n(= (rebuild 4028) 4028)"
     :math-program "(define (digit-sum n)\n  (fold (lambda (p acc) (+ acc (car p))) 0 (math/place-value n)))\n(= (digit-sum 305) 8)"
     :cs-program "(define (rebuild n)\n  (fold (lambda (p acc) (+ acc (* (car p) (expt 10 (cadr p))))) 0 (math/place-value n)))\n(and (= (rebuild 7) 7) (= (rebuild 40028) 40028))"
     :invariant "∀ n ∈ ℕ. Σ pair-value(pv) = n where pv = place-value(n)" :meta "Reconstruction identity. If broken, decomposition is lossy. See book-of-math ch 3.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain place-value with a filter to find nonzero digits." :composition "(define (nonzero-places n)
  (filter (lambda (p) (not (zero? (car p)))) (math/place-value n)))
(nonzero-places 4028)"
     :eng-composition "(define (biggest-place n)\n  (let ((pv (math/place-value n)))\n    (if (equal? pv 'nan) 'nan (cadr (car pv)))))\n(map biggest-place '(7 42 305 40028))"
     :math-composition "(define (expanded-form n)\n  (map (lambda (p) (* (car p) (expt 10 (cadr p))))\n       (filter (lambda (p) (not (zero? (car p)))) (math/place-value n))))\n(expanded-form 4028)"
     :cs-composition "(define (nonzero-digit-count n)\n  (length (filter (lambda (p) (not (zero? (car p)))) (math/place-value n))))\n(map nonzero-digit-count '(1000 1234 40028))"
     :emergent "decompose-and-filter." :meta "Belongs to the family of positional-decomposition patterns. See book-of-composition ch 7.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb
  :name "math/pow" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/pow b e) -> number"
  :summary "Computes b raised to the power e (b^e)."
  :explanation "Exponentiation is repeated multiplication: b^e means b multiplied by itself e times (when e is a positive integer). More generally, it extends to negative exponents (b^(−e) = 1/b^e), fractional exponents (b^(1/n) = nth root of b), and real exponents (via logarithms). For example, 2^3 = 8 and 4^0.5 = 2. Returns inexact floating-point values. The base b should be positive for arbitrary real exponents."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/pow 2 3)" :note "Returns 8; 2³ = 2×2×2. Basic exponentiation.")
    (:dialect "motoi" :tier "intermediate" :code "(define (compound-interest principal rate years)\n  (* principal (math/pow (+ 1 rate) years)))\n(compound-interest 1000 0.05 10)" :note "Finance: A = P(1 + r)^t grows exponentially at rate r over t years.")
    (:dialect "motoi" :tier "expert" :code "(define (fold-left f init xs)\n  (let loop ((xs xs) (acc init))\n    (if (null? xs) acc (loop (cdr xs) (f acc (car xs))))))\n(define (power-series x n-terms)\n  (fold-left (lambda (sum k)\n              (+ sum (/ (math/pow x k) (comb/factorial k))))\n            0\n            (list-copy (map (lambda (i) i) (list 0)))))\n(power-series 1 5)" :note "Building a power series (here sketched; e^x ≈ Σ x^k/k!). Shows composition with factorial.")
  )
  :caveats ("For negative base b and non-integer exponent e, result may be complex (not returned)." "Zero to a negative power (0^(−e)) is undefined; may escalate." "Exponent 0: b^0 = 1 for any nonzero b." "Results are inexact floating-point; precision degrades for very large or very small exponents." "1^e always returns 1 for any exponent e.")
  :drawbacks ("Floating-point precision limits; not suitable for exact symbolic work (use sym/pow)." "Cannot represent negative bases with fractional exponents." "Very large exponents can overflow to infinity; very small (negative large) exponents underflow to zero.")
  :usecases ("Modeling exponential growth (population, finance) and decay (half-life, radioactivity)." "Computing roots as fractional exponents (e.g., cube root as ^(1/3))." "Power series and polynomial evaluation." "Physics and engineering: velocity, acceleration, energy formulas.")
  :related ("math/log" "math/log-base" "math/log10" "math/log2" "math/exp" "const/e")
  :learn (:concept "Exponentiation as repeated multiplication, generalized to real exponents via logarithms." :prerequisites ("math/log") :progression "Master math/pow, then explore its inverse math/log-base, then apply both to growth/decay problems and financial modeling.")
  :row-2-audit (
    (:problem "A financial model computes compound interest: A = P(1+r)^t." :program "(define (compound p r t) (* p (math/pow (+ 1 r) t)))
(compound 1000 0.05 10)"
     :eng-program "(define (compound p r t) (* p (math/pow (+ 1 r) t)))\n(map (lambda (yr) (list yr (compound 1000 0.05 yr))) '(1 5 10))"
     :math-program "(math/pow 2 3)"
     :cs-program "(define (cube-root x) (math/pow x (/ 1 3)))\n(list 'cbrt-27 (cube-root 27) 'cbrt-8 (cube-root 8))"
     :explanation "Apply (1+r)^t and scale by principal. Eng: balance at several years. Math: 2^3 = 8. CS: fractional exponent gives roots (cube root as ^(1/3))." :meta "math/pow is the correct verb because the exponent can be any real. math/exp with log workaround is possible but less direct.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: real exponentiation."
     :rungs (
       (:domain "math/*" :code "(math/pow 2 3)")
       (:domain "population (a metaphor domain — n doublings from an initial size)" :code "(define (pop-n n0 doublings) (list n0 doublings))")
       (:domain "math — b^e for b>0" :code "(define (power b e) (list b e))")
     )
     :explanation "Each rung raises a base to a real power."
     :meta "The shape transfers because b^e is fundamental to any scale-invariant process.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "b^(a+c) = b^a · b^c." :program "(< (abs (- (math/pow 2 5) (* (math/pow 2 2) (math/pow 2 3)))) 1e-9)"
     :eng-program "(< (abs (- (math/pow 2 5) (* (math/pow 2 2) (math/pow 2 3)))) 1e-9)"
     :math-program "(define (zero-exp-is-one? b) (< (abs (- (math/pow b 0) 1)) 1e-9))\n(and (zero-exp-is-one? 2) (zero-exp-is-one? 7) (zero-exp-is-one? 0.5))"
     :cs-program "(define (pow-log-inverse? b x)\n  (< (abs (- (math/log-base b (math/pow b x)) x)) 1e-9))\n(pow-log-inverse? 2 5)"
     :invariant "∀ b > 0, a c ∈ ℝ. b^(a+c) = b^a · b^c" :meta "Exponent-addition law. If broken, the impl is not exponentiation. See book-of-math ch 9.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain pow with a rate for a growth timeline." :composition "(define (grow-over n0 rate t) (* n0 (math/pow (+ 1 rate) t)))
(grow-over 100 0.1 5)"
     :eng-composition "(define (double-every n0 doublings) (* n0 (math/pow 2 doublings)))\n(map (lambda (d) (list d (double-every 1 d))) '(0 1 2 3 10))"
     :math-composition "(define (powers-of b ns)\n  (map (lambda (n) (list n (math/pow b n))) ns))\n(powers-of 3 '(0 1 2 3 4))"
     :cs-composition "(define (bytes-for bits) (math/pow 2 bits))\n(map (lambda (b) (list 'bits b 'values (bytes-for b))) '(1 4 8 16))"
     :emergent "growth-model: pow drives compound growth." :meta "Belongs to the family of exponential-growth models. See book-of-composition ch 11.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb
  :name "math/ratio-bar" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/ratio-bar a b) -> spec"
  :summary "Produces a specification for rendering a ratio bar visualizing the ratio a:b."
  :explanation "A ratio bar is a teaching model that visually represents the relationship between two quantities in a ratio a:b. The bar is divided into a units and b units (or segments proportional to a and b), helping students understand ratios as relationships between amounts. For example, a ratio 2:3 would show a bar divided into 5 equal parts, with 2 shaded on the left and 3 shaded (or unshaded) on the right. The verb returns a spec object suitable for rendering or visualization systems."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/ratio-bar 2 3)" :note "A ratio 2:3; spec describes a bar divided into 2 + 3 = 5 units.")
    (:dialect "motoi" :tier "intermediate" :code "(define (scale-ratio a b scale-factor)\n  (math/ratio-bar (* a scale-factor) (* b scale-factor)))\n(scale-ratio 1 4 5)" :note "Equivalent ratio: 1:4 scaled by 5 becomes 5:20. Demonstrates ratio equivalence.")
    (:dialect "motoi" :tier "expert" :code "(define (ratio-problem girls boys)\n  (let ((spec (math/ratio-bar girls boys)))\n    (list 'ratio-spec spec\n          'total (+ girls boys)\n          'girl-fraction (/ girls (+ girls boys)))))\n(ratio-problem 8 12)" :note "Word-problem context: ratio bar used to find total and fractions.")
  )
  :caveats ("a and b should both be non-negative; negative values produce undefined behavior." "If a or b is zero, the ratio is degenerate; visualizations may not render sensibly." "This returns a spec, not a rendered image; a separate verb must visualize." "Large values of a and b may be visually difficult to represent as discrete units.")
  :drawbacks ("Spec-only: requires a visualization pipeline to display the actual bar." "Not suitable for exact symbolic ratio manipulation (use for pedagogy/visualization)." "If a and b are very large, rendering may be slow or cluttered.")
  :usecases ("Teaching students to understand ratios and proportions visually." "Building interactive ratio and proportion problem solvers." "Illustrating equivalent ratios and scaling." "Creating visual aids for word problems involving mixtures, recipes, and rates.")
  :related ("math/fraction-bar" "math/number-line" "math/compare" "math/count-on" "math/area-model")
  :learn (:concept "Ratio bar: visual model showing the multiplicative relationship a:b between two quantities." :prerequisites ("math/fraction-bar") :progression "After math/ratio-bar, explore math/fraction-bar for parts of a whole, then solve/proportion for ratio equations.")
  :row-2-audit (
    (:problem "A recipe-scaling lesson shows a 2:3 water-to-flour ratio." :program "(define spec (math/ratio-bar 2 3))
spec"
     :eng-program "(define (recipe-bar water flour) (math/ratio-bar water flour))\n(recipe-bar 2 3)"
     :math-program "(math/ratio-bar 1 1)"
     :cs-program "(define (scaled-bar a b k) (math/ratio-bar (* a k) (* b k)))\n(list (scaled-bar 1 4 1) (scaled-bar 1 4 5))"
     :explanation "Emit the spec that renders as a bar in the 2:3 proportion. Eng: water-to-flour. Math: 1:1 is an even split. CS: scale both terms to show an equivalent ratio." :meta "math/ratio-bar is the correct verb because it names the ratio pedagogy. fraction-bar shows part-of-whole; ratio-bar shows part-to-part.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: part-to-part proportion."
     :rungs (
       (:domain "math/*" :code "(math/ratio-bar 2 3)")
       (:domain "mixing paint (a metaphor domain — 2 parts blue to 3 parts white)" :code "(define (mix a b) (list a b))")
       (:domain "math — ratio a:b as an equivalence class of pairs (na, nb)" :code "(define (proportion a b) (list a b))")
     )
     :explanation "Each rung represents a fixed ratio of two quantities."
     :meta "The shape transfers because part-to-part ratios are universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "Scaling both terms of a ratio by k preserves the ratio." :program "(define r1 (math/ratio-bar 2 3))
(define r2 (math/ratio-bar 4 6))
(> (length (list r1 r2)) 1)"
     :eng-program "(define r1 (math/ratio-bar 2 3))\n(define r2 (math/ratio-bar 4 6))\n(= (length (list r1 r2)) 2)"
     :math-program "(define (ratio-total a b) (+ a b))\n(and (= (ratio-total 2 3) 5) (= (ratio-total 4 6) 10))"
     :cs-program "(define (equivalent? a b c d) (= (* a d) (* b c)))\n(and (equivalent? 2 3 4 6) (not (equivalent? 2 3 4 7)))"
     :invariant "∀ a b > 0, k > 0. ratio(a,b) ≡ ratio(k·a, k·b)" :meta "Scale-invariance of ratios. If broken, the visualization mismatches equivalent ratios. See book-of-math ch 6.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain ratio-bar with scaling to show equivalent ratios." :composition "(define (equiv a b k) (list (math/ratio-bar a b) (math/ratio-bar (* a k) (* b k))))
(equiv 1 4 5)"
     :eng-composition "(define (ratio-report a b)\n  (list 'bar (math/ratio-bar a b)\n        'total (+ a b)\n        'first-share (math/pct a (+ a b))))\n(ratio-report 8 12)"
     :math-composition "(define (equivalent-bars a b ks)\n  (map (lambda (k) (math/ratio-bar (* a k) (* b k))) ks))\n(equivalent-bars 2 3 '(1 2 3))"
     :cs-composition "(define (bar-for-fraction n d)\n  (math/ratio-bar n (- d n)))\n(bar-for-fraction 3 8)"
     :emergent "equivalence-illustration." :meta "Belongs to the family of pedagogical parallel-views. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb
  :name "math/round" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/round n decimals) -> number"
  :summary "Round n to a given number of decimal places using half-away-from-zero rule."
  :explanation "Rounding is essential for display and comparison. This verb rounds to a fixed number of decimal places using the half-away-from-zero strategy: if the digit to be discarded is 5 or greater, round away from zero (up for positive, down for negative). For example, 2.345 rounded to 2 decimal places is 2.35, and -2.345 rounded to 2 places is -2.35. This is more predictable for teaching than banker's rounding (round-to-even)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/round 3.14159 2)" :note "Returns 3.14 — truncated and rounded to two decimal places.")
    (:dialect "motoi" :tier "intermediate" :code "(define (format-price cents)\n  (math/round (/ cents 100) 2))\n(display (format-price 1049))" :note "Convert cents to dollars and round; common in e-commerce or shoppe contexts.")
    (:dialect "motoi" :tier "expert" :code "(define (grade-with-curve raw-score scale factor)\n  (let ((adjusted (+ raw-score (* scale factor))))\n    (math/round adjusted 1)))\n(grade-with-curve 87 0.5 2)" :note "Apply a formula, then round to one decimal place for consistent display.")
  )
  :caveats ("Rounds half away from zero, not toward even (banker's rounding); -2.5 rounds to -3, not -2." "If decimals is 0, rounds to the nearest integer." "If decimals is negative, *[verify]* rounding behavior (e.g., (math/round 1234 -1) may round to nearest 10)." "Floating-point precision issues may arise with very large numbers or many decimal places.")
  :drawbacks ("Does not truncate; use (floor n) or (quotient n) if you need strict truncation." "Does not format as a string; compose with (display) or (format) for string output." "Expensive for many rounding operations in a tight loop; cache if possible.")
  :usecases ("Price formatting and currency display." "Grade reporting and score display." "Scientific or statistical output (confidence intervals, p-values)." "UI labels and dashboards requiring fixed precision.")
  :related ("math/pct" "math/round-to-place" "math/avg")
  :learn (:concept "Decimal rounding and half-away-from-zero rule." :prerequisites ("(core)/number?" "(core)/expt" "(core)/quotient") :progression "After learning math/round, study math/round-to-place to understand place-magnitude rounding (10s, 100s), then explore exact/float->rat for exact rational arithmetic.")
  :row-2-audit (
    (:problem "A price display needs π rounded to 2 decimal places."
     :program "(math/round 3.14159 2)"
     :eng-program "(define (price-list-round prices places)\n  (map (lambda (p) (math/round p places)) prices))\n(price-list-round (list 12.999 4.995 0.055 100.001) 2)"
     :math-program "(define (round-preserves-integer? n)\n  (and (= (math/round 3.0 5) 3.0)\n       (= (math/round (- 7.0) 3) (- 7.0))))\n(round-preserves-integer? 5)"
     :cs-program "(define (safe-round x places)\n  (cond ((not (number? x)) (error 'not-a-number))\n        ((< places 0) (error 'need-nonneg-places))\n        (else (math/round x places))))\n(safe-round 3.14159 2)"
     :explanation "Round to 2 decimals. Eng: batch price rounding. Math: rounding integers is identity regardless of places. CS: type + precondition guards."
     :meta "math/round is the correct verb because it rounds half-away-from-zero, which is the intuitive rule. Banker's rounding would flip on 0.5 boundaries.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: precision truncation with rounding."
     :rungs (
       (:domain "math/*" :code "(math/round 3.14159 2)")
       (:domain "supermarket prices (a metaphor domain — items priced to two decimal cents)" :code "(math/round 3.14159 2)")
       (:domain "math — approximation to a fixed precision" :code "(define (approx x p) (list x p))")
     )
     :explanation "Each rung truncates precision to a fixed number of digits."
     :meta "The shape transfers because 'to N places' is a universal presentation operation.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "The error is bounded by half the place unit."
     :program "(< (abs (- (math/round 3.14159 2) 3.14159)) 0.005)"
     :eng-program "(define (batch-error-bounded? xs)\n  (let loop ((rest xs))\n    (cond ((null? rest) #t)\n          ((> (abs (- (math/round (car rest) 3) (car rest))) 0.0005) #f)\n          (else (loop (cdr rest))))))\n(batch-error-bounded? (list 3.14159 2.71828 1.41421 0.577215))"
     :math-program "(define (half-away-from-zero?)\n  (and (= (math/round 2.5 0) 3)\n       (= (math/round -2.5 0) -3)\n       (= (math/round 0.5 0) 1)))\n(half-away-from-zero?)"
     :cs-program "(define (idempotent-at-precision? x k)\n  (= (math/round (math/round x k) k) (math/round x k)))\n(and (idempotent-at-precision? 3.14159 2)\n     (idempotent-at-precision? 7.0 5))"
     :invariant "∀ x ∈ ℝ, k ∈ ℕ. |round(x, k) − x| ≤ 0.5·10^(-k)"
     :meta "Rounding error bound. If broken, precision guarantee is wrong. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain round with a formatter for currency display."
     :composition "(define (dollar-format cents)\n  (string-append \"$\" (number->string (math/round (/ cents 100) 2))))\n(dollar-format 1049)"
     :eng-composition "(define (invoice-total-rounded items)\n  (math/round (apply + items) 2))\n(invoice-total-rounded (list 12.345 4.678 0.999 1.5))"
     :math-composition "(define (fit-error-report ys y-hats)\n  (let* ((residuals (map - ys y-hats))\n         (mse (/ (apply + (map (lambda (r) (* r r)) residuals)) (length ys))))\n    (math/round (sqrt mse) 4)))\n(fit-error-report (list 1.0 2.0 3.0 4.0) (list 1.1 1.9 3.05 3.98))"
     :cs-composition "(define (grade-with-cap raw-score cap decimals)\n  (math/round (min raw-score cap) decimals))\n(grade-with-cap 105.789 100 1)"
     :emergent "round-then-format. Eng: invoice total with 2-decimal round. Math: fit-error RMSE rounded to 4 places. CS: grade capped-then-rounded for display."
     :meta "Belongs to the family of presentation pipelines. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb
  :name "math/round-half-up" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/round-half-up x places) -> number"
  :summary "Rounds x to the specified number of decimal places using round-half-up (classical rounding)."
  :explanation "Rounding approximates a number to a simpler form with fewer decimal places. Round-half-up (also called 'commercial rounding' or 'round half away from zero') rounds .5 up: 2.5 becomes 3, 2.4 becomes 2, 2.6 becomes 3. This is the most intuitive rounding for most people. The places argument specifies the number of decimal places: places=0 rounds to an integer, places=1 rounds to one decimal place, places=−1 rounds to the nearest ten, etc. Returns an inexact floating-point number."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/round-half-up 3.7 0)" :note "Rounds 3.7 to 0 decimal places (nearest integer) = 4.")
    (:dialect "motoi" :tier "intermediate" :code "(define (price-from-cost cost markup-pct)\n  (let ((gross (* cost (+ 1 (/ markup-pct 100)))))\n    (math/round-half-up gross 2)))\n(price-from-cost 10 15)" :note "Commerce: compute price with markup, then round to 2 decimal places (cents).")
    (:dialect "motoi" :tier "expert" :code "(define (summarize-measurements measurements)\n  (let ((mean (/ (apply + measurements) (length measurements))))\n    (list 'mean-exact mean\n          'mean-rounded (math/round-half-up mean 3))))\n(summarize-measurements (list 2.3456 2.3461 2.3454))" :note "Statistics: compute exact mean, then round for reporting.")
  )
  :caveats ("places can be negative (round to tens, hundreds, etc.); places=−1 rounds to nearest 10." "Rounding .5 always rounds away from zero (up for positive, down for negative)." "Floating-point representation errors may cause subtle rounding artifacts." "This is inexact: suitable for presentation, not for exact financial or critical calculations." "Successive rounding can accumulate error; round once at the end, not at intermediate steps.")
  :drawbacks ("Does not use banker's rounding (round-half-to-even), which some contexts prefer." "Floating-point precision limits effectiveness for very precise values." "Not suitable for exact rational arithmetic (use exact/* for precise fractional results)." "Rounding .5 away from zero can introduce upward bias in large datasets.")
  :usecases ("Formatting prices and monetary values to 2 decimal places." "Rounding measurements and scientific data for presentation." "Computing averages and summaries from noisy data." "Preparing output for display in user interfaces or reports.")
  :related ("math/round" "math/exp" "math/log" "math/pow" "exact/->float" "exact/->mixed")
  :learn (:concept "Round-half-up: classical rounding where .5 rounds away from zero." :prerequisites () :progression "Use math/round-half-up for basic rounding, then explore exact/* for precise fractional arithmetic, then consider banker's rounding or truncation for specialized contexts.")
  :row-2-audit (
    (:problem "A financial rounding needs to round 2.5 to 3 (not banker's 2)." :program "(math/round-half-up 2.5 0)"
     :eng-program "(define (to-cents x) (math/round-half-up x 2))\n(map to-cents '(1.005 2.675 0.125))"
     :math-program "(math/round-half-up 2.5 0)"
     :cs-program "(define (round-list xs places)\n  (map (lambda (x) (math/round-half-up x places)) xs))\n(round-list '(1.4 1.5 2.5 -2.5) 0)"
     :explanation "Half rounds up (away from zero). Eng: round money to cents. Math: 2.5 → 3. CS: apply the same rule across a list, note -2.5 → -3." :meta "math/round-half-up is the correct verb when the domain demands commercial rounding. Banker's rounding is unpredictable in currency contexts.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: rounding rule variant."
     :rungs (
       (:domain "math/*" :code "(math/round-half-up 2.5 0)")
       (:domain "classroom grading (a metaphor domain — 89.5% rounds up to 90%)" :code "(define (grade-round g) (list g))")
       (:domain "math — round half away from zero" :code "(define (round-hu x) (list x))")
     )
     :explanation "Each rung specifies a rule for the .5 boundary."
     :meta "The shape transfers because rounding rules are a class of policy choices.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "Applied at places=0, half-up rounds 0.5 to 1, -0.5 to -1." :program "(and (= (math/round-half-up 0.5 0) 1) (= (math/round-half-up -0.5 0) -1))"
     :eng-program "(and (= (math/round-half-up 0.5 0) 1) (= (math/round-half-up -0.5 0) -1))"
     :math-program "(define (integer-fixed? n) (= (math/round-half-up n 0) n))\n(and (integer-fixed? 3) (integer-fixed? -7) (integer-fixed? 0))"
     :cs-program "(define (idempotent? x p)\n  (= (math/round-half-up (math/round-half-up x p) p)\n     (math/round-half-up x p)))\n(and (idempotent? 3.14159 2) (idempotent? 2.5 0))"
     :invariant "round-half-up(0.5, 0) = 1 ∧ round-half-up(-0.5, 0) = -1" :meta "Rule anchor. If broken, the sign handling is wrong. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain half-up with markup for pricing." :composition "(define (price cost markup)
  (math/round-half-up (* cost (+ 1 (/ markup 100))) 2))
(price 10 15)"
     :eng-composition "(define (with-tax price rate)\n  (math/round-half-up (* price (+ 1 (/ rate 100))) 2))\n(with-tax 19.99 8)"
     :math-composition "(define (rounded-mean xs places)\n  (math/round-half-up (/ (apply + xs) (length xs)) places))\n(rounded-mean '(2.3456 2.3461 2.3454) 3)"
     :cs-composition "(define (split-bill total people)\n  (math/round-half-up (/ total people) 2))\n(split-bill 100.0 3)"
     :emergent "commerce-rounding." :meta "Belongs to the family of policy-round pipelines. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb
  :name "math/round-to-place" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/round-to-place n place-magnitude) -> number"
  :summary "Round n to the nearest place magnitude (10, 100, 1000, etc.); not decimal places."
  :explanation "Place-magnitude rounding rounds to the nearest power of ten, rather than decimal places. For example, rounding 1234 to the nearest 100 gives 1200; rounding to the nearest 10 gives 1230. This is distinct from math/round, which rounds by decimal places. Place-magnitude rounding is useful for estimation, order-of-magnitude thinking, and student exercises in which the concept of place value is central."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/round-to-place 1234 100)" :note "Returns 1200 — rounded to the nearest hundred.")
    (:dialect "motoi" :tier "intermediate" :code "(define (estimate-population city-count)\n  (math/round-to-place (* city-count 50000) 100000))\n(estimate-population 12)" :note "Estimate total population, then round to nearest hundred-thousand for a rough figure.")
    (:dialect "motoi" :tier "expert" :code "(define (budget-line-item cost magnitude)\n  (let ((rounded (math/round-to-place cost magnitude)))\n    (cond ((equal? rounded 'nan) 'error)\n          ((> rounded cost) (list 'over rounded))\n          (else (list 'under rounded)))))\n(budget-line-item 1567 1000)" :note "Round a cost to a place magnitude, then classify as over or under the original cost.")
  )
  :caveats ("Expects a place magnitude (10, 100, 1000, …); passing arbitrary numbers yields *[verify]* results." "Returns 'nan if the magnitude is zero or invalid." "Negative magnitudes: behavior is *[verify]*." "Very large magnitudes may cause precision loss in floating-point representation.")
  :drawbacks ("More specialized than math/round; if you need decimal-place rounding, use math/round instead." "Does not handle bases other than 10; binary or hexadecimal rounding requires custom code." "Not suitable for fine-grained precision; use math/round if you need 0.01-unit accuracy.")
  :usecases ("Order-of-magnitude estimation exercises (how many students in the school?)." "Budget or cost approximation (round salaries to nearest 1000)." "Population, survey, or demographic reporting." "Simplifying large numbers for mental math and student intuition-building.")
  :related ("math/place-value" "math/round" "math/avg")
  :learn (:concept "Place-magnitude rounding vs. decimal rounding." :prerequisites ("(core)/number?" "math/place-value") :progression "Learn math/place-value first to understand place magnitudes, then study math/round-to-place for rounding by magnitude, and finally math/round for decimal-place precision.")
  :row-2-audit (
    (:problem "An estimator rounds a cost of 1567 to the nearest 100 for a rough budget." :program "(math/round-to-place 1567 100)"
     :eng-program "(define (budget-estimate cost) (math/round-to-place cost 100))\n(map budget-estimate '(1567 2340 899))"
     :math-program "(math/round-to-place 1234 100)"
     :cs-program "(define (round-many ns mag)\n  (map (lambda (n) (math/round-to-place n mag)) ns))\n(round-many '(12 45 67 88) 10)"
     :explanation "Round to the nearest 100 → 1600. Eng: rough budget figures. Math: 1234 to nearest 100 = 1200. CS: round a whole list to the same magnitude." :meta "math/round-to-place is the correct verb for magnitude rounding. math/round handles decimals; this handles powers of 10.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: coarse-grained rounding."
     :rungs (
       (:domain "math/*" :code "(math/round-to-place 1567 100)")
       (:domain "estimating (a metaphor domain — nearest ten-thousand for a population)" :code "(define (est n place) (list n place))")
       (:domain "math — rounding on a lattice" :code "(define (round-lattice x k) (list x k))")
     )
     :explanation "Each rung snaps a value to a coarser grid."
     :meta "The shape transfers because 'snap to a lattice' is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "The result is always a multiple of the magnitude." :program "(zero? (modulo (math/round-to-place 1567 100) 100))"
     :eng-program "(zero? (modulo (math/round-to-place 1567 100) 100))"
     :math-program "(define (multiple-of-mag? n m) (zero? (modulo (math/round-to-place n m) m)))\n(and (multiple-of-mag? 1567 100) (multiple-of-mag? 42 10) (multiple-of-mag? 9876 1000))"
