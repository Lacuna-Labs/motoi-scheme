(verb :name "truncate" :std "R7RS-small"        :library "math" :tier "core" :kind "pure" :signature "(truncate x) -> integer"
  :summary "Round toward zero. R7RS §6.2.6."
  :provenance "R7RS §6.2.6; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(truncate 3.7)" :note "3.0 — toward zero. §6.2.6 says truncate PRESERVES exactness, so an inexact argument gives an inexact answer: 3.0, not 3. Use (exact (truncate 3.7)) when you want the exact integer.")
    (:dialect "motoi" :tier "intermediate" :code "(truncate -3.7)" :note "-3.0 — toward zero, NOT down: (floor -3.7) is -4.0. Inexact in, inexact out, as above.")
    (:dialect "motoi" :tier "expert" :code "(define (truncate-to places x) (let ((s (math/pow 10 places))) (/ (truncate (* x s)) s)))\n(truncate-to 2 3.14159)" :note "Truncate to N decimal places by scaling. Returns 3.14.")
  )
  :row-2-audit (
    (:problem "A trip-cost tracker rounds toward zero to get the integer dollar count." :program "(truncate 3.7)"
     :eng-program "(define (whole-dollars amount) (truncate amount))\n(whole-dollars 3.7)"
     :math-program "(define (matches-floor-on-positives? x) (= (truncate x) (math/floor x)))\n(and (matches-floor-on-positives? 3.7) (matches-floor-on-positives? 0.9))"
     :cs-program "(define (safe-truncate x) (if (number? x) (truncate x) (error 'not-a-number)))\n(safe-truncate -3.7)"
     :explanation "Returns 3.0. Eng: whole dollars from a cost. Math: truncate agrees with floor on non-negatives but not on negatives. CS: type-guarded wrapper."
     :meta "truncate is the correct verb (R7RS) for round-toward-zero. math/floor rounds toward -∞ — different at negatives.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: round-toward-zero."
     :rungs (
       (:domain "math/*" :code "(truncate 3.7)")
       (:domain "payroll (a metaphor domain — always pay whole hours worked, drop the fraction)" :code "(define (whole-hours h) (list h))")
       (:domain "math — integer part of x by dropping the fraction" :code "(define (int-part x) (list x))")
     )
     :explanation "Each rung drops the fractional part."
     :meta "The shape transfers because 'integer part toward zero' is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "truncate(-x) = -truncate(x)." :program "(= (truncate -3.7) (- (truncate 3.7)))"
     :eng-program "(define (never-rounds-up?) (and (= (truncate 3.9) 3.0) (= (truncate -3.9) -3.0)))\n(never-rounds-up?)"
     :math-program "(define (odd-symmetry? x) (= (truncate (- x)) (- (truncate x))))\n(and (odd-symmetry? 3.7) (odd-symmetry? -2.2) (odd-symmetry? 0.0))"
     :cs-program "(define (magnitude-not-increased? x) (<= (abs (truncate x)) (abs x)))\n(and (magnitude-not-increased? 3.7) (magnitude-not-increased? -3.7))"
     :invariant "∀ x. truncate(-x) = -truncate(x)" :meta "Odd-symmetry, and |truncate(x)| ≤ |x| always. If broken, sign handling is wrong. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain truncate with modulo for a discrete part." :composition "(define (frac-part x) (- x (truncate x)))
(frac-part 3.7)"
     :eng-composition "(define (split-money amount) (let ((whole (truncate amount))) (list 'dollars whole 'cents (truncate (* 100 (- amount whole))))))\n(split-money 12.34)"
     :math-composition "(define (int-parts xs) (map truncate xs))\n(int-parts (list 1.9 -1.9 2.5 -2.5))"
     :cs-composition "(define (bucket x width) (* width (truncate (/ x width))))\n(list (bucket 27 10) (bucket -27 10))"
     :emergent "int-and-frac decomposition. Eng: split a currency amount into whole dollars and cents. Math: elementwise integer part of a list. CS: quantize a value into fixed-width buckets toward zero." :meta "Belongs to the family of number-decomposition patterns. See book-of-composition ch 7.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "atan" :std "R7RS-small"            :library "math" :tier "core" :kind "pure" :signature "(atan y [x]) -> number"
  :summary "(atan y) → arctan; (atan y x) → atan2. R7RS §6.2.6."
  :provenance "R7RS §6.2.6; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(atan 1)" :note "0.7853981633974483 — pi/4.")
    (:dialect "motoi" :tier "intermediate" :code "(atan 1 1)" :note "0.7853981633974483 — 2-arg form: atan(y/x) in the right quadrant.")
  )
  :row-2-audit (
    (:eng-program "(define (heading-from-velocity vx vy) (atan vy vx))\n(heading-from-velocity 1 1)"
     :math-program "(define (arctan-of-slope m) (atan m))\n(arctan-of-slope 0.577)"
     :cs-program "(define (safe-atan y x) (if (and (zero? y) (zero? x)) 0 (atan y x)))\n(safe-atan 0 0)")
    (:problem "An operator needs the polar angle of (3, 4) — atan2 spelled the R7RS way." :program "(atan 4 3)" :explanation "Returns ~0.927 rad." :meta "atan (2-arg) is the correct verb because it's R7RS-standard atan2. geom/atan2 is the geom-library alias.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape as geom/atan2 (see chapter 29)."
     :rungs (
       (:domain "math/*" :code "(atan 1 1)")
       (:domain "compass (a metaphor domain — bearing from displacement)" :code "(define (bearing dy dx) (list dy dx))")
       (:domain "math — polar angle from Cartesian coordinates" :code "(define (polar-ang x y) (list x y))")
     )
     :explanation "Each rung recovers a full-quadrant angle from two components."
     :meta "The shape transfers because atan2 is universal in polar recovery.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:eng-program "(define (opposite-quadrant? a) (let ((b (atan (- (sin a)) (- (cos a))))) (< (abs (- (abs (- a b)) 3.14159265)) 0.001)))\n(opposite-quadrant? 0.5)"
     :math-program "(define (arctan-monotone? a b) (if (< a b) (< (atan a) (atan b)) #t))\n(arctan-monotone? 0.5 1.5)"
     :cs-program "(define (atan-of-zero-zero-defined? ) (number? (atan 1 1)))\n(atan-of-zero-zero-defined?)"
     :claim "atan(y, x) is in [-π, π]." :program "(let ((a (atan 1 -1))) (and (<= a math/pi) (>= a (- math/pi))))" :invariant "∀ y x not both 0. atan(y, x) ∈ [-π, π]" :meta "Codomain invariant. If broken, branch selection is wrong. See book-of-math ch 5.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:eng-composition "(define (target-tracker current target) (let ((dy (- (cadr target) (cadr current))) (dx (- (car target) (car current)))) (atan dy dx)))\n(target-tracker '(0 0) '(3 4))"
     :math-composition "(define (angle-differences angles) (if (or (null? angles) (null? (cdr angles))) '() (cons (- (cadr angles) (car angles)) (angle-differences (cdr angles)))))\n(angle-differences (list (atan 1) (atan 2) (atan 5)))"
     :cs-composition "(define (rotate-2d point angle) (let ((c (cos angle)) (s (sin angle)) (x (car point)) (y (cadr point))) (let ((new-angle (+ (atan y x) angle))) (list (* (sqrt (+ (* x x) (* y y))) (cos new-angle)) (* (sqrt (+ (* x x) (* y y))) (sin new-angle))))))\n(rotate-2d '(1 0) 1.5708)")
    (:base "Chain atan with sqrt for polar coords." :composition "(define (to-polar x y)
  (list (math/sqrt (+ (* x x) (* y y))) (atan y x)))
(to-polar 3 4)" :emergent "cartesian-to-polar." :meta "Belongs to the family of coordinate-transform patterns. See book-of-composition ch 10.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "square" :std "R7RS-small"          :library "math" :tier "core" :kind "pure" :signature "(square x) -> number"
