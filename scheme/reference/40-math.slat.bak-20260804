(verb :name "exact" :std "R7RS-small"           :library "math" :tier "core" :kind "pure" :signature "(exact x) -> exact-number"
  :summary "The exact number x denotes. R7RS §6.2. An integer when x is integer-valued, otherwise an exact rational — (exact 3.5) is 7/2, not 3."
  :provenance "R7RS §6.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(exact 3.5)" :note "7/2 — the exact rational.")
    (:dialect "motoi" :tier "intermediate" :code "(exact 1.5)" :note "3/2.")
    (:dialect "motoi" :tier "expert" :code "(define (money-add . amounts) (apply + (map exact amounts)))\n(money-add 0.10 0.20 0.05)" :note "Sum currency amounts exactly, avoiding 0.1+0.2 float drift.")
  )
  :row-2-audit (
    (:problem "A rational computation needs to convert 3.5 back to 7/2."
     :program "(exact 3.5)"
     :eng-program "(define (exact-percent-of x pct) (exact (* x (/ pct 100))))\n(exact-percent-of 200 15)"
     :math-program "(define (float-rational-fidelity x) (equal? (exact x) (exact (inexact (exact x)))))\n(float-rational-fidelity 0.25)"
     :cs-program "(define (safe-exact x) (if (number? x) (exact x) (error 'not-a-number)))\n(safe-exact 3.5)"
     :explanation "Convert to exact form. Eng: exact percentage-of-a-price. Math: round-trip fidelity witness. CS: type-guarded conversion."
     :meta "exact is the correct verb because it names the conversion. inexact->exact is an alias.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: representation conversion."
     :rungs (
       (:domain "math/*" :code "(exact 3.5)")
       (:domain "digital-analog (a metaphor domain — quantize analog to digital)" :code "(define (digitize a) (round (* a 256)))")
       (:domain "math — embedding of ℝ into ℚ (up to precision)" :code "(define (rat-of x) (exact x))"))
     :explanation "Each rung converts a representation to a more precise one."
     :meta "The shape transfers because 'exact' and 'inexact' are two sides of the number tower.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "exact ∘ inexact is identity on exacts."
     :program "(equal? 7 (exact (inexact 7)))"
     :eng-program "(define (integer-preserved?) (and (equal? (exact 3.0) 3) (equal? (exact -5.0) -5)))\n(integer-preserved?)"
     :math-program "(define (exact-integer-idempotent? n) (equal? (exact (exact n)) (exact n)))\n(and (exact-integer-idempotent? 3.5) (exact-integer-idempotent? -2.25))"
     :cs-program "(define (yields-exact-type? x) (exact? (exact x)))\n(and (yields-exact-type? 3.5) (yields-exact-type? 0.1))"
     :invariant "∀ n ∈ ℤ. exact(inexact(n)) = n"
     :meta "Round-trip on integers. If broken, precision loss. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain exact with arithmetic for precise fractions."
     :composition "(+ (exact 3.5) (exact 2.5))"
     :eng-composition "(define (settle-invoice line-items) (let loop ((xs line-items) (total 0)) (if (null? xs) total (loop (cdr xs) (+ total (exact (car xs)))))))\n(settle-invoice (list 0.10 0.20 0.35))"
     :math-composition "(define (mean-exact xs) (/ (apply + (map exact xs)) (length xs)))\n(mean-exact (list 1.5 2.5 3.5))"
     :cs-composition "(define (bounded-precision xs cap) (map (lambda (x) (let* ((r (exact x)) (d (denominator r))) (if (> d cap) (/ (round (* x cap)) cap) r))) xs))\n(bounded-precision (list 0.333333 0.5 0.6666) 100)"
     :emergent "convert-then-compute. Eng: exact invoice settlement. Math: mean over exact reals. CS: precision-cap admission control."
     :meta "Belongs to the family of precision-preservation patterns. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "inexact" :std "R7RS-small"         :library "math" :tier "core" :kind "pure" :signature "(inexact x) -> number"
  :summary "Convert to inexact (float). R7RS §6.2."
  :provenance "R7RS §6.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(inexact 1)" :note "1.0 — the inexact image of the exact 1. The trailing .0 is not decoration: it is how the printer says INEXACT, and it is what makes the value read back as a double rather than as the exact 1. (exact? (inexact 1)) is #f.")
    (:dialect "motoi" :tier "intermediate" :code "(inexact 3/2)" :note "1.5.")
  )
  :row-2-audit (
   
    (:problem "A display layer converts 3/2 to 1.5 for the UI."
     :program "(inexact 3/2)"
     :eng-program "(define (percentages-as-floats fractions) (map inexact fractions))\n(percentages-as-floats (list 1/4 1/3 3/8 5/16))"
     :math-program "(define (float-conservation-check q)\n  (let ((f (inexact q)))\n    (< (abs (- f q)) 1e-12)))\n(and (float-conservation-check 1/2)\n     (float-conservation-check 3/4)\n     (float-conservation-check 7/8))"
     :cs-program "(define (safe-inexact x)\n  (cond ((and (number? x) (exact? x)) (inexact x))\n        ((and (number? x) (not (exact? x))) x)\n        (else (error 'not-a-number))))\n(list (safe-inexact 3/2) (safe-inexact 2.5))"
     :explanation "Convert to float. Eng: batch-convert rational percentages to floats. Math: dyadic rationals (denominators = 2^k) convert exactly. CS: type-guarded wrapper that also passes through already-inexact numbers."
     :meta "inexact is the correct verb. exact->inexact is an alias.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape as exact but the reverse direction."
     :rungs (
       (:domain "math/*" :code "(inexact 3/2)")
       (:domain "resampling (a metaphor domain — analog approximation from a digital exact)" :code "(define (analog e) (list e))")
       (:domain "math — embedding of ℚ into a float representation" :code "(define (float-of x) (list x))")
     )
     :explanation "Each rung converts an exact value to an inexact one."
     :meta "The shape transfers because representations map both ways.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "inexact ∘ exact ≈ identity for representable inputs."
     :program "(< (abs (- (inexact (exact 3.5)) 3.5)) 1e-15)"
     :eng-program "(define (idempotent-on-floats? x) (equal? (inexact x) (inexact (inexact x))))\n(and (idempotent-on-floats? 3.14)\n     (idempotent-on-floats? -2.71))"
     :math-program "(define (integer-to-float-exact? n) (= (inexact n) n))\n(and (integer-to-float-exact? 0)\n     (integer-to-float-exact? 1)\n     (integer-to-float-exact? (- (expt 2 40))))"
     :cs-program "(define (loss-on-thirds)\n  (let ((third (/ 1 3)))\n    (> (abs (- (inexact third) third)) 0)))\n(loss-on-thirds)"
     :invariant "∀ representable x. |inexact(exact(x)) − x| < ε"
     :meta "Round-trip up to float precision. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain inexact with a UI formatter."
     :composition "(define (show-frac n d) (number->string (inexact (/ n d))))\n(show-frac 3 2)"
     :eng-composition "(define (mean-as-float xs)\n  (inexact (/ (apply + xs) (length xs))))\n(mean-as-float (list 1 2 3 4 5))"
     :math-composition "(define (leibniz-pi-inexact terms)\n  (inexact (* 4 (let loop ((k 0) (acc 0))\n                  (if (>= k terms) acc\n                      (loop (+ k 1) (+ acc (/ (expt -1 k) (+ (* 2 k) 1)))))))))\n(leibniz-pi-inexact 100)"
     :cs-composition "(define (batch-normalize amounts)\n  (let ((total (apply + amounts)))\n    (map (lambda (a) (inexact (/ a total))) amounts)))\n(batch-normalize (list 30 20 50))"
     :emergent "convert-then-format. Eng: mean-as-float from exact fraction. Math: Leibniz series kept exact then displayed as float at boundary. CS: batch-normalize probabilities as floats."
     :meta "Belongs to the family of presentation-conversion patterns. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "exact->inexact" :std "R7RS-small"  :library "math" :tier "core" :kind "pure" :signature "(exact->inexact x) -> number"
  :summary "Alias for inexact. R7RS §6.2."
  :provenance "R7RS §6.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(exact->inexact 1/2)" :note "0.5.")
    (:dialect "motoi" :tier "intermediate" :code "(exact->inexact 22/7)" :note "3.142857142857143 — an approximation of pi.")
    (:dialect "motoi" :tier "expert" :code "(define (approx-pi terms) (exact->inexact (let loop ((k 0) (acc 0)) (if (>= k terms) acc (loop (+ k 1) (+ acc (/ (expt -1 k) (+ (* 2 k) 1))))))))\n(* 4 (approx-pi 1000))" :note "Leibniz series for pi kept exact, then displayed as inexact only at the boundary.")
  )
  :row-2-audit (
    (:problem "Same problem as inexact — convert an exact rational to a float for the UI."
     :program "(exact->inexact 22/7)"
     :eng-program "(define (percent-string q) (list 'pct (exact->inexact (* q 100))))\n(percent-string 3/8)"
     :math-program "(define (float-diff-from-exact q) (- (exact->inexact q) q))\n(< (abs (float-diff-from-exact 1/3)) 1e-15)"
     :cs-program "(define (safe-e->i x) (if (rational? x) (exact->inexact x) (error 'not-rational)))\n(safe-e->i 22/7)"
     :explanation "Convert to float; result approximates the rational. Eng: percent-formatter. Math: quantization-error probe. CS: type-guarded conversion."
     :meta "exact->inexact is the correct verb because it's the R7RS name. inexact is the alias.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape as inexact."
     :rungs (
       (:domain "math/*" :code "(exact->inexact 1/2)")
       (:domain "photographic prints (a metaphor domain — exact digital negatives become physical prints)" :code "(define (print neg) (exact->inexact neg))")
       (:domain "math — R7RS-standard promote to float" :code "(define (promote x) (exact->inexact x))"))
     :explanation "Each rung converts exact to inexact."
     :meta "The shape transfers because R7RS promotion is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "Result satisfies (exact result) equals input up to representable precision."
     :program "(< (abs (- (exact->inexact 1/2) 0.5)) 1e-15)"
     :eng-program "(define (small-relative-error? q) (< (abs (- (exact->inexact q) q)) (* (abs q) 1e-14)))\n(small-relative-error? 1/8)"
     :math-program "(define (idempotent-on-inexact? x) (= (exact->inexact x) (exact->inexact (exact->inexact x))))\n(and (idempotent-on-inexact? 3.14) (idempotent-on-inexact? 0.1))"
     :cs-program "(define (yields-inexact-type? q) (inexact? (exact->inexact q)))\n(and (yields-inexact-type? 1/2) (yields-inexact-type? 22/7))"
     :invariant "∀ q ∈ ℚ representable. exact→inexact(q) ≈ q"
     :meta "Round-trip precision. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain into display pipeline."
     :composition "(define (display-frac n d) (exact->inexact (/ n d)))\n(display-frac 22 7)"
     :eng-composition "(define (format-progress done total) (let ((pct (exact->inexact (* 100 (/ done total))))) (list 'pct pct 'label (list done '/ total))))\n(format-progress 3 8)"
     :math-composition "(define (series-partial-sums coeffs) (let loop ((cs coeffs) (acc 0) (out '())) (if (null? cs) (reverse out) (let ((s (+ acc (car cs)))) (loop (cdr cs) s (cons (exact->inexact s) out))))))\n(series-partial-sums (list 1 1/2 1/4 1/8 1/16))"
     :cs-composition "(define (float-render-list qs) (map exact->inexact qs))\n(float-render-list (list 1/3 2/7 5/9))"
     :emergent "convert-then-display. Eng: progress-bar percent. Math: partial-sum tracing. CS: batch float-render for output."
     :meta "Belongs to the family of R7RS-standard conversion patterns. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "inexact->exact" :std "R7RS-small"  :library "math" :tier "core" :kind "pure" :signature "(inexact->exact x) -> integer"
  :summary "Alias for exact. R7RS §6.2."
  :provenance "R7RS §6.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(inexact->exact 0.5)" :note "1/2.")
    (:dialect "motoi" :tier "intermediate" :code "(inexact->exact 3.0)" :note "3.")
  )
  :row-2-audit (
    (:problem "Same problem as exact — recover a rational from a float."
     :program "(inexact->exact 0.5)"
     :eng-program "(define (money-add . floats)\n  (apply + (map inexact->exact floats)))\n(money-add 0.10 0.20 0.05)"
     :math-program "(define (rational-reconstruction-check x)\n  (let ((q (inexact->exact x)))\n    (and (rational? q) (< (abs (- (inexact q) x)) 1e-12))))\n(and (rational-reconstruction-check 0.5)\n     (rational-reconstruction-check 0.25)\n     (rational-reconstruction-check 0.125))"
     :cs-program "(define (guarded-i->e x)\n  (cond ((and (number? x) (not (exact? x))) (inexact->exact x))\n        ((exact? x) x)\n        (else (error 'not-a-number))))\n(list (guarded-i->e 0.5) (guarded-i->e 1/2))"
     :explanation "Convert to rational. Eng: exact money summation avoids 0.10+0.20 float drift. Math: rational-reconstruction of a float (dyadic rationals exact). CS: type-guard that passes through already-exact numbers."
     :meta "inexact->exact is the correct verb (R7RS name). exact is the alias.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape as exact."
     :rungs (
       (:domain "math/*" :code "(inexact->exact 0.5)")
       (:domain "scanning (a metaphor domain — analog signal to exact digital)" :code "(define (scan a) (list a))")
       (:domain "math — R7RS-standard demote to rational" :code "(define (demote x) (list x))")
     )
     :explanation "Each rung converts inexact to exact."
     :meta "The shape transfers because R7RS demotion is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
   
    (:claim "For exact-representable floats, the demotion is precise."
     :program "(equal? 1/2 (inexact->exact 0.5))"
     :eng-program "(define (dyadic-rational-check)\n  (and (equal? (inexact->exact 0.5) 1/2)\n       (equal? (inexact->exact 0.25) 1/4)\n       (equal? (inexact->exact 0.125) 1/8)))\n(dyadic-rational-check)"
     :math-program "(define (integer-preserved?)\n  (and (equal? (inexact->exact 5.0) 5)\n       (equal? (inexact->exact -3.0) -3)\n       (equal? (inexact->exact 0.0) 0)))\n(integer-preserved?)"
     :cs-program "(define (returns-exact-type? x)\n  (exact? (inexact->exact x)))\n(and (returns-exact-type? 0.5)\n     (returns-exact-type? 3.14))"
     :invariant "∀ float x representable as ℚ. inexact→exact(x) = the rational value of x"
     :meta "Exact recovery when possible. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain into arithmetic to avoid float rounding."
     :composition "(+ (inexact->exact 0.1) (inexact->exact 0.2))"
     :eng-composition "(define (exact-sum-of-samples samples)\n  (apply + (map inexact->exact samples)))\n(exact-sum-of-samples (list 0.1 0.2 0.3 0.4))"
     :math-composition "(define (harmonic-sum-exact n)\n  (let loop ((k 1) (acc 0))\n    (if (> k n) acc\n        (loop (+ k 1) (+ acc (inexact->exact (/ 1.0 k)))))))\n(harmonic-sum-exact 5)"
     :cs-composition "(define (bounded-precision-cap xs cap)\n  (map (lambda (x)\n         (let ((q (inexact->exact x)))\n           (/ (round (* x cap)) cap)))\n       xs))\n(bounded-precision-cap (list 0.333333 0.5 0.66666) 100)"
     :emergent "convert-then-compute-exact. Eng: exact sample sum avoids accumulated float drift. Math: harmonic-sum with exact partials. CS: precision-cap to bound rational denominator explosion."
     :meta "Belongs to the family of precision-preservation patterns. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "gcd" :std "R7RS-small"             :library "math" :tier "core" :kind "pure" :signature "(gcd n ...) -> integer"
  :summary "Greatest common divisor. R7RS §6.2.6."
  :examples ((:dialect "motoi" :tier "novice" :code "(gcd 12 18)" :note "6."))
  :provenance "R7RS §6.2.6; added 2026-07-18 finalization"
  :row-2-audit (
    (:eng-program "(define (reduce-ratio num den) (let ((d (gcd num den))) (list (/ num d) (/ den d))))\n(reduce-ratio 48 36)"
     :math-program "(define (coprime? a b) (= (gcd a b) 1))\n(coprime? 7 15)"
     :cs-program "(define (safe-gcd . xs) (if (null? xs) 0 (apply gcd xs)))\n(safe-gcd 12 18 24)")
    (:problem "R7RS gcd for a fraction reducer." :program "(gcd 12 18)" :explanation "Returns 6." :meta "gcd (the R7RS core name) is the correct verb. math/gcd aliases it.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape as math/gcd."
     :rungs (
       (:domain "math/*" :code "(gcd 12 18)")
       (:domain "scheduling (a metaphor domain — common repeating period)" :code "(gcd 12 18)")
       (:domain "math — greatest common divisor in ℤ" :code "(define (gcd-int a b) (list a b))")
     )
     :explanation "Each rung finds the greatest shared divisor."
     :meta "The shape transfers to any Euclidean domain.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:eng-program "(define (commutative? a b) (= (gcd a b) (gcd b a)))\n(commutative? 12 18)"
     :math-program "(define (bezout-verified? a b) (let ((d (gcd a b))) (and (zero? (modulo a d)) (zero? (modulo b d)))))\n(bezout-verified? 48 36)"
     :cs-program "(define (idempotent? a) (= (gcd a a) a))\n(idempotent? 24)"
     :claim "gcd(a, 0) = |a|." :program "(= (gcd 12 0) 12)" :invariant "∀ a ∈ ℤ. gcd(a, 0) = |a|" :meta "Zero anchor. See book-of-math ch 3.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:eng-composition "(define (rational-add p q) (let* ((num (+ (* (car p) (cadr q)) (* (car q) (cadr p)))) (den (* (cadr p) (cadr q))) (d (gcd (abs num) den))) (list (/ num d) (/ den d))))\n(rational-add '(1 4) '(1 6))"
     :math-composition "(define (fold-gcd xs) (let loop ((xs xs) (acc 0)) (if (null? xs) acc (loop (cdr xs) (gcd acc (car xs))))))\n(fold-gcd '(24 36 60))"
     :cs-composition "(define (canonical-scale ratios) (let ((g (let loop ((rs ratios) (acc 0)) (if (null? rs) acc (loop (cdr rs) (gcd acc (car rs))))))) (map (lambda (r) (/ r g)) ratios)))\n(canonical-scale '(10 15 25))")
    (:base "Chain gcd for a common-divisor across a list." :composition "(define (multi-gcd xs) (fold gcd 0 xs))\n(multi-gcd '(24 36 60))" :emergent "reduce-with-gcd." :meta "Belongs to the family of monoid folds. See book-of-composition ch 7.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb :name "lcm" :std "R7RS-small"             :library "math" :tier "core" :kind "pure" :signature "(lcm n ...) -> integer"
  :summary "Least common multiple. R7RS §6.2.6."
