(verb
  :name "math/mixed-number" :std "Motoi"
  :library "math"
  :kind "pure"
  :signature "(math/mixed-number improper-fraction) -> (whole numerator denominator) | 'nan"
  :summary "Convert an improper fraction to a mixed number (whole part + reduced proper fraction)."
  :explanation "Takes an improper fraction (as a list (numerator denominator)) and returns a three-element list (whole numerator denominator) where numerator < denominator (a proper fraction). For example, 7/3 becomes (2 1 3) meaning 2 + 1/3. If the denominator is zero, returns 'nan. The result fractions are always in lowest terms (fully reduced). This is useful for displaying fractions in human-readable form and for middle-school algebra curricula."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/mixed-number (list 7 3))" :note "7/3 becomes (2 1 3), i.e. 2 and 1/3.")
    (:dialect "motoi" :tier "intermediate" :code "(define (display-fraction frac)\n  (let ((mixed (math/mixed-number frac)))\n    (if (equal? mixed 'nan)\n      (display \"undefined\")\n      (let ((w (list-ref mixed 0))\n            (n (list-ref mixed 1))\n            (d (list-ref mixed 2)))\n        (display (string-append (number->string w) \" and \" (number->string n) \"/\" (number->string d)))))))\n(display-fraction (list 11 4))" :note "Convert and format a mixed number for display.")
    (:dialect "motoi" :tier "expert" :code "(define (filter pred xs)\n  (let loop ((xs xs) (acc '()))\n    (cond ((null? xs) (reverse acc))\n          ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc)))\n          (else (loop (cdr xs) acc)))))\n(define (solve-fraction-word-problem results)\n  (let ((answers (map\n    (lambda (r)\n      (let ((mn (math/mixed-number r)))\n        (if (equal? mn 'nan)\n          'error\n          (list 'whole (list-ref mn 0) 'frac (list (list-ref mn 1) (list-ref mn 2))))))\n    results)))\n    (filter (lambda (a) (not (equal? a 'error))) answers)))\n(solve-fraction-word-problem (list (list 15 4) (list 22 5) (list 9 0)))" :note "Batch-convert improper fractions and filter out errors (den=0).")
  )
  :caveats ("Denominator must be non-zero; zero returns 'nan without error." "Numerator and denominator are assumed to be integers; behavior with floats is undefined." "Negative fractions are supported; sign is carried in the numerator." "The result is always fully reduced (GCD normalized).")
  :drawbacks ("Requires fraction input as (num den) list; no string parsing." "Inverse verb (mixed number back to improper fraction) is not provided; use arithmetic." "No formatting or display verb; you must build display logic yourself.")
  :usecases ("Displaying fractions in human-readable form in curricula or tutorials." "Converting computation results to mixed number format for answers." "Parsing and simplifying fraction arithmetic in symbolic math." "Building fraction-based games or educational software.")
  :related ("exact/float->rat" "math/round" "math/avg" "geom/slope")
  :learn (:concept "Fraction normalization: converting improper to mixed form and reducing to lowest terms." :prerequisites ("list" "quotient" "modulo") :progression "Learn math/mixed-number, then exact/float->rat for decimal-to-fraction conversion.")
  :row-2-audit (
    (:problem "A student's answer is 7/3; a display layer must show '2 and 1/3'." :program "(define (to-mixed nd) (math/mixed-number nd))
(to-mixed '(7 3))"
     :eng-program "(define (to-mixed nd) (math/mixed-number nd))\n(map to-mixed '((7 3) (11 4) (9 2)))"
     :math-program "(math/mixed-number '(8 4))"
     :cs-program "(define (safe-mixed nd)\n  (let ((m (math/mixed-number nd)))\n    (if (equal? m 'nan) 'div-by-zero m)))\n(list (safe-mixed '(7 3)) (safe-mixed '(5 0)))"
     :explanation "Convert improper to mixed. Returns (2 1 3). Eng: batch-convert a set of answers. Math: 8/4 reduces to whole (2 0 1). CS: guard the zero-denominator case." :meta "math/mixed-number is the correct verb because the desired output is a mixed-number form. Quotient/remainder alone would give the pieces but not the reduced-fraction guarantee.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: canonical representative — pick a distinguished form from a class."
     :rungs (
       (:domain "math/*" :code "(math/mixed-number '(7 3))")
       (:domain "timekeeping (a metaphor domain — 90 minutes rendered as 1 hour 30 minutes)" :code "(define (to-mixed nd) (math/mixed-number nd))\n(to-mixed '(7 3))")
       (:domain "math — Euclidean algorithm applied to fraction reduction" :code "(define (reduce n d) (list n d))")
     )
     :explanation "Each rung picks a canonical representative for an equivalence class."
     :meta "The shape transfers because normalization to canonical form is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "Combining the whole and fraction returns the original ratio." :program "(define m (math/mixed-number '(7 3)))
(define w (list-ref m 0))
(define n (list-ref m 1))
(define d (list-ref m 2))
(= (/ 7 3) (+ w (/ n d)))"
     :eng-program "(define m (math/mixed-number '(11 4)))\n(= (/ 11 4) (+ (list-ref m 0) (/ (list-ref m 1) (list-ref m 2))))"
     :math-program "(define (proper-fraction? nd)\n  (let ((m (math/mixed-number nd)))\n    (< (list-ref m 1) (list-ref m 2))))\n(and (proper-fraction? '(7 3)) (proper-fraction? '(22 5)))"
     :cs-program "(define (roundtrip? nd)\n  (let ((m (math/mixed-number nd)))\n    (= (/ (car nd) (cadr nd))\n       (+ (list-ref m 0) (/ (list-ref m 1) (list-ref m 2))))))\n(and (roundtrip? '(7 3)) (roundtrip? '(15 4)))"
     :invariant "∀ (n, d) with d ≠ 0. w + n'/d' = n/d, where mixed-number(n,d) = (w, n', d')" :meta "Round-trip identity. If broken, either the whole or the fractional part is off. See book-of-math ch 6.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain mixed-number with a formatter for display." :composition "(define (show-mixed nd)
  (let ((m (math/mixed-number nd)))
    (list 'whole (list-ref m 0) 'frac (list (list-ref m 1) (list-ref m 2)))))
(show-mixed '(11 4))"
     :eng-composition "(define (mixed-string nd)\n  (let ((m (math/mixed-number nd)))\n    (string-append (number->string (list-ref m 0)) \" \"\n                   (number->string (list-ref m 1)) \"/\"\n                   (number->string (list-ref m 2)))))\n(mixed-string '(11 4))"
     :math-composition "(define (sort-by-whole nds)\n  (map (lambda (nd) (list nd (list-ref (math/mixed-number nd) 0))) nds))\n(sort-by-whole '((7 3) (22 5) (9 4)))"
     :cs-composition "(define (mixed-or-error nd)\n  (let ((m (math/mixed-number nd)))\n    (if (equal? m 'nan) (list 'error nd) (list 'ok m))))\n(map mixed-or-error '((7 3) (5 0) (11 4)))"
     :emergent "convert-then-format." :meta "Belongs to the family of normalize-then-display patterns. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
))

(verb
  :name "math/number-line" :std "Motoi"
  :library "math"
  :kind "meta"
  :signature "(math/number-line lo hi step) -> spec"
  :summary "Produces a specification for rendering a number line from lo to hi with marks at step intervals."
  :explanation "A number line is a visual teaching tool showing numbers as points on a line. This verb creates a metadata spec describing the line's bounds (lo and hi), the spacing of tick marks (step), and other rendering information. It is commonly used in elementary mathematics to teach ordering, comparison, and basic arithmetic. The spec can be passed to rendering or visualization verbs that build the actual display."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/number-line 0 10 1)" :note "A line from 0 to 10 with marks every 1 unit; shows the integers 0–10.")
    (:dialect "motoi" :tier "intermediate" :code "(define (make-number-line-for-range min-val max-val)\n  (let ((range (- max-val min-val)))\n    (math/number-line min-val max-val (max 1 (quotient range 10)))))\n(make-number-line-for-range 25 75)" :note "Auto-scaling step size based on range; approximately 10 marks across.")
    (:dialect "motoi" :tier "expert" :code "(define (compare-on-line a b)\n  (let ((line (math/number-line (min a b -5) (max a b 5) 1)))\n    (list 'line line 'a a 'b b 'relation\n          (cond ((< a b) '<) ((= a b) '=) (else '>)))))\n(compare-on-line 3 7)" :note "Using a number line spec as context for comparing two values; teaching aid.")
  )
  :caveats ("lo should be less than hi; if lo >= hi, behavior is undefined." "step should be positive; step <= 0 will not produce sensible marks." "This returns a spec object, not a rendered image; another verb must visualize it." "lo, hi, and step need not be integers, but fractional steps may yield dense or sparse marks.")
  :drawbacks ("Spec-only: does not directly render or display; requires a separate visualization step." "Large ranges with small steps produce many marks; may be visually cluttered." "No built-in handling of logarithmic or non-uniform scales; use for linear scales only.")
  :usecases ("Creating visual aids for teaching number ordering and comparison." "Building contexts for arithmetic and fraction problems." "Illustrating inequalities and solution sets on a line." "Supporting interactive math applications that show number positions.")
  :related ("math/integer-line" "math/count-on" "math/skip-count" "math/compare")
  :learn (:concept "Number line as a visual representation of number order and magnitude." :prerequisites ("math/compare") :progression "After math/number-line, explore math/integer-line for negative numbers, then math/count-on and math/skip-count for sequences.")
  :row-2-audit (
    (:problem "A lesson needs a decimal number line from 0 to 1 with marks at 0.1 intervals." :program "(define spec (math/number-line 0 1 0.1))
spec"
