;;; 52-predicate.slat — Motoi Scheme Reference · Chapter 52 · library predicate
;;;
;;; 37 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;
;;; The original 21 verbs upgraded to full 15-program standard 2026-07-22.
;;; The 16 R7RS-small core predicates (eq? eqv? equal? not null? pair?
;;; boolean? symbol? string? number? procedure? zero? positive? negative?
;;; even? odd?) were authored 2026-08-02 against the live engine.

(dialect :applies ("motoi") :note "Library predicate — 37 verbs.")

(chapter :number "52" :library "predicate" :verb-count 37 :training-eligible #t)

;; ═══ 37 verbs in library predicate ═══

(verb :name "list?" :std "R7RS-small"      :library "predicate" :tier "core" :kind "pure" :signature "(list? x) -> boolean"
  :summary "#t if x is a proper (finite, terminated) list. R7RS §6.4."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(list? (list 1 2 3))" :note "#t — the canonical proper list.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((xs (list 1 2 3))) (and (list? xs) (positive? (length xs))))" :note "#t only if xs is a non-empty proper list.")
    (:dialect "motoi" :tier "expert"       :code "(define (walk-lists thing) (cond ((list? thing) (map walk-lists thing)) (else thing)))\n(walk-lists (list (list 1 2) 'atom (list 3)))" :note "Deep walk. list? gates the recursion — atoms fall through, lists recurse."))
  :provenance "R7RS §6.4; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-load payload) (if (list? payload) (map world/spawn payload) (io/warn \"payload not a proper list\" payload)))\n(safe-load (list 'flower 'stone 'water))"
     :math-program "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))"
     :cs-program "(define (handle . args) (list 'handled args))\n(define (dispatch req) (if (list? req) (apply handle req) (raise (list :kind 'bad-request :got req))))\n(dispatch (list 'get 'user 42))"
     :problem "A world/loader receives a data payload that may be a proper list, an improper list (dotted pair chain), or a scalar. The operator must accept only proper lists before invoking a per-element map."
     :explanation "eng: guards a spawn loop. math: guards a sum. cs: guards a dispatch. Same predicate, three domains."
     :meta "Reach for list? and NOT pair?: pair? admits (1 . 2), which would crash any consumer at the cdr of the dotted end.")
    (:eng "The load log line names the shape: 'payload not a proper list: (1 . 2)'." :math "list? is the characteristic function of the proper-list subset of Pair⋆." :cs "Recursive predicate; O(n); walks the spine to confirm nil-termination."))
  :row-3-dimension (
    (:setup "Shape-classification: is this container well-formed."
     :rungs (
       (:domain "engineering"  :code "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))")
       (:domain "mathematics"  :code "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))")
       (:domain "cs / dispatch" :code "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))"))
     :explanation "Three domains, one shape-check. The predicate transfers because well-formedness is a universal question."
     :meta "Well-formedness predicates transfer to any structural type.")
    (:eng "Validity gates precede every batch operation." :math "Recursive characteristic function on Pair⋆." :cs "Well-formedness checks are the base for safe recursion."))
  :row-4-proof (
    (:eng-program "(define (closed-under-cons? x xs) (if (list? xs) (list? (cons x xs)) #t))\n(and (closed-under-cons? 'a (list 1 2)) (closed-under-cons? 'a '()))"
     :math-program "(define (build-list n f) (map f (iota n)))\n(define (induction-step n) (list? (cons n (build-list n (lambda (i) i)))))\n(and (induction-step 0) (induction-step 1) (induction-step 5))"
     :cs-program "(define (invariant-holds pipeline) (list? (pipeline (list 1 2 3))))\n(invariant-holds (lambda (xs) (map (lambda (x) (* 2 x)) xs)))"
     :claim "list? is closed under cons: cons of anything onto a proper list yields a proper list."
     :invariant "∀ x xs. list?(xs) → list?(cons(x, xs))"
     :meta "Pattern: closure under a constructor. Same claim, three witnesses: an engineering test, a math induction step, a cs pipeline invariant.")
    (:eng "Closure lets constructors chain without re-checking after each cons." :math "The list-type is inductively defined; cons preserves the type." :cs "Closure under constructor is the essence of an inductive-type invariant."))
  :row-5-emergence (
    (:eng-composition "(define (all-lists? xs) (and (list? xs) (fold (lambda (r x) (and r (list? x))) #t xs)))\n(all-lists? (list (list 1) (list 2 3) (list)))"
     :math-composition "(define (nested-list-of-nat? xs) (and (list? xs) (fold (lambda (r x) (and r (or (integer? x) (nested-list-of-nat? x)))) #t xs)))\n(nested-list-of-nat? (list 1 (list 2 3) (list (list 4))))"
     :cs-composition "(define (validate-schema shape data) (cond ((eq? shape 'atom) (not (list? data))) ((eq? shape 'seq) (list? data)) ((and (pair? shape) (list? data)) (every (lambda (s d) (validate-schema s d)) shape data)) (else #f)))\n(validate-schema (list 'atom 'seq 'atom) (list 42 (list 1 2) 'x))"
     :base "list? tests proper list."
     :emergent "Compositions with list? build recursive validators: eng-flat-check, math-nested-typed, cs-schema-walker. All three grow from the same base predicate."
     :meta "Family: recursive-shape validation.")
    (:eng "The pattern grows deep structural checks from shallow ones." :math "The composition realizes a predicate over the free structure Pair⋆." :cs "Recursive validators compose by applying the base predicate at each level."))
)

(verb :name "exact?" :std "R7RS-small"          :library "predicate" :tier "core" :kind "pure" :signature "(exact? x) -> boolean"
  :summary "#t if x uses an exact numeric representation (integer or rational). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact? 3)" :note "#t — integers are exact.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3/4)) (and (exact? x) (not (zero? x))))" :note "Exact and non-zero — safe for exact division.")
    (:dialect "motoi" :tier "expert"       :code "(define (exact-solve n) (list 'exact n))\n(define (numeric-solve n) (list 'approx (exact->inexact n)))\n(define (route-solver n) (if (exact? n) (exact-solve n) (numeric-solve n)))\n(map route-solver (list 3 3.0 1/2 3.14))" :note "Dispatch table: exact values → symbolic solver, inexact → numeric."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (financial-multiply a b) (if (and (exact? a) (exact? b)) (* a b) (error 'shape 'inexact-in-finance)))\n(financial-multiply 19/2 5)"
     :math-program "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))"
     :cs-program "(define (tag-check v) (if (exact? v) :exact-tag :float-tag))\n(tag-check 42)"
     :problem "A financial multiply cannot admit floats — a rounding error becomes a lawsuit. The operator confirms exactness before dispatch."
     :explanation "eng: money math. math: solver routing. cs: representation tag. Same predicate, three domains."
     :meta "Reach for exact? and NOT integer?: integer? admits 3.0. exact? tracks the representation, which is what precision-critical code needs.")
    (:eng "Dispatch log names the branch: 'routed 5 to exact solver'." :math "exact? is the characteristic function of the exact subset of Number." :cs "Primitive; O(1) — reads the numeric tag."))
  :row-3-dimension (
    (:setup "Representation-classification: is this value in the exact-representation class."
     :rungs (
       (:domain "engineering"  :code "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))")
       (:domain "mathematics"  :code "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))")
       (:domain "cs / dispatch" :code "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))"))
     :explanation "Three domains, one representation-check."
     :meta "Representation-class transfers to any domain with distinguishable exact/inexact forms.")
    (:eng "Dispatch-on-representation is a routine hot-path shape." :math "A partition of Number by representation." :cs "Type-tag inspection is O(1) in tagged-value runtimes."))
  :row-4-proof (
    (:eng-program "(define (complementary? n) (or (exact? n) (inexact? n)))\n(and (complementary? 3) (complementary? 3.0) (complementary? 1/2))"
     :math-program "(define (exclusive? n) (not (and (exact? n) (inexact? n))))\n(and (exclusive? 3) (exclusive? 3.0))"
     :cs-program "(define (partition-check ns) (fold (lambda (r n) (and r (or (exact? n) (inexact? n)))) #t ns))\n(partition-check (list 1 2.0 3/4 4.5))"
     :claim "exact? and inexact? are complementary on the numeric domain: every number is exactly one."
     :invariant "∀ n ∈ Number. exact?(n) ⊕ inexact?(n)"
     :meta "Pattern: binary partition. Three witnesses to the same invariant.")
    (:eng "Complementarity means every number routes to exactly one branch." :math "Number is partitioned into exact and inexact classes." :cs "Tagged-value runtimes enforce this at the representation level."))
  :row-5-emergence (
    (:eng-composition "(define (all-exact? xs) (and (list? xs) (fold (lambda (r x) (and r (exact? x))) #t xs)))\n(all-exact? (list 1 2 3/4 5))"
     :math-composition "(define (all-exact? xs) (and (list? xs) (fold (lambda (r x) (and r (exact? x))) #t xs)))\n(define (exact-ring? xs) (and (all-exact? xs) (all-exact? (map (lambda (a) (fold * a xs)) xs))))\n(exact-ring? (list 1/2 2 3))"
     :cs-composition "(define (route-batch xs)\n  (let-values (((exacts inexacts) (partition (lambda (x) (exact? x)) xs)))\n    (list 'exact exacts 'inexact inexacts)))\n(route-batch (list 1 2.0 3/4 4.5))"
     :base "exact? tests representation class."
     :emergent "Compositions with exact? build representation-aware dispatchers: eng-batch-check, math-closed-ring-check, cs-partitioning."
     :meta "Family: representation-typed dispatch.")
    (:eng "Batch representation checks feed pipelines." :math "Closure of the exact class under ring operations is a checkable property." :cs "Partitioning by representation is the base of two-branch pipelines."))
)

(verb :name "inexact?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(inexact? x) -> boolean"
  :summary "#t if x uses an inexact (floating-point) numeric representation. R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(inexact? 3.14)" :note "#t — floats are inexact.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3.14)) (and (inexact? x) (finite? x)))" :note "#t for a well-behaved float (finite + inexact).")
    (:dialect "motoi" :tier "expert"       :code "(define (tolerance-check a b) (if (or (inexact? a) (inexact? b)) (< (abs (- a b)) 1e-9) (= a b)))\n(tolerance-check 3.14159 3.14158999)" :note "Choose exact equality vs. tolerance based on representation."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (fft-ready? xs) (and (list? xs) (fold (lambda (r x) (and r (inexact? x))) #t xs)))\n(fft-ready? (list 1.0 2.0 3.0 4.0))"
     :math-program "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)"
     :cs-program "(define (float-branch v) (if (inexact? v) :ieee-path :exact-path))\n(float-branch 2.71)"
     :problem "An FFT routine expects a list of floats; passing exact rationals crashes on the internal complex-arithmetic layer. The operator confirms inexact representation before FFT."
     :explanation "eng: signal-processing gate. math: equality-vs-tolerance choice. cs: code path selection."
     :meta "Reach for inexact? and NOT real?: real? admits both. inexact? is representation-specific.")
    (:eng "FFT precondition names the shape." :math "inexact? is the characteristic function of the inexact subset of Number." :cs "Primitive; O(1) — numeric tag inspection."))
  :row-3-dimension (
    (:setup "Representation dual of exact?"
     :rungs (
       (:domain "engineering"  :code "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)")
       (:domain "mathematics"  :code "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)")
       (:domain "cs / dispatch" :code "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)"))
     :explanation "Sensor reads, numerical integration, float parsing — all yield inexact by nature."
     :meta "Representation-dual is a universal shape.")
    (:eng "Inexactness announces that measurement uncertainty is involved." :math "IEEE-754 floats are the standard inexact carrier." :cs "The float tag routes to hardware-accelerated paths."))
  :row-4-proof (
    (:eng-program "(define (fft-safe xs) (and (list? xs) (fold (lambda (r x) (and r (inexact? x))) #t xs)))\n(fft-safe (list 1.0 2.0))"
     :math-program "(define (dual-holds n) (not (and (exact? n) (inexact? n))))\n(and (dual-holds 3) (dual-holds 3.0))"
     :cs-program "(define (representative-count ns) (let* ((e (filter exact? ns)) (i (filter inexact? ns))) (= (length ns) (+ (length e) (length i)))))\n(representative-count (list 1 2.0 3/4))"
     :claim "inexact? and exact? are complementary on Number."
     :invariant "∀ n ∈ Number. inexact?(n) ⊕ exact?(n)"
     :meta "Same complementarity as exact?, viewed from the other side.")
    (:eng "Complementarity means routing is deterministic." :math "Dual partition of Number." :cs "Runtime tag routes to exactly one branch."))
  :row-5-emergence (
    (:eng-composition "(define (scale-if-float f xs) (map (lambda (x) (if (inexact? x) (f x) x)) xs))\n(scale-if-float (lambda (x) (* x 100)) (list 1 2.0 3 4.5))"
     :math-composition "(define (float-max xs) (fold (lambda (best x) (if (and (inexact? x) (or (not best) (> x best))) x best)) #f xs))\n(float-max (list 1 2.0 3 4.5))"
     :cs-composition "(define (float-normalize xs) (let ((max (fold (lambda (b x) (if (inexact? x) (max-safe b x) b)) 0 xs))) (map (lambda (x) (if (inexact? x) (/ x max) x)) xs)))\n(float-normalize (list 1.0 2.0 3.0))"
     :base "inexact? tests IEEE-float representation."
     :emergent "Compositions with inexact? build conditional-float pipelines."
     :meta "Family: conditional-float transformation.")
    (:eng "Conditional-transformation pipelines are ubiquitous." :math "Restricting an operation to the inexact subset is a valid partial function." :cs "Type-directed dispatch is a runtime optimization."))
)

(verb :name "integer?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(integer? x) -> boolean"
  :summary "#t if x is an integer value (representation-agnostic — 3.0 counts). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(integer? 42)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 5)) (and (integer? x) (positive? x)))" :note "Positive integer — the safe-index shape.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-index xs i) (and (integer? i) (>= i 0) (< i (length xs)) (list-ref xs i)))\n(safe-index (list 'a 'b 'c) 1)" :note "Guard bounds-check with integer? plus range checks."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-loop-times n body) (if (integer? n) (do ((i 0 (+ i 1))) ((= i n)) (body i)) (error 'shape 'need-integer-count)))\n(safe-loop-times 5 (lambda (i) i))"
     :math-program "(define (factorial n) (if (= n 0) 1 (* n (factorial (- n 1)))))\n(define (dispatch-op n op) (if (integer? n) (op n) (error 'shape 'need-integer)))\n(dispatch-op 4 factorial)"
     :cs-program "(define (parse-index tok) (let ((n (string->number tok))) (if (integer? n) n (raise (list :kind 'bad-index :got tok)))))\n(parse-index \"5\")"
     :problem "A loop count expected an integer; the caller passed 5.0. Should it work? R7RS says integer? admits 5.0 (it's an integer VALUE). Use exact-integer? if you need exact representation."
     :explanation "eng: loop guard. math: op dispatch. cs: parse validation."
     :meta "Reach for integer? and NOT exact-integer?: integer? admits 3.0. Choose based on whether the caller cares about representation.")
    (:eng "Integer-valued numbers admit both 5 and 5.0." :math "integer? is the characteristic function of the integer-valued subset of Number." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Value-class classification, representation-agnostic."
     :rungs (
       (:domain "engineering"  :code "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)")
       (:domain "mathematics"  :code "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)")
       (:domain "cs / dispatch" :code "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)"))
     :explanation "Integer values live in every domain."
     :meta "Value-class is a domain-neutral concept.")
    (:eng "Count guards precede every loop." :math "Membership in ℤ (as a value class)." :cs "Whole-number check is the base of every indexing operation."))
  :row-4-proof (
    (:eng-program "(define (closed-add xs) (and (fold (lambda (r x) (and r (integer? x))) #t xs) (integer? (fold + 0 xs))))\n(closed-add (list 1 2 3 4))"
     :math-program "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)"
     :cs-program "(define (invariant? f xs) (and (fold (lambda (r x) (and r (integer? x))) #t xs) (integer? (fold f 0 xs))))\n(invariant? + (list 1 2 3))"
     :claim "integer? is closed under + and *."
     :invariant "∀ a b. integer?(a) ∧ integer?(b) → integer?(a+b) ∧ integer?(a·b)"
     :meta "Pattern: ring closure. Three witnesses in three domains.")
    (:eng "Closure lets integer-only pipelines chain safely." :math "ℤ is closed under + and ·." :cs "Type-preserving operations don't need mid-pipeline checks."))
  :row-5-emergence (
    (:eng-composition "(define (histogram xs) (let ((h (make-hash-table))) (for-each (lambda (x) (when (integer? x) (hash-table-update! h x (lambda (n) (+ n 1)) (lambda () 0)))) xs) h))\n(histogram (list 1 2 1 3 2.5 1))"
     :math-composition "(define (partition-p n) (if (= n 0) 1 (+ n 1)))\n(define (integer-partition-count n) (if (and (integer? n) (>= n 0)) (partition-p n) 0))\n(integer-partition-count 5)"
     :cs-composition "(define (index-map xs) (let loop ((xs xs) (i 0) (acc '())) (cond ((null? xs) (reverse acc)) ((integer? i) (loop (cdr xs) (+ i 1) (cons (cons i (car xs)) acc))))))\n(index-map (list 'a 'b 'c))"
     :base "integer? tests whole-value shape."
     :emergent "Compositions with integer? build tabulation and enumeration pipelines."
     :meta "Family: whole-value tabulation.")
    (:eng "Tabulation is the base for reports and dashboards." :math "Enumeration over integer classes generates combinatorial structures." :cs "Indexed transformations produce named collections."))
)

(verb :name "rational?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(rational? x) -> boolean"
  :summary "#t if x is a rational value (integer or ratio). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(rational? 1/2)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3/4)) (and (rational? x) (not (zero? x))))" :note "Nonzero rational — safe divisor.")
    (:dialect "motoi" :tier "expert"       :code "(define (item-price item) (car item))\n(define (cost-in-rationals items) (fold + 0 (filter rational? (map item-price items))))\n(cost-in-rationals (list (list 1/2) (list 3.14) (list 2/3)))" :note "Financial pipeline drops any non-rational entry."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-divide a b) (if (and (rational? a) (rational? b) (not (zero? b))) (/ a b) (error 'shape 'divide-guard)))\n(safe-divide 3 2)"
     :math-program "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)"
     :cs-program "(define (parse-rat-or-fail s) (let ((n (string->number s))) (if (rational? n) n (raise (list :kind 'bad-rat :got s)))))\n(parse-rat-or-fail \"3/4\")"
     :problem "Financial code must reject irrationals and infinities; only rationals fit the domain."
     :explanation "eng: money math. math: finite-rational check. cs: parse validation."
     :meta "Reach for rational? and NOT real?: real? admits π and inf. rational? excludes both.")
    (:eng "Finance guards reject non-rationals." :math "rational? is the characteristic function of ℚ within the numeric tower." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Value-class check for expressible-as-ratio."
     :rungs (
       (:domain "engineering"  :code "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)")
       (:domain "mathematics"  :code "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)")
       (:domain "cs / dispatch" :code "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)"))
     :explanation "Rationals fit finance, linear algebra, and structured parsing."
     :meta "Value-class transfers to any rational-only domain.")
    (:eng "Financial safety." :math "Membership in ℚ." :cs "Representable-in-decimal without loss."))
  :row-4-proof (
    (:eng-program "(define (closed-under-add? a b) (and (rational? a) (rational? b) (rational? (+ a b))))\n(closed-under-add? 1/2 1/3)"
     :math-program "(define (field-holds? a b) (and (rational? a) (rational? b) (not (zero? b)) (rational? (/ a b))))\n(field-holds? 3 4)"
     :cs-program "(define (pipeline-preserves-rat? f a) (and (rational? a) (rational? (f a))))\n(pipeline-preserves-rat? (lambda (x) (* x 2)) 3/5)"
     :claim "rational? is closed under +, -, *, and / (with non-zero divisor)."
     :invariant "∀ a b ∈ ℚ, b ≠ 0. rational?(a op b) for op ∈ {+, -, *, /}"
     :meta "Pattern: field closure. Three witnesses.")
    (:eng "Financial closure means pipelines stay in ℚ." :math "ℚ is a field." :cs "Type-preserving arithmetic is a pipeline invariant."))
  :row-5-emergence (
    (:eng-composition "(define (rational-sum xs) (fold + 0 (filter rational? xs)))\n(rational-sum (list 1 2/3 3.14 4/7))"
     :math-composition "(define (mediant a b) (if (and (rational? a) (rational? b)) (/ (+ (numerator a) (numerator b)) (+ (denominator a) (denominator b))) (error 'shape 'mediant-needs-rationals)))\n(mediant 1/2 1/3)"
     :cs-composition "(define (rat-schema-check v) (cond ((rational? v) :ok) ((real? v) :out-of-rat) (else :not-num)))\n(rat-schema-check 3.14)"
     :base "rational? tests ratio-representable shape."
     :emergent "Compositions with rational? build financial safety, mediant construction, schema-validation."
     :meta "Family: rational-arithmetic safety.")
    (:eng "Financial pipelines depend on rational safety." :math "Farey-sequence mediants use rational-only arithmetic." :cs "Schema validation grades by tightness of the value class."))
)

(verb :name "real?" :std "R7RS-small"           :library "predicate" :tier "core" :kind "pure" :signature "(real? x) -> boolean"
  :summary "#t if x is a real number (integer, rational, or float). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(real? 3.14)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3.14)) (and (real? x) (not (nan? x))))" :note "Real and not-NaN — a proper number.")
    (:dialect "motoi" :tier "expert"       :code "(define (physics-quantity v) (if (real? v) v (error 'shape 'need-real)))\n(map physics-quantity (list 3 3.14 22/7))" :note "Physics gate — every real, no complex."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (physics/accel-input v) (if (real? v) v (raise (list :kind 'shape :got v))))\n(physics/accel-input 9.8)"
     :math-program "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)"
     :cs-program "(define (numeric-parse-or-raise s) (let ((n (string->number s))) (if (real? n) n (raise (list :kind 'bad-num :got s)))))\n(numeric-parse-or-raise \"3.14\")"
     :problem "A physics function needs a real quantity; complex numbers are not physically meaningful for this call. Real? admits the intended set."
     :explanation "eng: physics gate. math: comparable check. cs: parse ok."
     :meta "Reach for real? and NOT complex?: complex? admits imaginary numbers which fail the physical interpretation.")
    (:eng "Physics inputs cannot be complex." :math "real? is the characteristic function of ℝ within Number." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Value-class check for placement on the number line."
     :rungs (
       (:domain "engineering"  :code "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)")
       (:domain "mathematics"  :code "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)")
       (:domain "cs / dispatch" :code "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)"))
     :explanation "Every real-valued signal, limit, or parsed number."
     :meta "Ordering on ℝ makes real? the shape for comparison-based algorithms.")
    (:eng "Sensor signals are real by nature." :math "ℝ is totally ordered." :cs "Real-tagged values support < and > without extra checks."))
  :row-4-proof (
    (:eng-program "(define (sort-safely xs) (if (fold (lambda (x r) (and r (real? x))) #t xs) (sort xs <) (error 'shape 'not-all-real)))\n(sort-safely (list 3.1 1 2.5))"
     :math-program "(define (rat-implies-real? xs) (fold (lambda (x r) (and r (if (rational? x) (real? x) #t))) #t xs))\n(rat-implies-real? (list 1/2 3 4.5))"
     :cs-program "(define (dual-check n) (or (real? n) (not (rational? n))))\n(and (dual-check 3) (dual-check \"not-a-num\"))"
     :claim "rational? ⊂ real?: every rational is real."
     :invariant "∀ n. rational?(n) → real?(n)"
     :meta "Pattern: subset containment. Three domains show the same containment.")
    (:eng "Real superset means any rational-required op works with real inputs." :math "ℚ ⊂ ℝ." :cs "Type widening preserves query results."))
  :row-5-emergence (
    (:eng-composition "(define (stats-summary xs) (let ((reals (filter real? xs))) (if (null? reals) 'none (list :count (length reals) :min (fold min (car reals) reals) :max (fold max (car reals) reals)))))\n(stats-summary (list 3 2.5 'hey 7 1.1))"
     :math-composition "(define (real-line-position x) (cond ((not (real? x)) :off-line) ((negative? x) :left) ((positive? x) :right) (else :zero)))\n(real-line-position -2.5)"
     :cs-composition "(define (real-schema data) (map (lambda (v) (cons (real? v) v)) data))\n(real-schema (list 3 'a 2.5))"
     :base "real? tests placement on the number line."
     :emergent "Compositions build statistics, positional queries, schema tags."
     :meta "Family: ordered-value operations.")
    (:eng "Stats routines assume real-valued input." :math "Sign and ordering are queryable properties of ℝ." :cs "Schema tags per element enable heterogeneous data pipelines."))
)

(verb :name "complex?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(complex? x) -> boolean"
  :summary "#t if x is any number (real, rational, integer, or complex). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(complex? 3)" :note "#t — every number is complex? in R7RS.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3)) (and (complex? x) (not (complex? #f))))" :note "Actually-complex — has an imaginary part.")
    (:dialect "motoi" :tier "expert"       :code "(define (is-any-num? v) (complex? v))\n(filter is-any-num? (list 3 'x 3.14 \"hi\"))" :note "Universal numeric gate: keeps every numeric flavor."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (numeric-dispatch v) (if (complex? v) 'proceed 'skip))\n(map numeric-dispatch (list 3 'a 3.14 (list)))"
     :math-program "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))"
     :cs-program "(define (numeric-only xs) (filter complex? xs))\n(numeric-only (list 3 'x 3.14 \"hi\"))"
     :problem "A downstream numeric op accepts any flavor of number; the operator gates on complex? to filter out non-numeric noise before dispatch."
     :explanation "eng: general numeric gate. math: hierarchy classification. cs: filter."
     :meta "Reach for complex? when you want ANY number and don't care about the specific class.")
    (:eng "General numeric gate: broad but honest." :math "complex? is the top of the numeric tower." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Umbrella check for any numeric shape."
     :rungs (
       (:domain "engineering"  :code "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))")
       (:domain "mathematics"  :code "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))")
       (:domain "cs / dispatch" :code "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))"))
     :explanation "Anything numeric — from FFT bins to parsed literals."
     :meta "Universal numeric umbrella.")
    (:eng "Broad numeric acceptance is often desired." :math "ℂ contains ℝ contains ℚ contains ℤ." :cs "Numeric tagging enables uniform dispatch."))
  :row-4-proof (
    (:eng-program "(define (widening-holds? xs) (fold (lambda (r x) (and r (if (integer? x) (complex? x) #t))) #t xs))\n(widening-holds? (list 1 2 3))"
     :math-program "(define (tower-holds? n) (or (not (rational? n)) (complex? n)))\n(and (tower-holds? 1/2) (tower-holds? 3))"
     :cs-program "(define (containment-check ns) (equal? (length (filter complex? ns)) (length (filter (lambda (n) (or (integer? n) (rational? n) (real? n) (complex? n))) ns))))\n(containment-check (list 1 2/3 3.14))"
     :claim "integer? ⊂ rational? ⊂ real? ⊂ complex?."
     :invariant "∀ n. integer?(n) → rational?(n) → real?(n) → complex?(n)"
     :meta "Pattern: nested subset chain.")
    (:eng "Chain widening: any narrower class satisfies broader ones." :math "The numeric tower is a chain of inclusions." :cs "Type widening never fails."))
  :row-5-emergence (
    (:eng-composition "(define (numeric-only xs) (filter complex? xs))\n(numeric-only (list 3 'x 3.14))"
     :math-composition "(define (num-partition ns) (list :int (filter integer? ns) :rat (filter (lambda (n) (and (rational? n) (not (integer? n)))) ns) :real (filter (lambda (n) (and (real? n) (not (rational? n)))) ns)))\n(num-partition (list 1 1/2 3.14))"
     :cs-composition "(define (parse-any-num src) (let ((n (string->number src))) (if (complex? n) n :parse-fail)))\n(parse-any-num \"3.14\")"
     :base "complex? tests any-numeric shape."
     :emergent "Umbrella filter, class partition, permissive parser."
     :meta "Family: umbrella-typed pipelines.")
    (:eng "Umbrella filters preserve permissive behavior." :math "The numeric tower supports classification." :cs "Permissive parsers admit every well-formed number."))
)

(verb :name "exact-integer?" :std "R7RS-small"  :library "predicate" :tier "core" :kind "pure" :signature "(exact-integer? x) -> boolean"
  :summary "#t if x is both integer? and exact?. R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact-integer? 42)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(exact-integer? 3.0)" :note "#t in Motoi. R7RS §6.2.6 says #f, because 3.0 is integer-valued but inexact — and that is the answer to give in any other Scheme. Motoi cannot distinguish them: 3 and 3.0 are the same JavaScript double, so no predicate here can tell exact 3 from inexact 3.0. Known representation divergence; do not rely on exactness tests round-tripping.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-array-ref xs i) (if (exact-integer? i) (list-ref xs i) (error 'shape 'index-must-be-exact)))\n(safe-array-ref (list 'a 'b 'c) 1)" :note "Strict indexing: only exact integers as array indices."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-index xs i) (if (exact-integer? i) (list-ref xs i) (error 'shape 'need-exact-int)))\n(safe-index (list 'a 'b 'c) 1)"
     :math-program "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)"
     :cs-program "(define (bit-shift-left n k) (* n (expt 2 k)))\n(define (bit-op n) (if (exact-integer? n) (bit-shift-left n 1) (error 'shape 'need-exact-int)))\n(bit-op 7)"
     :problem "Array indices and bit operations demand exact integers — 3.0 might be equal to 3 but the hardware wants a machine integer."
     :explanation "eng: array indexing. math: recursive factorial (needs integer termination). cs: bit-shift needs word-value."
     :meta "Reach for exact-integer? and NOT integer?: integer? admits 3.0. exact-integer? is the strict machine-int check.")
    (:eng "Strict integer for hardware-adjacent operations." :math "The exact-integer set is ℤ with tagged representation." :cs "Machine-word check is one tag comparison."))
  :row-3-dimension (
    (:setup "Strict tag + value check."
     :rungs (
       (:domain "engineering"  :code "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)")
       (:domain "mathematics"  :code "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)")
       (:domain "cs / dispatch" :code "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)"))
     :explanation "Strict integer domains: indexing, induction, bit-ops."
     :meta "Strict tag check is universal to hardware-adjacent code.")
    (:eng "Hardware operations need exact-tagged inputs." :math "Peano-style recursion requires exact zero and successor." :cs "Bit operations produce exact integers by construction."))
  :row-4-proof (
    (:eng-program "(define (equivalent? n) (equal? (exact-integer? n) (and (exact? n) (integer? n))))\n(and (equivalent? 3) (equivalent? 3.0) (equivalent? 1/2))"
     :math-program "(define (subset? n) (or (not (exact-integer? n)) (and (exact? n) (integer? n))))\n(and (subset? 3) (subset? 3.0))"
     :cs-program "(define (impl-check ns) (fold (lambda (r n) (and r (equal? (exact-integer? n) (and (exact? n) (integer? n))))) #t ns))\n(impl-check (list 3 3.0 1/2 42))"
     :claim "exact-integer? ⇔ (exact? ∧ integer?)."
     :invariant "∀ n. exact-integer?(n) ⇔ (exact?(n) ∧ integer?(n))"
     :meta "Pattern: conjunctive definition. Three witnesses.")
    (:eng "Composition of predicates is a valid predicate." :math "Intersection of two subsets." :cs "Two tag checks combined."))
  :row-5-emergence (
    (:eng-composition "(define (indices-of xs pred) (let loop ((xs xs) (i 0) (acc '())) (cond ((null? xs) (reverse acc)) ((and (exact-integer? i) (pred (car xs))) (loop (cdr xs) (+ i 1) (cons i acc))) (else (loop (cdr xs) (+ i 1) acc)))))\n(indices-of (list 'a 'b 'a 'c) (lambda (x) (eq? x 'a)))"
     :math-composition "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(define (binomial n k) (if (and (exact-integer? n) (exact-integer? k) (>= n k)) (/ (fac n) (* (fac k) (fac (- n k)))) 0))\n(binomial 5 2)"
     :cs-composition "(define (bit-shift-left n k) (* n (expt 2 k)))\n(define (bit-or a b) (let loop ((a a) (b b) (bit 1) (acc 0)) (if (and (= a 0) (= b 0)) acc (loop (quotient a 2) (quotient b 2) (* bit 2) (if (or (odd? a) (odd? b)) (+ acc bit) acc)))))\n(define (bitset xs) (fold (lambda (x b) (if (exact-integer? x) (bit-or b (bit-shift-left 1 x)) b)) 0 xs))\n(bitset (list 0 2 3))"
     :base "exact-integer? tests machine-integer shape."
     :emergent "Compositions build index-lists, exact combinatorics, bitsets."
     :meta "Family: hardware-adjacent integer operations.")
    (:eng "Index tracking assumes exact counters." :math "Combinatorial functions demand exact integers." :cs "Bitsets are one-bit-per-integer encodings."))
)

(verb :name "finite?" :std "R7RS-small"         :library "predicate" :tier "core" :kind "pure" :signature "(finite? x) -> boolean"
  :summary "#t if x is a finite real (not +inf.0, -inf.0, or +nan.0). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(finite? 3.14)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3.14)) (and (real? x) (finite? x)))" :note "Real and finite — safe for arithmetic.")
    (:dialect "motoi" :tier "expert"       :code "(define (fft-guard xs) (if (fold (lambda (r x) (and r (finite? x))) #t xs) (fft xs) (error 'shape 'not-finite)))" :note "Guard signal processing — no inf/nan in the buffer."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (fft-safe xs) (fold (lambda (r x) (and r (finite? x))) #t xs))\n(fft-safe (list 1.0 2.0 3.0))"
     :math-program "(define (limit-attained? x) (finite? x))\n(limit-attained? 3.14)"
     :cs-program "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)"
     :problem "IEEE ±inf and NaN crash downstream: FFT loses convergence, JSON encoders raise, chart libraries flatten. Guard before dispatch."
     :explanation "eng: fft guard. math: limit convergence test. cs: JSON-safe check."
     :meta "Reach for finite? and NOT real?: real? admits inf and nan. finite? is the useful-value check.")
    (:eng "IEEE inf/nan corruption is silent until it lands." :math "finite? is the characteristic function of ℝ excluding infinities and NaN." :cs "Primitive; O(1) — IEEE class inspection."))
  :row-3-dimension (
    (:setup "IEEE-well-formedness check."
     :rungs (
       (:domain "engineering"  :code "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)")
       (:domain "mathematics"  :code "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)")
       (:domain "cs / dispatch" :code "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)"))
     :explanation "Well-formed real from sensor, integrator, parser."
     :meta "IEEE well-formedness is universal.")
    (:eng "Sensor edge cases produce inf/nan; guard them." :math "The finite subset supports all arithmetic without pollution." :cs "IEEE-754 non-finite values need explicit handling."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (finite-not-inf? n) (implies (finite? n) (not (infinite? n))))\n(and (finite-not-inf? 3.0) (finite-not-inf? +inf.0))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (partition-holds? n) (implies (finite? n) (and (not (infinite? n)) (not (nan? n)))))\n(and (partition-holds? 3.0) (partition-holds? +nan.0))"
     :cs-program "(define (mut-exclusive? n) (= 1 (+ (if (finite? n) 1 0) (if (infinite? n) 1 0) (if (nan? n) 1 0))))\n(mut-exclusive? 3.14)"
     :claim "finite?, infinite?, and nan? partition the IEEE reals."
     :invariant "∀ n ∈ Real. exactly one of finite?(n), infinite?(n), nan?(n)"
     :meta "Pattern: three-way partition. Three witnesses.")
    (:eng "Exactly-one-of routing is deterministic." :math "IEEE-754 classifies each value into one of five classes (normal, subnormal, zero, inf, nan) — Motoi merges the finite ones." :cs "Class inspection returns exactly one tag."))
  :row-5-emergence (
    (:eng-composition "(define (clean-signal xs) (filter finite? xs))\n(clean-signal (list 1.0 +inf.0 2.0 +nan.0 3.0))"
     :math-composition "(define (converges? seq) (finite? (fold (lambda (a b) (if (and (finite? a) (finite? b)) (+ a b) +nan.0)) 0 seq)))\n(converges? (list 1.0 0.5 0.25 0.125))"
     :cs-composition "(define (normalize-json xs) (map (lambda (x) (if (finite? x) x 'null)) xs))\n(normalize-json (list 1.0 +inf.0 3.14))"
     :base "finite? tests IEEE well-formedness."
     :emergent "Compositions build signal cleaners, convergence tests, JSON normalizers."
     :meta "Family: IEEE-safe pipelines.")
    (:eng "Cleaning signals is a pre-dispatch discipline." :math "Convergence is a finite-sum question." :cs "JSON encoders demand finite values."))
)

(verb :name "infinite?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(infinite? x) -> boolean"
  :summary "#t if x is +inf.0 or -inf.0. R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(infinite? +inf.0)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x +inf.0)) (or (infinite? x) (nan? x)))" :note "Non-finite — includes both extremes.")
    (:dialect "motoi" :tier "expert"       :code "(define (saturation-detect xs) (any infinite? xs))\n(saturation-detect (list 1.0 +inf.0 3.0))" :note "Detect overflow in a numeric pipeline."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (overflow-flag xs) (if (any infinite? xs) 'overflow 'ok))\n(overflow-flag (list 3.0 +inf.0))"
     :math-program "(define (divergence-flag seq) (if (infinite? (fold + 0 seq)) 'diverges 'converges))\n(divergence-flag (list 1e300 1e300 1e300))"
     :cs-program "(define (limit-hit? v) (or (infinite? v) (nan? v)))\n(limit-hit? +inf.0)"
     :problem "Overflow in numeric computation manifests as +inf.0. Detect it explicitly rather than silently propagating."
     :explanation "eng: overflow. math: divergence. cs: general limit hit."
     :meta "Reach for infinite? and NOT (not (finite?)): the negation admits NaN too. infinite? is precise.")
    (:eng "Overflow detection is a value question." :math "±∞ signals numerical divergence." :cs "IEEE ±inf is a specific tag class."))
  :row-3-dimension (
    (:setup "Limit-value classification."
     :rungs (
       (:domain "engineering"  :code "(define (divergence-flag seq) (if (infinite? (fold + 0 seq)) 'diverges 'converges))\n(divergence-flag (list 1e300 1e300 1e300))")
       (:domain "mathematics"  :code "(define (divergence-flag seq) (if (infinite? (fold + 0 seq)) 'diverges 'converges))\n(divergence-flag (list 1e300 1e300 1e300))")
       (:domain "cs / dispatch" :code "(infinite? (string->number \"1e400\"))"))
     :explanation "Any limit or overflow reveals infinite?."
     :meta "Limit sentinel is a universal shape.")
    (:eng "Multiplicative accumulators overflow to inf." :math "Limits at infinity produce infinite? values." :cs "Parsing very-large literals yields inf."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (finite-complement? n) (implies (infinite? n) (not (finite? n))))\n(and (finite-complement? +inf.0) (finite-complement? 3.0))"
     :math-program "(define (sign-preserving? n) (if (infinite? n) (or (positive? n) (negative? n)) #t))\n(and (sign-preserving? +inf.0) (sign-preserving? -inf.0))"
     :cs-program "(define (num-of-inf ns) (length (filter infinite? ns)))\n(num-of-inf (list 1.0 +inf.0 -inf.0 2.0))"
     :claim "infinite? implies not finite? and not nan?."
     :invariant "∀ n. infinite?(n) → ¬finite?(n) ∧ ¬nan?(n)"
     :meta "Pattern: mutually exclusive class.")
    (:eng "Class exclusion means one branch fires." :math "±∞ have signed identity." :cs "Counting values by tag is a common metric."))
  :row-5-emergence (
    (:eng-composition "(define (saturation-report xs) (list :count (length (filter infinite? xs)) :any? (any infinite? xs)))\n(saturation-report (list 1.0 +inf.0 2.0))"
     :math-composition "(define (bounded-monoid xs) (if (any infinite? xs) 'unbounded (fold + 0 xs)))\n(bounded-monoid (list 1 2 3))"
     :cs-composition "(define (clip-infs xs cap) (map (lambda (x) (if (infinite? x) (if (positive? x) cap (- cap)) x)) xs))\n(clip-infs (list 1.0 +inf.0 -inf.0) 1e6)"
     :base "infinite? tests the ±∞ sentinel."
     :emergent "Compositions build saturation reports, boundedness checks, clipping."
     :meta "Family: numeric-limit management.")
    (:eng "Saturation is a common pipeline flag." :math "Boundedness is a mathematical property, checkable at the boundary." :cs "Clipping is a defensive pattern against sensor overflow."))
)

(verb :name "nan?" :std "R7RS-small"            :library "predicate" :tier "core" :kind "pure" :signature "(nan? x) -> boolean"
  :summary "#t if x is +nan.0 (an IEEE Not-a-Number). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(nan? +nan.0)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x +nan.0)) (or (nan? x) (not (real? x))))" :note "Not-a-real: NaN or not a number at all.")
    (:dialect "motoi" :tier "expert"       :code "(define (scrub-nans xs) (filter (lambda (x) (not (nan? x))) xs))\n(scrub-nans (list 1.0 +nan.0 2.0))" :note "Remove NaN corruption from a numeric buffer."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-divide a b) (let ((r (/ a b))) (if (nan? r) 'nan-detected r)))\n(safe-divide 0.0 0.0)"
     :math-program "(define (undefined-flag x) (if (nan? x) 'undefined 'defined))\n(undefined-flag +nan.0)"
     :cs-program "(define (json-serialize v) (if (nan? v) \"null\" (number->string v)))\n(json-serialize +nan.0)"
     :problem "NaN silently propagates through arithmetic; every downstream op inherits the NaN. Detect at the source, don't chase it downstream."
     :explanation "eng: divide-by-zero. math: undefined-value marker. cs: JSON has no NaN."
     :meta "Reach for nan? and NOT (= x x): NaN is unique in that (= +nan.0 +nan.0) is #f. Use nan? for a definitive check.")
    (:eng "NaN detection at source prevents corruption downstream." :math "NaN represents mathematically undefined results (0/0, log(-1))." :cs "JSON, YAML, and most serializers have no NaN — must map to null."))
  :row-3-dimension (
    (:setup "IEEE-undefined check."
     :rungs (
       (:domain "engineering"  :code "(define (undefined-flag x) (if (nan? x) 'undefined 'defined))\n(undefined-flag +nan.0)")
       (:domain "mathematics"  :code "(nan? (sqrt -1.0))")
       (:domain "cs / dispatch" :code "(nan? +nan.0)"))
     :explanation "Every mathematically undefined result surfaces as NaN in IEEE arithmetic."
     :meta "Undefined-marker is a universal shape.")
    (:eng "Divide-by-zero, sqrt of negative, log of zero — all yield NaN." :math "IEEE-754 defines NaN as the undefined-value sentinel." :cs "NaN is its own equivalence class (violates reflexivity)."))
  :row-4-proof (
    (:eng-program "(define (self-not-equal? x) (if (nan? x) (not (= x x)) #t))\n(and (self-not-equal? +nan.0) (self-not-equal? 3.14))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (partition-check n) (implies (nan? n) (and (not (finite? n)) (not (infinite? n)))))\n(and (partition-check +nan.0) (partition-check 3.0))"
     :cs-program "(define (identify-nans ns) (map (lambda (n) (cons n (nan? n))) ns))\n(identify-nans (list 1.0 +nan.0 3.0))"
     :claim "NaN violates reflexivity: (= x x) is #f when x is NaN."
     :invariant "∀ x. nan?(x) ⇒ ¬(= x x)"
     :meta "Pattern: reflexivity failure — the definitional weirdness of NaN.")
    (:eng "Equality-with-self is the classic NaN detection reflex." :math "IEEE mandates non-reflexivity of NaN." :cs "Runtime tests use nan? because = returns false."))
  :row-5-emergence (
    (:eng-composition "(define (clean-buffer xs) (map (lambda (x) (if (nan? x) 0.0 x)) xs))\n(clean-buffer (list 1.0 +nan.0 2.0))"
     :math-composition "(define (mean-ignore-nan xs) (let ((clean (filter (lambda (x) (not (nan? x))) xs))) (if (null? clean) +nan.0 (/ (fold + 0 clean) (length clean)))))\n(mean-ignore-nan (list 1.0 +nan.0 3.0))"
     :cs-composition "(define (nan-report xs) (list :count (length (filter nan? xs)) :indices (let loop ((xs xs) (i 0) (acc '())) (cond ((null? xs) (reverse acc)) ((nan? (car xs)) (loop (cdr xs) (+ i 1) (cons i acc))) (else (loop (cdr xs) (+ i 1) acc))))))\n(nan-report (list 1.0 +nan.0 3.0 +nan.0))"
     :base "nan? tests IEEE undefined-value."
     :emergent "Compositions build corruption-cleanup pipelines."
     :meta "Family: NaN-safe numeric pipelines.")
    (:eng "Cleanup replaces NaN with a safe default." :math "Aggregations must decide whether to skip or fail on NaN." :cs "Diagnostic reports name where NaN entered the pipeline."))
)

(verb :name "eof-object?" :std "R7RS-small"     :library "predicate" :tier "core" :kind "pure" :signature "(eof-object? x) -> boolean"
  :summary "#t if x is the EOF sentinel (from read/read-char at stream end). R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(eof-object? (read-char (open-input-string \"\")))" :note "#t — empty stream yields EOF at first read.")
    (:dialect "motoi" :tier "intermediate" :code "(let* ((port (open-input-string \"a\")) (c (read-char port))) (or (eof-object? c) (char? c)))" :note "Either EOF or a character; nothing else.")
    (:dialect "motoi" :tier "expert"       :code "(define (read-all p) (let loop ((acc '())) (let ((line (read-line p))) (if (eof-object? line) (reverse acc) (loop (cons line acc))))))\n(read-all (open-input-string \"a\\nb\\nc\"))" :note "EOF is the loop terminator for streamed I/O."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-getline p) (let ((ln (read-line p))) (if (eof-object? ln) 'done ln)))\n(safe-getline (open-input-string \"hello\"))"
     :math-program "(define (stream-fold p f seed) (let loop ((acc seed)) (let ((v (read-char p))) (if (eof-object? v) acc (loop (f acc 1))))))\n(stream-fold (open-input-string \"123\") + 0)"
     :cs-program "(define (char-count p) (let loop ((acc '())) (let ((t (read-char p))) (if (eof-object? t) (reverse acc) (loop (cons t acc))))))\n(length (char-count (open-input-string \"abc\")))"
     :problem "A read loop must terminate when input ends. eof-object? tells you when to stop — every other value is real data."
     :explanation "eng: getline. math: fold over stream. cs: token parser."
     :meta "Reach for eof-object? — no sibling. EOF is a singleton, not a character or a value.")
    (:eng "Line readers use EOF as the termination signal." :math "Fold over a stream terminates at EOF." :cs "Token parsers read until EOF."))
  :row-3-dimension (
    (:setup "Stream-terminator check."
     :rungs (
       (:domain "engineering"  :code "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)")
       (:domain "mathematics"  :code "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)")
       (:domain "cs / dispatch" :code "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)"))
     :explanation "Every stream — log, sequence, parser — signals its end with EOF."
     :meta "Stream terminator is a universal shape.")
    (:eng "Log reading needs an end marker." :math "Finite streams terminate; EOF is the marker." :cs "Parsers read until the token supply ends."))
  :row-4-proof (
    (:eng-program "(define (never-a-char? p) (let loop ((n 5)) (let ((c (read-char p))) (if (eof-object? c) #t (loop (- n 1))))))\n(never-a-char? (open-input-string \"a\"))"
     :math-program "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)"
     :cs-program "(define (once-emitted p) (let* ((eof (read-char (open-input-string \"\"))) (again (read-char (open-input-string \"\")))) (and (eof-object? eof) (eof-object? again))))\n(once-emitted #f)"
     :claim "eof-object? is a singleton — there is only one EOF value."
     :invariant "∀ p q — end-of-stream. eof?(p) ∧ eof?(q) ⇒ eq?(p, q)"
     :meta "Pattern: singleton object.")
    (:eng "Singleton terminator means comparison is a tag check." :math "The EOF set has cardinality 1." :cs "Singleton objects support eq? identity."))
  :row-5-emergence (
    (:eng-composition "(define (all-lines p) (let loop ((acc '())) (let ((l (read-line p))) (if (eof-object? l) (reverse acc) (loop (cons l acc))))))\n(all-lines (open-input-string \"a\\nb\\nc\"))"
     :math-composition "(define (stream-char-sum p) (let loop ((s 0)) (let ((c (read-char p))) (if (eof-object? c) s (loop (+ s 1))))))\n(stream-char-sum (open-input-string \"1 2 3 4\"))"
     :cs-composition "(define (char-count p) (let loop ((n 0)) (let ((c (read-char p))) (if (eof-object? c) n (loop (+ n 1))))))\n(char-count (open-input-string \"abc\"))"
     :base "eof-object? tests EOF sentinel."
     :emergent "Compositions build line readers, stream aggregators, token counters."
     :meta "Family: streaming aggregation.")
    (:eng "Line readers are the canonical text-processing entry point." :math "Streaming folds compute aggregates without materializing all elements." :cs "Token counters yield lexer statistics."))
)

(verb :name "input-port?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(input-port? p) -> boolean"
  :summary "#t if p is a read-capable port. R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(input-port? (open-input-string \"x\"))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-input-string \"x\"))) (and (input-port? p) (not (output-port? p))))" :note "Read-only port.")
    (:dialect "motoi" :tier "expert"       :code "(define (with-input-port p thunk) (if (input-port? p) (thunk p) (error 'shape 'need-input-port)))\n(with-input-port (open-input-string \"a\") read-char)" :note "Higher-order I/O helper — guards direction before dispatch."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-read-char p) (if (input-port? p) (read-char p) (error 'shape 'not-a-read-port)))\n(safe-read-char (open-input-string \"42\"))"
     :math-program "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))"
     :cs-program "(define (validate-capability p) (if (input-port? p) 'read-cap 'no-read-cap))\n(validate-capability (open-input-string \"x\"))"
     :problem "A read verb that expects an input-port refuses to run against an output-port, preventing a confusing exception deep in the read machinery."
     :explanation "eng: safe-read. math: dispatch by direction. cs: capability check."
     :meta "Reach for input-port? and NOT port?: port? admits output ports too, which would cause read to fail deeper.")
    (:eng "Direction check names the boundary error." :math "input-port? is the characteristic function of the read-capable subset." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Direction-typing on handles."
     :rungs (
       (:domain "engineering"  :code "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))")
       (:domain "mathematics"  :code "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))")
       (:domain "cs / dispatch" :code "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))"))
     :explanation "Read direction on a file, a string, or a pipe."
     :meta "Direction-typed handles are universal.")
    (:eng "Read direction is a boundary predicate." :math "Reader ⊆ Port." :cs "Capability typing supports safe upcasting."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (imp-port? p) (implies (input-port? p) (port? p)))\n(and (imp-port? (open-input-string \"x\")) (imp-port? (open-output-string)))"
     :math-program "(define (sub-holds? p) (or (not (input-port? p)) (port? p)))\n(sub-holds? (open-input-string \"x\"))"
     :cs-program "(define (union-check ps) (fold (lambda (r p) (and r (or (input-port? p) (not (input-port? p))))) #t ps))\n(union-check (list (open-input-string \"a\") (open-output-string)))"
     :claim "input-port? ⊂ port?: every input-port is a port."
     :invariant "∀ p. input-port?(p) → port?(p)"
     :meta "Pattern: subset containment.")
    (:eng "Sub-class admission is a universal I/O rule." :math "Reader ⊂ Port ⊃ Writer." :cs "Type widening preserves capability."))
  :row-5-emergence (
    (:eng-composition "(define (read-all-if-input p) (if (input-port? p) (let loop ((acc '())) (let ((v (read-char p))) (if (eof-object? v) (reverse acc) (loop (cons v acc))))) 'not-input))\n(read-all-if-input (open-input-string \"abc\"))"
     :math-composition "(define (read-all-if-input p) (if (input-port? p) (let loop ((acc '())) (let ((v (read-char p))) (if (eof-object? v) (reverse acc) (loop (cons v acc))))) 'not-input))\n(define (combine-readers ps) (fold (lambda (p acc) (if (input-port? p) (append acc (read-all-if-input p)) acc)) '() ps))\n(combine-readers (list (open-input-string \"ab\") (open-input-string \"cd\")))"
     :cs-composition "(define (with-input-safely p thunk fallback) (if (input-port? p) (thunk p) (fallback)))\n(with-input-safely (open-input-string \"x\") read-char (lambda () 'none))"
     :base "input-port? tests read capability."
     :emergent "Compositions build read-all pipelines, reader unions, safe-invocation."
     :meta "Family: safe-input.")
    (:eng "Read-all pipelines are the base of streaming aggregation." :math "Reader unions combine sources." :cs "Safe-invocation with fallback is a defensive pattern."))
)

(verb :name "output-port?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(output-port? p) -> boolean"
  :summary "#t if p is a write-capable port. R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(output-port? (open-output-string))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string))) (and (output-port? p) (not (input-port? p))))" :note "Write-only port.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-write p v) (if (output-port? p) (write v p) (error 'shape 'need-output-port)))\n(safe-write (open-output-string) 42)" :note "Guard write direction before dispatch."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-log p msg) (if (output-port? p) (begin (display msg p) (newline p)) (error 'shape 'need-write-port)))\n(safe-log (open-output-string) \"hello\")"
     :math-program "(define (direction-of p) (cond ((and (output-port? p) (input-port? p)) :duplex) ((output-port? p) :write-only) ((input-port? p) :read-only) (else :none)))\n(direction-of (open-output-string))"
     :cs-program "(define (allocate-writer factory) (let ((p (factory))) (if (output-port? p) p (error 'shape 'factory-yielded-non-writer))))\n(allocate-writer open-output-string)"
     :problem "A write verb refuses to run against an input-port, preventing confusing errors at the write machinery."
     :explanation "eng: safe-log. math: direction dispatch. cs: factory validation."
     :meta "Reach for output-port? and NOT port?: port? admits input ports too. Direction is distinct.")
    (:eng "Boundary error at write direction check." :math "output-port? is the characteristic function of the write-capable subset." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Write-direction typing on handles."
     :rungs (
       (:domain "engineering"  :code "(define (direction-of p) (cond ((and (output-port? p) (input-port? p)) :duplex) ((output-port? p) :write-only) ((input-port? p) :read-only) (else :none)))\n(direction-of (open-output-string))")
       (:domain "mathematics"  :code "(output-port? (open-output-string))")
       (:domain "cs / dispatch" :code "(define (direction-of p) (cond ((and (output-port? p) (input-port? p)) :duplex) ((output-port? p) :write-only) ((input-port? p) :read-only) (else :none)))\n(direction-of (open-output-string))"))
     :explanation "Write direction on a file, a string buffer, or a pipe."
     :meta "Direction-typed handles are universal.")
    (:eng "Write direction is a boundary predicate." :math "Writer ⊆ Port." :cs "Capability typing supports safe upcasting."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (writer-implies-port? p) (implies (output-port? p) (port? p)))\n(and (writer-implies-port? (open-output-string)) (writer-implies-port? (open-input-string \"x\")))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (dual-check p) (implies (output-port? p) (port? p)))\n(dual-check (open-output-string))"
     :cs-program "(define (audit-write-cap ps) (fold (lambda (n p) (if (output-port? p) (+ n 1) n)) 0 ps))\n(audit-write-cap (list (open-output-string) (open-input-string \"x\")))"
     :claim "output-port? ⊂ port?: every output-port is a port."
     :invariant "∀ p. output-port?(p) → port?(p)"
     :meta "Pattern: subset containment.")
    (:eng "Sub-class admission is a universal I/O rule." :math "Writer ⊂ Port." :cs "Widening preserves capability."))
  :row-5-emergence (
    (:eng-composition "(define (log-batch p msgs) (when (output-port? p) (for-each (lambda (m) (display m p) (newline p)) msgs)))\n(log-batch (open-output-string) (list \"a\" \"b\" \"c\"))"
     :math-composition "(define (with-outs-of ps thunk) (let ((valid (filter output-port? ps))) (for-each (lambda (p) (thunk p)) valid)))\n(with-outs-of (list (open-output-string) (open-input-string \"x\")) (lambda (p) (display 'ok p)))"
     :cs-composition "(define (redirected-out src dest-thunk) (if (output-port? src) (dest-thunk src) (error 'shape 'not-out)))\n(redirected-out (open-output-string) (lambda (p) (display 'redirected p)))"
     :base "output-port? tests write capability."
     :emergent "Compositions build batched loggers, port unions, redirection."
     :meta "Family: safe-output.")
    (:eng "Batched logging is a common pattern." :math "Multi-out fanout writes to a valid subset." :cs "Redirection is capability-preserving substitution."))
)

(verb :name "port?" :std "R7RS-small"              :library "predicate" :tier "core" :kind "pure" :signature "(port? p) -> boolean"
  :summary "#t if p is any port (input, output, or both). R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(port? (open-input-string \"x\"))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string))) (and (port? p) (not (input-port? p))))" :note "A non-input port — usually output-only.")
    (:dialect "motoi" :tier "expert"       :code "(define (log-anywhere p msg) (cond ((not (port? p)) 'no-port) ((output-port? p) (display msg p) 'wrote) (else 'input-only)))\n(log-anywhere (open-output-string) \"hi\")" :note "Umbrella port check before direction-specific dispatch."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (accept-port p) (if (port? p) 'accepted 'rejected))\n(accept-port (open-input-string \"x\"))"
     :math-program "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))"
     :cs-program "(define (validate-connection p) (if (port? p) 'valid 'invalid))\n(validate-connection 'not-a-port)"
     :problem "Any port-manipulating helper needs to know it received a port at all before caring about direction."
     :explanation "eng: acceptance. math: domain classification. cs: validation."
     :meta "Reach for port? when direction doesn't matter — you need only I/O-handleness.")
    (:eng "Umbrella check precedes direction-specific dispatch." :math "port? is the union of input-port? and output-port?." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Umbrella-handle check."
     :rungs (
       (:domain "engineering"  :code "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))")
       (:domain "mathematics"  :code "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))")
       (:domain "cs / dispatch" :code "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))"))
     :explanation "Network, string, parser handles — all are ports."
     :meta "Umbrella typing is universal.")
    (:eng "Connection handles are ports." :math "Union of directional subsets." :cs "Umbrella tag simplifies routing."))
  :row-4-proof (
    (:eng-program "(define (union-holds? p) (equal? (port? p) (or (input-port? p) (output-port? p))))\n(and (union-holds? (open-input-string \"x\")) (union-holds? (open-output-string)))"
     :math-program "(define (subset-count ps) (list :input (length (filter input-port? ps)) :output (length (filter output-port? ps)) :any (length (filter port? ps))))\n(subset-count (list (open-input-string \"x\") (open-output-string)))"
     :cs-program "(define (all-port? xs) (fold (lambda (r p) (and r (port? p))) #t xs))\n(all-port? (list (open-input-string \"x\") (open-output-string)))"
     :claim "port? = input-port? ∪ output-port?."
     :invariant "∀ p. port?(p) ⇔ (input-port?(p) ∨ output-port?(p))"
     :meta "Pattern: union identity.")
    (:eng "Union identity means the umbrella is exact." :math "Union of two subsets equals the top of the port hierarchy." :cs "Runtime tag inspection is O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (close-all-ports ps) (for-each (lambda (p) (when (port? p) (close-port p))) ps))\n(close-all-ports (list (open-input-string \"x\") 'not-a-port))"
     :math-composition "(define (port-count ps) (length (filter port? ps)))\n(port-count (list (open-input-string \"x\") 'not-port (open-output-string)))"
     :cs-composition "(define (route-io v) (cond ((not (port? v)) :not-port) ((input-port? v) (read-char v)) ((output-port? v) (display 'ok v))))\n(route-io (open-input-string \"3\"))"
     :base "port? tests any I/O handle."
     :emergent "Compositions build port lifecycle mgmt, port counting, umbrella routing."
     :meta "Family: I/O umbrella management.")
    (:eng "Port lifecycle needs a way to walk any handle." :math "Counting ports gives system-level metrics." :cs "Umbrella routing dispatches to direction-specific paths."))
)

(verb :name "bytevector?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(bytevector? x) -> boolean"
  :summary "#t if x is a bytevector (a mutable u8 array). R7RS §6.9."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(bytevector? (make-bytevector 4 0))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((bv (make-bytevector 3 0))) (and (bytevector? bv) (positive? (bytevector-length bv))))" :note "Non-empty bytevector.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-serialize v) (if (bytevector? v) (utf8->string v) (error 'shape 'need-bytevector)))\n(safe-serialize (string->utf8 \"hello\"))" :note "Type-guarded byte-to-string conversion."))
  :provenance "R7RS §6.9; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (write-bytes p bv) (if (bytevector? bv) (display (utf8->string bv) p) (error 'shape 'need-bv)))\n(write-bytes (open-output-string) (string->utf8 \"hi\"))"
     :math-program "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))"
     :cs-program "(define (validate-frame v) (if (bytevector? v) 'binary 'non-binary))\n(validate-frame (make-bytevector 8))"
     :problem "Binary IO expects a bytevector; passing a string or list crashes at the write layer with a cryptic message."
     :explanation "eng: write. math: fold over u8. cs: frame validation."
     :meta "Reach for bytevector? and NOT string?: strings are UTF-8 encoded; bytevectors are raw bytes.")
    (:eng "Binary write guards prevent encoding confusion." :math "bytevector? is the characteristic function of u8-array shape." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Binary-container shape check."
     :rungs (
       (:domain "engineering"  :code "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))")
       (:domain "mathematics"  :code "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))")
       (:domain "cs / dispatch" :code "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))"))
     :explanation "Received frames, encoded signals, disk blocks — all bytevectors."
     :meta "Binary-container is a universal shape.")
    (:eng "Wire protocols use bytevectors." :math "Signal encoding produces u8 arrays." :cs "File I/O naturally uses bytevectors."))
  :row-4-proof (
    (:eng-program "(define (excludes-string? v) (or (not (bytevector? v)) (not (string? v))))\n(and (excludes-string? \"hello\") (excludes-string? (make-bytevector 2)))"
     :math-program "(define (mutable? bv) (if (bytevector? bv) (begin (bytevector-u8-set! bv 0 99) #t) #f))\n(mutable? (make-bytevector 3 0))"
     :cs-program "(define (length-matches? bv n) (and (bytevector? bv) (= (bytevector-length bv) n)))\n(length-matches? (make-bytevector 5) 5)"
     :claim "bytevector? and string? are disjoint."
     :invariant "∀ x. ¬(bytevector?(x) ∧ string?(x))"
     :meta "Pattern: disjoint types.")
    (:eng "Disjointness prevents encoding-confusion bugs." :math "Two distinct type classes with no overlap." :cs "Runtime tag distinguishes at O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (concat-bvs bvs) (let* ((total (fold + 0 (map bytevector-length (filter bytevector? bvs)))) (out (make-bytevector total 0))) (let loop ((bvs (filter bytevector? bvs)) (off 0)) (cond ((null? bvs) out) (else (bytevector-copy! out off (car bvs) 0 (bytevector-length (car bvs))) (loop (cdr bvs) (+ off (bytevector-length (car bvs)))))))))\n(concat-bvs (list (make-bytevector 2 1) 'not-bv (make-bytevector 2 2)))"
     :math-composition "(define (checksum bv) (if (bytevector? bv) (let loop ((i 0) (sum 0)) (if (= i (bytevector-length bv)) sum (loop (+ i 1) (+ sum (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(checksum (make-bytevector 4 42))"
     :cs-composition "(define (byte-histogram bvs) (let ((h (make-hash-table))) (for-each (lambda (bv) (when (bytevector? bv) (let loop ((i 0)) (when (< i (bytevector-length bv)) (hash-table-update! h (bytevector-u8-ref bv i) (lambda (n) (+ n 1)) (lambda () 0)) (loop (+ i 1)))))) bvs) h))\n(byte-histogram (list (make-bytevector 3 65) (make-bytevector 2 66)))"
     :base "bytevector? tests binary-container shape."
     :emergent "Compositions build concat, checksum, histogram."
     :meta "Family: byte-buffer aggregation.")
    (:eng "Concat is the base of frame reassembly." :math "Checksums verify integrity." :cs "Histograms analyze byte distributions."))
)

(verb :name "hash-table?" :std "SRFI-125"       :library "predicate" :tier "core" :kind "pure" :signature "(hash-table? x) -> boolean"
  :summary "#t if x is a hash-table. R7RS §6.10 (SRFI 69 / 125 shape)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(hash-table? (make-hash-table))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((h (make-hash-table))) (hash-table-set! h 'k 1) (and (hash-table? h) (positive? (hash-table-size h))))" :note "Non-empty hash-table.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-update h k f init) (if (hash-table? h) (hash-table-update! h k f init) (error 'shape 'need-ht)))\n(let ((h (make-hash-table))) (safe-update h 'x (lambda (n) (+ n 1)) (lambda () 0)))" :note "Guarded update — no crash on wrong type."))
  :provenance "R7RS §6.10; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (cache-lookup h k) (if (hash-table? h) (hash-table-ref h k (lambda () 'miss)) (error 'shape 'need-ht)))\n(cache-lookup (make-hash-table) 'x)"
     :math-program "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))"
     :cs-program "(define (memoize-safe f h) (if (hash-table? h) (lambda (x) (hash-table-ref h x (lambda () (let ((v (f x))) (hash-table-set! h x v) v)))) (error 'shape 'need-ht)))\n((memoize-safe (lambda (n) (* n n)) (make-hash-table)) 5)"
     :problem "Cache verbs expect a hash-table; passing an alist works with hash-table-ref-like helpers but not the mutating ops. Guard the shape."
     :explanation "eng: cache lookup. math: map over ht as (k,v). cs: memoization helper."
     :meta "Reach for hash-table? and NOT list?: alists are lists of pairs; hash-tables are distinct.")
    (:eng "Cache verbs need mutable, keyed storage." :math "hash-table? is a finite-map characteristic function." :cs "Primitive; O(1) — tag inspection."))
  :row-3-dimension (
    (:setup "Keyed-store shape check."
     :rungs (
       (:domain "engineering"  :code "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))")
       (:domain "mathematics"  :code "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))")
       (:domain "cs / dispatch" :code "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))"))
     :explanation "Every keyed store — cache, memo, config — is a hash-table."
     :meta "Keyed-store is a universal shape.")
    (:eng "Caches speed up expensive queries." :math "Finite maps model discrete correspondences." :cs "Hash-tables provide O(1) average keyed access."))
  :row-4-proof (
    (:eng-program "(define (empty-ok? h) (or (not (hash-table? h)) (>= (hash-table-size h) 0)))\n(empty-ok? (make-hash-table))"
     :math-program "(define (disjoint-with-list? h l) (not (and (hash-table? h) (list? l) (eq? h l))))\n(disjoint-with-list? (make-hash-table) '())"
     :cs-program "(define (post-set-holds? h k v) (if (hash-table? h) (begin (hash-table-set! h k v) (equal? (hash-table-ref/default h k #f) v)) #f))\n(post-set-holds? (make-hash-table) 'x 42)"
     :claim "hash-table? and list? are disjoint."
     :invariant "∀ x. ¬(hash-table?(x) ∧ list?(x))"
     :meta "Pattern: disjoint container types.")
    (:eng "Disjointness prevents cache-vs-list confusion." :math "Two distinct algebraic-structure classes." :cs "Runtime tag distinguishes at O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (merge-hts ha hb) (if (and (hash-table? ha) (hash-table? hb)) (let ((out (hash-table-copy ha))) (hash-table-walk hb (lambda (k v) (hash-table-set! out k v))) out) (error 'shape 'need-two-hts)))\n(let ((a (make-hash-table)) (b (make-hash-table))) (hash-table-set! a 'x 1) (hash-table-set! b 'y 2) (merge-hts a b))"
     :math-composition "(define (fmap-values h f) (let ((out (make-hash-table))) (hash-table-fold h (lambda (k v acc) (hash-table-set! out k (f v)) acc) #f) out))\n(fmap-values (let ((h (make-hash-table))) (hash-table-set! h 'x 3) h) (lambda (v) (* v 2)))"
     :cs-composition "(define (route-by h key default) (if (hash-table? h) (hash-table-ref/default h key default) default))\n(route-by (let ((h (make-hash-table))) (hash-table-set! h 'GET 'get-handler) h) 'GET 'not-found)"
     :base "hash-table? tests finite-map shape."
     :emergent "Compositions build merges, mappers, dispatchers."
     :meta "Family: finite-map operations.")
    (:eng "Merges combine multiple caches." :math "Value-mapping is a Functor operation on hash-tables." :cs "Route dispatch by key is the base of every router."))
)

(verb :name "vector?" :std "R7RS-small"          :library "predicate" :tier "core" :kind "pure" :signature "(vector? x) -> boolean"
  :summary "#t if x is a vector (a fixed-length indexed collection). R7RS §6.8."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(vector? (vector 1 2 3))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((v (vector 1 2 3))) (and (vector? v) (positive? (vector-length v))))" :note "Non-empty vector.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-vindex v i) (if (and (vector? v) (exact-integer? i) (< i (vector-length v))) (vector-ref v i) (error 'shape 'bad-index)))\n(safe-vindex (vector 'a 'b 'c) 1)" :note "Bounded random-access with type + range guard."))
  :provenance "R7RS §6.8; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (parallel-render vs) (if (vector? vs) (do ((i 0 (+ i 1))) ((= i (vector-length vs))) (render (vector-ref vs i))) (error 'shape 'need-vector)))\n(parallel-render (vector 'a 'b 'c))"
     :math-program "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))"
     :cs-program "(define (validate-frame v) (if (vector? v) 'ok 'shape-mismatch))\n(validate-frame (vector 1 2 3))"
     :problem "Fixed-index rendering (buffer walking) needs random access; a list would be O(n) per index. Vectors are O(1) — but the caller must pass a vector."
     :explanation "eng: parallel render. math: dot product. cs: frame validation."
     :meta "Reach for vector? and NOT list?: lists are cons-cells (O(n) index); vectors are contiguous storage (O(1) index).")
    (:eng "Random access must use a vector." :math "vector? is the characteristic function of indexed-array shape." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Indexed-storage shape check."
     :rungs (
       (:domain "engineering"  :code "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))")
       (:domain "mathematics"  :code "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))")
       (:domain "cs / dispatch" :code "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))"))
     :explanation "Framebuffers, math arrays, tuple decodings — all vectors."
     :meta "Indexed-storage is a universal shape.")
    (:eng "Buffers demand indexed storage." :math "Arrays are indexed sequences." :cs "Tuples decode into vectors."))
  :row-4-proof (
    (:eng-program "(define (disjoint-with-list? v l) (not (and (vector? v) (list? l) (eq? v l))))\n(disjoint-with-list? (vector 1 2) '(1 2))"
     :math-program "(define (o1-access? v i) (if (and (vector? v) (< i (vector-length v))) (begin (vector-ref v i) #t) #f))\n(o1-access? (vector 'a 'b 'c) 1)"
     :cs-program "(define (length-eq? v n) (and (vector? v) (= (vector-length v) n)))\n(length-eq? (vector 1 2 3) 3)"
     :claim "vector? and list? are disjoint containers."
     :invariant "∀ x. ¬(vector?(x) ∧ list?(x))"
     :meta "Pattern: disjoint types.")
    (:eng "Disjointness prevents container-confusion bugs." :math "Two distinct container-type classes." :cs "Type tag distinguishes at O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (transpose vs) (if (and (vector? vs) (positive? (vector-length vs)) (vector? (vector-ref vs 0))) (let* ((n (vector-length vs)) (m (vector-length (vector-ref vs 0))) (out (make-vector m #f))) (do ((j 0 (+ j 1))) ((= j m)) (vector-set! out j (make-vector n 0)) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! (vector-ref out j) i (vector-ref (vector-ref vs i) j)))) out) (error 'shape 'not-matrix)))\n(transpose (vector (vector 1 2) (vector 3 4)))"
     :math-composition "(define (norm-sq v) (if (vector? v) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (expt (vector-ref v i) 2))))) (error 'shape 'need-vec)))\n(norm-sq (vector 3 4))"
     :cs-composition "(define (map-vec f v) (if (vector? v) (let ((out (make-vector (vector-length v) #f))) (do ((i 0 (+ i 1))) ((= i (vector-length v))) (vector-set! out i (f (vector-ref v i)))) out) (error 'shape 'need-vec)))\n(map-vec (lambda (x) (* x 2)) (vector 1 2 3))"
     :base "vector? tests indexed-container shape."
     :emergent "Compositions build transpose, norms, mapped-vec."
     :meta "Family: indexed-storage operations.")
    (:eng "Matrix operations require indexed access." :math "Vector norms are indexed-sum operations." :cs "Element-wise map preserves shape."))
)

(verb :name "error-object?" :std "R7RS-small"     :library "predicate" :tier "core" :kind "pure" :signature "(error-object? x) -> boolean"
  :summary "#t if x is an error-object (a structured error value). R7RS §6.11."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(error-object? (guard (e (#t e)) (error 'test-error)))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((e (guard (ex (#t ex)) (error \"oops\")))) (and (error-object? e) (string? (error-object-message e))))" :note "Structured error with a message string.")
    (:dialect "motoi" :tier "expert"       :code "(define (log-error e) (when (error-object? e) (display (error-object-message e)) (newline)))\n(log-error (guard (e (#t e)) (error 'divide-by-zero)))" :note "Guarded logging of a caught error."))
  :provenance "R7RS §6.11; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (retry-on-error thunk) (let loop ((attempts 3)) (guard (e ((error-object? e) (if (positive? attempts) (loop (- attempts 1)) (raise e)))) (thunk))))\n(retry-on-error (lambda () 42))"
     :math-program "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))"
     :cs-program "(define (normalize-error e) (if (error-object? e) (list :msg (error-object-message e) :cause (error-object-irritants e)) (list :msg \"unknown\" :cause e)))\n(normalize-error (guard (e (#t e)) (error 'test)))"
     :problem "Structured error objects carry :message and :irritants; unstructured errors might just be strings. Distinguish before extraction."
     :explanation "eng: retry. math: class extraction. cs: normalization."
     :meta "Reach for error-object? and NOT error?: error? is broader (admits raised non-error values too). error-object? is R7RS-shaped.")
    (:eng "Retry loops depend on structured errors." :math "Error classification uses structured fields." :cs "Normalization pipelines produce log-friendly shapes."))
  :row-3-dimension (
    (:setup "Structured-error shape check."
     :rungs (
       (:domain "engineering"  :code "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))")
       (:domain "mathematics"  :code "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))")
       (:domain "cs / dispatch" :code "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))"))
     :explanation "Every guarded error, arithmetic exception, parse failure."
     :meta "Structured error is a universal shape.")
    (:eng "Structured errors carry actionable data." :math "Error is a value; error-object? refines that shape." :cs "Structured errors survive marshalling."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (implies-error? e) (implies (error-object? e) (error? e)))\n(and (implies-error? (guard (e (#t e)) (error \"x\"))) (implies-error? 'not-error))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (message-non-nil? e) (implies (error-object? e) (string? (error-object-message e))))\n(message-non-nil? (guard (e (#t e)) (error \"x\")))"
     :cs-program "(define (subset-count es) (list :objs (length (filter error-object? es)) :any (length (filter error? es))))\n(subset-count (list (guard (e (#t e)) (error 'x)) 'not-err))"
     :claim "error-object? ⊂ error?: every error-object is an error."
     :invariant "∀ e. error-object?(e) → error?(e)"
     :meta "Pattern: subset containment.")
    (:eng "Sub-class admission means broader handlers catch narrower classes." :math "Structured errors are a subset of general errors." :cs "Widening preserves catch semantics."))
  :row-5-emergence (
    (:eng-composition "(define (log-errors es) (for-each (lambda (e) (when (error-object? e) (display (error-object-message e)) (newline))) es))\n(log-errors (list (guard (e (#t e)) (error 'x))))"
     :math-composition "(define (error-class-count es) (fold (lambda (h e) (if (error-object? e) (let ((k (or (car (error-object-irritants e)) 'unknown))) (hash-table-update! h k (lambda (n) (+ n 1)) (lambda () 0))) h) h) (make-hash-table) es))\n(error-class-count (list))"
     :cs-composition "(define (triage-errors es) (map (lambda (e) (list :kind (if (error-object? e) 'structured 'raw) :val e)) es))\n(triage-errors (list (guard (e (#t e)) (error 'x)) 'other))"
     :base "error-object? tests structured error shape."
     :emergent "Compositions build error loggers, class-counting, triage."
     :meta "Family: structured error handling.")
    (:eng "Log pipelines need structured errors." :math "Classification counts by class." :cs "Triage separates raw vs structured errors."))
)

(verb :name "error?" :std "Motoi"            :library "predicate" :tier "core" :kind "pure" :signature "(error? x) -> boolean"
  :summary "#t if x can be raised as an error (structured or custom). R7RS §6.11."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(error? (guard (e (#t e)) (error 'test)))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((e (guard (ex (#t ex)) (error \"oops\")))) (and (error? e) (error-object? e)))" :note "Structured error is also error? — the umbrella predicate.")
    (:dialect "motoi" :tier "expert"       :code "(define (universal-catch thunk) (guard (e ((error? e) (list :caught e))) (thunk)))\n(universal-catch (lambda () (error 'bad-thing)))" :note "Umbrella error catch."))
  :provenance "R7RS §6.11; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-op op) (guard (e ((error? e) (list :failed e))) (op)))\n(safe-op (lambda () (error 'x)))"
     :math-program "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))"
     :cs-program "(define (log-all-errors es) (map (lambda (e) (list :is-err (error? e) :val e)) es))\n(log-all-errors (list (guard (e (#t e)) (error 'x)) 'not-err))"
     :problem "A general handler wants to catch any raised value; error? is the umbrella that admits both structured error-objects and custom raise values."
     :explanation "eng: safe op. math: classification. cs: audit logging."
     :meta "Reach for error? when you want the umbrella; error-object? for R7RS-shaped errors only.")
    (:eng "Universal error catches use error?." :math "Union of structured and custom errors." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Umbrella-error shape check."
     :rungs (
       (:domain "engineering"  :code "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))")
       (:domain "mathematics"  :code "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))")
       (:domain "cs / dispatch" :code "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))"))
     :explanation "Any failure mode surfaces as error?."
     :meta "Error umbrella is universal.")
    (:eng "General error handling needs umbrella detection." :math "Failure modes are values." :cs "Runtime raise semantics."))
  :row-4-proof (
    (:eng-program "(define (union-holds? e) (equal? (error? e) (or (error-object? e) (custom-error? e))))\n(union-holds? (guard (e (#t e)) (error 'x)))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (implies-err? e) (implies (error-object? e) (error? e)))\n(implies-err? (guard (e (#t e)) (error \"x\")))"
     :cs-program "(define (count-errors es) (length (filter error? es)))\n(count-errors (list (guard (e (#t e)) (error 'x)) 'not-err))"
     :claim "error? admits every error-object? plus custom raised values."
     :invariant "∀ e. error-object?(e) → error?(e); error? may admit additional values."
     :meta "Pattern: superset relation.")
    (:eng "Umbrella means one branch handles many failure kinds." :math "Union of subsets." :cs "Type widening preserves catch scope."))
  :row-5-emergence (
    (:eng-composition "(define (report-errors thunk) (guard (e ((error? e) (list :error e))) (thunk)))\n(report-errors (lambda () (error 'x)))"
     :math-composition "(define (error-severity e) (cond ((not (error? e)) :none) ((error-object? e) :structured) (else :raw)))\n(error-severity (guard (e (#t e)) (error 'x)))"
     :cs-composition "(define (retry-or-fail thunk max) (let loop ((n 0)) (guard (e ((error? e) (if (< n max) (loop (+ n 1)) (raise e)))) (thunk))))\n(retry-or-fail (lambda () 42) 3)"
     :base "error? tests umbrella-error shape."
     :emergent "Compositions build report, severity, retry."
     :meta "Family: unified error handling.")
    (:eng "Error reporting is universal in production code." :math "Severity classifies errors by structure." :cs "Retry loops use umbrella catches."))
)

(verb :name "promise?" :std "R7RS-small" :library "predicate" :tier "core" :kind "pure" :signature "(promise? x) -> boolean"
  :summary "#t if x is a promise (a delayed / lazy computation). R7RS §6.12."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(promise? (delay (+ 1 2)))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (delay 42))) (if (promise? p) (force p) p))" :note "Force only if promise; leave forced values alone.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-force p) (if (promise? p) (force p) (error 'shape 'need-promise)))\n(safe-force (delay 42))" :note "Guarded force — no double-force on already-forced values."))
  :provenance "R7RS §6.12; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (build-config) (list 'config 'default))\n(define (lazy-init factory) (if (promise? factory) (force factory) factory))\n(lazy-init (delay (build-config)))"
     :math-program "(define (compute-once) 42)\n(define (memo-value m) (cond ((promise? m) (force m)) (else m)))\n(memo-value (delay (compute-once)))"
     :cs-program "(define (stream-head s) (if (promise? s) (car (force s)) (error 'shape 'need-stream)))\n(stream-head (delay (cons 1 (delay '()))))"
     :problem "Lazy initialization patterns store promises; the consumer must know when to force vs. read directly. Guard the shape."
     :explanation "eng: lazy init. math: memoized value. cs: streaming head."
     :meta "Reach for promise? and NOT procedure?: procedures are called; promises are forced. Distinct.")
    (:eng "Lazy init is a common pattern for expensive setup." :math "Memoization suspends computation until needed." :cs "Streaming uses (head . delayed-tail)."))
  :row-3-dimension (
    (:setup "Suspended-computation shape check."
     :rungs (
       (:domain "engineering"  :code "(promise? (delay (load-large-file)))")
       (:domain "mathematics"  :code "(define (force-once-only p) (if (promise? p) (let ((v (force p))) (equal? v (force p))) #t))\n(force-once-only (delay 42))")
       (:domain "cs / dispatch" :code "(define (force-once-only p) (if (promise? p) (let ((v (force p))) (equal? v (force p))) #t))\n(force-once-only (delay 42))"))
     :explanation "Deferred loading, memoization, streaming — all use promises."
     :meta "Suspended computation is a universal shape.")
    (:eng "Delayed loading avoids upfront cost." :math "Memoized computations cache after first force." :cs "Streams model infinite data lazily."))
  :row-4-proof (
    (:eng-program "(define (idempotent-force? p) (if (promise? p) (equal? (force p) (force p)) #t))\n(idempotent-force? (delay (random-int 100)))"
     :math-program "(define (force-once-only p) (if (promise? p) (let ((v (force p))) (equal? v (force p))) #t))\n(force-once-only (delay 42))"
     :cs-program "(define (excludes-value? p v) (not (and (promise? p) (equal? p v))))\n(excludes-value? (delay 42) 42)"
     :claim "force is idempotent on promises."
     :invariant "∀ p. promise?(p) ⇒ force(p) = force(force(p))"
     :meta "Pattern: idempotence of force.")
    (:eng "Idempotence lets pipelines force safely without tracking state." :math "Memoization is the mechanism of idempotence." :cs "Force uses a memoized-thunk implementation."))
  :row-5-emergence (
    (:eng-composition "(define (force-if-promise xs) (map (lambda (x) (if (promise? x) (force x) x)) xs))\n(force-if-promise (list 1 (delay 2) 3))"
     :math-composition "(define (force-sum promises) (fold (lambda (p acc) (+ acc (if (promise? p) (force p) p))) 0 promises))\n(force-sum (list (delay 1) (delay 2) (delay 3)))"
     :cs-composition "(define (safe-take n s) (let loop ((n n) (s s) (acc '())) (cond ((<= n 0) (reverse acc)) ((not (promise? s)) (reverse acc)) (else (let ((pair (force s))) (if (null? pair) (reverse acc) (loop (- n 1) (cdr pair) (cons (car pair) acc))))))))\n(safe-take 3 (delay (cons 1 (delay (cons 2 (delay (cons 3 (delay '()))))))))"
     :base "promise? tests deferred-computation shape."
     :emergent "Compositions build lazy transformers, lazy folds, safe takes."
     :meta "Family: lazy-evaluation pipelines.")
    (:eng "Lazy transformers defer work until needed." :math "Lazy folds work on infinite streams." :cs "Safe take extracts finite prefixes from potentially infinite streams."))
)

;; ─── R7RS-small core predicates (added 2026-08-02) ───

(verb
  :name "eq?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(eq? a b) -> boolean"
  :summary "The identity test: #t when a and b are the same object, or the same atom. R7RS-small 6.1."
  :explanation "The cheapest rung of the three-rung equality ladder, and in Motoi eq? and eqv? are literally the same procedure -- both names are bound to one function in the engine. R7RS-small permits that, because it leaves eq?'s answer on numbers and characters UNSPECIFIED rather than requiring #f, so making the two agree is conformant and spares the learner a distinction with no observable meaning here. What eq? answers #t for: the same object; two symbols with the same name; two numbers of equal value; two characters; the booleans; and -- because Motoi strings are immutable host values, so string-set! raises -- two strings with the same characters. What it answers #f for: two SEPARATELY BUILT aggregates. (eq? (list 1) (list 1)) is #f, and so is the same test on two vectors, even though both sides print identically. That single #f is the whole reason equal? exists. Two measured departures from the standard you must know before you rely on them. First, (eq? '() '()) answers #f in Motoi, although R7RS-small requires #t for two empty lists -- so test emptiness with null?, never with eq?. Second, (eq? 2 2.0) answers #t, because Motoi has no distinct inexact integer: 2.0 reads as the very same object as 2."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(eq? 'north 'north)" :note "#t -- two occurrences of one symbol are the same object.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (eq? 'a 'a) (eq? (list 1) (list 1)) (eq? \"ab\" \"ab\") (eq? '() '())))\n(newline)" :note "(#t #f #t #f) -- symbols yes; two freshly built lists NO; two equal strings yes (Motoi strings are immutable values); two empty lists NO, which is the departure from R7RS.")
    (:dialect "motoi" :tier "expert" :code "(define (state-name s) (cond ((eq? s 'idle) \"waiting\") ((eq? s 'run) \"working\") (else \"unknown\")))\n(display (map state-name (list 'idle 'run 'halt)))\n(newline)" :note "(waiting working unknown) -- symbol dispatch, the job eq? is built for.")
  )
  :caveats ("(eq? (list 1) (list 1)) is #f. Two lists that print the same are not the same object; reach for equal?." "(eq? '() '()) is #f in Motoi. R7RS-small 6.1 requires #t for the empty list. Use null? to test emptiness -- it is #t for every empty list." "(eq? 2 2.0) is #t. R7RS leaves eq? on numbers unspecified, so this is conformant, but a program that relies on it will behave differently on a Scheme with a real inexact integer." "(eq? \"abc\" \"abc\") is #t. R7RS leaves this unspecified; Motoi picks value equality because its strings are immutable." "eq? and eqv? are the same procedure in Motoi. Anything true of one is true of the other." "Arity is not checked: (eq? 1) answers #f rather than raising.")
  :usecases ("Dispatching on a symbolic tag or state name." "Testing whether two names denote one interned symbol." "Cheap membership over a list of symbols.")
  :related ("eqv?" "equal?" "null?" "symbol?" "not")
  :learn (:concept "Identity versus structure: eq? asks whether two expressions denote ONE thing, not whether two things look alike." :prerequisites ("symbol?" "null?") :progression "Meet eq? on symbols first, where it is exact and cheap. Then meet equal? on lists, where eq? deliberately answers #f. Learn eqv? last -- in Motoi it is the same procedure as eq?, so it adds a name, not a behaviour.")
  :provenance "R7RS-small 6.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :status "needs-alfred"
  :row-2-audit (
    (:eng-program "(define (transition s ev)\n  (cond ((and (eq? s 'idle) (eq? ev 'go)) 'run)\n        ((and (eq? s 'run) (eq? ev 'stop)) 'idle)\n        (else s)))\n(display (list (transition 'idle 'go) (transition 'run 'stop) (transition 'run 'go)))\n(newline)"
     :math-program "(define (tally sym xs) (fold (lambda (x n) (if (eq? x sym) (+ n 1) n)) 0 xs))\n(display (list 'a (tally 'a (list 'a 'b 'a 'c)) 'b (tally 'b (list 'a 'b 'a 'c))))\n(newline)"
     :cs-program "(define table (list (cons 'red 1) (cons 'green 2)))\n(define (lookup k) (let loop ((t table)) (cond ((null? t) 'missing) ((eq? (caar t) k) (cdar t)) (else (loop (cdr t))))))\n(display (list (lookup 'red) (lookup 'green) (lookup 'blue)))\n(newline)"
     :problem "The operator is writing a state machine whose states and events are symbols. Candidates: eq? (identity on symbols -- exact, one comparison), equal? (also correct here, but it pays for a deep structural walk on every branch and would additionally answer #t for a LIST that happened to print like the tag), and string comparison after symbol->string (allocates a string per test and throws away the interning the reader already did). For symbolic tags the tags ARE identities, so eq? is not merely faster, it is the honest statement of the question."
     :explanation "eng: a two-state machine driven by symbol events. math: counting occurrences of one symbol in a bag. cs: an association list walked with eq? on the key -- the classic symbol table."
     :meta "Why eq? and not equal?: equal? asks \"do these have the same shape and contents\", which is a strictly weaker question. When the answer you need is \"is this THE state named run\", weakening the question invites a value that merely resembles the tag to pass.")
    (:eng "A state machine that dispatches on identity cannot be fooled by a lookalike; the log line names the exact symbol that fired."
     :math "eq? on an interned symbol set is the equality of that set: each name denotes exactly one element."
     :cs "O(1). The reader interns symbols, so identity is a single comparison -- no walk, no allocation."))
  :row-3-dimension (
    (:setup "Asking whether two names refer to one and the same thing, rather than to two things that merely look alike."
     :rungs ((:domain "symbols in a program" :code "(display (list (eq? 'stone 'stone) (eq? 'stone 'water)))\n(newline)")
             (:domain "labelled loading bays on a workshop floor" :code "(define (same-slot? a b) (eq? a b))\n(display (list (same-slot? 'bay-3 'bay-3) (same-slot? 'bay-3 'bay-4)))\n(newline)")
             (:domain "the Kronecker delta on an index set" :code "(define (kronecker a b) (if (eq? a b) 1 0))\n(display (map (lambda (p) (kronecker (car p) (cdr p))) (list (cons 'i 'i) (cons 'i 'j))))\n(newline)"))
     :explanation "In a program, two occurrences of 'stone name one interned symbol, so eq? is #t. On a workshop floor, bay-3 written on two work orders means one physical bay -- the label is an identity, not a description. In mathematics the Kronecker delta is exactly this predicate with 1 and 0 in place of #t and #f: it is 1 when the indices are the same index. All three share a single move: comparing labels drawn from a set where each label names exactly one element."
     :meta "Identity comparison is only meaningful over a namespace where names are unique. Where names may be re-used, identity stops answering the question and structure has to.")
    (:eng "Bay labels are unique by construction, which is what licenses comparing them by identity instead of by description."
     :math "The Kronecker delta is the characteristic function of the diagonal of a set crossed with itself."
     :cs "Interning is the implementation that makes name identity and name equality coincide."))
  :row-4-proof (
    (:eng-program "(define vals (list 'a 'b 1 2.5 #\\x \"s\" #t '()))\n(display (map (lambda (v) (eq? v v)) vals))\n(newline)"
     :math-program "(define vals (list 'a 1 #\\x \"s\" #t (list 1 2)))\n(define (sym-ok a b) (eq? (eq? a b) (eq? b a)))\n(display (list 'symmetric (every (lambda (a) (every (lambda (b) (sym-ok a b)) vals)) vals)))\n(newline)"
     :cs-program "(define vals (list 'a 1 #\\x \"s\" #t (list 1 2) (vector 3)))\n(define (ladder a b) (if (eq? a b) (eqv? a b) #t))\n(display (list 'eq-implies-eqv (every (lambda (a) (every (lambda (b) (ladder a b)) vals)) vals)))\n(newline)"
     :claim "eq? is reflexive on every value (including an aggregate compared with itself), symmetric on every pair of values, and implies eqv? -- trivially so in Motoi, where they are one procedure. Reflexivity holds even for the empty list: it is TWO separately read empty lists that answer #f, never one compared with itself."
     :invariant "For all x. eq?(x, x) = #t; for all a b. eq?(a, b) = eq?(b, a); for all a b. eq?(a, b) implies eqv?(a, b)"
     :meta "What would falsify it: a value that is not eq? to itself, a pair that answers differently when the arguments are swapped, or a pair that is eq? but not eqv?. The reflexive program deliberately includes the empty list and a string, the two values whose behaviour surprises people.")
    (:eng "Reflexivity is what lets a cache compare a stored object against itself without a deep walk."
     :math "Reflexive plus symmetric plus transitive makes eq? an equivalence relation; the implication chain orders the three relations by refinement."
     :cs "eq? implies eqv? holds by construction here -- one function, two names -- so the test documents the binding rather than probing it."))
  :row-5-emergence (
    (:eng-composition "(define (assq-eq k alist) (let loop ((t alist)) (cond ((null? t) #f) ((eq? (caar t) k) (car t)) (else (loop (cdr t))))))\n(define handlers (list (cons 'open 'unlock) (cons 'shut 'lock)))\n(display (list (assq-eq 'open handlers) (assq-eq 'melt handlers)))\n(newline)"
     :math-composition "(define (uniq xs) (fold-right (lambda (x acc) (if (any (lambda (y) (eq? x y)) acc) acc (cons x acc))) '() xs))\n(display (uniq (list 'a 'b 'a 'c 'b)))\n(newline)"
     :cs-composition "(define (dispatch tag arg)\n  (cond ((eq? tag 'double) (* 2 arg))\n        ((eq? tag 'negate) (- arg))\n        (else 'no-handler)))\n(display (map (lambda (t) (dispatch t 5)) (list 'double 'negate 'square)))\n(newline)"
     :base "eq? answers whether two values are the same object or the same atom."
     :emergent "eng: an association-list lookup keyed by symbol -- the symbol table, the oldest data structure in Lisp. math: a duplicate-free set over symbols, built by asking eq? against everything already kept. cs: a dispatch table that turns a tag into an action, with an explicit no-handler branch."
     :meta "The composition is eq? plus a list. What emerges is the symbol-table family: put eq? in a lookup loop and you get a table; put it in an accumulator guard and you get a set; put it in a cond and you get dispatch. Same predicate, three containers.")
    (:eng "A dispatch table with a named no-handler branch fails loudly instead of silently doing nothing."
     :math "Deduplication by eq? realises the quotient of a list by the identity relation."
     :cs "Linear scan is the right structure at this size; the same shape backed by a hash table is what a symbol table becomes when it grows."))
)

(verb
  :name "eqv?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(eqv? a b) -> boolean"
  :summary "The standard equivalence on atoms: #t for the same object, and for numbers, characters, symbols and booleans of equal value. R7RS-small 6.1."
  :explanation "The middle rung of the equality ladder, and in Motoi the SAME procedure as eq? -- both names are bound to one function. R7RS-small defines eqv? as the equivalence that cannot be defeated by any operation: two objects are eqv? when no program can tell them apart. Motoi's atoms are already value-shaped, so eqv? is identity plus a value check on symbols and on exact rationals, and nothing else. An aggregate is eqv? only to itself: (eqv? (list 1) (list 1)) is #f, which is correct and is the point -- two lists built separately are two objects. Exactness IS respected where Motoi can represent it: (eqv? 1/2 0.5) is #f, exactly as the standard requires, because one is exact and the other is not. Two measured departures. First, (eqv? '() '()) answers #f, although R7RS-small explicitly requires #t when both objects are the empty list; test emptiness with null?. Second, (eqv? 2 2.0) answers #t where the standard requires #f, because Motoi has no distinct inexact integer -- 2.0 reads as the same object as 2, so no operation can distinguish them and there is nothing for eqv? to separate. And one gap worth knowing before you rely on the ladder: (eqv? 1/2 1/2) is #t while (equal? 1/2 1/2) is #f, so eqv? does NOT imply equal? on exact rationals in the engine as it stands."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(eqv? 100 100)" :note "#t -- two numbers of equal value.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (eqv? #\\a #\\a) (eqv? 1/2 1/2) (eqv? 1/2 0.5) (eqv? (list 1) (list 1))))\n(newline)" :note "(#t #t #f #f) -- characters yes; two equal exact rationals yes; an exact rational against its inexact value NO (exactness is respected, as R7RS requires); two freshly built lists NO.")
    (:dialect "motoi" :tier "expert" :code "(define (memv-eqv x xs) (let loop ((t xs)) (cond ((null? t) #f) ((eqv? (car t) x) t) (else (loop (cdr t))))))\n(display (list (memv-eqv 3 (list 1 2 3 4)) (memv-eqv 9 (list 1 2 3 4))))\n(newline)" :note "((3 4) #f) -- memv written by hand: eqv? is exactly the comparison the standard specifies for it.")
  )
  :caveats ("eqv? and eq? are the same procedure in Motoi. There is no case in which they differ." "(eqv? '() '()) is #f. R7RS-small 6.1 requires #t for two empty lists. Use null?." "(eqv? 2 2.0) is #t. R7RS-small requires #f because the two differ in exactness; Motoi has no separate inexact integer, so the two literals read as one object." "(eqv? 1/2 1/2) is #t but (equal? 1/2 1/2) is #f. The standard requires equal? to be #t wherever eqv? is, so the ladder is broken at exact rationals." "(eqv? (list 1) (list 1)) is #f, correctly. Use equal? when you mean same shape and contents." "Arity is not checked: (eqv? 1) answers #f rather than raising.")
  :usecases ("Hand-writing memv or assv over atoms." "Counting distinct atomic values in a sequence." "Run-length encoding, where adjacent atoms are compared.")
  :related ("eq?" "equal?" "number?" "exact?" "not")
  :learn (:concept "Equivalence on atoms: eqv? is #t exactly when no operation can distinguish the two values." :prerequisites ("eq?" "number?") :progression "Learn eq? on symbols, then eqv? as the standard name for the same test with the atom rules spelled out, then equal? for aggregates. If you can only remember one rule: atoms compare by value, aggregates compare by identity.")
  :provenance "R7RS-small 6.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :status "needs-alfred"
  :row-2-audit (
    (:eng-program "(define (bucket-of ch)\n  (cond ((eqv? ch #\\space) 'gap) ((eqv? ch #\\-) 'dash) (else 'char)))\n(display (map bucket-of (list #\\a #\\space #\\-)))\n(newline)"
     :math-program "(define (count-value v xs) (fold (lambda (x n) (if (eqv? x v) (+ n 1) n)) 0 xs))\n(display (list (count-value 2 (list 1 2 2 3)) (count-value 1/2 (list 1/2 1/3 1/2))))\n(newline)"
     :cs-program "(define (dedupe-atoms xs) (fold-right (lambda (x acc) (if (any (lambda (y) (eqv? x y)) acc) acc (cons x acc))) '() xs))\n(display (dedupe-atoms (list 1 #\\a 1 'z #\\a)))\n(newline)"
     :problem "The operator is bucketing characters coming off a text scan. Candidates: eqv? (the standard equivalence for characters, and the comparison memv is defined in terms of), equal? (correct but overpowered -- it would also walk a list argument, so a bug that passed a list instead of a character would be answered instead of noticed), and char=? (correct and narrower, but it is a type error on a non-character rather than a #f). For a scan whose alphabet is atoms, eqv? is the comparison the standard already names."
     :explanation "eng: bucketing characters into gap, dash, and ordinary. math: counting how many times one value occurs, including an exact rational. cs: removing duplicate atoms while keeping first-seen order."
     :meta "Why eqv? and not equal?: equal? asks a strictly larger question and answers #t in cases eqv? deliberately answers #f. When the domain is atoms the two agree, so choosing eqv? costs nothing and states the intent -- these are atoms, compare them as atoms.")
    (:eng "Bucketing on the standard equivalence means the code reads the same as the library procedures (memv, assv, case) that use it."
     :math "eqv? induces the partition of a bag of atoms into value classes; counting a class is counting its preimage."
     :cs "O(1) on atoms. Two distinct aggregates are rejected on the first identity check, with no walk."))
  :row-3-dimension (
    (:setup "Deciding whether two values are interchangeable -- whether any operation at all could tell them apart."
     :rungs ((:domain "characters in a text scan" :code "(display (list (eqv? #\\q #\\q) (eqv? #\\q #\\r)))\n(newline)")
             (:domain "interchangeable parts in a bin" :code "(define (same-part? a b) (eqv? a b))\n(display (list (same-part? 'bolt-m4 'bolt-m4) (same-part? 'bolt-m4 'bolt-m5)))\n(newline)")
             (:domain "the discrete metric on a set" :code "(define (delta a b) (if (eqv? a b) 1 0))\n(display (list (delta 7 7) (delta 7 8) (delta 1/2 1/2)))\n(newline)"))
     :explanation "In a scan, two occurrences of the character q are interchangeable: nothing downstream can tell which one arrived. In a parts bin, two m4 bolts are interchangeable for the same reason -- not because they are one object, but because no operation in the shop distinguishes them. In mathematics this is the discrete metric, distance 0 exactly when the points coincide. All three share the move: equality defined as the absence of any distinguishing observation."
     :meta "Interchangeability is the operational definition of equality. It is also why immutability matters -- two mutable objects that look alike are distinguishable the moment one is changed.")
    (:eng "Interchangeable parts are a design decision, not a discovery; so is deciding which values a program treats as equivalent."
     :math "The discrete metric is the coarsest metric that separates points; eqv? is its predicate form."
     :cs "Immutable values can be compared by value safely; mutable ones cannot, which is why R7RS compares aggregates by location."))
  :row-4-proof (
    (:eng-program "(define atoms (list 'a 1 1/2 #\\x \"s\" #t '()))\n(display (map (lambda (v) (eqv? v v)) atoms))\n(newline)"
     :math-program "(define atoms (list 'a 1 1/2 #\\x \"s\" #t (list 1 2)))\n(display (list 'symmetric (every (lambda (a) (every (lambda (b) (eq? (eqv? a b) (eqv? b a))) atoms)) atoms)))\n(newline)"
     :cs-program "(define atoms (list 'a 1 #\\x \"s\" #t (list 1 2) (vector 3)))\n(define (ladder a b) (if (eqv? a b) (equal? a b) #t))\n(display (list 'eqv-implies-equal-except-rationals\n               (every (lambda (a) (every (lambda (b) (ladder a b)) atoms)) atoms)\n               'rational-break (list (eqv? 1/2 1/2) (equal? 1/2 1/2))))\n(newline)"
     :claim "eqv? is reflexive on every value and symmetric on every pair. It implies equal? on every value tested EXCEPT exact rationals, where the engine currently answers eqv? #t and equal? #f -- the third program prints that counterexample alongside the passing check rather than hiding it."
     :invariant "For all x. eqv?(x, x) = #t; for all a b. eqv?(a, b) = eqv?(b, a); for all a b not exact rationals. eqv?(a, b) implies equal?(a, b)"
     :meta "What would falsify it: a value not eqv? to itself, an asymmetric pair, or a non-rational pair that is eqv? but not equal?. The rational case is already falsified and is printed as data, because a proof row that quietly excluded the failing case would be teaching the invariant the engine does not have.")
    (:eng "A stated exception is a work item; an unstated one is a bug report from a user six months later."
     :math "Reflexive and symmetric and transitive make eqv? an equivalence relation; the ladder to equal? is a refinement order, and it holds everywhere the engine has not broken it."
     :cs "The counterexample is printed, not asserted, so the program passes while the defect stays visible in the output."))
  :row-5-emergence (
    (:eng-composition "(define (run-length xs)\n  (if (null? xs) '()\n      (let loop ((t (cdr xs)) (cur (car xs)) (n 1) (acc '()))\n        (cond ((null? t) (reverse (cons (cons cur n) acc)))\n              ((eqv? (car t) cur) (loop (cdr t) cur (+ n 1) acc))\n              (else (loop (cdr t) (car t) 1 (cons (cons cur n) acc)))))))\n(display (run-length (list 1 1 2 2 2 3)))\n(newline)"
     :math-composition "(define (histogram xs)\n  (fold (lambda (x acc)\n          (let loop ((t acc) (out '()))\n            (cond ((null? t) (reverse (cons (cons x 1) out)))\n                  ((eqv? (caar t) x) (append (reverse out) (cons (cons x (+ 1 (cdar t))) (cdr t))))\n                  (else (loop (cdr t) (cons (car t) out))))))\n        '() xs))\n(display (histogram (list 1 2 1 3 1)))\n(newline)"
     :cs-composition "(define (index-of v xs) (let loop ((t xs) (i 0)) (cond ((null? t) #f) ((eqv? (car t) v) i) (else (loop (cdr t) (+ i 1))))))\n(display (list (index-of #\\c (list #\\a #\\b #\\c)) (index-of #\\z (list #\\a #\\b #\\c))))\n(newline)"
     :base "eqv? answers whether two atoms have the same value, or two aggregates are the same object."
     :emergent "eng: run-length encoding, which is nothing but eqv? applied to adjacent elements. math: a histogram, which is eqv? applied to every element against every bucket key. cs: index-of, which is eqv? applied until the first hit."
     :meta "The composition is eqv? plus a traversal. What emerges is the tally family: compare adjacent and you compress; compare against a table and you count; compare until a hit and you locate. The predicate is fixed, the traversal decides what you get.")
    (:eng "Run-length encoding is the cheapest compression there is, and it is one predicate and one loop."
     :math "A histogram is the fibres of the map from elements to their equivalence classes."
     :cs "All three are one pass; only the accumulator differs -- a run, a table, or an index."))
)

(verb
  :name "equal?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(equal? a b) -> boolean"
  :summary "Structural equality: #t when a and b have the same shape and equal contents, recursively. R7RS-small 6.1."
  :explanation "The top rung of the equality ladder and the one you want most of the time. Where eq? and eqv? ask 'is this the same object', equal? asks 'does this have the same shape and the same contents', and it recurses to find out: lists are compared element by element down the spine, vectors element by element, bytevectors byte by byte, and atoms are compared as eqv? compares them. So (equal? (list 1 (list 2)) (list 1 (list 2))) is #t while the same test with eq? is #f. That gap is the reason all three procedures exist. Cost follows the definition: equal? walks the whole structure, so it is O(size), where eq? is O(1) -- use equal? when shape is the question and eq? when identity is. One measured gap you must know. (equal? 1/2 1/2) answers #f, although (eqv? 1/2 1/2) is #t and R7RS-small requires equal? to be #t wherever eqv? is. Exact rationals are heap objects in Motoi and the structural walk has no case for them, so two equal rationals fall through to #f. Compare exact rationals with = or eqv?, not with equal?, until that is fixed."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(equal? (list 1 2 3) (list 1 2 3))" :note "#t -- same shape, same contents.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (equal? (list 1 (list 2)) (list 1 (list 2))) (equal? (vector 1 2) (vector 1 2)) (equal? 1/2 1/2)))\n(newline)" :note "(#t #t #f) -- nested lists yes; vectors yes; two equal exact rationals NO, which is the gap.")
    (:dialect "motoi" :tier "expert" :code "(define (same-config? a b) (equal? a b))\n(define golden (list 'width 320 'height 240))\n(display (list (same-config? golden (list 'width 320 'height 240)) (same-config? golden (list 'width 640 'height 480))))\n(newline)" :note "(#t #f) -- comparing a configuration against a known-good one, the everyday use.")
  )
  :caveats ("(equal? 1/2 1/2) is #f, although (eqv? 1/2 1/2) is #t. R7RS-small requires equal? to hold wherever eqv? does. Use = or eqv? for exact rationals." "(equal? 4/2 2) is #f even though both print as 2 and (= 4/2 2) is #t. Same cause: an exact rational is not compared numerically by equal?." "equal? walks the whole structure. On a large nested list it is O(size), not O(1). Reach for eq? when identity is the question." "equal? compares a list against a vector as #f even when the elements match: shape is part of the question." "On atoms equal? agrees with eqv?, so it is never WRONG on a symbol or a character -- only more expensive to say.")
  :usecases ("Comparing a computed structure against an expected one in a test." "Deduplicating a list of lists." "Detecting whether a snapshot of state changed.")
  :related ("eq?" "eqv?" "list?" "vector?" "not")
  :learn (:concept "Structural equality: same shape, same contents, all the way down." :prerequisites ("eq?" "pair?" "list?") :progression "Learn eq? first so the #f on two lookalike lists is a surprise you have already met. Then equal? as the answer to that surprise. Then learn WHEN not to use it: identity questions, and hot loops over big structures.")
  :provenance "R7RS-small 6.1; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :status "needs-alfred"
  :row-2-audit (
    (:eng-program "(define expected (list (list 'sku \"A1\") (list 'sku \"B2\")))\n(define actual (list (list 'sku \"A1\") (list 'sku \"B2\")))\n(display (list 'match (equal? expected actual) 'identical (eq? expected actual)))\n(newline)"
     :math-program "(define (set-equal? a b) (and (every (lambda (x) (any (lambda (y) (equal? x y)) b)) a)\n                              (every (lambda (y) (any (lambda (x) (equal? x y)) a)) b)))\n(display (list (set-equal? (list (list 1) (list 2)) (list (list 2) (list 1)))\n               (set-equal? (list (list 1)) (list (list 1) (list 3)))))\n(newline)"
     :cs-program "(define (assoc-equal k alist) (let loop ((t alist)) (cond ((null? t) #f) ((equal? (caar t) k) (car t)) (else (loop (cdr t))))))\n(define routes (list (cons (list 'get 'home) 'index) (cons (list 'get 'about) 'about)))\n(display (list (assoc-equal (list 'get 'about) routes) (assoc-equal (list 'put 'home) routes)))\n(newline)"
     :problem "The operator is checking a computed table of records against the table the test expects. Candidates: equal? (structural -- exactly the question a test asks), eq? (answers #f for two separately built tables, so the test would fail on every run and teach the author to distrust the test), and a hand-written element-by-element comparison (correct, longer, and one more thing to get wrong). A test asks about shape and contents, so equal? IS the assertion."
     :explanation "eng: expected versus actual on a table of records, printed alongside the identity answer so the difference is visible. math: set equality by mutual inclusion, with equal? as the element comparison. cs: an association list keyed by a LIST, which only works because equal? compares structurally."
     :meta "Why equal? and not eq?: eq? would answer #f for every separately built structure, which turns a passing test into a failing one and a failing one into noise. The rule of thumb: if either side was freshly built, the question is structural.")
    (:eng "A test that compares with eq? fails for the wrong reason, which is worse than not testing."
     :math "Set equality by mutual inclusion needs an element equality; equal? supplies it for structured elements."
     :cs "Keying a table by a list requires structural equality; that is precisely the difference between assq and assoc."))
  :row-3-dimension (
    (:setup "Judging two things the same because they are built the same way out of the same parts, not because they are one thing."
     :rungs ((:domain "lists compared element by element" :code "(display (list (equal? (list 1 2) (list 1 2)) (equal? (list 1 2) (list 2 1))))\n(newline)")
             (:domain "two crates packed to the same manifest" :code "(define (crate-contents . items) items)\n(display (list (equal? (crate-contents 'nail 'screw) (crate-contents 'nail 'screw))\n               (equal? (crate-contents 'nail 'screw) (crate-contents 'nail 'bolt))))\n(newline)")
             (:domain "two trees with the same labelled shape" :code "(define (tree-equal? a b) (equal? a b))\n(display (list (tree-equal? (list 1 (list 2 (list 3))) (list 1 (list 2 (list 3))))\n               (tree-equal? (list 1 (list 2)) (list 1 (list 3)))))\n(newline)"))
     :explanation "Two lists are equal? when they have the same elements in the same order. Two crates packed to the same manifest are interchangeable to the receiving dock even though they are two crates -- and swapping the order of the items would make them a different pack, which is why order is part of the judgement. In mathematics two labelled trees are equal when their shapes agree and each corresponding label agrees. All three share the move: descend both structures together, compare at the leaves, and require the shapes to line up on the way down."
     :meta "Structural equality is defined by recursion on the constructor. That is why it costs a walk, and why it stops being the right question the moment the structures are large and identity would do.")
    (:eng "A manifest check is a walk, and the cost of a walk is why receiving docks spot-check instead of comparing everything."
     :math "Equality of labelled trees is defined by induction over the tree constructors -- exactly how R7RS defines equal?."
     :cs "The recursion is the definition; short-circuiting on the first mismatch is the only optimisation it admits."))
  :row-4-proof (
    (:eng-program "(define vals (list 'a 1 #\\x \"s\" #t (list 1 2) (vector 1 2) '()))\n(display (map (lambda (v) (equal? v v)) vals))\n(newline)"
     :math-program "(define vals (list 'a 1 \"s\" (list 1 2) (vector 1 2) '()))\n(display (list 'symmetric (every (lambda (a) (every (lambda (b) (eq? (equal? a b) (equal? b a))) vals)) vals)))\n(newline)"
     :cs-program "(define vals (list 'a 1 \"s\" (list 1 2) (vector 1 2) '()))\n(define (transitive? a b c) (if (and (equal? a b) (equal? b c)) (equal? a c) #t))\n(display (list 'transitive\n               (every (lambda (a) (every (lambda (b) (every (lambda (c) (transitive? a b c)) vals)) vals)) vals)\n               'rational-gap (list (eqv? 1/2 1/2) (equal? 1/2 1/2))))\n(newline)"
     :claim "equal? is reflexive, symmetric and transitive over lists, vectors, strings, symbols, characters, booleans and the empty list -- it is an equivalence relation on those. It is NOT reflexive on exact rationals: (equal? 1/2 1/2) is #f, and the third program prints that counterexample beside the passing transitivity check."
     :invariant "For all x not an exact rational. equal?(x, x) = #t; for all a b. equal?(a, b) = equal?(b, a); for all a b c. equal?(a, b) and equal?(b, c) implies equal?(a, c)"
     :meta "What would falsify it: a structure not equal? to itself, an asymmetric pair, or a broken chain of three. The rational case is already falsified. Note the shape of the failure -- reflexivity is the weakest property an equality can have, so a value that is not equal? to itself is the loudest possible signal that a case is missing.")
    (:eng "Reflexivity failing is the cheapest bug to detect and the most expensive to leave in, because every consumer assumes it."
     :math "Reflexive, symmetric and transitive is the definition of an equivalence relation; without reflexivity there are no equivalence classes at all."
     :cs "Membership, deduplication and table lookup all assume reflexivity; each of them silently misbehaves on exact rationals as a consequence."))
  :row-5-emergence (
    (:eng-composition "(define (diff-fields a b)\n  (fold-right (lambda (p acc) (if (equal? (cdr p) (cdr (assq (car p) b))) acc (cons (car p) acc))) '() a))\n(display (diff-fields (list (cons 'w 320) (cons 'h 240)) (list (cons 'w 320) (cons 'h 480))))\n(newline)"
     :math-composition "(define (unique-shapes xs) (fold-right (lambda (x acc) (if (any (lambda (y) (equal? x y)) acc) acc (cons x acc))) '() xs))\n(display (unique-shapes (list (list 1 2) (list 1 2) (list 3) (list 3) (list 1 2))))\n(newline)"
     :cs-composition "(define (snapshot-changed? before after) (not (equal? before after)))\n(define s0 (list 'x 0 'y 0))\n(display (list (snapshot-changed? s0 (list 'x 0 'y 0)) (snapshot-changed? s0 (list 'x 1 'y 0))))\n(newline)"
     :base "equal? answers whether two values have the same shape and the same contents."
     :emergent "eng: a field-level diff between two configurations, naming only what changed. math: deduplication of structured values, which needs structural equality to work at all. cs: change detection between two snapshots of state -- equal? behind a not."
     :meta "The composition is equal? plus a comparison plan. What emerges is the diff family: compare field by field and you get a diff; compare against everything kept and you get a set; compare whole against whole and you get a change flag. The predicate is the same; the granularity is the design decision.")
    (:eng "A diff that names the changed field turns a failing comparison into an actionable one."
     :math "Deduplication by equal? realises the quotient of a list by structural equality."
     :cs "Change detection is one equal? and one not; the cost is a full walk, which is why real systems compare hashes first."))
)

(verb
  :name "not" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(not x) -> boolean"
  :summary "#t when x is #f, and #f for every other value. R7RS-small 6.3."
  :explanation "Logical negation, and the verb that teaches Motoi's truth rule. There is exactly ONE false value: #f. Everything else is true -- 0 is true, the empty string is true, and the empty list is true. That last one catches people arriving from languages where an empty container is falsy: (not '()) is #f, and (if '() 'yes 'no) answers yes. So not is not an emptiness test and not a zero test; it is a test for the single value #f. Its answer is always a boolean, which makes it useful for normalising: (not (not x)) turns any value into the boolean that if would branch on. And because it is a procedure rather than a special form, it composes -- (lambda (x) (not (p x))) is the complement of a predicate and can be handed to filter, unlike the and and or special forms which cannot be passed as values."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(not #f)" :note "#t -- the only argument that makes not answer #t.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (not #f) (not #t) (not 0) (not '()) (not \"\")))\n(newline)" :note "(#t #f #f #f #f) -- #f is false; #t, 0, the empty list and the empty string are all true.")
    (:dialect "motoi" :tier "expert" :code "(define (reject-missing xs) (filter (lambda (x) (not (eq? x 'missing))) xs))\n(display (reject-missing (list 1 'missing 2 'missing 3)))\n(newline)" :note "(1 2 3) -- not turns a predicate into its complement, which filter can use.")
  )
  :caveats ("(not '()) is #f. The empty list is TRUE in Scheme. Test emptiness with null?." "(not 0) is #f. Zero is true. Test for zero with zero?." "(not \"\") is #f. The empty string is true." "not always answers a boolean, so (not (not x)) is the idiom for coercing any value to #t or #f." "Arity is not checked: (not) with no argument answers #f rather than raising.")
  :usecases ("Building the complement of a predicate for filter or remove." "Inverting a guard so the interesting branch reads first." "Coercing an arbitrary value to a boolean with a double not.")
  :related ("boolean?" "null?" "zero?" "eq?")
  :learn (:concept "There is one false value, #f. not is its test; everything else is true." :prerequisites ("boolean?") :progression "Learn the truth rule before learning not, because the rule is what surprises people. Then not, then the complement idiom with filter, then null? and zero? as the tests you actually meant when you were tempted to use not.")
  :provenance "R7RS-small 6.3; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (needs-refill? level) (not (> level 10)))\n(display (map needs-refill? (list 5 10 25)))\n(newline)"
     :math-program "(define (coprime-ish? a b) (not (zero? (remainder a b))))\n(display (list (coprime-ish? 7 3) (coprime-ish? 6 3)))\n(newline)"
     :cs-program "(define (unhandled xs handled) (filter (lambda (x) (not (any (lambda (h) (eq? h x)) handled))) xs))\n(display (unhandled (list 'open 'shut 'melt) (list 'open 'shut)))\n(newline)"
     :problem "The operator wants the negative branch of a threshold check to read first, because that is the branch with the alarm in it. Candidates: not applied to the positive test (one reading, one place to change if the threshold moves), writing the inverted comparison by hand as <= (correct but now the threshold rule exists in two forms and they can drift apart), and swapping the if branches (correct but leaves the reader translating). Negating the ONE stated rule keeps the rule in one place."
     :explanation "eng: a refill alarm that negates the healthy-level test rather than restating it. math: divisibility, expressed as the negation of a zero remainder. cs: finding the events nobody handles, by negating membership."
     :meta "Why not and not a hand-inverted comparison: the hand inversion duplicates the rule. When the threshold changes, one copy gets edited and the other does not, and the bug that follows is invisible in review because both lines look reasonable.")
    (:eng "One rule, one place. Negation keeps the threshold stated once even when both branches need it."
     :math "Negating a divisibility test is the standard way to state coprimality-like conditions."
     :cs "Set difference is exactly filter with a negated membership test."))
  :row-3-dimension (
    (:setup "Turning a question into its opposite without restating the question."
     :rungs ((:domain "the boolean values themselves" :code "(display (list (not #f) (not #t)))\n(newline)")
             (:domain "a signal light driven by a closed-contact sensor" :code "(define (light-state closed?) (if (not closed?) 'green 'red))\n(display (list (light-state #f) (light-state #t)))\n(newline)")
             (:domain "the complement of a predicate over a set" :code "(define (complement p) (lambda (x) (not (p x))))\n(display (list (filter even? (list 1 2 3 4)) (filter (complement even?) (list 1 2 3 4))))\n(newline)"))
     :explanation "On booleans, not is the whole story: it swaps #t and #f. On a workbench, a sensor that reports closed drives a green light through exactly one inversion -- the wiring states the rule once and negates it where the light is. In mathematics the complement of a predicate is that same inversion lifted to a function, which is why the complement of even? partitions a list into the same two pieces from the other side. All three share: one stated rule, and a single operation that flips it."
     :meta "Negation is cheap and total, which is why it is the right way to express an opposite. Restating the opposite is where two truths get written down and one of them goes stale.")
    (:eng "Inverting at the point of use keeps the sensor definition authoritative."
     :math "Complement is an involution on predicates: complementing twice returns the original."
     :cs "not is a procedure, so it composes; and and or are special forms and cannot be passed as values."))
  :row-4-proof (
    (:eng-program "(define vals (list #t #f 0 1 \"\" \"a\" '() (list 1) 'sym #\\c))\n(display (map not vals))\n(newline)"
     :math-program "(define vals (list #t #f 0 \"\" '() 'sym))\n(display (list 'involution (every (lambda (v) (eq? (not (not (not v))) (not v))) vals)))\n(newline)"
     :cs-program "(define vals (list #t #f 0 \"\" '() 'sym (list 1)))\n(display (list 'agrees-with-if\n               (every (lambda (v) (eq? (not v) (if v #f #t))) vals)))\n(newline)"
     :claim "not answers #t for #f alone and #f for every other value -- including 0, the empty string, the empty list, symbols and pairs. Triple negation equals single negation, and not always agrees with the branch if would take."
     :invariant "For all x. not(x) = #t if and only if x = #f; for all x. not(not(not(x))) = not(x); for all x. not(x) = (if x #f #t)"
     :meta "What would falsify it: any value other than #f answering #t, or a disagreement between not and if on the same value. The second invariant is the one that matters in practice -- it says not is exactly the branching rule, so anything you can learn from if you can learn from not.")
    (:eng "A truth rule with one exception is easy to teach and impossible to misremember once the eight-value table has been seen."
     :math "not is an involution on booleans, so triple negation collapses to single -- the algebraic statement of double-negation elimination."
     :cs "not and if share one notion of falsity; a language where they disagreed would be unusable."))
  :row-5-emergence (
    (:eng-composition "(define (remove-if p xs) (filter (lambda (x) (not (p x))) xs))\n(display (list (remove-if null? (list (list 1) '() (list 2) '()))\n               (remove-if string? (list \"a\" 1 \"b\" 2))))\n(newline)"
     :math-composition "(define (nand a b) (not (and a b)))\n(define (nor a b) (not (or a b)))\n(display (list (nand #t #t) (nand #t #f) (nor #f #f) (nor #t #f)))\n(newline)"
     :cs-composition "(define (partition-by p xs)\n  (list 'yes (filter p xs) 'no (filter (lambda (x) (not (p x))) xs)))\n(display (partition-by even? (list 1 2 3 4 5)))\n(newline)"
     :base "not answers #t for #f and #f for everything else."
     :emergent "eng: remove-if, the complement of filter, built by negating any predicate handed to it. math: nand and nor, the two gates from which every other gate can be built. cs: a partition that returns both sides, so nothing is thrown away."
     :meta "The composition is not plus a predicate. What emerges is the complement family: negate inside filter and you get removal; negate outside a connective and you get a universal gate; do both and you get a partition. One inversion, three structures.")
    (:eng "Returning both sides of a partition costs nothing and saves the second pass that discovers the other side was needed after all."
     :math "nand alone is functionally complete: every boolean function can be written with it."
     :cs "filter and remove-if traverse once each; the partition does the work of both in a single pass over the data."))
)

(verb
  :name "null?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(null? x) -> boolean"
  :summary "#t if x is the empty list. R7RS-small 6.4."
  :explanation "The base-case test for every list recursion. It is #t for the empty list and #f for everything else -- including a non-empty list, a pair, #f, 0 and the empty string. Learn it beside two neighbours. pair? is #t for a non-empty list and for a dotted pair; null? and pair? are mutually exclusive, and together they cover every proper list, which is exactly why (if (null? xs) base (recur (cdr xs))) terminates. list? is the whole-shape question and walks the spine to answer it, where null? is a single O(1) check. One thing to know that is specific to Motoi: two separately read empty lists are not eq? to each other, because the empty list is an ordinary empty aggregate in this engine rather than a unique object. That makes null? the ONLY reliable emptiness test here -- (eq? xs '()) is not a substitute, and neither is (not xs), because the empty list is true."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(null? '())" :note "#t -- the empty list.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (null? '()) (null? (list)) (null? (list 1)) (null? #f) (null? 0)))\n(newline)" :note "(#t #t #f #f #f) -- the empty list, however written; and NOT a non-empty list, NOT #f, NOT 0.")
    (:dialect "motoi" :tier "expert" :code "(define (len xs) (if (null? xs) 0 (+ 1 (len (cdr xs)))))\n(display (list (len '()) (len (list 'a 'b 'c))))\n(newline)" :note "(0 3) -- the base case of a list recursion, which is the job null? exists for.")
  )
  :caveats ("(null? #f) is #f. #f and the empty list are different values; only null? tests emptiness." "(null? 0) and (null? \"\") are #f. Emptiness of a list is not emptiness of anything else." "(eq? '() '()) is #f in Motoi, so never test emptiness with eq?. Use null?, which is #t for every empty list." "(not xs) does not test emptiness either: the empty list is TRUE, so (not '()) is #f." "(null? (cons 1 2)) is #f -- a dotted pair is not empty. Use pair? for the other half of the recursion.")
  :usecases ("The base case of a recursion over a list." "Guarding car and cdr so they are only reached on a non-empty list." "Reporting an empty queue, batch or result set.")
  :related ("pair?" "list?" "length" "car" "not")
  :learn (:concept "The base case: null? is the test that ends a list recursion." :prerequisites ("pair?" "list?") :progression "Learn null? and pair? together -- they are the two halves of every list recursion. Then learn list?, which asks the whole-shape question and costs a walk. Then learn why (eq? xs (list)) is not a substitute in this engine.")
  :provenance "R7RS-small 6.4; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (drain queue) (if (null? queue) 'idle (list 'serving (car queue) 'left (length (cdr queue)))))\n(display (list (drain '()) (drain (list 'job-1 'job-2))))\n(newline)"
     :math-program "(define (sum xs) (if (null? xs) 0 (+ (car xs) (sum (cdr xs)))))\n(display (list (sum '()) (sum (list 1 2 3 4))))\n(newline)"
     :cs-program "(define (safe-first xs default) (if (null? xs) default (car xs)))\n(display (list (safe-first '() 'none) (safe-first (list 7 8) 'none)))\n(newline)"
     :problem "The operator is draining a work queue and must report cleanly when there is nothing to do. Candidates: null? (the direct question, O(1), and the same test the recursion already uses), (zero? (length q)) (correct but walks the entire queue to learn one bit, which is O(n) for an O(1) question), and (not q) (simply wrong -- the empty list is TRUE in Scheme, so the branch never fires). One of the three is right, one is wasteful, and one is a bug that looks fine."
     :explanation "eng: a queue drain that reports idle instead of reaching into an empty list. math: a sum over a list, with the empty case answering the additive identity. cs: a total accessor that returns a default instead of raising on the empty list."
     :meta "Why null? and not (zero? (length xs)): length walks the whole spine. On a long list that is an O(n) way to ask an O(1) question, and on a circular structure it does not return at all. Ask the question you mean.")
    (:eng "Reporting idle is a state, not an error; the empty case deserves a named branch rather than a raise."
     :math "The empty case carries the identity element -- 0 for a sum, 1 for a product, the empty list for an append."
     :cs "O(1) against O(n): null? inspects one value, length traverses the spine."))
  :row-3-dimension (
    (:setup "Asking whether there is nothing left, so that a process knows to stop rather than to reach."
     :rungs ((:domain "the empty list itself" :code "(display (list (null? '()) (null? (list 1))))\n(newline)")
             (:domain "an empty shelf on a stock round" :code "(define (shelf-report items) (if (null? items) \"shelf empty\" \"shelf stocked\"))\n(display (list (shelf-report '()) (shelf-report (list 'jar))))\n(newline)")
             (:domain "a set of cardinality zero" :code "(define (cardinality-zero? s) (null? s))\n(display (list (cardinality-zero? '()) (cardinality-zero? (list 'x))))\n(newline)"))
     :explanation "In a program the empty list is the end of the spine, and null? is how a recursion learns it has arrived. On a stock round an empty shelf is a report, not a failure -- the round ends normally and the report says empty. In mathematics the empty set has cardinality zero and is the base case of nearly every inductive definition. All three share: a distinguished nothing that is a legitimate answer rather than an absence of one."
     :meta "Empty is a value, not an error. Systems that treat it as an error grow a special case at every call site; systems that treat it as a value grow a base case in one place.")
    (:eng "An empty result should flow through the same path as a non-empty one, with different content."
     :math "The empty set is the base case of induction and the identity for union -- nothing about it is exceptional."
     :cs "Distinguishing empty from missing is a recurring design decision; null? answers only the first."))
  :row-4-proof (
    (:eng-program "(define vals (list '() (list 1) (cons 1 2) 0 #f \"\" 'nil (vector)))\n(display (map null? vals))\n(newline)"
     :math-program "(define vals (list '() (list 1) (list 1 2) (cons 1 2) 0 #f))\n(display (list 'null-xor-pair (every (lambda (v) (not (and (null? v) (pair? v)))) vals)\n               'list-is-null-or-pair (every (lambda (v) (if (list? v) (or (null? v) (pair? v)) #t)) vals)))\n(newline)"
     :cs-program "(define (walk xs) (if (null? xs) 'done (walk (cdr xs))))\n(display (list (walk '()) (walk (list 1 2 3 4 5))))\n(newline)"
     :claim "null? is #t for the empty list alone -- not for a pair, not for 0, not for #f, not for the empty string, not for an empty vector. null? and pair? are mutually exclusive, and every proper list satisfies exactly one of them, which is what makes a cdr-recursion terminate."
     :invariant "For all x. not(null?(x) and pair?(x)); for all xs. list?(xs) implies (null?(xs) or pair?(xs))"
     :meta "What would falsify it: a value that is both null? and pair?, or a proper list that is neither. The third program is the practical consequence -- a cdr-walk over any proper list reaches the empty list and stops. If the invariant failed, that walk would run off the end.")
    (:eng "Termination is the property being tested; a walk that returns is the evidence."
     :math "The two predicates partition the proper lists, which is the induction principle for lists stated as code."
     :cs "Every list recursion in the chapter rests on this partition; it is the reason the base case is reachable."))
  :row-5-emergence (
    (:eng-composition "(define (compact xs) (filter (lambda (x) (not (null? x))) xs))\n(display (compact (list (list 1) '() (list 2 3) '())))\n(newline)"
     :math-composition "(define (tree-leaves t)\n  (cond ((null? t) '())\n        ((pair? t) (append (tree-leaves (car t)) (tree-leaves (cdr t))))\n        (else (list t))))\n(display (tree-leaves (list 1 (list 2 3) 4)))\n(newline)"
     :cs-composition "(define (chunk xs n)\n  (let loop ((t xs) (acc '()))\n    (if (null? t) (reverse acc)\n        (let inner ((t t) (k n) (piece '()))\n          (if (or (null? t) (zero? k))\n              (loop t (cons (reverse piece) acc))\n              (inner (cdr t) (- k 1) (cons (car t) piece)))))))\n(display (chunk (list 1 2 3 4 5) 2))\n(newline)"
     :base "null? answers whether a value is the empty list."
     :emergent "eng: compacting a list by dropping the empty entries. math: collecting the leaves of a tree, where null? is the case that contributes nothing. cs: chunking a list into fixed-size pieces, where null? ends both the inner and the outer loop."
     :meta "The composition is null? plus a recursion. What emerges is the traversal family: null? as a filter test drops empties; null? as a recursion base gathers leaves; null? as a loop guard slices. One base case, three traversals.")
    (:eng "Dropping empties before a pipeline saves every later stage from carrying a special case."
     :math "The leaf walk is structural recursion with three cases -- empty, pair, atom -- and null? is the first of them."
     :cs "The chunker has two loops and both end on null?; the final chunk is short, and no special case is needed to allow it."))
)

(verb
  :name "pair?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(pair? x) -> boolean"
  :summary "#t if x is a pair -- a cons cell with a car and a cdr. R7RS-small 6.4."
  :explanation "The other half of every list recursion. pair? is #t for anything built by cons, which means it is #t for a non-empty list AND for a dotted pair like (cons 1 2), and #f for the empty list, for atoms, for strings and for vectors. Three neighbours are easy to confuse. null? is #t exactly where pair? is #f on a proper list; the two are mutually exclusive and together cover every proper list. list? asks the stronger question -- is this a FINITE, nil-terminated chain -- and pays a spine walk to answer it, so (list? (cons 1 2)) is #f where (pair? (cons 1 2)) is #t. Reach for pair? when you are about to take a car or a cdr, because that is exactly the operation pair? licenses: car raises on anything that is not a pair, and pair? is #t exactly where car is safe. Reach for list? when you are about to hand the whole thing to something that assumes a proper list, because pair? will happily admit (1 . 2) and the consumer will fail at the dotted end."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(pair? (cons 1 2))" :note "#t -- cons makes a pair.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (pair? (cons 1 2)) (pair? (list 1 2)) (pair? '()) (pair? \"ab\") (pair? (vector 1))))\n(newline)" :note "(#t #t #f #f #f) -- a dotted pair yes; a non-empty list yes; the empty list NO; a string NO; a vector NO.")
    (:dialect "motoi" :tier "expert" :code "(define (deep-count x) (if (pair? x) (+ (deep-count (car x)) (deep-count (cdr x))) 1))\n(display (list (deep-count (list 1 2)) (deep-count (cons 1 2)) (deep-count 'atom)))\n(newline)" :note "(3 2 1) -- counting leaves by descending wherever pair? is #t. The list (1 2) has three leaves because its spine ends in the empty list.")
  )
  :caveats ("(pair? '()) is #f. The empty list is not a pair; that is what makes the null?/pair? split a partition." "(pair? (cons 1 2)) is #t but (list? (cons 1 2)) is #f. pair? admits improper lists; list? does not." "pair? is O(1) -- it looks at one value. list? walks the spine." "(pair? \"ab\") and (pair? (vector 1)) are #f. Strings and vectors are not built from cons cells." "pair? is #t exactly where car and cdr are safe, which is the practical reason to reach for it.")
  :usecases ("Guarding car and cdr in a recursive walk." "Deciding whether a value is a branch or a leaf while descending a tree." "Distinguishing a structured value from an atom before dispatch.")
  :related ("null?" "list?" "car" "cdr" "cons")
  :learn (:concept "The recursive case: pair? is the test that says there is more structure to descend into." :prerequisites ("null?" "cons") :progression "Learn null? and pair? as one lesson -- base case and recursive case. Then meet the dotted pair, which is the value that separates pair? from list?. Then learn list? and what its spine walk costs.")
  :provenance "R7RS-small 6.4; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (head-or xs default) (if (pair? xs) (car xs) default))\n(display (list (head-or (list 1 2) 'none) (head-or '() 'none) (head-or (cons 1 2) 'none)))\n(newline)"
     :math-program "(define (spine-length x) (let loop ((x x) (n 0)) (if (pair? x) (loop (cdr x) (+ n 1)) n)))\n(display (list (spine-length (list 1 2 3)) (spine-length (cons 1 (cons 2 3))) (spine-length 'atom)))\n(newline)"
     :cs-program "(define (flatten x)\n  (cond ((null? x) '())\n        ((pair? x) (append (flatten (car x)) (flatten (cdr x))))\n        (else (list x))))\n(display (list (flatten (list 1 (list 2 3))) (flatten (cons 1 2))))\n(newline)"
     :problem "The operator needs the first element of an incoming value that may be a list, may be a dotted pair, or may be an atom, and must not raise. Candidates: pair? (#t exactly where car is legal, O(1)), list? (also safe but stricter -- it refuses the dotted pair whose car is perfectly readable, and it walks the spine to decide), and calling car inside a guard (works, but uses an exception for control flow and hides a type confusion the caller should have been told about). When the question is may I take the car, pair? IS the question."
     :explanation "eng: a total head-of accessor that answers a default instead of raising, and reads the car of a dotted pair correctly. math: spine length, counted by stepping while pair? holds -- it stops at the dotted end instead of running off it. cs: flatten, where pair? decides branch from leaf."
     :meta "Why pair? and not list?: list? is a stronger claim and costs a walk. If the only operation coming next is car, then the only precondition is pair?, and asking for more admits fewer legal values while doing more work.")
    (:eng "A total accessor with a named default keeps the caller from wrapping every call in a guard."
     :math "Stepping while pair? holds counts the spine of an improper list correctly, which length cannot do."
     :cs "O(1) per node. The walk costs what the structure costs, not what the predicate costs."))
  :row-3-dimension (
    (:setup "Asking whether a thing has parts you can take hold of, or is a single indivisible item."
     :rungs ((:domain "cons cells against atoms" :code "(display (list (pair? (cons 'a 'b)) (pair? 'a)))\n(newline)")
             (:domain "a coupled pair of wagons against a single wagon" :code "(define (has-link? x) (pair? x))\n(display (list (has-link? (cons 'car-1 'car-2)) (has-link? 'car-1)))\n(newline)")
             (:domain "a product node against a leaf in a tree" :code "(define (product-node? x) (pair? x))\n(display (list (product-node? (cons 1 2)) (product-node? 1)))\n(newline)"))
     :explanation "A cons cell has two fields and an atom has none, so pair? is the test for having parts. Coupled wagons have a link you can uncouple; a single wagon does not, and knowing which you have determines whether the next operation is legal. In mathematics a product node has projections -- a first and a second -- while a leaf has none. All three share: a test for decomposability, asked before the decomposition is attempted."
     :meta "Every safe destructuring is a decomposability test followed by a projection. Skipping the test is how a walk over a heterogeneous structure raises on the one atom nobody expected.")
    (:eng "Check before you uncouple; the check is cheaper than the recovery."
     :math "car and cdr are the two projections of the product; pair? is the test that they exist."
     :cs "Pattern matching in other languages compiles to exactly this test followed by these projections."))
  :row-4-proof (
    (:eng-program "(define vals (list (cons 1 2) (list 1) '() 0 #f \"s\" 'sym (vector 1)))\n(display (map pair? vals))\n(newline)"
     :math-program "(define vals (list (cons 1 2) (list 1 2) '() 0 'sym))\n(display (list 'cons-always-pair (every (lambda (v) (pair? (cons v v))) vals)\n               'never-both (every (lambda (v) (not (and (pair? v) (null? v)))) vals)))\n(newline)"
     :cs-program "(define vals (list (cons 1 2) (list 1 2) '() 'atom))\n(display (list 'car-safe-exactly-when-pair\n               (every (lambda (v) (eq? (pair? v) (guard (e (#t #f)) (car v) #t))) vals)))\n(newline)"
     :claim "cons always makes a pair, whatever it is given. No value is both pair? and null?. And pair? is #t exactly where car succeeds -- the third program tests that correspondence by comparing the predicate against a guarded car on four different shapes."
     :invariant "For all x y. pair?(cons(x, y)) = #t; for all x. not(pair?(x) and null?(x)); for all x. pair?(x) = (car x) succeeds"
     :meta "What would falsify it: a cons whose result is not a pair, a value that is both empty and a pair, or a value where the predicate and the actual operation disagree. The third is the invariant worth having, because it is what makes pair? a precondition rather than a description.")
    (:eng "A predicate that exactly matches an operation precondition can be trusted at every call site."
     :math "cons is a total constructor into the pair type; that totality is what makes the recursion well founded."
     :cs "Guarding car and comparing against pair? is the direct test that the predicate is the precondition."))
  :row-5-emergence (
    (:eng-composition "(define (tree-map f x)\n  (cond ((pair? x) (cons (tree-map f (car x)) (tree-map f (cdr x))))\n        ((null? x) '())\n        (else (f x))))\n(display (tree-map (lambda (n) (* 2 n)) (list 1 (list 2 3) 4)))\n(newline)"
     :math-composition "(define (depth x) (if (pair? x) (+ 1 (max (depth (car x)) (depth (cdr x)))) 0))\n(display (list (depth (list 1 2)) (depth (list 1 (list 2 (list 3))))))\n(newline)"
     :cs-composition "(define (assoc-walk k x)\n  (cond ((and (pair? x) (equal? (car x) k)) (cdr x))\n        ((pair? x) (or (assoc-walk k (car x)) (assoc-walk k (cdr x))))\n        (else #f)))\n(display (list (assoc-walk 'b (list (cons 'a 1) (cons 'b 2))) (assoc-walk 'z (list (cons 'a 1)))))\n(newline)"
     :base "pair? answers whether a value is a cons cell with parts to take."
     :emergent "eng: tree-map, applying a function at every leaf while rebuilding the structure. math: depth, the longest chain of nested pairs. cs: a search that descends both car and cdr until it finds a matching key."
     :meta "The composition is pair? plus a two-way descent. What emerges is the tree family: rebuild as you descend and you get a map; count as you descend and you get a measure; stop on a hit and you get a search. Same test, three things done at the node.")
    (:eng "Rebuilding rather than mutating leaves the input intact, so a failed walk costs nothing."
     :math "Depth over the pair structure counts the spine and the nesting together, because both are pairs."
     :cs "The car-then-cdr descent visits every node exactly once; the or short-circuits on the first hit."))
)

(verb
  :name "boolean?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(boolean? x) -> boolean"
  :summary "#t if x is #t or #f. R7RS-small 6.3."
  :explanation "The narrowest type predicate in the chapter: its domain has exactly two members. It is worth knowing precisely because Scheme's truth rule is so wide. Every value except #f is TRUE in a conditional, so if branches happily on 0, on a string, on the empty list -- but only two values are BOOLEANS. That distinction matters at the edges of a system: a configuration field declared as a flag should hold #t or #f, and a 1 arriving in its place is a schema error even though it would branch identically. boolean? is how you say so. Inside a program it is rarely needed, because you already know what you built; at a boundary -- reading a settings record, validating a payload, checking that a predicate really returned a predicate's answer -- it is the right question. Note that Motoi's own predicates all return real booleans, which the proof row checks, so a value that fails boolean? did not come from one of them."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(boolean? #t)" :note "#t -- #t is a boolean.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (boolean? #t) (boolean? #f) (boolean? 0) (boolean? '()) (boolean? 'true)))\n(newline)" :note "(#t #t #f #f #f) -- #t and #f yes; 0, the empty list and the symbol true NO, even though all three are TRUE in a conditional.")
    (:dialect "motoi" :tier "expert" :code "(define (as-flag x) (if (boolean? x) x (if x #t #f)))\n(display (list (as-flag #t) (as-flag 0) (as-flag #f) (as-flag \"on\")))\n(newline)" :note "(#t #t #f #t) -- normalising any value to a boolean, leaving real booleans untouched.")
  )
  :caveats ("(boolean? 0) is #f, but 0 is still TRUE in a conditional. Being a boolean and being true are different questions." "(boolean? '()) is #f, and the empty list is also true." "(boolean? 'true) is #f. A symbol spelled like a truth value is not one." "Use (not (not x)) to coerce any value into a boolean; boolean? only tests, it does not convert." "All of Motoi's standard predicates return real booleans, so boolean? is a boundary check, not an internal one.")
  :usecases ("Validating that a configuration flag really holds a flag." "Checking a payload field against a declared schema." "Separating flags from values when reporting a settings record.")
  :related ("not" "eq?" "symbol?" "number?")
  :learn (:concept "Being a boolean and being true are two different questions; Scheme has two booleans and one false value." :prerequisites ("not") :progression "Learn the truth rule first, then not, then boolean? as the test that distinguishes the two-element boolean type from the wide notion of truth. Use it at boundaries, not inside code you wrote yourself.")
  :provenance "R7RS-small 6.3; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (validate-setting k v) (if (boolean? v) (list k 'ok) (list k 'expected-boolean v)))\n(display (list (validate-setting 'fullscreen #t) (validate-setting 'fullscreen 1)))\n(newline)"
     :math-program "(define (all-boolean? xs) (every boolean? xs))\n(display (list (all-boolean? (list #t #f #t)) (all-boolean? (list #t 1))))\n(newline)"
     :cs-program "(define (schema-check pairs) (map (lambda (p) (cons (car p) (boolean? (cdr p)))) pairs))\n(display (schema-check (list (cons 'a #t) (cons 'b 0))))\n(newline)"
     :problem "The operator is validating a settings record in which fullscreen is declared to be a flag. Candidates: boolean? (says exactly what the schema says), accepting anything and relying on the truth rule (which silently accepts 1, and then a later == comparison against #t fails in a distant file), and comparing with (eq? v #t) (which rejects the perfectly legal #f). Only the first states the schema."
     :explanation "eng: a per-field validator that names the field and the offending value. math: a whole-list check with every, so one bad field fails the record. cs: a schema report that pairs each key with whether it type-checked."
     :meta "Why boolean? and not just relying on truthiness: truthiness accepts 1 and \"yes\" and the empty list. If the schema says flag, a validator that accepts a number has not validated anything -- it has just deferred the failure to somewhere with less context.")
    (:eng "A validation message that names the field and the value is the difference between a five-minute fix and an afternoon."
     :math "boolean? is the characteristic function of a two-element set, the smallest non-trivial type in the language."
     :cs "Boundary validation belongs at the boundary; past it, the program should be able to trust its own values."))
  :row-3-dimension (
    (:setup "Asking whether a value belongs to a type with exactly two members, rather than merely behaving like one."
     :rungs ((:domain "the two boolean values" :code "(display (list (boolean? #t) (boolean? 'yes)))\n(newline)")
             (:domain "a two-position switch on a panel" :code "(define (switch-value? v) (boolean? v))\n(display (list (switch-value? #f) (switch-value? \"off\")))\n(newline)")
             (:domain "membership of a two-element set" :code "(define (in-two-element-set? v) (boolean? v))\n(display (list (in-two-element-set? #t) (in-two-element-set? 2)))\n(newline)"))
     :explanation "In the language there are exactly two booleans and boolean? is their test. On a panel a two-position switch is either up or down -- a dial that happens to be at one end is not a switch, even though you could read it as one. In mathematics this is membership of a two-element set, the smallest set that can carry information at all. All three share: a type whose extent is fully enumerable, so the test can be stated exactly rather than approximately."
     :meta "The smaller the type, the more precise the test can be. boolean? is the extreme case: two members, no edge cases, nothing to argue about.")
    (:eng "A switch and a dial are different components; conflating them at the interface is how a control panel becomes ambiguous."
     :math "A two-element set carries exactly one bit, which is why it is the unit of information."
     :cs "Enumerable types admit exhaustive tests; that is why the proof row can check every case rather than sample."))
  :row-4-proof (
    (:eng-program "(define vals (list #t #f 0 1 \"\" '() 'sym (list 1)))\n(display (map boolean? vals))\n(newline)"
     :math-program "(define vals (list #t #f 0 \"\" '() 'sym))\n(display (list 'exactly-two (every (lambda (v) (if (boolean? v) (or (eq? v #t) (eq? v #f)) #t)) vals)\n               'not-closes (every (lambda (v) (boolean? (not v))) vals)))\n(newline)"
     :cs-program "(define vals (list #t #f 0 \"\" '() 'sym))\n(display (list 'predicates-return-booleans\n               (every (lambda (v) (and (boolean? (null? v)) (boolean? (pair? v)) (boolean? (symbol? v)))) vals)))\n(newline)"
     :claim "boolean? is #t for #t and #f alone. not always returns a boolean, whatever it is given, so not is a total coercion into the type. And the standard predicates in this chapter all return real booleans -- null?, pair? and symbol? are checked against every kind of value."
     :invariant "For all x. boolean?(x) implies (x = #t or x = #f); for all x. boolean?(not(x)) = #t; for all x. boolean?(null?(x)) and boolean?(pair?(x)) and boolean?(symbol?(x))"
     :meta "What would falsify it: a third boolean, a not that returned something else, or a predicate that returned a non-boolean truthy value. The last is a real failure mode in languages where a predicate returns the found element instead of #t; the test pins it shut here.")
    (:eng "A predicate that returns a truthy non-boolean is usable but not composable; checking the return type keeps the API honest."
     :math "not is a total function from the universe onto the two-element set -- a retraction, not merely a negation."
     :cs "Returning real booleans is what lets a predicate be handed to every, any and filter without surprises."))
  :row-5-emergence (
    (:eng-composition "(define (settings-report s) (map (lambda (p) (list (car p) (if (boolean? (cdr p)) 'flag 'value))) s))\n(display (settings-report (list (cons 'grid #t) (cons 'zoom 2))))\n(newline)"
     :math-composition "(define (truth-table f) (map (lambda (p) (list (car p) (cdr p) (f (car p) (cdr p))))\n                             (list (cons #t #t) (cons #t #f) (cons #f #t) (cons #f #f))))\n(display (truth-table (lambda (a b) (and a b))))\n(newline)"
     :cs-composition "(define (coerce-flags xs) (map (lambda (x) (if (boolean? x) x (not (not x)))) xs))\n(display (coerce-flags (list #t 0 '() #f \"x\")))\n(newline)"
     :base "boolean? answers whether a value is one of the two booleans."
     :emergent "eng: a settings report that labels each entry a flag or a value. math: a truth table, generated by running a two-argument function over all four boolean inputs. cs: coercion of a mixed list into real booleans, leaving genuine booleans alone."
     :meta "The composition is boolean? plus a decision about what to do with the answer. What emerges is the schema family: label it, enumerate it, or coerce it. Report when you want the operator to decide, coerce when the program can.")
    (:eng "Labelling before coercing lets a human see what would have been silently changed."
     :math "Four rows is the whole domain of a two-argument boolean function, so the table IS the function."
     :cs "Coercion at the boundary means one place converts and the rest of the program can assume the type."))
)

(verb
  :name "symbol?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(symbol? x) -> boolean"
  :summary "#t if x is a symbol. R7RS-small 6.5."
  :explanation "Symbols are the names in a Scheme program: quoted identifiers like 'north, and anything string->symbol produces. symbol? tests for them. What makes symbols worth a predicate of their own is that they are INTERNED -- two occurrences of the same name are the same object, so (eq? (string->symbol \"alpha\") (string->symbol \"alpha\")) is #t. That is why symbols are the right key for a dispatch table and the wrong thing to build at high volume out of user input. The confusion to clear up is symbol against string. They print the same under display, so 'north and \"north\" look identical in output, but (symbol? \"north\") is #f and (string? 'north) is #f. Use write instead of display when you need to tell them apart, or symbol->string and string->symbol to move deliberately between them. The rule of thumb: a symbol is a NAME the program reasons about; a string is TEXT the program manipulates or shows to a person."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(symbol? 'north)" :note "#t -- a quoted identifier is a symbol.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (symbol? 'north) (symbol? \"north\") (symbol? '()) (symbol? (string->symbol \"made-up\"))))\n(newline)" :note "(#t #f #f #t) -- a quoted name yes; the string spelled the same NO; the empty list NO; a symbol built by string->symbol yes.")
    (:dialect "motoi" :tier "expert" :code "(define (name-of x) (cond ((symbol? x) (symbol->string x)) ((string? x) x) (else \"?\")))\n(display (list (name-of 'idle) (name-of \"idle\") (name-of 42)))\n(newline)" :note "(idle idle ?) -- accepting either a symbol or a string and normalising to text. Note the first two print identically, which is the whole confusion.")
  )
  :caveats ("(symbol? \"north\") is #f. A string that prints like a symbol is not one -- display shows them the same, write does not." "Symbols are interned: (eq? (string->symbol \"a\") (string->symbol \"a\")) is #t, which is what makes eq? the right comparison for them." "(symbol? '()) is #f. The empty list is not a name." "symbol->string and string->symbol convert; symbol? only tests." "Building symbols in bulk from untrusted input interns them permanently. Keep high-cardinality data in strings.")
  :usecases ("Collecting the free variables of an expression." "Deciding whether a token is an identifier or a literal." "Substituting bindings into a symbolic expression.")
  :related ("string?" "eq?" "string->symbol" "symbol->string" "pair?")
  :learn (:concept "A symbol is a name the program reasons about; a string is text the program manipulates." :prerequisites ("eq?" "string?") :progression "Learn symbol? beside string?, since the two are the pair people confuse. Then learn interning, which is why symbols are compared with eq?. Then use symbols as keys and expression atoms, and strings for anything a person reads.")
  :provenance "R7RS-small 6.5; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (route ev) (if (symbol? ev) (list 'dispatch ev) (list 'reject ev)))\n(display (list (route 'tick) (route \"tick\")))\n(newline)"
     :math-program "(define (free-variables expr)\n  (cond ((symbol? expr) (list expr))\n        ((pair? expr) (append (free-variables (car expr)) (free-variables (cdr expr))))\n        (else '())))\n(display (free-variables (list '+ 'x (list '* 'y 2))))\n(newline)"
     :cs-program "(define (tokens->kinds ts) (map (lambda (t) (cond ((symbol? t) 'ident) ((number? t) 'literal) (else 'other))) ts))\n(display (tokens->kinds (list 'x 1 \"s\" 'y)))\n(newline)"
     :problem "The operator's event router accepts a symbol and must reject text that merely looks like one, because display prints 'tick and \"tick\" identically and a mistyped quote would otherwise sail through. Candidates: symbol? (asks the real question), comparing against a list of known event names with equal? (accepts the string too, since equal? on a symbol against a string is #f but the author usually writes the check the other way and does not notice), and converting everything with string->symbol first (accepts the bug by erasing it, and interns whatever arrives). Only symbol? distinguishes name from text."
     :explanation "eng: a router that dispatches symbols and rejects strings, with both cases shown so the identical printing is visible. math: collecting the free variables of an expression, where symbol? marks the leaves that are names. cs: classifying a token stream into identifiers, literals and everything else."
     :meta "Why symbol? and not a conversion: converting makes the bug unobservable. The point of a boundary check is to notice the wrong kind of value, not to absorb it.")
    (:eng "Rejecting at the boundary with the offending value in the message beats accepting and failing later."
     :math "The free variables of an expression are exactly its symbol leaves; the walk IS the definition."
     :cs "A lexer classifies by type predicate; symbol? is the identifier case of that classification."))
  :row-3-dimension (
    (:setup "Distinguishing a name that denotes something from the text that spells the name."
     :rungs ((:domain "symbols against strings" :code "(display (list (symbol? 'stone) (symbol? \"stone\")))\n(newline)")
             (:domain "a bin label against a description of the bin" :code "(define (label? x) (symbol? x))\n(display (list (label? 'bin-4) (label? 4)))\n(newline)")
             (:domain "an atom of a syntax tree against a compound term" :code "(define (atom-of-syntax? x) (symbol? x))\n(display (list (atom-of-syntax? 'x) (atom-of-syntax? (list 'x))))\n(newline)"))
     :explanation "In a program, a symbol denotes and a string spells; they print the same and are not the same. On a shop floor a bin label is an identifier -- bin-4 refers to one bin, and any two tags reading bin-4 mean that same bin. In logic an atomic term is a name in the language, distinct from the compound terms built from it. All three share: a level distinction between the thing used as a name and the material the name is made of."
     :meta "Confusing a name with its spelling is the oldest bug in symbol processing. The predicate is how a program keeps the two levels apart.")
    (:eng "Labels are identifiers, not descriptions; two bins can share a description and must not share a label."
     :math "Atoms and compound terms are the two cases of the term grammar, and every recursion over terms splits on them."
     :cs "Interning is the implementation that makes a name comparison a pointer comparison."))
  :row-4-proof (
    (:eng-program "(define vals (list 'a (string->symbol \"b\") \"c\" 1 #\\d #t '() (list 1)))\n(display (map symbol? vals))\n(newline)"
     :math-program "(define names (list \"alpha\" \"beta\" \"gamma\"))\n(display (list 'roundtrip (every (lambda (s) (and (symbol? (string->symbol s))\n                                                  (equal? s (symbol->string (string->symbol s))))) names)\n               'interned (every (lambda (s) (eq? (string->symbol s) (string->symbol s))) names)))\n(newline)"
     :cs-program "(define vals (list 'a \"a\" 1 #\\a #t '()))\n(display (list 'symbol-excludes-string (every (lambda (v) (not (and (symbol? v) (string? v)))) vals)))\n(newline)"
     :claim "symbol? is #t for quoted names and for anything string->symbol produces, and #f for strings, numbers, characters, booleans, the empty list and lists. The conversion round-trips: string->symbol then symbol->string returns the original text, and the same name interns to one object every time. No value is both a symbol and a string."
     :invariant "For all strings s. symbol?(string->symbol(s)) and symbol->string(string->symbol(s)) = s; for all strings s. eq?(string->symbol(s), string->symbol(s)); for all x. not(symbol?(x) and string?(x))"
     :meta "What would falsify it: a name that did not survive the round trip, two conversions of one name producing distinct objects, or a value passing both predicates. The interning test is the load-bearing one -- it is the licence to compare symbols with eq?.")
    (:eng "A round-trip test is the cheapest way to pin a pair of conversions to each other."
     :math "string->symbol and symbol->string are mutually inverse on the text they share."
     :cs "Interning turns name equality into pointer equality, which is why symbol dispatch is O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (substitute env expr)\n  (cond ((symbol? expr) (let ((hit (assq expr env))) (if hit (cdr hit) expr)))\n        ((pair? expr) (cons (substitute env (car expr)) (substitute env (cdr expr))))\n        (else expr)))\n(display (substitute (list (cons 'x 10)) (list '+ 'x 'y)))\n(newline)"
     :math-composition "(define (symbol-set expr)\n  (fold-right (lambda (s acc) (if (any (lambda (t) (eq? s t)) acc) acc (cons s acc)))\n              '()\n              (let walk ((e expr)) (cond ((symbol? e) (list e)) ((pair? e) (append (walk (car e)) (walk (cdr e)))) (else '())))))\n(display (symbol-set (list '+ 'x (list '* 'x 'y))))\n(newline)"
     :cs-composition "(define (keyword-count expr words)\n  (let walk ((e expr) (n 0))\n    (cond ((symbol? e) (if (any (lambda (w) (eq? w e)) words) (+ n 1) n))\n          ((pair? e) (walk (cdr e) (walk (car e) n)))\n          (else n))))\n(display (keyword-count (list 'if 'x (list 'if 'y 1 2) 3) (list 'if)))\n(newline)"
     :base "symbol? answers whether a value is a name."
     :emergent "eng: substitution -- walking an expression and replacing the symbols that have bindings. math: the symbol set of an expression, deduplicated with eq?. cs: counting keyword occurrences in a nested form."
     :meta "The composition is symbol? plus a walk over an expression. What emerges is the symbolic-processing family: replace at the symbol leaves and you get substitution; collect them and you get the variable set; count them and you get a static measure. This is the shape every interpreter and every algebra system is built from.")
    (:eng "Substitution rebuilds rather than mutates, so the original expression stays available for comparison."
     :math "The symbol set is the support of the expression -- what it depends on."
     :cs "Static analysis is this walk with a different accumulator; the traversal is the reusable part."))
)

(verb
  :name "string?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(string? x) -> boolean"
  :summary "#t if x is a string. R7RS-small 6.7."
  :explanation "The test for text. It is #t for a string literal, for the empty string, and for anything the string procedures or number->string produce; it is #f for symbols, characters, numbers and lists of characters. Two things make it more load-bearing in Motoi than a type predicate usually is. First, symbols and strings print IDENTICALLY under display, so 'north and \"north\" are indistinguishable in output and only string? or write can tell them apart. Second -- and this is measured, not assumed -- Motoi's string procedures do not type-check their argument: (string-length 'abc) answers 3 rather than raising, because the value is coerced to text first. So string? is not a redundant belt-and-braces check here; it is the guard, and if you skip it a symbol or a number will flow through a string pipeline and produce a plausible wrong answer instead of an error. Motoi's strings are also immutable: string-set! raises, which is why two equal strings are eq? in this engine."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(string? \"hello\")" :note "#t -- a string literal.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (string? \"hello\") (string? 'hello) (string? #\\h) (string? (number->string 42))))\n(newline)" :note "(#t #f #f #t) -- a literal yes; the symbol spelled the same NO; a character NO; the output of number->string yes.")
    (:dialect "motoi" :tier "expert" :code "(define (join xs sep) (fold (lambda (x acc) (if (equal? acc \"\") x (string-append acc sep x))) \"\" (filter string? xs)))\n(display (join (list \"a\" 1 \"b\" 'c \"d\") \"-\"))\n(newline)" :note "a-b-d -- joining only the string elements of a mixed list. The non-strings are filtered out, not coerced.")
  )
  :caveats ("(string? 'north) is #f, but display prints 'north and \"north\" identically. Use write when you need to see which you have." "(string-length 'abc) answers 3 rather than raising -- Motoi's string procedures coerce. string? is the guard you must apply yourself." "(string? #\\h) is #f. A character is not a one-character string." "Motoi strings are immutable: string-set! raises. That is why two equal strings are eq? here." "(string? \"\") is #t. The empty string is a string, and it is TRUE in a conditional.")
  :usecases ("Filtering the text elements out of a mixed list." "Validating a row before handing it to string operations." "Choosing a rendering branch for a heterogeneous value.")
  :related ("symbol?" "string-length" "string-append" "number->string" "char?")
  :learn (:concept "Text is its own type, and in Motoi the string procedures will not tell you when it is missing -- string? will." :prerequisites ("symbol?" "string-length") :progression "Learn string? beside symbol?, because display makes them look the same. Then learn that the string procedures coerce, which is what makes the guard necessary. Then learn the conversions -- number->string, symbol->string -- as the deliberate way in.")
  :provenance "R7RS-small 6.7; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (render x) (cond ((string? x) x) ((number? x) (number->string x)) ((symbol? x) (symbol->string x)) (else \"?\")))\n(display (map render (list \"a\" 2 'c #t)))\n(newline)"
     :math-program "(define (total-length xs) (fold (lambda (x n) (if (string? x) (+ n (string-length x)) n)) 0 xs))\n(display (list (total-length (list \"ab\" 1 \"cde\")) (total-length (list 1 2))))\n(newline)"
     :cs-program "(define (validate-row r) (if (every string? r) 'ok (list 'bad-row r)))\n(display (list (validate-row (list \"a\" \"b\")) (validate-row (list \"a\" 2))))\n(newline)"
     :problem "The operator is rendering a heterogeneous list for display and must not hand a non-string to a string procedure. Candidates: string? (asks the question and lets each other type take its own conversion branch), calling string-append on everything (which in Motoi does NOT raise -- it coerces, so a symbol renders as text that looks right until the day it does not), and converting everything with a single generic writer (loses the distinction the render function exists to make). Because the string procedures coerce, the type check has to be explicit."
     :explanation "eng: a renderer with one branch per type and a fallback. math: total character length across the string elements only. cs: row validation, rejecting a row that is not all text."
     :meta "Why string? and not just calling the string procedure: in a language that raises, the missing check shows up as an error. In Motoi it shows up as a plausible answer. A silent wrong answer is the expensive kind.")
    (:eng "A renderer with an explicit fallback branch tells you when a new type arrived; a coercing one does not."
     :math "Summing lengths over the string subset is a fold over a filtered domain -- the filter is the predicate."
     :cs "Validate whole rows, not cells, when downstream code assumes homogeneity."))
  :row-3-dimension (
    (:setup "Asking whether a value is the material a text operation is allowed to work on."
     :rungs ((:domain "strings against symbols" :code "(display (list (string? \"text\") (string? 'text)))\n(newline)")
             (:domain "a printed label against the number stamped on the part" :code "(define (label-printable? x) (string? x))\n(display (list (label-printable? \"BIN 4\") (label-printable? 4)))\n(newline)")
             (:domain "a word over an alphabet against a sequence of letters" :code "(define (word-in-alphabet? x) (string? x))\n(display (list (word-in-alphabet? \"abc\") (word-in-alphabet? (list #\\a #\\b))))\n(newline)"))
     :explanation "In a program a string is text and a symbol is a name, and only string? separates them. On a workbench a printed label is text -- BIN 4 -- while the number 4 stamped in the metal is a quantity; you can read both, but only one is legend. In formal language theory a word is an element of the free monoid over an alphabet, which is not the same object as the list of its letters. All three share: text as a thing in its own right, distinct from what it depicts and from the parts it is made of."
     :meta "A type predicate marks the boundary of a domain of operations. Outside that boundary the operations are undefined -- or worse, in a coercing runtime, defined but meaningless.")
    (:eng "Legend and quantity are different fields on a drawing; a system that merges them cannot round-trip."
     :math "The free monoid over an alphabet is generated by concatenation, with the empty string as identity."
     :cs "A list of characters and a string are different representations with different costs; the predicate names which one you have."))
  :row-4-proof (
    (:eng-program "(define vals (list \"a\" \"\" 'a #\\a 1 #t '() (list \"a\")))\n(display (map string? vals))\n(newline)"
     :math-program "(define ss (list \"\" \"a\" \"abc\"))\n(display (list 'append-closed (every (lambda (a) (every (lambda (b) (string? (string-append a b))) ss)) ss)\n               'length-adds (every (lambda (a) (every (lambda (b) (= (string-length (string-append a b))\n                                                                     (+ (string-length a) (string-length b)))) ss)) ss)))\n(newline)"
     :cs-program "(define vals (list \"abc\" 'abc 12))\n(display (list 'string? (map string? vals) 'string-length-answers-anyway (map string-length vals)))\n(newline)"
     :claim "string? is #t for strings including the empty one, and #f for symbols, characters, numbers, booleans, the empty list and lists. Strings are closed under append and lengths add. And -- measured, not assumed -- string-length answers for a symbol and for a number instead of raising, so string? is the only guard."
     :invariant "For all strings a b. string?(append(a, b)) and length(append(a, b)) = length(a) + length(b); for all x. string?(x) implies string-length(x) is meaningful -- the converse does NOT hold in Motoi"
     :meta "What would falsify the first two: an append that left the type or lost a character. The third program is not a proof but a MEASUREMENT, and it deliberately prints the wrong-looking answers rather than asserting they raise, because that is what the engine does today and a reader who assumes otherwise will skip the guard.")
    (:eng "Measure the runtime rather than assuming it; the assumption here would cost a silent data corruption."
     :math "Strings under append with the empty string form a monoid, and the length map is a homomorphism to the naturals."
     :cs "A coercing library shifts the type-checking burden onto the caller; the reference has to say so plainly."))
  :row-5-emergence (
    (:eng-composition "(define (report xs) (map (lambda (x) (if (string? x) (string-append \"[\" x \"]\") x)) xs))\n(display (report (list \"ok\" 1 \"fail\")))\n(newline)"
     :math-composition "(define (longest xs) (fold (lambda (x best) (if (and (string? x) (> (string-length x) (string-length best))) x best)) \"\" xs))\n(display (list (longest (list \"a\" \"abcd\" 'zz \"ab\")) (longest (list 1 2))))\n(newline)"
     :cs-composition "(define (stringify-all xs) (map (lambda (x) (if (string? x) x (if (number? x) (number->string x) (symbol->string x)))) xs))\n(display (stringify-all (list \"a\" 2 'c)))\n(newline)"
     :base "string? answers whether a value is text."
     :emergent "eng: a report that decorates the text entries and leaves everything else alone. math: the longest string in a mixed list, with the empty string as the starting point so the empty case needs no branch. cs: normalising a mixed list to all-text by dispatching on type."
     :meta "The composition is string? plus a fold or a map. What emerges is the mixed-list family: decorate the matches, select an extreme among them, or convert everything to one type. Seeding the fold with the identity of the domain -- the empty string -- is what removes the special case.")
    (:eng "Decorating only what matches keeps the rest of the record intact for whatever needs it next."
     :math "The empty string is the identity for append and the minimum for length, which makes it the right fold seed."
     :cs "Normalising to one type at the boundary means the rest of the pipeline has no type checks in it at all."))
)

(verb
  :name "number?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(number? x) -> boolean"
  :summary "#t if x is a number of any kind -- integer, rational or real. R7RS-small 6.2."
  :explanation "The widest gate of the numeric tower. number? is #t for every value the arithmetic procedures accept: integers, exact rationals like 1/2, and reals like 3.5. It is #f for strings, symbols, characters and booleans -- notably (number? \"42\") is #f and (number? #\\1) is #f, which is the check that separates text that LOOKS numeric from a number. The narrower predicates below it answer narrower questions: integer? asks whether the value is a whole number, rational? and real? name places in the tower, and exact? asks about representation. Use number? when the only thing you need to know is may I do arithmetic with this. The idiomatic pairing is with string->number, which answers #f rather than raising when the text does not parse -- so (if (number? (string->number s)) ...) is the safe parse, and it is safe precisely because number? rejects the #f that a failed parse returns."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(number? 42)" :note "#t -- an integer is a number.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (number? 42) (number? 3.5) (number? 1/2) (number? \"42\") (number? 'x)))\n(newline)" :note "(#t #t #t #f #f) -- integer, real and exact rational yes; the string \"42\" NO; a symbol NO.")
    (:dialect "motoi" :tier "expert" :code "(define (sum-numbers xs) (fold + 0 (filter number? xs)))\n(display (list (sum-numbers (list 1 \"a\" 2.5 'b 3)) (sum-numbers (list 'a \"b\"))))\n(newline)" :note "(6.5 0) -- summing only the numeric elements of a mixed list; the empty case answers the additive identity.")
  )
  :caveats ("(number? \"42\") is #f. Text that looks numeric is not a number -- convert with string->number first." "(number? #\\1) is #f. The character 1 is not the number 1." "number? is the widest numeric test. It says nothing about whether the value is a whole number; that is integer?." "string->number answers #f on a failed parse, so number? is the right test on its result." "A non-number passed to zero?, positive?, negative?, even? or odd? answers #f in Motoi rather than raising, so number? is the guard that catches the confusion.")
  :usecases ("Summing or averaging the numeric entries of a mixed list." "Validating a parsed cell before arithmetic." "Routing a heterogeneous value to a numeric or a text branch.")
  :related ("integer?" "exact?" "real?" "string->number" "zero?")
  :learn (:concept "One gate for the whole numeric tower: number? asks only whether arithmetic is allowed." :prerequisites ("integer?" "string->number") :progression "Learn number? first as the wide gate, then the narrower questions -- integer? for wholeness, exact? for representation. Then pair number? with string->number, which is the safe parse idiom.")
  :provenance "R7RS-small 6.2; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (safe-scale x k) (if (number? x) (* x k) 'skipped))\n(display (map (lambda (x) (safe-scale x 2)) (list 3 \"3\" 'three 1.5)))\n(newline)"
     :math-program "(define (mean xs) (let ((ns (filter number? xs))) (if (null? ns) 'undefined (/ (fold + 0 ns) (length ns)))))\n(display (list (mean (list 1 2 3 'x)) (mean (list 'x))))\n(newline)"
     :cs-program "(define (parse-cell s) (let ((n (string->number s))) (if (number? n) n s)))\n(display (map parse-cell (list \"12\" \"abc\" \"3.5\")))\n(newline)"
     :problem "The operator is scaling values out of a spreadsheet column that contains numbers, numeric-looking text and stray symbols. Candidates: number? (asks whether arithmetic is legal, which is the actual precondition), integer? (too narrow -- it would skip the 1.5 that is perfectly scalable), and multiplying and catching the failure (which in Motoi may not fail at all, since the numeric predicates answer #f rather than raising on the wrong type). number? is the gate that matches the operation."
     :explanation "eng: a scale that skips what it cannot multiply and says so. math: a mean over the numeric subset, with a named undefined answer when the subset is empty. cs: cell parsing where string->number decides and number? checks its answer."
     :meta "Why number? and not integer?: the precondition for multiplication is being a number, not being whole. Narrowing a guard past the operation it protects silently drops legal data, and dropped data is harder to notice than a raised error.")
    (:eng "Skipping with a marker beats skipping silently; the marker is what makes the drop visible in the output."
     :math "The mean of the empty set is undefined, and saying so is more honest than answering 0."
     :cs "A parse that returns #f on failure composes with a predicate; a parse that raises needs a guard at every call site."))
  :row-3-dimension (
    (:setup "Asking whether a value belongs to the domain where arithmetic is defined at all."
     :rungs ((:domain "numbers against numeric-looking text" :code "(display (list (number? 7) (number? \"7\")))\n(newline)")
             (:domain "a measured quantity against the name of a quantity" :code "(define (measurable? x) (number? x))\n(display (list (measurable? 12) (measurable? 'twelve)))\n(newline)")
             (:domain "membership of the numeric tower" :code "(define (in-numeric-tower? x) (number? x))\n(display (list (in-numeric-tower? 1) (in-numeric-tower? 1/2) (in-numeric-tower? 1.5) (in-numeric-tower? #\\1)))\n(newline)"))
     :explanation "In a program, 7 and \"7\" print the same under display and only one can be added to. On a workbench a measured length is a quantity you can halve; the word twelve on a work order is a name for one, and halving it is not an operation. In mathematics the numeric tower is a nest of domains -- integers inside rationals inside reals -- and number? is membership of the outermost. All three share: a domain boundary that decides which operations even have meaning."
     :meta "Type predicates mark where operations are defined. Outside the domain the operation is not slow or wrong; it is meaningless, and a runtime that answers anyway is hiding that.")
    (:eng "Units and quantities belong together; a bare name is not a measurement."
     :math "The tower is an inclusion chain, so the outer predicate is the weakest and the safest gate."
     :cs "Parsing is the boundary crossing from text into the numeric domain, and it can fail."))
  :row-4-proof (
    (:eng-program "(define vals (list 1 -1 0 1.5 1/2 \"1\" 'one #\\1 #t '()))\n(display (map number? vals))\n(newline)"
     :math-program "(define ns (list 0 1 -3 1.5 1/2))\n(display (list 'closed-under-+ (every (lambda (a) (every (lambda (b) (number? (+ a b))) ns)) ns)\n               'closed-under-* (every (lambda (a) (every (lambda (b) (number? (* a b))) ns)) ns)))\n(newline)"
     :cs-program "(define vals (list 1 1.5 1/2 \"1\" 'one))\n(display (list 'number-implies-comparable\n               (every (lambda (v) (if (number? v) (boolean? (= v v)) #t)) vals)))\n(newline)"
     :claim "number? is #t for integers, negatives, zero, reals and exact rationals, and #f for strings, symbols, characters, booleans and the empty list. The numbers are closed under addition and multiplication, and any number can be compared with = to itself, yielding a real boolean."
     :invariant "For all numbers a b. number?(a + b) and number?(a * b); for all x. number?(x) implies boolean?(= x x)"
     :meta "What would falsify it: an arithmetic result that left the numeric domain, or a number that could not be compared. Closure is the property that lets a fold over numbers be written without a type check in the loop -- the check happens once, at the filter.")
    (:eng "Check once at the boundary, then trust the domain; a type check inside a hot fold is a design smell."
     :math "Closure under the operations is what makes the numbers a ring, and what makes fold over them total."
     :cs "A predicate that returns a real boolean composes with every, any and filter without surprises."))
  :row-5-emergence (
    (:eng-composition "(define (summary xs)\n  (let ((ns (filter number? xs)))\n    (if (null? ns) 'no-numbers\n        (list 'count (length ns) 'sum (fold + 0 ns) 'min (fold min (car ns) ns) 'max (fold max (car ns) ns)))))\n(display (summary (list 3 \"x\" 1 'y 7)))\n(newline)"
     :math-composition "(define (numeric-partition xs)\n  (list 'ints (filter (lambda (x) (and (number? x) (integer? x))) xs)\n        'others (filter (lambda (x) (and (number? x) (not (integer? x)))) xs)\n        'non-numeric (filter (lambda (x) (not (number? x))) xs)))\n(display (numeric-partition (list 1 2.5 'x 1/2 \"s\")))\n(newline)"
     :cs-composition "(define (coerce-row r) (map (lambda (c) (if (number? c) c (let ((n (string->number c))) (if (number? n) n 'bad)))) r))\n(display (coerce-row (list 1 \"2\" \"x\")))\n(newline)"
     :base "number? answers whether arithmetic is defined for a value."
     :emergent "eng: a summary -- count, sum, min and max -- over the numeric entries of a mixed list, with a named answer when there are none. math: a three-way partition into whole numbers, other numbers, and non-numbers. cs: coercing a row, turning parseable text into numbers and marking the rest bad."
     :meta "The composition is number? plus a fold or a partition. What emerges is the mixed-data family: summarise the numeric part, split by numeric class, or coerce toward numbers and mark the failures. Marking the failures is the part people skip and later need.")
    (:eng "A summary that reports its count alongside its sum lets a reader tell an empty column from a zero one."
     :math "Partitioning by predicate is how a heterogeneous column becomes several homogeneous ones."
     :cs "Coercion that marks failures is recoverable; coercion that drops them is not."))
)

(verb
  :name "procedure?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(procedure? x) -> boolean"
  :summary "#t if x is a procedure -- a builtin, a lambda, or a closure. R7RS-small 6.10."
  :explanation "The test for callability. It is #t for the builtins like car and +, for any lambda, and for any closure returned from a procedure that captured state; it is #f for a symbol NAMING a procedure, for a string, and for numbers. That first #f is the point: 'car is a symbol and car is a procedure, and only the second can be applied. procedure? is what a dispatch table needs when its values arrive from data rather than from code -- if a handler slot may hold either a procedure or a marker, checking before applying turns a crash into a named branch. Two distinct lambdas with identical bodies are NOT equal in any sense the language exposes: (eq? (lambda (x) x) (lambda (x) x)) is #f, because each evaluation of a lambda expression makes a new procedure. So procedure? tells you a value is callable; it cannot tell you two callables do the same thing, and nothing in Scheme can."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(procedure? car)" :note "#t -- a builtin is a procedure.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (procedure? car) (procedure? (lambda (x) x)) (procedure? 'car) (procedure? \"car\")))\n(newline)" :note "(#t #t #f #f) -- a builtin and a lambda yes; the SYMBOL car NO; the string \"car\" NO.")
    (:dialect "motoi" :tier "expert" :code "(define (apply-if-callable f x) (if (procedure? f) (f x) 'not-callable))\n(display (list (apply-if-callable (lambda (n) (* n 3)) 4) (apply-if-callable 'triple 4)))\n(newline)" :note "(12 not-callable) -- applying only what can be applied, with a named branch for the rest.")
  )
  :caveats ("(procedure? 'car) is #f. The symbol car is a name; the procedure car is a value. Only the value can be applied." "(eq? (lambda (x) x) (lambda (x) x)) is #f. Each evaluation of a lambda makes a new procedure; identical bodies do not make identical procedures." "procedure? does not report arity. A procedure that takes two arguments still passes." "A closure that captured mutable state is still a procedure; procedure? says nothing about purity." "Applying a non-procedure raises, so procedure? is the check that turns that raise into a branch you chose.")
  :usecases ("Guarding a dispatch table whose values arrive from data." "Validating the arguments of a higher-order procedure like compose." "Counting or filtering the callable entries of a mixed list.")
  :related ("apply" "map" "symbol?" "eq?")
  :learn (:concept "Procedures are values: they can be stored, passed, returned and tested for, and a name is not one." :prerequisites ("symbol?" "apply") :progression "Learn procedure? after lambda, once procedures are being stored in lists. Then meet the distinction between the symbol and the procedure. Then use it to guard dispatch tables, which is where data and code meet.")
  :provenance "R7RS-small 6.10; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define handlers (list (cons 'double (lambda (n) (* 2 n))) (cons 'name 'not-a-procedure)))\n(define (invoke k x) (let ((hit (assq k handlers))) (if (and hit (procedure? (cdr hit))) ((cdr hit) x) 'no-handler)))\n(display (list (invoke 'double 5) (invoke 'name 5) (invoke 'missing 5)))\n(newline)"
     :math-program "(define (compose f g) (if (and (procedure? f) (procedure? g)) (lambda (x) (f (g x))) (error 'compose \"needs two procedures\")))\n(display ((compose (lambda (n) (+ n 1)) (lambda (n) (* n 2))) 5))\n(newline)"
     :cs-program "(define (callable-count xs) (fold (lambda (x n) (if (procedure? x) (+ n 1) n)) 0 xs))\n(display (callable-count (list car 1 (lambda (x) x) \"f\")))\n(newline)"
     :problem "The operator has a handler table built partly from data, so a slot may hold a procedure or may hold something else entirely. Candidates: procedure? before applying (turns a crash into a named no-handler branch), applying inside a guard (works, but uses an exception for a condition that is not exceptional and swallows real errors raised BY the handler), and trusting the table (fine until the day the table is edited). The check distinguishes a missing handler from a handler that failed -- the guard cannot."
     :explanation "eng: a dispatch table with a bad slot and a missing key, both answering no-handler. math: compose, which validates both arguments and raises with a clear message rather than returning a broken procedure. cs: counting the callable entries in a mixed list."
     :meta "Why procedure? and not a guard around the call: a guard cannot tell an uncallable slot from a handler that raised inside itself. Checking first keeps those two failures distinguishable, and they need very different responses.")
    (:eng "A dispatch failure and a handler failure are different incidents; collapsing them into one guard loses the difference."
     :math "compose is only defined when both arguments are functions, so checking is stating the domain."
     :cs "Validate at construction where you can; construction-time errors have the stack that explains them."))
  :row-3-dimension (
    (:setup "Asking whether a value can be applied -- whether it is a thing that DOES something, or a thing that merely names one."
     :rungs ((:domain "procedures against the symbols that name them" :code "(display (list (procedure? cdr) (procedure? 'cdr)))\n(newline)")
             (:domain "a tool on the bench against the word for the tool" :code "(define (tool? x) (procedure? x))\n(display (list (tool? (lambda (x) x)) (tool? 'hammer)))\n(newline)")
             (:domain "a function value against an element of its domain" :code "(define (total-function-value? x) (procedure? x))\n(display (list (total-function-value? +) (total-function-value? 1)))\n(newline)"))
     :explanation "In a program cdr is a procedure and 'cdr is a name for it; only one can be applied. On a bench, a hammer does work and the word hammer on a list does not -- you cannot drive a nail with an inventory entry. In mathematics a function is an object in its own right, distinct from the values it maps between, which is exactly what makes higher-order functions possible. All three share: the difference between a capability and a reference to one."
     :meta "Treating procedures as values is what makes map, filter and fold possible. The predicate is the guard at the point where data-shaped things and code-shaped things meet.")
    (:eng "An inventory of tools is not a set of tools; the distinction matters when the work starts."
     :math "Functions as first-class objects is the move that makes higher-order mathematics -- and this whole chapter -- expressible."
     :cs "Code as data is the Lisp premise; procedure? is where a program checks which one it is holding."))
  :row-4-proof (
    (:eng-program "(define vals (list car + (lambda (x) x) 'car \"car\" 1 '()))\n(display (map procedure? vals))\n(newline)"
     :math-program "(define fs (list car cdr + (lambda (x) x)))\n(display (list 'all-procedures (every procedure? fs)\n               'compose-closed (every (lambda (f) (procedure? (lambda (x) (f x)))) fs)))\n(newline)"
     :cs-program "(define fs (list (lambda (x) x) (lambda (x) (* 2 x))))\n(display (list 'apply-safe-when-procedure\n               (every (lambda (f) (eq? (procedure? f) (guard (e (#t #f)) (f 1) #t))) fs)))\n(newline)"
     :claim "procedure? is #t for builtins, lambdas and closures, and #f for symbols, strings, numbers and the empty list. Wrapping a procedure in a lambda yields a procedure, so callability is closed under composition. And procedure? agrees with what actually happens: a value that passes can be applied."
     :invariant "For all procedures f. procedure?(lambda (x) (f x)); for all f. procedure?(f) = (f arg) is applicable"
     :meta "What would falsify it: a wrapped procedure that stopped being one, or a value where the predicate and the application disagreed. The second invariant is what makes procedure? a precondition rather than a description, exactly as with pair? and car.")
    (:eng "A predicate that matches an operation precondition can be relied on at every call site without a guard."
     :math "Closure under eta-expansion is why combinators like compose and curry can be written at all."
     :cs "Testing the predicate against the operation is the only way to know they have not drifted apart."))
  :row-5-emergence (
    (:eng-composition "(define pipeline (list (lambda (n) (+ n 1)) (lambda (n) (* n 2)) 'oops))\n(define (run x steps) (fold (lambda (f acc) (if (procedure? f) (f acc) acc)) x steps))\n(display (run 3 pipeline))\n(newline)"
     :math-composition "(define (iterate f n x) (if (zero? n) x (iterate f (- n 1) (f x))))\n(display (list (iterate (lambda (n) (* 2 n)) 3 1) (if (procedure? car) 'callable 'not)))\n(newline)"
     :cs-composition "(define (make-counter) (let ((n 0)) (lambda () (set! n (+ n 1)) n)))\n(define c (make-counter))\n(display (list (procedure? c) (c) (c) (c)))\n(newline)"
     :base "procedure? answers whether a value can be applied."
     :emergent "eng: a pipeline that runs the callable stages and steps over the rest, so one bad entry does not stop the run. math: iterate, applying a procedure n times -- the discrete dynamical system in three lines. cs: a counter closure, which is a procedure carrying private state."
     :meta "The composition is procedure? plus a place to keep procedures. What emerges is the higher-order family: a list of procedures is a pipeline, a repeated application is an iteration, and a captured variable is an object. Procedures in a data structure is the whole idea.")
    (:eng "A pipeline that skips a bad stage keeps running; whether that is right depends on the stage, so make it a decision, not an accident."
     :math "Iterating a function is how a discrete dynamical system is defined; the orbit is the list of results."
     :cs "A closure over a mutable variable is the smallest object system there is -- state plus one method."))
)

(verb
  :name "zero?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(zero? x) -> boolean"
  :summary "#t if x is numerically zero. R7RS-small 6.2.6."
  :explanation "The test for the additive identity, and the base case of a great many numeric recursions. It is #t for 0, and for 0.0 -- which in Motoi is the same value as 0, since the engine has no separate inexact integer. It is #f for every other number. Its main job is the guard before a division: (if (zero? b) 'undefined (/ a b)) is the whole idiom, and it is worth writing because division by zero raises in Motoi rather than answering an infinity. zero? is exactly (= x 0), and the proof row checks that; prefer zero? because it states the intent in one word and cannot be mistyped as an assignment. One caveat that matters at boundaries: a non-number passed to zero? answers #f rather than raising -- (zero? \"a\") is #f -- so zero? does not double as a type check. Pair it with number? when the value came from outside."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(zero? 0)" :note "#t -- the additive identity.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (zero? 0) (zero? 0.0) (zero? 1) (zero? -1) (zero? (- 3 3))))\n(newline)" :note "(#t #t #f #f #t) -- 0 yes; 0.0 yes, since it is the same value here; 1 and -1 no; a computed zero yes.")
    (:dialect "motoi" :tier "expert" :code "(define (safe-div a b) (if (zero? b) 'undefined (/ a b)))\n(display (list (safe-div 10 2) (safe-div 10 0)))\n(newline)" :note "(5 undefined) -- the division guard, the reason zero? is written most often.")
  )
  :caveats ("(zero? \"a\") is #f rather than raising. zero? is not a type check; pair it with number? at a boundary." "Division by zero RAISES in Motoi, so the zero? guard before a divide is load-bearing, not decorative." "(zero? 0.0) is #t, and 0.0 is the same value as 0 in this engine." "zero? is exactly (= x 0). Prefer the word: it says what it means and cannot be confused with an assignment." "zero?, positive? and negative? partition the numbers: every number satisfies exactly one.")
  :usecases ("Guarding a division or a normalisation." "The base case of a numeric recursion such as factorial or gcd." "Dropping or reporting zero entries in a data set.")
  :related ("positive?" "negative?" "number?" "even?")
  :learn (:concept "Zero is the additive identity and the base case; testing for it is how numeric recursions stop and how divisions stay safe." :prerequisites ("number?") :progression "Learn zero? as the guard before division first, because that is where its absence hurts. Then as the base case of a recursion. Then meet positive? and negative? and see that the three partition the numbers.")
  :provenance "R7RS-small 6.2.6; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (fuel-status n) (cond ((zero? n) 'empty) ((< n 10) 'low) (else 'ok)))\n(display (map fuel-status (list 0 5 50)))\n(newline)"
     :math-program "(define (fact n) (if (zero? n) 1 (* n (fact (- n 1)))))\n(display (list (fact 0) (fact 5)))\n(newline)"
     :cs-program "(define (normalize xs) (let ((total (fold + 0 xs))) (if (zero? total) 'cannot-normalize (map (lambda (x) (/ x total)) xs))))\n(display (list (normalize (list 1 1 2)) (normalize (list 0 0))))\n(newline)"
     :problem "The operator normalises a batch of readings by their total, and the total can legitimately be zero. Candidates: zero? on the total before dividing (one check, a named answer, and the batch survives), dividing and catching the raise (turns a foreseeable data condition into an exception, and the handler no longer knows which batch), and adding a small epsilon to the denominator (silently manufactures data that was never measured). The zero total is not an error; it is a fact about the batch."
     :explanation "eng: a fuel gauge with a distinct empty state rather than a low one. math: factorial, whose base case IS the zero test. cs: normalisation that reports it cannot proceed rather than dividing."
     :meta "Why zero? and not an epsilon: an epsilon changes the answer to avoid an error. That is a fabricated result, and it is indistinguishable from a real one downstream.")
    (:eng "Empty and low are different operational states and deserve different words on the display."
     :math "The zero case carries the identity, which is why the recursion bottoms out at 1 rather than at 0."
     :cs "A foreseeable data condition belongs in a branch, not in an exception handler."))
  :row-3-dimension (
    (:setup "Recognising the point where a quantity has run out, so the next operation changes rather than fails."
     :rungs ((:domain "the number zero" :code "(display (list (zero? 0) (zero? 3)))\n(newline)")
             (:domain "an empty tank on a gauge" :code "(define (tank-empty? litres) (zero? litres))\n(display (list (tank-empty? 0) (tank-empty? 4)))\n(newline)")
             (:domain "the additive identity of a ring" :code "(define (additive-identity? x) (zero? x))\n(display (list (additive-identity? 0) (additive-identity? 1)))\n(newline)"))
     :explanation "In arithmetic zero is the value that changes nothing when added and destroys everything when divided by. On a gauge, empty is a distinct state from low: low means keep going carefully, empty means stop. In algebra the additive identity is the element that leaves every other element alone, and it is exactly the element with no multiplicative inverse. All three share: a distinguished value where the rules change."
     :meta "Zero is not a small number; it is a structurally different one. Any code that treats it as merely small will divide by it eventually.")
    (:eng "A gauge that shows empty as the bottom of a continuous scale invites the operator to treat it as almost-empty."
     :math "Zero has no multiplicative inverse, which is the algebraic reason division by it is undefined rather than large."
     :cs "The base case of a recursion is where the structure changes, not merely where the counter is small."))
  :row-4-proof (
    (:eng-program "(define ns (list 0 0.0 1 -1 1/2 0.5 100))\n(display (map zero? ns))\n(newline)"
     :math-program "(define ns (list 0 1 -3 7 1/2 2.5))\n(display (list 'identity (every (lambda (n) (zero? (- n n))) ns)\n               'agrees-with-= (every (lambda (n) (eq? (zero? n) (= n 0))) ns)))\n(newline)"
     :cs-program "(define ns (list 0 1 -3 2.5 1/2))\n(display (list 'trichotomy (every (lambda (n) (if (zero? n) (and (not (positive? n)) (not (negative? n)))\n                                                  (or (positive? n) (negative? n)))) ns)))\n(newline)"
     :claim "zero? is #t for 0 and 0.0 and #f for every other number. Subtracting any number from itself gives zero, zero? agrees exactly with (= x 0), and zero? together with positive? and negative? partitions the numbers -- every number satisfies exactly one of the three."
     :invariant "For all numbers n. zero?(n - n); for all numbers n. zero?(n) = (n = 0); for all numbers n. exactly one of zero?(n), positive?(n), negative?(n)"
     :meta "What would falsify it: a self-difference that was not zero, a disagreement with =, or a number satisfying two of the three sign predicates or none. The trichotomy is the useful one -- it is the licence to write a three-branch cond with no else-case worry.")
    (:eng "A three-branch sign test with no fallthrough is only safe if the trichotomy holds; the test is the licence."
     :math "Trichotomy is an ordered-field axiom, and the three predicates are its computational form."
     :cs "zero? and = agree, so the choice between them is about readability, not behaviour."))
  :row-5-emergence (
    (:eng-composition "(define (guarded-ratios xs y) (if (zero? y) '() (map (lambda (x) (/ x y)) xs)))\n(display (list (guarded-ratios (list 2 4) 2) (guarded-ratios (list 2 4) 0)))\n(newline)"
     :math-composition "(define (gcd2 a b) (if (zero? b) a (gcd2 b (remainder a b))))\n(display (list (gcd2 12 18) (gcd2 7 0)))\n(newline)"
     :cs-composition "(define (drop-zeros xs) (filter (lambda (x) (not (zero? x))) xs))\n(display (drop-zeros (list 0 1 0 2 3 0)))\n(newline)"
     :base "zero? answers whether a number is the additive identity."
     :emergent "eng: a guarded ratio computation that answers an empty list rather than raising. math: the Euclidean algorithm, whose termination condition IS the zero test. cs: dropping zero entries from a data set."
     :meta "The composition is zero? plus a decision about the degenerate case. What emerges is the guard family: refuse the operation, terminate the recursion, or filter the value out. Which one is right is a domain question, and the code should show that a choice was made.")
    (:eng "Answering an empty list on a refused operation keeps the return type stable, which the caller depends on."
     :math "gcd terminates because the remainder strictly decreases and zero? catches the bottom."
     :cs "Filtering zeros is destructive of information; keep the count if the zeros meant something."))
)

(verb
  :name "positive?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(positive? x) -> boolean"
  :summary "#t if x is greater than zero. R7RS-small 6.2.6."
  :explanation "One of the three sign predicates. positive? is #t for numbers strictly greater than zero -- integers, reals and exact rationals alike -- and #f for zero and for everything below it. Note the strictness: (positive? 0) is #f. Zero is neither positive nor negative, which is precisely what makes the three predicates a partition rather than an overlapping pair, and it is the mistake to watch for when a threshold check is written as positive? but meant as non-negative. positive? is exactly (> x 0). Prefer the word when the concept is sign and prefer the comparison when the concept is a threshold that happens to sit at zero -- the difference shows up when the threshold later moves. As with the other numeric predicates in this chapter, a non-number answers #f rather than raising, so positive? is not a type check."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(positive? 5)" :note "#t -- greater than zero.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (positive? 5) (positive? 0) (positive? -5) (positive? 0.5) (positive? 1/2)))\n(newline)" :note "(#t #f #f #t #t) -- 5 yes; 0 NO, strictly; -5 no; 0.5 and the exact rational 1/2 yes.")
    (:dialect "motoi" :tier "expert" :code "(define (credits xs) (fold + 0 (filter positive? xs)))\n(display (list (credits (list 5 -3 7 -1)) (credits (list -1 -2))))\n(newline)" :note "(12 0) -- summing the credits out of a signed ledger.")
  )
  :caveats ("(positive? 0) is #f. Zero is not positive. If you mean non-negative, write (>= x 0)." "(positive? \"a\") is #f rather than raising. Pair with number? at a boundary." "positive? is exactly (> x 0); the word is clearer when the concept is sign, the comparison when the concept is a threshold." "positive?, negative? and zero? partition the numbers -- exactly one holds for any number." "positive? works on exact rationals as well as integers and reals.")
  :usecases ("Splitting a signed ledger into credits and debits." "Validating that a size or a count is strictly greater than zero." "Clamping a series at a floor of zero.")
  :related ("negative?" "zero?" "number?" "abs")
  :learn (:concept "Sign is a three-way question, not a two-way one: positive, negative, and zero which is neither." :prerequisites ("zero?" "number?") :progression "Learn zero? first so that the strictness of positive? is expected rather than surprising. Then positive? and negative? together, then the trichotomy that makes a three-branch sign cond safe.")
  :provenance "R7RS-small 6.2.6; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (stock-status n) (cond ((positive? n) 'in-stock) ((zero? n) 'out-of-stock) (else 'oversold)))\n(display (map stock-status (list 4 0 -2)))\n(newline)"
     :math-program "(define (magnitudes xs) (map (lambda (x) (if (positive? x) x (- x))) xs))\n(display (magnitudes (list 3 -4 0 -1/2)))\n(newline)"
     :cs-program "(define (validate-size n) (if (positive? n) 'ok (list 'bad-size n)))\n(display (list (validate-size 320) (validate-size 0) (validate-size -8)))\n(newline)"
     :problem "The operator reports stock levels, and a negative level means the system oversold -- a different incident from being out of stock. Candidates: a three-branch cond on positive?, zero? and else (three distinct states, three distinct messages), a two-branch (> n 0) test (collapses out-of-stock and oversold into one, hiding the incident that needs a human), and (not (negative? n)) (merges in-stock with out-of-stock instead). Only the three-way split reports the three states that exist."
     :explanation "eng: a three-state stock report where oversold is named. math: magnitude, taking the negation of anything not positive. cs: size validation, rejecting both zero and negative with the offending value in the message."
     :meta "Why positive? and not (>= n 0): they differ exactly at zero, and zero is the state the operator most needs to distinguish. A guard whose boundary case is the interesting case should name that case explicitly.")
    (:eng "Three real states deserve three messages; merging two of them is how an incident goes unnoticed."
     :math "Magnitude is defined by cases on sign, which is why the sign predicates come before absolute value."
     :cs "A validator that echoes the rejected value saves the round trip of asking what was sent."))
  :row-3-dimension (
    (:setup "Asking which side of a natural origin a quantity falls on, where the origin itself is a third case."
     :rungs ((:domain "numbers against zero" :code "(display (list (positive? 1) (positive? -1)))\n(newline)")
             (:domain "a slope that rises against one that falls or is level" :code "(define (uphill? slope) (positive? slope))\n(display (list (uphill? 3) (uphill? -3) (uphill? 0)))\n(newline)")
             (:domain "the right half of the real line" :code "(define (right-of-origin? x) (positive? x))\n(display (list (right-of-origin? 2.5) (right-of-origin? 0)))\n(newline)"))
     :explanation "A number is positive when it lies above zero; zero itself is not. A slope rises, falls, or is level -- and level is its own case, not a weak version of rising, which is why a path grader treats it separately. On the real line the positive reals are the open right half, open precisely because the origin is excluded. All three share: an origin that separates two sides and belongs to neither."
     :meta "The excluded origin is what makes a sign test a partition into three. Half-open thinking here is the same discipline as half-open indexing in the string chapter -- decide which side the boundary belongs to, once, and be consistent.")
    (:eng "Level ground is its own condition on a site plan, not a small hill."
     :math "The positive reals are an open set; including the origin gives a different, closed, set with different properties."
     :cs "Boundary conventions must be decided once and applied everywhere, or off-by-one bugs cluster at the origin."))
  :row-4-proof (
    (:eng-program "(define ns (list 5 0 -5 0.5 -0.5 1/2 -1/2 0.0))\n(display (map positive? ns))\n(newline)"
     :math-program "(define ns (list 5 0 -5 0.5 1/2 -1/2))\n(display (list 'exclusive (every (lambda (n) (not (and (positive? n) (negative? n)))) ns)\n               'exhaustive (every (lambda (n) (or (positive? n) (negative? n) (zero? n))) ns)))\n(newline)"
     :cs-program "(define ns (list 5 0 -5 0.5 1/2 -1/2))\n(display (list 'mirror (every (lambda (n) (eq? (positive? n) (negative? (- n)))) ns)))\n(newline)"
     :claim "positive? is #t strictly above zero, for integers, reals and exact rationals alike, and #f at zero and below. It is mutually exclusive with negative? and, with zero?, exhaustive over the numbers. And it mirrors: a number is positive exactly when its negation is negative."
     :invariant "For all numbers n. not(positive?(n) and negative?(n)); for all numbers n. positive?(n) or negative?(n) or zero?(n); for all numbers n. positive?(n) = negative?(-n)"
     :meta "What would falsify it: a number both positive and negative, a number that is none of the three, or a sign that did not flip under negation. The mirror invariant is the one that catches a wrong boundary -- if positive? included zero, negation would break it immediately.")
    (:eng "A mirror test catches boundary errors that a one-sided test cannot see."
     :math "Exclusivity plus exhaustiveness is trichotomy, an axiom of ordered fields."
     :cs "Negation is an involution that swaps the two open halves and fixes the origin."))
  :row-5-emergence (
    (:eng-composition "(define (running-balance xs) (let loop ((t xs) (bal 0) (acc '()))\n  (if (null? t) (reverse acc)\n      (let ((b (+ bal (car t)))) (loop (cdr t) b (cons (list b (if (positive? b) 'ok 'overdrawn)) acc))))))\n(display (running-balance (list 10 -4 -9 20)))\n(newline)"
     :math-composition "(define (sign-vector xs) (map (lambda (x) (cond ((positive? x) 1) ((negative? x) -1) (else 0))) xs))\n(display (sign-vector (list 3 -2 0 1/2)))\n(newline)"
     :cs-composition "(define (clamp-low xs) (map (lambda (x) (if (positive? x) x 0)) xs))\n(display (clamp-low (list 3 -2 0 5)))\n(newline)"
     :base "positive? answers whether a number lies strictly above zero."
     :emergent "eng: a running balance that flags each point at which the account is overdrawn. math: the sign vector of a series, mapping each entry to 1, -1 or 0. cs: a floor clamp that raises everything below zero up to it."
     :meta "The composition is positive? plus a scan. What emerges is the sign-analysis family: flag as you scan and you get an audit trail; map to signs and you get a shape summary; clamp and you get a bounded series. The scan keeps the position, which is what makes the flag useful.")
    (:eng "An audit trail with the balance at each step tells you WHEN it went wrong, not just that it did."
     :math "The sign vector records where a series crosses zero, which is where its behaviour changes."
     :cs "Clamping loses information; keep the original alongside if anything downstream needs to know it was clamped."))
)

(verb
  :name "negative?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(negative? x) -> boolean"
  :summary "#t if x is less than zero. R7RS-small 6.2.6."
  :explanation "The third sign predicate, and the mirror of positive?. It is #t for numbers strictly below zero -- integers, reals and exact rationals -- and #f for zero and everything above. As with positive?, the strictness at zero is the thing to get right: (negative? 0) is #f, so negative? does not mean non-positive. It is exactly (< x 0), and the proof row checks that. The three sign predicates together are a partition, which is what licenses a three-branch cond with no defensive else -- and writing that cond is usually better than writing (not (positive? n)), because the negation quietly folds zero in with the negatives and the reader cannot see that it happened. A non-number answers #f rather than raising, so like its siblings this is not a type check."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(negative? -5)" :note "#t -- less than zero.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (negative? -5) (negative? 0) (negative? 5) (negative? -0.5) (negative? -1/2)))\n(newline)" :note "(#t #f #f #t #t) -- -5 yes; 0 NO, strictly; 5 no; -0.5 and the exact rational -1/2 yes.")
    (:dialect "motoi" :tier "expert" :code "(define (debits xs) (fold + 0 (filter negative? xs)))\n(display (list (debits (list 5 -3 7 -1)) (debits (list 1 2))))\n(newline)" :note "(-4 0) -- summing the debits out of a signed ledger; the all-positive case answers 0.")
  )
  :caveats ("(negative? 0) is #f. Zero is not negative. If you mean non-positive, write (<= x 0)." "(not (positive? n)) is NOT the same as (negative? n) -- the negation includes zero. Say which you mean." "(negative? \"a\") is #f rather than raising. Pair with number? at a boundary." "negative? is exactly (< x 0), and works on exact rationals as well as integers and reals." "negative?, positive? and zero? partition the numbers -- exactly one holds for any number.")
  :usecases ("Separating debits from credits in a signed ledger." "Detecting the first below-threshold reading in a series." "Clamping negative values to zero.")
  :related ("positive?" "zero?" "abs" "number?")
  :learn (:concept "The mirror of positive?, with the same strict boundary: zero is on neither side." :prerequisites ("positive?" "zero?") :progression "Learn negative? immediately after positive? so the symmetry is obvious. Then the trichotomy. Then practise NOT writing (not (positive? n)) when you mean negative?, which is the mistake the symmetry is meant to prevent.")
  :provenance "R7RS-small 6.2.6; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :row-2-audit (
    (:eng-program "(define (temp-alert c) (cond ((negative? c) 'freezing) ((zero? c) 'at-freezing) (else 'above)))\n(display (map temp-alert (list -4 0 12)))\n(newline)"
     :math-program "(define (abs2 x) (if (negative? x) (- x) x))\n(display (map abs2 (list -3 3 0 -1/2 -2.5)))\n(newline)"
     :cs-program "(define (find-first-negative xs) (let loop ((t xs) (i 0)) (cond ((null? t) #f) ((negative? (car t)) i) (else (loop (cdr t) (+ i 1))))))\n(display (list (find-first-negative (list 3 1 -2 4)) (find-first-negative (list 1 2))))\n(newline)"
     :problem "The operator reports temperatures where below-freezing, exactly freezing and above are three different operational conditions. Candidates: a three-branch cond on negative?, zero? and else (names all three), (not (positive? c)) (merges freezing with below-freezing, so the transition point is invisible), and (< c 1) (correct today, wrong the moment the scale changes). The freezing point is the interesting reading; a test that hides it is answering the wrong question."
     :explanation "eng: a three-state temperature alert with the freezing point named. math: absolute value defined by cases on sign. cs: finding the index of the first negative reading, which is where a series first goes wrong."
     :meta "Why negative? and not (not (positive? c)): the negation includes zero. On a temperature scale that is the freezing point itself, which is exactly the reading the operator called about.")
    (:eng "The boundary reading is usually the interesting one; a test that folds it into a neighbour hides the event."
     :math "Absolute value is defined by cases on sign, so the sign predicates are logically prior to it."
     :cs "Returning the INDEX rather than the value tells the caller where in the series to look."))
  :row-3-dimension (
    (:setup "Asking whether a quantity has passed below a natural datum, where the datum itself is neither side."
     :rungs ((:domain "numbers against zero" :code "(display (list (negative? -1) (negative? 1)))\n(newline)")
             (:domain "a depth below the survey datum" :code "(define (below-datum? depth) (negative? depth))\n(display (list (below-datum? -12) (below-datum? 12) (below-datum? 0)))\n(newline)")
             (:domain "the left half of the real line" :code "(define (left-of-origin? x) (negative? x))\n(display (list (left-of-origin? -2.5) (left-of-origin? 0)))\n(newline)"))
     :explanation "A number is negative below zero and not at it. On a survey, a depth below datum is recorded as negative and datum level is zero -- a reading of exactly zero is at the datum, neither below nor above, and a survey that rounded it either way would misreport the site. On the real line the negatives are the open left half. All three share the same excluded origin as positive?, seen from the other side."
     :meta "The two sign predicates are mirror images and the origin belongs to neither. Writing them as mirrors, rather than one as the negation of the other, is what keeps the origin visible.")
    (:eng "A datum reading of exactly zero is a real measurement, not a rounding opportunity."
     :math "The negative reals are the image of the positives under negation, an order-reversing bijection."
     :cs "Mirrored predicates document the boundary; a negated predicate hides it."))
  :row-4-proof (
    (:eng-program "(define ns (list -5 0 5 -0.5 0.5 -1/2 1/2 0.0))\n(display (map negative? ns))\n(newline)"
     :math-program "(define ns (list -5 0 5 -0.5 1/2 -1/2))\n(display (list 'exclusive (every (lambda (n) (not (and (negative? n) (positive? n)))) ns)\n               'exhaustive (every (lambda (n) (or (negative? n) (positive? n) (zero? n))) ns)))\n(newline)"
     :cs-program "(define ns (list -5 0 5 -0.5 1/2 -1/2))\n(display (list 'mirror (every (lambda (n) (eq? (negative? n) (positive? (- n)))) ns)\n               'agrees-with-< (every (lambda (n) (eq? (negative? n) (< n 0))) ns)))\n(newline)"
     :claim "negative? is #t strictly below zero, for integers, reals and exact rationals, and #f at zero and above. It is exclusive with positive? and, with zero?, exhaustive. It mirrors positive? under negation, and it agrees exactly with (< n 0)."
     :invariant "For all numbers n. not(negative?(n) and positive?(n)); for all numbers n. negative?(n) or positive?(n) or zero?(n); for all numbers n. negative?(n) = positive?(-n) = (n < 0)"
     :meta "What would falsify it: a number on both sides, a number on none, a sign that survived negation, or a disagreement with the comparison. Checking against < is what pins the strictness -- an implementation that used <= would fail only at zero, which is exactly the case a casual test omits.")
    (:eng "Test the boundary case explicitly; it is the only case where a wrong comparison operator shows."
     :math "Negation is an order-reversing involution, so it exchanges the two open halves exactly."
     :cs "A predicate and its comparison must agree, or two spellings of one rule drift apart."))
  :row-5-emergence (
    (:eng-composition "(define (split-ledger xs) (list 'credits (filter positive? xs) 'debits (filter negative? xs) 'zeros (filter zero? xs)))\n(display (split-ledger (list 5 -3 0 7 -1)))\n(newline)"
     :math-composition "(define (net xs) (list 'in (fold + 0 (filter positive? xs)) 'out (fold + 0 (filter negative? xs)) 'net (fold + 0 xs)))\n(display (net (list 10 -4 -3 2)))\n(newline)"
     :cs-composition "(define (clamp-to-zero xs) (map (lambda (x) (if (negative? x) 0 x)) xs))\n(display (clamp-to-zero (list 3 -2 0 -5)))\n(newline)"
     :base "negative? answers whether a number lies strictly below zero."
     :emergent "eng: a ledger split three ways into credits, debits and zeros, so nothing is silently dropped. math: a net summary reporting inflow, outflow and total. cs: a zero clamp for a series that must not go below its floor."
     :meta "The composition is negative? plus its two siblings. What emerges is the ledger family: partition by sign and you get a statement; sum each part and you get a summary; clamp one side and you get a bounded series. Keeping the zeros in the partition is what makes the three parts reconcile against the whole.")
    (:eng "A three-way split reconciles: the parts add back to the whole, which is the check that nothing was lost."
     :math "Reporting inflow and outflow separately preserves information the net figure destroys."
     :cs "A clamp is a decision about representable range; record that it fired if anything depends on it."))
)

(verb
  :name "even?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(even? n) -> boolean"
  :summary "#t if the integer n is divisible by two. R7RS-small 6.2.6."
  :explanation "The parity test. It is #t for zero, for positive even integers and for negative ones -- (even? -2) is #t -- and #f for odd integers. It is exactly (zero? (remainder n 2)), which the proof row checks. Parity is the cheapest structural fact about an integer, which is why it turns up as the alternation rule in striped rows, the branch in the Collatz step, and the key/value distinction in a flat list of pairs. Two measured limits to know. A non-integer answers #f rather than raising: (even? 2.5) is #f, and so is (even? \"a\"), so even? does not double as a type check and it does not report that a value is unsuitable -- it just says no. More seriously, an exact rational that IS a whole number answers #f: (even? 4/2) is #f even though (integer? 4/2) is #t, (= 4/2 2) is #t and it prints as 2. Anything divided into a rational-typed integer will hit this. Until it is fixed, normalise first -- (even? (/ 4 2)) is #t -- or test with (zero? (remainder n 2)), which is correct on those values."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(even? 4)" :note "#t -- four is even.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (even? 0) (even? 2) (even? 3) (even? -2) (even? -3)))\n(newline)" :note "(#t #t #f #t #f) -- zero is even; 2 yes; 3 no; -2 yes, parity is sign-blind; -3 no.")
    (:dialect "motoi" :tier "expert" :code "(define (evens xs) (filter even? xs))\n(display (evens (list 1 2 3 4 5 6)))\n(newline)" :note "(2 4 6) -- even? handed straight to filter, which is where parity is used most.")
  )
  :caveats ("(even? 4/2) is #f although (integer? 4/2) is #t and it prints as 2. An exact rational is not tested for parity correctly; use (zero? (remainder n 2)) or normalise with / first." "(even? 2.5) is #f and (even? \"a\") is #f -- a non-integer answers #f rather than raising, so even? is not a type check." "(even? 0) is #t. Zero is even." "(even? -2) is #t. Parity ignores sign." "even? and odd? are complementary on integers: exactly one holds.")
  :usecases ("Alternating a treatment across rows, stripes or turns." "Branching a numeric algorithm on parity, as in Collatz or fast exponentiation." "Splitting a flat list into alternating positions.")
  :related ("odd?" "remainder" "quotient" "zero?" "integer?")
  :learn (:concept "Parity is the cheapest structural fact about an integer, and it drives alternation everywhere." :prerequisites ("zero?" "remainder") :progression "Learn even? as a filter predicate first, then as an algorithmic branch, then as the alternation rule for positions in a list. Learn its relationship to remainder last -- that is what explains both its behaviour and its limits.")
  :provenance "R7RS-small 6.2.6; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :status "needs-alfred"
  :row-2-audit (
    (:eng-program "(define (stripe-colour row) (if (even? row) 'light 'dark))\n(display (map stripe-colour (list 0 1 2 3)))\n(newline)"
     :math-program "(define (collatz-step n) (if (even? n) (quotient n 2) (+ (* 3 n) 1)))\n(display (map collatz-step (list 6 7 1)))\n(newline)"
     :cs-program "(define (pair-up xs) (let loop ((t xs) (i 0) (acc '()))\n  (if (null? t) (reverse acc) (loop (cdr t) (+ i 1) (cons (list (if (even? i) 'key 'value) (car t)) acc)))))\n(display (pair-up (list 'a 1 'b 2)))\n(newline)"
     :problem "The operator is striping the rows of a table so a reader can follow a line across. Candidates: even? on the row index (states the alternation rule directly and survives the table being reordered or filtered), a toggling boolean carried through the loop (correct until a row is skipped, after which the stripes drift), and precomputing a colour column (correct and now stale the moment the data changes). Deriving the stripe from the index keeps one source of truth."
     :explanation "eng: a stripe colour derived from the row index. math: the Collatz step, which branches on parity and is the standard example of a parity-driven rule. cs: reading a flat list as alternating keys and values by the parity of the position."
     :meta "Why even? on the index and not a carried toggle: a toggle is state, and state drifts when the traversal changes. The index is already there and already correct.")
    (:eng "Derive presentation from data rather than storing it; stored presentation goes stale silently."
     :math "The Collatz step is the canonical parity branch -- halve when even, otherwise 3n+1."
     :cs "A flat alternating list is a common wire format; parity of the index is how it is read back."))
  :row-3-dimension (
    (:setup "Splitting a whole quantity into two by asking whether it divides evenly into pairs."
     :rungs ((:domain "integers by parity" :code "(display (list (even? 8) (even? 9)))\n(newline)")
             (:domain "a count of parts that pairs up exactly" :code "(define (fits-in-pairs? n) (even? n))\n(display (list (fits-in-pairs? 12) (fits-in-pairs? 13)))\n(newline)")
             (:domain "membership of the even integers, 2Z" :code "(define (in-2Z? n) (even? n))\n(display (list (in-2Z? 0) (in-2Z? -4) (in-2Z? 5)))\n(newline)"))
     :explanation "An integer is even when it splits into two equal whole parts. On a bench, twelve bolts pair up with none left over and thirteen do not, which decides whether the job needs an extra fixing. In algebra the even integers are 2Z, a subgroup of the integers -- closed under addition and containing zero. All three share: divisibility by two, asked as a yes-or-no rather than as a quotient."
     :meta "Parity is the smallest non-trivial quotient of the integers, and the reason it is everywhere is that two is the smallest number of alternatives worth alternating between.")
    (:eng "A leftover part is a real planning fact; parity is how the plan finds out before the job starts."
     :math "2Z is a subgroup and the even/odd split is the quotient Z/2Z -- the two-element group."
     :cs "A single bit of a binary number decides parity, which is why the test is one machine instruction."))
  :row-4-proof (
    (:eng-program "(define ns (list 0 1 2 3 -2 -3 100 101))\n(display (map even? ns))\n(newline)"
     :math-program "(define ns (list 0 1 2 3 -2 -3 10 11))\n(display (list 'complementary (every (lambda (n) (eq? (even? n) (not (odd? n)))) ns)\n               'closed-under-+ (every (lambda (a) (every (lambda (b) (if (and (even? a) (even? b)) (even? (+ a b)) #t)) ns)) ns)))\n(newline)"
     :cs-program "(define ns (list 0 1 2 3 -2 -3))\n(display (list 'agrees-with-remainder (every (lambda (n) (eq? (even? n) (zero? (remainder n 2)))) ns)\n               'non-integers-answer-false (list (even? 2.5) (even? 4/2))))\n(newline)"
     :claim "even? and odd? are complementary on integers, the even integers are closed under addition, and even? agrees exactly with (zero? (remainder n 2)) on the integers. The third program also PRINTS the two known limits rather than hiding them: (even? 2.5) is #f and (even? 4/2) is #f, the second of which is wrong."
     :invariant "For all integers n. even?(n) = not(odd?(n)); for all integers a b. even?(a) and even?(b) implies even?(a + b); for all integers n. even?(n) = (remainder(n, 2) = 0) -- on JS-number integers, NOT on exact rationals"
     :meta "What would falsify the first two: an integer that was both or neither, or a sum of evens that came out odd. The third invariant is stated with its restriction attached, because that is where the engine departs from the standard: the equivalence with remainder holds for the integers even? handles and fails for the rational-typed integers it does not.")
    (:eng "State the restriction in the invariant. An invariant with a silent exception is worse than no invariant."
     :math "Closure under addition is what makes the even integers a subgroup; the odds are its other coset."
     :cs "Testing the predicate against remainder is the direct check, and it is what exposed the rational case."))
  :row-5-emergence (
    (:eng-composition "(define (deal xs) (list 'left (let loop ((t xs) (i 0) (a '())) (if (null? t) (reverse a) (loop (cdr t) (+ i 1) (if (even? i) (cons (car t) a) a))))\n                        'right (let loop ((t xs) (i 0) (a '())) (if (null? t) (reverse a) (loop (cdr t) (+ i 1) (if (odd? i) (cons (car t) a) a))))))\n(display (deal (list 'a 'b 'c 'd 'e)))\n(newline)"
     :math-composition "(define (parity-sum xs) (list 'evens (fold + 0 (filter even? xs)) 'odds (fold + 0 (filter odd? xs))))\n(display (parity-sum (list 1 2 3 4 5 6)))\n(newline)"
     :cs-composition "(define (halve-while-even n) (let loop ((n n) (k 0)) (if (and (even? n) (not (zero? n))) (loop (quotient n 2) (+ k 1)) (list 'odd-part n 'twos k))))\n(display (list (halve-while-even 24) (halve-while-even 7)))\n(newline)"
     :base "even? answers whether an integer divides into two equal whole parts."
     :emergent "eng: dealing a list alternately into two hands. math: parity-separated sums over one pass of the data. cs: factoring out the powers of two from a number, leaving its odd part."
     :meta "The composition is even? plus a position or a loop. What emerges is the alternation family: parity of the index deals; parity of the value separates; parity in a loop condition factors. The last is the one that generalises -- repeated halving while even is the shape of binary exponentiation and of gcd.")
    (:eng "Dealing alternately is the simplest fair split, and it needs no state beyond the index."
     :math "Splitting a sum by parity is a decomposition into cosets of 2Z."
     :cs "Halving while even runs in log time and is the core of fast exponentiation."))
)

(verb
  :name "odd?" :std "R7RS-small"
  :library "predicate"
  :tier "core"
  :kind "pure"
  :signature "(odd? n) -> boolean"
  :summary "#t if the integer n is not divisible by two. R7RS-small 6.2.6."
  :explanation "The complement of even? on the integers. It is #t for odd integers positive and negative alike -- (odd? -3) is #t -- and #f for even ones including zero. It is exactly (not (zero? (remainder n 2))) on the integers, which the proof row checks. It carries the same two measured limits as even?, and they matter for the same reason. A non-integer answers #f rather than raising, so (odd? 2.5) is #f and so is (odd? \"a\"): odd? is not a type check, and a #f from it does not mean the value was even. And an exact rational that is a whole number answers #f too -- (odd? 5/1) is #f although (integer? 5/1) is #t and it prints as 5. That means on rational-typed values even? and odd? can BOTH answer #f, so the complementarity that holds on ordinary integers does not hold there. Normalise first, or test with remainder."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(odd? 3)" :note "#t -- three is odd.")
    (:dialect "motoi" :tier "intermediate" :code "(display (list (odd? 1) (odd? 0) (odd? -3) (odd? 2) (odd? 7)))\n(newline)" :note "(#t #f #t #f #t) -- 1 yes; 0 no, zero is even; -3 yes, parity ignores sign; 2 no; 7 yes.")
    (:dialect "motoi" :tier "expert" :code "(define (odds xs) (filter odd? xs))\n(display (odds (list 1 2 3 4 5)))\n(newline)" :note "(1 3 5) -- odd? handed to filter, the everyday use.")
  )
  :caveats ("(odd? 5/1) is #f although (integer? 5/1) is #t and it prints as 5. On exact rationals even? and odd? can BOTH answer #f, so they are not complementary there." "(odd? 2.5) is #f and (odd? \"a\") is #f -- a non-integer answers #f rather than raising. A #f does not mean the value was even." "(odd? 0) is #f. Zero is even." "(odd? -3) is #t. Parity ignores sign." "On ordinary integers odd? is exactly (not (even? n)); prefer whichever reads as the positive statement of your rule.")
  :usecases ("Selecting alternate positions or turns." "Parity checksums over a list of bits." "Generating the odd members of a range.")
  :related ("even?" "remainder" "zero?" "integer?" "not")
  :learn (:concept "The other half of parity: odd? and even? split the integers in two, and neither says anything about non-integers." :prerequisites ("even?" "remainder") :progression "Learn odd? straight after even? and check the complementarity yourself on a handful of integers, including zero and a negative. Then meet the two cases where the complementarity fails, so you know the boundary of the rule you just learned.")
  :provenance "R7RS-small 6.2.6; measured against the live engine 2026-08-02; reference record added 2026-08-02"
  :status "needs-alfred"
  :row-2-audit (
    (:eng-program "(define (needs-spare? n) (if (odd? n) 'yes 'no))\n(display (map needs-spare? (list 4 5)))\n(newline)"
     :math-program "(define (sum-odds n) (fold + 0 (filter odd? (iota n))))\n(display (list (sum-odds 10) (sum-odds 1)))\n(newline)"
     :cs-program "(define (checksum-ok? bits) (even? (fold + 0 bits)))\n(display (list (checksum-ok? (list 1 1 0)) (checksum-ok? (list 1 0 0))))\n(newline)"
     :problem "The operator is checking a parity checksum on a run of bits. Candidates: even? or odd? on the sum (states the parity rule in one place and reads as the rule), summing and comparing the remainder by hand (correct but restates the rule as arithmetic, so the intent has to be reconstructed by the reader), and counting the ones in a loop with a toggle (correct, longer, and the toggle is state that can be got wrong). The predicate IS the rule."
     :explanation "eng: a spare-part check that reports whether a count leaves one over. math: the sum of the odd numbers below n, which is the classic square identity. cs: an even-parity checksum over a list of bits."
     :meta "Why the parity predicate and not the remainder arithmetic: both are correct, but one names the concept. When the rule changes from even parity to odd parity, the named version changes in one obvious place.")
    (:eng "A checksum stated as a named rule is auditable; stated as arithmetic it has to be re-derived."
     :math "The sum of the first k odd numbers is k squared -- the identity the math program exhibits."
     :cs "Parity is the weakest error detection there is: it catches any single-bit flip and no double one."))
  :row-3-dimension (
    (:setup "Recognising the quantity that will not pair up -- the one left over when everything else has matched."
     :rungs ((:domain "integers by parity" :code "(display (list (odd? 7) (odd? 8)))\n(newline)")
             (:domain "a count that leaves one over after pairing" :code "(define (leftover-after-pairing? n) (odd? n))\n(display (list (leftover-after-pairing? 7) (leftover-after-pairing? 8)))\n(newline)")
             (:domain "membership of the odd integers, 2Z+1" :code "(define (in-2Z+1? n) (odd? n))\n(display (list (in-2Z+1? 1) (in-2Z+1? -3) (in-2Z+1? 4)))\n(newline)"))
     :explanation "An odd integer is one that cannot be split into two equal whole parts. On a bench, seven parts pair up into three pairs with one left over, and that leftover is the planning fact -- it decides whether a job needs an extra fixing or an odd-man-out rule. In algebra the odd integers are 2Z+1, the other coset of the even subgroup: not a subgroup themselves, since two odds sum to an even. All three share: the residue that remains after maximal pairing."
     :meta "The leftover is the information. Parity is the smallest possible summary of a count, and it is exactly the part that survives pairing everything off.")
    (:eng "The odd one out drives a real decision -- a bye in a tournament, an extra fixing, a spare seat."
     :math "2Z+1 is a coset, not a subgroup: closed under neither addition nor zero."
     :cs "The low bit of a two-complement integer is its parity, negative numbers included."))
  :row-4-proof (
    (:eng-program "(define ns (list 0 1 2 3 -2 -3 100 101))\n(display (map odd? ns))\n(newline)"
     :math-program "(define ns (list 0 1 2 3 -2 -3 10 11))\n(display (list 'complementary (every (lambda (n) (eq? (odd? n) (not (even? n)))) ns)\n               'odd+odd-is-even (every (lambda (a) (every (lambda (b) (if (and (odd? a) (odd? b)) (even? (+ a b)) #t)) ns)) ns)))\n(newline)"
     :cs-program "(define ns (list 0 1 2 3 -2 -3))\n(display (list 'agrees-with-remainder (every (lambda (n) (eq? (odd? n) (not (zero? (remainder n 2))))) ns)\n               'non-integers-answer-false (list (odd? 2.5) (odd? 5/1))))\n(newline)"
     :claim "odd? and even? are complementary on integers, the sum of two odds is even, and odd? agrees exactly with a non-zero remainder on division by two. The third program prints the two known limits alongside: (odd? 2.5) is #f, and (odd? 5/1) is #f although that value is a whole number."
     :invariant "For all integers n. odd?(n) = not(even?(n)); for all integers a b. odd?(a) and odd?(b) implies even?(a + b); for all integers n. odd?(n) = (remainder(n, 2) /= 0) -- on JS-number integers, NOT on exact rationals"
     :meta "What would falsify the first two: an integer that was both or neither, or two odds summing to an odd. The exact rationals already falsify the complementarity, which is why the invariant carries its restriction in the text rather than in a footnote.")
    (:eng "An invariant that names where it stops applying is usable; one that does not will be applied where it is false."
     :math "Odd plus odd is even because the odds form a coset, and the coset is closed under pairwise addition into the subgroup."
     :cs "Checking against remainder is the direct test and is what makes the rational-typed failure visible."))
  :row-5-emergence (
    (:eng-composition "(define (alternate xs) (map (lambda (p) (list (car p) (if (odd? (cdr p)) 'indent 'flush)))\n                            (let loop ((t xs) (i 0) (a '())) (if (null? t) (reverse a) (loop (cdr t) (+ i 1) (cons (cons (car t) i) a))))))\n(display (alternate (list 'a 'b 'c)))\n(newline)"
     :math-composition "(define (odd-squares n) (map (lambda (k) (* k k)) (filter odd? (iota n))))\n(display (odd-squares 8))\n(newline)"
     :cs-composition "(define (round-robin xs) (list 'team-a (filter (lambda (p) (even? (cdr p))) xs) 'team-b (filter (lambda (p) (odd? (cdr p))) xs)))\n(display (round-robin (list (cons 'ann 0) (cons 'bo 1) (cons 'cy 2))))\n(newline)"
     :base "odd? answers whether an integer leaves one over when paired off."
     :emergent "eng: alternating layout, indenting every second line by position. math: the odd squares, generated by filtering a range and squaring. cs: round-robin assignment into two teams by index parity."
     :meta "The composition is odd? plus an index. What emerges is the alternation family seen from the other side: indent by parity and you get layout; filter by parity and you get a subsequence; assign by parity and you get a fair split. Attaching the index first, then testing it, keeps the rule readable.")
    (:eng "Alternating layout is derived from position, so it stays correct when entries are added or removed."
     :math "The odd squares are 1, 9, 25, 49 -- the squares of the odd numbers, and every one of them is odd."
     :cs "Round-robin by index parity needs no randomness and no state, and it is reproducible."))
)
