;;; 52-predicate.slat — Motoi Scheme Reference · Chapter 52 · library predicate
;;;
;;; 21 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;
;;; All 21 verbs upgraded to full 15-program standard 2026-07-22.

(dialect :applies ("motoi") :note "Library predicate — 21 verbs.")

(chapter :number "52" :library "predicate" :verb-count 21 :training-eligible #t)

;; ═══ 21 verbs in library predicate ═══

(verb :name "list?" :std "R7RS-small"      :library "predicate" :tier "core" :kind "pure" :signature "(list? x) -> boolean"
  :summary "#t if x is a proper (finite, terminated) list. R7RS §6.4."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(list? (list 1 2 3))" :note "#t — the canonical proper list.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((xs (list 1 2 3))) (and (list? xs) (positive? (length xs))))" :note "#t only if xs is a non-empty proper list.")
    (:dialect "motoi" :tier "expert"       :code "(define (walk-lists thing) (cond ((list? thing) (map walk-lists thing)) (else thing)))\n(walk-lists (list (list 1 2) 'atom (list 3)))" :note "Deep walk. list? gates the recursion — atoms fall through, lists recurse."))
  :provenance "R7RS §6.4; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-load payload) (if (list? payload) (map world/spawn payload) (io/warn \"payload not a proper list\" payload)))\n(safe-load (list 'flower 'stone 'water))"
     :math-program "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))"
     :cs-program "(define (handle . args) (list 'handled args))\n(define (dispatch req) (if (list? req) (apply handle req) (raise (list :kind 'bad-request :got req))))\n(dispatch (list 'get 'user 42))"
     :problem "A world/loader receives a data payload that may be a proper list, an improper list (dotted pair chain), or a scalar. The operator must accept only proper lists before invoking a per-element map."
     :explanation "eng: guards a spawn loop. math: guards a sum. cs: guards a dispatch. Same predicate, three domains."
     :meta "Reach for list? and NOT pair?: pair? admits (1 . 2), which would crash any consumer at the cdr of the dotted end.")
    (:eng "The load log line names the shape: 'payload not a proper list: (1 . 2)'." :math "list? is the characteristic function of the proper-list subset of Pair⋆." :cs "Recursive predicate; O(n); walks the spine to confirm nil-termination."))
  :row-3-dimension (
    (:setup "Shape-classification: is this container well-formed."
     :rungs (
       (:domain "engineering"  :code "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))")
       (:domain "mathematics"  :code "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))")
       (:domain "cs / dispatch" :code "(define (list-sum xs) (if (list? xs) (fold + 0 xs) (error 'shape 'not-a-list)))\n(list-sum (list 1 2 3 4 5))"))
     :explanation "Three domains, one shape-check. The predicate transfers because well-formedness is a universal question."
     :meta "Well-formedness predicates transfer to any structural type.")
    (:eng "Validity gates precede every batch operation." :math "Recursive characteristic function on Pair⋆." :cs "Well-formedness checks are the base for safe recursion."))
  :row-4-proof (
    (:eng-program "(define (closed-under-cons? x xs) (if (list? xs) (list? (cons x xs)) #t))\n(and (closed-under-cons? 'a (list 1 2)) (closed-under-cons? 'a '()))"
     :math-program "(define (build-list n f) (map f (iota n)))\n(define (induction-step n) (list? (cons n (build-list n (lambda (i) i)))))\n(and (induction-step 0) (induction-step 1) (induction-step 5))"
     :cs-program "(define (invariant-holds pipeline) (list? (pipeline (list 1 2 3))))\n(invariant-holds (lambda (xs) (map (lambda (x) (* 2 x)) xs)))"
     :claim "list? is closed under cons: cons of anything onto a proper list yields a proper list."
     :invariant "∀ x xs. list?(xs) → list?(cons(x, xs))"
     :meta "Pattern: closure under a constructor. Same claim, three witnesses: an engineering test, a math induction step, a cs pipeline invariant.")
    (:eng "Closure lets constructors chain without re-checking after each cons." :math "The list-type is inductively defined; cons preserves the type." :cs "Closure under constructor is the essence of an inductive-type invariant."))
  :row-5-emergence (
    (:eng-composition "(define (all-lists? xs) (and (list? xs) (fold (lambda (r x) (and r (list? x))) #t xs)))\n(all-lists? (list (list 1) (list 2 3) (list)))"
     :math-composition "(define (nested-list-of-nat? xs) (and (list? xs) (fold (lambda (r x) (and r (or (integer? x) (nested-list-of-nat? x)))) #t xs)))\n(nested-list-of-nat? (list 1 (list 2 3) (list (list 4))))"
     :cs-composition "(define (validate-schema shape data) (cond ((eq? shape 'atom) (not (list? data))) ((eq? shape 'seq) (list? data)) ((and (pair? shape) (list? data)) (every (lambda (s d) (validate-schema s d)) shape data)) (else #f)))\n(validate-schema (list 'atom 'seq 'atom) (list 42 (list 1 2) 'x))"
     :base "list? tests proper list."
     :emergent "Compositions with list? build recursive validators: eng-flat-check, math-nested-typed, cs-schema-walker. All three grow from the same base predicate."
     :meta "Family: recursive-shape validation.")
    (:eng "The pattern grows deep structural checks from shallow ones." :math "The composition realizes a predicate over the free structure Pair⋆." :cs "Recursive validators compose by applying the base predicate at each level."))
)

(verb :name "exact?" :std "R7RS-small"          :library "predicate" :tier "core" :kind "pure" :signature "(exact? x) -> boolean"
  :summary "#t if x uses an exact numeric representation (integer or rational). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact? 3)" :note "#t — integers are exact.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3/4)) (and (exact? x) (not (zero? x))))" :note "Exact and non-zero — safe for exact division.")
    (:dialect "motoi" :tier "expert"       :code "(define (exact-solve n) (list 'exact n))\n(define (numeric-solve n) (list 'approx (exact->inexact n)))\n(define (route-solver n) (if (exact? n) (exact-solve n) (numeric-solve n)))\n(map route-solver (list 3 3.0 1/2 3.14))" :note "Dispatch table: exact values → symbolic solver, inexact → numeric."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (financial-multiply a b) (if (and (exact? a) (exact? b)) (* a b) (error 'shape 'inexact-in-finance)))\n(financial-multiply 19/2 5)"
     :math-program "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))"
     :cs-program "(define (tag-check v) (if (exact? v) :exact-tag :float-tag))\n(tag-check 42)"
     :problem "A financial multiply cannot admit floats — a rounding error becomes a lawsuit. The operator confirms exactness before dispatch."
     :explanation "eng: money math. math: solver routing. cs: representation tag. Same predicate, three domains."
     :meta "Reach for exact? and NOT integer?: integer? admits 3.0. exact? tracks the representation, which is what precision-critical code needs.")
    (:eng "Dispatch log names the branch: 'routed 5 to exact solver'." :math "exact? is the characteristic function of the exact subset of Number." :cs "Primitive; O(1) — reads the numeric tag."))
  :row-3-dimension (
    (:setup "Representation-classification: is this value in the exact-representation class."
     :rungs (
       (:domain "engineering"  :code "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))")
       (:domain "mathematics"  :code "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))")
       (:domain "cs / dispatch" :code "(define (dispatch-solver n) (if (exact? n) 'symbolic 'numeric))\n(map dispatch-solver (list 3 3.0 1/2))"))
     :explanation "Three domains, one representation-check."
     :meta "Representation-class transfers to any domain with distinguishable exact/inexact forms.")
    (:eng "Dispatch-on-representation is a routine hot-path shape." :math "A partition of Number by representation." :cs "Type-tag inspection is O(1) in tagged-value runtimes."))
  :row-4-proof (
    (:eng-program "(define (complementary? n) (or (exact? n) (inexact? n)))\n(and (complementary? 3) (complementary? 3.0) (complementary? 1/2))"
     :math-program "(define (exclusive? n) (not (and (exact? n) (inexact? n))))\n(and (exclusive? 3) (exclusive? 3.0))"
     :cs-program "(define (partition-check ns) (fold (lambda (r n) (and r (or (exact? n) (inexact? n)))) #t ns))\n(partition-check (list 1 2.0 3/4 4.5))"
     :claim "exact? and inexact? are complementary on the numeric domain: every number is exactly one."
     :invariant "∀ n ∈ Number. exact?(n) ⊕ inexact?(n)"
     :meta "Pattern: binary partition. Three witnesses to the same invariant.")
    (:eng "Complementarity means every number routes to exactly one branch." :math "Number is partitioned into exact and inexact classes." :cs "Tagged-value runtimes enforce this at the representation level."))
  :row-5-emergence (
    (:eng-composition "(define (all-exact? xs) (and (list? xs) (fold (lambda (r x) (and r (exact? x))) #t xs)))\n(all-exact? (list 1 2 3/4 5))"
     :math-composition "(define (all-exact? xs) (and (list? xs) (fold (lambda (r x) (and r (exact? x))) #t xs)))\n(define (exact-ring? xs) (and (all-exact? xs) (all-exact? (map (lambda (a) (fold * a xs)) xs))))\n(exact-ring? (list 1/2 2 3))"
     :cs-composition "(define (route-batch xs)\n  (let-values (((exacts inexacts) (partition (lambda (x) (exact? x)) xs)))\n    (list 'exact exacts 'inexact inexacts)))\n(route-batch (list 1 2.0 3/4 4.5))"
     :base "exact? tests representation class."
     :emergent "Compositions with exact? build representation-aware dispatchers: eng-batch-check, math-closed-ring-check, cs-partitioning."
     :meta "Family: representation-typed dispatch.")
    (:eng "Batch representation checks feed pipelines." :math "Closure of the exact class under ring operations is a checkable property." :cs "Partitioning by representation is the base of two-branch pipelines."))
)

(verb :name "inexact?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(inexact? x) -> boolean"
  :summary "#t if x uses an inexact (floating-point) numeric representation. R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(inexact? 3.14)" :note "#t — floats are inexact.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3.14)) (and (inexact? x) (finite? x)))" :note "#t for a well-behaved float (finite + inexact).")
    (:dialect "motoi" :tier "expert"       :code "(define (tolerance-check a b) (if (or (inexact? a) (inexact? b)) (< (abs (- a b)) 1e-9) (= a b)))\n(tolerance-check 3.14159 3.14158999)" :note "Choose exact equality vs. tolerance based on representation."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (fft-ready? xs) (and (list? xs) (fold (lambda (r x) (and r (inexact? x))) #t xs)))\n(fft-ready? (list 1.0 2.0 3.0 4.0))"
     :math-program "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)"
     :cs-program "(define (float-branch v) (if (inexact? v) :ieee-path :exact-path))\n(float-branch 2.71)"
     :problem "An FFT routine expects a list of floats; passing exact rationals crashes on the internal complex-arithmetic layer. The operator confirms inexact representation before FFT."
     :explanation "eng: signal-processing gate. math: equality-vs-tolerance choice. cs: code path selection."
     :meta "Reach for inexact? and NOT real?: real? admits both. inexact? is representation-specific.")
    (:eng "FFT precondition names the shape." :math "inexact? is the characteristic function of the inexact subset of Number." :cs "Primitive; O(1) — numeric tag inspection."))
  :row-3-dimension (
    (:setup "Representation dual of exact?"
     :rungs (
       (:domain "engineering"  :code "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)")
       (:domain "mathematics"  :code "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)")
       (:domain "cs / dispatch" :code "(define (needs-tolerance? a b) (or (inexact? a) (inexact? b)))\n(needs-tolerance? 3.14 22/7)"))
     :explanation "Sensor reads, numerical integration, float parsing — all yield inexact by nature."
     :meta "Representation-dual is a universal shape.")
    (:eng "Inexactness announces that measurement uncertainty is involved." :math "IEEE-754 floats are the standard inexact carrier." :cs "The float tag routes to hardware-accelerated paths."))
  :row-4-proof (
    (:eng-program "(define (fft-safe xs) (and (list? xs) (fold (lambda (r x) (and r (inexact? x))) #t xs)))\n(fft-safe (list 1.0 2.0))"
     :math-program "(define (dual-holds n) (not (and (exact? n) (inexact? n))))\n(and (dual-holds 3) (dual-holds 3.0))"
     :cs-program "(define (representative-count ns) (let* ((e (filter exact? ns)) (i (filter inexact? ns))) (= (length ns) (+ (length e) (length i)))))\n(representative-count (list 1 2.0 3/4))"
     :claim "inexact? and exact? are complementary on Number."
     :invariant "∀ n ∈ Number. inexact?(n) ⊕ exact?(n)"
     :meta "Same complementarity as exact?, viewed from the other side.")
    (:eng "Complementarity means routing is deterministic." :math "Dual partition of Number." :cs "Runtime tag routes to exactly one branch."))
  :row-5-emergence (
    (:eng-composition "(define (scale-if-float f xs) (map (lambda (x) (if (inexact? x) (f x) x)) xs))\n(scale-if-float (lambda (x) (* x 100)) (list 1 2.0 3 4.5))"
     :math-composition "(define (float-max xs) (fold (lambda (best x) (if (and (inexact? x) (or (not best) (> x best))) x best)) #f xs))\n(float-max (list 1 2.0 3 4.5))"
     :cs-composition "(define (float-normalize xs) (let ((max (fold (lambda (b x) (if (inexact? x) (max-safe b x) b)) 0 xs))) (map (lambda (x) (if (inexact? x) (/ x max) x)) xs)))\n(float-normalize (list 1.0 2.0 3.0))"
     :base "inexact? tests IEEE-float representation."
     :emergent "Compositions with inexact? build conditional-float pipelines."
     :meta "Family: conditional-float transformation.")
    (:eng "Conditional-transformation pipelines are ubiquitous." :math "Restricting an operation to the inexact subset is a valid partial function." :cs "Type-directed dispatch is a runtime optimization."))
)

(verb :name "integer?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(integer? x) -> boolean"
  :summary "#t if x is an integer value (representation-agnostic — 3.0 counts). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(integer? 42)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 5)) (and (integer? x) (positive? x)))" :note "Positive integer — the safe-index shape.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-index xs i) (and (integer? i) (>= i 0) (< i (length xs)) (list-ref xs i)))\n(safe-index (list 'a 'b 'c) 1)" :note "Guard bounds-check with integer? plus range checks."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-loop-times n body) (if (integer? n) (do ((i 0 (+ i 1))) ((= i n)) (body i)) (error 'shape 'need-integer-count)))\n(safe-loop-times 5 (lambda (i) i))"
     :math-program "(define (factorial n) (if (= n 0) 1 (* n (factorial (- n 1)))))\n(define (dispatch-op n op) (if (integer? n) (op n) (error 'shape 'need-integer)))\n(dispatch-op 4 factorial)"
     :cs-program "(define (parse-index tok) (let ((n (string->number tok))) (if (integer? n) n (raise (list :kind 'bad-index :got tok)))))\n(parse-index \"5\")"
     :problem "A loop count expected an integer; the caller passed 5.0. Should it work? R7RS says integer? admits 5.0 (it's an integer VALUE). Use exact-integer? if you need exact representation."
     :explanation "eng: loop guard. math: op dispatch. cs: parse validation."
     :meta "Reach for integer? and NOT exact-integer?: integer? admits 3.0. Choose based on whether the caller cares about representation.")
    (:eng "Integer-valued numbers admit both 5 and 5.0." :math "integer? is the characteristic function of the integer-valued subset of Number." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Value-class classification, representation-agnostic."
     :rungs (
       (:domain "engineering"  :code "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)")
       (:domain "mathematics"  :code "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)")
       (:domain "cs / dispatch" :code "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)"))
     :explanation "Integer values live in every domain."
     :meta "Value-class is a domain-neutral concept.")
    (:eng "Count guards precede every loop." :math "Membership in ℤ (as a value class)." :cs "Whole-number check is the base of every indexing operation."))
  :row-4-proof (
    (:eng-program "(define (closed-add xs) (and (fold (lambda (r x) (and r (integer? x))) #t xs) (integer? (fold + 0 xs))))\n(closed-add (list 1 2 3 4))"
     :math-program "(define (integer-ring? a b) (and (integer? a) (integer? b) (integer? (+ a b)) (integer? (- a b)) (integer? (* a b))))\n(integer-ring? 3 5)"
     :cs-program "(define (invariant? f xs) (and (fold (lambda (r x) (and r (integer? x))) #t xs) (integer? (fold f 0 xs))))\n(invariant? + (list 1 2 3))"
     :claim "integer? is closed under + and *."
     :invariant "∀ a b. integer?(a) ∧ integer?(b) → integer?(a+b) ∧ integer?(a·b)"
     :meta "Pattern: ring closure. Three witnesses in three domains.")
    (:eng "Closure lets integer-only pipelines chain safely." :math "ℤ is closed under + and ·." :cs "Type-preserving operations don't need mid-pipeline checks."))
  :row-5-emergence (
    (:eng-composition "(define (histogram xs) (let ((h (make-hash-table))) (for-each (lambda (x) (when (integer? x) (hash-table-update! h x (lambda (n) (+ n 1)) (lambda () 0)))) xs) h))\n(histogram (list 1 2 1 3 2.5 1))"
     :math-composition "(define (partition-p n) (if (= n 0) 1 (+ n 1)))\n(define (integer-partition-count n) (if (and (integer? n) (>= n 0)) (partition-p n) 0))\n(integer-partition-count 5)"
     :cs-composition "(define (index-map xs) (let loop ((xs xs) (i 0) (acc '())) (cond ((null? xs) (reverse acc)) ((integer? i) (loop (cdr xs) (+ i 1) (cons (cons i (car xs)) acc))))))\n(index-map (list 'a 'b 'c))"
     :base "integer? tests whole-value shape."
     :emergent "Compositions with integer? build tabulation and enumeration pipelines."
     :meta "Family: whole-value tabulation.")
    (:eng "Tabulation is the base for reports and dashboards." :math "Enumeration over integer classes generates combinatorial structures." :cs "Indexed transformations produce named collections."))
)

(verb :name "rational?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(rational? x) -> boolean"
  :summary "#t if x is a rational value (integer or ratio). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(rational? 1/2)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3/4)) (and (rational? x) (not (zero? x))))" :note "Nonzero rational — safe divisor.")
    (:dialect "motoi" :tier "expert"       :code "(define (item-price item) (car item))\n(define (cost-in-rationals items) (fold + 0 (filter rational? (map item-price items))))\n(cost-in-rationals (list (list 1/2) (list 3.14) (list 2/3)))" :note "Financial pipeline drops any non-rational entry."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-divide a b) (if (and (rational? a) (rational? b) (not (zero? b))) (/ a b) (error 'shape 'divide-guard)))\n(safe-divide 3 2)"
     :math-program "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)"
     :cs-program "(define (parse-rat-or-fail s) (let ((n (string->number s))) (if (rational? n) n (raise (list :kind 'bad-rat :got s)))))\n(parse-rat-or-fail \"3/4\")"
     :problem "Financial code must reject irrationals and infinities; only rationals fit the domain."
     :explanation "eng: money math. math: finite-rational check. cs: parse validation."
     :meta "Reach for rational? and NOT real?: real? admits π and inf. rational? excludes both.")
    (:eng "Finance guards reject non-rationals." :math "rational? is the characteristic function of ℚ within the numeric tower." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Value-class check for expressible-as-ratio."
     :rungs (
       (:domain "engineering"  :code "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)")
       (:domain "mathematics"  :code "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)")
       (:domain "cs / dispatch" :code "(define (finite-rat-op? n) (and (rational? n) (finite? n)))\n(finite-rat-op? 22/7)"))
     :explanation "Rationals fit finance, linear algebra, and structured parsing."
     :meta "Value-class transfers to any rational-only domain.")
    (:eng "Financial safety." :math "Membership in ℚ." :cs "Representable-in-decimal without loss."))
  :row-4-proof (
    (:eng-program "(define (closed-under-add? a b) (and (rational? a) (rational? b) (rational? (+ a b))))\n(closed-under-add? 1/2 1/3)"
     :math-program "(define (field-holds? a b) (and (rational? a) (rational? b) (not (zero? b)) (rational? (/ a b))))\n(field-holds? 3 4)"
     :cs-program "(define (pipeline-preserves-rat? f a) (and (rational? a) (rational? (f a))))\n(pipeline-preserves-rat? (lambda (x) (* x 2)) 3/5)"
     :claim "rational? is closed under +, -, *, and / (with non-zero divisor)."
     :invariant "∀ a b ∈ ℚ, b ≠ 0. rational?(a op b) for op ∈ {+, -, *, /}"
     :meta "Pattern: field closure. Three witnesses.")
    (:eng "Financial closure means pipelines stay in ℚ." :math "ℚ is a field." :cs "Type-preserving arithmetic is a pipeline invariant."))
  :row-5-emergence (
    (:eng-composition "(define (rational-sum xs) (fold + 0 (filter rational? xs)))\n(rational-sum (list 1 2/3 3.14 4/7))"
     :math-composition "(define (mediant a b) (if (and (rational? a) (rational? b)) (/ (+ (numerator a) (numerator b)) (+ (denominator a) (denominator b))) (error 'shape 'mediant-needs-rationals)))\n(mediant 1/2 1/3)"
     :cs-composition "(define (rat-schema-check v) (cond ((rational? v) :ok) ((real? v) :out-of-rat) (else :not-num)))\n(rat-schema-check 3.14)"
     :base "rational? tests ratio-representable shape."
     :emergent "Compositions with rational? build financial safety, mediant construction, schema-validation."
     :meta "Family: rational-arithmetic safety.")
    (:eng "Financial pipelines depend on rational safety." :math "Farey-sequence mediants use rational-only arithmetic." :cs "Schema validation grades by tightness of the value class."))
)

(verb :name "real?" :std "R7RS-small"           :library "predicate" :tier "core" :kind "pure" :signature "(real? x) -> boolean"
  :summary "#t if x is a real number (integer, rational, or float). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(real? 3.14)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3.14)) (and (real? x) (not (nan? x))))" :note "Real and not-NaN — a proper number.")
    (:dialect "motoi" :tier "expert"       :code "(define (physics-quantity v) (if (real? v) v (error 'shape 'need-real)))\n(map physics-quantity (list 3 3.14 22/7))" :note "Physics gate — every real, no complex."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (physics/accel-input v) (if (real? v) v (raise (list :kind 'shape :got v))))\n(physics/accel-input 9.8)"
     :math-program "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)"
     :cs-program "(define (numeric-parse-or-raise s) (let ((n (string->number s))) (if (real? n) n (raise (list :kind 'bad-num :got s)))))\n(numeric-parse-or-raise \"3.14\")"
     :problem "A physics function needs a real quantity; complex numbers are not physically meaningful for this call. Real? admits the intended set."
     :explanation "eng: physics gate. math: comparable check. cs: parse ok."
     :meta "Reach for real? and NOT complex?: complex? admits imaginary numbers which fail the physical interpretation.")
    (:eng "Physics inputs cannot be complex." :math "real? is the characteristic function of ℝ within Number." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Value-class check for placement on the number line."
     :rungs (
       (:domain "engineering"  :code "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)")
       (:domain "mathematics"  :code "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)")
       (:domain "cs / dispatch" :code "(define (comparable? a b) (and (real? a) (real? b)))\n(comparable? 3 4.5)"))
     :explanation "Every real-valued signal, limit, or parsed number."
     :meta "Ordering on ℝ makes real? the shape for comparison-based algorithms.")
    (:eng "Sensor signals are real by nature." :math "ℝ is totally ordered." :cs "Real-tagged values support < and > without extra checks."))
  :row-4-proof (
    (:eng-program "(define (sort-safely xs) (if (fold (lambda (x r) (and r (real? x))) #t xs) (sort xs <) (error 'shape 'not-all-real)))\n(sort-safely (list 3.1 1 2.5))"
     :math-program "(define (rat-implies-real? xs) (fold (lambda (x r) (and r (if (rational? x) (real? x) #t))) #t xs))\n(rat-implies-real? (list 1/2 3 4.5))"
     :cs-program "(define (dual-check n) (or (real? n) (not (rational? n))))\n(and (dual-check 3) (dual-check \"not-a-num\"))"
     :claim "rational? ⊂ real?: every rational is real."
     :invariant "∀ n. rational?(n) → real?(n)"
     :meta "Pattern: subset containment. Three domains show the same containment.")
    (:eng "Real superset means any rational-required op works with real inputs." :math "ℚ ⊂ ℝ." :cs "Type widening preserves query results."))
  :row-5-emergence (
    (:eng-composition "(define (stats-summary xs) (let ((reals (filter real? xs))) (if (null? reals) 'none (list :count (length reals) :min (fold min (car reals) reals) :max (fold max (car reals) reals)))))\n(stats-summary (list 3 2.5 'hey 7 1.1))"
     :math-composition "(define (real-line-position x) (cond ((not (real? x)) :off-line) ((negative? x) :left) ((positive? x) :right) (else :zero)))\n(real-line-position -2.5)"
     :cs-composition "(define (real-schema data) (map (lambda (v) (cons (real? v) v)) data))\n(real-schema (list 3 'a 2.5))"
     :base "real? tests placement on the number line."
     :emergent "Compositions build statistics, positional queries, schema tags."
     :meta "Family: ordered-value operations.")
    (:eng "Stats routines assume real-valued input." :math "Sign and ordering are queryable properties of ℝ." :cs "Schema tags per element enable heterogeneous data pipelines."))
)

(verb :name "complex?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(complex? x) -> boolean"
  :summary "#t if x is any number (real, rational, integer, or complex). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(complex? 3)" :note "#t — every number is complex? in R7RS.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3)) (and (complex? x) (not (complex? #f))))" :note "Actually-complex — has an imaginary part.")
    (:dialect "motoi" :tier "expert"       :code "(define (is-any-num? v) (complex? v))\n(filter is-any-num? (list 3 'x 3.14 \"hi\"))" :note "Universal numeric gate: keeps every numeric flavor."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (numeric-dispatch v) (if (complex? v) 'proceed 'skip))\n(map numeric-dispatch (list 3 'a 3.14 (list)))"
     :math-program "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))"
     :cs-program "(define (numeric-only xs) (filter complex? xs))\n(numeric-only (list 3 'x 3.14 \"hi\"))"
     :problem "A downstream numeric op accepts any flavor of number; the operator gates on complex? to filter out non-numeric noise before dispatch."
     :explanation "eng: general numeric gate. math: hierarchy classification. cs: filter."
     :meta "Reach for complex? when you want ANY number and don't care about the specific class.")
    (:eng "General numeric gate: broad but honest." :math "complex? is the top of the numeric tower." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Umbrella check for any numeric shape."
     :rungs (
       (:domain "engineering"  :code "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))")
       (:domain "mathematics"  :code "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))")
       (:domain "cs / dispatch" :code "(define (num-domain n) (cond ((integer? n) :Z) ((rational? n) :Q) ((real? n) :R) ((complex? n) :C) (else :not-a-number)))\n(map num-domain (list 3 1/2 3.14))"))
     :explanation "Anything numeric — from FFT bins to parsed literals."
     :meta "Universal numeric umbrella.")
    (:eng "Broad numeric acceptance is often desired." :math "ℂ contains ℝ contains ℚ contains ℤ." :cs "Numeric tagging enables uniform dispatch."))
  :row-4-proof (
    (:eng-program "(define (widening-holds? xs) (fold (lambda (r x) (and r (if (integer? x) (complex? x) #t))) #t xs))\n(widening-holds? (list 1 2 3))"
     :math-program "(define (tower-holds? n) (or (not (rational? n)) (complex? n)))\n(and (tower-holds? 1/2) (tower-holds? 3))"
     :cs-program "(define (containment-check ns) (equal? (length (filter complex? ns)) (length (filter (lambda (n) (or (integer? n) (rational? n) (real? n) (complex? n))) ns))))\n(containment-check (list 1 2/3 3.14))"
     :claim "integer? ⊂ rational? ⊂ real? ⊂ complex?."
     :invariant "∀ n. integer?(n) → rational?(n) → real?(n) → complex?(n)"
     :meta "Pattern: nested subset chain.")
    (:eng "Chain widening: any narrower class satisfies broader ones." :math "The numeric tower is a chain of inclusions." :cs "Type widening never fails."))
  :row-5-emergence (
    (:eng-composition "(define (numeric-only xs) (filter complex? xs))\n(numeric-only (list 3 'x 3.14))"
     :math-composition "(define (num-partition ns) (list :int (filter integer? ns) :rat (filter (lambda (n) (and (rational? n) (not (integer? n)))) ns) :real (filter (lambda (n) (and (real? n) (not (rational? n)))) ns)))\n(num-partition (list 1 1/2 3.14))"
     :cs-composition "(define (parse-any-num src) (let ((n (string->number src))) (if (complex? n) n :parse-fail)))\n(parse-any-num \"3.14\")"
     :base "complex? tests any-numeric shape."
     :emergent "Umbrella filter, class partition, permissive parser."
     :meta "Family: umbrella-typed pipelines.")
    (:eng "Umbrella filters preserve permissive behavior." :math "The numeric tower supports classification." :cs "Permissive parsers admit every well-formed number."))
)

(verb :name "exact-integer?" :std "R7RS-small"  :library "predicate" :tier "core" :kind "pure" :signature "(exact-integer? x) -> boolean"
  :summary "#t if x is both integer? and exact?. R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact-integer? 42)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(exact-integer? 3.0)" :note "#f — 3.0 is integer-valued but inexact.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-array-ref xs i) (if (exact-integer? i) (list-ref xs i) (error 'shape 'index-must-be-exact)))\n(safe-array-ref (list 'a 'b 'c) 1)" :note "Strict indexing: only exact integers as array indices."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-index xs i) (if (exact-integer? i) (list-ref xs i) (error 'shape 'need-exact-int)))\n(safe-index (list 'a 'b 'c) 1)"
     :math-program "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)"
     :cs-program "(define (bit-shift-left n k) (* n (expt 2 k)))\n(define (bit-op n) (if (exact-integer? n) (bit-shift-left n 1) (error 'shape 'need-exact-int)))\n(bit-op 7)"
     :problem "Array indices and bit operations demand exact integers — 3.0 might be equal to 3 but the hardware wants a machine integer."
     :explanation "eng: array indexing. math: recursive factorial (needs integer termination). cs: bit-shift needs word-value."
     :meta "Reach for exact-integer? and NOT integer?: integer? admits 3.0. exact-integer? is the strict machine-int check.")
    (:eng "Strict integer for hardware-adjacent operations." :math "The exact-integer set is ℤ with tagged representation." :cs "Machine-word check is one tag comparison."))
  :row-3-dimension (
    (:setup "Strict tag + value check."
     :rungs (
       (:domain "engineering"  :code "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)")
       (:domain "mathematics"  :code "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)")
       (:domain "cs / dispatch" :code "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(fac 5)"))
     :explanation "Strict integer domains: indexing, induction, bit-ops."
     :meta "Strict tag check is universal to hardware-adjacent code.")
    (:eng "Hardware operations need exact-tagged inputs." :math "Peano-style recursion requires exact zero and successor." :cs "Bit operations produce exact integers by construction."))
  :row-4-proof (
    (:eng-program "(define (equivalent? n) (equal? (exact-integer? n) (and (exact? n) (integer? n))))\n(and (equivalent? 3) (equivalent? 3.0) (equivalent? 1/2))"
     :math-program "(define (subset? n) (or (not (exact-integer? n)) (and (exact? n) (integer? n))))\n(and (subset? 3) (subset? 3.0))"
     :cs-program "(define (impl-check ns) (fold (lambda (r n) (and r (equal? (exact-integer? n) (and (exact? n) (integer? n))))) #t ns))\n(impl-check (list 3 3.0 1/2 42))"
     :claim "exact-integer? ⇔ (exact? ∧ integer?)."
     :invariant "∀ n. exact-integer?(n) ⇔ (exact?(n) ∧ integer?(n))"
     :meta "Pattern: conjunctive definition. Three witnesses.")
    (:eng "Composition of predicates is a valid predicate." :math "Intersection of two subsets." :cs "Two tag checks combined."))
  :row-5-emergence (
    (:eng-composition "(define (indices-of xs pred) (let loop ((xs xs) (i 0) (acc '())) (cond ((null? xs) (reverse acc)) ((and (exact-integer? i) (pred (car xs))) (loop (cdr xs) (+ i 1) (cons i acc))) (else (loop (cdr xs) (+ i 1) acc)))))\n(indices-of (list 'a 'b 'a 'c) (lambda (x) (eq? x 'a)))"
     :math-composition "(define (fac n) (if (exact-integer? n) (if (zero? n) 1 (* n (fac (- n 1)))) (error 'shape 'need-exact-int)))\n(define (binomial n k) (if (and (exact-integer? n) (exact-integer? k) (>= n k)) (/ (fac n) (* (fac k) (fac (- n k)))) 0))\n(binomial 5 2)"
     :cs-composition "(define (bit-shift-left n k) (* n (expt 2 k)))\n(define (bit-or a b) (let loop ((a a) (b b) (bit 1) (acc 0)) (if (and (= a 0) (= b 0)) acc (loop (quotient a 2) (quotient b 2) (* bit 2) (if (or (odd? a) (odd? b)) (+ acc bit) acc)))))\n(define (bitset xs) (fold (lambda (x b) (if (exact-integer? x) (bit-or b (bit-shift-left 1 x)) b)) 0 xs))\n(bitset (list 0 2 3))"
     :base "exact-integer? tests machine-integer shape."
     :emergent "Compositions build index-lists, exact combinatorics, bitsets."
     :meta "Family: hardware-adjacent integer operations.")
    (:eng "Index tracking assumes exact counters." :math "Combinatorial functions demand exact integers." :cs "Bitsets are one-bit-per-integer encodings."))
)

(verb :name "finite?" :std "R7RS-small"         :library "predicate" :tier "core" :kind "pure" :signature "(finite? x) -> boolean"
  :summary "#t if x is a finite real (not +inf.0, -inf.0, or +nan.0). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(finite? 3.14)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x 3.14)) (and (real? x) (finite? x)))" :note "Real and finite — safe for arithmetic.")
    (:dialect "motoi" :tier "expert"       :code "(define (fft-guard xs) (if (fold (lambda (r x) (and r (finite? x))) #t xs) (fft xs) (error 'shape 'not-finite)))" :note "Guard signal processing — no inf/nan in the buffer."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (fft-safe xs) (fold (lambda (r x) (and r (finite? x))) #t xs))\n(fft-safe (list 1.0 2.0 3.0))"
     :math-program "(define (limit-attained? x) (finite? x))\n(limit-attained? 3.14)"
     :cs-program "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)"
     :problem "IEEE ±inf and NaN crash downstream: FFT loses convergence, JSON encoders raise, chart libraries flatten. Guard before dispatch."
     :explanation "eng: fft guard. math: limit convergence test. cs: JSON-safe check."
     :meta "Reach for finite? and NOT real?: real? admits inf and nan. finite? is the useful-value check.")
    (:eng "IEEE inf/nan corruption is silent until it lands." :math "finite? is the characteristic function of ℝ excluding infinities and NaN." :cs "Primitive; O(1) — IEEE class inspection."))
  :row-3-dimension (
    (:setup "IEEE-well-formedness check."
     :rungs (
       (:domain "engineering"  :code "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)")
       (:domain "mathematics"  :code "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)")
       (:domain "cs / dispatch" :code "(define (json-safe-number? x) (and (real? x) (finite? x)))\n(json-safe-number? 3.14)"))
     :explanation "Well-formed real from sensor, integrator, parser."
     :meta "IEEE well-formedness is universal.")
    (:eng "Sensor edge cases produce inf/nan; guard them." :math "The finite subset supports all arithmetic without pollution." :cs "IEEE-754 non-finite values need explicit handling."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (finite-not-inf? n) (implies (finite? n) (not (infinite? n))))\n(and (finite-not-inf? 3.0) (finite-not-inf? +inf.0))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (partition-holds? n) (implies (finite? n) (and (not (infinite? n)) (not (nan? n)))))\n(and (partition-holds? 3.0) (partition-holds? +nan.0))"
     :cs-program "(define (mut-exclusive? n) (= 1 (+ (if (finite? n) 1 0) (if (infinite? n) 1 0) (if (nan? n) 1 0))))\n(mut-exclusive? 3.14)"
     :claim "finite?, infinite?, and nan? partition the IEEE reals."
     :invariant "∀ n ∈ Real. exactly one of finite?(n), infinite?(n), nan?(n)"
     :meta "Pattern: three-way partition. Three witnesses.")
    (:eng "Exactly-one-of routing is deterministic." :math "IEEE-754 classifies each value into one of five classes (normal, subnormal, zero, inf, nan) — Motoi merges the finite ones." :cs "Class inspection returns exactly one tag."))
  :row-5-emergence (
    (:eng-composition "(define (clean-signal xs) (filter finite? xs))\n(clean-signal (list 1.0 +inf.0 2.0 +nan.0 3.0))"
     :math-composition "(define (converges? seq) (finite? (fold (lambda (a b) (if (and (finite? a) (finite? b)) (+ a b) +nan.0)) 0 seq)))\n(converges? (list 1.0 0.5 0.25 0.125))"
     :cs-composition "(define (normalize-json xs) (map (lambda (x) (if (finite? x) x 'null)) xs))\n(normalize-json (list 1.0 +inf.0 3.14))"
     :base "finite? tests IEEE well-formedness."
     :emergent "Compositions build signal cleaners, convergence tests, JSON normalizers."
     :meta "Family: IEEE-safe pipelines.")
    (:eng "Cleaning signals is a pre-dispatch discipline." :math "Convergence is a finite-sum question." :cs "JSON encoders demand finite values."))
)

(verb :name "infinite?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(infinite? x) -> boolean"
  :summary "#t if x is +inf.0 or -inf.0. R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(infinite? +inf.0)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x +inf.0)) (or (infinite? x) (nan? x)))" :note "Non-finite — includes both extremes.")
    (:dialect "motoi" :tier "expert"       :code "(define (saturation-detect xs) (any infinite? xs))\n(saturation-detect (list 1.0 +inf.0 3.0))" :note "Detect overflow in a numeric pipeline."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (overflow-flag xs) (if (any infinite? xs) 'overflow 'ok))\n(overflow-flag (list 3.0 +inf.0))"
     :math-program "(define (divergence-flag seq) (if (infinite? (fold + 0 seq)) 'diverges 'converges))\n(divergence-flag (list 1e300 1e300 1e300))"
     :cs-program "(define (limit-hit? v) (or (infinite? v) (nan? v)))\n(limit-hit? +inf.0)"
     :problem "Overflow in numeric computation manifests as +inf.0. Detect it explicitly rather than silently propagating."
     :explanation "eng: overflow. math: divergence. cs: general limit hit."
     :meta "Reach for infinite? and NOT (not (finite?)): the negation admits NaN too. infinite? is precise.")
    (:eng "Overflow detection is a value question." :math "±∞ signals numerical divergence." :cs "IEEE ±inf is a specific tag class."))
  :row-3-dimension (
    (:setup "Limit-value classification."
     :rungs (
       (:domain "engineering"  :code "(define (divergence-flag seq) (if (infinite? (fold + 0 seq)) 'diverges 'converges))\n(divergence-flag (list 1e300 1e300 1e300))")
       (:domain "mathematics"  :code "(define (divergence-flag seq) (if (infinite? (fold + 0 seq)) 'diverges 'converges))\n(divergence-flag (list 1e300 1e300 1e300))")
       (:domain "cs / dispatch" :code "(infinite? (string->number \"1e400\"))"))
     :explanation "Any limit or overflow reveals infinite?."
     :meta "Limit sentinel is a universal shape.")
    (:eng "Multiplicative accumulators overflow to inf." :math "Limits at infinity produce infinite? values." :cs "Parsing very-large literals yields inf."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (finite-complement? n) (implies (infinite? n) (not (finite? n))))\n(and (finite-complement? +inf.0) (finite-complement? 3.0))"
     :math-program "(define (sign-preserving? n) (if (infinite? n) (or (positive? n) (negative? n)) #t))\n(and (sign-preserving? +inf.0) (sign-preserving? -inf.0))"
     :cs-program "(define (num-of-inf ns) (length (filter infinite? ns)))\n(num-of-inf (list 1.0 +inf.0 -inf.0 2.0))"
     :claim "infinite? implies not finite? and not nan?."
     :invariant "∀ n. infinite?(n) → ¬finite?(n) ∧ ¬nan?(n)"
     :meta "Pattern: mutually exclusive class.")
    (:eng "Class exclusion means one branch fires." :math "±∞ have signed identity." :cs "Counting values by tag is a common metric."))
  :row-5-emergence (
    (:eng-composition "(define (saturation-report xs) (list :count (length (filter infinite? xs)) :any? (any infinite? xs)))\n(saturation-report (list 1.0 +inf.0 2.0))"
     :math-composition "(define (bounded-monoid xs) (if (any infinite? xs) 'unbounded (fold + 0 xs)))\n(bounded-monoid (list 1 2 3))"
     :cs-composition "(define (clip-infs xs cap) (map (lambda (x) (if (infinite? x) (if (positive? x) cap (- cap)) x)) xs))\n(clip-infs (list 1.0 +inf.0 -inf.0) 1e6)"
     :base "infinite? tests the ±∞ sentinel."
     :emergent "Compositions build saturation reports, boundedness checks, clipping."
     :meta "Family: numeric-limit management.")
    (:eng "Saturation is a common pipeline flag." :math "Boundedness is a mathematical property, checkable at the boundary." :cs "Clipping is a defensive pattern against sensor overflow."))
)

(verb :name "nan?" :std "R7RS-small"            :library "predicate" :tier "core" :kind "pure" :signature "(nan? x) -> boolean"
  :summary "#t if x is +nan.0 (an IEEE Not-a-Number). R7RS §6.2."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(nan? +nan.0)" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((x +nan.0)) (or (nan? x) (not (real? x))))" :note "Not-a-real: NaN or not a number at all.")
    (:dialect "motoi" :tier "expert"       :code "(define (scrub-nans xs) (filter (lambda (x) (not (nan? x))) xs))\n(scrub-nans (list 1.0 +nan.0 2.0))" :note "Remove NaN corruption from a numeric buffer."))
  :provenance "R7RS §6.2; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-divide a b) (let ((r (/ a b))) (if (nan? r) 'nan-detected r)))\n(safe-divide 0.0 0.0)"
     :math-program "(define (undefined-flag x) (if (nan? x) 'undefined 'defined))\n(undefined-flag +nan.0)"
     :cs-program "(define (json-serialize v) (if (nan? v) \"null\" (number->string v)))\n(json-serialize +nan.0)"
     :problem "NaN silently propagates through arithmetic; every downstream op inherits the NaN. Detect at the source, don't chase it downstream."
     :explanation "eng: divide-by-zero. math: undefined-value marker. cs: JSON has no NaN."
     :meta "Reach for nan? and NOT (= x x): NaN is unique in that (= +nan.0 +nan.0) is #f. Use nan? for a definitive check.")
    (:eng "NaN detection at source prevents corruption downstream." :math "NaN represents mathematically undefined results (0/0, log(-1))." :cs "JSON, YAML, and most serializers have no NaN — must map to null."))
  :row-3-dimension (
    (:setup "IEEE-undefined check."
     :rungs (
       (:domain "engineering"  :code "(define (undefined-flag x) (if (nan? x) 'undefined 'defined))\n(undefined-flag +nan.0)")
       (:domain "mathematics"  :code "(nan? (sqrt -1.0))")
       (:domain "cs / dispatch" :code "(nan? +nan.0)"))
     :explanation "Every mathematically undefined result surfaces as NaN in IEEE arithmetic."
     :meta "Undefined-marker is a universal shape.")
    (:eng "Divide-by-zero, sqrt of negative, log of zero — all yield NaN." :math "IEEE-754 defines NaN as the undefined-value sentinel." :cs "NaN is its own equivalence class (violates reflexivity)."))
  :row-4-proof (
    (:eng-program "(define (self-not-equal? x) (if (nan? x) (not (= x x)) #t))\n(and (self-not-equal? +nan.0) (self-not-equal? 3.14))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (partition-check n) (implies (nan? n) (and (not (finite? n)) (not (infinite? n)))))\n(and (partition-check +nan.0) (partition-check 3.0))"
     :cs-program "(define (identify-nans ns) (map (lambda (n) (cons n (nan? n))) ns))\n(identify-nans (list 1.0 +nan.0 3.0))"
     :claim "NaN violates reflexivity: (= x x) is #f when x is NaN."
     :invariant "∀ x. nan?(x) ⇒ ¬(= x x)"
     :meta "Pattern: reflexivity failure — the definitional weirdness of NaN.")
    (:eng "Equality-with-self is the classic NaN detection reflex." :math "IEEE mandates non-reflexivity of NaN." :cs "Runtime tests use nan? because = returns false."))
  :row-5-emergence (
    (:eng-composition "(define (clean-buffer xs) (map (lambda (x) (if (nan? x) 0.0 x)) xs))\n(clean-buffer (list 1.0 +nan.0 2.0))"
     :math-composition "(define (mean-ignore-nan xs) (let ((clean (filter (lambda (x) (not (nan? x))) xs))) (if (null? clean) +nan.0 (/ (fold + 0 clean) (length clean)))))\n(mean-ignore-nan (list 1.0 +nan.0 3.0))"
     :cs-composition "(define (nan-report xs) (list :count (length (filter nan? xs)) :indices (let loop ((xs xs) (i 0) (acc '())) (cond ((null? xs) (reverse acc)) ((nan? (car xs)) (loop (cdr xs) (+ i 1) (cons i acc))) (else (loop (cdr xs) (+ i 1) acc))))))\n(nan-report (list 1.0 +nan.0 3.0 +nan.0))"
     :base "nan? tests IEEE undefined-value."
     :emergent "Compositions build corruption-cleanup pipelines."
     :meta "Family: NaN-safe numeric pipelines.")
    (:eng "Cleanup replaces NaN with a safe default." :math "Aggregations must decide whether to skip or fail on NaN." :cs "Diagnostic reports name where NaN entered the pipeline."))
)

(verb :name "eof-object?" :std "R7RS-small"     :library "predicate" :tier "core" :kind "pure" :signature "(eof-object? x) -> boolean"
  :summary "#t if x is the EOF sentinel (from read/read-char at stream end). R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(eof-object? (read-char (open-input-string \"\")))" :note "#t — empty stream yields EOF at first read.")
    (:dialect "motoi" :tier "intermediate" :code "(let* ((port (open-input-string \"a\")) (c (read-char port))) (or (eof-object? c) (char? c)))" :note "Either EOF or a character; nothing else.")
    (:dialect "motoi" :tier "expert"       :code "(define (read-all p) (let loop ((acc '())) (let ((line (read-line p))) (if (eof-object? line) (reverse acc) (loop (cons line acc))))))\n(read-all (open-input-string \"a\\nb\\nc\"))" :note "EOF is the loop terminator for streamed I/O."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-getline p) (let ((ln (read-line p))) (if (eof-object? ln) 'done ln)))\n(safe-getline (open-input-string \"hello\"))"
     :math-program "(define (stream-fold p f seed) (let loop ((acc seed)) (let ((v (read-char p))) (if (eof-object? v) acc (loop (f acc 1))))))\n(stream-fold (open-input-string \"123\") + 0)"
     :cs-program "(define (char-count p) (let loop ((acc '())) (let ((t (read-char p))) (if (eof-object? t) (reverse acc) (loop (cons t acc))))))\n(length (char-count (open-input-string \"abc\")))"
     :problem "A read loop must terminate when input ends. eof-object? tells you when to stop — every other value is real data."
     :explanation "eng: getline. math: fold over stream. cs: token parser."
     :meta "Reach for eof-object? — no sibling. EOF is a singleton, not a character or a value.")
    (:eng "Line readers use EOF as the termination signal." :math "Fold over a stream terminates at EOF." :cs "Token parsers read until EOF."))
  :row-3-dimension (
    (:setup "Stream-terminator check."
     :rungs (
       (:domain "engineering"  :code "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)")
       (:domain "mathematics"  :code "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)")
       (:domain "cs / dispatch" :code "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)"))
     :explanation "Every stream — log, sequence, parser — signals its end with EOF."
     :meta "Stream terminator is a universal shape.")
    (:eng "Log reading needs an end marker." :math "Finite streams terminate; EOF is the marker." :cs "Parsers read until the token supply ends."))
  :row-4-proof (
    (:eng-program "(define (never-a-char? p) (let loop ((n 5)) (let ((c (read-char p))) (if (eof-object? c) #t (loop (- n 1))))))\n(never-a-char? (open-input-string \"a\"))"
     :math-program "(define (singleton? p) (let ((eof (read-char (open-input-string \"\")))) (eof-object? eof)))\n(singleton? #f)"
     :cs-program "(define (once-emitted p) (let* ((eof (read-char (open-input-string \"\"))) (again (read-char (open-input-string \"\")))) (and (eof-object? eof) (eof-object? again))))\n(once-emitted #f)"
     :claim "eof-object? is a singleton — there is only one EOF value."
     :invariant "∀ p q — end-of-stream. eof?(p) ∧ eof?(q) ⇒ eq?(p, q)"
     :meta "Pattern: singleton object.")
    (:eng "Singleton terminator means comparison is a tag check." :math "The EOF set has cardinality 1." :cs "Singleton objects support eq? identity."))
  :row-5-emergence (
    (:eng-composition "(define (all-lines p) (let loop ((acc '())) (let ((l (read-line p))) (if (eof-object? l) (reverse acc) (loop (cons l acc))))))\n(all-lines (open-input-string \"a\\nb\\nc\"))"
     :math-composition "(define (stream-char-sum p) (let loop ((s 0)) (let ((c (read-char p))) (if (eof-object? c) s (loop (+ s 1))))))\n(stream-char-sum (open-input-string \"1 2 3 4\"))"
     :cs-composition "(define (char-count p) (let loop ((n 0)) (let ((c (read-char p))) (if (eof-object? c) n (loop (+ n 1))))))\n(char-count (open-input-string \"abc\"))"
     :base "eof-object? tests EOF sentinel."
     :emergent "Compositions build line readers, stream aggregators, token counters."
     :meta "Family: streaming aggregation.")
    (:eng "Line readers are the canonical text-processing entry point." :math "Streaming folds compute aggregates without materializing all elements." :cs "Token counters yield lexer statistics."))
)

(verb :name "input-port?" :std "R7RS-small"        :library "predicate" :tier "core" :kind "pure" :signature "(input-port? p) -> boolean"
  :summary "#t if p is a read-capable port. R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(input-port? (open-input-string \"x\"))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-input-string \"x\"))) (and (input-port? p) (not (output-port? p))))" :note "Read-only port.")
    (:dialect "motoi" :tier "expert"       :code "(define (with-input-port p thunk) (if (input-port? p) (thunk p) (error 'shape 'need-input-port)))\n(with-input-port (open-input-string \"a\") read-char)" :note "Higher-order I/O helper — guards direction before dispatch."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-read-char p) (if (input-port? p) (read-char p) (error 'shape 'not-a-read-port)))\n(safe-read-char (open-input-string \"42\"))"
     :math-program "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))"
     :cs-program "(define (validate-capability p) (if (input-port? p) 'read-cap 'no-read-cap))\n(validate-capability (open-input-string \"x\"))"
     :problem "A read verb that expects an input-port refuses to run against an output-port, preventing a confusing exception deep in the read machinery."
     :explanation "eng: safe-read. math: dispatch by direction. cs: capability check."
     :meta "Reach for input-port? and NOT port?: port? admits output ports too, which would cause read to fail deeper.")
    (:eng "Direction check names the boundary error." :math "input-port? is the characteristic function of the read-capable subset." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Direction-typing on handles."
     :rungs (
       (:domain "engineering"  :code "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))")
       (:domain "mathematics"  :code "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))")
       (:domain "cs / dispatch" :code "(define (dispatch-by-direction p) (cond ((input-port? p) :reader) ((output-port? p) :writer) (else :non-port)))\n(dispatch-by-direction (open-input-string \"x\"))"))
     :explanation "Read direction on a file, a string, or a pipe."
     :meta "Direction-typed handles are universal.")
    (:eng "Read direction is a boundary predicate." :math "Reader ⊆ Port." :cs "Capability typing supports safe upcasting."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (imp-port? p) (implies (input-port? p) (port? p)))\n(and (imp-port? (open-input-string \"x\")) (imp-port? (open-output-string)))"
     :math-program "(define (sub-holds? p) (or (not (input-port? p)) (port? p)))\n(sub-holds? (open-input-string \"x\"))"
     :cs-program "(define (union-check ps) (fold (lambda (r p) (and r (or (input-port? p) (not (input-port? p))))) #t ps))\n(union-check (list (open-input-string \"a\") (open-output-string)))"
     :claim "input-port? ⊂ port?: every input-port is a port."
     :invariant "∀ p. input-port?(p) → port?(p)"
     :meta "Pattern: subset containment.")
    (:eng "Sub-class admission is a universal I/O rule." :math "Reader ⊂ Port ⊃ Writer." :cs "Type widening preserves capability."))
  :row-5-emergence (
    (:eng-composition "(define (read-all-if-input p) (if (input-port? p) (let loop ((acc '())) (let ((v (read-char p))) (if (eof-object? v) (reverse acc) (loop (cons v acc))))) 'not-input))\n(read-all-if-input (open-input-string \"abc\"))"
     :math-composition "(define (read-all-if-input p) (if (input-port? p) (let loop ((acc '())) (let ((v (read-char p))) (if (eof-object? v) (reverse acc) (loop (cons v acc))))) 'not-input))\n(define (combine-readers ps) (fold (lambda (p acc) (if (input-port? p) (append acc (read-all-if-input p)) acc)) '() ps))\n(combine-readers (list (open-input-string \"ab\") (open-input-string \"cd\")))"
     :cs-composition "(define (with-input-safely p thunk fallback) (if (input-port? p) (thunk p) (fallback)))\n(with-input-safely (open-input-string \"x\") read-char (lambda () 'none))"
     :base "input-port? tests read capability."
     :emergent "Compositions build read-all pipelines, reader unions, safe-invocation."
     :meta "Family: safe-input.")
    (:eng "Read-all pipelines are the base of streaming aggregation." :math "Reader unions combine sources." :cs "Safe-invocation with fallback is a defensive pattern."))
)

(verb :name "output-port?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(output-port? p) -> boolean"
  :summary "#t if p is a write-capable port. R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(output-port? (open-output-string))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string))) (and (output-port? p) (not (input-port? p))))" :note "Write-only port.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-write p v) (if (output-port? p) (write v p) (error 'shape 'need-output-port)))\n(safe-write (open-output-string) 42)" :note "Guard write direction before dispatch."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-log p msg) (if (output-port? p) (begin (display msg p) (newline p)) (error 'shape 'need-write-port)))\n(safe-log (open-output-string) \"hello\")"
     :math-program "(define (direction-of p) (cond ((and (output-port? p) (input-port? p)) :duplex) ((output-port? p) :write-only) ((input-port? p) :read-only) (else :none)))\n(direction-of (open-output-string))"
     :cs-program "(define (allocate-writer factory) (let ((p (factory))) (if (output-port? p) p (error 'shape 'factory-yielded-non-writer))))\n(allocate-writer open-output-string)"
     :problem "A write verb refuses to run against an input-port, preventing confusing errors at the write machinery."
     :explanation "eng: safe-log. math: direction dispatch. cs: factory validation."
     :meta "Reach for output-port? and NOT port?: port? admits input ports too. Direction is distinct.")
    (:eng "Boundary error at write direction check." :math "output-port? is the characteristic function of the write-capable subset." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Write-direction typing on handles."
     :rungs (
       (:domain "engineering"  :code "(define (direction-of p) (cond ((and (output-port? p) (input-port? p)) :duplex) ((output-port? p) :write-only) ((input-port? p) :read-only) (else :none)))\n(direction-of (open-output-string))")
       (:domain "mathematics"  :code "(output-port? (open-output-string))")
       (:domain "cs / dispatch" :code "(define (direction-of p) (cond ((and (output-port? p) (input-port? p)) :duplex) ((output-port? p) :write-only) ((input-port? p) :read-only) (else :none)))\n(direction-of (open-output-string))"))
     :explanation "Write direction on a file, a string buffer, or a pipe."
     :meta "Direction-typed handles are universal.")
    (:eng "Write direction is a boundary predicate." :math "Writer ⊆ Port." :cs "Capability typing supports safe upcasting."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (writer-implies-port? p) (implies (output-port? p) (port? p)))\n(and (writer-implies-port? (open-output-string)) (writer-implies-port? (open-input-string \"x\")))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (dual-check p) (implies (output-port? p) (port? p)))\n(dual-check (open-output-string))"
     :cs-program "(define (audit-write-cap ps) (fold (lambda (n p) (if (output-port? p) (+ n 1) n)) 0 ps))\n(audit-write-cap (list (open-output-string) (open-input-string \"x\")))"
     :claim "output-port? ⊂ port?: every output-port is a port."
     :invariant "∀ p. output-port?(p) → port?(p)"
     :meta "Pattern: subset containment.")
    (:eng "Sub-class admission is a universal I/O rule." :math "Writer ⊂ Port." :cs "Widening preserves capability."))
  :row-5-emergence (
    (:eng-composition "(define (log-batch p msgs) (when (output-port? p) (for-each (lambda (m) (display m p) (newline p)) msgs)))\n(log-batch (open-output-string) (list \"a\" \"b\" \"c\"))"
     :math-composition "(define (with-outs-of ps thunk) (let ((valid (filter output-port? ps))) (for-each (lambda (p) (thunk p)) valid)))\n(with-outs-of (list (open-output-string) (open-input-string \"x\")) (lambda (p) (display 'ok p)))"
     :cs-composition "(define (redirected-out src dest-thunk) (if (output-port? src) (dest-thunk src) (error 'shape 'not-out)))\n(redirected-out (open-output-string) (lambda (p) (display 'redirected p)))"
     :base "output-port? tests write capability."
     :emergent "Compositions build batched loggers, port unions, redirection."
     :meta "Family: safe-output.")
    (:eng "Batched logging is a common pattern." :math "Multi-out fanout writes to a valid subset." :cs "Redirection is capability-preserving substitution."))
)

(verb :name "port?" :std "R7RS-small"              :library "predicate" :tier "core" :kind "pure" :signature "(port? p) -> boolean"
  :summary "#t if p is any port (input, output, or both). R7RS §6.13."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(port? (open-input-string \"x\"))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (open-output-string))) (and (port? p) (not (input-port? p))))" :note "A non-input port — usually output-only.")
    (:dialect "motoi" :tier "expert"       :code "(define (log-anywhere p msg) (cond ((not (port? p)) 'no-port) ((output-port? p) (display msg p) 'wrote) (else 'input-only)))\n(log-anywhere (open-output-string) \"hi\")" :note "Umbrella port check before direction-specific dispatch."))
  :provenance "R7RS §6.13; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (accept-port p) (if (port? p) 'accepted 'rejected))\n(accept-port (open-input-string \"x\"))"
     :math-program "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))"
     :cs-program "(define (validate-connection p) (if (port? p) 'valid 'invalid))\n(validate-connection 'not-a-port)"
     :problem "Any port-manipulating helper needs to know it received a port at all before caring about direction."
     :explanation "eng: acceptance. math: domain classification. cs: validation."
     :meta "Reach for port? when direction doesn't matter — you need only I/O-handleness.")
    (:eng "Umbrella check precedes direction-specific dispatch." :math "port? is the union of input-port? and output-port?." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Umbrella-handle check."
     :rungs (
       (:domain "engineering"  :code "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))")
       (:domain "mathematics"  :code "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))")
       (:domain "cs / dispatch" :code "(define (port-domain p) (cond ((not (port? p)) :not-port) ((and (input-port? p) (output-port? p)) :duplex) ((input-port? p) :reader) ((output-port? p) :writer)))\n(port-domain (open-input-string \"x\"))"))
     :explanation "Network, string, parser handles — all are ports."
     :meta "Umbrella typing is universal.")
    (:eng "Connection handles are ports." :math "Union of directional subsets." :cs "Umbrella tag simplifies routing."))
  :row-4-proof (
    (:eng-program "(define (union-holds? p) (equal? (port? p) (or (input-port? p) (output-port? p))))\n(and (union-holds? (open-input-string \"x\")) (union-holds? (open-output-string)))"
     :math-program "(define (subset-count ps) (list :input (length (filter input-port? ps)) :output (length (filter output-port? ps)) :any (length (filter port? ps))))\n(subset-count (list (open-input-string \"x\") (open-output-string)))"
     :cs-program "(define (all-port? xs) (fold (lambda (r p) (and r (port? p))) #t xs))\n(all-port? (list (open-input-string \"x\") (open-output-string)))"
     :claim "port? = input-port? ∪ output-port?."
     :invariant "∀ p. port?(p) ⇔ (input-port?(p) ∨ output-port?(p))"
     :meta "Pattern: union identity.")
    (:eng "Union identity means the umbrella is exact." :math "Union of two subsets equals the top of the port hierarchy." :cs "Runtime tag inspection is O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (close-all-ports ps) (for-each (lambda (p) (when (port? p) (close-port p))) ps))\n(close-all-ports (list (open-input-string \"x\") 'not-a-port))"
     :math-composition "(define (port-count ps) (length (filter port? ps)))\n(port-count (list (open-input-string \"x\") 'not-port (open-output-string)))"
     :cs-composition "(define (route-io v) (cond ((not (port? v)) :not-port) ((input-port? v) (read-char v)) ((output-port? v) (display 'ok v))))\n(route-io (open-input-string \"3\"))"
     :base "port? tests any I/O handle."
     :emergent "Compositions build port lifecycle mgmt, port counting, umbrella routing."
     :meta "Family: I/O umbrella management.")
    (:eng "Port lifecycle needs a way to walk any handle." :math "Counting ports gives system-level metrics." :cs "Umbrella routing dispatches to direction-specific paths."))
)

(verb :name "bytevector?" :std "R7RS-small"       :library "predicate" :tier "core" :kind "pure" :signature "(bytevector? x) -> boolean"
  :summary "#t if x is a bytevector (a mutable u8 array). R7RS §6.9."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(bytevector? (make-bytevector 4 0))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((bv (make-bytevector 3 0))) (and (bytevector? bv) (positive? (bytevector-length bv))))" :note "Non-empty bytevector.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-serialize v) (if (bytevector? v) (utf8->string v) (error 'shape 'need-bytevector)))\n(safe-serialize (string->utf8 \"hello\"))" :note "Type-guarded byte-to-string conversion."))
  :provenance "R7RS §6.9; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (write-bytes p bv) (if (bytevector? bv) (display (utf8->string bv) p) (error 'shape 'need-bv)))\n(write-bytes (open-output-string) (string->utf8 \"hi\"))"
     :math-program "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))"
     :cs-program "(define (validate-frame v) (if (bytevector? v) 'binary 'non-binary))\n(validate-frame (make-bytevector 8))"
     :problem "Binary IO expects a bytevector; passing a string or list crashes at the write layer with a cryptic message."
     :explanation "eng: write. math: fold over u8. cs: frame validation."
     :meta "Reach for bytevector? and NOT string?: strings are UTF-8 encoded; bytevectors are raw bytes.")
    (:eng "Binary write guards prevent encoding confusion." :math "bytevector? is the characteristic function of u8-array shape." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Binary-container shape check."
     :rungs (
       (:domain "engineering"  :code "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))")
       (:domain "mathematics"  :code "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))")
       (:domain "cs / dispatch" :code "(define (u8-fold f init bv) (if (bytevector? bv) (let loop ((i 0) (acc init)) (if (= i (bytevector-length bv)) acc (loop (+ i 1) (f acc (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(u8-fold + 0 (make-bytevector 3 10))"))
     :explanation "Received frames, encoded signals, disk blocks — all bytevectors."
     :meta "Binary-container is a universal shape.")
    (:eng "Wire protocols use bytevectors." :math "Signal encoding produces u8 arrays." :cs "File I/O naturally uses bytevectors."))
  :row-4-proof (
    (:eng-program "(define (excludes-string? v) (or (not (bytevector? v)) (not (string? v))))\n(and (excludes-string? \"hello\") (excludes-string? (make-bytevector 2)))"
     :math-program "(define (mutable? bv) (if (bytevector? bv) (begin (bytevector-u8-set! bv 0 99) #t) #f))\n(mutable? (make-bytevector 3 0))"
     :cs-program "(define (length-matches? bv n) (and (bytevector? bv) (= (bytevector-length bv) n)))\n(length-matches? (make-bytevector 5) 5)"
     :claim "bytevector? and string? are disjoint."
     :invariant "∀ x. ¬(bytevector?(x) ∧ string?(x))"
     :meta "Pattern: disjoint types.")
    (:eng "Disjointness prevents encoding-confusion bugs." :math "Two distinct type classes with no overlap." :cs "Runtime tag distinguishes at O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (concat-bvs bvs) (let* ((total (fold + 0 (map bytevector-length (filter bytevector? bvs)))) (out (make-bytevector total 0))) (let loop ((bvs (filter bytevector? bvs)) (off 0)) (cond ((null? bvs) out) (else (bytevector-copy! out off (car bvs) 0 (bytevector-length (car bvs))) (loop (cdr bvs) (+ off (bytevector-length (car bvs)))))))))\n(concat-bvs (list (make-bytevector 2 1) 'not-bv (make-bytevector 2 2)))"
     :math-composition "(define (checksum bv) (if (bytevector? bv) (let loop ((i 0) (sum 0)) (if (= i (bytevector-length bv)) sum (loop (+ i 1) (+ sum (bytevector-u8-ref bv i))))) (error 'shape 'need-bv)))\n(checksum (make-bytevector 4 42))"
     :cs-composition "(define (byte-histogram bvs) (let ((h (make-hash-table))) (for-each (lambda (bv) (when (bytevector? bv) (let loop ((i 0)) (when (< i (bytevector-length bv)) (hash-table-update! h (bytevector-u8-ref bv i) (lambda (n) (+ n 1)) (lambda () 0)) (loop (+ i 1)))))) bvs) h))\n(byte-histogram (list (make-bytevector 3 65) (make-bytevector 2 66)))"
     :base "bytevector? tests binary-container shape."
     :emergent "Compositions build concat, checksum, histogram."
     :meta "Family: byte-buffer aggregation.")
    (:eng "Concat is the base of frame reassembly." :math "Checksums verify integrity." :cs "Histograms analyze byte distributions."))
)

(verb :name "hash-table?" :std "SRFI-125"       :library "predicate" :tier "core" :kind "pure" :signature "(hash-table? x) -> boolean"
  :summary "#t if x is a hash-table. R7RS §6.10 (SRFI 69 / 125 shape)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(hash-table? (make-hash-table))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((h (make-hash-table))) (hash-table-set! h 'k 1) (and (hash-table? h) (positive? (hash-table-size h))))" :note "Non-empty hash-table.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-update h k f init) (if (hash-table? h) (hash-table-update! h k f init) (error 'shape 'need-ht)))\n(let ((h (make-hash-table))) (safe-update h 'x (lambda (n) (+ n 1)) (lambda () 0)))" :note "Guarded update — no crash on wrong type."))
  :provenance "R7RS §6.10; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (cache-lookup h k) (if (hash-table? h) (hash-table-ref h k (lambda () 'miss)) (error 'shape 'need-ht)))\n(cache-lookup (make-hash-table) 'x)"
     :math-program "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))"
     :cs-program "(define (memoize-safe f h) (if (hash-table? h) (lambda (x) (hash-table-ref h x (lambda () (let ((v (f x))) (hash-table-set! h x v) v)))) (error 'shape 'need-ht)))\n((memoize-safe (lambda (n) (* n n)) (make-hash-table)) 5)"
     :problem "Cache verbs expect a hash-table; passing an alist works with hash-table-ref-like helpers but not the mutating ops. Guard the shape."
     :explanation "eng: cache lookup. math: map over ht as (k,v). cs: memoization helper."
     :meta "Reach for hash-table? and NOT list?: alists are lists of pairs; hash-tables are distinct.")
    (:eng "Cache verbs need mutable, keyed storage." :math "hash-table? is a finite-map characteristic function." :cs "Primitive; O(1) — tag inspection."))
  :row-3-dimension (
    (:setup "Keyed-store shape check."
     :rungs (
       (:domain "engineering"  :code "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))")
       (:domain "mathematics"  :code "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))")
       (:domain "cs / dispatch" :code "(define (fmap-htn h f) (if (hash-table? h) (hash-table-fold h (lambda (k v acc) (cons (cons k (f v)) acc)) '()) (error 'shape 'need-ht)))\n(fmap-htn (make-hash-table) (lambda (v) (* v 2)))"))
     :explanation "Every keyed store — cache, memo, config — is a hash-table."
     :meta "Keyed-store is a universal shape.")
    (:eng "Caches speed up expensive queries." :math "Finite maps model discrete correspondences." :cs "Hash-tables provide O(1) average keyed access."))
  :row-4-proof (
    (:eng-program "(define (empty-ok? h) (or (not (hash-table? h)) (>= (hash-table-size h) 0)))\n(empty-ok? (make-hash-table))"
     :math-program "(define (disjoint-with-list? h l) (not (and (hash-table? h) (list? l) (eq? h l))))\n(disjoint-with-list? (make-hash-table) '())"
     :cs-program "(define (post-set-holds? h k v) (if (hash-table? h) (begin (hash-table-set! h k v) (equal? (hash-table-ref/default h k #f) v)) #f))\n(post-set-holds? (make-hash-table) 'x 42)"
     :claim "hash-table? and list? are disjoint."
     :invariant "∀ x. ¬(hash-table?(x) ∧ list?(x))"
     :meta "Pattern: disjoint container types.")
    (:eng "Disjointness prevents cache-vs-list confusion." :math "Two distinct algebraic-structure classes." :cs "Runtime tag distinguishes at O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (merge-hts ha hb) (if (and (hash-table? ha) (hash-table? hb)) (let ((out (hash-table-copy ha))) (hash-table-walk hb (lambda (k v) (hash-table-set! out k v))) out) (error 'shape 'need-two-hts)))\n(let ((a (make-hash-table)) (b (make-hash-table))) (hash-table-set! a 'x 1) (hash-table-set! b 'y 2) (merge-hts a b))"
     :math-composition "(define (fmap-values h f) (let ((out (make-hash-table))) (hash-table-fold h (lambda (k v acc) (hash-table-set! out k (f v)) acc) #f) out))\n(fmap-values (let ((h (make-hash-table))) (hash-table-set! h 'x 3) h) (lambda (v) (* v 2)))"
     :cs-composition "(define (route-by h key default) (if (hash-table? h) (hash-table-ref/default h key default) default))\n(route-by (let ((h (make-hash-table))) (hash-table-set! h 'GET 'get-handler) h) 'GET 'not-found)"
     :base "hash-table? tests finite-map shape."
     :emergent "Compositions build merges, mappers, dispatchers."
     :meta "Family: finite-map operations.")
    (:eng "Merges combine multiple caches." :math "Value-mapping is a Functor operation on hash-tables." :cs "Route dispatch by key is the base of every router."))
)

(verb :name "vector?" :std "R7RS-small"          :library "predicate" :tier "core" :kind "pure" :signature "(vector? x) -> boolean"
  :summary "#t if x is a vector (a fixed-length indexed collection). R7RS §6.8."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(vector? (vector 1 2 3))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((v (vector 1 2 3))) (and (vector? v) (positive? (vector-length v))))" :note "Non-empty vector.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-vindex v i) (if (and (vector? v) (exact-integer? i) (< i (vector-length v))) (vector-ref v i) (error 'shape 'bad-index)))\n(safe-vindex (vector 'a 'b 'c) 1)" :note "Bounded random-access with type + range guard."))
  :provenance "R7RS §6.8; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (parallel-render vs) (if (vector? vs) (do ((i 0 (+ i 1))) ((= i (vector-length vs))) (render (vector-ref vs i))) (error 'shape 'need-vector)))\n(parallel-render (vector 'a 'b 'c))"
     :math-program "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))"
     :cs-program "(define (validate-frame v) (if (vector? v) 'ok 'shape-mismatch))\n(validate-frame (vector 1 2 3))"
     :problem "Fixed-index rendering (buffer walking) needs random access; a list would be O(n) per index. Vectors are O(1) — but the caller must pass a vector."
     :explanation "eng: parallel render. math: dot product. cs: frame validation."
     :meta "Reach for vector? and NOT list?: lists are cons-cells (O(n) index); vectors are contiguous storage (O(1) index).")
    (:eng "Random access must use a vector." :math "vector? is the characteristic function of indexed-array shape." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Indexed-storage shape check."
     :rungs (
       (:domain "engineering"  :code "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))")
       (:domain "mathematics"  :code "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))")
       (:domain "cs / dispatch" :code "(define (dot v w) (if (and (vector? v) (vector? w) (= (vector-length v) (vector-length w))) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (* (vector-ref v i) (vector-ref w i)))))) (error 'shape 'need-two-vecs)))\n(dot (vector 1 2 3) (vector 4 5 6))"))
     :explanation "Framebuffers, math arrays, tuple decodings — all vectors."
     :meta "Indexed-storage is a universal shape.")
    (:eng "Buffers demand indexed storage." :math "Arrays are indexed sequences." :cs "Tuples decode into vectors."))
  :row-4-proof (
    (:eng-program "(define (disjoint-with-list? v l) (not (and (vector? v) (list? l) (eq? v l))))\n(disjoint-with-list? (vector 1 2) '(1 2))"
     :math-program "(define (o1-access? v i) (if (and (vector? v) (< i (vector-length v))) (begin (vector-ref v i) #t) #f))\n(o1-access? (vector 'a 'b 'c) 1)"
     :cs-program "(define (length-eq? v n) (and (vector? v) (= (vector-length v) n)))\n(length-eq? (vector 1 2 3) 3)"
     :claim "vector? and list? are disjoint containers."
     :invariant "∀ x. ¬(vector?(x) ∧ list?(x))"
     :meta "Pattern: disjoint types.")
    (:eng "Disjointness prevents container-confusion bugs." :math "Two distinct container-type classes." :cs "Type tag distinguishes at O(1)."))
  :row-5-emergence (
    (:eng-composition "(define (transpose vs) (if (and (vector? vs) (positive? (vector-length vs)) (vector? (vector-ref vs 0))) (let* ((n (vector-length vs)) (m (vector-length (vector-ref vs 0))) (out (make-vector m #f))) (do ((j 0 (+ j 1))) ((= j m)) (vector-set! out j (make-vector n 0)) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! (vector-ref out j) i (vector-ref (vector-ref vs i) j)))) out) (error 'shape 'not-matrix)))\n(transpose (vector (vector 1 2) (vector 3 4)))"
     :math-composition "(define (norm-sq v) (if (vector? v) (let loop ((i 0) (sum 0)) (if (= i (vector-length v)) sum (loop (+ i 1) (+ sum (expt (vector-ref v i) 2))))) (error 'shape 'need-vec)))\n(norm-sq (vector 3 4))"
     :cs-composition "(define (map-vec f v) (if (vector? v) (let ((out (make-vector (vector-length v) #f))) (do ((i 0 (+ i 1))) ((= i (vector-length v))) (vector-set! out i (f (vector-ref v i)))) out) (error 'shape 'need-vec)))\n(map-vec (lambda (x) (* x 2)) (vector 1 2 3))"
     :base "vector? tests indexed-container shape."
     :emergent "Compositions build transpose, norms, mapped-vec."
     :meta "Family: indexed-storage operations.")
    (:eng "Matrix operations require indexed access." :math "Vector norms are indexed-sum operations." :cs "Element-wise map preserves shape."))
)

(verb :name "error-object?" :std "R7RS-small"     :library "predicate" :tier "core" :kind "pure" :signature "(error-object? x) -> boolean"
  :summary "#t if x is an error-object (a structured error value). R7RS §6.11."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(error-object? (guard (e (#t e)) (error 'test-error)))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((e (guard (ex (#t ex)) (error \"oops\")))) (and (error-object? e) (string? (error-object-message e))))" :note "Structured error with a message string.")
    (:dialect "motoi" :tier "expert"       :code "(define (log-error e) (when (error-object? e) (display (error-object-message e)) (newline)))\n(log-error (guard (e (#t e)) (error 'divide-by-zero)))" :note "Guarded logging of a caught error."))
  :provenance "R7RS §6.11; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (retry-on-error thunk) (let loop ((attempts 3)) (guard (e ((error-object? e) (if (positive? attempts) (loop (- attempts 1)) (raise e)))) (thunk))))\n(retry-on-error (lambda () 42))"
     :math-program "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))"
     :cs-program "(define (normalize-error e) (if (error-object? e) (list :msg (error-object-message e) :cause (error-object-irritants e)) (list :msg \"unknown\" :cause e)))\n(normalize-error (guard (e (#t e)) (error 'test)))"
     :problem "Structured error objects carry :message and :irritants; unstructured errors might just be strings. Distinguish before extraction."
     :explanation "eng: retry. math: class extraction. cs: normalization."
     :meta "Reach for error-object? and NOT error?: error? is broader (admits raised non-error values too). error-object? is R7RS-shaped.")
    (:eng "Retry loops depend on structured errors." :math "Error classification uses structured fields." :cs "Normalization pipelines produce log-friendly shapes."))
  :row-3-dimension (
    (:setup "Structured-error shape check."
     :rungs (
       (:domain "engineering"  :code "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))")
       (:domain "mathematics"  :code "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))")
       (:domain "cs / dispatch" :code "(define (error-class e) (if (error-object? e) (car (error-object-irritants e)) 'unknown))\n(error-class (guard (e (#t e)) (error 'bad-input 'reason)))"))
     :explanation "Every guarded error, arithmetic exception, parse failure."
     :meta "Structured error is a universal shape.")
    (:eng "Structured errors carry actionable data." :math "Error is a value; error-object? refines that shape." :cs "Structured errors survive marshalling."))
  :row-4-proof (
    (:eng-program "(define (implies a b) (or (not a) b))\n(define (implies-error? e) (implies (error-object? e) (error? e)))\n(and (implies-error? (guard (e (#t e)) (error \"x\"))) (implies-error? 'not-error))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (message-non-nil? e) (implies (error-object? e) (string? (error-object-message e))))\n(message-non-nil? (guard (e (#t e)) (error \"x\")))"
     :cs-program "(define (subset-count es) (list :objs (length (filter error-object? es)) :any (length (filter error? es))))\n(subset-count (list (guard (e (#t e)) (error 'x)) 'not-err))"
     :claim "error-object? ⊂ error?: every error-object is an error."
     :invariant "∀ e. error-object?(e) → error?(e)"
     :meta "Pattern: subset containment.")
    (:eng "Sub-class admission means broader handlers catch narrower classes." :math "Structured errors are a subset of general errors." :cs "Widening preserves catch semantics."))
  :row-5-emergence (
    (:eng-composition "(define (log-errors es) (for-each (lambda (e) (when (error-object? e) (display (error-object-message e)) (newline))) es))\n(log-errors (list (guard (e (#t e)) (error 'x))))"
     :math-composition "(define (error-class-count es) (fold (lambda (h e) (if (error-object? e) (let ((k (or (car (error-object-irritants e)) 'unknown))) (hash-table-update! h k (lambda (n) (+ n 1)) (lambda () 0))) h) h) (make-hash-table) es))\n(error-class-count (list))"
     :cs-composition "(define (triage-errors es) (map (lambda (e) (list :kind (if (error-object? e) 'structured 'raw) :val e)) es))\n(triage-errors (list (guard (e (#t e)) (error 'x)) 'other))"
     :base "error-object? tests structured error shape."
     :emergent "Compositions build error loggers, class-counting, triage."
     :meta "Family: structured error handling.")
    (:eng "Log pipelines need structured errors." :math "Classification counts by class." :cs "Triage separates raw vs structured errors."))
)

(verb :name "error?" :std "Motoi"            :library "predicate" :tier "core" :kind "pure" :signature "(error? x) -> boolean"
  :summary "#t if x can be raised as an error (structured or custom). R7RS §6.11."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(error? (guard (e (#t e)) (error 'test)))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((e (guard (ex (#t ex)) (error \"oops\")))) (and (error? e) (error-object? e)))" :note "Structured error is also error? — the umbrella predicate.")
    (:dialect "motoi" :tier "expert"       :code "(define (universal-catch thunk) (guard (e ((error? e) (list :caught e))) (thunk)))\n(universal-catch (lambda () (error 'bad-thing)))" :note "Umbrella error catch."))
  :provenance "R7RS §6.11; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (safe-op op) (guard (e ((error? e) (list :failed e))) (op)))\n(safe-op (lambda () (error 'x)))"
     :math-program "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))"
     :cs-program "(define (log-all-errors es) (map (lambda (e) (list :is-err (error? e) :val e)) es))\n(log-all-errors (list (guard (e (#t e)) (error 'x)) 'not-err))"
     :problem "A general handler wants to catch any raised value; error? is the umbrella that admits both structured error-objects and custom raise values."
     :explanation "eng: safe op. math: classification. cs: audit logging."
     :meta "Reach for error? when you want the umbrella; error-object? for R7RS-shaped errors only.")
    (:eng "Universal error catches use error?." :math "Union of structured and custom errors." :cs "Primitive; O(1)."))
  :row-3-dimension (
    (:setup "Umbrella-error shape check."
     :rungs (
       (:domain "engineering"  :code "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))")
       (:domain "mathematics"  :code "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))")
       (:domain "cs / dispatch" :code "(define (classify e) (cond ((error-object? e) :structured) ((error? e) :raw) (else :not-error)))\n(classify (guard (e (#t e)) (error 'x)))"))
     :explanation "Any failure mode surfaces as error?."
     :meta "Error umbrella is universal.")
    (:eng "General error handling needs umbrella detection." :math "Failure modes are values." :cs "Runtime raise semantics."))
  :row-4-proof (
    (:eng-program "(define (union-holds? e) (equal? (error? e) (or (error-object? e) (custom-error? e))))\n(union-holds? (guard (e (#t e)) (error 'x)))"
     :math-program "(define (implies a b) (or (not a) b))\n(define (implies-err? e) (implies (error-object? e) (error? e)))\n(implies-err? (guard (e (#t e)) (error \"x\")))"
     :cs-program "(define (count-errors es) (length (filter error? es)))\n(count-errors (list (guard (e (#t e)) (error 'x)) 'not-err))"
     :claim "error? admits every error-object? plus custom raised values."
     :invariant "∀ e. error-object?(e) → error?(e); error? may admit additional values."
     :meta "Pattern: superset relation.")
    (:eng "Umbrella means one branch handles many failure kinds." :math "Union of subsets." :cs "Type widening preserves catch scope."))
  :row-5-emergence (
    (:eng-composition "(define (report-errors thunk) (guard (e ((error? e) (list :error e))) (thunk)))\n(report-errors (lambda () (error 'x)))"
     :math-composition "(define (error-severity e) (cond ((not (error? e)) :none) ((error-object? e) :structured) (else :raw)))\n(error-severity (guard (e (#t e)) (error 'x)))"
     :cs-composition "(define (retry-or-fail thunk max) (let loop ((n 0)) (guard (e ((error? e) (if (< n max) (loop (+ n 1)) (raise e)))) (thunk))))\n(retry-or-fail (lambda () 42) 3)"
     :base "error? tests umbrella-error shape."
     :emergent "Compositions build report, severity, retry."
     :meta "Family: unified error handling.")
    (:eng "Error reporting is universal in production code." :math "Severity classifies errors by structure." :cs "Retry loops use umbrella catches."))
)

(verb :name "promise?" :std "R7RS-small" :library "predicate" :tier "core" :kind "pure" :signature "(promise? x) -> boolean"
  :summary "#t if x is a promise (a delayed / lazy computation). R7RS §6.12."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(promise? (delay (+ 1 2)))" :note "#t.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (delay 42))) (if (promise? p) (force p) p))" :note "Force only if promise; leave forced values alone.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-force p) (if (promise? p) (force p) (error 'shape 'need-promise)))\n(safe-force (delay 42))" :note "Guarded force — no double-force on already-forced values."))
  :provenance "R7RS §6.12; added 2026-07-18 finalization; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (build-config) (list 'config 'default))\n(define (lazy-init factory) (if (promise? factory) (force factory) factory))\n(lazy-init (delay (build-config)))"
     :math-program "(define (compute-once) 42)\n(define (memo-value m) (cond ((promise? m) (force m)) (else m)))\n(memo-value (delay (compute-once)))"
     :cs-program "(define (stream-head s) (if (promise? s) (car (force s)) (error 'shape 'need-stream)))\n(stream-head (delay (cons 1 (delay '()))))"
     :problem "Lazy initialization patterns store promises; the consumer must know when to force vs. read directly. Guard the shape."
     :explanation "eng: lazy init. math: memoized value. cs: streaming head."
     :meta "Reach for promise? and NOT procedure?: procedures are called; promises are forced. Distinct.")
    (:eng "Lazy init is a common pattern for expensive setup." :math "Memoization suspends computation until needed." :cs "Streaming uses (head . delayed-tail)."))
  :row-3-dimension (
    (:setup "Suspended-computation shape check."
     :rungs (
       (:domain "engineering"  :code "(promise? (delay (load-large-file)))")
       (:domain "mathematics"  :code "(define (force-once-only p) (if (promise? p) (let ((v (force p))) (equal? v (force p))) #t))\n(force-once-only (delay 42))")
       (:domain "cs / dispatch" :code "(define (force-once-only p) (if (promise? p) (let ((v (force p))) (equal? v (force p))) #t))\n(force-once-only (delay 42))"))
     :explanation "Deferred loading, memoization, streaming — all use promises."
     :meta "Suspended computation is a universal shape.")
    (:eng "Delayed loading avoids upfront cost." :math "Memoized computations cache after first force." :cs "Streams model infinite data lazily."))
  :row-4-proof (
    (:eng-program "(define (idempotent-force? p) (if (promise? p) (equal? (force p) (force p)) #t))\n(idempotent-force? (delay (random-int 100)))"
     :math-program "(define (force-once-only p) (if (promise? p) (let ((v (force p))) (equal? v (force p))) #t))\n(force-once-only (delay 42))"
     :cs-program "(define (excludes-value? p v) (not (and (promise? p) (equal? p v))))\n(excludes-value? (delay 42) 42)"
     :claim "force is idempotent on promises."
     :invariant "∀ p. promise?(p) ⇒ force(p) = force(force(p))"
     :meta "Pattern: idempotence of force.")
    (:eng "Idempotence lets pipelines force safely without tracking state." :math "Memoization is the mechanism of idempotence." :cs "Force uses a memoized-thunk implementation."))
  :row-5-emergence (
    (:eng-composition "(define (force-if-promise xs) (map (lambda (x) (if (promise? x) (force x) x)) xs))\n(force-if-promise (list 1 (delay 2) 3))"
     :math-composition "(define (force-sum promises) (fold (lambda (p acc) (+ acc (if (promise? p) (force p) p))) 0 promises))\n(force-sum (list (delay 1) (delay 2) (delay 3)))"
     :cs-composition "(define (safe-take n s) (let loop ((n n) (s s) (acc '())) (cond ((<= n 0) (reverse acc)) ((not (promise? s)) (reverse acc)) (else (let ((pair (force s))) (if (null? pair) (reverse acc) (loop (- n 1) (cdr pair) (cons (car pair) acc))))))))\n(safe-take 3 (delay (cons 1 (delay (cons 2 (delay (cons 3 (delay '()))))))))"
     :base "promise? tests deferred-computation shape."
     :emergent "Compositions build lazy transformers, lazy folds, safe takes."
     :meta "Family: lazy-evaluation pipelines.")
    (:eng "Lazy transformers defer work until needed." :math "Lazy folds work on infinite streams." :cs "Safe take extracts finite prefixes from potentially infinite streams."))
)
