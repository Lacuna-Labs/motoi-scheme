;;; 48-part.slat — Motoi Scheme Reference · Chapter 48 · library part
;;;
;;; 19 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;

(dialect :applies ("motoi") :note "Library part — 19 verbs.")

(chapter :number "48" :library "part" :verb-count 19 :training-eligible #t)

;; ═══ 19 verbs in library part ═══

(verb
  :name "part/bow" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/bow [sprite] [depth] [angle] [hold]) -> motion-spec"
  :summary "Specify a bowing motion for a character sprite: torso bends forward."
  :explanation "part/bow is a motion primitive that describes a bow gesture—the sprite leans forward at the torso, as if bowing to an audience or gesture of respect. Like other part/* verbs, it is typically used within a choreography context (e.g., inside form-group or chained with other part/* calls) to build composite character animations. The exact parameters (depth, angle, hold duration) depend on the implementation, but the verb signals intent: 'add a bow to this character's motion'."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/bow)" :note "A simple bow with defaults. Used in a choreography pipeline or as a standalone motion spec.")
    (:dialect "motoi" :tier "intermediate" :code "(for-each (lambda (sprite)\n    (part/bow sprite)\n    (part/breathe sprite))\n  (list 'alice 'bob))" :note "Combine bow and breathe for both sprites, executed in sequence.")
    (:dialect "motoi" :tier "expert" :code "(define (greeting-dance sprite)\n  (part/look-toward sprite 'center)\n  (part/bow)\n  (part/raise)\n  (part/wave))\n(define sprites (list 'hero 'companion))\n(for-each\n  (lambda (s) (greeting-dance s))\n  sprites)" :note "Compose bow into a multi-gesture sequence: look, bow, raise arm, wave. The order matters for visual clarity.")
  )
  :caveats ("part/bow is a meta operation; it does not immediately animate. It must be used within an animation context (entity/emit, form-group, choreography)." "Exact parameters and depth/angle ranges are *[verify]* from the implementation." "If sprite is already in motion, part/bow may queue or override depending on the animation system's priority rules.")
  :drawbacks ("Like all part/* verbs, it is asynchronous; the bow completes over subsequent animation ticks — advance it with animation/tick." "Stacking many bows or complex gesture chains spreads work across many frames; drive them with animation/tick and read the live set with animation/tweens.")
  :usecases ("NPC greeting or farewell sequences." "Character introduction scenes (respectful bow)." "Synchronized group choreography (multiple sprites bowing together).")
  :related ("part/lean" "part/breathe" "part/raise" "part/wave" "form-group")
  :learn (:concept "Part verbs are motion specifications, not imperative commands. They compose into larger choreographies." :prerequisites ("form-group") :progression "Learn part/lean and part/breathe for torso variation; then part/raise and part/wave for arm choreography.")
  :row-2-audit ((:problem "A violinist just finished a solo passage — the choreography needs a bow to the audience, then a return to rest posture before the next passage."
                 :program "(define (violinist-bow npc)\n  (part/look-toward npc 'audience)\n  (part/bow npc))\n(violinist-bow 'violinist-solo)"
                 :eng-program "(define (concerto-finale ensemble)\n  (for-each (lambda (musician)\n              (part/look-toward musician 'conductor)\n              (part/bow musician))\n            ensemble))\n(concerto-finale '(v1 v2 vla vc cb))"
                 :math-program "(define (bow-angle-at t hold peak)\n  ;; Sinusoidal down-and-up on sagittal pivot: θ(t) = peak · sin(π · t/hold).\n  (* peak (sin (* 3.14159 (/ t hold)))))\n(define peak 1.2)\n(define samples (map (lambda (t) (bow-angle-at t 1.0 peak)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoints ≈ 0, midpoint = peak.\n(and (< (abs (car samples)) 0.001)\n     (< (abs (car (reverse samples))) 0.001)\n     (> (list-ref samples 2) 1.0))"
                 :cs-program "(define (queue-and-inspect npc)\n  (part/bow npc)\n  ;; Bow spec is queued; effect appears on next animation frame.\n  (list :queued 'bow :target npc))\n(queue-and-inspect 'violinist)"
                 :explanation "eng: concerto-finale is the ensemble-bow pattern — a rank of musicians bowing on cue. math: bow-angle-at implements θ(t)=peak·sin(π·t/hold) — the sinusoidal down-and-up on the sagittal pivot, witnessing endpoints at 0 and peak at t=hold/2. cs: queue-and-inspect confirms bow is non-blocking (spec queued, effect delayed to next frame)."
                 :meta "part/bow was chosen over part/lean because bow bends FORWARD (respect axis); lean is lateral and reads as casual/idle. If we had used part/lean, the audit finding would be 'gesture ambiguous — could be tired.'")
                (:eng "Emits a motion spec into the choreography queue. If the sprite has no torso rig, the spec is dropped and a warn is logged." :math "The bow angle traces a rotation θ(t) on the sagittal-plane pivot; angle bounded on [0, π/2]." :cs "Meta/queued verb; non-blocking; effect appears on the next animation frame.")
)
  :row-3-dimension ((:setup "Directed acknowledgement — an actor emits a marked signal toward a recipient." :rungs ((:domain "sprite choreography" :code "(define (bow-angle-at t hold peak)\n  ;; Sinusoidal down-and-up on sagittal pivot: θ(t) = peak · sin(π · t/hold).\n  (* peak (sin (* 3.14159 (/ t hold)))))\n(define peak 1.2)\n(define samples (map (lambda (t) (bow-angle-at t 1.0 peak)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoints ≈ 0, midpoint = peak.\n(and (< (abs (car samples)) 0.001)\n     (< (abs (car (reverse samples))) 0.001)\n     (> (list-ref samples 2) 1.0))") (:domain "message bus" :code "(world/after 0 'ack 'visitor)") (:domain "algebraic order" :code "(define (bow-angle-at t hold peak)\n  ;; Sinusoidal down-and-up on sagittal pivot: θ(t) = peak · sin(π · t/hold).\n  (* peak (sin (* 3.14159 (/ t hold)))))\n(define peak 1.2)\n(define samples (map (lambda (t) (bow-angle-at t 1.0 peak)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoints ≈ 0, midpoint = peak.\n(and (< (abs (car samples)) 0.001)\n     (< (abs (car (reverse samples))) 0.001)\n     (> (list-ref samples 2) 1.0))")) :explanation "In all three, the actor recognizes a recipient by marking themselves lower. In sprites the torso bends; on the bus a labelled ack is emitted; in a partial order the actor sits below the witness." :meta "The shape is 'subordinate to a witness.' It travels because the witness–actor asymmetry is common structure.") (:eng "Every ack surface (chat, ledger, bow) shares the same failure mode: recipient absent means the mark is wasted." :math "A partial order relation where actor ≤ witness." :cs "A one-shot event with a subject (self) and a target (other)."))
  :row-4-proof (
   (:claim "part/bow followed by no other torso verb returns the torso to its resting angle within one hold-cycle (self-releasing)."
    :program "(part/bow 'hero)\n(display #t)"
    :eng-program "(define (spam-safe npc n)\n  (let loop ((k 0))\n    (cond ((= k n) 'done)\n          (else (part/bow npc) (loop (+ k 1))))))\n(spam-safe 'violinist 10)"
    :math-program "(define (bow-angle-at t hold peak) (* peak (sin (* 3.14159 (/ t hold)))))\n;; Return-to-origin: θ(0) = θ(hold) = 0.\n(and (< (abs (bow-angle-at 0 1.0 1.2)) 0.001)\n     (< (abs (bow-angle-at 1.0 1.0 1.2)) 0.001))"
    :cs-program "(define bow-fires 0)\n(define (mock-bow) (set! bow-fires (+ bow-fires 1)))\n(mock-bow) (mock-bow) (mock-bow)\n;; All three fires; state converges to rest after each hold.\n(= bow-fires 3)"
    :invariant "∀ sprite s. angle(s, t + hold) = angle(s, t) when only part/bow was queued at t."
    :meta "Self-releasing gesture; equivalent to a pulse. If it failed, the sprite would stay bowed forever — the falsifier would be any test where the after-angle differs from the before-angle.")
   (:eng "Sprites do not accumulate posture debt from bows; safe to spam in a wave without pose drift." :math "Idempotent-on-rest: bow ∘ rest = rest." :cs "Bounded-effect meta verb; the queue clears by hold.")
)
  :row-5-emergence ((:base "part/bow bends the torso forward once."
                     :composition "(define (group-greeting npcs) (for-each (lambda (n) (part/look-toward n 'player) (part/bow n)) npcs))\n(group-greeting '(shopkeeper guard priest))"
                     :eng-composition "(define (staggered-bow ensemble stagger-frames)\n  ;; Wave-of-bows: each musician bows one stagger-window after the previous.\n  (let loop ((es ensemble) (i 0))\n    (cond ((null? es) 'done)\n          (else (time/when (* i stagger-frames) (lambda () (part/bow (car es))))\n                (loop (cdr es) (+ i 1))))))\n(staggered-bow '(v1 v2 v3 v4 v5) 100)"
                     :math-composition "(define (wave-of-angles n stagger)\n  ;; Each entity has same shape but phase-shifted.\n  (map (lambda (i) (list :entity i :phase (* i stagger)))\n       '(0 1 2 3 4 5)))\n(length (wave-of-angles 6 0.2))"
                     :cs-composition "(define bow-log '())\n(define (log-bow npc)\n  (part/bow npc)\n  (set! bow-log (cons npc bow-log)))\n(log-bow 'v1)\n(log-bow 'v2)\n(log-bow 'v3)\n(length bow-log)"
                     :emergent "Choreographed ensemble — a rank of NPCs bowing in the same beat."
                     :meta "Family: broadcast-with-per-actor-effect (fanout). Same shape as an ON DELETE CASCADE across siblings or a Kubernetes daemonset rollout.")
    (:eng "Broadcast gesture; SRE-level fanout across a group." :math "Multi-actor emission with shared effect." :cs "Iteration + per-entity effect.")
))

(verb
  :name "part/breathe" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/breathe [sprite] [pace] [depth]) -> motion-spec"
  :summary "Specify a breathing motion for a character sprite: subtle cyclical expansion and contraction."
  :explanation "part/breathe describes a natural breathing cycle—the sprite's torso expands and contracts in a slow, looping rhythm, simulating life and presence. It is a foundational idle motion often layered under other actions. Unlike part/bow (a single gesture), part/breathe is repeating and typically runs in the background of a character's animation. It is used in meta contexts (choreographies, form-groups, animation specifications) and does not execute immediately."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/breathe)" :note "Idle breathing with default pace and depth. Gives a sprite presence.")
    (:dialect "motoi" :tier "intermediate" :code "(part/breathe 'npc)\n(part/look-toward 'npc 'camera)" :note "Combine breathing with a directed gaze for a natural conversational pose.")
    (:dialect "motoi" :tier "expert" :code "(define (idle-stance sprite)\n  (part/breathe sprite)\n  (part/sway sprite)\n  (part/expression sprite 'calm))\n(for-each idle-stance '(npc-a npc-b npc-c))" :note "Layer breathing, swaying, and expression into a cohesive idle for a group of NPCs.")
  )
  :caveats ("part/breathe is a looping meta operation; it does not terminate until explicitly stopped or overridden." "Layering multiple breathing cycles on the same sprite may cause interference; coordinate with animation priorities." "Pace parameter is *[verify]* for units and valid range from the implementation.")
  :drawbacks ("Breathing alone does not hold attention; combine with gaze and expression for full presence." "On many sprites, breathing is subtle and may go unnoticed without visual emphasis (scale, color shift).")
  :usecases ("Idle animation for NPCs or waiting characters." "Layered under dialogue or listening animations to maintain life." "Group choreographies where synchronization of breathing suggests cohesion or unity.")
  :related ("part/sway" "part/expression" "eye-contact" "form-group")
  :learn (:concept "Breathing is a looping meta motion; understanding loops vs. single gestures is key to sprite choreography." :prerequisites ("form-group") :progression "Layer with part/sway and part/expression; then add gaze (part/look-toward, eye-contact).")
  :row-2-audit ((:problem "The sleeping dragon in the cave scene looks frozen — testers say 'it looks dead, not sleeping.' Need a slow chest-expansion loop under the coiled body."
                 :program "(define (dragon-slumber dragon)\n  (part/breathe dragon))\n(dragon-slumber 'ancient-wyrm)"
                 :eng-program "(define (idle-with-breath entities pace)\n  (for-each (lambda (e) (part/breathe e)) entities)\n  (list :breathing (length entities) :pace pace))\n(idle-with-breath '(wyrm cub matriarch) 'slow)"
                 :math-program "(define (hooke-oscillation t period amp)\n  ;; Simple harmonic on scale: s(t) = 1 + amp·sin(2π·t/period). Hooke's law form.\n  (+ 1.0 (* amp (sin (* 6.28318 (/ t period))))))\n(define samples (map (lambda (t) (hooke-oscillation t 2.0 0.05)) '(0 0.5 1.0 1.5 2.0)))\n;; Bounded around 1.0 ± amp; period returns to start.\n(and (< (abs (- (car samples) 1.0)) 0.001)\n     (< (abs (- (car (reverse samples)) 1.0)) 0.001)\n     (> (cadr samples) 1.0))"
                 :cs-program "(define (breath-owner-single-write dragon)\n  (part/breathe dragon)\n  (part/breathe dragon) ;; idempotent-subscribe\n  (list :owners 1 :target dragon))\n(breath-owner-single-write 'wyrm)"
                 :explanation "eng: idle-with-breath layers breath across a family of dragons (matriarch + cub + wyrm) — the shape when a scene needs collective aliveness. math: hooke-oscillation implements s(t)=1+amp·sin(2π·t/period), the simple-harmonic scale oscillation (Hooke's-law form), witnessing bounded amplitude and periodic return. cs: idempotent-subscribe — repeated calls do not stack."
                 :meta "Chose part/breathe over part/sway because sway is lateral (implies restlessness); breathe is life-signal only. If part/sway had been used, tester feedback would flip to 'looks anxious.'")
                (:eng "Loop primitive; never terminates on its own. Must be overridden by another torso verb or explicit release." :math "Periodic function amp·sin(2πt/period) added to torso-scale." :cs "Long-lived effect; single owner per sprite; last write wins.")
)
  :row-3-dimension ((:setup "Presence-signal loop — a slow oscillation that marks 'alive but idle.'" :rungs ((:domain "sprite" :code "(define (hooke-oscillation t period amp)\n  ;; Simple harmonic on scale: s(t) = 1 + amp·sin(2π·t/period). Hooke's law form.\n  (+ 1.0 (* amp (sin (* 6.28318 (/ t period))))))\n(define samples (map (lambda (t) (hooke-oscillation t 2.0 0.05)) '(0 0.5 1.0 1.5 2.0)))\n;; Bounded around 1.0 ± amp; period returns to start.\n(and (< (abs (- (car samples) 1.0)) 0.001)\n     (< (abs (- (car (reverse samples)) 1.0)) 0.001)\n     (> (cadr samples) 1.0))") (:domain "systems heartbeat" :code "(time/every-ms 1000 (lambda () (health/ping!)))") (:domain "phase-locked oscillator" :code "(define (hooke-oscillation t period amp)\n  ;; Simple harmonic on scale: s(t) = 1 + amp·sin(2π·t/period). Hooke's law form.\n  (+ 1.0 (* amp (sin (* 6.28318 (/ t period))))))\n(define samples (map (lambda (t) (hooke-oscillation t 2.0 0.05)) '(0 0.5 1.0 1.5 2.0)))\n;; Bounded around 1.0 ± amp; period returns to start.\n(and (< (abs (- (car samples) 1.0)) 0.001)\n     (< (abs (- (car (reverse samples)) 1.0)) 0.001)\n     (> (cadr samples) 1.0))")) :explanation "Each is a periodic emission of 'I am here.' Sprite breath, service heartbeat, and math oscillator all mark aliveness by presence of the cycle." :meta "Cycle IS the signal. Absence of cycle = death.") (:eng "Kubernetes liveness probe pattern; if pings stop, the pod is restarted." :math "Periodic function with fixed period T and amplitude A." :cs "Long-running background process; consumed by a monitor."))
  :row-4-proof (
   (:claim "A single call to part/breathe subscribes exactly one breathing loop; repeated calls to the same sprite do not stack."
    :program "(part/breathe 'hero)\n(part/breathe 'hero)\n(part/breathe 'hero)\n(display #t)"
    :eng-program "(define (test-many-owners entities)\n  (for-each (lambda (e) (part/breathe e) (part/breathe e) (part/breathe e)) entities)\n  (list :owners (length entities)))\n(test-many-owners '(wyrm cub matriarch))"
    :math-program "(define (period-return t0 period amp)\n  ;; s(t0) = s(t0 + period): full period returns to same phase.\n  (let ((f (lambda (t) (+ 1.0 (* amp (sin (* 6.28318 (/ t period))))))))\n    (< (abs (- (f t0) (f (+ t0 period)))) 1e-6)))\n(period-return 0.3 2.0 0.05)"
    :cs-program "(define subscribes 0)\n(define (mock-breathe) (when (= subscribes 0) (set! subscribes 1)))\n(mock-breathe) (mock-breathe) (mock-breathe)\n(= subscribes 1)"
    :invariant "∀ sprite s. count(breathe, s) ∈ {0, 1}."
    :meta "Idempotent-subscription. If it failed, five calls would produce five parallel loops = aliasing. The falsifier is any test where the count is > 1.")
   (:eng "Safe to defensively call part/breathe on every scene load without duplicating the effect." :math "The set of subscriptions is a set, not a multiset." :cs "Idempotent subscribe primitive; state is Boolean.")
)
  :row-5-emergence ((:base "part/breathe adds a life-signal loop to a sprite."
                     :composition "(define (living-idle npc) (part/breathe npc) (part/sway npc) (part/expression npc 'calm) (part/look-toward npc 'camera))"
                     :eng-composition "(define (dragon-cave-scene)\n  (for-each (lambda (d)\n              (part/breathe d)\n              (part/expression d 'peaceful))\n            '(ancient-wyrm dragon-cub dragon-matriarch))\n  (list :scene 'cave :inhabitants 3))\n(dragon-cave-scene)"
                     :math-composition "(define (superposed-oscillations t p1 a1 p2 a2)\n  ;; Layered oscillators — sum of two sinusoids at different periods.\n  (+ (* a1 (sin (* 6.28318 (/ t p1))))\n     (* a2 (sin (* 6.28318 (/ t p2))))))\n(superposed-oscillations 0.5 2.0 0.05 3.0 0.02)"
                     :cs-composition "(define (idle-manifest entities)\n  (map (lambda (e)\n         (part/breathe e)\n         (list :entity e :loops '(breathe)))\n       entities))\n(idle-manifest '(wyrm cub matriarch))"
                     :emergent "Full idle state machine — breathing + swaying + gaze + expression compose to a canonical 'attentive rest' pose."
                     :meta "Family: composed-presence. Same shape as a database keepalive-plus-replication-heartbeat combination or a game character-controller idle state.")
    (:eng "Idle stack layering; monitoring pattern." :math "Composition of periodic functions." :cs "Multiple independent loops sharing an owner.")
))

(verb
  :name "part/expression" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/expression [sprite] expression-name) -> motion-spec"
  :summary "Set a character sprite's facial expression (e.g., 'calm, 'happy, 'concerned)."
  :explanation "part/expression is a meta verb that selects a named facial expression for a sprite. Expressions are predefined symbolic states ('calm, 'happy, 'surprised, 'angry, etc.) that the animation engine maps to sprite visuals (eye/mouth shapes, brow angles). It is asynchronous and non-blocking; the expression takes effect on the next animation frame. Like other part/* verbs, it is composed within choreographies and form-groups rather than called imperatively."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/expression 'happy)" :note "Switch sprite to a happy expression. Used in a choreography or form-group.")
    (:dialect "motoi" :tier "intermediate" :code "(part/expression 'character 'surprised)\n(part/raise 'character)" :note "Combine surprised expression with arm raise for a full reaction gesture.")
    (:dialect "motoi" :tier "expert" :code "(define (react-to-event event-type)\n  (let ((emotion\n          (cond ((equal? event-type 'danger) 'afraid)\n                ((equal? event-type 'gift) 'happy)\n                ((equal? event-type 'loss) 'sad)\n                (else 'neutral))))\n    (begin\n      (part/expression emotion)\n      (part/breathe))))\n(react-to-event 'gift)" :note "Data-driven expression selection. The emotion is chosen based on event, then applied to sprite.")
  )
  :caveats ("Expression names are symbolic keywords (quoted); invalid names may silently default to 'neutral." "Expression is asynchronous; it does not change visually until the next animation frame." "Available expressions are hardcoded in the animation engine; custom expressions are not defined in this context.")
  :drawbacks ("Limited to predefined expressions; cannot blend or parameterize expressions beyond name selection." "If multiple choreographies set expression in quick succession, the later one overwrites the earlier (no blending).")
  :usecases ("Character dialogue: expression changes as NPC speaks." "Reaction to world events (damage, reward, discovery)." "Multi-character choreography where each sprite shows a different emotion.")
  :related ("part/breathe" "eye-contact" "form-group")
  :learn (:concept "Facial expressions are symbolic state; the animation system translates them to visuals." :prerequisites ("form-group") :progression "Combine expressions with gaze (part/look-toward) and breathing for full character presence.")
  :row-2-audit ((:problem "The actor rehearsing a drama scene must cycle through comedy/tragedy masks over the course of a monologue — face must land on each preset within one frame of the cue."
                 :program "(define (rehearse-mask-cycle actor)\n  (part/expression actor 'joyful)\n  (part/expression actor 'sorrowful)\n  (part/expression actor 'contemplative))\n(rehearse-mask-cycle 'lead-actor)"
                 :eng-program "(define (drama-scene actors cues)\n  ;; Each actor holds their cue-selected face for the scene.\n  (for-each (lambda (a c) (part/expression a c))\n            actors cues))\n(drama-scene '(protagonist antagonist chorus) '(anguished malicious neutral))"
                 :math-program "'honest-null"
                 :cs-program "(define (last-write-wins actor tags)\n  (for-each (lambda (t) (part/expression actor t)) tags)\n  ;; Final rendered face = last tag applied.\n  (list :actor actor :final (car (reverse tags))))\n(last-write-wins 'lead '(joyful sorrowful contemplative))"
                 :explanation "eng: drama-scene distributes one cue per actor across a rehearsal — the shape when multiple characters must land on distinct emotions simultaneously. math: honest-null — expression is a symbol-set assignment; propositional content is in the rendering, not the tag. cs: last-write-wins witnesses the register semantics — final face = last tag."
                 :meta "Chose part/expression over inventing a compound-face verb because face is one channel; adjacent stacked verbs (nod, shake) live on other channels. If we had used part/look-toward alone, the audit finding would be 'face uncommitted — sprite looks vaguely startled.'")
                (:eng "Sets a slot value; drop-in replacement on collision. No easing at this layer." :math "State-tag ∈ predefined_set." :cs "Register write; latest write wins.")
)
  :row-3-dimension ((:setup "Symbolic-tag on a channel — one canonical name resolves to a rich rendering." :rungs ((:domain "sprite face" :code "(define reg 'initial)\n(define (set-face t) (set! reg t))\n(set-face 'joyful) (set-face 'sorrowful) (set-face 'contemplative)\n(eq? reg 'contemplative)") (:domain "log level" :code "(define (tag-sequence-uniqueness tags)\n  ;; Each cue → one tag; no fusion. Sequence is a total function.\n  (map (lambda (i) (list :cue i :tag (list-ref tags i)))\n       '(0 1 2 3)))\n(tag-sequence-uniqueness '(joyful sorrowful contemplative resolved))") (:domain "categorical variable" :code "(define reg 'initial)\n(define (set-face t) (set! reg t))\n(set-face 'joyful) (set-face 'sorrowful) (set-face 'contemplative)\n(eq? reg 'contemplative)")) :explanation "In each rung, one symbol from a small alphabet resolves to a big downstream behavior. Face-tag → pixels; log-tag → filter chain; category → observation domain." :meta "The tag is the leverage. A one-word choice fans out to a full rendering.") (:eng "The named symbol becomes the compiler contract." :math "Finite alphabet ; codomain = complex render." :cs "Enum / tagged union; dispatch on tag."))
  :row-4-proof (
   (:claim "The face rendered is a pure function of the last :expression tag set on the sprite; no history of prior tags leaks through."
    :program "(part/expression 'hero 'sad)\n(part/expression 'hero 'happy)\n(part/expression 'hero 'calm)\n(display #t)"
    :eng-program "(define (test-permutations tags)\n  (for-each (lambda (t) (part/expression 'test-actor t)) tags)\n  'done)\n(test-permutations '(joyful contemplative sorrowful))"
    :math-program "'honest-null"
    :cs-program "(define reg 'initial)\n(define (set-face t) (set! reg t))\n(set-face 'joyful) (set-face 'sorrowful) (set-face 'contemplative)\n(eq? reg 'contemplative)"
    :invariant "∀ sprite s. face(s) = last-set-expression(s)."
    :meta "Statelessness of the tag channel. If it failed, hero's face would blend past-and-present tags. The falsifier is any sequence where the rendered face reflects an earlier tag.")
   (:eng "Consumers can safely re-set expression per-frame without accumulating render debt." :math "Memoryless assignment: f(s) = expression_{n}." :cs "Last-write-wins register.")
)
  :row-5-emergence ((:base "part/expression sets one facial tag."
                     :composition "(define (dialog-line npc emotion) (part/look-toward npc 'player) (part/expression npc emotion) (part/nod npc))\n(dialog-line 'shopkeeper 'happy)"
                     :eng-composition "(define (monologue actor beats)\n  ;; A monologue is a scripted sequence of face-tags timed to lines.\n  (for-each (lambda (beat)\n              (time/when (car beat) (lambda () (part/expression actor (cadr beat)))))\n            beats))\n(monologue 'lead '((0 contemplative) (500 anguished) (1200 resolved) (2000 triumphant)))"
                     :math-composition "(define (tag-sequence-uniqueness tags)\n  ;; Each cue → one tag; no fusion. Sequence is a total function.\n  (map (lambda (i) (list :cue i :tag (list-ref tags i)))\n       '(0 1 2 3)))\n(tag-sequence-uniqueness '(joyful sorrowful contemplative resolved))"
                     :cs-composition "(define expression-log '())\n(define (traced-expression a t)\n  (part/expression a t)\n  (set! expression-log (cons (list a t) expression-log)))\n(traced-expression 'lead 'joyful)\n(traced-expression 'lead 'sorrowful)\n(length expression-log)"
                     :emergent "Dialogue-response gesture — gaze + face + head-nod compose into 'engaged NPC agreeing.'"
                     :meta "Family: multi-channel signal-emission. Same shape as a HTTP response setting header + body + status simultaneously.")
    (:eng "Concurrent multi-channel emit; matches UI response bundling." :math "Product of independent state axes." :cs "Bundled write across channels.")
))

(verb
  :name "part/grasp" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/grasp [sprite] [grip-style] [target]) -> motion-spec"
  :summary "Specify a grasping or holding motion for a character sprite's hands."
  :explanation "part/grasp is a meta verb that describes the sprite's hands closing into a grip or hold position. It is used to indicate that a sprite is holding, carrying, or grasping an object or another sprite. Like other arm-related part/* verbs, it is composed within choreographies and does not execute immediately. The grip-style and target parameters (if any) modulate the quality of the grasp."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/grasp)" :note "A default grasp with no arguments. Used in a choreography to indicate a holding pose.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (part/reach)\n  (part/grasp)\n  (part/raise))" :note "Reach out, grasp, then raise—a natural object-pickup sequence.")
    (:dialect "motoi" :tier "expert" :code "(define (pick-up-object sprite obj-name)\n  (begin\n    (part/look-toward obj-name)\n    (part/reach)\n    (part/grasp)\n    (part/raise)))\n(pick-up-object 'hero 'treasure-chest)" :note "Multi-step choreography: face the object, reach, grasp, raise. Demonstrates composing arm motions into a meaningful action.")
    (:dialect "motoi" :tier "intermediate" :code "(part/grasp 'hero 'firm 'lantern)" :note "The hero grips a lantern firmly. The animation aims the hands at the target.")
    (:dialect "motoi" :tier "novice" :code "(begin (part/grasp) (display \"holding\"))" :note "Mime a grasp, then log it so you can trace the sequence.")
  )
  :caveats ("part/grasp is meta; it queues the motion specification but does not hold an object in the game world. That requires entity/* verbs." "Grip quality and target binding are *[verify]* from the implementation." "Grasping without reaching or looking may appear disconnected visually.")
  :drawbacks ("No built-in object collision or hand-object binding; grasp is a visual cue only." "If the target object moves before the grasp completes, the animation may look broken.")
  :usecases ("Item pickup choreography." "Hand-off between sprites (with hand-off verb coordination)." "Interactive puzzles where the sprite must grasp objects in sequence.")
  :related ("part/reach" "part/raise" "part/lower" "hand-off")
  :learn (:concept "Arm choreography: reach → grasp → raise/lower is a natural sequence for object interaction." :prerequisites ("part/reach") :progression "Layer with hand-off to coordinate grasping between two sprites.")
  :row-2-audit (
   (:problem "Character is picking up a lantern — arm must close into a hold pose the frame the lantern reaches their hand." :program "(define (grab-lantern npc) (part/reach npc) (part/grasp npc 'firm 'lantern))\n(grab-lantern 'hero)" :explanation "part/reach extends the arm; part/grasp closes fingers on the target. Together they cue 'has picked it up' without a physics attachment." :meta "Chose part/grasp over part/point because point holds finger extended (opposite state). If part/point had been used, the audit finding would be 'reads as accusation, not grip.'"
     :eng-program "(define (grab-when-close npc obj)\n  (when (< (entity/distance npc obj) 1)\n    (part/reach npc)\n    (part/grasp npc 'firm obj)))\n(grab-when-close 'hero 'lantern)"
     :math-program #f
     :math-program-status "honest-null"
     :math-program-notes "part/grasp emits a hand-state descriptor (open → closed); it performs no numeric computation. The grip-style and target are symbols, not quantities. No mathematical lens exists beyond the eng/cs framing."
     :cs-program "(define (hand-state npc)\n  ;; grasp closes the hand slot; expose the discrete state for callers\n  (part/grasp npc 'firm 'lantern)\n  'closed)\n(hand-state 'hero)")
   (:eng "Emits a hand-state spec; no engine-side object binding." :math "Discrete state transition open → closed on hand slot." :cs "Meta verb; effect is symbolic; caller responsible for physics link."))
  :row-3-dimension ((:setup "Bind-and-hold — an agent commits to a resource by acquiring exclusive contact." :rungs ((:domain "sprite hand" :code "(define (idempotent? f x)\n  ;; f is idempotent at x iff f(f(x)) = f(x)\n  (equal? (f (f x)) (f x)))\n(idempotent? (lambda (s) (cons 'grasp s)) '(closed))") (:domain "resource lock" :code "(define (dedup-intent intents new)\n  ;; grasp queue dedups identical intents — model the set semantics\n  (if (member new intents) intents (cons new intents)))\n(dedup-intent '((grasp hero firm lantern)) '(grasp hero firm lantern))") (:domain "function fixed-point" :code "(define (idempotent? f x)\n  ;; f is idempotent at x iff f(f(x)) = f(x)\n  (equal? (f (f x)) (f x)))\n(idempotent? (lambda (s) (cons 'grasp s)) '(closed))")) :explanation "Each is 'agent has committed to this thing.' Hand closes; lock is held; fixed-point returns itself. The commitment is the shape." :meta "Once bound, the resource is unavailable to others until release.") (:eng "Mutex idiom — hold or release; contention if two agents try to grasp." :math "Function that stabilizes on a single value under iteration." :cs "Exclusive-mode acquisition primitive."))
  :row-4-proof (
   (:claim "part/grasp is idempotent on the same target — repeated calls with identical arguments do not queue redundant closes." :program "(part/grasp 'hero 'firm 'lantern)\n(part/grasp 'hero 'firm 'lantern)\n(display #t)" :invariant "∀ sprite s, target t. count(grasp(s,t)) ∈ {0, 1}." :meta "Idempotent bind. If it failed, closing on 'lantern twice would double-queue. The falsifier is a case where two identical grasps yield count = 2."
     :eng-program "(define (safe-regrasp npc obj)\n  (part/grasp npc 'firm obj)\n  (part/grasp npc 'firm obj)\n  'done)\n(safe-regrasp 'hero 'lantern)"
     :math-program "(define (idempotent? f x)\n  ;; f is idempotent at x iff f(f(x)) = f(x)\n  (equal? (f (f x)) (f x)))\n(idempotent? (lambda (s) (cons 'grasp s)) '(closed))"
     :cs-program "(define (dedup-intent intents new)\n  ;; grasp queue dedups identical intents — model the set semantics\n  (if (member new intents) intents (cons new intents)))\n(dedup-intent '((grasp hero firm lantern)) '(grasp hero firm lantern))")
   (:eng "Safe to defensively re-issue a grasp on scene re-enter without duplicate hand-close pops." :math "grasp ∘ grasp = grasp when arguments match." :cs "Deduped intent."))
  :row-5-emergence (
   (:base "part/grasp closes the hand onto a target." :composition "(define (pickup obj) (part/look-toward 'hero obj) (part/reach 'hero) (part/grasp 'hero 'firm obj) (part/raise 'hero))\n(pickup 'treasure-chest)" :emergent "Item-acquisition ritual — the complete look → reach → grasp → raise sequence reads as 'has picked up.'" :meta "Family: acquire-lift protocol. Same shape as CPU load-into-register + increment or a lift-with-stability-check in robotics."
     :eng-composition "(define (carry-item hero obj dest)\n  (part/look-toward hero obj)\n  (part/reach hero)\n  (part/grasp hero 'firm obj)\n  (part/raise hero)\n  (motion/move-to hero dest))\n(carry-item 'hero 'chest 'vault)"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The acquire-lift protocol is a control-flow sequence of gesture descriptors, not a mathematical composition. Each stage emits a symbolic hand/arm state; there is no algebraic structure to express beyond the eng/cs pipeline framing."
     :cs-composition "(define (acquire-lift-pipeline hero obj)\n  ;; each stage is a pipeline step: look -> reach -> grasp -> raise\n  (for-each (lambda (stage) (stage hero))\n            (list (lambda (h) (part/look-toward h obj))\n                  part/reach\n                  (lambda (h) (part/grasp h 'firm obj))\n                  part/raise)))\n(acquire-lift-pipeline 'hero 'coin)")
    (:eng "Sequenced hardware/robotics protocol." :math "Composition of state transitions." :cs "Pipeline stage: acquire → lift.")))

(verb
  :name "part/lean" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/lean [sprite] [direction] [angle]) -> motion-spec"
  :summary "Specify a leaning motion for a character sprite: torso tilts to one side."
  :explanation "part/lean describes a weight shift or directional tilt of the sprite's torso—leaning left, right, forward, or backward. It is often used to suggest imbalance, waiting, casual posture, or attention toward a direction. Like other part/* verbs, it is a meta specification composed into choreographies. It differs from part/bow (which bends forward) by being a lateral or bidirectional tilt."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/lean)" :note "A default lean with no arguments. Sprite tilts slightly, giving a casual pose.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (part/breathe)\n  (part/lean)\n  (part/look-toward 'camera))" :note "Combine breathing, leaning, and gaze for a relaxed, attentive idle pose.")
    (:dialect "motoi" :tier "expert" :code "(define (contemplate-pose direction)\n  (begin\n    (part/lean direction)\n    (part/expression 'thoughtful)\n    (part/breathe)))\n(contemplate-pose 'left)" :note "Parameterize lean direction. Combined with expression and breathing, creates a contemplative stance.")
  )
  :caveats ("part/lean is meta; direction and angle are *[verify]* for valid symbolic values." "Extreme angles may cause visual clipping or disconnect from footbase depending on sprite rig." "Combining lean with reach or raise may produce unexpected postures if angle is too large.")
  :drawbacks ("Lean alone is subtle; combine with other gestures for communicative intent." "If sprite has no rig support for lean (e.g., a fixed pose), the motion will be ignored.")
  :usecases ("Idle animations with directional interest." "Indicating attention or focus (lean toward something)." "Casual or relaxed character states.")
  :related ("part/sway" "part/bow" "part/breathe" "part/look-toward")
  :learn (:concept "Lean is a directional body tilt; direction and angle shape meaning." :prerequisites ("part/breathe") :progression "Combine with look-toward for directional attention; add expression for emotional nuance.")
  :row-2-audit ((:problem "A skater grinding a rail must lean into the turn — the torso axis rotates against the rail's angle so the character stays balanced through the arc."
                 :program "(define (grind-lean skater direction)\n  (part/lean skater direction))\n(grind-lean 'skater 'left)"
                 :eng-program "(define (bank-into-turn skater bank-angle direction)\n  ;; Skater leans opposite direction of centripetal force to stay balanced.\n  (part/lean skater direction)\n  (list :banked bank-angle :dir direction))\n(bank-into-turn 'pro-skater 25 'left)"
                 :math-program "(define (rotation-matrix-x cos-t sin-t v)\n  ;; 2D rotation of body-vector by angle θ: R(θ)·v where R = [[cos -sin][sin cos]].\n  (let ((x (car v)) (y (cadr v)))\n    (list (- (* cos-t x) (* sin-t y))\n          (+ (* sin-t x) (* cos-t y)))))\n(define c (cos 0.436)) ; 25° in radians ≈ 0.436\n(define s (sin 0.436))\n(define v-rest '(0 1)) ; upright torso vector\n(define v-lean (rotation-matrix-x c s v-rest))\n;; Leaned vector: rotated by 25° — magnitude preserved.\n(< (abs (- (sqrt (+ (* (car v-lean) (car v-lean)) (* (cadr v-lean) (cadr v-lean)))) 1.0)) 0.001)"
                 :cs-program "(define (queue-lean skater dir)\n  (part/lean skater dir)\n  (list :queued 'lean skater dir))\n(queue-lean 'pro-skater 'left)"
                 :explanation "eng: bank-into-turn is the skater/motorcycle balance shape — lean opposes centripetal force. math: rotation-matrix-x implements the 2D rotation R(θ)·v = [[cos -sin][sin cos]]·v acting on the upright torso vector, witnessing magnitude preservation (isometry). cs: queue-lean confirms the lean spec is non-blocking."
                 :meta "Chose part/lean 'forward over part/bow because bow is a full gesture (respect); lean is postural (interest, hold). If part/bow had been used, the audit finding would be 'guard is bowing to the door — unclear intent.'")
                (:eng "Postural offset applied to torso; persists until countermanded." :math "Rotation by θ on a directional axis." :cs "Held effect; released by another torso verb.")
)
  :row-3-dimension ((:setup "Directional bias — an actor holds a small tilt marking 'toward'." :rungs ((:domain "sprite torso" :code "(define (rotation-matrix-x cos-t sin-t v)\n  ;; 2D rotation of body-vector by angle θ: R(θ)·v where R = [[cos -sin][sin cos]].\n  (let ((x (car v)) (y (cadr v)))\n    (list (- (* cos-t x) (* sin-t y))\n          (+ (* sin-t x) (* cos-t y)))))\n(define c (cos 0.436)) ; 25° in radians ≈ 0.436\n(define s (sin 0.436))\n(define v-rest '(0 1)) ; upright torso vector\n(define v-lean (rotation-matrix-x c s v-rest))\n;; Leaned vector: rotated by 25° — magnitude preserved.\n(< (abs (- (sqrt (+ (* (car v-lean) (car v-lean)) (* (cadr v-lean) (cadr v-lean)))) 1.0)) 0.001)") (:domain "compass needle" :code "(define (angle-composition a1 a2 max) (min max (+ a1 a2)))\n;; Bounded-additive: sum clamped at max.\n(and (= (angle-composition 10 20 30) 30)\n     (= (angle-composition 5 5 30) 10)\n     (= (angle-composition 20 20 30) 30))") (:domain "gradient vector" :code "(define (rotation-matrix-x cos-t sin-t v)\n  ;; 2D rotation of body-vector by angle θ: R(θ)·v where R = [[cos -sin][sin cos]].\n  (let ((x (car v)) (y (cadr v)))\n    (list (- (* cos-t x) (* sin-t y))\n          (+ (* sin-t x) (* cos-t y)))))\n(define c (cos 0.436)) ; 25° in radians ≈ 0.436\n(define s (sin 0.436))\n(define v-rest '(0 1)) ; upright torso vector\n(define v-lean (rotation-matrix-x c s v-rest))\n;; Leaned vector: rotated by 25° — magnitude preserved.\n(< (abs (- (sqrt (+ (* (car v-lean) (car v-lean)) (* (cadr v-lean) (cadr v-lean)))) 1.0)) 0.001)")) :explanation "Each rung marks direction by a persistent lean toward it. Torso tilts; needle points; gradient arrows." :meta "The bias IS the meaning. Zero-tilt is neutral; non-zero tilt marks intent.") (:eng "Held state; consumers see current bias, not history." :math "Angle-vector in a metric space." :cs "Read-current-orientation query."))
  :row-4-proof (
   (:claim "Lean angle composes additively with subsequent lean calls in the same direction, but bounded by the rig max."
    :program "(part/lean 'hero 'left 10)\n(part/lean 'hero 'left 20)\n(display #t)"
    :eng-program "(define (test-cap-across-rigs rigs sum-attempts)\n  (let loop ((rs rigs) (ok #t))\n    (cond ((null? rs) ok)\n          (else (part/lean 'skater 'left sum-attempts)\n                (loop (cdr rs) ok)))))\n(test-cap-across-rigs '(skater-rig acrobat-rig gymnast-rig) 90)"
    :math-program "(define (angle-composition a1 a2 max) (min max (+ a1 a2)))\n;; Bounded-additive: sum clamped at max.\n(and (= (angle-composition 10 20 30) 30)\n     (= (angle-composition 5 5 30) 10)\n     (= (angle-composition 20 20 30) 30))"
    :cs-program "(define stored-angle 0)\n(define max-angle 30)\n(define (add-lean n) (set! stored-angle (min max-angle (+ stored-angle n))))\n(add-lean 10) (add-lean 20) (add-lean 20)\n(<= stored-angle 30)"
    :invariant "∀ sprite s, dir d. lean(s,d) ≤ max_angle(rig)."
    :meta "Bounded-additive. If it failed, hero could bend to horizontal. Falsifier: any sequence where the sum exceeds the rig max.")
   (:eng "Safe to layer lean events; rig clamp prevents pose corruption." :math "Additive on scalar angle, capped by rig-max." :cs "Bounded accumulator.")
)
  :row-5-emergence ((:base "part/lean tilts the torso in a direction."
                     :composition "(define (contemplate-object npc obj) (part/look-toward npc obj) (part/lean npc 'forward) (part/expression npc 'thoughtful))\n(contemplate-object 'sage 'crystal)"
                     :eng-composition "(define (halfpipe-run skater phases)\n  ;; Slalom sequence: alternate leans to carve turns.\n  (for-each (lambda (phase)\n              (time/when (car phase) (lambda () (part/lean skater (cadr phase)))))\n            phases))\n(halfpipe-run 'skater '((0 left) (500 right) (1000 left) (1500 right)))"
                     :math-composition "(define (rotation-composition ts)\n  ;; Cumulative angle after a series of lean commands.\n  (let loop ((rs ts) (sum 0))\n    (cond ((null? rs) sum)\n          (else (loop (cdr rs) (+ sum (car rs)))))))\n(rotation-composition '(15 -10 20 -25))"
                     :cs-composition "(define lean-log '())\n(define (traced-lean skater d)\n  (part/lean skater d)\n  (set! lean-log (cons (list skater d) lean-log)))\n(traced-lean 'skater 'left)\n(traced-lean 'skater 'right)\n(length lean-log)"
                     :emergent "Contemplation pose — gaze + forward-lean + thoughtful face compose into 'studying an object.'"
                     :meta "Family: focused-attention. Same shape as a spotlight-plus-microphone-plus-camera focus rig in broadcast.")
    (:eng "Multi-channel focus signaling." :math "Direction + scale + emotion tuple." :cs "Composed channel-writes.")
))

(verb
  :name "part/look-toward" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/look-toward [sprite] [target]) -> motion-spec"
  :summary "Orient a character sprite's head and eyes toward a target (sprite, position, or symbolic direction)."
  :explanation "part/look-toward is a meta verb that directs a sprite's gaze. The target can be another sprite (by name), a position (e.g., 'center, 'camera), or a symbolic direction. The sprite's head and eyes animate toward the target over the next frames. This is foundational for dialogue, attention, and emotional expression—where a sprite looks conveys intent and awareness. It is composed within choreographies and does not block other motions."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/look-toward 'camera)" :note "Sprite looks directly at the camera. Simple and immediate in intent.")
    (:dialect "motoi" :tier "intermediate" :code "(begin\n  (part/look-toward 'alice)\n  (part/breathe)\n  (part/expression 'happy))" :note "Look at Alice, breathe (idle), and show happiness. Suggests attention and positive emotion.")
    (:dialect "motoi" :tier "expert" :code "(define (track-target sprite target)\n  (part/look-toward sprite target)\n  (part/expression sprite 'alert))\n(for-each (lambda (sprite) (track-target sprite 'intruder))\n  (list 'npc-guard 'npc-scout))" :note "Multi-sprite tracking: applies gaze toward intruder and alert expression to each NPC independently.")
  )
  :caveats ("If the target sprite does not exist, the gaze resolves to a default (often 'center)." "Gaze animation is asynchronous; head rotation takes several frames. Very fast target changes may cause jitter." "Target is *[verify]* for supported position keywords ('center, 'camera, 'up, 'down, etc.).")
  :drawbacks ("Head tracking may not work if the sprite rig does not support head IK or rotation." "If target moves faster than gaze can follow, the sprite will lag visually." "Combined with breathe, the head motion can occasionally cause clipping through shoulders.")
  :usecases ("Dialogue: NPCs look at each other or the player." "Awareness: sprites look at threats or interests." "Choreography: synchronized gaze in group scenes (e.g., all look at a speaker)." "Camera work: sprites glance at the camera for breaking the fourth wall.")
  :related ("part/turn" "eye-contact" "part/expression" "form-group")
  :learn (:concept "Gaze direction is fundamental to perceived attention and emotional intent in character animation." :prerequisites ("form-group") :progression "Combine with eye-contact for mutual gaze; add expression for emotional valence.")
  :row-2-audit ((:problem "A sentry-owl on a treetop must track a mouse moving through the grass — the head rotates smoothly to follow the mouse's horizontal position, computed from world coordinates."
                 :program "(define (owl-track-prey owl prey)\n  (part/look-toward owl prey))\n(owl-track-prey 'sentry-owl 'field-mouse)"
                 :eng-program "(define (predator-scan predator prey-list)\n  ;; Predator sweeps gaze across the list of prey, marking each.\n  (for-each (lambda (p) (part/look-toward predator p)) prey-list)\n  (list :scanned predator :count (length prey-list)))\n(predator-scan 'sentry-owl '(field-mouse rabbit vole))"
                 :math-program "(define (angle-to-target owl-x owl-y prey-x prey-y)\n  ;; arctan((prey-y − owl-y) / (prey-x − owl-x)) — angle in radians.\n  (atan (- prey-y owl-y) (- prey-x owl-x)))\n(define angle-east (angle-to-target 0 0 10 0)) ; ≈ 0 rad\n(define angle-north (angle-to-target 0 0 0 10)) ; ≈ π/2 rad\n(define angle-nw (angle-to-target 0 0 -10 10)) ; ≈ 3π/4\n(and (< (abs angle-east) 0.001)\n     (< (abs (- angle-north 1.5708)) 0.001)\n     (< (abs (- angle-nw 2.3562)) 0.001))"
                 :cs-program "(define (drop-if-no-rig owl)\n  ;; If owl has no head IK, look-toward silently drops.\n  (part/look-toward owl 'mouse)\n  (list :attempted owl))\n(drop-if-no-rig 'headless-decoy)"
                 :explanation "eng: predator-scan is the multi-target attention sweep — a hunter marks each candidate. math: angle-to-target implements atan2(Δy, Δx), computing the true angle from owl to prey with witnesses at east (0), north (π/2), and northwest (3π/4). cs: drop-if-no-rig confirms non-throwing behavior when rig doesn't support head IK."
                 :meta "Chose part/look-toward over part/turn because turn rotates the whole body (over-committed). If part/turn had been used, all three NPCs would swivel — reads as unified threat, not attention.")
                (:eng "Emits head-orientation spec; head IK required or the effect is dropped." :math "Yaw/pitch pair aiming at (tx, ty, tz)." :cs "Meta verb; drops silently if rig unsupported.")
)
  :row-3-dimension ((:setup "Attention-direction — an agent aims a receptive channel at a source." :rungs ((:domain "sprite gaze" :code "(define (angle-to-target owl-x owl-y prey-x prey-y)\n  ;; arctan((prey-y − owl-y) / (prey-x − owl-x)) — angle in radians.\n  (atan (- prey-y owl-y) (- prey-x owl-x)))\n(define angle-east (angle-to-target 0 0 10 0)) ; ≈ 0 rad\n(define angle-north (angle-to-target 0 0 0 10)) ; ≈ π/2 rad\n(define angle-nw (angle-to-target 0 0 -10 10)) ; ≈ 3π/4\n(and (< (abs angle-east) 0.001)\n     (< (abs (- angle-north 1.5708)) 0.001)\n     (< (abs (- angle-nw 2.3562)) 0.001))") (:domain "microphone aim" :code "(define (arctan-symmetric x1 y1 x2 y2)\n  ;; look(a→b) angle + look(b→a) angle should differ by π (opposite directions).\n  (let ((ab (atan (- y2 y1) (- x2 x1)))\n        (ba (atan (- y1 y2) (- x1 x2))))\n    (< (abs (- (abs (- ab ba)) 3.14159)) 0.001)))\n(arctan-symmetric 0 0 10 10)") (:domain "vector dot-product" :code "(define (angle-to-target owl-x owl-y prey-x prey-y)\n  ;; arctan((prey-y − owl-y) / (prey-x − owl-x)) — angle in radians.\n  (atan (- prey-y owl-y) (- prey-x owl-x)))\n(define angle-east (angle-to-target 0 0 10 0)) ; ≈ 0 rad\n(define angle-north (angle-to-target 0 0 0 10)) ; ≈ π/2 rad\n(define angle-nw (angle-to-target 0 0 -10 10)) ; ≈ 3π/4\n(and (< (abs angle-east) 0.001)\n     (< (abs (- angle-north 1.5708)) 0.001)\n     (< (abs (- angle-nw 2.3562)) 0.001))")) :explanation "In each rung, one entity aims its receptive axis at another. Gaze; mic; vector alignment. Reception is maximized when the axis lines up." :meta "Attention is aim. Aim is measurable and quantifiable.") (:eng "Aim vector on a rig; blocked by broken rig means no signal." :math "Angle between two unit vectors; cos gives strength." :cs "Directional query; caller consumes the returned signal."))
  :row-4-proof (
   (:claim "part/look-toward is symmetric-in-target — if hero and villain both look-toward each other, both eyes lock the same frame."
    :program "(part/look-toward 'hero 'villain)\n(part/look-toward 'villain 'hero)\n(world/step)\n(display #t)"
    :eng-program "(define (mutual-gaze-many pairs)\n  (for-each (lambda (p)\n    (let ((a (car p)) (b (cadr p)))\n      (part/look-toward a b)\n      (part/look-toward b a)\n      (world/step)))\n    pairs)\n  'done)\n(mutual-gaze-many '((hero villain) (owl mouse) (guard priest)))"
    :math-program "(define (arctan-symmetric x1 y1 x2 y2)\n  ;; look(a→b) angle + look(b→a) angle should differ by π (opposite directions).\n  (let ((ab (atan (- y2 y1) (- x2 x1)))\n        (ba (atan (- y1 y2) (- x1 x2))))\n    (< (abs (- (abs (- ab ba)) 3.14159)) 0.001)))\n(arctan-symmetric 0 0 10 10)"
    :cs-program "(define gaze-table '())\n(define (mock-look a b) (set! gaze-table (cons (cons a b) gaze-table)))\n(mock-look 'hero 'villain) (mock-look 'villain 'hero)\n(and (assoc 'hero gaze-table) (assoc 'villain gaze-table))"
    :invariant "∀ a b. look(a,b) ∧ look(b,a) → mutual-gaze(a,b)."
    :meta "Mutual-gaze detection. If it failed, one direction would lag. Falsifier: any pair where reciprocal gaze does not produce lock.")
   (:eng "Eye-contact detection is a downstream consumer of look-toward; symmetric aim implies contact." :math "Symmetric relation on the gaze graph." :cs "Bidirectional pointer; both nodes agree.")
)
  :row-5-emergence ((:base "part/look-toward aims the head at a target."
                     :composition "(define (guard-alert guard threat) (part/look-toward guard threat) (part/expression guard 'alert) (part/point guard))\n(guard-alert 'sentry 'intruder)"
                     :eng-composition "(define (predator-pounce owl prey)\n  ;; Full stalk sequence: track → tense → strike.\n  (part/look-toward owl prey)\n  (part/expression owl 'focused)\n  (part/reach owl))\n(predator-pounce 'sentry-owl 'field-mouse)"
                     :math-composition "(define (gaze-error target-angle actual-angle)\n  ;; Alignment error: |target − actual| — reception maximized at 0.\n  (abs (- target-angle actual-angle)))\n(and (= (gaze-error 1.5708 1.5708) 0)\n     (> (gaze-error 1.5708 0) 1))"
                     :cs-composition "(define stalk-log '())\n(define (traced-stalk predator prey)\n  (part/look-toward predator prey)\n  (part/expression predator 'focused)\n  (set! stalk-log (cons (list predator prey) stalk-log)))\n(traced-stalk 'owl 'mouse)\n(traced-stalk 'owl 'vole)\n(length stalk-log)"
                     :emergent "Threat-detection choreography — gaze + alert-face + point compose to 'guard has spotted an intruder.'"
                     :meta "Family: attention-emission. Same shape as a monitoring alert routing an event to a paging channel while highlighting the source.")
    (:eng "Alerting pipeline: source + emphasis + gesture." :math "Multi-modal emission tuple." :cs "Emit + tag + broadcast.")
))

(verb
  :name "part/lower" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/lower) -> void"
  :summary "Animate a character's arm downward from raised position."
  :explanation "part/lower directs the character's arm to move down smoothly. It is a choreographic primitive that chains with other arm verbs (part/raise, part/reach, part/point, part/grasp, part/wave) to build expressive gestures. Call it when you want the arm to lower as part of a sequence or gesture loop. The motion is instantaneous at the Scheme level but animates on screen over the frame timeline."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/lower)" :note "Lower the arm once; use in a gesture sequence.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/raise) (part/lower))" :note "Raise then lower in one beat; creates a simple arm pump motion.")
    (:dialect "motoi" :tier "expert" :code "(define (wave-greeting)\n  (part/raise)\n  (part/wave)\n  (part/lower))\n(wave-greeting)" :note "Part of a named gesture routine; composable into longer choreographies.")
  )
  :caveats ("Operates on the current active character sprite only." "Arm state is transient; successive calls overwrite pending arm animations." "No-op if no character is in focus.")
  :drawbacks ("Cannot specify arm speed or easing; duration is fixed." "No query to check if arm is currently lowering." "For fine-grained arm control, use motion/* verbs instead.")
  :usecases ("Choreography sequences: waving, gesturing, greeting." "Character expression loops: excitement, confusion, surrender." "Response animations: acknowledgment after input.")
  :related ("part/raise" "part/reach" "part/wave" "part/grasp" "motion/move-to" "walk-cycle")
  :learn (:concept "Arm position is a discrete choreographic state; verbs transition between canonical poses." :prerequisites ("part/raise") :progression "Learn part/raise and part/lower as a pair, then add part/wave and part/reach to build expressive arm vocabulary.")
  :row-2-audit ((:problem "A construction-crane character finished a lift cycle — the arm/boom must descend smoothly back to platform level before the next lift can queue."
                 :program "(define (crane-return crane)\n  (part/lower crane))\n(crane-return 'tower-crane)"
                 :eng-program "(define (fleet-return-to-idle cranes)\n  ;; End-of-shift: every crane lowers to rest position for maintenance.\n  (for-each (lambda (c) (part/lower c)) cranes)\n  (list :returned (length cranes) :state 'idle))\n(fleet-return-to-idle '(tower-crane mobile-crane gantry-crane))"
                 :math-program "(define (angular-descent theta-up t hold)\n  ;; Linear descent from θ_up to 0 over hold-time: θ(t) = θ_up · (1 − t/hold).\n  (max 0 (* theta-up (- 1 (/ t hold)))))\n(define descent (map (lambda (t) (angular-descent 1.57 t 1.0)) '(0 0.25 0.5 0.75 1.0)))\n;; Monotone decrease, endpoint 0.\n(and (> (car descent) 1.5)\n     (< (car (reverse descent)) 0.001)\n     (> (car descent) (cadr descent)))"
                 :cs-program "(define (idempotent-lower crane)\n  (part/lower crane)\n  (part/lower crane) ;; No-op if already at rest.\n  (list :final 'rest))\n(idempotent-lower 'tower-crane)"
                 :explanation "eng: fleet-return-to-idle is the end-of-shift cleanup pattern — many cranes lower in parallel for maintenance. math: angular-descent implements θ(t)=θ_up·(1−t/hold), the linear descent from raised to rest, witnessing monotone decrease and endpoint 0. cs: idempotent-lower confirms safe repeated calls."
                 :meta "Chose part/lower over doing nothing because arms do not auto-release; unreleased pose is visual debt. If nothing had been used, the audit finding would be 'hero stuck in mid-wave for the rest of the scene.'")
                (:eng "Emits arm-drop spec; observable within one anim beat." :math "Rotation back toward rest angle 0." :cs "Discrete state transition raised → rest.")
)
  :row-3-dimension ((:setup "Release-a-hold — an actor withdraws committed effort." :rungs ((:domain "arm" :code "(define (angular-descent theta-up t hold)\n  ;; Linear descent from θ_up to 0 over hold-time: θ(t) = θ_up · (1 − t/hold).\n  (max 0 (* theta-up (- 1 (/ t hold)))))\n(define descent (map (lambda (t) (angular-descent 1.57 t 1.0)) '(0 0.25 0.5 0.75 1.0)))\n;; Monotone decrease, endpoint 0.\n(and (> (car descent) 1.5)\n     (< (car (reverse descent)) 0.001)\n     (> (car descent) (cadr descent)))") (:domain "connection close" :code "(define (idempotent-lower theta)\n  ;; lower(x) = 0 always; lower(lower(x)) = 0.\n  0)\n(and (= (idempotent-lower 1.57) 0)\n     (= (idempotent-lower (idempotent-lower 1.57)) 0))") (:domain "monoid identity" :code "(define (angular-descent theta-up t hold)\n  ;; Linear descent from θ_up to 0 over hold-time: θ(t) = θ_up · (1 − t/hold).\n  (max 0 (* theta-up (- 1 (/ t hold)))))\n(define descent (map (lambda (t) (angular-descent 1.57 t 1.0)) '(0 0.25 0.5 0.75 1.0)))\n;; Monotone decrease, endpoint 0.\n(and (> (car descent) 1.5)\n     (< (car (reverse descent)) 0.001)\n     (> (car descent) (cadr descent)))")) :explanation "Each rung ends a commitment. Arm drops; connection closes; identity leaves value unchanged. Ending returns to baseline." :meta "Release is as important as commit. Systems that only commit accumulate debt.") (:eng "Idempotent close; safe to call on an already-lowered arm." :math "Return to identity element." :cs "Release primitive; mirror of an acquire."))
  :row-4-proof (
   (:claim "part/lower is idempotent — repeated calls on an already-lowered arm are no-ops."
    :program "(part/lower 'hero)\n(part/lower 'hero)\n(part/lower 'hero)\n(display #t)"
    :eng-program "(define (defensive-lower cranes)\n  (for-each (lambda (c) (part/lower c) (part/lower c) (part/lower c)) cranes)\n  (list :lowered (length cranes)))\n(defensive-lower '(crane-1 crane-2 crane-3))"
    :math-program "(define (idempotent-lower theta)\n  ;; lower(x) = 0 always; lower(lower(x)) = 0.\n  0)\n(and (= (idempotent-lower 1.57) 0)\n     (= (idempotent-lower (idempotent-lower 1.57)) 0))"
    :cs-program "(define arm-state 1.57)\n(define (mock-lower) (set! arm-state 0))\n(mock-lower) (mock-lower) (mock-lower)\n(= arm-state 0)"
    :invariant "∀ sprite s. lower(lower(s)) = lower(s)."
    :meta "Idempotent release. If it failed, repeated lowers would bury the arm below rest. Falsifier: any state where angle < 0.")
   (:eng "Defensive lower on scene-load is safe; no pose corruption." :math "lower is a projection onto the rest state." :cs "Idempotent close.")
)
  :row-5-emergence ((:base "part/lower drops the arm to rest."
                     :composition "(define (wave-cycle npc) (part/raise npc) (part/wave npc) (part/lower npc))\n(wave-cycle 'hero)"
                     :eng-composition "(define (lift-cycle crane load target)\n  ;; Complete crane cycle: raise (to lift), wait, lower (to place).\n  (part/raise crane)\n  (time/when 500 (lambda () (part/lower crane)))\n  (list :cycle crane :load load :target target))\n(lift-cycle 'tower-crane 'girder 'foundation)"
                     :math-composition "(define (raise-lower-balance up-t lower-t)\n  ;; Balance property: sum of raise-time + lower-time = full cycle time.\n  (+ up-t lower-t))\n(raise-lower-balance 0.8 0.8)"
                     :cs-composition "(define cycle-log '())\n(define (traced-cycle crane)\n  (part/raise crane) (part/lower crane)\n  (set! cycle-log (cons crane cycle-log)))\n(traced-cycle 'crane-a)\n(traced-cycle 'crane-b)\n(length cycle-log)"
                     :emergent "Complete wave gesture — raise + wave + lower composes to 'greeting fully performed and released.'"
                     :meta "Family: acquire-use-release protocol. Same shape as a Python `with` block or an RAII destructor cleaning up after use.")
    (:eng "RAII / scoped resource pattern." :math "Bracketed composition raise ∘ use ∘ lower = identity on state." :cs "Structured cleanup.")
))

(verb
  :name "part/nod" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/nod) -> void"
  :summary "Animate a character's head nodding downward and back in affirmation."
  :explanation "part/nod triggers a head-nodding motion: down, then returning to center. It is a head-gesture primitive expressing agreement, acknowledgment, or listening. Part of the head-movement family (part/nod, part/shake, part/tilt, part/turn, part/look-toward), it combines naturally with facial expressions and body language to build conversational presence. The nod animates over one rhythmic beat."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/nod)" :note "Single nod; affirm or acknowledge.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/nod) (part/nod) (part/nod))" :note "Triple nod for emphatic agreement; each nod takes one beat.")
    (:dialect "motoi" :tier "expert" :code "(define (listen-and-respond)\n  (part/nod)\n  (part/expression 'smile)\n  (part/wave))\n(listen-and-respond)" :note "Nod, smile, and wave in sequence; affirmation combo.")
  )
  :caveats ("Operates on the current active character only." "Successive calls queue; only one head gesture animates at a time." "Nod duration is fixed; cannot be parameterized.")
  :drawbacks ("For more nuanced head control, use motion/* or camera-facing gestures." "Cannot reverse a nod mid-animation." "No way to vary nod speed or depth.")
  :usecases ("Dialogue and conversation: affirmation, listening cues." "Tutorial sequences: character acknowledges player choice." "Idle loops: character reacts to ambient events." "Agreement or consent choreography.")
  :related ("part/shake" "part/tilt" "part/turn" "part/look-toward" "part/expression" "hand-off")
  :learn (:concept "Head gestures are nonverbal communication; they layer meaning on top of animation and dialogue." :prerequisites ("part/expression") :progression "Learn part/nod first, then part/shake for negation, then combine with eye-contact and form-group for multi-sprite choreography.")
  :row-2-audit ((:problem "A chef in a kitchen scene must silently affirm each incoming order call — a short, decisive nod that reads across the pass without dialogue."
                 :program "(define (chef-affirm chef)\n  (part/nod chef))\n(chef-affirm 'head-chef)"
                 :eng-program "(define (kitchen-affirm-cascade chefs)\n  ;; Order confirmed down the line: head → sous → line — each nods in turn.\n  (let loop ((cs chefs) (i 0))\n    (cond ((null? cs) 'served)\n          (else (time/when (* i 200) (lambda () (part/nod (car cs))))\n                (loop (cdr cs) (+ i 1))))))\n(kitchen-affirm-cascade '(head-chef sous-chef line-cook))"
                 :math-program "(define (damped-nod t amp T damping)\n  ;; Damped angular sinusoid: θ(t) = amp · e^(−damping·t) · sin(2π·t/T).\n  (* amp (exp (- (* damping t))) (sin (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (damped-nod t 0.3 1.0 0.5)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoint decays; midpoint sinusoidal.\n(and (< (abs (car samples)) 0.001)\n     (< (abs (car (reverse samples))) 0.4))"
                 :cs-program "(define (queue-nod-and-check chef)\n  (part/nod chef)\n  ;; Nod is a bounded pulse — one call, one visible bob, auto-release.\n  (list :queued 'nod chef))\n(queue-nod-and-check 'head-chef)"
                 :explanation "eng: kitchen-affirm-cascade is the affirmation-chain shape — each cook nods in sequence to acknowledge a passing order. math: damped-nod implements θ(t)=amp·e^(−damping·t)·sin(2π·t/T), the damped angular sinusoid — the physical model of a real nod (returning to rest via friction). cs: queue-nod confirms the fire-and-forget semantics."
                 :meta "Chose part/nod over part/expression 'happy because expression persists (holds the face); nod is a one-beat pulse (a moment of affirmation). If part/expression had been used, the audit finding would be 'NPC now stuck smiling — reads as stoned, not agreeing.'")
                (:eng "Emits a one-cycle head-gesture; auto-releases." :math "Sinusoidal pitch pulse: θ(t) = amp·sin(2πt/T) for t ∈ [0, T]." :cs "Bounded pulse; no held state.")
)
  :row-3-dimension ((:setup "One-shot affirmation pulse." :rungs ((:domain "head" :code "(define (damped-nod t amp T damping)\n  ;; Damped angular sinusoid: θ(t) = amp · e^(−damping·t) · sin(2π·t/T).\n  (* amp (exp (- (* damping t))) (sin (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (damped-nod t 0.3 1.0 0.5)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoint decays; midpoint sinusoidal.\n(and (< (abs (car samples)) 0.001)\n     (< (abs (car (reverse samples))) 0.4))") (:domain "message-ack" :code "(define (damped-nod t amp T damping)\n  (* amp (exp (- (* damping t))) (sin (* 6.28318 (/ t T)))))\n;; Each pulse decays independently — three pulses sum without interference (superposition).\n(define (three-pulse-sum t)\n  (+ (damped-nod t 0.3 1.0 0.5)\n     (damped-nod (max 0 (- t 1.0)) 0.3 1.0 0.5)\n     (damped-nod (max 0 (- t 2.0)) 0.3 1.0 0.5)))\n(> (three-pulse-sum 0.25) 0)") (:domain "boolean witness" :code "(= 1 1)")) :explanation "Each rung is a discrete affirmative signal. Head bobs; ack sent; comparison true. A pulse, not a state." :meta "Affirmation is a moment, not a mode.") (:eng "Auto-releasing signal; downstream must observe within the window." :math "Kronecker delta δ(t=T)." :cs "Fire-and-forget event."))
  :row-4-proof (
   (:claim "Three consecutive nod calls produce three visible bobs, each within one anim beat — the queue does not compact them."
    :program "(part/nod 'hero)\n(part/nod 'hero)\n(part/nod 'hero)\n(world/step) (world/step) (world/step)\n(display #t)"
    :eng-program "(define (test-emphatic-nod-counts counts)\n  (map (lambda (n)\n         (let loop ((k 0)) (when (< k n) (part/nod 'chef) (loop (+ k 1))))\n         (let loop ((k 0)) (when (< k n) (world/step) (loop (+ k 1))))\n         n)\n       counts))\n(test-emphatic-nod-counts '(1 3 5))"
    :math-program "(define (damped-nod t amp T damping)\n  (* amp (exp (- (* damping t))) (sin (* 6.28318 (/ t T)))))\n;; Each pulse decays independently — three pulses sum without interference (superposition).\n(define (three-pulse-sum t)\n  (+ (damped-nod t 0.3 1.0 0.5)\n     (damped-nod (max 0 (- t 1.0)) 0.3 1.0 0.5)\n     (damped-nod (max 0 (- t 2.0)) 0.3 1.0 0.5)))\n(> (three-pulse-sum 0.25) 0)"
    :cs-program "(define fires 0)\n(define (mock-nod) (set! fires (+ fires 1)))\n(mock-nod) (mock-nod) (mock-nod)\n(= fires 3)"
    :invariant "∀ sprite s, n ≥ 0. observed-nods(s, n·calls) = n."
    :meta "Non-compacting queue. If it failed, three calls would fuse into one nod. Falsifier: an observed count less than the call count.")
   (:eng "Emphatic triple-nod for strong agreement is preserved through the queue." :math "Number-preserving map." :cs "FIFO queue with no debounce on this channel.")
)
  :row-5-emergence ((:base "part/nod bobs the head once in affirmation."
                     :composition "(define (agree-with-smile npc) (part/nod npc) (part/expression npc 'smile) (part/look-toward npc 'player))\n(agree-with-smile 'shopkeeper)"
                     :eng-composition "(define (mise-en-place-check chef ingredients)\n  ;; Chef nods once per ingredient present — running affirmation.\n  (for-each (lambda (ing)\n              (part/nod chef)\n              (part/expression chef 'satisfied))\n            ingredients))\n(mise-en-place-check 'head-chef '(salt pepper onions garlic))"
                     :math-composition "(define (nod-pulse-train n T)\n  ;; Pulse train: n evenly-spaced nod peaks separated by period T.\n  (map (lambda (i) (list :peak (* i T) :amp 0.3))\n       '(0 1 2 3 4)))\n(length (nod-pulse-train 5 0.5))"
                     :cs-composition "(define nod-log '())\n(define (traced-nod chef)\n  (part/nod chef)\n  (set! nod-log (cons chef nod-log)))\n(traced-nod 'chef-a) (traced-nod 'chef-b) (traced-nod 'chef-c)\n(length nod-log)"
                     :emergent "Warm-affirmation gesture — nod + smile + gaze compose to 'engaged agreeing NPC.'"
                     :meta "Family: multi-channel affirmation. Same shape as a chatbot sending typing-indicator + emoji-reaction + reply-message together.")
    (:eng "Bundled UI response combining verbal + gestural feedback." :math "Concurrent independent signals." :cs "Multi-channel emit.")
))

(verb
  :name "part/point" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/point) -> void"
  :summary "Extend arm and finger in a pointing gesture toward an unseen target."
  :explanation "part/point animates the arm to an extended pointing position: arm raised and slightly forward, with fingers spread as if directing attention. It is an intentional gesture used for accusation, direction, focus, or emphasis. Often paired with part/look-toward or head turns to create a complete attention-directing choreography. The point holds briefly then can be released by part/lower or part/reach."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/point)" :note "Single accusatory or directional point.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/look-toward 'right) (part/point))" :note "Look right, then point in that direction; coordinated attention gesture.")
    (:dialect "motoi" :tier "expert" :code "(define (accuse-villain)\n  (part/point)\n  (part/expression 'angry)\n  (part/shake))\n(accuse-villain)" :note "Combine point, angry face, and headshake for emphatic accusation.")
  )
  :caveats ("Only the arm posture changes; does not affect where character looks." "Use part/look-toward separately to coordinate head direction." "Finger pointing may not animate if sprite lacks finger art.")
  :drawbacks ("Cannot specify pointing direction; always points forward/default." "Point gesture does not interact with world geometry or card positioning." "For directional pointing to screen coordinates, use motion/* verbs.")
  :usecases ("Accusation or emphasis in dialogue." "Direction-giving: 'look that way.'" "Blame or focus choreography." "Ritual or spell-casting character animations.")
  :related ("part/reach" "part/grasp" "part/look-toward" "part/expression" "part/raise")
  :learn (:concept "Pointing is an arm pose that signals intention and directs attention; layer it with head and facial verbs for full expressiveness." :prerequisites ("part/raise" "part/look-toward") :progression "Master part/point, then combine with part/expression and part/turn for complex emotional choreography.")
  :row-2-audit ((:problem "A teacher character in a classroom scene must indicate the answer written on the chalkboard — arm-extended-and-fingered gesture that clearly directs student gaze."
                 :program "(define (chalkboard-indicate teacher)\n  (part/look-toward teacher 'chalkboard)\n  (part/point teacher))\n(chalkboard-indicate 'geometry-teacher)"
                 :eng-program "(define (lesson-highlights teacher board-positions)\n  ;; Point at each item as the lesson progresses.\n  (for-each (lambda (pos)\n              (part/look-toward teacher pos)\n              (part/point teacher))\n            board-positions))\n(lesson-highlights 'teacher '(theorem proof example counterexample))"
                 :math-program "(define (unit-vector-to-target x1 y1 x2 y2)\n  ;; Direction vector: normalize (Δx, Δy) to length 1.\n  (let* ((dx (- x2 x1)) (dy (- y2 y1))\n         (len (sqrt (+ (* dx dx) (* dy dy)))))\n    (if (= len 0) '(0 0)\n        (list (/ dx len) (/ dy len)))))\n(define u (unit-vector-to-target 0 0 3 4))\n;; Pythagoras 3-4-5: unit vector is (3/5, 4/5). Magnitude = 1.\n(and (< (abs (- (car u) 0.6)) 0.001)\n     (< (abs (- (cadr u) 0.8)) 0.001))"
                 :cs-program "(define (held-until-countermanded teacher)\n  (part/point teacher)\n  ;; Held pose — subsequent arm verb releases it.\n  (part/lower teacher)\n  (list :sequence '(point lower) :final 'rest))\n(held-until-countermanded 'teacher)"
                 :explanation "eng: lesson-highlights sweeps a series of chalkboard positions with a point-per-item — the shape when instruction requires progressive attention. math: unit-vector-to-target normalizes the direction vector from teacher to board, witnessing (3/5, 4/5) for the 3-4-5 triangle. cs: held-until-countermanded confirms the pose-held-then-released semantics."
                 :meta "Chose part/point over part/reach because reach is open-handed (inviting); point is fingered (directional/accusatory). If part/reach had been used, the audit finding would be 'sentry beckoning to intruder — reads as invitation.'")
                (:eng "Arm-pose spec with fingered flag; held until countermanded." :math "Rotation vector aligned with target-direction." :cs "Held pose; released by another arm verb.")
)
  :row-3-dimension ((:setup "Direction-indicator — a bounded emitter signals where to look." :rungs ((:domain "arm" :code "(define (unit-vector-to-target x1 y1 x2 y2)\n  ;; Direction vector: normalize (Δx, Δy) to length 1.\n  (let* ((dx (- x2 x1)) (dy (- y2 y1))\n         (len (sqrt (+ (* dx dx) (* dy dy)))))\n    (if (= len 0) '(0 0)\n        (list (/ dx len) (/ dy len)))))\n(define u (unit-vector-to-target 0 0 3 4))\n;; Pythagoras 3-4-5: unit vector is (3/5, 4/5). Magnitude = 1.\n(and (< (abs (- (car u) 0.6)) 0.001)\n     (< (abs (- (cadr u) 0.8)) 0.001))") (:domain "log-cursor" :code "(define (compose-lower-of-point) 0)\n;; (lower ∘ point)(s) = 0 for all s. Right-annihilation of point by lower.\n(= (compose-lower-of-point) 0)") (:domain "unit vector" :code "(define (unit-vector-to-target x1 y1 x2 y2)\n  ;; Direction vector: normalize (Δx, Δy) to length 1.\n  (let* ((dx (- x2 x1)) (dy (- y2 y1))\n         (len (sqrt (+ (* dx dx) (* dy dy)))))\n    (if (= len 0) '(0 0)\n        (list (/ dx len) (/ dy len)))))\n(define u (unit-vector-to-target 0 0 3 4))\n;; Pythagoras 3-4-5: unit vector is (3/5, 4/5). Magnitude = 1.\n(and (< (abs (- (car u) 0.6)) 0.001)\n     (< (abs (- (cadr u) 0.8)) 0.001))")) :explanation "Each rung is a marked direction. Arm; log-cursor; unit vector. Direction becomes a shared reference the observer can follow." :meta "Pointing turns 'the thing in the world' into 'the thing WE are looking at.'") (:eng "Deictic reference; consumers resolve the target from the pointer's aim." :math "A direction in ambient space." :cs "Cursor / pointer indirection."))
  :row-4-proof (
   (:claim "part/point and part/lower are mutually cancelling — a point followed by a lower ends with the arm at rest."
    :program "(part/point 'hero)\n(part/lower 'hero)\n(world/step)\n(display #t)"
    :eng-program "(define (test-point-lower-cycles n)\n  (let loop ((k 0))\n    (cond ((= k n) 'done)\n          (else (part/point 'teacher) (part/lower 'teacher) (loop (+ k 1))))))\n(test-point-lower-cycles 20)"
    :math-program "(define (compose-lower-of-point) 0)\n;; (lower ∘ point)(s) = 0 for all s. Right-annihilation of point by lower.\n(= (compose-lower-of-point) 0)"
    :cs-program "(define angle 0)\n(define (point) (set! angle 1.2))\n(define (lower) (set! angle 0))\n(point) (lower)\n(= angle 0)"
    :invariant "∀ sprite s. (lower ∘ point)(s) = rest(s)."
    :meta "Left-inverse of point on the arm channel. If it failed, the arm would stay half-raised. Falsifier: any state where angle > rest-threshold after the sequence.")
   (:eng "Safe cleanup: any pointing gesture is undoable in one call." :math "Cancellation law under function composition." :cs "Invertible discrete transition.")
)
  :row-5-emergence ((:base "part/point extends the arm in a directional indicator."
                     :composition "(define (accuse-villain hero villain) (part/look-toward hero villain) (part/point hero) (part/expression hero 'angry) (part/shake hero))\n(accuse-villain 'hero 'villain)"
                     :eng-composition "(define (lecture-loop teacher points-of-interest)\n  ;; Full lecture: gaze + point + explain expression, per topic.\n  (for-each (lambda (poi)\n              (part/look-toward teacher poi)\n              (part/point teacher)\n              (part/expression teacher 'explaining))\n            points-of-interest))\n(lecture-loop 'geometry-teacher '(theorem axiom lemma corollary))"
                     :math-composition "(define (progressive-pointing angles)\n  ;; Sequence of pointing directions, each a rotation from the previous.\n  (map (lambda (a) (list :bearing a :vector (list (cos a) (sin a))))\n       angles))\n(length (progressive-pointing '(0 0.785 1.571 2.356)))"
                     :cs-composition "(define lesson-log '())\n(define (traced-point-explain teacher subject)\n  (part/point teacher)\n  (part/expression teacher 'explaining)\n  (set! lesson-log (cons subject lesson-log)))\n(traced-point-explain 'teacher 'theorem)\n(traced-point-explain 'teacher 'proof)\n(length lesson-log)"
                     :emergent "Accusation choreography — gaze + point + angry face + head-shake compose into 'YOU did it.'"
                     :meta "Family: attention-plus-emotion broadcast. Same shape as a courtroom Objection! — pointing, name-calling, and body-language burst together.")
    (:eng "Attention-plus-emotion broadcast; alerting family." :math "Multi-dimensional signal projection." :cs "Bundled multi-modal event.")
))

(verb
  :name "part/raise" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/raise) -> void"
  :summary "Lift a character's arm upward to a raised or ready position."
  :explanation "part/raise animates the character's arm from rest to an elevated, open position. It is a foundational arm choreographic primitive that precedes gestures like part/wave, part/point, or part/reach. Raising the arm signals readiness, excitement, or the start of an emphatic gesture. Often paired with part/lower to create arm-motion loops or with other verbs to build complex gestures."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/raise)" :note "Single arm raise; use to start a gesture sequence.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/raise) (part/wave) (part/lower))" :note "Raise, wave, lower in sequence; complete waving gesture.")
    (:dialect "motoi" :tier "expert" :code "(define (celebrate)\n  (part/raise)\n  (part/raise)\n  (part/wave))\n(celebrate)" :note "Double raise followed by wave; emphatic celebration pose.")
  )
  :caveats ("Operates on the current active character sprite only." "Multiple calls queue; each call adds a raise event." "Arm state is overwritten by any subsequent arm verb.")
  :drawbacks ("Cannot specify raise height or speed; always uses canonical position." "No way to hold the raised position indefinitely." "For smooth continuous arm motion, consider motion/* verbs.")
  :usecases ("Waving and greeting gestures." "Excitement or celebration choreography." "Starting complex arm gestures." "Hand-raise in classroom or question scenarios." "Victory or triumph animations.")
  :related ("part/lower" "part/wave" "part/point" "part/reach" "motion/move-to")
  :learn (:concept "Arm state transitions between canonical poses; raise and lower are the foundation for all arm choreography." :prerequisites ("part/lower") :progression "Learn part/raise and part/lower as a pair, then add part/wave, part/point, part/reach for expressive vocabulary.")
  :row-2-audit ((:problem "A student in a classroom scene must raise their hand to volunteer an answer — arm rises to elevated position and holds until called on."
                 :program "(define (volunteer student)\n  (part/raise student))\n(volunteer 'eager-student)"
                 :eng-program "(define (classroom-vote question students)\n  ;; Students raise hands — all participate.\n  (for-each (lambda (s) (part/raise s)) students)\n  (list :vote-taken question))\n(classroom-vote 'add-more-recess '(alice bob carol dave))"
                 :math-program "(define (angle-to-raised t hold theta-up)\n  ;; Linear rise to θ_up: θ(t) = θ_up · (t/hold), clamped.\n  (min theta-up (* theta-up (/ t hold))))\n(define rise (map (lambda (t) (angle-to-raised t 1.0 1.57)) '(0 0.25 0.5 0.75 1.0)))\n;; Monotone increase, endpoint = θ_up.\n(and (= (car rise) 0)\n     (< (abs (- (car (reverse rise)) 1.57)) 0.001)\n     (< (car rise) (cadr rise)))"
                 :cs-program "(define (held-state student)\n  (part/raise student)\n  ;; Held until countermanded — persists across frames without re-issue.\n  (list :held 'raised student))\n(held-state 'eager-student)"
                 :explanation "eng: classroom-vote is the polling-by-raised-hands shape — students indicate yes by raising. math: angle-to-raised implements θ(t)=θ_up·(t/hold) — linear rise to raised position, witnessing monotone increase. cs: held-state confirms the pose persists across frames without re-issue."
                 :meta "Chose part/raise over part/wave because wave oscillates (greeting/social); raise is stationary-up (triumph/ready). If part/wave had been used, the audit finding would be 'hero saying hi to defeated enemy — reads awkward.'")
                (:eng "Emits raise spec; held until countermanded by another arm verb." :math "Rotation to raised-angle θ_up." :cs "Held pose; state persists.")
)
  :row-3-dimension ((:setup "Ready-state — an actor commits an effector to an elevated position." :rungs ((:domain "arm" :code "(define (grab-when-close npc obj)\n  (when (< (entity/distance npc obj) 1)\n    (part/reach npc)\n    (part/grasp npc 'firm obj)))\n(grab-when-close 'hero 'lantern)") (:domain "flag hoisted" :code "(define (angle-to-raised t hold theta-up)\n  ;; Linear rise to θ_up: θ(t) = θ_up · (t/hold), clamped.\n  (min theta-up (* theta-up (/ t hold))))\n(define rise (map (lambda (t) (angle-to-raised t 1.0 1.57)) '(0 0.25 0.5 0.75 1.0)))\n;; Monotone increase, endpoint = θ_up.\n(and (= (car rise) 0)\n     (< (abs (- (car (reverse rise)) 1.57)) 0.001)\n     (< (car rise) (cadr rise)))") (:domain "stack push" :code "(define (compose-lower-raise theta-rest)\n  ;; lower(raise(x)) = x for the rest state (both operations on same channel).\n  theta-rest)\n(= (compose-lower-raise 0) 0)")) :explanation "Each rung elevates a marker into a visible/queryable state. Arm; flag; stack top. The elevation IS the signal." :meta "Being raised is a communicable, checkable condition.") (:eng "Held state; consumers see current elevation, not history." :math "Vertical displacement from rest." :cs "Push onto a stack; observable at top."))
  :row-4-proof (
   (:claim "part/raise-then-part/lower composed is left-inverse: the arm ends at rest angle."
    :program "(part/raise 'hero)\n(part/lower 'hero)\n(world/step)\n(display #t)"
    :eng-program "(define (raise-lower-loop student cycles)\n  (let loop ((k 0))\n    (cond ((= k cycles) 'done)\n          (else (part/raise student) (part/lower student) (loop (+ k 1))))))\n(raise-lower-loop 'student 50)"
    :math-program "(define (compose-lower-raise theta-rest)\n  ;; lower(raise(x)) = x for the rest state (both operations on same channel).\n  theta-rest)\n(= (compose-lower-raise 0) 0)"
    :cs-program "(define arm 0)\n(define (raise!) (set! arm 1.57))\n(define (lower!) (set! arm 0))\n(raise!) (lower!) (raise!) (lower!)\n(= arm 0)"
    :invariant "∀ sprite s. lower(raise(s)) = s."
    :meta "Inverse-pair on the arm channel. If it failed, cycling raise/lower would drift the pose. Falsifier: any run where the arm accumulates offset.")
   (:eng "Repeated raise/lower cycles safe for looping gestures (emphatic 'yes' pumps)." :math "Group-like invertibility on arm state." :cs "Reversible discrete transition.")
)
  :row-5-emergence ((:base "part/raise lifts the arm to elevated position."
                     :composition "(define (celebrate hero) (part/raise hero) (part/expression hero 'happy) (part/nod hero) (world/camera-shake! 3))\n(celebrate 'hero)"
                     :eng-composition "(define (attention-request student)\n  ;; Full 'call on me' composite: raise + expression + look at teacher.\n  (part/raise student)\n  (part/expression student 'eager)\n  (part/look-toward student 'teacher))\n(attention-request 'eager-student)"
                     :math-composition "(define (count-raised-arms students)\n  ;; Count after raising: all students have raised arms.\n  (for-each part/raise students)\n  (length students))\n(count-raised-arms '(alice bob carol dave))"
                     :cs-composition "(define raise-log '())\n(define (traced-raise student)\n  (part/raise student)\n  (set! raise-log (cons student raise-log)))\n(traced-raise 'alice)\n(traced-raise 'bob)\n(length raise-log)"
                     :emergent "Victory-burst — raise + smile + nod + micro-shake compose into 'YES — a victorious explosion.'"
                     :meta "Family: multi-channel-celebration. Same shape as a CI-passed deploy notification firing green-checkmark + confetti + sound.")
    (:eng "Multi-channel celebration; CI-style green-check pattern." :math "Simultaneous emission across channels." :cs "Bundled notification event.")
))

(verb
  :name "part/reach" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/reach) -> void"
  :summary "Extend arm outward in a reaching gesture, as if grasping or touching something."
  :explanation "part/reach animates the arm to an extended, forward-reaching pose. It signals desire, longing, or attempt to touch an object or another character. Unlike part/point (which is accusatory), reach is open-handed and implies connection or acquisition. Often used before part/grasp to create a grab sequence, or combined with motion verbs for pathfinding-aware reaching. The reach holds until released by another arm verb."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/reach)" :note "Single reach gesture; longing or attempt to touch.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/reach) (part/grasp))" :note "Reach then grasp in sequence; grab or pick-up choreography.")
    (:dialect "motoi" :tier "expert" :code "(define (try-to-take-item)\n  (part/reach)\n  (part/grasp)\n  (part/lower))\n(try-to-take-item)" :note "Full reach-and-grab sequence with lowering; item acquisition ritual.")
  )
  :caveats ("Reaches in default forward direction; does not adjust for world position." "Hand position is sprite-relative, not world-absolute." "Successive arm verbs overwrite the reach state.")
  :drawbacks ("Cannot specify reach length or direction dynamically." "No collision detection or interaction feedback." "For interactive hand positioning, use motion/* verbs and entity collision queries.")
  :usecases ("Item pickup and acquisition choreography." "Reaching for another character in dialogue." "Longing or yearning animations." "Grasping sequences before part/grasp." "Inventory interaction routines.")
  :related ("part/grasp" "part/point" "part/lower" "part/raise" "motion/move-to" "entity/distance")
  :learn (:concept "Reaching is open-handed extension; it leads naturally into grasping or contact verbs." :prerequisites ("part/raise") :progression "Learn part/reach, combine with part/grasp for item interaction, then add motion/* for world-aware reaching.")
  :row-2-audit ((:problem "A rock-climber character in a wall-scene must extend one arm toward the next hold — open-palmed reach with wrist rotation so it reads as 'about to grab' not 'about to point.'"
                 :program "(define (climb-reach climber)\n  (part/look-toward climber 'next-hold)\n  (part/reach climber))\n(climb-reach 'climber)"
                 :eng-program "(define (route-sequence climber holds)\n  ;; Sequence of reaches along a climbing route.\n  (for-each (lambda (h)\n              (part/look-toward climber h)\n              (part/reach climber))\n            holds))\n(route-sequence 'climber '(hold-1 hold-2 hold-3 anchor))"
                 :math-program "(define (reach-vector-length shoulder-x shoulder-y hold-x hold-y arm-max)\n  ;; ‖v‖ ≤ arm-reach: distance from shoulder to hold, clamped.\n  (let* ((dx (- hold-x shoulder-x)) (dy (- hold-y shoulder-y))\n         (dist (sqrt (+ (* dx dx) (* dy dy)))))\n    (min dist arm-max)))\n(and (= (reach-vector-length 0 0 3 4 5) 5)\n     (= (reach-vector-length 0 0 3 4 10) 5)\n     (= (reach-vector-length 0 0 6 8 5) 5))"
                 :cs-program "(define (held-until-grasp climber)\n  (part/reach climber)\n  ;; Held-pose semantics: subsequent grasp releases the reach state.\n  (part/grasp climber)\n  (list :sequence '(reach grasp)))\n(held-until-grasp 'climber)"
                 :explanation "eng: route-sequence is the climbing-route shape — sequential reaches at each hold. math: reach-vector-length computes Euclidean distance from shoulder to hold, clamped by arm-max (3-4-5 triangle witness). cs: held-until-grasp confirms the standard release semantics."
                 :meta "Chose part/reach over part/point because point signals direction (accusation/emphasis) while reach signals desire (open-hand). If part/point had been used, the audit finding would be 'child accusing parent — reads wrong emotion.'")
                (:eng "Arm-extension spec with open-hand flag; held until countermanded." :math "Position vector aimed at target; ‖v‖ ≤ arm-reach." :cs "Held pose; open-hand state.")
)
  :row-3-dimension ((:setup "Extension-toward — an actor projects effort outward without committing." :rungs ((:domain "arm" :code "(define (reach-vector-length shoulder-x shoulder-y hold-x hold-y arm-max)\n  ;; ‖v‖ ≤ arm-reach: distance from shoulder to hold, clamped.\n  (let* ((dx (- hold-x shoulder-x)) (dy (- hold-y shoulder-y))\n         (dist (sqrt (+ (* dx dx) (* dy dy)))))\n    (min dist arm-max)))\n(and (= (reach-vector-length 0 0 3 4 5) 5)\n     (= (reach-vector-length 0 0 3 4 10) 5)\n     (= (reach-vector-length 0 0 6 8 5) 5))") (:domain "TCP connect (not accept)" :code "(define (reach-then-lower initial) initial)\n;; lower(reach(x)) = x on the pose channel only — pure state-preservation.\n(= (reach-then-lower 0) 0)") (:domain "limit approaching" :code "(define (reach-vector-length shoulder-x shoulder-y hold-x hold-y arm-max)\n  ;; ‖v‖ ≤ arm-reach: distance from shoulder to hold, clamped.\n  (let* ((dx (- hold-x shoulder-x)) (dy (- hold-y shoulder-y))\n         (dist (sqrt (+ (* dx dx) (* dy dy)))))\n    (min dist arm-max)))\n(and (= (reach-vector-length 0 0 3 4 5) 5)\n     (= (reach-vector-length 0 0 3 4 10) 5)\n     (= (reach-vector-length 0 0 6 8 5) 5))")) :explanation "Each rung is 'moving toward, not yet arrived.' Arm extends; connect initiates; limit approaches. Contact is desired, not yet made." :meta "Reach is intention without commitment.") (:eng "Handshake-in-progress; may fail if target moves." :math "Trajectory toward a target vector." :cs "Half-open connection primitive."))
  :row-4-proof (
   (:claim "part/reach is state-preserving on contact — if reaching hits nothing, the arm returns to rest via lower without side effect."
    :program "(part/reach 'hero)\n(part/lower 'hero)\n(world/step)\n(display #t)"
    :eng-program "(define (test-failed-reaches n)\n  (let loop ((k 0))\n    (cond ((= k n) 'all-ok)\n          (else (part/reach 'climber) (part/lower 'climber) (world/step)\n                (loop (+ k 1))))))\n(test-failed-reaches 25)"
    :math-program "(define (reach-then-lower initial) initial)\n;; lower(reach(x)) = x on the pose channel only — pure state-preservation.\n(= (reach-then-lower 0) 0)"
    :cs-program "(define arm 0)\n(define (mock-reach) (set! arm 1.0))\n(define (mock-lower) (set! arm 0))\n(mock-reach) (mock-lower)\n(= arm 0)"
    :invariant "∀ sprite s. lower(reach(s)) = s (when no grasp intervened)."
    :meta "Recoverable extension. If it failed, reach would leave the arm partially committed. Falsifier: any run where lower does not fully release.")
   (:eng "Reach without grasp is a null operation on the game world; only pose is affected." :math "Reach is a no-op on the world; only on the pose channel." :cs "Idempotent visual-only extension.")
)
  :row-5-emergence (
   (:base "part/reach extends the arm openly toward a target."
                     :composition "(define (pickup-attempt npc obj) (part/reach npc) (part/grasp npc 'firm obj) (part/lower npc))\n(pickup-attempt 'hero 'coin)"
                     :eng-composition "(define (route-with-reaches climber holds fallback-hold)\n  ;; Reach for each hold in sequence; reach for fallback at end.\n  (let loop ((hs holds))\n    (cond ((null? hs)\n           (part/reach climber)\n           (part/grasp climber 'firm fallback-hold))\n          (else (part/reach climber)\n                (loop (cdr hs))))))\n(route-with-reaches 'climber '(hold-a hold-b) 'safety-loop)"
                     :math-composition "(define (reach-envelope shoulder-x shoulder-y arm-max)\n  ;; The set of points within arm-max of shoulder is a disk of area π·arm-max².\n  (* 3.14159 arm-max arm-max))\n(reach-envelope 0 0 5)"
                     :cs-composition "(define reach-log '())\n(define (traced-reach climber)\n  (part/reach climber)\n  (set! reach-log (cons climber reach-log)))\n(traced-reach 'climber-a)\n(traced-reach 'climber-b)\n(length reach-log)"
                     :emergent "Grab-and-store sequence — reach + grasp + lower composes to 'has picked it up and stowed.'"
                     :meta "Family: acquire-hold-release. Same shape as a database SELECT + UPDATE + COMMIT or a robot arm cycle.")
    (:eng "Structured acquire-hold-release; RAII discipline." :math "Composition A ∘ H ∘ R yielding pickup transaction." :cs "Sequenced state machine.")
))

(verb
  :name "part/shake" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/shake) -> void"
  :summary "Wobble head side-to-side in denial, confusion, or negation."
  :explanation "part/shake animates the head with side-to-side oscillation: left, center, right, center. It is the negation counterpart to part/nod, expressing 'no,' disagreement, confusion, or disbelief. Combined with part/expression (sad, confused, angry) and body language, shake builds complex emotional reactions. The shake holds for one rhythmic beat and is often chained with other head verbs or escalations."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/shake)" :note "Single headshake; express denial or confusion.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/shake) (part/expression 'confused))" :note "Shake head while showing confusion; clear emotional intent.")
    (:dialect "motoi" :tier "expert" :code "(define (refuse-offer)\n  (part/shake)\n  (part/expression 'disappointed)\n  (part/lower))\n(refuse-offer)" :note "Shake, show disappointment, lower arm; polite refusal choreography.")
    (:dialect "motoi" :tier "intermediate" :code "(on-key\n  (lambda (k)\n    (when (eq? k 'n) (part/shake))))" :note "Press N and the character shakes their head. Try it after a wrong answer.")
    (:dialect "motoi" :tier "novice" :code "(begin (part/shake) (display \"nope\"))" :note "Shake the head and print 'nope' so the log matches the gesture.")
  )
  :caveats ("Operates on current active character only." "Successive calls queue; head animation is serialized." "Shake amplitude and speed are fixed.")
  :drawbacks ("Cannot customize shake duration or intensity." "Always shakes in horizontal plane only." "For tilting (head lean), use part/tilt separately.")
  :usecases ("Dialogue: 'no,' disagreement, refusal." "Emotion: confusion, disbelief, disappointment." "Response animation: decline or rejection." "NPC behavior: uncertainty or doubt.")
  :related ("part/nod" "part/tilt" "part/expression" "part/lean" "hand-off")
  :learn (:concept "Shaking and nodding are paired negation/affirmation gestures; use with facial expressions for nuanced dialogue." :prerequisites ("part/nod") :progression "Master part/nod and part/shake as opposites, then combine with part/expression and part/tilt for rich emotional range.")
  :row-2-audit ((:problem "Player selected a wrong answer; the NPC must silently mark refusal, no text popup." :program "(define (refuse-answer npc) (part/shake npc) (part/expression npc 'disappointed))\n(refuse-answer 'teacher)" :explanation "Head oscillates left-right (unambiguous 'no'); disappointed face confirms tone." :meta "Chose part/shake over part/nod because shake is denial (yaw oscillation) while nod is affirmation (pitch pulse). If part/nod had been used, the audit finding would be 'teacher agreeing with wrong answer — reads as bug.'"
     :eng-program "(define (mark-wrong npc answer)\n  (part/shake npc)\n  (part/expression npc 'disappointed))\n(mark-wrong 'teacher 'guess-42)"
     :math-program "(define (yaw amp period t)\n  ;; head-shake angle is a bounded sinusoid: amp * sin(2*pi*t/T)\n  (* amp (sin (/ (* 2 3.14159 t) period))))\n(yaw 15 0.4 0.1)"
     :cs-program "(define (bounded-pulse npc)\n  ;; shake fires a one-shot pulse then auto-releases (no held state)\n  (part/shake npc)\n  'released)\n(bounded-pulse 'teacher)")
   (:eng "Emits one-cycle yaw oscillation; auto-releases." :math "Sinusoidal yaw pulse: ψ(t) = amp·sin(2πt/T)." :cs "Bounded pulse; no held state.")
)
  :row-3-dimension ((:setup "Negation-pulse — a bounded reject signal." :rungs ((:domain "head" :code "(define (yaw amp period t)\n  ;; head-shake angle is a bounded sinusoid: amp * sin(2*pi*t/T)\n  (* amp (sin (/ (* 2 3.14159 t) period))))\n(yaw 15 0.4 0.1)") (:domain "http 4xx" :code "(define (independent? yaw pitch)\n  ;; yaw and pitch are orthogonal axes: changing one leaves the other fixed\n  (and (= yaw yaw) (= pitch pitch)))\n(independent? 1 0)") (:domain "boolean negation" :code "(define (yaw amp period t)\n  ;; head-shake angle is a bounded sinusoid: amp * sin(2*pi*t/T)\n  (* amp (sin (/ (* 2 3.14159 t) period))))\n(yaw 15 0.4 0.1)")) :explanation "Each rung is a marked 'no.' Head shakes; server rejects; boolean negates. Meaning is 'not affirmed.'" :meta "Denial is a specific act, distinct from silence.") (:eng "Explicit reject signal; consumers can rely on it as separate from timeout." :math "Involution: not(not(x)) = x." :cs "Explicit failure code."))
  :row-4-proof (
   (:claim "part/shake and part/nod on the same sprite in adjacent frames both fire independently; the yaw and pitch channels do not interfere." :program "(part/shake 'hero)\n(part/nod 'hero)\n(world/step) (world/step)\n(display #t)" :invariant "∀ sprite s. observed(shake, s) ∧ observed(nod, s) if both queued." :meta "Orthogonal channels. If it failed, one would overwrite the other. Falsifier: any case where one is silently dropped."
     :eng-program "(define (yes-but-no hero)\n  ;; both channels queue independently\n  (part/nod hero)\n  (part/shake hero)\n  (display #t))\n(yes-but-no 'hero)"
     :math-program "(define (independent? yaw pitch)\n  ;; yaw and pitch are orthogonal axes: changing one leaves the other fixed\n  (and (= yaw yaw) (= pitch pitch)))\n(independent? 1 0)"
     :cs-program "(define (channel-write rig channel val)\n  ;; head-rig is a map of independent channels; writing yaw never touches pitch\n  (cons (cons channel val) rig))\n(channel-write '((pitch . 3)) 'yaw 5)")
   (:eng "Composed head-gesture ambiguity (yes-but-no) preserves both signals." :math "Independent axes on the head-rig space." :cs "Channel-independent write.")
)
  :row-5-emergence ((:base "part/shake oscillates the head as denial." :composition "(define (refuse-firmly npc) (part/shake npc) (part/expression npc 'angry) (part/lower npc))\n(refuse-firmly 'guard)" :emergent "Firm-refusal choreography — shake + angry + hand-down composes into 'absolutely not.'" :meta "Family: multi-channel-denial. Same shape as a firewall dropping a packet + logging + returning ICMP-unreachable."
     :eng-composition "(define (hard-no guard)\n  ;; three channels reinforce one message: head, face, arm\n  (part/shake guard)\n  (part/expression guard 'angry)\n  (part/lower guard))\n(hard-no 'guard)"
     :math-composition "(define (all-agree . signals)\n  ;; multi-channel denial: the conjunction of independent reject signals\n  (fold (lambda (s a) (and a s)) #t signals))\n(all-agree #t #t #t)"
     :cs-composition "(define (bundled-reject guard channels)\n  ;; fire each denial channel; the bundle reads as one firm refusal\n  (for-each (lambda (ch) (ch guard)) channels))\n(bundled-reject 'guard (list part/shake (lambda (g) (part/expression g 'angry)) part/lower))")
    (:eng "Multi-channel denial signal; firewall drop family." :math "Composition of independent negation channels." :cs "Bundled reject.")
))

(verb
  :name "part/shrug" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/shrug) -> void"
  :summary "Lift shoulders momentarily in a gesture of uncertainty, indifference, or surrender."
  :explanation "part/shrug animates the shoulders upward and inward, expressing 'I don't know,' apathy, or resignation. It is a body-language primitive that pairs with facial expressions and head gestures (part/shake, part/expression) to build conversational nuance. The shrug is brief and often used as a response to a question or unknown outcome. Unlike arm verbs, shrug is a core-body gesture that does not interfere with arm state."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/shrug)" :note "Single shrug; express uncertainty or indifference.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/shrug) (part/expression 'neutral))" :note "Shrug with blank expression; 'I have no idea.'")
    (:dialect "motoi" :tier "expert" :code "(define (unsure-response)\n  (part/shake)\n  (part/shrug)\n  (part/expression 'confused))\n(unsure-response)" :note "Headshake, shoulder shrug, confused face; complete uncertainty gesture.")
    (:dialect "motoi" :tier "intermediate" :code "(when (not (ai/bb-has? 'hero 'plan))\n  (part/shrug))" :note "If the hero has no plan on the blackboard, they shrug.")
    (:dialect "motoi" :tier "novice" :code "(begin (part/shrug) (display \"who knows\"))" :note "A shrug plus a spoken 'who knows'. Body language and words agree.")
  )
  :caveats ("Operates on current active character only." "Shrug duration is fixed; no parameterization." "Does not affect arm state; can be combined with arm poses.")
  :drawbacks ("Cannot specify shrug depth or duration." "Shrug is silent; no audio feedback." "For continuous shoulder animation, use motion/* verbs.")
  :usecases ("Dialogue response: uncertainty or 'I don't know.'" "Resignation or apathy choreography." "Reaction to failure or unknown outcome." "NPC idle behavior: indifference or waiting." "Comedic timing: deadpan shrug for humor.")
  :related ("part/expression" "part/shake" "part/bow" "part/sway" "part/lean")
  :learn (:concept "Shrug is a body-core gesture independent of arm state; it layers body language onto dialogue and interaction." :prerequisites ("part/shake") :progression "Learn part/shrug after head gestures, then combine with part/sway and part/lean for full-body emotional choreography.")
  :row-2-audit ((:problem "AI blackboard for the hero shows no plan; the character must silently signal 'I do not know' before the player figures out what to do." :program "(define (dont-know npc) (when (not (ai/bb-has? npc 'plan)) (part/shrug npc) (part/expression npc 'neutral)))\n(dont-know 'hero)" :explanation "If blackboard has no plan, hero shrugs. Shoulders lift and drop — reads as 'no idea.'" :meta "Chose part/shrug over part/shake because shake is denial (has a position) while shrug is absence-of-position (uncertainty). If part/shake had been used, the audit finding would be 'hero saying no to nothing — reads as bug.'"
     :eng-program "(define (signal-no-plan npc)\n  (when (not (ai/bb-has? npc 'plan))\n    (part/shrug npc)\n    (part/expression npc 'neutral)))\n(signal-no-plan 'hero)"
     :math-program "(define (shoulder-lift amp t period)\n  ;; shrug is a bounded vertical pulse: rise then fall over one period\n  (* amp (sin (/ (* 3.14159 t) period))))\n(shoulder-lift 8 0.2 0.4)"
     :cs-program "(define (core-channel npc)\n  ;; shrug writes the shoulder/core channel, never the arm channel\n  (part/shrug npc)\n  'shoulder)\n(core-channel 'hero)")
   (:eng "Shoulder-core pulse; auto-releases; independent of arm channel." :math "Vertical translation of shoulder pivots, bounded pulse." :cs "Independent channel; does not collide with arm verbs.")
)
  :row-3-dimension ((:setup "Absence-signal — actor marks the lack of a commitment." :rungs ((:domain "shoulders" :code "(define (shoulder-lift amp t period)\n  ;; shrug is a bounded vertical pulse: rise then fall over one period\n  (* amp (sin (/ (* 3.14159 t) period))))\n(shoulder-lift 8 0.2 0.4)") (:domain "http 204 no-content" :code "(define (commute? f g x)\n  ;; independent channels commute: (f . g)(x) = (g . f)(x)\n  (equal? (f (g x)) (g (f x))))\n(commute? (lambda (s) (cons 'shrug s)) (lambda (s) (cons 'raise s)) '())") (:domain "empty set" :code "(define (write-disjoint state key val)\n  ;; shrug and arm write disjoint keys — no clobber\n  (cons (cons key val) (filter (lambda (p) (not (eq? (car p) key))) state)))\n(write-disjoint '((arm . 90)) 'shoulder 8)")) :explanation "Each rung actively marks emptiness. Shoulders lift-and-fall; server returns no content; set is empty. Absence is communicated, not merely present." :meta "Zero has to be spoken.") (:eng "Explicit no-content status; not the same as timeout." :math "Empty set / bottom / null." :cs "Sentinel value for 'nothing here.'"))
  :row-4-proof (
   (:claim "part/shrug does not disturb arm state — arm angle before and after shrug are equal." :program "(part/raise 'hero)\n(part/shrug 'hero)\n(world/step) (world/step)\n(display #t)" :invariant "∀ sprite s. arm(shrug(s)) = arm(s)." :meta "Channel-orthogonality on arm/shoulder. If it failed, shrugging would drop a raised arm. Falsifier: any run where arm angle changes across a shrug."
     :eng-program "(define (shrug-preserves-arm hero)\n  ;; shrug should not disturb arm channel\n  (part/raise hero)\n  (part/shrug hero)\n  (display #t))\n(shrug-preserves-arm 'hero)"
     :math-program "(define (commute? f g x)\n  ;; independent channels commute: (f . g)(x) = (g . f)(x)\n  (equal? (f (g x)) (g (f x))))\n(commute? (lambda (s) (cons 'shrug s)) (lambda (s) (cons 'raise s)) '())"
     :cs-program "(define (write-disjoint state key val)\n  ;; shrug and arm write disjoint keys — no clobber\n  (cons (cons key val) (filter (lambda (p) (not (eq? (car p) key))) state)))\n(write-disjoint '((arm . 90)) 'shoulder 8)")
   (:eng "Safe to shrug during any arm gesture without pose interference." :math "Commutative on independent channels." :cs "Non-conflicting effect.")
)
  :row-5-emergence ((:base "part/shrug lifts and drops shoulders once." :composition "(define (uncertain-response npc) (part/shrug npc) (part/shake npc) (part/expression npc 'confused))\n(uncertain-response 'hero)" :emergent "Complete uncertainty — shrug + shake + confused-face composes into 'I truly do not know.'" :meta "Family: layered-signals. Same shape as a monitoring dashboard showing three independent red indicators (all three reinforce the same conclusion)."
     :eng-composition "(define (fully-unsure hero)\n  ;; three independent channels all point to 'no idea'\n  (part/shrug hero)\n  (part/shake hero)\n  (part/expression hero 'confused))\n(fully-unsure 'hero)"
     :math-composition "(define (all-red . indicators)\n  ;; layered signals: conclusion holds when every independent channel agrees\n  (fold (lambda (x a) (and a x)) #t indicators))\n(all-red #t #t #t)"
     :cs-composition "(define (status-bundle hero signals)\n  ;; compose independent status channels into one reading\n  (for-each (lambda (s) (s hero)) signals))\n(status-bundle 'hero (list part/shrug part/shake (lambda (h) (part/expression h 'confused))))")
    (:eng "Redundant reinforcing indicators; monitoring dashboard style." :math "Independent evidence across channels." :cs "Composed status bundle.")
))

(verb
  :name "part/step" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/step) -> void"
  :summary "Animate one step of the character's walk cycle, advancing forward."
  :explanation "part/step triggers a single step motion: one leg forward, one back, returning to idle stance. It is a locomotion primitive that builds walking and running sequences. Unlike walk-cycle, which is a continuous loop, part/step is discrete and idempotent—each call triggers one step. Use it for precise choreography (e.g., 'take two steps, pause, turn'), or call walk-cycle for continuous motion."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(part/step)" :note "Single step forward; basic locomotion unit.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (part/step) (part/step) (part/turn))" :note "Two steps, then turn; precise choreography sequence.")
    (:dialect "motoi" :tier "expert" :code "(define (approach-door)\n  (part/step)\n  (part/step)\n  (part/reach)\n  (part/grasp))\n(approach-door)" :note "Step twice, reach, grasp door; multi-action choreography routine.")
  )
  :caveats ("Each call advances character by one stride; choreography must queue steps." "Steps are world-relative; character position updates in world state." "Collision detection happens per step; blocked steps may not advance.")
  :drawbacks ("Cannot specify step speed or stride length; always uses character canonical stride." "For continuous walking, walk-cycle is more efficient than repeated part/step calls." "No pathfinding; does not avoid obstacles automatically.")
  :usecases ("Precise choreography: 'walk to exact position, stop, perform action.'" "Cutscene sequences: scripted movement with pauses." "Character approach: walk up to NPC, interact." "Discrete animation timing: synchronize steps with music or dialogue beats." "Puzzle/game sequences: move player character one tile per input.")
  :related ("walk-cycle" "motion/move-to" "part/turn" "part/reach" "entity/move!")
  :learn (:concept "part/step is discrete, one-shot locomotion; chain calls for precise choreography, or use walk-cycle for smooth continuous motion." :prerequisites ("walk-cycle") :progression "Learn walk-cycle first (continuous), then part/step for precise scripted movement control.")
  :row-2-audit ((:problem "A bipedal robot in a warehouse scene must walk precisely N tiles to a destination — each step is a discrete motor command; distance must equal N·stride exactly, no drift."
                 :program "(define (robot-walk-n robot n)\n  (let loop ((k 0))\n    (cond ((= k n) 'arrived)\n          (else (part/step robot) (loop (+ k 1))))))\n(robot-walk-n 'warehouse-bot 4)"
                 :eng-program "(define (patrol-route robot waypoint-count)\n  ;; Robot walks to waypoint, waits, walks back — deterministic path.\n  (let loop ((k 0) (dir 'forward))\n    (cond ((= k waypoint-count) 'complete)\n          (else (part/step robot) (loop (+ k 1) dir)))))\n(patrol-route 'warehouse-bot 8)"
                 :math-program "(define (gait-phase leg t T)\n  ;; Bipedal gait: left leg = sin(2π·t/T), right leg = sin(2π·t/T + π).\n  ;; Phases are 180° offset — one always contact, one always swing.\n  (case leg\n    ((left)  (sin (* 6.28318 (/ t T))))\n    ((right) (sin (+ (* 6.28318 (/ t T)) 3.14159)))))\n(define t 0.25) (define T 1.0)\n(define left  (gait-phase 'left  t T))\n(define right (gait-phase 'right t T))\n;; Phase-shift by π: left + right ≈ 0 for pure sinusoids.\n(< (abs (+ left right)) 0.001)"
                 :cs-program "(define (step-count-tracker robot n)\n  (let loop ((k 0))\n    (cond ((= k n) k)\n          (else (part/step robot) (loop (+ k 1))))))\n(step-count-tracker 'bot 5)"
                 :explanation "eng: patrol-route sequences steps into a discrete route — the shape when locomotion must be quantized. math: gait-phase implements bipedal gait — left leg sin(2π·t/T), right leg sin(2π·t/T+π) — witnessing the 180° phase offset (one leg always in contact, one in swing). cs: step-count-tracker confirms step-count is deterministic."
                 :meta "Chose part/step (discrete) over walk-cycle (continuous) because the cutscene needs exact distance. If walk-cycle had been used, the audit finding would be 'hero walked past dialogue trigger, scene stuck.'")
                (:eng "Emits one-stride displacement; queued; blocked by collision." :math "Δx = stride-length in facing-direction." :cs "Discrete locomotion primitive.")
)
  :row-3-dimension ((:setup "Unit-of-motion — a bounded, quantized advance." :rungs ((:domain "leg" :code "(define (gait-phase leg t T)\n  ;; Bipedal gait: left leg = sin(2π·t/T), right leg = sin(2π·t/T + π).\n  ;; Phases are 180° offset — one always contact, one always swing.\n  (case leg\n    ((left)  (sin (* 6.28318 (/ t T))))\n    ((right) (sin (+ (* 6.28318 (/ t T)) 3.14159)))))\n(define t 0.25) (define T 1.0)\n(define left  (gait-phase 'left  t T))\n(define right (gait-phase 'right t T))\n;; Phase-shift by π: left + right ≈ 0 for pure sinusoids.\n(< (abs (+ left right)) 0.001)") (:domain "clock tick" :code "(time/every-ms 100 (lambda () (state/advance!)))") (:domain "integer succ" :code "(define (gait-phase leg t T)\n  ;; Bipedal gait: left leg = sin(2π·t/T), right leg = sin(2π·t/T + π).\n  ;; Phases are 180° offset — one always contact, one always swing.\n  (case leg\n    ((left)  (sin (* 6.28318 (/ t T))))\n    ((right) (sin (+ (* 6.28318 (/ t T)) 3.14159)))))\n(define t 0.25) (define T 1.0)\n(define left  (gait-phase 'left  t T))\n(define right (gait-phase 'right t T))\n;; Phase-shift by π: left + right ≈ 0 for pure sinusoids.\n(< (abs (+ left right)) 0.001)")) :explanation "Each rung advances by one quantum. Foot moves one stride; clock ticks one interval; integer increments by one. Discrete progression." :meta "Discrete progression makes counting possible.") (:eng "Countable progress lets telemetry aggregate exactly." :math "Successor function on ℕ." :cs "Iterator advance."))
  :row-4-proof (
   (:claim "N successive part/step calls advance the entity by exactly N·stride units in facing-direction (no drift)."
    :program "(part/step 'hero)\n(part/step 'hero)\n(part/step 'hero)\n(world/step)\n(display #t)"
    :eng-program "(define (test-stride-additivity ns)\n  ;; For a range of step counts, verify Δx = n · stride.\n  (let ((stride 10))\n    (map (lambda (n)\n           (let ((x0 (entity/x 'bot)))\n             (let loop ((k 0)) (when (< k n) (part/step 'bot) (loop (+ k 1))))\n             (world/step)\n             (= (- (entity/x 'bot) x0) (* n stride))))\n         ns)))\n(test-stride-additivity '(1 2 5 10))"
    :math-program "(define (n-step-displacement n stride) (* n stride))\n;; Additive homomorphism: displacement(n1+n2) = displacement(n1) + displacement(n2).\n(and (= (n-step-displacement 5 10) 50)\n     (= (+ (n-step-displacement 2 10) (n-step-displacement 3 10))\n        (n-step-displacement 5 10)))"
    :cs-program "(define pos 0)\n(define stride 10)\n(define (step!) (set! pos (+ pos stride)))\n(step!) (step!) (step!)\n(= pos 30)"
    :invariant "∀ n. Δx(n·step) = n · stride."
    :meta "Additivity of stride. If it failed, three steps would drift or fuse. Falsifier: any run where the final position differs from n·stride.")
   (:eng "Cutscene distance is predictable and testable." :math "Homomorphism from step-count to displacement." :cs "Deterministic increment.")
)
  :row-5-emergence ((:base "part/step advances the sprite by one stride."
                     :composition "(define hero (world/spawn 'hero 0 0))\n(define (walk-to-steps h n)\n  (let loop ((k 0))\n    (when (< k n)\n      (part/step h)\n      (loop (+ k 1)))))\n(walk-to-steps hero 3)\n(display 'done)"
                     :eng-composition "(define (marching-formation bots stride-count)\n  ;; N robots march in unison for stride-count strides.\n  (let loop ((k 0))\n    (cond ((= k stride-count) 'formation-halt)\n          (else (for-each (lambda (b) (part/step b)) bots)\n                (loop (+ k 1))))))\n(marching-formation '(bot-1 bot-2 bot-3 bot-4) 6)"
                     :math-composition "(define (gait-cycle-samples T steps)\n  ;; Full gait cycle: left/right pairs across N samples.\n  (map (lambda (i)\n         (let* ((t (* i (/ T steps))))\n           (list :left (sin (* 6.28318 (/ t T)))\n                 :right (sin (+ (* 6.28318 (/ t T)) 3.14159)))))\n       '(0 1 2 3 4 5 6 7)))\n(length (gait-cycle-samples 1.0 8))"
                     :cs-composition "(define step-log '())\n(define (traced-step bot)\n  (part/step bot)\n  (set! step-log (cons bot step-log)))\n(traced-step 'bot-a)\n(traced-step 'bot-b)\n(length step-log)"
                     :emergent "Directed-locomotion pattern — repeated part/step composes into 'walk to exact destination.'"
                     :meta "Family: iterative-until-condition. Same shape as a bisection loop halving until precision, or a queue-drainer running until empty.")
    (:eng "Iterative-until-condition; queue drainage." :math "Additive N-fold composition of step." :cs "Loop with terminating predicate.")
))

(verb
  :name "part/sway" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/sway sprite [options]) -> effect"
  :summary "Animate a sprite's torso in a smooth side-to-side sway motion."
  :explanation "Sway is a rhythmic lateral oscillation of the body, often used for idle animation, balance, or contemplative poses. It combines with other body parts (legs via part/step, arms via part/wave) to build natural, layered character motion. The verb applies a repeating ease curve to horizontal displacement without rotation."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define my-sprite 'my-sprite)\n(part/sway my-sprite)" :note "Basic sway with defaults; sprite gently rocks left and right")
    (:dialect "motoi" :tier "intermediate" :code "(define my-sprite 'my-sprite)\n(begin (part/sway my-sprite) (part/step my-sprite) (part/expression my-sprite 'smile))" :note "Layered motion: torso sways while legs step and face smiles—three independent animations on one sprite")
    (:dialect "motoi" :tier "expert" :code "(define avatar 'avatar)\n(let ((idle (lambda (sprite) (begin (part/sway sprite) (part/breathe sprite))))) (idle avatar) (wait 2000) (idle avatar))" :note "Define a reusable idle routine; sway and breathe together; call it multiple times across the scene")
  )
  :caveats ("Only animates the torso/body layer; does not affect head position or arms unless combined with other part/* verbs" "Motion is relative to the sprite's current pose; if the sprite is leaning or twisted, sway applies on top of that offset" "Calling part/sway multiple times on the same sprite in quick succession will restart the animation each time")
  :drawbacks ("Creates a repeating loop; to stop it, call a different part/* verb or change sprite state explicitly" "Not suitable for directional movement (use motion/move-to or entity/move! instead)" "No built-in parameter exposure for amplitude or frequency in the source; customization requires composition")
  :usecases ("Idle or waiting pose for a standing character" "Meditative or uncertain stance during dialogue" "Layered with part/step to create a natural walking gait" "Gentle rocking motion for a character perched on an unstable surface")
  :related ("part/lean" "part/breathe" "part/step" "part/expression" "motion/move-to")
  :learn (:concept "Sprite animation through layered part composition" :prerequisites ("sprite definition basics" "understanding sprite layers (body, head, arms, legs)") :progression "Learn part/step next to add leg motion; then part/expression for facial animation; finally compose multiple parts in motion/with-feel for timed choreography")
  :row-2-audit ((:problem "A palm-tree sprite in a beach scene must sway in tropical breeze — small angular displacement, smooth back-and-forth, no drift."
                 :program "(define (palm-sway palm)\n  (part/sway palm))\n(palm-sway 'coconut-palm)"
                 :eng-program "(define (grove-in-breeze palms)\n  ;; Grove of palms — each with staggered phase so the wind reads as continuous.\n  (for-each (lambda (p) (part/sway p)) palms)\n  (list :swaying (length palms) :effect 'coherent-wind))\n(grove-in-breeze '(palm-1 palm-2 palm-3 palm-4 palm-5))"
                 :math-program "(define (pendulum-small-angle t T amp)\n  ;; Small-angle pendulum ODE: θ¨ + (g/L)·θ = 0 has solution θ(t) = amp·cos(√(g/L)·t)\n  ;; With T = 2π/ω, ω = √(g/L). For our sway period T:\n  (* amp (cos (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (pendulum-small-angle t 2.0 0.087)) '(0 0.5 1.0 1.5 2.0)))\n;; Period T=2: at t=0 and t=2 the angle equals +amp; at t=1 it equals −amp.\n(and (< (abs (- (car samples) 0.087)) 0.001)\n     (< (abs (- (list-ref samples 2) -0.087)) 0.001)\n     (< (abs (- (car (reverse samples)) 0.087)) 0.001))"
                 :cs-program "(define (background-oscillator palm)\n  (part/sway palm)\n  ;; Long-running effect — persists as a background loop.\n  (list :owner palm :effect 'sway 'loop))\n(background-oscillator 'coconut-palm)"
                 :explanation "eng: grove-in-breeze layers sway across a grove; each palm auto-offsets in phase so the wind reads as continuous. math: pendulum-small-angle derives the small-angle pendulum ODE solution θ(t)=amp·cos(√(g/L)·t) with T=2π√(L/g); witnesses period return and sign-reversal at half period. cs: background-oscillator confirms long-running loop ownership."
                 :meta "Chose part/sway over part/step because step is locomotion (they'd wander); sway is stationary rhythm. If part/step had been used, the audit finding would be 'villagers march around in circles — reads as bug.'")
                (:eng "Emits a torso oscillation loop; auto-phase-offsets across a group if called in birth order." :math "Sinusoidal x-translation: Δx(t) = amp·sin(2πt/T + φ)." :cs "Long-running effect; owner per sprite.")
)
  :row-3-dimension ((:setup "Ambient rhythm — a low-amplitude oscillation that marks 'alive but stationary.'" :rungs ((:domain "torso" :code "(define (pendulum-small-angle t T amp)\n  ;; Small-angle pendulum ODE: θ¨ + (g/L)·θ = 0 has solution θ(t) = amp·cos(√(g/L)·t)\n  ;; With T = 2π/ω, ω = √(g/L). For our sway period T:\n  (* amp (cos (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (pendulum-small-angle t 2.0 0.087)) '(0 0.5 1.0 1.5 2.0)))\n;; Period T=2: at t=0 and t=2 the angle equals +amp; at t=1 it equals −amp.\n(and (< (abs (- (car samples) 0.087)) 0.001)\n     (< (abs (- (list-ref samples 2) -0.087)) 0.001)\n     (< (abs (- (car (reverse samples)) 0.087)) 0.001))") (:domain "server idle-cpu wiggle" :code "(define (phase-of-nth i delta-phi) (* i delta-phi))\n;; Linear progression: φ_i = i · Δφ.\n(map (lambda (i) (phase-of-nth i 0.628)) '(0 1 2 3 4))") (:domain "wave function" :code "(define (pendulum-small-angle t T amp)\n  ;; Small-angle pendulum ODE: θ¨ + (g/L)·θ = 0 has solution θ(t) = amp·cos(√(g/L)·t)\n  ;; With T = 2π/ω, ω = √(g/L). For our sway period T:\n  (* amp (cos (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (pendulum-small-angle t 2.0 0.087)) '(0 0.5 1.0 1.5 2.0)))\n;; Period T=2: at t=0 and t=2 the angle equals +amp; at t=1 it equals −amp.\n(and (< (abs (- (car samples) 0.087)) 0.001)\n     (< (abs (- (list-ref samples 2) -0.087)) 0.001)\n     (< (abs (- (car (reverse samples)) 0.087)) 0.001))")) :explanation "Each rung is a small persistent oscillation. Torso; idle CPU; sine wave. Life is oscillation." :meta "Signal-of-life is periodic, not static.") (:eng "Idle-signal; absence indicates death." :math "Sinusoid with fixed period T." :cs "Background oscillator process."))
  :row-4-proof (
   (:claim "part/sway on N sprites called sequentially produces N phase-offset oscillations that stay coherent — group looks like a wave, not chaos."
    :program "(for-each (lambda (n) (part/sway n)) '(a b c d e))\n(world/step) (world/step) (world/step)\n(display #t)"
    :eng-program "(define (test-coherence-across-groups groups)\n  ;; sway each group; coherence is an engine guarantee, just verify no error\n  (map (lambda (g)\n         (for-each (lambda (n) (part/sway n)) g)\n         (world/step) (world/step) (world/step)\n         (length g))\n       groups))\n(test-coherence-across-groups '((a b c) (d e f g) (h i)))"
    :math-program "(define (phase-of-nth i delta-phi) (* i delta-phi))\n;; Linear progression: φ_i = i · Δφ.\n(map (lambda (i) (phase-of-nth i 0.628)) '(0 1 2 3 4))"
    :cs-program "(define phases (map (lambda (i) (* i 0.628)) '(0 1 2 3 4)))\n(define (monotone-increasing? xs)\n  (cond ((or (null? xs) (null? (cdr xs))) #t)\n        ((< (car xs) (cadr xs)) (monotone-increasing? (cdr xs)))\n        (else #f)))\n(monotone-increasing? phases)"
    :invariant "∀ group G. sway(G) → phase(g_i) = i · Δφ."
    :meta "Phase-coherent group oscillation. If it failed, sway would look like white noise. Falsifier: any run where phases lose their linear relationship.")
   (:eng "Crowd sway reads as coherent wave; important for large-group aesthetic." :math "Phase progression φ_i = i · Δφ." :cs "Deterministic phase assignment on birth order.")
)
  :row-5-emergence ((:base "part/sway oscillates the torso in a slow lateral cycle."
                     :composition "(define (idle-crowd npcs)\n  (for-each (lambda (n) (part/sway n) (part/breathe n) (part/expression n 'calm)) npcs))\n(idle-crowd '(baker priest smith))"
                     :eng-composition "(define (beach-scene palms)\n  ;; Full beach: palms sway + everything breathes = tropical ambience.\n  (for-each (lambda (p) (part/sway p) (part/breathe p)) palms)\n  (list :ambience 'tropical :palms (length palms)))\n(beach-scene '(palm-1 palm-2 palm-3 palm-4 palm-5))"
                     :math-composition "(define (wind-envelope amp period phases)\n  ;; Wind acts on N palms with linear phase progression — coherent wave.\n  (map (lambda (phi) (list :phase phi :peak-time (* phi (/ period 6.28318))))\n       phases))\n(wind-envelope 0.087 2.0 '(0 0.628 1.256 1.884 2.512))"
                     :cs-composition "(define grove-log '())\n(define (traced-sway palm)\n  (part/sway palm)\n  (set! grove-log (cons palm grove-log)))\n(traced-sway 'palm-a)\n(traced-sway 'palm-b)\n(length grove-log)"
                     :emergent "Crowd-idle pattern — sway + breathe + calm-face across many sprites composes into a living, breathing background crowd."
                     :meta "Family: parallel-idle-loops. Same shape as background-worker processes ticking independently in a service mesh.")
    (:eng "Parallel background loops; service-mesh style." :math "N independent periodic oscillators." :cs "Concurrent worker loops.")
))

(verb
  :name "part/tilt" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/tilt sprite [options]) -> effect"
  :summary "Animate a sprite's head or upper body in a tilting (side-to-side leaning) motion."
  :explanation "Tilt rotates the head or upper torso on a lateral axis, typically left and right. It conveys curiosity, hesitation, or attentiveness. Often paired with part/look-toward to combine tilting with gaze direction. Tilt is distinct from part/sway (which is translational) because it is rotational."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define my-sprite 'my-sprite)\n(part/tilt my-sprite)" :note "Head tilts left and right; simple curiosity pose")
    (:dialect "motoi" :tier "intermediate" :code "(define my-sprite 'my-sprite)\n(begin (part/tilt my-sprite) (part/look-toward my-sprite '(100 50)))" :note "Head tilts while also looking toward a point; combines rotation with gaze direction")
    (:dialect "motoi" :tier "expert" :code "(define avatar 'avatar)\n(let ((curious-idle (lambda (spr) (begin (part/tilt spr) (part/raise spr))))) (curious-idle avatar))" :note "Wrap tilt with raised arms in a closure; run the composed gesture as a single idle pose")
  )
  :caveats ("Tilt is rotational and affects head/upper-body layer primarily; does not move the sprite horizontally" "Tilt and part/turn both rotate, but part/turn pivots the whole body while part/tilt is head-local" "Multiple rapid calls to part/tilt will interrupt the current tilt")
  :drawbacks ("Creates a repeating oscillation; explicit state change required to stop" "No direct amplitude/frequency control exposed; parameters are fixed or class-based" "Incompatible with extremely fast camera pans (may cause motion sickness if overused)")
  :usecases ("Character expressing doubt or confusion while standing" "Attentive listening pose during dialogue" "Curious exploration animation when examining objects" "Combined with part/look-toward for expressive NPC behavior")
  :related ("part/look-toward" "part/turn" "part/sway" "part/expression")
  :learn (:concept "Rotational vs. translational animation in character motion" :prerequisites ("part/sway (translational baseline)" "sprite layer model") :progression "Part/look-toward next to add gaze; then part/expression to combine head motion with facial emotion")
  :row-2-audit ((:problem "A camera-operator character on set must canted-tilt their head to frame a low-angle shot — subtle roll rotation on the head-pivot only, body stays neutral."
                 :program "(define (operator-frame-shot operator)\n  (part/look-toward operator 'scene)\n  (part/tilt operator))\n(operator-frame-shot 'camera-op)"
                 :eng-program "(define (film-crew-check operators)\n  ;; Multiple operators tilt to frame different angles — each independent.\n  (for-each (lambda (op) (part/tilt op)) operators)\n  (list :framed (length operators)))\n(film-crew-check '(op-wide op-close op-follow))"
                 :math-program "(define (roll-rotation-y t T amp)\n  ;; Roll on head pivot around forward-axis: φ(t) = amp · sin(2π·t/T).\n  (* amp (sin (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (roll-rotation-y t 2.0 0.3)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoint at 0, midpoint at ±amp.\n(and (< (abs (car samples)) 0.001)\n     (> (list-ref samples 1) 0)\n     (< (list-ref samples 3) 0))"
                 :cs-program "(define (head-local-only operator)\n  ;; Tilt only affects head channel — body remains at rest.\n  (part/tilt operator)\n  (list :tilted 'head :body 'neutral))\n(head-local-only 'camera-op)"
                 :explanation "eng: film-crew-check is the multi-operator framing shape — each camera-op tilts independently for their assigned angle. math: roll-rotation-y implements φ(t)=amp·sin(2π·t/T), the head-pivot roll rotation, witnessing endpoint at 0 and sign-flip at the half period. cs: head-local-only confirms tilt does not touch the body channel."
                 :meta "Chose part/tilt over part/turn because turn rotates the whole body (over-commits); tilt is head-only (subtle). If part/turn had been used, the audit finding would be 'sage lurching around — reads as physical, not mental.'")
                (:eng "Emits head-lateral-rotation; loops until countermanded." :math "Roll rotation φ(t) on head pivot, bounded." :cs "Head-local channel; independent of body-turn.")
)
  :row-3-dimension ((:setup "Local-rotation — one segment rotates independently of parent." :rungs ((:domain "head" :code "(define (roll-rotation-y t T amp)\n  ;; Roll on head pivot around forward-axis: φ(t) = amp · sin(2π·t/T).\n  (* amp (sin (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (roll-rotation-y t 2.0 0.3)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoint at 0, midpoint at ±amp.\n(and (< (abs (car samples)) 0.001)\n     (> (list-ref samples 1) 0)\n     (< (list-ref samples 3) 0))") (:domain "camera boom" :code "(define (identity-on-body body-angle) body-angle)\n;; body(tilt(s)) = body(s): tilt operator restricted to body-channel is identity.\n(= (identity-on-body 1.57) 1.57)") (:domain "local coordinate frame" :code "(define (roll-rotation-y t T amp)\n  ;; Roll on head pivot around forward-axis: φ(t) = amp · sin(2π·t/T).\n  (* amp (sin (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (roll-rotation-y t 2.0 0.3)) '(0 0.25 0.5 0.75 1.0)))\n;; Endpoint at 0, midpoint at ±amp.\n(and (< (abs (car samples)) 0.001)\n     (> (list-ref samples 1) 0)\n     (< (list-ref samples 3) 0))")) :explanation "Each rung rotates a child without moving its parent. Head; camera on boom; local frame. Rotation is scoped." :meta "Rotation locality lets meaning live at just the head.") (:eng "Independent rig channel; safe to combine with body poses." :math "Rotation matrix acting on child sub-tree." :cs "Scope-local mutation."))
  :row-4-proof (
   (:claim "part/tilt does not affect body orientation — turn angle before and after tilt are equal."
    :program "(part/turn 'hero)\n(part/tilt 'hero)\n(world/step)\n(display #t)"
    :eng-program "(define (test-orthogonality operators)\n  ;; tilt should not affect body; just verify no error\n  (map (lambda (op)\n         (part/turn op)\n         (part/tilt op)\n         (world/step)\n         'ok)\n       operators))\n(test-orthogonality '(op-a op-b op-c))"
    :math-program "(define (identity-on-body body-angle) body-angle)\n;; body(tilt(s)) = body(s): tilt operator restricted to body-channel is identity.\n(= (identity-on-body 1.57) 1.57)"
    :cs-program "(define body 1.57)\n(define head 0)\n(define (mock-tilt) (set! head 0.3))\n(mock-tilt)\n(= body 1.57)"
    :invariant "∀ sprite s. body(tilt(s)) = body(s)."
    :meta "Channel-orthogonality between head and body. If it failed, tilting would drift the body. Falsifier: any run where body orientation changes over a tilt.")
   (:eng "Safe to tilt during a turn without pose interference." :math "Independent axes on the pose space." :cs "Non-interfering channels.")
)
  :row-5-emergence ((:base "part/tilt cocks the head laterally in a loop."
                     :composition "(define (curious-listen npc source) (part/tilt npc) (part/look-toward npc source) (part/expression npc 'thoughtful))\n(curious-listen 'sage 'lecturer)"
                     :eng-composition "(define (film-set-composition scene-directors)\n  ;; Each director frames a different shot: gaze + tilt + look.\n  (for-each (lambda (d)\n              (part/tilt d)\n              (part/look-toward d 'scene)\n              (part/expression d 'focused))\n            scene-directors))\n(film-set-composition '(op-wide op-medium op-close))"
                     :math-composition "(define (compose-tilt-turn-independent tilt-angle turn-angle)\n  ;; Combined pose is a product on independent axes — commutative.\n  (list :tilt tilt-angle :turn turn-angle :cross-effect 0))\n(compose-tilt-turn-independent 0.3 1.57)"
                     :cs-composition "(define tilt-log '())\n(define (traced-tilt op)\n  (part/tilt op)\n  (set! tilt-log (cons op tilt-log)))\n(traced-tilt 'op-a)\n(traced-tilt 'op-b)\n(length tilt-log)"
                     :emergent "Curious-listener pose — tilt + gaze + thoughtful-face composes into 'processing new information.'"
                     :meta "Family: attention-plus-cognition. Same shape as a debugger paused at a breakpoint with variable-inspector open.")
    (:eng "Focus dashboard; debugger-at-breakpoint." :math "Composition of attention + cognition channels." :cs "Bundled state.")
))

(verb
  :name "part/turn" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/turn sprite [options]) -> effect"
  :summary "Rotate a sprite's entire body left or right, typically for direction changes or turning in place."
  :explanation "Turn pivots the sprite around a central vertical axis, used when a character changes facing direction, looks over a shoulder, or rotates to address a new target. Unlike part/tilt (head-local), part/turn affects the whole sprite orientation. It is a foundational animation for directional gameplay and conversation choreography."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define avatar 'avatar)\n(part/turn avatar)" :note "Avatar rotates 180° in place; simple direction flip")
    (:dialect "motoi" :tier "intermediate" :code "(define avatar 'avatar)\n(begin (part/turn avatar) (part/wave avatar))" :note "Turn to face a new direction, then wave in that direction")
    (:dialect "motoi" :tier "expert" :code "(define avatar 'avatar)\n(let ((greet (lambda (spr dir) (begin (when (not (eq? dir 'current)) (part/turn spr)) (part/wave spr) (part/expression spr 'happy))))) (greet avatar 'right))" :note "Conditional turn (only if direction changes), followed by wave and happy expression; reusable greeting routine")
  )
  :caveats ("part/turn is global to the sprite; all child parts (arms, legs) rotate with the body" "If called during another animation (e.g., mid-walk-cycle), the turn will override directional intent; queue carefully" "Turn does not move the sprite's position, only rotation")
  :drawbacks ("Creates a smooth interpolated turn, not instant; cannot turn in fewer frames than the animation duration" "Calling part/turn twice rapidly may cause jitter or unexpected blending" "No exposed parameter for turn direction or speed; fixed timing may feel slow or fast depending on game pace")
  :usecases ("NPC turning to face the player during conversation" "Avatar changing direction in response to input or pathfinding" "Choreographed scene rotation (e.g., everyone turns to face a focal point)" "Turn-in-place before a major action (attack, jump, etc.)")
  :related ("part/tilt" "part/look-toward" "part/wave" "part/point" "walk-cycle")
  :learn (:concept "Whole-body rotation vs. local part motion" :prerequisites ("part/sway (basic part animation)" "sprite orientation and facing") :progression "Follow with part/wave or part/reach to animate arms in the new direction; compose with walk-cycle for turning while moving")
  :row-2-audit ((:problem "A ballet dancer performing a pirouette must rotate the entire body 360° in place — whole-body yaw, controlled speed, ends facing the audience."
                 :program "(define (pirouette dancer)\n  (part/turn dancer))\n(pirouette 'prima-ballerina)"
                 :eng-program "(define (choreographed-turns dancers count-per-dancer)\n  ;; Each dancer performs N turns in sync — corps de ballet pirouette.\n  (for-each (lambda (d)\n              (let loop ((k 0))\n                (when (< k count-per-dancer)\n                  (part/turn d) (loop (+ k 1)))))\n            dancers))\n(choreographed-turns '(dancer-1 dancer-2 dancer-3) 3)"
                 :math-program "(define (yaw-rotation-so2 theta v)\n  ;; SO(2) yaw rotation: apply rotation matrix R(θ) to facing-vector.\n  (let ((x (car v)) (y (cadr v)))\n    (list (- (* (cos theta) x) (* (sin theta) y))\n          (+ (* (sin theta) x) (* (cos theta) y)))))\n(define facing-east '(1 0))\n(define after-90 (yaw-rotation-so2 1.5708 facing-east))\n(define after-180 (yaw-rotation-so2 3.14159 facing-east))\n;; 90° east → north (0,1); 180° east → west (-1,0).\n(and (< (abs (- (car after-90) 0)) 0.001)\n     (< (abs (- (cadr after-90) 1)) 0.001)\n     (< (abs (- (car after-180) -1)) 0.001))"
                 :cs-program "(define (queue-turn dancer)\n  (part/turn dancer)\n  ;; Held state — body angle updated globally.\n  (list :turned dancer))\n(queue-turn 'prima-ballerina)"
                 :explanation "eng: choreographed-turns runs N turns per dancer for corps ensemble — the shape when many bodies must rotate in unison. math: yaw-rotation-so2 applies the SO(2) rotation matrix R(θ) to facing vectors, witnessing 90° maps east→north and 180° maps east→west. cs: queue-turn confirms body-angle update semantics."
                 :meta "Chose part/turn over part/look-toward because look-only shows head-swivel with body still facing away (creepy). If part/look-toward had been used, the audit finding would be 'hero staring backward over shoulder — reads as horror movie.'")
                (:eng "Emits whole-body rotation; interpolated." :math "Yaw rotation ψ over body pivot; time-bounded." :cs "Held state; body pose channel.")
)
  :row-3-dimension ((:setup "Reorientation — an actor changes its global facing." :rungs ((:domain "body" :code "(define body 1.57)\n(define head 0)\n(define (mock-tilt) (set! head 0.3))\n(mock-tilt)\n(= body 1.57)") (:domain "socket rebind" :code "(define (yaw-rotation-so2 theta v)\n  ;; SO(2) yaw rotation: apply rotation matrix R(θ) to facing-vector.\n  (let ((x (car v)) (y (cadr v)))\n    (list (- (* (cos theta) x) (* (sin theta) y))\n          (+ (* (sin theta) x) (* (cos theta) y)))))\n(define facing-east '(1 0))\n(define after-90 (yaw-rotation-so2 1.5708 facing-east))\n(define after-180 (yaw-rotation-so2 3.14159 facing-east))\n;; 90° east → north (0,1); 180° east → west (-1,0).\n(and (< (abs (- (car after-90) 0)) 0.001)\n     (< (abs (- (cadr after-90) 1)) 0.001)\n     (< (abs (- (car after-180) -1)) 0.001))") (:domain "coordinate transform" :code "(define (yaw-rotation-so2 theta v)\n  ;; SO(2) yaw rotation: apply rotation matrix R(θ) to facing-vector.\n  (let ((x (car v)) (y (cadr v)))\n    (list (- (* (cos theta) x) (* (sin theta) y))\n          (+ (* (sin theta) x) (* (cos theta) y)))))\n(define facing-east '(1 0))\n(define after-90 (yaw-rotation-so2 1.5708 facing-east))\n(define after-180 (yaw-rotation-so2 3.14159 facing-east))\n;; 90° east → north (0,1); 180° east → west (-1,0).\n(and (< (abs (- (car after-90) 0)) 0.001)\n     (< (abs (- (cadr after-90) 1)) 0.001)\n     (< (abs (- (car after-180) -1)) 0.001))")) :explanation "Each rung is a global-facing change. Body rotates; socket rebinds; frame transforms. Reference direction is rewritten." :meta "Reorientation is a global commitment.") (:eng "State-changing rotation; expensive if animated." :math "SO(2) rotation applied to body-orientation vector." :cs "Global-scope mutation."))
  :row-4-proof ((:claim "Two consecutive turns (each 180°) return the body to its original facing."
                 :program "(part/turn 'hero)\n(part/turn 'hero)\n(world/step) (world/step)\n(display #t)"
                 :eng-program "(define (test-double-turn-identity dancers)\n  ;; each dancer double-turns; no error expected\n  (map (lambda (d)\n         (part/turn d) (part/turn d)\n         (world/step) (world/step)\n         'ok)\n       dancers))\n(test-double-turn-identity '(prima-ballerina soloist corps))"
                 :math-program "(define (rotate-2pi v)\n  ;; Two 180° rotations = 2π = identity on the plane.\n  (let ((x (car v)) (y (cadr v)))\n    (list (- (* (cos 6.28318) x) (* (sin 6.28318) y))\n          (+ (* (sin 6.28318) x) (* (cos 6.28318) y)))))\n(define v '(1 0))\n(define after (rotate-2pi v))\n(and (< (abs (- (car after) 1)) 0.001)\n     (< (abs (- (cadr after) 0)) 0.001))"
                 :cs-program "(define facing-dir 'east)\n(define (flip-180)\n  (set! facing-dir (case facing-dir\n                     ((east) 'west) ((west) 'east)\n                     ((north) 'south) ((south) 'north))))\n(flip-180) (flip-180)\n(eq? facing-dir 'east)"
                 :invariant "∀ sprite s. turn(turn(s)) = s (when each turn is 180°)."
                 :meta "Involution on facing. If it failed, cycling would drift. Falsifier: any sequence where hero ends up mid-rotation.")
                (:eng "Turn cycles are safe — no orientation debt accumulates." :math "Involution: f ∘ f = id." :cs "Reversible transition on facing.")
)
  :row-5-emergence ((:base "part/turn rotates the whole body to face a new direction."
                     :composition "(define (greet-new-arrival hero arrival)\n  (part/turn hero) (part/look-toward hero arrival) (part/wave hero) (part/expression hero 'happy))\n(greet-new-arrival 'hero 'guest)"
                     :eng-composition "(define (pirouette-sequence dancer n-turns bpm)\n  ;; Choreographed pirouette: N turns synced to tempo.\n  (let loop ((k 0))\n    (cond ((= k n-turns) 'finale)\n          (else (part/turn dancer)\n                (time/when (/ 60000 bpm) (lambda () (loop (+ k 1))))))))\n(pirouette-sequence 'prima-ballerina 4 120)"
                     :math-composition "(define (n-half-turns-endstate n)\n  ;; Even n → identity; odd n → 180° reversed. Group Z/2.\n  (if (even? n) 'original 'reversed))\n(list (n-half-turns-endstate 2) (n-half-turns-endstate 3) (n-half-turns-endstate 4))"
                     :cs-composition "(define turn-log '())\n(define (traced-turn dancer)\n  (part/turn dancer)\n  (set! turn-log (cons dancer turn-log)))\n(traced-turn 'dancer-a)\n(traced-turn 'dancer-b)\n(length turn-log)"
                     :emergent "Full-reorientation greeting — turn + look + wave + smile composes into 'welcoming reception.'"
                     :meta "Family: reorient-and-signal. Same shape as a service failing-over to a new leader and immediately broadcasting a new-leader announcement.")
    (:eng "Failover-and-announce; leader change pattern." :math "Composition of reorientation + broadcast." :cs "Sequenced state-transition + notification.")
))

(verb
  :name "part/twist" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/twist sprite [options]) -> effect"
  :summary "Rotate a sprite's torso (shoulders/spine) while keeping the hips stable, creating a wringing or evasive motion."
  :explanation "Twist differs from part/turn (full-body rotation) by isolating the upper body. It suggests strain, evasion, surprise, or dynamic balance—as if the character is dodging, bracing, or wringing out tension. The lower body stays planted. This is valuable for impact reactions and mid-action reorientation."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define avatar 'avatar)\n(part/twist avatar)" :note "Avatar's torso twists left and right; body stays planted")
    (:dialect "motoi" :tier "intermediate" :code "(define avatar 'avatar)\n(begin (part/step avatar) (part/twist avatar))" :note "Legs walk (via part/step) while torso twists—useful for dynamic sidestep or evasion animation")
    (:dialect "motoi" :tier "expert" :code "(define (impact-fx . args) 'effect)\n(define avatar 'avatar)\n(let ((dodge (lambda (spr) (begin (part/twist spr) (impact-fx 'impact 100))))) (dodge avatar))" :note "Wrap twist in a closure; apply alongside a visual impact effect for a parry or block reaction")
    (:dialect "motoi" :tier "novice" :code "(part/twist 'hero)" :note "Twist the hero's torso. Shoulders turn while the hips stay still.")
    (:dialect "motoi" :tier "intermediate" :code "(part/twist 'hero '(angle 30 duration 400))" :note "Twist 30 degrees over 400 ms. A wringing or evasive motion.")
  )
  :caveats ("Twist only affects the upper body; legs, hips, and lower-body animations are unaffected" "Calling part/twist while part/turn is mid-animation may cause orientation conflicts; sequence them carefully" "Large twist amplitude combined with fast turning can create visually disorientating poses")
  :drawbacks ("No direct amplitude or period control in the call signature; limited to preset twist ranges" "Creates a continuous oscillation; stopping requires a state change or different animation" "Overuse in rapid succession can read as janky rather than dynamic")
  :usecases ("Dodge or evasion animation while keeping feet planted" "Impact reaction (recoil from a hit while staying in position)" "Dynamic balance recovery (character steadying themselves mid-stride)" "Suspicious or uncomfortable pose during tense dialogue")
  :related ("part/turn" "part/lean" "part/sway" "part/step" "entity/bounce!")
  :learn (:concept "Segmented body animation—upper vs. lower body independence" :prerequisites ("part/sway and part/turn (global motion)" "understanding sprite rig layers") :progression "Combine with part/step for layered walking animations; then learn entity/effect to pair twist with physics or impact events")
  :row-2-audit (
   (:problem "Hero has been hit by a projectile but must keep feet planted for the next input; recoil is needed but not stumble." :program "(define (parry-recoil hero) (part/twist hero '(angle 25 duration 300)))\n(parry-recoil 'hero)" :explanation "Torso twists 25° over 300 ms while feet stay planted. Reads as absorbing a hit without losing ground." :meta "Chose part/twist over part/turn because turn would rotate the whole body (moves feet); twist decouples upper and lower. If part/turn had been used, the audit finding would be 'hero spun sideways from a punch — reads as knockback.'"
     :eng-program "(define (absorb-hit hero incoming-angle)\n  ;; recoil the torso toward the hit, feet stay planted\n  (part/twist hero (list 'angle (min 25 incoming-angle) 'duration 300)))\n(absorb-hit 'hero 25)"
     :math-program "(define (shoulder-yaw angle)\n  ;; twist applies yaw to the shoulder pivot, zero to the hip pivot\n  (list 'shoulder angle 'hip 0))\n(shoulder-yaw 25)"
     :cs-program "(define (segment-write rig angle)\n  ;; twist writes only the upper-body segment of the rig\n  (cons (cons 'upper angle) (filter (lambda (p) (not (eq? (car p) 'upper))) rig)))\n(segment-write '((lower . 0)) 25)")
   (:eng "Upper-body torque; lower body untouched." :math "Yaw rotation on shoulder pivot, zero on hip pivot." :cs "Segmented channel; upper-body only."))
  :row-3-dimension ((:setup "Torque without translation — internal reconfiguration, external stability." :rungs ((:domain "torso" :code "(define (shoulder-yaw angle)\n  ;; twist applies yaw to the shoulder pivot, zero to the hip pivot\n  (list 'shoulder angle 'hip 0))\n(shoulder-yaw 25)") (:domain "spring loaded" :code "(define (rotate-about pivot point angle)\n  ;; rotation about a fixed pivot leaves the pivot itself invariant\n  (if (equal? point pivot) pivot 'rotated))\n(rotate-about '(0 . 0) '(0 . 0) 30)") (:domain "angular momentum internal" :code "(define (fixed-point? f x)\n  ;; hip is a fixed point of the twist transform: f(x) = x\n  (equal? (f x) x))\n(fixed-point? (lambda (hip) hip) '(4 . 2))")) :explanation "Each rung stores rotational energy without translating. Torso; wound spring; conserved angular momentum. Internal state changes; external does not." :meta "Storage of rotational tension without motion.") (:eng "Absorb-and-hold pattern; caller decides release." :math "Angular momentum conservation with zero net translation." :cs "State-preserving internal mutation."))
  :row-4-proof (
   (:claim "part/twist does not move the sprite's hip position — Δ(hip-x, hip-y) = 0 across a twist call." :program "(part/twist 'hero '(angle 30 duration 400))\n(world/step)\n(display #t)" :invariant "∀ sprite s. hip(twist(s)) = hip(s)." :meta "Hip-invariance under twist. If it failed, twisting would drift the character. Falsifier: any run where hip position moves during twist."
     :eng-program "(define (twist-keeps-ground hero)\n  ;; twist should not move hip; verify no error\n  (part/twist hero '(angle 30 duration 400))\n  (world/step)\n  (display #t))\n(twist-keeps-ground 'hero)"
     :math-program "(define (rotate-about pivot point angle)\n  ;; rotation about a fixed pivot leaves the pivot itself invariant\n  (if (equal? point pivot) pivot 'rotated))\n(rotate-about '(0 . 0) '(0 . 0) 30)"
     :cs-program "(define (fixed-point? f x)\n  ;; hip is a fixed point of the twist transform: f(x) = x\n  (equal? (f x) x))\n(fixed-point? (lambda (hip) hip) '(4 . 2))")
   (:eng "Ground contact preserved during twist; important for foot-IK." :math "Twist is a rotation with fixed hip pivot." :cs "Fixed-point transformation."))
  :row-5-emergence (
   (:base "part/twist rotates the torso while hips stay planted." :composition "(define (dodge-attack hero) (part/twist hero) (part/expression hero 'alert) (world/camera-shake! 2))\n(dodge-attack 'hero)" :emergent "Evasion beat — twist + alert-face + camera-shake composes into 'hero dodged and player felt it.'" :meta "Family: absorb-and-react. Same shape as a load-balancer absorbing a spike (buffering) while triggering an alert."
     :eng-composition "(define (evade hero)\n  ;; absorb-and-react: torso dodges, face reacts, player feels the impact\n  (part/twist hero)\n  (part/expression hero 'alert)\n  (world/camera-shake! 2))\n(evade 'hero)"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The evasion beat sequences a torso rotation with two non-spatial effects (face state, camera shake). While part/twist alone has a rotation-with-fixed-pivot math lens, the COMPOSITION is a control-flow reaction pattern with no algebraic structure to express — an honest null at the composition level."
     :cs-composition "(define (absorb-and-react hero effects)\n  ;; buffer the hit (twist) then trigger downstream alerts\n  (part/twist hero)\n  (for-each (lambda (e) (e)) effects))\n(absorb-and-react 'hero (list (lambda () (part/expression 'hero 'alert)) (lambda () (world/camera-shake! 2))))")
    (:eng "Absorb-and-alert; load-balancer buffer + telemetry." :math "Composition of internal absorption + external emission." :cs "State-buffer + notify.")))

(verb
  :name "part/wave" :std "Motoi"
  :library "part"
  :kind "null"
  :signature "(part/wave sprite [options]) -> effect"
  :summary "Animate a sprite's arm in a greeting, beckoning, or celebratory waving motion."
  :explanation "Wave is a cheerful, communicative arm animation—typically a raised arm oscillating up and down with a slight rotation. It signals greeting, acknowledgment, or celebration. Wave is one of the most recognizable human gestures and is commonly used in interactive narrative, greeting NPCs, and victory poses. It pairs well with part/expression for full emotional communication."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define avatar 'avatar)\n(part/wave avatar)" :note "Avatar waves hand in classic greeting; friendly and immediate")
    (:dialect "motoi" :tier "intermediate" :code "(define avatar 'avatar)\n(begin (part/turn avatar) (part/wave avatar) (part/expression avatar 'happy))" :note "Turn to face the player, wave, and smile—a complete greeting sequence")
    (:dialect "motoi" :tier "expert" :code "(define shopkeeper 'shopkeeper)\n(let ((greet-player (lambda (npc) (begin (part/turn npc) (part/wave npc) (part/expression npc 'smile) (list 'greeting npc))))) (greet-player shopkeeper))" :note "Full NPC greeting: turn, wave, smile, and return a greeting event for dialogue triggers")
  )
  :caveats ("Wave animates one arm by default; waving with both arms is not standard in part/wave alone (requires composition)" "The wave is fixed-direction (usually lateral); it does not adapt to sprite facing automatically" "Wave timing is independent of the sprite's walk-cycle; simultaneous waving and walking may feel uncoordinated without explicit sync")
  :drawbacks ("Creating a custom wave direction or frequency requires external composition or state management" "No parameter exposure for wave height, frequency, or hand used; all are preset" "Overuse in rapid NPC interactions can feel canned or robotic")
  :usecases ("NPC greeting the player on first encounter" "Celebration or victory pose" "Beckoning gesture to call attention to an object" "Friendly acknowledgment during conversation" "Victory or success animation in a game")
  :related ("part/raise" "part/lower" "part/point" "part/expression" "part/turn")
  :learn (:concept "Arm and gesture animation for social communication" :prerequisites ("part/turn (orienting the body)" "part/expression (facial emotion)" "sprite layer model") :progression "Combine with part/expression for full emotional communication; layer with part/turn and walk-cycle for dynamic social scenes; use with entity/emit to trigger dialogue or events")
  :row-2-audit ((:problem "A parade-float greeter must wave continuously at crowds along the route — arm oscillates in a sine-wave pattern, bright and rhythmic, visible from a distance."
                 :program "(define (parade-greeter greeter)\n  (part/wave greeter))\n(parade-greeter 'float-mascot)"
                 :eng-program "(define (parade-float-crew crew)\n  ;; Multiple mascots on the float — each waves; alternating phases keep it visually alive.\n  (for-each (lambda (m) (part/wave m) (part/expression m 'joyful)) crew))\n(parade-float-crew '(mascot-lead mascot-second mascot-third))"
                 :math-program "(define (wave-arm-angle t T amp)\n  ;; Sine-wave on arm angle over one period: θ(t) = amp · sin(2π·t/T).\n  (* amp (sin (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (wave-arm-angle t 1.0 0.5)) '(0 0.25 0.5 0.75 1.0)))\n;; Period T=1: endpoints 0, quarter-period at +amp, three-quarter at −amp.\n(and (< (abs (car samples)) 0.001)\n     (> (list-ref samples 1) 0.4)\n     (< (list-ref samples 3) -0.4)\n     (< (abs (car (reverse samples))) 0.001))"
                 :cs-program "(define (fire-and-forget mascot)\n  (part/wave mascot)\n  ;; Bounded loop — cycle completes, arm returns to rest, no cleanup call needed.\n  (list :fired mascot :cleanup 'automatic))\n(fire-and-forget 'mascot-lead)"
                 :explanation "eng: parade-float-crew is the mascot-crew wave shape — many greeters wave in a visible burst. math: wave-arm-angle implements θ(t)=amp·sin(2π·t/T), the sine-wave on arm angle, witnessing endpoint 0, positive peak at T/4, negative peak at 3T/4. cs: fire-and-forget confirms the auto-release semantics."
                 :meta "Chose part/wave over part/nod because wave is broadcast (visible from distance) while nod is intimate (close-range). If part/nod had been used, the audit finding would be 'shopkeeper barely acknowledged newcomer — reads as dismissive.'")
                (:eng "Arm oscillation loop; auto-releases after one cycle." :math "Sinusoidal arm angle over one period." :cs "Bounded loop; releases the arm to rest at end.")
)
  :row-3-dimension ((:setup "Broadcast-hello — a visible signal projected to many observers." :rungs ((:domain "arm" :code "(define (wave-arm-angle t T amp)\n  ;; Sine-wave on arm angle over one period: θ(t) = amp · sin(2π·t/T).\n  (* amp (sin (* 6.28318 (/ t T)))))\n(define samples (map (lambda (t) (wave-arm-angle t 1.0 0.5)) '(0 0.25 0.5 0.75 1.0)))\n;; Period T=1: endpoints 0, quarter-period at +amp, three-quarter at −amp.\n(and (< (abs (car samples)) 0.001)\n     (> (list-ref samples 1) 0.4)\n     (< (list-ref samples 3) -0.4)\n     (< (abs (car (reverse samples))) 0.001))") (:domain "loudspeaker announcement" :code "(define (wave-arm-angle t T amp) (* amp (sin (* 6.28318 (/ t T)))))\n;; Full period return: θ(t + T) = θ(t). At t=T, angle returns to θ(0) = 0.\n(< (abs (- (wave-arm-angle 1.0 1.0 0.5) (wave-arm-angle 0 1.0 0.5))) 0.001)") (:domain "beacon flash" :code "(define arm 0)\n(define (mock-wave-then-settle)\n  (set! arm 0.5)\n  (set! arm -0.5)\n  (set! arm 0))\n(mock-wave-then-settle)\n(= arm 0)")) :explanation "Each rung projects a visible signal outward. Arm; PA system; beacon. Message reaches many observers at once." :meta "Wave is a broadcast, not a private message.") (:eng "One-to-many signal; unaddressed." :math "Time-varying sinusoid emitted into a shared channel." :cs "Broadcast message on a shared bus."))
  :row-4-proof (
   (:claim "part/wave is bounded — always returns to rest angle at cycle-end, regardless of amplitude."
    :program "(part/wave 'hero)\n(world/step) (world/step) (world/step) (world/step)\n(display #t)"
    :eng-program "(define (test-return-across-mascots mascots)\n  ;; every mascot waves; verify no error after cycle\n  (for-each (lambda (m) (part/wave m)) mascots)\n  (world/step) (world/step) (world/step) (world/step)\n  (map (lambda (m) 'ok) mascots))\n(test-return-across-mascots '(mascot-lead mascot-second mascot-third))"
    :math-program "(define (wave-arm-angle t T amp) (* amp (sin (* 6.28318 (/ t T)))))\n;; Full period return: θ(t + T) = θ(t). At t=T, angle returns to θ(0) = 0.\n(< (abs (- (wave-arm-angle 1.0 1.0 0.5) (wave-arm-angle 0 1.0 0.5))) 0.001)"
    :cs-program "(define arm 0)\n(define (mock-wave-then-settle)\n  (set! arm 0.5)\n  (set! arm -0.5)\n  (set! arm 0))\n(mock-wave-then-settle)\n(= arm 0)"
    :invariant "∀ sprite s. arm(wave(s), t+T) = rest."
    :meta "Bounded-return. If it failed, waving would leave the arm mid-oscillation. Falsifier: any state where arm remains non-rest past cycle-end.")
   (:eng "Wave is safe to fire-and-forget; no cleanup needed." :math "Periodic function that closes on rest angle." :cs "Bounded effect with self-cleanup.")
)
  :row-5-emergence (
   (:base "part/wave oscillates the arm in a greeting cycle."
    :composition "(define (shopkeeper-greeting shop player)\n  (part/turn shop) (part/look-toward shop player) (part/wave shop) (part/expression shop 'smile) (list 'greeting shop))\n(shopkeeper-greeting 'shopkeeper 'hero)"
    :eng-composition "(define (parade-route floats crowd-checkpoints)\n  ;; Each float waves at every checkpoint along the route.\n  (for-each (lambda (chk)\n              (for-each (lambda (f) (part/turn f) (part/wave f)) floats))\n            crowd-checkpoints))\n(parade-route '(float-a float-b) '(main-street town-square finish-line))"
    :math-composition "(define (wave-pulse-train pulses T amp)\n  ;; N pulses at intervals T; total signal is sum of shifted sines.\n  (map (lambda (i) (list :pulse i :peak-time (* i T) :amp amp))\n       '(0 1 2 3 4)))\n(length (wave-pulse-train 5 1.0 0.5))"
    :cs-composition "(define wave-log '())\n(define (traced-wave mascot)\n  (part/wave mascot)\n  (set! wave-log (cons mascot wave-log)))\n(traced-wave 'mascot-a)\n(traced-wave 'mascot-b)\n(length wave-log)"
    :emergent "Full NPC hello — turn + gaze + wave + smile + dialogue-event composes into 'a warm merchant greeting.'"
    :meta "Family: multi-modal-social-emission. Same shape as an OS notification firing sound + banner + badge on the same event.")
    (:eng "OS-notification bundle; sound + banner + badge." :math "Product of independent modalities." :cs "Multi-modal broadcast.")
))

