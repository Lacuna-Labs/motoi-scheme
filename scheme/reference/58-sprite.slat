;;; 58-sprite.slat — Motoi Scheme Reference · Chapter 58 · library sprite
;;;
;;; 4 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library sprite — 4 verbs.")

(chapter :number "58" :library "sprite" :verb-count 4 :training-eligible #t)

(verb :name "sprite/address" :std "Motoi" :library "sprite" :tier "core" :kind "pure" :signature "(sprite/address sprite-ref petal-ref) -> cell-coord"
  :summary "Resolve a named sprite + petal-ref to a cell coordinate in the sprite's frame."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(sprite/address 'hero 'head)" :note "Cell coord for hero's head petal.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((h (sprite/address 'hero 'head))) h)" :note "Bind for reuse.")
    (:dialect "motoi" :tier "expert"       :code "(define (petal-map sprite refs) (map (lambda (r) (list r (sprite/address sprite r))) refs))\n(petal-map 'hero (list 'head 'hand 'foot))" :note "Build a per-petal coord table."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(let ((coord (sprite/address 'hero 'head))) (display coord))"
     :math-program "(define (address-fn sprite ref) (sprite/address sprite ref))\n(address-fn 'hero 'head)"
     :cs-program "(define (safe-address s r) (if (and (symbol? s) (symbol? r)) (sprite/address s r) (error 'bad-args)))\n(safe-address 'hero 'head)"
     :problem "Draw a hat on the hero's head — need the head's cell coordinate at any current animation frame."
     :explanation "eng: rig-attach point. math: sprite × ref → coord. cs: type-guarded resolve."
     :meta "Reach for sprite/address and NOT hardcoded coord: coord shifts by frame; sprite/address always resolves to current frame's petal cell.")
    (:eng "Attachment points survive animation." :math "Lookup function in name×name space." :cs "Named-coordinate resolution."))
  :row-3-dimension (
    (:setup "Named-anchor resolution: name-pair → coordinate."
     :rungs (
       (:domain "engineering"  :code "(sprite/address 'hero 'head)")
       (:domain "mathematics"  :code "(define (address-fn sprite ref) (sprite/address sprite ref))\n(address-fn 'hero 'head)")
       (:domain "cs / dispatch" :code "(define (address-fn sprite ref) (sprite/address sprite ref))\n(address-fn 'hero 'head)"))
     :explanation "Direct, canonicalized, parsed dispatch."
     :meta "Nominal → coordinate.")
    (:eng "Attachment resolves anchors, not raw coords." :math "Total function in name × name domain (when refs exist)." :cs "Name resolution — DNS-like."))
  :row-4-proof (
    (:eng-program "(equal? (sprite/address 'hero 'head) (sprite/address 'hero 'head))"
     :math-program "(define (deterministic? s r) (equal? (sprite/address s r) (sprite/address s r)))\n(deterministic? 'hero 'head)"
     :cs-program "(define (returns-coord? c) (or (list? c) (pair? c)))\n(returns-coord? (sprite/address 'hero 'head))"
     :claim "Deterministic within a frame; returns a cell-coord."
     :invariant "∀ s r. sprite/address(s, r) = sprite/address(s, r) within a frame"
     :meta "Pattern: pure name-resolution.")
    (:eng "Cacheable within a frame." :math "Function-shape lookup." :cs "Pure resolver."))
  :row-5-emergence (
    (:eng-composition "(define (attach-hat hero hat) (display (list 'draw-at (sprite/address hero 'head) hat)))\n(attach-hat 'hero 'top-hat)"
     :math-composition "(define (all-petals sprite refs) (map (lambda (r) (sprite/address sprite r)) refs))\n(all-petals 'hero (list 'head 'hand))"
     :cs-composition "(define (rig-mount sprite mounts) (for-each (lambda (m) (display (list 'mount (sprite/address sprite (car m)) (cadr m)))) mounts))\n(rig-mount 'hero (list (list 'head 'hat)))"
     :base "sprite/address resolves petal names to coords."
     :emergent "Compositions: eng attachment, math petal-map, cs rig-mount."
     :meta "Family: named-anchor rigging.")
    (:eng "Attachments stay with the rig across frames." :math "Bulk resolution over ref list." :cs "Rig-mount pipeline."))
)

(verb :name "sprite/landmarks" :std "Motoi" :library "sprite" :tier "core" :kind "pure" :signature "(sprite/landmarks sprite-ref) -> list"
  :summary "List all named anchor points (petals) defined on a sprite."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(sprite/landmarks 'hero)" :note "List of petal names.")
    (:dialect "motoi" :tier "intermediate" :code "(length (sprite/landmarks 'hero))" :note "Count of petals.")
    (:dialect "motoi" :tier "expert"       :code "(define (petal-coords sprite)\n  (let ((landmarks (list 'head 'hand 'foot)))\n    (map (lambda (p) (list p (sprite/address sprite p))) landmarks)))\n(petal-coords 'hero)" :note "Full anchor map."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define petals (sprite/landmarks 'hero))\n(length petals)"
     :math-program "(define (petal-set s) (sprite/landmarks s))\n(petal-set 'hero)"
     :cs-program "(define (safe-landmarks s) (if (symbol? s) (sprite/landmarks s) (error 'need-symbol)))\n(safe-landmarks 'hero)"
     :problem "Rig-tool needs to enumerate every attachment point on a sprite."
     :explanation "eng: enumerate anchors. math: set of names. cs: type-guarded enumeration."
     :meta "Reach for sprite/landmarks and NOT hardcoded list: landmarks is derived from the sprite; hardcoding drifts as artists edit.")
    (:eng "Rig tools stay in sync with art edits." :math "Enumeration of the petal set." :cs "Introspection API for rigging."))
  :row-3-dimension (
    (:setup "Enumerate members of a named set."
     :rungs (
       (:domain "engineering"  :code "(sprite/landmarks 'hero)")
       (:domain "mathematics"  :code "(define (petal-set s) (sprite/landmarks s))\n(petal-set 'hero)")
       (:domain "cs / dispatch" :code "(define (petal-set s) (sprite/landmarks s))\n(petal-set 'hero)"))
     :explanation "Direct, set-comprehension, parsed dispatch."
     :meta "Enumeration of index set.")
    (:eng "Data-driven rigging." :math "Set of anchor names." :cs "Reflection-like introspection."))
  :row-4-proof (
    (:eng-program "(equal? (sprite/landmarks 'hero) (sprite/landmarks 'hero))"
     :math-program "(define (deterministic-set? s) (equal? (sprite/landmarks s) (sprite/landmarks s)))\n(deterministic-set? 'hero)"
     :cs-program "(define (returns-list? l) (list? l))\n(returns-list? (sprite/landmarks 'hero))"
     :claim "Deterministic list of petal names for the sprite."
     :invariant "∀ s. sprite/landmarks(s) = sprite/landmarks(s) ∧ list?"
     :meta "Pattern: pure enumeration.")
    (:eng "Stable across reads within a frame." :math "Set enumeration function." :cs "Introspection return list."))
  :row-5-emergence (
    (:eng-composition "(define (validate-rig sprite required)\n  (let ((known (list 'head 'hand 'foot)))\n    (fold (lambda (r ok) (and ok (member r known))) #t required)))\n(validate-rig 'hero (list 'head 'hand))"
     :math-composition "(define (petal-count sprite) (length (sprite/landmarks sprite)))\n(petal-count 'hero)"
     :cs-composition "(define (introspect-rig sprite)\n  (let ((landmarks (list 'head 'hand 'foot)))\n    (map (lambda (r) (list r (sprite/address sprite r))) landmarks)))\n(introspect-rig 'hero)"
     :base "sprite/landmarks enumerates petals."
     :emergent "Compositions: eng rig-validator, math petal-count, cs introspect-rig."
     :meta "Family: introspection-driven rigging.")
    (:eng "Rig-validator catches missing anchors before runtime." :math "Cardinality via length." :cs "Reflection walker."))
)

(verb :name "sprite/rasterize" :std "Motoi" :library "sprite" :tier "core" :kind "state-change" :signature "(sprite/rasterize cells col row spin sx sy dy alphas) -> integer"
  :summary "Render a sprite's cell cluster to the canvas at position, with rotation, scale, and per-cell alphas."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(define cells (list 'a 'b))\n(sprite/rasterize cells 10 10 0 1 1 0 (vector 1.0))" :note "Baseline: no spin/scale, full alpha.")
    (:dialect "motoi" :tier "intermediate" :code "(define cells (list 'a 'b 'c 'd))\n(define alphas (vector 1.0 1.0 1.0 1.0))\n(sprite/rasterize cells 50 50 (/ 3.14 4) 2 2 0 alphas)" :note "45° spin, 2× scale.")
    (:dialect "motoi" :tier "expert"       :code "(define (fx-stamp cells origin spin scale) (sprite/rasterize cells (car origin) (cadr origin) spin scale scale 0 (make-vector (length cells) 1.0)))\n(fx-stamp (list 'a 'b) (list 0 0) 0 1)" :note "Named wrapper for common FX stamp."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define cells (list 'a 'b))\n(sprite/rasterize cells 10 10 0 1 1 0 (vector 1.0 1.0))"
     :math-program "(define cells (list 'a 'b))\n(define x 10) (define y 20) (define theta 0) (define sx 1) (define sy 1)\n(define alphas (vector 1.0 1.0))\n(sprite/rasterize cells x y theta sx sy 0 alphas)"
     :cs-program "(define (safe-raster cells x y) (if (list? cells) (sprite/rasterize cells x y 0 1 1 0 (vector 1)) (error 'need-cells)))\n(safe-raster (list 'a) 0 0)"
     :problem "Stamp a rotated, scaled sprite at a position with per-cell blending."
     :explanation "eng: stamp with FX. math: affine transform + alpha. cs: type-guarded raster."
     :meta "Reach for sprite/rasterize and NOT low-level draw-cell: raster batches cells and applies the transform once per cluster.")
    (:eng "One call = one FX stamp; batched." :math "Rotation θ + scale (sx,sy) + per-cell α." :cs "Vectorized raster call."))
  :row-3-dimension (
    (:setup "Batched raster: (cluster, transform, alphas) → pixels."
     :rungs (
       (:domain "engineering"  :code "(define (returns-count? n) (integer? n))\n(returns-count? (sprite/rasterize (list 'a) 0 0 0 1 1 0 (vector 1)))")
       (:domain "mathematics"  :code "(define (returns-count? n) (integer? n))\n(returns-count? (sprite/rasterize (list 'a) 0 0 0 1 1 0 (vector 1)))")
       (:domain "cs / dispatch" :code "(define (returns-count? n) (integer? n))\n(returns-count? (sprite/rasterize (list 'a) 0 0 0 1 1 0 (vector 1)))"))
     :explanation "Direct, math-typed transform, parsed dispatch."
     :meta "Batched affine raster.")
    (:eng "One rig call, one composite stamp." :math "Affine transform on cluster." :cs "Draw-call batching."))
  :row-4-proof (
    (:eng-program "(define cells (list 'a 'b))\n(integer? (sprite/rasterize cells 0 0 0 1 1 0 (vector 1.0)))"
     :math-program "(define (returns-count? n) (integer? n))\n(returns-count? (sprite/rasterize (list 'a) 0 0 0 1 1 0 (vector 1)))"
     :cs-program "(define (deterministic-shape? cells) (equal? (sprite/rasterize cells 0 0 0 1 1 0 (vector 1)) (sprite/rasterize cells 0 0 0 1 1 0 (vector 1))))\n(deterministic-shape? (list 'a))"
     :claim "Returns count of stamped cells; deterministic for identical args within a frame."
     :invariant "∀ cells x y θ sx sy dy α. rasterize(...) ∈ ℤ ∧ deterministic within frame"
     :meta "Pattern: batched-effect emit with count.")
    (:eng "Return count witnesses how many cells actually stamped." :math "Integer count of stamps." :cs "Draw-count return."))
  :row-5-emergence (
    (:eng-composition "(define (stamp-with-fx cells origin spin) (sprite/rasterize cells (car origin) (cadr origin) spin 1 1 0 (make-vector (length cells) 1.0)))\n(stamp-with-fx (list 'a) (list 0 0) 0)"
     :math-composition "(define (radial-cluster cells origin count) (do ((i 0 (+ i 1))) ((>= i count)) (sprite/rasterize cells (car origin) (cadr origin) (* i (/ 6.28 count)) 1 1 0 (make-vector (length cells) 1.0))))\n(radial-cluster (list 'a) (list 0 0) 8)"
     :cs-composition "(define (batch-stamp positions cells) (for-each (lambda (p) (sprite/rasterize cells (car p) (cadr p) 0 1 1 0 (make-vector (length cells) 1.0))) positions))\n(batch-stamp (list (list 0 0)) (list 'a))"
     :base "sprite/rasterize stamps a cluster."
     :emergent "Compositions: eng named FX wrapper, math radial cluster, cs batch stamp."
     :meta "Family: raster pipelines.")
    (:eng "Named wrappers make raster calls readable." :math "Rotational symmetry via angle increments." :cs "Batched raster pipeline."))
)

(verb
  :name "sprite/define" :std "Motoi"
  :library "sprite"
  :kind "io"
  :signature "(sprite/define name cells petals) -> boolean"
  :summary "Register a named sprite from a list of cells and a list of petals; returns #t on success."
  :impl-status "wired"
  :impl-file "lib/graphics/sprite.js"
  :impl-notes "Registers a sprite under a symbol name. cells is a list of (col row) coordinate pairs describing the sprite's shape; petals is a list of named attachment points (may be empty). Returns #t. Re-defining the same name overwrites the prior definition."
  :explanation "A sprite is a named cluster of cells plus optional petals — attachment anchors like head or hand. sprite/define registers one under a symbol so later verbs (sprite/address, sprite/landmarks, sprite/rasterize) can look it up by name. The cells argument is a list of (col row) pairs; the petals argument names anchor points and may be empty. The verb returns #t to confirm the registration."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(sprite/define 'hero (list (list 1 0) (list 0 1)) (list))" :note "Register a two-cell sprite with no petals; returns #t.")
    (:dialect "motoi" :tier "apprentice" :code "(sprite/define 'dot (list (list 0 0)) (list))" :note "A one-cell sprite. The smallest valid shape.")
    (:dialect "motoi" :tier "intermediate" :code "(and (sprite/define 'a (list (list 0 0)) (list))\n     (sprite/define 'b (list (list 1 1)) (list)))" :note "Two definitions both succeed: #t.")
    (:dialect "motoi" :tier "expert" :code "(define (define-column name h)\n  (sprite/define name\n    (map (lambda (r) (list 0 r)) (iota h))\n    (list)))\n(define-column 'pillar 3)" :note "Build a vertical sprite programmatically from a cell list.")
    (:dialect "motoi" :tier "master" :code "(define (define-all specs)\n  (fold (lambda (spec acc)\n          (and acc (sprite/define (car spec) (cadr spec) (list))))\n        #t specs))\n(define-all (list (list 'x (list (list 0 0)))\n                  (list 'y (list (list 1 0)))))" :note "Register a batch of sprites; #t only if every registration succeeds.")
  )
  :caveats ("Cells are (col row) pairs in the sprite's own frame, not screen pixels." "Re-defining a name silently overwrites the previous sprite of that name." "An empty petals list is valid; petals are optional anchors, not required geometry." "The name is a symbol — quote it.")
  :drawbacks ("No validation that cells form a connected shape; disjoint cells are accepted." "There is no un-define; a name persists once registered until overwritten." "Defining many sprites is one call each — no bulk-register primitive.")
  :usecases ("Register a player, enemy, or projectile shape at load time." "Build sprites procedurally from generated cell lists." "Attach named petals so accessories can be pinned to anchors.")
  :related ("sprite/address" "sprite/landmarks" "sprite/rasterize")
  :learn (:concept "Registration: turning a cell/petal description into a named, addressable sprite." :prerequisites ("(core)") :progression "After sprite/define, use sprite/address to resolve petals and sprite/rasterize to stamp the shape onto the surface.")
  :row-2-audit (
    (:eng-program "(sprite/define 'hero (list (list 1 0) (list 0 1)) (list))"
     :math-program "(define (grid-cells w h)\n  (apply append (map (lambda (r) (map (lambda (c) (list c r)) (iota w))) (iota h))))\n(sprite/define 'block (grid-cells 2 2) (list))"
     :cs-program "(define (define-safe name cells)\n  (if (and (symbol? name) (list? cells))\n      (sprite/define name cells (list))\n      'bad-args))\n(define-safe 'hero (list (list 0 0)))"
     :problem "The operator has a cell list describing a hero shape and needs it addressable by name so draw code can reference 'hero rather than raw coordinates. Which verb registers a named sprite? Not sprite/address (that resolves an already-registered sprite's petal), not sprite/rasterize (that stamps pixels, it does not register a name)."
     :explanation "eng: register the hero directly from its two cells. math: generate a w×h grid of cells and register it as a block. cs: guard the argument shapes before registering."
     :meta "Reach for sprite/define and NOT sprite/rasterize: define REGISTERS a name→shape mapping; rasterize CONSUMES a shape to paint pixels. Registration must precede any addressing or drawing by name.")
    (:eng "Asset loaders register every sprite up front."
     :math "define : Name × Cells × Petals → {registered}."
     :cs "A name-binding IO effect on the sprite table."))
  :row-3-dimension (
    (:setup "Bind a name to a structured description for later lookup."
     :rungs (
       (:domain "sprite table" :code "(sprite/define 'hero (list (list 1 0) (list 0 1)) (list))")
       (:domain "shape from generator" :code "(define (line-cells n) (map (lambda (i) (list i 0)) (iota n)))\n(sprite/define 'bar (line-cells 3) (list))")
       (:domain "batch registry" :code "(fold (lambda (nm acc) (and acc (sprite/define nm (list (list 0 0)) (list)))) #t (list 'a 'b 'c))"))
     :explanation "Rung 1: register one sprite. Rung 2: register a generated shape. Rung 3: fold a batch of registrations into a single success flag."
     :meta "Shape transfers to any name→definition registry.")
    (:eng "Every asset system binds names to definitions."
     :math "A partial function name ↦ shape, extended by each define."
     :cs "Registration into a lookup table."))
  :row-4-proof (
    (:eng-program "(sprite/define 'x (list (list 0 0)) (list))"
     :math-program "(define (define-returns-true? name cells)\n  (eq? (sprite/define name cells (list)) #t))\n(define-returns-true? 'y (list (list 0 0)))"
     :cs-program "(define (redefine-ok? name)\n  (and (sprite/define name (list (list 0 0)) (list))\n       (sprite/define name (list (list 1 1)) (list))))\n(redefine-ok? 'z)"
     :claim "sprite/define returns #t on success, and re-defining a name succeeds again (last definition wins)."
     :invariant "∀ name cells.  (sprite/define name cells petals) = #t when the arguments are well-formed."
     :meta "Successful-registration flag. Falsifier: a well-formed define that returns non-#t. Pattern-name: idempotent overwrite register.")
    (:eng "A #t result lets a loader assert every asset registered."
     :math "The registration relation is total on well-formed inputs."
     :cs "Overwrite semantics keep the table single-valued per name."))
  :row-5-emergence (
    (:eng-composition "(define (register-cast names)\n  (map (lambda (n) (sprite/define n (list (list 0 0)) (list))) names))\n(register-cast (list 'hero 'foe 'coin))"
     :math-composition "(define (define-grid name w h)\n  (sprite/define name\n    (apply append (map (lambda (r) (map (lambda (c) (list c r)) (iota w))) (iota h)))\n    (list)))\n(define-grid 'panel 2 2)"
     :cs-composition "(define (define-all specs)\n  (fold (lambda (s acc) (and acc (sprite/define (car s) (cdr s) (list)))) #t specs))\n(define-all (list (cons 'a (list (list 0 0))) (cons 'b (list (list 1 0)))))"
     :base "sprite/define registers one named sprite."
     :emergent "A sprite-atlas loader emerges: map or fold define over a list of specs to register a whole cast at once. Eng: register the cast. Math: a w×h panel from a coordinate lattice. CS: an all-or-nothing batch register."
     :meta "Family: asset registries — the shape of texture atlases, font tables, and any name-keyed resource pool.")
    (:eng "An atlas is a batch of sprite/define calls."
     :math "The cell grid is a product over two index ranges."
     :cs "fold-and accumulates a batch-success flag.")))
