;;; 31-group.slat — Motoi Scheme Reference · Chapter 31 · library group (REDIRECT)
;;;
;;; The `group` library was folded into `world` on 2026-07-25. Motoi has one
;;; entity collection — the world — so tag-scoped population queries are the
;;; world/* verbs (chapter 72), not a separate group/* namespace. The engine's
;;; wired names win over the paper alias (authorized 2026-07-25).
;;;
;;;   group/count  →  world/count   (chapter 72)
;;;   group/each   →  world/each    (chapter 72)
;;;   group/find   →  world/find    (chapter 72)
;;;
;;; The original 15-program group/* chapter is preserved as a teaching card at
;;; broken-examples/group-folded-into-world.slatl (the fold is not a pure
;;; textual swap — world/each returns #<undefined> and passes entity handles;
;;; world/find returns handles, not integer IDs, and also accepts a predicate).
;;; The verbatim original is archived at scratch/31-group.original.slat.

(dialect :applies ("motoi") :note "Library group folded into world — see chapter 72.")

(chapter :number "31" :library "group" :verb-count 0 :redirect "72-world.slat" :training-eligible #t)

(renamed-library :from "group" :into "world" :chapter "72" :date "2026-07-25"
  :reason "One entity collection (the world); group/* duplicated world/* under a second name."
  :mapping (
    (:from "group/count" :to "world/count"
     :note "Identical contract: pure, allocation-free, returns a nonnegative integer.")
    (:from "group/each"  :to "world/each"
     :note "world/each passes the entity HANDLE and returns #<undefined>; close over a counter to witness call-count.")
    (:from "group/find"  :to "world/find"
     :note "world/find returns a list of entity HANDLES (not IDs) and also accepts a predicate: (world/find pred)."))
  ;; Runnable verification — the mapping demonstrated with the wired world/* names.
  :verify (
    (:dialect "motoi" :tier "novice"
     :code "(begin (world/reset!) (world/spawn 'enemy) (world/spawn 'enemy) (world/count 'enemy))"
     :note "world/count replaces group/count. Returns 2.")
    (:dialect "motoi" :tier "intermediate"
     :code "(begin (world/reset!) (world/spawn 'enemy) (world/spawn 'ally)\n  (= (length (world/find 'enemy)) (world/count 'enemy)))"
     :note "find-length equals count — the same invariant the group chapter proved, now on handles.")
    (:dialect "motoi" :tier "expert"
     :code "(begin (world/reset!) (world/spawn 'enemy) (world/spawn 'enemy)\n  (let ((c 0)) (world/each 'enemy (lambda (e) (set! c (+ c 1)))) (= c (world/count 'enemy))))"
     :note "world/each returns #<undefined>, so witness the traversal with a closed-over counter.")))
