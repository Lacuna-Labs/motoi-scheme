    (:dialect "motoi" :tier "intermediate" :code "(let ((sample-temps '(72 75 73 76 74 71)))\n  (let ((s2 (stat/variance-sample sample-temps)))\n    (list ':s2 s2 ':sd (sqrt s2))))" :note "Compute variance then take sqrt for SD in original units. Confirms sqrt(s2) is stat/sd-sample.")
    (:dialect "motoi" :tier "expert" :code "(define (pooled-variance a b)\n  ;; Pooled variance for two samples of possibly-different size.\n  (let ((na (stat/count a)) (nb (stat/count b))\n        (va (stat/variance-sample a))\n        (vb (stat/variance-sample b)))\n    (/ (+ (* (- na 1) va) (* (- nb 1) vb))\n       (- (+ na nb) 2))))\n(pooled-variance '(2 4 6 8 10) '(3 5 7 9 11))" :note "Pooled variance — combines two samples' variances weighted by their df. Returns 10.")
    (:dialect "motoi" :tier "master" :code "(define (welch-df sa sb)\n  ;; Welch's degrees of freedom for two-sample t-test with unequal variance.\n  (let* ((na (stat/count sa)) (nb (stat/count sb))\n         (va (stat/variance-sample sa))\n         (vb (stat/variance-sample sb))\n         (num (expt (+ (/ va na) (/ vb nb)) 2))\n         (den (+ (/ (expt (/ va na) 2) (- na 1))\n                 (/ (expt (/ vb nb) 2) (- nb 1)))))\n    (if (= den 0) 0 (/ num den))))\n(welch-df '(2 4 6 8 10) '(3 5 7 9 11))" :note "Welch's approximate df for unequal-variance two-sample t. Returns 8 for two equal-size, equal-variance samples — matches classical df = na + nb - 2.")
  )
  :caveats ("Empty dataset returns 'nan; guard with stat/count." "Fewer than 2 data points escalates 'no-spread; cannot estimate variance from a single observation." "Variance is in squared units; take the square root (stat/sd-sample) for intuitive interpretation." "Larger than stat/variance for the same data due to Bessel's correction (n−1 vs n).")
  :drawbacks ("Squared units are hard to interpret; use stat/sd-sample instead." "Bessel's correction introduces slight bias toward the high side in small samples; no unbiased estimator exists." "Sensitive to outliers; a single extreme value dramatically inflates variance." "Assumes continuous or interval data; misleading for categorical or ordinal data.")
