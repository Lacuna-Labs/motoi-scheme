    (:dialect "motoi" :tier "intermediate" :code "(let ((data (list 10 12 11 15 14 13 16 17 18 19)))\n  (list 'min (stat/min data) 'max (stat/max data) 'range (- (stat/max data) (stat/min data))))" :note "Use min and max together to compute range and check data bounds.")
    (:dialect "motoi" :tier "expert" :code "(define (clamp-to-range data lo hi)\n  (map (lambda (x) (if (< x lo) lo (if (> x hi) hi x))) data))\n(clamp-to-range (list 5 10 15 20) 8 18)" :note "Clip values outside [lo, hi]; uses min/max logic to enforce bounds.")
    (:dialect "motoi" :tier "master" :code "(define (min-max-normalize data)\n  ;; Scale all values to [0, 1] using min-max normalization.\n  (let ((lo (stat/min data)) (hi (stat/max data)))\n    (if (= lo hi)\n        (map (lambda (x) 0.5) data)\n        (map (lambda (x) (/ (- x lo) (- hi lo))) data))))\n(min-max-normalize '(10 20 30 40 50))" :note "Returns (0 0.25 0.5 0.75 1.0). When lo=hi (degenerate), returns 0.5 for all values.")
