    :eng-composition "(define (robust-summary data)\n  ;; Chain stat/median with stat/iqr to produce a robust two-number summary.\n  (list ':center (stat/median data) ':spread (stat/iqr data)))\n(robust-summary '(5 6 7 8 9 10 11 12 100))"
    :math-composition "(define (median-above-mean? data)\n  ;; Negative skew: median > mean. Positive skew: median < mean.\n  (let ((med (stat/median data)) (mu (stat/mean data)))\n    (list ':med med ':mean mu\n          ':skew-direction (cond ((> med mu) 'negative-skew)\n                                 ((< med mu) 'positive-skew)\n                                 (else 'symmetric)))))\n(median-above-mean? '(1 2 3 4 5 6 50))"
    :cs-composition "(define (rolling-median data window)\n  ;; Sliding-window median for robust time-series smoothing.\n  (let loop ((rest data) (out '()))\n    (if (< (length rest) window) (reverse out)\n        (loop (cdr rest)\n              (cons (stat/median (list-head rest window)) out)))))\n(rolling-median '(1 2 10 3 4 100 5 6 7) 3)"
    :emergent "A robust median-plus-IQR summary — a resilient descriptor that emerges from chaining stat/median with stat/iqr; the same shape a boxplot's center-and-spread pair uses."
    :meta "This is the robust-summary family — like the boxplot median+IQR, the M-estimator plus MAD; book-of-composition ch on 'robust-summarisation'.")
   (:eng "The pair is the standard for skewed real-world data reporting." :math "(median, IQR) — a scale-and-location robust descriptor." :cs "Two rank-based reductions; O(n log n).")))

(verb
  :name "stat/min" :std "Motoi"
  :library "stat"
  :kind "meta"
  :signature "(stat/min data) -> number | 'nan"
  :summary "Return the smallest value in a dataset."
  :explanation "The minimum is the lower boundary of your data, the smallest value observed. Pair stat/min with stat/max to compute range (max − min), or use both to detect unexpected data bounds. Like max, min is O(n); it returns 'nan for an empty dataset and raises on non-numeric input."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(stat/min (list 3 1 4 1 5 9 2 6))" :note "Returns 1.")
