    :eng-program "(let ((cases '((1 3 5 7 9) (5 5 5) (-3 -1 1 3))))\n  (map (lambda (d) (>= (stat/variance d) 0)) cases))"
    :math-program "(define (var-nonneg? d) (>= (stat/variance d) 0))\n(list (var-nonneg? '(100 200 300)) (var-nonneg? '(-5 -5 -5)) (var-nonneg? '(0.1 0.2 0.3)))"
    :cs-program "(define (computational-form? d)\n  ;; Var(X) = E[X²] - (E[X])² should match stat/variance.\n  (let* ((mean-sq (stat/mean (map (lambda (x) (* x x)) d)))\n         (sq-mean (let ((m (stat/mean d))) (* m m))))\n    (< (abs (- (stat/variance d) (- mean-sq sq-mean))) 1e-10)))\n(list (computational-form? '(1 3 5 7 9)) (computational-form? '(2 2 2 8)))"
