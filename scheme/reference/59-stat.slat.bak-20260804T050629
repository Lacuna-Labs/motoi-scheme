    :math-program "(let ((scores '(72 84 68 91 77 85 63 88)))\n  (list ':mean (stat/mean scores) ':median (stat/median scores)\n        ':skew (- (stat/mean scores) (stat/median scores))))"
    :cs-program "(define (mean-or-default xs fallback)\n  (if (= (stat/count xs) 0) fallback (stat/mean xs)))\n(list (mean-or-default '() 0) (mean-or-default '(10 20 30) 0))"
