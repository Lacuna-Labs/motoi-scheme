    (:dialect "motoi" :tier "intermediate" :code "(let ((data (list 10 12 11 15 14 13 16 17 18 19)))\n  (let ((m (stat/mean data))\n        (med (stat/median data)))\n    (list 'mean m 'median med 'skew (- m med))))" :note "Compare mean and median; close values suggest symmetry, large difference suggests skew.")
    (:dialect "motoi" :tier "expert" :code "(define (standardize data)\n  (let ((mu (stat/mean data))\n        (sigma (stat/sd data)))\n    (map (lambda (x) (/ (- x mu) sigma)) data)))\n(standardize (list 10 20 30 40))" :note "Subtract mean and divide by sd to center at 0 with spread 1; standard preprocessing for machine learning.")
    (:dialect "motoi" :tier "master" :code "(define (incremental-mean xs)\n  ;; Online mean that avoids storing the full list — Welford's running mean.\n  (let loop ((rest xs) (n 0) (mu 0.0))\n    (if (null? rest) mu\n        (let* ((x (car rest))\n               (n1 (+ n 1))\n               (mu1 (+ mu (/ (- x mu) n1))))\n          (loop (cdr rest) n1 mu1)))))\n(list ':online (incremental-mean '(2 4 4 6 8))\n      ':batch  (stat/mean '(2 4 4 6 8)))" :note "Welford online mean gives the same 4.8 as batch stat/mean; useful when the list is too large to store.")
  )
