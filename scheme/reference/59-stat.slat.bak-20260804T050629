   (:eng "Sanity axiom for any variance-like measure, plus the shortcut computational form." :math "Sum of squares is ≥ 0; E[X²]−(E[X])² is the algebraic identity." :cs "Runnable; non-negativity plus a tolerance-based identity check."))
  :row-5-emergence (
   (:base "stat/variance returns σ²."
    :eng-composition "(define (variance-decomposition groups)\n  ;; Chain stat/variance across groups for a within-group variance table.\n  (map (lambda (g) (list (car g) 'var (stat/variance (cadr g)))) groups))\n(variance-decomposition '((a (1 2 3)) (b (10 12 14)) (c (5 5 6))))"
    :math-composition "(define (variance-explained groups)\n  ;; Total variance vs pooled within-group variance — the R²-style ratio.\n  (let* ((all (apply append (map cadr groups)))\n         (total-var (stat/variance all))\n         (within (stat/mean (map (lambda (g) (stat/variance (cadr g))) groups))))\n    (if (= total-var 0) 'undefined\n        (list ':total total-var ':within within\n              ':explained (- 1 (/ within total-var))))))\n(variance-explained '((a (1 2 3)) (b (10 11 12)) (c (20 21 22))))"
    :cs-composition "(define (pooled-variance groups)\n  ;; Sum of within-group squared-deviations divided by total n — the residual variance.\n  (let* ((ns (map (lambda (g) (stat/count (cadr g))) groups))\n         (vars (map (lambda (g) (stat/variance (cadr g))) groups))\n         (n-total (apply + ns)))\n    (if (= n-total 0) 'no-data\n        (/ (apply + (map * ns vars)) n-total))))\n(pooled-variance '((a (1 2 3)) (b (10 12 14)) (c (5 5 6))))"
    :emergent "An ANOVA-style variance decomposition — within-group, pooled, and variance-explained ratios — that emerges from chaining stat/variance across groups; the same family an ANOVA table or a variance-explained (R²) analysis uses."
    :meta "This is the group-variance family — like ANOVA's within-group SS, pooled variance, or feature-variance analysis; book-of-composition ch on 'per-group-decomposition' and book-of-ml ch on ANOVA.")
   (:eng "The decomposition is the classical ANOVA input; the variance-explained ratio is the between/within signal." :math "Within-group SS, pooled σ², and 1 − within/total variance-explained." :cs "O(sum of group sizes); one pass per group.")))

(verb
  :name "stat/variance-sample" :std "Motoi"
  :library "stat"
