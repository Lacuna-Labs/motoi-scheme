    :eng-program "(define d '(3 1 4 1 5 9 2 6 5))\n(define sorted (sort d <))\n(= (stat/median d) (list-ref sorted (quotient (length d) 2)))"
    :math-program "(define (median-invariant-to-shift? xs offset)\n  ;; Median(xs + c) = Median(xs) + c.\n  (< (abs (- (stat/median (map (lambda (x) (+ x offset)) xs))\n             (+ (stat/median xs) offset))) 1e-10))\n(median-invariant-to-shift? '(3 1 4 1 5 9 2 6 5) 100)"
    :cs-program "(define (median-bounded-by-extremes? xs)\n  (let ((m (stat/median xs)))\n    (and (>= m (stat/min xs)) (<= m (stat/max xs)))))\n(list (median-bounded-by-extremes? '(1 2 3 4 5))\n      (median-bounded-by-extremes? '(10 20 30 40)))"
    :invariant "∀ odd-length numeric list. stat/median(xs) = sort(xs)[(|xs|-1)/2]"
