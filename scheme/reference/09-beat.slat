;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library beat — 1 verb.")

(chapter :number "09" :library "beat" :verb-count 1 :training-eligible #t)

(verb :name "beat/on" :std "Motoi" :library "beat" :tier "core" :kind "pure" :signature "(beat/on beat-index [total-beats]) -> record"
  :summary "Return a beat-timing record for the given position in a measure."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(beat/on 1)" :note "Timing record for beat 1 in the default measure.")
    (:dialect "motoi" :tier "intermediate" :code "(beat/on 3 8)" :note "Beat 3 in an 8-beat measure — for compound time.")
    (:dialect "motoi" :tier "expert"       :code "(define (schedule-drum-hits beats) (map (lambda (b) (beat/on b 16)) beats))\n(schedule-drum-hits (list 1 5 9 13))" :note "Schedule kicks on every 4 in a 16-beat measure."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (kick-pattern) (map (lambda (b) (beat/on b)) (list 1 5 9 13)))\n(kick-pattern)"
     :math-program "(define (beat-fractions n) (map (lambda (i) (beat/on i n)) (iota n 1)))\n(beat-fractions 4)"
     :cs-program "(define (safe-beat b n) (if (and (integer? b) (integer? n) (<= 1 b n)) (beat/on b n) (error 'beat-range)))\n(safe-beat 2 4)"
     :problem "Rhythmic events need position-in-measure descriptors that downstream verbs consume as timing."
     :explanation "eng: kick pattern. math: fractional beat positions. cs: range-guarded builder."
     :meta "Reach for beat/on and NOT at-beat: at-beat is action-taking; beat/on is descriptor-returning.")
    (:eng "Descriptors for rhythmic dispatch." :math "Beat position ∈ (1..n)." :cs "Range-validated constructor."))
  :row-3-dimension (
    (:setup "Position-in-cycle descriptor."
     :rungs (
       (:domain "engineering"  :code "(beat/on 1)")
       (:domain "mathematics"  :code "(define (beat-fractions n) (map (lambda (i) (beat/on i n)) (iota n 1)))\n(beat-fractions 4)")
       (:domain "cs / dispatch" :code "(define (beat-fractions n) (map (lambda (i) (beat/on i n)) (iota n 1)))\n(beat-fractions 4)"))
     :explanation "Kicks, fractional grids, parsed patterns."
     :meta "Position-in-cycle is universal.")
    (:eng "Rhythm is universal in games and animation." :math "Beat is discrete position." :cs "Descriptor pattern."))
  :row-4-proof (
    (:eng-program "(define (in-range? b n) (let ((r (beat/on b n))) (and r #t)))\n(in-range? 3 4)"
     :math-program "(define (fractional-sum-eq-1? n) (let ((records (map (lambda (i) (beat/on i n)) (iota n 1)))) (= (length records) n)))\n(fractional-sum-eq-1? 4)"
     :cs-program "(define (deterministic? b n) (equal? (beat/on b n) (beat/on b n)))\n(deterministic? 2 4)"
     :claim "beat/on is pure: same inputs → equal outputs; count matches measure."
     :invariant "∀ b n. beat/on(b, n) = beat/on(b, n) ∧ length(all-beats(n)) = n"
     :meta "Pattern: pure descriptor.")
    (:eng "Deterministic patterns are safe to memoize." :math "Cyclic completeness of beats." :cs "Pure function."))
  :row-5-emergence (
    (:eng-composition "(define (compound-pattern kicks snares) (list :kicks (map beat/on kicks) :snares (map beat/on snares)))\n(compound-pattern (list 1 5) (list 3 7))"
     :math-composition "(define (all-positions n) (map (lambda (i) (beat/on i n)) (iota n 1)))\n(all-positions 8)"
     :cs-composition "(define (validate-pattern beats n) (and (fold (lambda (r b) (and r (<= 1 b n))) #t beats) (map (lambda (b) (beat/on b n)) beats)))\n(validate-pattern (list 1 4 7) 8)"
     :base "beat/on returns a beat-position record."
     :emergent "Compositions: eng compound pattern, math complete cycle, cs validated pattern."
     :meta "Family: rhythmic-pattern construction.")
    (:eng "Compound patterns for drum kits." :math "Complete-cycle enumerations." :cs "Range-validated pattern build."))
)
