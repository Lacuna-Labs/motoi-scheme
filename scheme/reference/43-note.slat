;;; 43-note.slat — Motoi Scheme Reference · Chapter 43 · library note
;;;
;;; 5 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library note — 5 verbs.")

(chapter :number "43" :library "note" :verb-count 5 :training-eligible #t)

(verb :name "note/place-at" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(note/place-at pitch [stave] [clef]) -> null"
  :summary "Place a glyph at the staff slot for a given pitch."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(note/place-at 'c4)" :note "Default stave, default clef.")
    (:dialect "motoi" :tier "intermediate" :code "(note/place-at 'g4 1)" :note "Explicit stave index.")
    (:dialect "motoi" :tier "expert"       :code "(define (place-melody pitches stave) (for-each (lambda (p) (note/place-at p stave)) pitches))\n(place-melody (list 'c4 'e4 'g4) 0)" :note "Place a melodic sequence on one stave."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(for-each note/place-at (list 'c4 'e4 'g4))"
     :math-program "(define (glyph-at p s) (note/place-at p s))\n(glyph-at 'c4 0)"
     :cs-program "(define (safe-place p) (if (symbol? p) (note/place-at p) (error 'need-pitch)))\n(safe-place 'c4)"
     :problem "Score authoring — place glyphs at pitch slots without sounding them."
     :explanation "eng: chord/melody placement. math: pitch → slot. cs: type-guarded placement."
     :meta "Reach for note/place-at and NOT note/strike: place is visual/positional; strike sounds. Confusing the two makes silent scores sound and audible scores blank.")
    (:eng "Visual authoring path only." :math "Pitch → slot function." :cs "Setter-style placement."))
  :row-3-dimension (
    (:setup "Position-a-glyph in a coordinate system."
     :rungs (
       (:domain "engineering"  :code "(note/place-at 'c4)")
       (:domain "mathematics"  :code "(define (pitch-of freq) (if (< freq 262) 'b3 'c4))\n(note/place-at (pitch-of 440))")
       (:domain "cs / dispatch" :code "(define (parse-pitch tok) (string->symbol tok))\n(note/place-at (parse-pitch \"c4\"))"))
     :explanation "Direct, math-derived, parsed."
     :meta "Position marker in slotted grid.")
    (:eng "Visual authoring pipeline." :math "Discrete pitch space embedding." :cs "Grid-cell setter."))
  :row-4-proof (
    (:eng-program "(note/place-at 'c4)\n'placed"
     :math-program "(define (idempotent-visual? p) (note/place-at p) (note/place-at p) 'same-position)\n(idempotent-visual? 'c4)"
     :cs-program "(define (no-return-value?) (equal? (note/place-at 'c4) (if #f #f)))\n(no-return-value?)"
     :claim "Places glyph without sounding; repeated placement is idempotent on visual state."
     :invariant "∀ p. after(place-at(p)) ⇒ staff has glyph at slot-of(p) ; no audio side-effect"
     :meta "Pattern: silent visual write.")
    (:eng "Silent authoring — audio is a separate concern." :math "Idempotent position placement." :cs "Setter on visual state."))
  :row-5-emergence (
    (:eng-composition "(define (chord pitches) (for-each note/place-at pitches))\n(chord (list 'c4 'e4 'g4))"
     :math-composition "(define (arpeggio pitches base) (for-each (lambda (p) (note/place-at (+ p base))) pitches))\n(arpeggio (list 0 4 7) 60)"
     :cs-composition "(define (batch-place table) (for-each (lambda (row) (note/place-at (car row) (cadr row))) table))\n(batch-place (list (list 'c4 0) (list 'e4 0)))"
     :base "note/place-at positions a glyph."
     :emergent "Compositions: eng chord, math arpeggio, cs batch score-load."
     :meta "Family: score authoring.")
    (:eng "Chord is many placements at same time-slot." :math "Arpeggio is sequential placement." :cs "Batch loader for a score."))
)

(verb :name "note/release" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(note/release) -> null"
  :summary "Cut a sustained note."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(note/release)" :note "Cut the currently sustained note.")
    (:dialect "motoi" :tier "intermediate" :code "(note/strike 'c4 1.0)\n(note/release)" :note "Strike then explicitly release.")
    (:dialect "motoi" :tier "expert"       :code "(define (staccato pitch) (note/strike pitch 0.1) (note/release))\n(staccato 'c4)" :note "Wrap strike+release into a staccato note."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(note/strike 'c4 2.0)\n(note/release)"
     :math-program "(define (envelope-close) (note/release))\n(envelope-close)"
     :cs-program "(define (safe-release) (note/release))\n(safe-release)"
     :problem "Sustained note must be cut early — otherwise the ring-out extends past intended duration."
     :explanation "eng: early cut. math: envelope close. cs: side-effect stop."
     :meta "Reach for note/release and NOT let-decay: release is a one-shot stop; let-decay lets the tail sound.")
    (:eng "Fire-and-forget stop." :math "State transition to silent." :cs "Stop-side of sustain envelope."))
  :row-3-dimension (
    (:setup "Terminal signal on an active-note channel."
     :rungs (
       (:domain "engineering"  :code "(note/release)")
       (:domain "mathematics"  :code "(note/release) ; envelope: A→D→S→R (release phase)")
       (:domain "cs / dispatch" :code "(define (should-cut?) #t)\n(when (should-cut?) (note/release))"))
     :explanation "Direct, ADSR release-phase, gated dispatch."
     :meta "Terminal transition on channel.")
    (:eng "Explicit cut vs natural decay." :math "Release phase of envelope." :cs "Signal-termination call."))
  :row-4-proof (
    (:eng-program "(note/release)\n'released"
     :math-program "(define (idempotent-release?) (note/release) (note/release) 'still-released)\n(idempotent-release?)"
     :cs-program "(define (no-value?) (equal? (note/release) (if #f #f)))\n(no-value?)"
     :claim "Cuts any sustained note; idempotent when no note is sustained."
     :invariant "∀ state. after(release) ⇒ no sustained note ∧ release ∘ release = release"
     :meta "Pattern: idempotent stop.")
    (:eng "Safe to call even without an active note." :math "Absorbing state." :cs "Idempotent close."))
  :row-5-emergence (
    (:eng-composition "(define (staccato p) (note/strike p 0.1) (note/release))\n(staccato 'c4)"
     :math-composition "(define (bracketed-note p body) (note/strike p 10) (body) (note/release))\n(bracketed-note 'c4 (lambda () 'work))"
     :cs-composition "(define (rest-then n) (note/release) (n))\n(rest-then (lambda () 'work))"
     :base "note/release is a terminal cut."
     :emergent "Compositions: eng staccato, math bracketed strike+work+release, cs rest-then-work."
     :meta "Family: bracketed audio.")
    (:eng "Staccato = short strike + immediate release." :math "Bracket wraps body between strike and release." :cs "Same shape as file open/close bracket."))
)

(verb :name "note/strike" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(note/strike pitch duration) -> null"
  :summary "Sound a pitch for a duration."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(note/strike 'c4 1.0)" :note "Sound C4 for one beat.")
    (:dialect "motoi" :tier "intermediate" :code "(for-each (lambda (p) (note/strike p 0.5)) (list 'c4 'e4 'g4))" :note "Arpeggio: each note half-beat.")
    (:dialect "motoi" :tier "expert"       :code "(define (metronome pitches durs) (for-each (lambda (p d) (note/strike p d)) pitches durs))\n(metronome (list 'c4 'e4 'g4) (list 1 1 2))" :note "Paired pitch+duration playback."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(note/strike 'c4 1.0)"
     :math-program "(define (fundamental) (let ((bpm (or (audio-bpm) 120))) (note/strike 'c4 (/ 60 bpm))))\n(fundamental)"
     :cs-program "(define (safe-strike p d) (if (and (symbol? p) (number? d)) (note/strike p d) (error 'bad-args)))\n(safe-strike 'c4 1.0)"
     :problem "Playback of a scored note — pitch and duration are both required."
     :explanation "eng: play a pitch. math: fundamental at current tempo. cs: type-guarded strike."
     :meta "Reach for note/strike and NOT note/place-at: strike sounds; place-at only shows.")
    (:eng "Playback path only." :math "Duration is real-valued in beats." :cs "Audio-side setter."))
  :row-3-dimension (
    (:setup "Sound-a-pitch for a duration."
     :rungs (
       (:domain "engineering"  :code "(note/strike 'c4 1.0)")
       (:domain "mathematics"  :code "(define (pitch-of freq) (if (< freq 262) 'b3 'c4))\n(note/strike (pitch-of 440) 1.0)")
       (:domain "cs / dispatch" :code "(define (parse-pitch tok) (string->symbol tok))\n(define (parse-dur tok) (/ (string-length tok) 10.0))\n(note/strike (parse-pitch \"c4\") (parse-dur \"beat\"))"))
     :explanation "Direct, math-derived, parsed."
     :meta "Emit tone with envelope.")
    (:eng "Playback pipeline." :math "Frequency + duration space." :cs "Audio-side write."))
  :row-4-proof (
    (:eng-program "(note/strike 'c4 1.0)\n'struck"
     :math-program "(define (deterministic-duration? p d) (note/strike p d) 'played-for-d)\n(deterministic-duration? 'c4 1.0)"
     :cs-program "(define (returns-null?) (equal? (note/strike 'c4 1.0) (if #f #f)))\n(returns-null?)"
     :claim "Strikes the pitch and sustains for duration; envelope is release-phase-terminated by note/release."
     :invariant "∀ p d>0. strike(p, d) ⇒ audio sounds pitch p for duration d (barring release)"
     :meta "Pattern: timed audio emission.")
    (:eng "Deterministic within a device." :math "Duration is in beat-space at current tempo." :cs "Timed audio side-effect."))
  :row-5-emergence (
    (:eng-composition "(define (arpeggio pitches dur) (for-each (lambda (p) (note/strike p dur)) pitches))\n(arpeggio (list 'c4 'e4 'g4) 0.5)"
     :math-composition "(define (scale root steps dur) (for-each (lambda (s) (note/strike (+ root s) dur)) steps))\n(scale 60 (list 0 2 4 5 7 9 11 12) 0.25)"
     :cs-composition "(define (score notes) (for-each (lambda (n) (note/strike (car n) (cadr n))) notes))\n(score (list (list 'c4 1) (list 'e4 1)))"
     :base "note/strike sounds a timed pitch."
     :emergent "Compositions: eng arpeggio, math scale by intervals, cs score playback."
     :meta "Family: timed melody playback.")
    (:eng "Arpeggio = sequential strikes." :math "Scale is interval-driven strike." :cs "Score is data-driven playback."))
)

;; ═══ 2 top-level pitch-sequence verbs (added 2026-08-02) ═══

(verb :name "chord" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(chord notes [dur] [velocity]) -> unspecified"
  :summary "Mix up to sixteen pitches into one sample-accurate sound and play them together as a chord."
  :status "needs-alfred"
  :status-note "DIVERGENCE: chord returns the interpreter's absent value in EVERY case, including total failure. An empty list, or a list in which no element parses as a pitch, is silently a no-op that is indistinguishable from a successful three-note chord. Contrast tone / sfx / silence, which all return an inspectable record. There is no way for a cart to tell whether a chord sounded. Recorded as it behaves; whether chord should return a record needs Alfred's ruling."
  :examples (
    (:dialect "motoi" :tier "novice"         :code "(begin (chord (list 60 64 67) 0.4 0.5) 'played)" :note "played — a C major triad given as MIDI numbers; chord returns nothing, so begin supplies the value.")
    (:dialect "motoi" :tier "intermediate"   :code "(begin (chord (list 'C4 'E4 'G4) 0.1) 'played)" :note "played — the same triad written as note-name symbols; both spellings are accepted.")
    (:dialect "motoi" :tier "expert"         :code "(length (list (chord (list 60 64) 0.05)))" :note "1 — the return value is the absent value; it exists but prints as nothing, so never test it with equal?."))
  :caveats ("The return value is the interpreter's absent value in every case, success or failure. There is no record to inspect and no error is raised." "An empty list, or a list whose elements do not parse as pitches, is a silent no-op. (chord '() 0.1) and (chord (list 'H9 'Z2) 0.1) both look exactly like a successful call." "Pitches may be MIDI integers or note-name symbols matching letter, optional # or b, then an octave, such as C4, F#3 or Bb-1. Anything else is dropped from the chord without comment." "Duration defaults to 0.4 seconds and velocity to 0.5 — both differ from tone, whose duration default is 0.25." "Unlike tone and sfx, chord does NOT append an event to the sound timeline, so save-cart will not capture it and stop-sound will not cancel it." "Voices beyond the sixteenth are not mixed.")
  :provenance "Motoi-own; lib/media/media.js (playChord in lib/media/audio-driver.js). Authored 2026-08-02 from the implementation."
  :row-2-audit (
    (:eng-program "(begin (chord (list 60 64 67) 0.3 0.5) 'triad)"
     :math-program "(define (major-triad root) (list root (+ root 4) (+ root 7)))\n(begin (chord (major-triad 60) 0.2) (major-triad 60))"
     :cs-program "(define (safe-chord notes)\n  (if (and (pair? notes) (list? notes))\n      (begin (chord notes 0.1) 'sent)\n      'refused))\n(list (safe-chord (list 60 64)) (safe-chord '()))"
     :problem "Three notes must sound as one chord, attacking together. Firing three tone calls in a row does not work: each one spawns its own driver process with tens of milliseconds of startup latency, so the notes arpeggiate audibly instead of striking together."
     :explanation "eng: one call, one mixed buffer, one attack. math: a major triad is the root plus four and seven semitones, and the same list drives the sound and the assertion. cs: because chord cannot report failure, the guard has to check the argument itself before calling — the only place a mistake can still be caught."
     :meta "Reach for chord and NOT three tone calls: three calls means three process spawns, and the accumulated startup latency is the arpeggio you can hear. chord mixes the voices into a single buffer first.")
    (:eng "Simultaneity is a property of the mix, not of how fast you can issue calls." :math "A chord is a set of pitches sharing one onset time; the semitone offsets define its quality." :cs "Batching to eliminate per-call overhead."))
  :row-3-dimension (
    (:setup "Batching several items into one operation so they share a single instant."
     :rungs (
       (:domain "note (chord)"     :code "(begin (chord (list 60 64 67) 0.1) 'mixed)")
       (:domain "mathematics"      :code "(define (interval-set root offsets) (map (lambda (o) (+ root o)) offsets))\n(interval-set 60 (list 0 4 7))")
       (:domain "cs / batched write" :code "(define (batch xs) (list 'one-call (length xs)))\n(batch (list 60 64 67))"))
     :explanation "In music, a chord is several pitches given one shared onset. In set terms, it is a root plus a set of offsets. In systems work, a batched write is several records committed in one call so they share one timestamp. All three trade per-item control for a shared instant."
     :meta "Whenever items must agree on when they happened, batch them rather than issuing them quickly.")
    (:eng "Batching removes the jitter you would otherwise have to tune away." :math "A translate of an offset set." :cs "One syscall instead of n."))
  :row-4-proof (
    (:eng-program "(begin (chord (list 60 64 67) 0.05) 'no-error)"
     :math-program "(equal? (list (chord (list 60 64) 0.05)) (list (chord '() 0.05)))"
     :cs-program "(equal? (list (chord (list 'C4 'E4) 0.05)) (list (chord (list 'H9 'Z2) 0.05)))"
     :claim "chord is total and silent about its outcome: it never raises, and its return value is identical whether it played three notes, zero notes, or was handed nonsense."
     :invariant "forall notes. chord(notes) does not raise, and its value is the absent value regardless of how many pitches parsed"
     :meta "Pattern: total but unobservable. This is the divergence recorded in :status — success and total failure are indistinguishable to the caller.")
    (:eng "A verb that cannot report failure has to be guarded at the call site." :math "The return map is constant, so it carries zero information about the input." :cs "Fire-and-forget with no acknowledgement."))
  :row-5-emergence (
    (:eng-composition "(define (progression roots)\n  (for-each (lambda (r) (chord (list r (+ r 4) (+ r 7)) 0.08)) roots)\n  (length roots))\n(progression (list 60 65 67))"
     :math-composition "(define (invert triad)\n  (append (cdr triad) (list (+ (car triad) 12))))\n(chord (invert (list 60 64 67)) 0.08)\n(invert (list 60 64 67))"
     :cs-composition "(define (voiced root quality)\n  (let ((offsets (if (eq? quality 'minor) (list 0 3 7) (list 0 4 7))))\n    (chord (map (lambda (o) (+ root o)) offsets) 0.08)\n    offsets))\n(list (voiced 60 'major) (voiced 60 'minor))"
     :base "chord mixes a set of pitches into one simultaneous sound."
     :emergent "Map chord over a list of roots and you get a chord progression; add an offset table and you get major, minor and seventh voicings from one verb. That is the harmony family — the layer above single pitches."
     :meta "Family: harmonic construction from an offset table.")
    (:eng "An offset table makes the whole harmonic vocabulary one data structure." :math "Inversion is rotation of the pitch set with an octave transposition." :cs "Table-driven variant construction."))
)

(verb :name "melody" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(melody notes [dur] [velocity]) -> unspecified"
  :summary "Play a list of pitches back to back at a fixed per-note duration, rendered as one continuous buffer."
  :status "needs-alfred"
  :status-note "DIVERGENCE: melody, like chord, returns the interpreter's absent value in every case. An empty list, or a list of unparseable pitches, is a silent no-op indistinguishable from a played phrase. It also does not append to the sound timeline, so stop-sound cannot cancel it and save-cart will not capture it. Recorded as it behaves; whether melody should return a record needs Alfred's ruling."
  :examples (
    (:dialect "motoi" :tier "novice"         :code "(begin (melody (list 60 62 64 65) 0.1) 'played)" :note "played — four MIDI pitches, a tenth of a second each; melody returns nothing, so begin supplies the value.")
    (:dialect "motoi" :tier "intermediate"   :code "(begin (melody (list 'C4 'D4 'E4) 0.05) (melody (list 'E4 'D4 'C4) 0.05) 'done)" :note "done — note-name symbols work too, and the phrase can be played and then reversed.")
    (:dialect "motoi" :tier "expert"         :code "(length (list (melody (list 60 62) 0.05)))" :note "1 — the return value is the absent value; it occupies a list slot but prints as nothing."))
  :caveats ("The return value is the interpreter's absent value in every case, success or failure; no record, no error." "An empty list, or a list of unparseable pitches, is a silent no-op: (melody '() 0.1) and (melody (list 'H9 'Z2) 0.1) are indistinguishable from a played phrase." "Every note gets the SAME duration. There is no per-note rhythm; build rhythm from tone and silence instead." "Duration defaults to 0.2 seconds per note and velocity to 0.5." "Pitches may be MIDI integers or note-name symbols; unparseable entries are dropped silently, which shortens the phrase without warning." "melody does NOT append events to the sound timeline, so stop-sound will not cancel it and save-cart will not capture it.")
  :provenance "Motoi-own; lib/media/media.js (playSequence in lib/media/audio-driver.js). Authored 2026-08-02 from the implementation."
  :row-2-audit (
    (:eng-program "(begin (melody (list 60 62 64 65) 0.12) 'phrase)"
     :math-program "(define (major-scale root)\n  (map (lambda (o) (+ root o)) (list 0 2 4 5 7 9 11 12)))\n(melody (major-scale 60) 0.05)\n(length (major-scale 60))"
     :cs-program "(define (safe-melody notes)\n  (if (and (pair? notes) (list? notes))\n      (begin (melody notes 0.05) 'sent)\n      'refused))\n(list (safe-melody (list 60 62)) (safe-melody '()))"
     :problem "A four-note phrase must play smoothly. Scheduling four separate tone calls leaves audible gaps, because each call pays its own driver startup cost before the note begins."
     :explanation "eng: one call renders the whole phrase into a single buffer so the notes butt up against each other. math: a major scale is a fixed pattern of semitone offsets from the root, and the same list both sounds and is measured. cs: since melody cannot report failure, the guard inspects the argument at the call site."
     :meta "Reach for melody and NOT a loop over tone: the loop pays a process spawn per note, and the gap between notes is the latency you can hear. Reach for chord instead when the notes must sound TOGETHER rather than in order.")
    (:eng "Smoothness comes from rendering the whole phrase at once." :math "A scale is a fixed offset pattern applied to a root." :cs "Batching a sequence into a single render."))
  :row-3-dimension (
    (:setup "Rendering a sequence in one pass so the items butt up against each other with no seam."
     :rungs (
       (:domain "note (melody)"    :code "(begin (melody (list 60 62 64) 0.05) 'rendered)")
       (:domain "mathematics"      :code "(define (arithmetic-run start step n)\n  (let loop ((i 0) (acc '()))\n    (if (= i n) (reverse acc) (loop (+ i 1) (cons (+ start (* i step)) acc)))))\n(arithmetic-run 60 2 4)")
       (:domain "cs / buffered output" :code "(define (join-all parts) (apply string-append parts))\n(join-all (list \"a\" \"b\" \"c\"))"))
     :explanation "In music, a melody is notes rendered end to end with no seam. In arithmetic, a run is generated in one pass from a start and a step. In IO, buffered output concatenates the parts before a single write. All three avoid the per-item cost that would otherwise show up as a gap."
     :meta "Seams appear wherever a sequence is emitted one item at a time through a costly channel.")
    (:eng "One render, no seams." :math "A generated run rather than n independent values." :cs "Buffer then flush."))
  :row-4-proof (
    (:eng-program "(begin (melody (list 60 62 64) 0.03) 'no-error)"
     :math-program "(equal? (list (melody (list 60 62) 0.03)) (list (melody '() 0.03)))"
     :cs-program "(equal? (list (melody (list 'C4 'D4) 0.03)) (list (melody (list 'H9 'Z2) 0.03)))"
     :claim "melody is total and silent about its outcome: it never raises, and its return value is identical whether the phrase played, was empty, or was nonsense."
     :invariant "forall notes. melody(notes) does not raise, and its value is the absent value regardless of how many pitches parsed"
     :meta "Pattern: total but unobservable — the divergence recorded in :status. Falsified only if some argument makes it raise.")
    (:eng "Guard the argument, because the verb will not tell you." :math "A constant return map carries no information about its input." :cs "Fire-and-forget with no acknowledgement."))
  :row-5-emergence (
    (:eng-composition "(define (call-and-response phrase)\n  (melody phrase 0.05)\n  (melody (reverse phrase) 0.05)\n  (length phrase))\n(call-and-response (list 60 62 64 65))"
     :math-composition "(define (transpose phrase semitones)\n  (map (lambda (p) (+ p semitones)) phrase))\n(melody (transpose (list 60 62 64) 7) 0.04)\n(transpose (list 60 62 64) 7)"
     :cs-composition "(define (motif-bank)\n  (map (lambda (m) (melody m 0.03) (length m))\n       (list (list 60 64 67) (list 62 65 69) (list 64 67 71))))\n(motif-bank)"
     :base "melody renders a pitch sequence as one continuous phrase."
     :emergent "Compose melody with reverse and with a transposition map and you get call-and-response and sequence — the two oldest devices in melodic writing — out of one verb plus ordinary list operations. That is the phrase-transformation family."
     :meta "Family: phrase transformation — the melody is data, so every list operation is a musical device.")
    (:eng "Treating the phrase as a list makes every variation a one-liner." :math "Transposition is translation of the pitch sequence." :cs "Map and reverse over a payload list."))
)

