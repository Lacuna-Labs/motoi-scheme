;;; 66-time.slat — Motoi Scheme Reference · Chapter 66 · library time
;;;
;;; 19 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;

(dialect :applies ("motoi") :note "Library time — 19 verbs.")

(chapter :number "66" :library "time" :verb-count 19 :training-eligible #t)

;; ═══ 19 verbs in library time ═══

(verb
  :name "time/across" :std "Motoi"
  :library "time"
  :kind "null"
  :signature "*[verify]*"
  :summary "Combines two time spans or conditions into a unified reactive constraint."
  :explanation "time/across is an undocumented FRP (functional reactive programming) combinator. Based on the module context (frpGrammar.js), it likely combines or sequences time-based reactive specifications. Without official documentation or visible source, the exact signature and semantics are uncertain. It is likely used to span or distribute behavior across multiple time windows or to compose temporal logic. Exercise caution and verify against live usage in the codebase before relying on it."
  :examples (
    (:dialect "motoi" :tier "novice" :code ";; time/across is undocumented; signature unconfirmed.\n;; Demonstrate the placeholder pattern: log the unverified call site.\n(define call-log '())\n(define (audit-across . args)\n  (set! call-log (cons (list 'time/across 'unverified args) call-log))\n  'blocked)\n(audit-across 100 'clause)\n(display call-log) (newline)" :note "Placeholder: records the unverified call site into a log. Replace when signature is confirmed.")
    (:dialect "motoi" :tier "intermediate" :code ";; time/across is undocumented; signature unconfirmed.\n;; Guard that fails loudly rather than returning a fabricated result:\n(define (guarded-across . args)\n  (display 'time-across-not-yet-confirmed) (newline)\n  'blocked)\n(guarded-across 100 'clause)" :note "Sentinel guard: blocks the call and prints a confirmation marker.")
    (:dialect "motoi" :tier "expert" :code ";; time/across is undocumented; signature unconfirmed.\n;; Expert audit: collect all unverified sites and check for confirmation.\n(define unverified-sites '())\n(define (mark-unverified verb)\n  (set! unverified-sites (cons verb unverified-sites))\n  'needs-verification)\n(mark-unverified 'time/across)\n(display (list 'unverified-sites unverified-sites)) (newline)" :note "Expert audit: tracks unverified verb sites for later confirmation sweep.")
  )
  :caveats ("Undocumented; signature and behavior are not officially specified." "Module context suggests FRP composition, but exact mechanics are unclear." "May interact with time/every-ms, time/when, or other time verbs in ways that are not yet characterized.")
  :drawbacks ("Insufficient documentation makes reliable usage difficult." "Likely requires understanding of reactive programming or FRP to use effectively." "Risk of silent failure or unexpected behavior if assumptions about semantics are wrong.")
  :usecases ("*[verify]* — see live codebase examples.")
  :related ("time/every-ms" "time/when" "time/during" "time/delta")
  :learn (:concept "*[verify]* — unknown; verify against documentation." :prerequisites ("*[verify]*") :progression "*[verify]*")
  :row-2-audit (
    (:eng-program "(define call-log '())\n(define (audit-across . args)\n  (set! call-log (cons (list 'time/across 'unverified args) call-log))\n  'blocked)\n(audit-across 100 'clause)\n(display call-log) (newline)"
     :math-program #f
     :math-program-status "honest-null"
     :math-program-notes "No stable invariant exists while the signature is unconfirmed; there is nothing true to state about an undocumented combinator without fabricating its contract."
     :cs-program "(define (guarded-across . args)\n  (display 'time-across-not-yet-confirmed) (newline)\n  'blocked)\n(guarded-across 100 'clause)"
     :problem "The operator has a marked verb they cannot yet ship. Something in the loop calls (time/across ...) and the signature is not confirmed. The audit question is not 'what does it do?' but 'do you have a live example to point at?' — the honest verb to reach for here is the audit itself: refuse to compose against a *[verify]* record, mark the site, and stop."
     :explanation "eng: an audit wrapper records every unverified call site into a log the confirmation sweep can walk. cs: a guard stands in for time/across and prints the blocked sentinel instead of a fabricated result. math: honest-null — no invariant holds while the signature is unknown."
     :meta "Why the guard and not a live call: an unverified verb has no contract, so any test using it would be dishonest — the block preserves the audit trail so the code can be un-blocked later without silent drift.")
    (:eng "Log every unverified call site so the sweep that confirms time/across can reach them."
     :math "Not applicable — no invariant is stable while the signature is unconfirmed."
     :cs "The CS pattern is stub with sentinel — a placeholder that fails loudly rather than a placeholder that returns a plausible-looking value.")
)
  :row-3-dimension (
    (:setup "The unverified-signature shape: a hole in a system where a contract is promised but not yet witnessed."
     :rungs ((:domain "time (unconfirmed FRP combinator)" :code "(define (guarded-across . args)\n  (display 'time-across-not-yet-confirmed) (newline)\n  'blocked)\n(guarded-across 100 'clause)")
             (:domain "logbook (an entry with a TODO tag next to a load-bearing claim)" :code "(list 'entry 'claim-x 'status 'TODO)")
             (:domain "partial function (undefined on part of its domain)" :code "(define call-log '())\n(define (audit-across . args)\n  (set! call-log (cons (list 'time/across 'unverified args) call-log))\n  'blocked)\n(audit-across 100 'clause)\n(display call-log) (newline)"))
     :explanation "In the runtime, an unverified combinator is a hole. In a logbook, a TODO next to a load-bearing claim is a hole. In math, a partial function has a hole where the mapping is not yet defined. All three share the shape 'the label exists, the value does not.'"
     :meta "The shape transfers wherever a namespace commits to a name before committing to a definition.")
    (:eng "Log the hole. Do not paper over it with a mock that returns a plausible number."
     :math "A partial function is total on a subset; the complement of the subset is the hole."
     :cs "The CS analog is unimplemented — the language reserves the symbol; the runtime rejects the call."))
  :row-4-proof (
    (:eng-program "(define (across-audit result)\n  (if (eq? result 'blocked)\n      #t\n      #f))\n(display (across-audit 'blocked)) (newline)"
     :math-program #f
     :math-program-status "honest-null"
     :math-program-notes "There is no non-trivial mathematical claim to prove about an unverified combinator; the only true proposition is the audit property itself, which is an engineering/CS invariant, not a math one."
     :cs-program "(define (stub-exit-visible? result)\n  (memq result '(blocked skipped unverified)))\n(display (stub-exit-visible? 'blocked)) (newline)\n(display (stub-exit-visible? 42)) (newline)"
     :claim "Any call to time/across on this build must not silently succeed with fabricated behavior; the audit is that the call either resolves against a confirmed signature or returns a visible sentinel."
     :invariant "∀ call c of unverified time/across. c returns sentinel ∨ c raises audit event"
     :meta "The pattern is stub-audit: the invariant of a stub is that its exit is always visible. See book-of-code ch09 for search-and-audit correctness. What falsifies: any run where the stub returns a numeric or list value that a downstream verb consumes as if it were real.")
    (:eng "Smoke test: sentinel path fires as expected."
     :math "No non-trivial math content while the signature is unconfirmed."
     :cs "The CS pattern is sentinel-witness. Related: NotImplementedError in Python, panic!(\"unimplemented\") in Rust.")
)
  :row-5-emergence (
    (:eng-composition "(define (guard-verb name thunk)\n  (display (list 'call name 'unverified)) (newline)\n  'blocked)\n(define (feature-flag verb-name enabled? real-thunk)\n  (if enabled?\n      (real-thunk)\n      (guard-verb verb-name real-thunk)))\n(feature-flag 'time/across #f (lambda () (list 'would-run)))"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The feature-flag guard is a control-flow safety wrapper; it carries no mathematical structure to compose while the underlying verb's semantics are unconfirmed."
     :cs-composition "(define backlog '())\n(define (tracked-guard name)\n  (set! backlog (cons name backlog))\n  'blocked)\n(tracked-guard 'time/across)\n(tracked-guard 'time/across)\n(display (length backlog)) (newline)"
     :base "time/across is a placeholder verb with an unconfirmed signature."
     :emergent "feature flag guard — a wrapper that keeps unverified verbs behind a switch so partial builds can still ship the surrounding code"
     :meta "The composition chains a guard with a caller. What emerges is the feature-flag family: hide work-in-progress behind a boolean so the rest of the system stays green. Same family: LaunchDarkly flags, git branches guarded by build IDs, Chrome origin trials. In book-of-composition ch12 this is a foundational safety wrapper."
     :eng "Log every guard fire. The number of guard fires is the size of the audit backlog."
     :math "The composition is a partial function completed with a fallback."
     :cs "The CS pattern name is feature flag. Familiar analogs: if(FEATURE_X_ENABLED), config-driven dispatch.")
))

(verb
  :name "time/delta" :std "Motoi"
  :library "time"
  :kind "null"
  :signature "(time/delta unit) -> number"
  :summary "Returns the elapsed time since the last frame in the specified unit (ms, s, m, h, d)."
  :explanation "This verb measures the time delta (difference) between the current frame and the previous frame, returning the interval in a named unit: milliseconds (ms), seconds (s), minutes (m), hours (h), or days (d). It is useful for frame-rate-independent animation and simulation: instead of assuming fixed frame duration, multiply velocity or acceleration by the delta to ensure consistent motion regardless of frame rate. The unit parameter is a symbol (or string) that specifies the output unit."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(on-tick (lambda ()\n  (let ((dt (time/delta 's)))\n    (entity/move! 'ball (list (* 100 dt) 0)))))" :note "Ball moves 100 units per second, regardless of frame rate.")
    (:dialect "motoi" :tier "intermediate" :code "(on-tick (lambda ()\n  (let* ((dt (time/delta 'ms))\n         (acceleration 200)\n         (new-vel (+ (entity/vel 'player) (* acceleration dt 0.001))))\n    (entity/set-vel! 'player new-vel))))" :note "Physics simulation: acceleration applied over milliseconds, scaled to per-frame impulse.")
    (:dialect "motoi" :tier "expert" :code "(define (tick-simulation ctx)\n  (let* ((dt (time/delta 's))\n         (vel (ctx-get 'velocity ctx))\n         (friction 0.99)\n         (new-vel (* vel (expt friction dt)))\n         (pos (+ (ctx-get 'position ctx) (* vel dt))))\n    (next 'tick-simulation (ctx-set 'velocity new-vel (ctx-set 'position pos ctx)))))\n\n(on-tick tick-simulation)" :note "Simulation state machine: delta drives position and velocity decay, independent of frame rate.")
  )
  :caveats ("Unit must be one of: 'ms, 's, 'm, 'h, 'd (or equivalent string symbols)." "Unknown unit may cause an error or 'nan; always validate unit spelling." "First frame may report a large delta if no prior frame time is recorded; initialize timing carefully." "Very slow or paused execution (e.g., debugging breakpoints) may return a large delta; clamp if needed.")
  :drawbacks ("Relies on accurate clock synchronization; system clock skew or manual timing manipulation breaks assumptions." "Conversion between units is fixed; custom units are not supported." "If frame rate varies dramatically, large deltas may cause instability (overshooting). Apply max-delta clamping: (min dt max-dt)." "Not suitable for real-time hard constraints; elapsed time is measured after computation.")
  :usecases ("Frame-rate-independent physics and animation." "Velocity and acceleration simulation." "Adaptive timing loops (slow on low-end devices, fast on high-end)." "Measuring elapsed time in user-friendly units.")
  :related ("time/when" "time/during" "time/every-ms" "on-tick" "frame")
  :learn (:concept "Frame-rate-independent delta time: multiply rates and accelerations by dt to decouple simulation from frame rate." :prerequisites ("on-tick") :progression "Master time/delta for physics; then learn time/every-ms (fixed intervals) and time/when (event timing) for higher-level temporal control.")
  :row-2-audit (
    (:eng-program "(define (step-ball pos vel)\n  (let ((dt (time/delta 's)))\n    (+ pos (* vel dt))))\n(display (step-ball 0 100)) (newline)"
     :math-program "(define (integrate x v dts)\n  (if (null? dts) x\n      (integrate (+ x (* v (car dts))) v (cdr dts))))\n(display (integrate 0 100 '(0.016 0.033 0.016))) (newline)"
     :cs-program "(define (step-with-clock pos vel dt-thunk)\n  (+ pos (* vel (dt-thunk))))\n(display (step-with-clock 0 100 (lambda () 0.02))) (newline)"
     :problem "A ball moves smoothly on a fast machine and stutters on a slow one. The operator's problem is frame-rate coupling: the code assumed each tick was a fixed slice of wall time, and the assumption broke. The audit question is whether the fix uses time/delta (which measures the slice that actually elapsed) or a constant like 1/60 (which lies)."
     :explanation "eng: the step reads actual elapsed seconds and scales velocity by it, so the physical distance is the same at any frame rate. math: integrating v over a list of real slices is the discrete form of ∫ v dt. cs: injecting the clock as a thunk makes the frame-rate dependency explicit and testable."
     :meta "Why time/delta and not a hard-coded 1/60: hard-coding lies on any machine that is not 60 Hz, and every audit of motion on a variable-rate machine will find the drift.")
    (:eng "Log dt every frame. Sudden large dt = pause, breakpoint, or GC stall — motion should clamp or skip."
     :math "Discrete integration: xₙ₊₁ = xₙ + v · dt."
     :cs "The CS pattern is semi-implicit Euler with a variable step. Related: time-based vs frame-based simulation.")
)
  :row-3-dimension (
    (:setup "The elapsed-slice measurement: read the actual amount of a resource consumed rather than assume a constant amount."
     :rungs ((:domain "time (frame delta seconds)" :code "(time/delta 's)")
             (:domain "billing (the metered kilowatt-hour, not the estimated one)" :code "(define (integrate x v dts)\n  (if (null? dts) x\n      (integrate (+ x (* v (car dts))) v (cdr dts))))\n(display (integrate 0 100 '(0.016 0.033 0.016))) (newline)")
             (:domain "calculus (dt as the differential in ∫ v dt)" :code "(define (integrate x v dts)\n  (if (null? dts) x\n      (integrate (+ x (* v (car dts))) v (cdr dts))))\n(display (integrate 0 100 '(0.016 0.033 0.016))) (newline)"))
     :explanation "In the runtime, dt is the real slice of wall time. In utility billing, the meter delta is the real slice of energy. In calculus, dt is the differential. All three share the shape 'observe the slice, do not assume its size.'"
     :meta "The shape transfers wherever a continuous quantity has to be turned into a discrete step.")
    (:eng "Record every slice; the log is the audit trail for any drift claim."
     :math "The integral is the limit of sums of slices; each slice is the measured dt."
     :cs "The CS analog is metered accumulator."))
  :row-4-proof (
    (:eng-program "(define (advance pos vel dts)\n  (let loop ((p pos) (ds dts))\n    (if (null? ds) p (loop (+ p (* vel (car ds))) (cdr ds)))))\n(display (= (advance 0 100 '(0.02 0.02))\n            (advance 0 100 '(0.01 0.03)))) (newline)"
     :math-program "(define (v-sum vel dts) (* vel (apply + dts)))\n(display (= (v-sum 100 '(0.02 0.02))\n            (v-sum 100 '(0.01 0.03)))) (newline)"
     :cs-program "(define (split-invariant vel a b)\n  (= (+ (* vel a) (* vel b)) (* vel (+ a b))))\n(display (split-invariant 100 0.02 0.02)) (newline)\n(display (split-invariant 100 0.01 0.03)) (newline)"
     :claim "Total displacement over two frames equals velocity times the sum of the two deltas, independent of how the deltas are split."
     :invariant "∀ v, ∀ splits (d₁, d₂) with d₁ + d₂ = T. v·d₁ + v·d₂ = v·T"
     :meta "The pattern is distributivity of scalar multiplication over addition. See book-of-math ch04 for linear operations on real numbers. What falsifies: any run where re-splitting the deltas changes the total displacement (which would indicate a rounding bug at the accumulator).")
    (:eng "Smoke test: two splits, same total."
     :math "Distributivity: v·(d₁+d₂) = v·d₁ + v·d₂."
     :cs "The CS pattern is linear accumulator with associative update.")
)
  :row-5-emergence (
    (:eng-composition "(define (with-cap dt cap) (if (> dt cap) cap dt))\n(define (step-clamped pos vel)\n  (let ((dt (with-cap (time/delta 's) 0.1)))\n    (+ pos (* vel dt))))\n(display (step-clamped 0 100)) (newline)"
     :math-composition "(define (with-cap dt cap) (min dt cap))\n(display (with-cap 0.5 0.1)) (newline)\n(display (with-cap 0.02 0.1)) (newline)"
     :cs-composition "(define spikes 0)\n(define (with-cap dt cap)\n  (if (> dt cap) (begin (set! spikes (+ spikes 1)) cap) dt))\n(with-cap 0.5 0.1)\n(with-cap 0.02 0.1)\n(with-cap 0.9 0.1)\n(display spikes) (newline)"
     :base "time/delta returns the elapsed time since the previous frame."
     :emergent "clamped integrator — a step function that never advances by more than a bounded slice, so a hitch does not throw a body through a wall"
     :meta "The composition chains time/delta with a clamp. What emerges is the safe-step family: bound the update so a spike in dt does not violate a collision invariant. Same family: rate limiters, watchdog timeouts, max-step ODE solvers. In book-of-composition ch08 this is the bounded-update shape."
     :eng "Log the count of clamp fires. A spike in the count means the machine is stuttering."
     :math "The composition is min(dt, cap) fed into a linear update."
     :cs "The CS pattern name is clamped-integrator. Familiar analogs: fixed-timestep physics loops, capped scroll speed.")
))

(verb
  :name "time/during" :std "Motoi"
  :library "time"
  :kind "meta"
  :signature "(time/during predicate clause) → clause"
  :summary "Create a clause that runs its body only while a condition remains true."
  :explanation "time/during wraps a predicate and a clause together, gating execution: the clause fires each frame only as long as the predicate evaluates to truthy. Once the predicate becomes false, the clause stops running. This is useful for time-boxed animations, conditional behaviors, or guarded state machines. It composes with big-bang and other loop forms."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define (start ctx)\n  (big-bang\n    (list (time/during (lambda () (< (game/frame (ctx-get 'game-id ctx)) 60))\n                       (to-draw (lambda (s) '(render)))))))" :note "Run the render clause only for the first 60 frames.")
    (:dialect "motoi" :tier "intermediate" :code "(define (start ctx)\n  (big-bang\n    (list (time/during (lambda () (ctx-get 'is-active? ctx))\n                       (to-draw (lambda (s) '(render))))\n          (on-key (lambda (k s) s)))))" :note "Render while is-active? is true in state; other clauses run unconditionally.")
    (:dialect "motoi" :tier "expert" :code "(define (start ctx)\n  (let ((game-id (big-bang\n                   (list (time/during\n                          (lambda () (and (ctx-get 'running? ctx)\n                                         (> (ctx-get 'health ctx) 0)))\n                          (to-draw (lambda (s) (paint-grid s))))\n                        (time/until (lambda () (= (ctx-get 'health ctx) 0))\n                                    (to-draw (lambda (s) '(game-over))))))))\n    game-id))" :note "Nest time/during and time/until to model a two-phase loop: active gameplay, then game-over screen.")
  )
  :caveats ("The predicate is re-evaluated every frame; side-effects in the predicate will run each frame." "If the predicate is false on the first frame, the clause never runs." "Once false, the clause remains dormant for the rest of the loop; there is no re-activation.")
  :drawbacks ("For one-time delayed actions, time/until or time/when may be clearer." "Predicates that depend on mutable state must be careful about state consistency.")
  :usecases ("Conditional animations that stop when a flag becomes false." "Guarding a rendering phase while an entity is alive." "Time-boxing a behavior: run input handling only during active gameplay.")
  :related ("time/until" "time/when" "time/every-ms" "big-bang" "to-draw" "on-key")
  :learn (:concept "Conditional gate on a clause: predicate-driven activation." :prerequisites ("big-bang" "to-draw") :progression "Learn time/until next (the inverse — run until a condition), then time/when (one-shot trigger).")
  :row-2-audit (
    (:eng-program "(define (start ctx)\n  (big-bang\n    (list (time/during (lambda () (ctx-get 'is-active? ctx))\n                       (on-key (lambda (k s) s))))))\n(display 'started) (newline)"
     :math-program "(define (gate pred body t) (if (pred t) (body t) 0))\n(define (active? t) (and (>= t 2) (< t 5)))\n(display (map (lambda (t) (gate active? (lambda (x) 1) t)) '(0 1 2 3 4 5 6))) (newline)"
     :cs-program "(define (during pred body)\n  (lambda (s) (if (pred s) (body s) s)))\n(define gated (during (lambda (s) (> s 0)) (lambda (s) (- s 1))))\n(display (list (gated 3) (gated 0) (gated 5))) (newline)"
     :problem "Input handling should only run while the game is active. The operator's problem is that the on-key clause fires during the game-over screen and lets the player interact with a paused world. The audit question is whether the gate is time/during (dormant while false) or time/when (fires once) — these look similar but time/when would fire the input clause exactly once and then never again."
     :explanation "eng: the on-key clause is wrapped so it is dormant whenever is-active? is false. math: the gate is the indicator function 1_A over the tick axis — it emits the body's value where the predicate holds and 0 elsewhere. cs: the gated combinator passes state through untouched when the predicate is false."
     :meta "Why time/during and not time/when: time/when would fire once and stop; time/during keeps the gate live for the whole loop, opening and closing with the predicate.")
    (:eng "Log the boundary — the tick where the predicate flips — so the audit can confirm the clause went silent at that tick."
     :math "The clause's active set is the preimage of #t under the predicate over the tick sequence."
     :cs "The CS pattern is guarded execution. Related: switch, gate, conditional dispatch.")
)
  :row-3-dimension (
    (:setup "The gated stream: a channel that is only open while a condition holds."
     :rungs ((:domain "time (a clause active while a flag is true)" :code "(define (gate pred body t) (if (pred t) (body t) 0))\n(define (active? t) (and (>= t 2) (< t 5)))\n(display (map (lambda (t) (gate active? (lambda (x) 1) t)) '(0 1 2 3 4 5 6))) (newline)")
             (:domain "audio (a note that sustains while the key is held)" :code "(define (gate pred body t) (if (pred t) (body t) 0))\n(define (active? t) (and (>= t 2) (< t 5)))\n(display (map (lambda (t) (gate active? (lambda (x) 1) t)) '(0 1 2 3 4 5 6))) (newline)")
             (:domain "logic (an indicator function 1_A · f)" :code "(define (gate pred body t) (if (pred t) (body t) 0))\n(define (active? t) (and (>= t 2) (< t 5)))\n(display (map (lambda (t) (gate active? (lambda (x) 1) t)) '(0 1 2 3 4 5 6))) (newline)"))
     :explanation "In the runtime, the clause runs while the predicate holds. In audio, the note sustains while the key is held. In logic, an indicator function is the shape that multiplies a value by 0 or 1 depending on membership. All three share the shape 'value gated by a truth.'"
     :meta "The shape transfers wherever a stream must be windowed by an external condition.")
    (:eng "Record open and close events. The window is the pair (open-tick, close-tick)."
     :math "1_A · f is the indicator-gated function; its integral is the truncated one."
     :cs "The CS analog is windowed stream — the same shape used in reactive-stream libraries."))
  :row-4-proof (
    (:eng-program "(define fired '())\n(define (fire! tag) (set! fired (cons tag fired)))\n(define (during pred body) (if (pred) (body) 'skipped))\n(during (lambda () #f) (lambda () (fire! 't1)))\n(during (lambda () #t) (lambda () (fire! 't2)))\n(display fired) (newline)"
     :math-program "(define (ind a) (if a 1 0))\n(display (= (* (ind #f) 1) 0)) (newline)\n(display (= (* (ind #t) 1) 1)) (newline)\n(display (= (ind #t) (* (ind #t) (ind #t)))) (newline)"
     :cs-program "(define (effect pred body) (if pred (body) '()))\n(display (equal? (effect #f (lambda () 'x)) '())) (newline)\n(display (equal? (effect #t (lambda () 'x)) 'x)) (newline)"
     :claim "If the predicate is #f on tick t, the clause's effect on tick t is empty; if #t, the clause fires as if unwrapped."
     :invariant "∀ tick t. effect(during(P, C), t) = if P(t) then effect(C, t) else ∅"
     :meta "The pattern is guard-preserves-semantics. See book-of-math ch11 for indicator functions and their algebra. What falsifies: any tick where the predicate is false and the clause still leaves a trace.")
    (:eng "Smoke test: fire list contains t2 only."
     :math "Indicator gating is idempotent under composition: 1_A · 1_A = 1_A."
     :cs "The CS pattern is short-circuit.")
)
  :row-5-emergence (
    (:eng-composition "(define (start ctx)\n  (big-bang\n    (list (time/during (lambda () (ctx-get 'phase-a? ctx))\n                       (to-draw (lambda (s) (paint 'phase-a))))\n          (time/during (lambda () (ctx-get 'phase-b? ctx))\n                       (to-draw (lambda (s) (paint 'phase-b)))))))\n(display 'started) (newline)"
     :math-composition "(define (phase t)\n  (cond ((and (>= t 0) (< t 3)) 'a)\n        ((and (>= t 3) (< t 6)) 'b)\n        (else 'idle)))\n(display (map phase '(0 1 2 3 4 5 6))) (newline)"
     :cs-composition "(define (dispatch phase)\n  (cond ((eq? phase 'a) 'paint-a)\n        ((eq? phase 'b) 'paint-b)\n        (else 'paint-idle)))\n(display (map dispatch '(a b a idle))) (newline)"
     :base "time/during runs its clause while a predicate holds."
     :emergent "phase machine — an implicit state machine where mutually exclusive predicates select which clause runs each frame"
     :meta "The composition chains two time/during clauses on disjoint predicates. What emerges is the state-machine family: at any tick, exactly one branch is live. Same family: mode switches, dispatch tables, actor states. In book-of-composition ch07 this is the discriminated-union-over-time pattern."
     :eng "Log the current phase every tick. The log is the state-machine trace."
     :math "The composition is a partition of the tick axis by phase."
     :cs "The CS pattern name is state machine via disjoint guards. Familiar analogs: cond-tables, dispatch on tag.")
))

(verb
  :name "time/every-ms" :std "Motoi"
  :library "time"
  :kind "meta"
  :signature "(time/every-ms milliseconds clause) → clause"
  :summary "Wrap a clause so it fires at most once per N milliseconds."
  :explanation "time/every-ms throttles a clause's execution to a fixed wall-clock interval. The clause is allowed to run at most once every N milliseconds, regardless of frame rate. This decouples behavior from frame rate and is essential for audio polling, network requests, or expensive computations that should not run every frame. The internal timer tracks elapsed wall time, not game frames."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define (start ctx)\n  (big-bang\n    (list (time/every-ms 100\n                         (to-draw (lambda (s) (audio-play 'click)))))))" :note "Play a click sound at most once per 100 milliseconds, decoupled from frame rate.")
    (:dialect "motoi" :tier "intermediate" :code "(define (start ctx)\n  (big-bang\n    (list (time/every-ms 500\n                         (to-draw (lambda (s)\n                                   (let ((count (ctx-get 'poll-count ctx)))\n                                     (ctx-set 'poll-count (+ count 1) s)))))\n          (on-key (lambda (k s) s)))))" :note "Increment a counter every 500ms, while input handling runs every frame.")
    (:dialect "motoi" :tier "expert" :code "(define (start ctx)\n  (big-bang\n    (list (time/every-ms 1000\n                         (to-draw (lambda (s)\n                                   (let ((health (ctx-get 'health s)))\n                                     (if (> health 0)\n                                         (ctx-set 'health (- health 1) s)\n                                         s)))))\n          (time/during (lambda () (ctx-get 'is-active? ctx))\n                       (on-key (lambda (k s) s))))))" :note "Poison damage ticks every second; input handling only while active. Orthogonal time scales.")
  )
  :caveats ("The threshold is wall-clock time, not game frames, so it is immune to frame-rate stutters." "If the loop is paused or suspended, wall time keeps advancing; the clause may fire unexpectedly on resume." "Very small intervals (< 16ms) may appear to fire every frame on 60 Hz displays.")
  :drawbacks ("Cannot be frame-locked; use time/across or on-tick if you need frame-exact timing." "Interval is approximate — actual elapsed time may vary by a few milliseconds.")
  :usecases ("Polling external state at a fixed cadence (e.g., reading a sensor every 200ms)." "Damage or regeneration ticks decoupled from frame rate." "Rate-limiting expensive computations (physics solve, pathfinding) to 30 Hz while rendering at 60 Hz." "Audio-driven behavior (e.g., emit a visual pulse every beat of a song).")
  :related ("time/during" "time/across" "time/when" "on-tick" "audio-beat?")
  :learn (:concept "Wall-clock throttling: decouple behavior from frame rate." :prerequisites ("big-bang" "to-draw" "ctx-get" "ctx-set") :progression "Learn time/across next (frame-locked intervals), then compose with audio verbs like audio-beat?")
  :row-2-audit (
    (:eng-program "(define (start ctx)\n  (big-bang\n    (list (time/every-ms 250\n                         (to-draw (lambda (s) (repath! s)))))))\n(display 'throttled) (newline)"
     :math-program "(define (max-fires window interval)\n  (+ 1 (quotient window interval)))\n(display (max-fires 1000 250)) (newline)"
     :cs-program "(define (throttle interval times)\n  (let loop ((ts times) (last -100000) (fired '()))\n    (cond ((null? ts) (reverse fired))\n          ((>= (- (car ts) last) interval)\n           (loop (cdr ts) (car ts) (cons (car ts) fired)))\n          (else (loop (cdr ts) last fired)))))\n(display (throttle 250 '(0 100 250 300 500 600 750))) (newline)"
     :problem "A pathfinder runs every frame and the frame rate collapses. The operator's problem is that the expensive computation is over-frequent — it does not need 60 Hz, it needs 4 Hz. The audit question is whether the fix uses time/every-ms (wall-clock throttle) or a manual frame counter (which drifts with frame rate)."
     :explanation "eng: the pathfinding clause is wrapped in a 250 ms throttle, firing at most 4 times per second regardless of frame rate. math: the maximum fire count in a window is 1 + ⌊window/interval⌋. cs: a token-bucket-style throttle admits an event only once its interval since the last admitted one has elapsed."
     :meta "Why time/every-ms and not a frame counter: a frame counter throttles by frames-since-last, so on a 30 Hz machine the throttle is half as fast as on a 60 Hz machine; wall-clock throttling is invariant to frame rate.")
    (:eng "Log every fire with a wall timestamp. The gap between fires should be at least the threshold."
     :math "The fire rate is bounded above by 1 / interval per second."
     :cs "The CS pattern is rate limiter — token bucket with one token per interval.")
)
  :row-3-dimension (
    (:setup "The rate limiter: cap the fire frequency of an action."
     :rungs ((:domain "time (a clause capped at 1 fire per N ms)" :code "(define (max-fires window interval)\n  (+ 1 (quotient window interval)))\n(display (max-fires 1000 250)) (newline)")
             (:domain "faucet (a valve with a fixed drip rate)" :code "(define (max-fires window interval)\n  (+ 1 (quotient window interval)))\n(display (max-fires 1000 250)) (newline)")
             (:domain "number theory (the density of a subset of ℕ)" :code "(define (max-fires window interval)\n  (+ 1 (quotient window interval)))\n(display (max-fires 1000 250)) (newline)"))
     :explanation "In the runtime, throttling caps events per second. A faucet caps drops per second. In number theory, a periodic subset has density 1/k. All three share the shape 'events per unit is bounded.'"
     :meta "The shape transfers wherever an unbounded producer must be rate-matched to a bounded consumer.")
    (:eng "Record the observed rate; compare to the target rate."
     :math "The density of the fire set in [0, T] tends to 1 / interval as T → ∞."
     :cs "The CS analog is token bucket — one token replenished per interval, one token spent per fire."))
  :row-4-proof (
    (:eng-program "(define (simulate-throttle events interval)\n  (let loop ((es events) (last -1e9) (count 0))\n    (cond ((null? es) count)\n          ((>= (- (car es) last) interval)\n           (loop (cdr es) (car es) (+ count 1)))\n          (else (loop (cdr es) last count)))))\n(display (<= (simulate-throttle '(0 50 100 150 200 250 300 350 400) 100) 5)) (newline)"
     :math-program "(define (ceil-div a b) (quotient (+ a b -1) b))\n(display (<= 5 (+ 1 (ceil-div 400 100)))) (newline)"
     :cs-program "(define (min-gap-ok? fires interval)\n  (let loop ((fs fires))\n    (cond ((or (null? fs) (null? (cdr fs))) #t)\n          ((< (- (cadr fs) (car fs)) interval) #f)\n          (else (loop (cdr fs))))))\n(display (min-gap-ok? '(0 100 200 300 400) 100)) (newline)"
     :claim "In any window [t₀, t₀ + W], the count of fires is at most ceiling(W / interval)."
     :invariant "∀ window W, ∀ event stream. fires(W) ≤ ⌈W / interval⌉"
     :meta "The pattern is rate bound. See book-of-math ch05 for pigeonhole-style counting arguments. What falsifies: any run where the throttle admits two fires within one interval.")
    (:eng "Smoke test: five events at 100 ms interval over 400 ms is bounded by 5."
     :math "The bound is a consequence of the pigeonhole principle applied to time bins of size interval."
     :cs "The CS pattern is admission control.")
)
  :row-5-emergence (
    (:eng-composition "(define (start ctx)\n  (big-bang\n    (list (time/every-ms 1000\n                         (to-draw (lambda (s) (ctx-set 'ticks (+ (ctx-get 'ticks s) 1) s))))\n          (to-draw (lambda (s) (paint 'countdown (ctx-get 'ticks s)))))))\n(display 'countdown) (newline)"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The cadence-counter is a stateful wall-clock side-effect (a mutable tick incremented on a timer); there is no invariant to compose beyond the rate bound already stated in row 4, so a fresh math composition here would be contrived."
     :cs-composition "(define (make-cadence-counter)\n  (let ((ticks 0))\n    (lambda () (set! ticks (+ ticks 1)) ticks)))\n(define c (make-cadence-counter))\n(display (list (c) (c) (c))) (newline)"
     :base "time/every-ms throttles a clause to a fixed wall-clock cadence."
     :emergent "cadence-driven counter — one clause increments a state at a fixed cadence, another clause reads and renders it, producing a wall-clock counter independent of frame rate"
     :meta "The composition chains time/every-ms with a state update and a renderer. What emerges is the cadence-counter family: an independent tempo that the rest of the app observes. Same family: metronome, cron ticker, blinking cursor. In book-of-composition ch09 this is the tempo-driver pattern."
     :eng "Log the ticks value. It should advance at approximately 1 per second."
     :math "The composition is a step function on the wall-clock axis."
     :cs "The CS pattern name is cadence driver. Familiar analogs: setInterval, cron, drummer thread.")
))

(verb
  :name "time/then" :std "Motoi"
  :library "time"
  :kind "meta"
  :signature "(time/then clause-a clause-b) → clause"
  :summary "Sequentially compose two clauses: run clause-a, then when it completes, run clause-b."
  :explanation "time/then chains two clauses in sequence, like a promise chain or a state transition. The first clause runs until it returns a 'done' signal (or is consumed); then the second clause takes over. This is a fundamental tool for choreography: multi-step animations, narratives, or state machines where each phase must complete before the next begins. It is composable: (time/then a (time/then b c)) chains three clauses."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define (start ctx)\n  (big-bang\n    (list (time/then (to-draw (lambda (s) (paint-grid s)))\n                     (to-draw (lambda (s) '(game-over)))))))" :note "Render the grid, then render game-over. In practice, done signals control the switch.")
    (:dialect "motoi" :tier "intermediate" :code "(define (start ctx)\n  (big-bang\n    (list (time/then (time/every-ms 500\n                                     (to-draw (lambda (s) (audio-play 'tick))))\n                     (to-draw (lambda (s) (display 'event-finished))))\n          (on-key (lambda (k s) s)))))" :note "Emit a tick every 500ms, then emit an event when the first clause finishes.")
    (:dialect "motoi" :tier "expert" :code "(define (start ctx)\n  (big-bang\n    (list (time/then\n            (time/during (lambda () (< (game/frame (ctx-get 'game-id ctx)) 120))\n                        (to-draw (lambda (s) (paint-grid s))))\n            (time/then\n              (time/every-ms 300 (to-draw (lambda (s) (audio-play 'win))))\n              (to-draw (lambda (s) (display 'game-complete)))))\n          (on-key (lambda (k s) s)))))" :note "Choreograph: play grid for 120 frames, then emit victory sound every 300ms, then emit completion event.")
  )
  :caveats ("The done signal is typically generated by time/until or explicitly returned from a clause." "If neither clause ever produces done, the second clause will never run." "Nesting time/then deeply can become hard to read; consider extracted helper predicates.")
  :drawbacks ("Strict sequencing: both clauses cannot run concurrently. Use a list of clauses for parallel behaviors." "Debugging long chains can be tedious; add logging or breakpoints in the transition predicates.")
  :usecases ("Cutscene choreography: intro animation → dialogue → action sequence." "State machines with multi-step behaviors: idle → attack-startup → attack → recovery." "Tutorial sequences: show instruction → wait for confirmation → advance." "Loading screens: splash → progress bar → ready.")
  :related ("time/during" "time/until" "time/when" "big-bang" "done")
  :learn (:concept "Sequential composition of clauses: pipeline choreography." :prerequisites ("big-bang" "to-draw" "time/during") :progression "Combine with time/until and time/when to build expressive timelines.")
  :row-2-audit (
    (:eng-program "(define (start ctx)\n  (big-bang\n    (list (time/then (to-draw (lambda (s) (paint 'hint)))\n                     (to-draw (lambda (s) (paint 'reward)))))))\n(display 'sequenced) (newline)"
     :math-program "(define (schedule-len a b) (+ (length a) (length b)))\n(display (schedule-len '(h1 h2 h3) '(r1 r2))) (newline)"
     :cs-program "(define (run-seq a b done?)\n  (if (done? a) (list 'phase 'b b) (list 'phase 'a a)))\n(display (run-seq 'hint 'reward (lambda (x) #f))) (newline)\n(display (run-seq 'hint 'reward (lambda (x) #t))) (newline)"
     :problem "A tutorial has three steps: show hint, wait for click, show reward. The operator's problem is ordering — the reward keeps flashing before the click. The audit question is whether the sequence uses time/then (which waits for done from step A before starting B) or a naive list of clauses (which run in parallel)."
     :explanation "eng: the sequence renders hint then reward, and reward can only start after hint reports done. math: the schedule length of A then B is length(A) + length(B), a total order over the two clauses. cs: the runner shows only phase A until done? flips, then only phase B."
     :meta "Why time/then and not a list: a list runs both clauses each tick; time/then keeps the second dormant until the first finishes.")
    (:eng "Log the transition tick. Without a transition, the sequence is stuck on step A forever."
     :math "The composition is a total order on two clauses; length of the schedule is length(A) + length(B)."
     :cs "The CS pattern is sequencing — the semicolon of scheduling.")
)
  :row-3-dimension (
    (:setup "The sequential composition: A must finish before B begins."
     :rungs ((:domain "time (two clauses back to back)" :code "(define (schedule-len a b) (+ (length a) (length b)))\n(display (schedule-len '(h1 h2 h3) '(r1 r2))) (newline)")
             (:domain "assembly line (station 1 hands off to station 2)" :code "(define (schedule-len a b) (+ (length a) (length b)))\n(display (schedule-len '(h1 h2 h3) '(r1 r2))) (newline)")
             (:domain "category theory (morphism composition g ∘ f)" :code "(define (schedule-len a b) (+ (length a) (length b)))\n(display (schedule-len '(h1 h2 h3) '(r1 r2))) (newline)"))
     :explanation "In the runtime, A then B. On an assembly line, station 1 then station 2. In category theory, f then g compose to g∘f. All three share the shape 'output of first feeds start of second.'"
     :meta "The shape transfers wherever a workflow demands a completion signal before advancing.")
    (:eng "Log the handoff. The handoff is the join point of A and B."
     :math "Composition is associative: (A ; B) ; C = A ; (B ; C)."
     :cs "The CS analog is monad-style bind — the sequel that consumes a completion."))
  :row-4-proof (
    (:eng-program "(define (schedule ss) ss)\n(define left  (schedule '(a b c)))\n(define right (schedule '(a b c)))\n(display (equal? left right)) (newline)"
     :math-program "(define (then a b) (append a b))\n(display (equal? (then (then '(a) '(b)) '(c))\n                 (then '(a) (then '(b) '(c))))) (newline)"
     :cs-program "(define (flatten-seq . groups) (apply append groups))\n(display (equal? (flatten-seq (flatten-seq '(a) '(b)) '(c))\n                 (flatten-seq '(a) (flatten-seq '(b) '(c))))) (newline)"
     :claim "time/then is associative: sequencing three clauses left-associated equals sequencing them right-associated, up to schedule equivalence."
     :invariant "∀ A B C. (A ; B) ; C ≡ A ; (B ; C)"
     :meta "The pattern is monoidal associativity. See book-of-math ch09 for monoids and their laws. What falsifies: any grouping where the observable schedule differs.")
    (:eng "Smoke test: two groupings, same schedule."
     :math "Associativity is the defining law of a monoid."
     :cs "The CS pattern is associative composition — the shape that makes chains legible.")
)
  :row-5-emergence (
    (:eng-composition "(define (start ctx)\n  (big-bang\n    (list (time/then (to-draw (lambda (s) (paint 'splash)))\n           (time/then (to-draw (lambda (s) (paint 'loading)))\n                      (to-draw (lambda (s) (paint 'ready))))))))\n(display 'boot) (newline)"
     :math-composition "(define (pipeline . stages) (apply append stages))\n(display (pipeline '(splash) '(loading) '(ready))) (newline)"
     :cs-composition "(define (advance stages idx)\n  (if (< idx (length stages)) (list-ref stages idx) 'done))\n(display (map (lambda (i) (advance '(splash loading ready) i)) '(0 1 2 3))) (newline)"
     :base "time/then chains two clauses in order."
     :emergent "boot sequence — a chain of clauses that plays splash, then loading, then ready, forming a startup timeline"
     :meta "The composition chains three time/then. What emerges is the boot-sequence family: a pipeline where each stage yields to the next. Same family: OS boot stages, install wizards, cutscenes. In book-of-composition ch10 this is the linear pipeline pattern."
     :eng "Log each transition. The log is the boot trace."
     :math "The composition is a totally ordered sequence of clauses."
     :cs "The CS pattern name is pipeline. Familiar analogs: shell pipes, promise chains.")
))

(verb
  :name "time/until" :std "Motoi"
  :library "time"
  :kind "meta"
  :signature "(time/until predicate clause) → clause"
  :summary "Run a clause, and signal done once a condition becomes true."
  :explanation "time/until is the complement of time/during: the clause runs freely until the predicate flips true, at which point the clause signals completion. Use this to gate a behavior until an end condition is met (e.g., \"run this animation until the health reaches zero\"). Unlike time/during, which keeps a clause dormant while the predicate is false, time/until keeps the clause active and checks for an end condition. It pairs naturally with time/then to chain behaviors."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define (start ctx)\n  (big-bang\n    (list (time/until (lambda () (= (ctx-get 'health ctx) 0))\n                      (to-draw (lambda (s) (paint-grid s)))))))" :note "Render the grid until health reaches zero, then stop.")
    (:dialect "motoi" :tier "intermediate" :code "(define (start ctx)\n  (big-bang\n    (list (time/until (lambda () (> (game/frame (ctx-get 'game-id ctx)) 300))\n                      (to-draw (lambda (s) (display 'frame s))))\n          (on-key (lambda (k s) s)))))" :note "Emit a frame event every frame, until we've run for 300 frames.")
    (:dialect "motoi" :tier "expert" :code "(define (start ctx)\n  (big-bang\n    (list (time/then\n            (time/until (lambda () (>= (ctx-get 'score ctx) 100))\n                       (to-draw (lambda (s) (paint-grid s))))\n            (time/every-ms 100\n                          (to-draw (lambda (s) (audio-play 'victory)))))\n          (on-key (lambda (k s) s)))))" :note "Play the grid until score hits 100, then play victory sound every 100ms.")
  )
  :caveats ("The predicate is checked after the clause executes, so the clause runs at least once even if the predicate is true on frame 0." "Once the condition is true, the clause is done and does not re-activate." "The state must be updated externally (via ctx-set or other mutations) for the predicate to change.")
  :drawbacks ("For conditions that should prevent the clause from running at all, use time/during instead." "Predicates that depend on external state (e.g., a flag set by another system) can be fragile.")
  :usecases ("Play an animation until a timer expires." "Render a scene until the player health reaches zero." "Accumulate score or resources until a threshold is met." "Run a loop body until an invariant is violated or a goal is reached.")
  :related ("time/during" "time/when" "time/then" "big-bang" "stop-when")
  :learn (:concept "End-condition gating: run until a flag, then hand off." :prerequisites ("big-bang" "to-draw" "ctx-get" "ctx-set") :progression "Combine with time/then to build multi-phase loops; compare with time/during for the dual pattern.")
  :row-2-audit (
    (:eng-program "(define (start ctx)\n  (big-bang\n    (list (time/then\n            (time/until (lambda () (= (ctx-get 'boss-hp ctx) 0))\n                        (to-draw (lambda (s) (paint 'boss))))\n            (to-draw (lambda (s) (paint 'victory)))))))\n(display 'wired) (newline)"
     :math-program "(define (first-true pred ts)\n  (cond ((null? ts) 'never)\n        ((pred (car ts)) (car ts))\n        (else (first-true pred (cdr ts)))))\n(display (first-true (lambda (t) (= t 4)) '(0 1 2 3 4 5))) (newline)"
     :cs-program "(define (run-until pred ts)\n  (let loop ((ts ts) (active '()))\n    (cond ((null? ts) (list 'active (reverse active) 'done 'never))\n          ((pred (car ts)) (list 'active (reverse active) 'done (car ts)))\n          (else (loop (cdr ts) (cons (car ts) active))))))\n(display (run-until (lambda (t) (>= t 3)) '(0 1 2 3 4))) (newline)"
     :problem "A boss fight should stay active until the boss's health hits zero, then hand off to the victory screen. The operator's problem is choosing between time/during (which goes dormant when the predicate is false) and time/until (which stays active until the predicate becomes true, then signals done). The audit question is which one composes with time/then for the handoff."
     :explanation "eng: the boss render runs inside time/until so it stops when boss-hp hits zero, and time/then chains victory after done. math: the done tick is the first t at which the predicate is true — the minimum of a well-ordered set. cs: the runner accumulates the active prefix and emits the done tick."
     :meta "Why time/until and not time/during: time/during would render dormant while the predicate is false — never; time/until produces a done signal that time/then can hook on to.")
    (:eng "Log the boss-hp value and the emitted done event. The audit needs the tick where done fired."
     :math "The active set is a prefix of ticks up to the first t with predicate true."
     :cs "The CS pattern is until-loop with promotion — the loop runs and then emits a completion signal.")
)
  :row-3-dimension (
    (:setup "The until-and-done: run until a condition, then hand off."
     :rungs ((:domain "time (a clause active until predicate true)" :code "(define (first-true pred ts)\n  (cond ((null? ts) 'never)\n        ((pred (car ts)) (car ts))\n        (else (first-true pred (cdr ts)))))\n(display (first-true (lambda (t) (= t 4)) '(0 1 2 3 4 5))) (newline)")
             (:domain "boiler (heat until temperature reached, then stop)" :code "(define (first-true pred ts)\n  (cond ((null? ts) 'never)\n        ((pred (car ts)) (car ts))\n        (else (first-true pred (cdr ts)))))\n(display (first-true (lambda (t) (= t 4)) '(0 1 2 3 4 5))) (newline)")
             (:domain "search (iterate until a solution is found)" :code "(define (first-true pred ts)\n  (cond ((null? ts) 'never)\n        ((pred (car ts)) (car ts))\n        (else (first-true pred (cdr ts)))))\n(display (first-true (lambda (t) (= t 4)) '(0 1 2 3 4 5))) (newline)"))
     :explanation "In the runtime, a clause runs until a flag flips. A boiler heats until the target temperature. A search loop iterates until the goal is found. All three share the shape 'iterate until predicate, then done.'"
     :meta "The shape transfers wherever a workflow needs a completion condition rather than a completion count.")
    (:eng "Log the flip event; the flip is what upstream stages consume."
     :math "The active interval is [t₀, τ) where τ = min { t : pred(t) }."
     :cs "The CS analog is find-then-emit — the same shape as iterators that terminate on a sentinel."))
  :row-4-proof (
    (:eng-program "(define (until pred body)\n  (let loop ((t 0))\n    (if (pred t)\n        (list 'done 'at t)\n        (begin (body t) (loop (+ t 1))))))\n(display (until (lambda (t) (= t 3)) (lambda (t) 'tick))) (newline)"
     :math-program "(define (min-tau pred hi)\n  (let loop ((t 0))\n    (cond ((> t hi) 'unbounded)\n          ((pred t) t)\n          (else (loop (+ t 1))))))\n(display (min-tau (lambda (t) (>= t 3)) 100)) (newline)"
     :cs-program "(define done-count 0)\n(define (until-latch pred hi)\n  (let loop ((t 0))\n    (cond ((> t hi) done-count)\n          ((pred t) (set! done-count (+ done-count 1)) done-count)\n          (else (loop (+ t 1))))))\n(display (until-latch (lambda (t) (= t 3)) 10)) (newline)"
     :claim "time/until with a predicate that becomes true at tick τ produces exactly one done signal, at tick τ."
     :invariant "∀ pred, ∀ body. #done-signals from time/until(pred, body) = 1"
     :meta "The pattern is single-fire termination. See book-of-code ch11 for termination conditions in iterative programs. What falsifies: any run where done fires zero times or more than once.")
    (:eng "Smoke test: done at t=3."
     :math "The termination tick is the minimum of a well-ordered set."
     :cs "The CS pattern is bounded search — always terminates when a predicate flips.")
)
  :row-5-emergence (
    (:eng-composition "(define (start ctx)\n  (big-bang\n    (list (time/then\n            (time/until (lambda () (>= (ctx-get 'score ctx) 100))\n                        (to-draw (lambda (s) (paint 'play s))))\n            (time/every-ms 500 (to-draw (lambda (s) (paint 'confetti))))))))\n(display 'level-loop) (newline)"
     :math-composition "(define (phase-at t tau)\n  (if (< t tau) 'play 'celebrate))\n(display (map (lambda (t) (phase-at t 3)) '(0 1 2 3 4 5))) (newline)"
     :cs-composition "(define (goal-then score threshold)\n  (if (>= score threshold) 'celebrate 'play))\n(display (map (lambda (s) (goal-then s 100)) '(40 99 100 150))) (newline)"
     :base "time/until runs a clause until a condition, then signals done."
     :emergent "level-completion loop — a stage that runs until score threshold, then triggers a celebration loop"
     :meta "The composition chains time/until with time/then and time/every-ms. What emerges is the level-completion family: play, then reward. Same family: quest completion, checkpoint animation, save-game confirmation. In book-of-composition ch11 this is the goal-and-reward pattern."
     :eng "Log the goal-reached tick and the celebration duration."
     :math "The composition is a piecewise schedule with a transition at τ."
     :cs "The CS pattern name is goal-then-effect. Familiar analogs: post-conditions, ACHIEVEMENT UNLOCKED events.")
))

(verb
  :name "time/when" :std "Motoi"
  :library "time"
  :kind "meta"
  :signature "(time/when predicate clause) → clause"
  :summary "Create a one-shot clause that fires once, the first time a condition becomes true."
  :explanation "time/when is a one-time trigger: the wrapped clause runs exactly once, the first frame the predicate evaluates to true. On all other frames, it is inert. This is distinct from time/during (which keeps running while true) and time/until (which runs until true). Use time/when for single-fire events: a doorway opening when the player arrives, a sound cue on a specific beat, or a transition at the exact moment a condition flips."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define (start ctx)\n  (big-bang\n    (list (time/when (lambda () (> (ctx-get 'health ctx) 50))\n                     (to-draw (lambda (s) (audio-play 'alarm)))))))" :note "Play the alarm sound once, the first frame health exceeds 50.")
    (:dialect "motoi" :tier "intermediate" :code "(define (start ctx)\n  (big-bang\n    (list (time/when (lambda () (audio-beat? (ctx-get 'beat-id ctx)))\n                     (to-draw (lambda (s) (sprite-address 'pulse))))\n          (on-key (lambda (k s) s)))))" :note "Trigger a visual pulse exactly once when the audio beat arrives.")
    (:dialect "motoi" :tier "expert" :code "(define (start ctx)\n  (big-bang\n    (list (time/when (lambda () (= (ctx-get 'phase ctx) 'boss-enter))\n                     (to-draw (lambda (s) (display 'boss-dialogue))))\n          (time/during (lambda () (ctx-get 'is-running? ctx))\n                       (on-key (lambda (k s) s))))))" :note "Emit a dialogue event exactly once when the boss-enter phase begins, while input runs continuously.")
  )
  :caveats ("The clause fires on the first frame the predicate is true, not on the frame it becomes true (if the predicate is already true at loop start, it fires immediately)." "Once fired, the clause never runs again, even if the predicate becomes false and then true again." "The predicate is re-evaluated every frame, so side-effects in the predicate will run until it is true.")
  :drawbacks ("Cannot be re-triggered; for repeating events on a condition, use time/during." "If the condition is false for the entire loop, the clause never runs (which is silent — no error).")
  :usecases ("Play a doorway-open sound the first time the player enters a region." "Emit a tutorial hint the moment the player's score hits a milestone." "Trigger a cutscene the first time a boss is encountered." "Sync a visual effect to the first beat of a song.")
  :related ("time/during" "time/until" "time/every-ms" "big-bang" "audio-beat?")
  :learn (:concept "One-shot trigger: fire once when a condition becomes true, then lock." :prerequisites ("big-bang" "to-draw" "time/during") :progression "Understand the trio (time/during, time/until, time/when) as orthogonal gating strategies; combine with time/then for orchestration.")
  :row-2-audit (
    (:eng-program "(define (start ctx)\n  (big-bang\n    (list (time/when (lambda () (crossed-threshold? ctx))\n                     (to-draw (lambda (s) (audio-play 'doorway)))))))\n(display 'wired) (newline)"
     :math-program "(define (edges pred ts)\n  (let loop ((ts ts) (prev #f) (out '()))\n    (cond ((null? ts) (reverse out))\n          (else (let ((now (pred (car ts))))\n                  (loop (cdr ts) now\n                        (if (and now (not prev)) (cons (car ts) out) out)))))))\n(display (edges (lambda (t) (>= t 2)) '(0 1 2 3 4))) (newline)"
     :cs-program "(define fired? #f)\n(define (latch pred t)\n  (cond (fired? 'skip)\n        ((pred t) (set! fired? #t) 'fire)\n        (else 'wait)))\n(display (map (lambda (t) (latch (lambda (x) (>= x 2)) t)) '(0 1 2 3))) (newline)"
     :problem "A doorway sound should play the first time the player crosses the threshold. The operator's problem is that a naive time/during would play the sound every frame the player was on the threshold, producing a chattering buzz. The audit question is whether the fix is time/when (one-shot) or a manual played? flag with time/during (works but is more state to explain)."
     :explanation "eng: the doorway sound is wired to fire exactly once at the first tick crossed-threshold? returns true. math: the edge set of a level signal is the ticks where the predicate rises from false to true — for a monotone predicate this is a singleton. cs: a one-shot latch flips a bit and skips forever after."
     :meta "Why time/when and not time/during + flag: the flag is state the reader has to hold in mind; time/when hides it inside the combinator.")
    (:eng "Log the fire tick. There must be exactly one."
     :math "The fire predicate reduces the trigger stream to its minimum-argument singleton."
     :cs "The CS pattern is one-shot latch.")
)
  :row-3-dimension (
    (:setup "The edge-triggered fire: an event that fires on the transition, not the level."
     :rungs ((:domain "time (a clause that fires once at first true)" :code "(define (edges pred ts)\n  (let loop ((ts ts) (prev #f) (out '()))\n    (cond ((null? ts) (reverse out))\n          (else (let ((now (pred (car ts))))\n                  (loop (cdr ts) now\n                        (if (and now (not prev)) (cons (car ts) out) out)))))))\n(display (edges (lambda (t) (>= t 2)) '(0 1 2 3 4))) (newline)")
             (:domain "doorbell (rings once per press, not once per second held)" :code "(define (edges pred ts)\n  (let loop ((ts ts) (prev #f) (out '()))\n    (cond ((null? ts) (reverse out))\n          (else (let ((now (pred (car ts))))\n                  (loop (cdr ts) now\n                        (if (and now (not prev)) (cons (car ts) out) out)))))))\n(display (edges (lambda (t) (>= t 2)) '(0 1 2 3 4))) (newline)")
             (:domain "differentiation (the derivative of a step is a spike)" :code "(define (edges pred ts)\n  (let loop ((ts ts) (prev #f) (out '()))\n    (cond ((null? ts) (reverse out))\n          (else (let ((now (pred (car ts))))\n                  (loop (cdr ts) now\n                        (if (and now (not prev)) (cons (car ts) out) out)))))))\n(display (edges (lambda (t) (>= t 2)) '(0 1 2 3 4))) (newline)"))
     :explanation "In the runtime, one-shot on first true. A doorbell rings on the press, not on the hold. The derivative of a step is a spike at the transition. All three share the shape 'level → edge.'"
     :meta "The shape transfers wherever a continuous condition must be reduced to a single event.")
    (:eng "Log the transition. Level is the raw signal; edge is what downstream consumes."
     :math "The Dirac delta is the derivative of the Heaviside step."
     :cs "The CS analog is edge-triggered vs level-triggered — the same distinction used in interrupt handlers."))
  :row-4-proof (
    (:eng-program "(define (when-once pred body)\n  (let ((fired? #f))\n    (lambda (t)\n      (cond (fired? 'skip)\n            ((pred t) (set! fired? #t) (body t))\n            (else 'wait)))))\n(define w (when-once (lambda (t) (>= t 2)) (lambda (t) 'fire)))\n(display (list (w 0) (w 1) (w 2) (w 3))) (newline)"
     :math-program "(define (count-fires results) (length (filter (lambda (r) (eq? r 'fire)) results)))\n(display (<= (count-fires '(wait wait fire skip)) 1)) (newline)"
     :cs-program "(define (fire-count pred ts)\n  (let loop ((ts ts) (fired? #f) (n 0))\n    (cond ((null? ts) n)\n          ((and (not fired?) (pred (car ts))) (loop (cdr ts) #t (+ n 1)))\n          (else (loop (cdr ts) fired? n)))))\n(display (fire-count (lambda (t) (>= t 2)) '(0 1 2 3 4 5))) (newline)"
     :claim "time/when fires the clause exactly once across the loop's lifetime, at the first tick where the predicate is true."
     :invariant "∀ pred, ∀ body. #fires(time/when(pred, body)) ≤ 1"
     :meta "The pattern is at-most-once semantics. See book-of-code ch12 for latches and one-shots. What falsifies: any run where the fire count exceeds 1.")
    (:eng "Smoke test: list is (wait wait fire skip)."
     :math "The fire set has cardinality 0 or 1."
     :cs "The CS pattern is idempotent latch — a bit that goes from 0 to 1 and stays.")
)
  :row-5-emergence (
    (:eng-composition "(define (start ctx)\n  (big-bang\n    (list (time/when (lambda () (audio-beat? (ctx-get 'beat-id ctx)))\n                     (to-draw (lambda (s) (paint 'flash))))\n          (time/every-ms 500 (to-draw (lambda (s) (paint 'idle)))))))\n(display 'accented) (newline)"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The accent-on-first-beat is a one-shot decoration riding on a rendering side-effect; the singleton fire-set property already lives in row 4, and there is no further compositional invariant to state without contrivance."
     :cs-composition "(define (accent beats)\n  (let loop ((bs beats) (fired? #f) (out '()))\n    (cond ((null? bs) (reverse out))\n          ((and (car bs) (not fired?)) (loop (cdr bs) #t (cons 'flash out)))\n          (else (loop (cdr bs) fired? (cons 'idle out))))))\n(display (accent '(#f #t #t #f #t))) (newline)"
     :base "time/when fires a clause once, at the first true tick."
     :emergent "accent-on-first-beat — a visual flash on the first beat of a bar, with an idle animation running underneath"
     :meta "The composition chains time/when with a beat detector and a background clause. What emerges is the accent-on-event family: a decoration that fires once on a musical or temporal cue. Same family: notification badges, first-visit tooltips, spawn animations. In book-of-composition ch13 this is the once-and-only-once decorator pattern."
     :eng "Log the first-beat tick; it is the audit point for the accent."
     :math "The composition is a latch riding on a periodic stream."
     :cs "The CS pattern name is one-shot decorator. Familiar analogs: 'shown once' modals, ceremony triggers.")
))

(verb
  :name "time/now" :std "Motoi"
  :library "time"
  :kind "io"
  :dialect "motoi"
  :signature "(time/now) -> integer"
  :arity "0"
  :contract "→ milliseconds since Unix epoch (integer)"
  :summary "Current wall-clock time in milliseconds since 1970-01-01T00:00:00Z."
  :doc "Delegates to Date.now(). Non-deterministic (returns a different value each call). Not monotonic — the system clock may jump. For frame timing use tick/at or game/frame instead."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(time/now)" :note "A large integer, e.g. 1720000000000.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((start (time/now))) (map (lambda (x) (* x x)) (range 0 100)) (- (time/now) start))" :note "Milliseconds elapsed while squaring 100 numbers.")
    (:dialect "motoi" :tier "expert" :code "(define (with-timing thunk)\n  (let ((t0 (time/now)))\n    (let ((result (thunk)))\n      (list 'result result 'ms (- (time/now) t0)))))\n(with-timing (lambda () (apply + (range 0 1000))))" :note "Time a thunk. Returns a list with the result and elapsed ms.")
  )
  :related ("time/iso" "time/today" "tick/at" "game/frame")
  :row-2-audit (
    (:eng-program "(define (bench thunk)\n  (let ((t0 (time/now)))\n    (thunk)\n    (- (time/now) t0)))\n(display (bench (lambda () (apply + (range 0 1000))))) (newline)"
     :math-program "(define (elapsed t0 t1) (- t1 t0))\n(display (elapsed 1720000000000 1720000000042)) (newline)"
     :cs-program "(define (bracket-time clock thunk)\n  (let ((t0 (clock)))\n    (thunk)\n    (- (clock) t0)))\n(define fake (let ((n 1000)) (lambda () (set! n (+ n 5)) n)))\n(display (bracket-time fake (lambda () 'work))) (newline)"
     :problem "An operator wants to measure how long a Motoi thunk takes to run. The problem is choosing the clock: time/now (wall time, non-monotonic) or a frame counter (monotonic but discrete). For a one-shot bench, wall time is enough and the drift risk is negligible. The audit question is that the operator picked the milliseconds-since-epoch clock, not the ISO string."
     :explanation "eng: the bench opens the clock, runs the thunk, and returns the diff in ms. math: elapsed is the difference of two epoch integers, itself an integer. cs: bracketing the clock as an injected function makes the timing testable with a fake clock."
     :meta "Why time/now and not time/iso: iso returns a string; diffing strings is a category error — the operator wants a scalar for subtraction.")
    (:eng "Log the elapsed number. Include the sample count so the log is comparable across runs."
     :math "Elapsed = t₁ - t₀; the difference of two epoch integers is an integer."
     :cs "The CS pattern is bracketed timing — get-clock, run, get-clock.")
)
  :row-3-dimension (
    (:setup "The bracket measurement: take a reading before, take a reading after, subtract."
     :rungs ((:domain "time (wall-clock bench)" :code "(define (elapsed t0 t1) (- t1 t0))\n(display (elapsed 1720000000000 1720000000042)) (newline)")
             (:domain "billing (odometer at trip start and end)" :code "(define (elapsed t0 t1) (- t1 t0))\n(display (elapsed 1720000000000 1720000000042)) (newline)")
             (:domain "calculus (definite integral as boundary difference)" :code "(define (elapsed t0 t1) (- t1 t0))\n(display (elapsed 1720000000000 1720000000042)) (newline)"))
     :explanation "In the runtime, bench measures elapsed ms. On a car trip, the odometer measures elapsed miles. In calculus, the fundamental theorem gives elapsed value as the boundary difference. All three share the shape 'endpoint minus startpoint.'"
     :meta "The shape transfers wherever a total is the difference of two readings.")
    (:eng "Record both endpoints. The difference is only meaningful if both are the same clock."
     :math "Fundamental theorem of calculus: f(b) - f(a) is the net change."
     :cs "The CS analog is start-stop timer."))
  :row-4-proof (
    (:eng-program "(define t0 (time/now))\n(define t1 (time/now))\n(display (>= t1 t0)) (newline)"
     :math-program #f
     :math-program-status "honest-null"
     :math-program-notes "time/now is non-monotonic (an NTP correction can move the wall clock backwards), so there is no total-order invariant to prove; the property is a best-effort probabilistic guarantee, not a theorem. Asserting a mathematical monotonicity claim here would misrepresent the contract."
     :cs-program "(define (non-decreasing? seq)\n  (let loop ((s seq))\n    (cond ((or (null? s) (null? (cdr s))) #t)\n          ((< (cadr s) (car s)) #f)\n          (else (loop (cdr s))))))\n(display (non-decreasing? '(100 100 101 105))) (newline)\n(display (non-decreasing? '(100 99 101))) (newline)"
     :claim "For any two successive calls to time/now in the same thread, the second call returns a value greater than or equal to the first — clock is non-decreasing in the common case."
     :invariant "P(time/now₁ ≤ time/now₂) = 1 in the absence of NTP jump — the guarantee is best-effort, not monotonic"
     :meta "The pattern is best-effort monotonicity. See book-of-code ch14 for clock semantics. What falsifies: an NTP-driven backwards jump between the two calls. This is a known limitation — for hard monotonic timing use game/frame instead.")
    (:eng "Smoke test: t1 ≥ t0. On a healthy machine it passes; on a machine mid-NTP-correction it can fail."
     :math "The wall clock is a random variable perturbed by NTP corrections."
     :cs "The CS pattern is wall clock — distinct from monotonic clock.")
)
  :row-5-emergence (
    (:eng-composition "(define (with-timing thunk)\n  (let ((t0 (time/now)))\n    (let ((result (thunk)))\n      (list 'result result 'ms (- (time/now) t0)))))\n(display (with-timing (lambda () (apply + (range 0 100))))) (newline)"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The profiler wrapper is an observing decorator over a non-deterministic wall-clock read; it preserves the thunk's result but adds no algebraic structure to compose. Any 'functor' framing here would be decorative rather than a runnable law."
     :cs-composition "(define (profiled clock thunk)\n  (let ((t0 (clock)))\n    (let ((r (thunk)))\n      (list 'result r 'ms (- (clock) t0)))))\n(define fake (let ((n 0)) (lambda () (set! n (+ n 3)) n)))\n(display (profiled fake (lambda () 42))) (newline)"
     :base "time/now returns the current wall-clock epoch in ms."
     :emergent "profiler wrapper — a higher-order function that adds timing to any thunk without changing its return path"
     :meta "The composition chains time/now with a thunk and a return-shape. What emerges is the profiler-wrapper family: a decorator that observes without altering. Same family: log wrappers, retry wrappers, cache wrappers. In book-of-composition ch14 this is the observing-decorator pattern."
     :eng "Log the elapsed for every call. Feed the log to the performance dashboard."
     :math "The composition is a functor from thunks to (result, elapsed) pairs."
     :cs "The CS pattern name is profiling decorator. Familiar analogs: Python's @timing, Ruby's Benchmark.measure.")
)
)

(verb
  :name "time/iso" :std "Motoi"
  :library "time"
  :kind "io"
  :dialect "motoi"
  :signature "(time/iso) -> string"
  :arity "0"
  :contract "→ ISO-8601 UTC timestamp with milliseconds"
  :summary "Current time as an ISO-8601 UTC string (e.g. \"2026-07-16T12:34:56.789Z\")."
  :doc "Suffix is always 'Z' — this is UTC, not local time. Use for logs, audit records, cross-machine timestamps."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(time/iso)" :note "Returns something like \"2026-07-16T12:34:56.789Z\".")
    (:dialect "motoi" :tier "intermediate" :code "(list 'logged-at (time/iso) 'event 'user-login)" :note "Tag an audit record with the current timestamp.")
    (:dialect "motoi" :tier "expert" :code "(define (log-line level msg)\n  (list (time/iso) level msg))\n(log-line 'info \"card opened\")" :note "Simple structured log entry.")
  )
  :related ("time/now" "time/today" "time/from-ms")
  :row-2-audit (
    (:eng-program "(define event (list 'card-opened (time/iso) 'card-id 'main))\n(display event) (newline)"
     :math-program "(define (iso-of ms) (list 'iso ms))\n(display (equal? (iso-of 100) (iso-of 100))) (newline)\n(display (equal? (iso-of 100) (iso-of 200))) (newline)"
     :cs-program "(define (zoned? s) (and (string? s) (char=? (string-ref s (- (string-length s) 1)) #\\Z)))\n(display (zoned? \"2026-07-16T12:00:00.000Z\")) (newline)\n(display (zoned? \"2026-07-16T12:00:00\")) (newline)"
     :problem "An operator wants to tag a card-open event with a timestamp that survives copy-paste across time zones. The problem is that time/now returns an integer that requires context to interpret; the audit needs a self-describing string with a Z suffix. The audit question is whether the record uses time/iso (UTC, explicit) or a local-time formatter (which loses the zone)."
     :explanation "eng: the event record carries an ISO timestamp whose Z suffix makes it portable. math: the ms→ISO mapping is injective — equal instants render equal, distinct instants render distinct. cs: a zone check confirms the string is self-describing by testing for the trailing Z."
     :meta "Why time/iso and not time/now: two operators reading the log across time zones can each compute their local interpretation from the Z-suffixed UTC string; an integer requires a shared decoder.")
    (:eng "Log the string. It is self-describing: no unit column needed."
     :math "The mapping from wall time to ISO string is injective on ms precision."
     :cs "The CS pattern is self-describing timestamp — RFC 3339.")
)
  :row-3-dimension (
    (:setup "The self-describing tag: a value that carries its own units."
     :rungs ((:domain "time (ISO 8601 UTC string)" :code "(time/iso)")
             (:domain "shipping (label with unit and value)" :code "(define (iso-of ms) (list 'iso ms))\n(display (equal? (iso-of 100) (iso-of 100))) (newline)\n(display (equal? (iso-of 100) (iso-of 200))) (newline)")
             (:domain "physics (dimensional quantity)" :code "(define (iso-of ms) (list 'iso ms))\n(display (equal? (iso-of 100) (iso-of 100))) (newline)\n(display (equal? (iso-of 100) (iso-of 200))) (newline)"))
     :explanation "In the runtime, ISO strings carry their zone. Shipping labels carry the unit. Physics quantities carry dimensions. All three share the shape 'value plus intrinsic unit.'"
     :meta "The shape transfers wherever a datum crosses a boundary and must be self-interpreting on the other side.")
    (:eng "Prefer self-describing values across boundaries. Loss of context is loss of meaning."
     :math "A dimensioned quantity is a tuple (magnitude, unit); operations respect unit algebra."
     :cs "The CS analog is tagged value — the same shape used in serialization schemes like JSON with type keys."))
  :row-4-proof (
    (:eng-program "(define now-iso (time/iso))\n(define round (time/from-ms (time/to-ms now-iso)))\n(display (equal? now-iso round)) (newline)"
     :math-program "(define (from-ms ms) (list 'iso ms))\n(define (to-ms iso) (cadr iso))\n(define iso (from-ms 1720000000000))\n(display (equal? (from-ms (to-ms iso)) iso)) (newline)"
     :cs-program "(define (round-trip encode decode x) (decode (encode x)))\n(define (enc s) (list 'wrapped s))\n(define (dec w) (cadr w))\n(display (equal? (round-trip enc dec \"2026-07-16T12:00:00.000Z\")\n                 \"2026-07-16T12:00:00.000Z\")) (newline)"
     :claim "time/iso and time/from-ms are mutually round-tripping to millisecond precision: time/from-ms(time/to-ms(iso)) = iso for any iso produced by time/iso in this build."
     :invariant "∀ iso ∈ image(time/iso). time/from-ms(time/to-ms(iso)) = iso"
     :meta "The pattern is round-trip identity. See book-of-math ch10 for inverse pairs. What falsifies: any iso that comes back different — this can happen if precision is lost below ms.")
    (:eng "Smoke test: round equals now-iso."
     :math "The pair (to-ms, from-ms) is a section of an isomorphism on the space of ms-precise timestamps."
     :cs "The CS pattern is invertible encoding.")
)
  :row-5-emergence (
    (:eng-composition "(define (log-line level msg)\n  (list (time/iso) level msg))\n(display (log-line 'info \"card opened\")) (newline)\n(display (log-line 'warn \"slow query\")) (newline)"
     :math-composition "(define (append-log stream rec) (append stream (list rec)))\n(define s1 (append-log '() 'a))\n(define s2 (append-log s1 'b))\n(display (equal? s2 '(a b))) (newline)"
     :cs-composition "(define log '())\n(define (emit level msg) (set! log (cons (list 'ts level msg) log)))\n(emit 'info \"open\")\n(emit 'warn \"slow\")\n(display (length log)) (newline)"
     :base "time/iso returns the current UTC time as an ISO-8601 string."
     :emergent "structured log — a stream of records each tagged with a UTC timestamp, ready for downstream aggregation"
     :meta "The composition chains time/iso with a level and a message. What emerges is the structured-log family: a stream where every record is timestamped and typed. Same family: syslog, journald entries, Elastic log lines. In book-of-composition ch15 this is the timestamped-record pattern."
     :eng "Log every line. The timestamps drive the log query interface."
     :math "The composition is a monoidal append into an ordered stream."
     :cs "The CS pattern name is structured logging. Familiar analogs: logfmt, JSON logs, ndjson.")
)
)

(verb
  :name "time/from-ms" :std "Motoi"
  :library "time"
  :kind "pure"
  :dialect "motoi"
  :signature "(time/from-ms ms) -> string"
  :arity "1"
  :contract "ms is integer → ISO-8601 UTC string"
  :summary "Format a millisecond epoch value as an ISO-8601 UTC string."
  :doc "Inverse of time/to-ms. Useful for rendering a stored timestamp back into a human-readable form."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(time/from-ms 0)" :note "The Unix epoch. Returns \"1970-01-01T00:00:00.000Z\".")
    (:dialect "motoi" :tier "intermediate" :code "(time/from-ms 1720000000000)" :note "Returns \"2024-07-03T09:46:40.000Z\".")
    (:dialect "motoi" :tier "expert" :code "(define (log-with-time ms msg) (list (time/from-ms ms) msg))\n(log-with-time (time/now) 'saved)" :note "Render a captured timestamp for display.")
  )
  :related ("time/to-ms" "time/iso" "time/now")
  :row-2-audit (
    (:eng-program "(define stored-ms 1720000000000)\n(display (time/from-ms stored-ms)) (newline)"
     :math-program "(define (render ms) (list 'utc ms))\n(display (equal? (render 1720000000000) (render 1720000000000))) (newline)"
     :cs-program "(define (render-at-boundary internal) (list 'view internal))\n(define store 1720000000000)\n(display (render-at-boundary store)) (newline)"
     :problem "An operator stored a captured timestamp as an integer in a persistent store and now wants to display it. The problem is that a bare integer is not human-readable in a log or a UI. The audit question is whether the rendering uses time/from-ms (integer → ISO) or a hand-rolled formatter (which risks locale or zone bugs)."
     :explanation "eng: the stored integer is rendered as an ISO-8601 UTC string ready for a log or tooltip. math: the render map is deterministic and total — the same integer always yields the same string. cs: format only at the boundary, keeping the internal store canonical."
     :meta "Why time/from-ms and not a manual formatter: the manual path invites zone drift; time/from-ms produces UTC every time, which is the only reproducible choice.")
    (:eng "Log the pair (ms, iso) so the audit can confirm the renderer for any stored value."
     :math "The mapping ms → iso is deterministic and total on integers."
     :cs "The CS pattern is deterministic renderer.")
)
  :row-3-dimension (
    (:setup "The formatter: turn a machine value into a human-facing view."
     :rungs ((:domain "time (ms integer to ISO string)" :code "(time/from-ms 1720000000000)")
             (:domain "money (cents integer to formatted currency)" :code "(define (render ms) (list 'utc ms))\n(display (equal? (render 1720000000000) (render 1720000000000))) (newline)")
             (:domain "coordinates (radians to degrees-minutes-seconds)" :code "(define (render ms) (list 'utc ms))\n(display (equal? (render 1720000000000) (render 1720000000000))) (newline)"))
     :explanation "In the runtime, ms → ISO. In finance, cents → currency string. In navigation, radians → DMS. All three share the shape 'internal scalar → external presentation.'"
     :meta "The shape transfers wherever a storage format differs from a display format.")
    (:eng "Keep the internal form canonical; format only at the boundary."
     :math "The formatter is a function from ℤ to a subset of Σ*."
     :cs "The CS analog is view function — the same shape used in MVC render layers."))
  :row-4-proof (
    (:eng-program ";; time/from-ms is the left-inverse of time/to-ms on its own output.\n(define ms 1720000000000)\n(define iso (time/from-ms ms))\n(display (equal? (time/from-ms (time/to-ms iso)) iso)) (newline)"
     :math-program "(define (f ms) (list 'iso ms))\n(define (g iso) (cadr iso))\n(define iso (f 1720000000000))\n(display (equal? (f (g iso)) iso)) (newline)"
     :cs-program "(define (left-inverse? f g x) (equal? (f (g (f x))) (f x)))\n(display (left-inverse? (lambda (n) (list 'iso n)) cadr 1720000000000)) (newline)"
     :claim "time/from-ms is the left-inverse of time/to-ms on strings that time/from-ms could have produced: for any iso from time/from-ms, time/from-ms(time/to-ms(iso)) = iso."
     :invariant "∀ iso ∈ image(time/from-ms). time/from-ms(time/to-ms(iso)) = iso"
     :meta "The pattern is left-inverse. See book-of-math ch10 for inverse pairs. What falsifies: any round trip where the second iso disagrees with the first — evidence of a lossy step.")
    (:eng "Smoke test: round trip equals original."
     :math "The pair forms a section of an isomorphism between ms integers and their ISO renderings."
     :cs "The CS pattern is invertible view — rare and worth preserving.")
)
  :row-5-emergence (
    (:eng-composition "(define (log-with-time ms msg)\n  (list (time/from-ms ms) msg))\n(display (log-with-time (time/now) 'saved)) (newline)"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The backdated-log family is a data-modeling distinction (event-time vs processing-time) over rendered records; it carries no algebraic law to compose beyond the inverse-pair identity already proven in row 4."
     :cs-composition "(define (record event-ms write-ms msg)\n  (list 'event event-ms 'written write-ms 'msg msg))\n(display (record 1720000000000 1720000005000 'saved)) (newline)"
     :base "time/from-ms renders an ms integer as an ISO-8601 UTC string."
     :emergent "backdated log — a log record that carries a captured event time distinct from the log-write time"
     :meta "The composition chains a captured ms with time/from-ms and a message. What emerges is the backdated-log family: records that timestamp the event, not the write. Same family: event sourcing, audit trails, insurance claim records. In book-of-composition ch16 this is the event-time-vs-processing-time pattern."
     :eng "Log both event time and write time when they can differ; the difference is a debug lead."
     :math "The composition is a mapping from (event-time, message) to a rendered record."
     :cs "The CS pattern name is event-time record. Familiar analogs: Kafka event-time, PostgreSQL WITH TIMESTAMPTZ.")
))

(verb
  :name "time/to-ms" :std "Motoi"
  :library "time"
  :kind "pure"
  :dialect "motoi"
  :signature "(time/to-ms s) -> integer | #f"
  :arity "1"
  :contract "s is an ISO-8601 or Date-parseable string → milliseconds since epoch, or #f on parse failure"
  :summary "Parse an ISO-8601 string into a millisecond epoch value. Returns #f if unparseable."
  :doc "Delegates to `new Date(s)`. Failure is signalled as #f (not an exception) so callers can guard easily. Inverse of time/from-ms."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(time/to-ms \"2026-07-16T12:00:00.000Z\")" :note "Returns the epoch ms for that instant.")
    (:dialect "motoi" :tier "intermediate" :code "(time/to-ms \"not a date\")" :note "Unparseable input returns #f.")
    (:dialect "motoi" :tier "expert" :code "(define (age-ms iso-string)\n  (let ((then (time/to-ms iso-string)))\n    (if then (- (time/now) then) #f)))\n(age-ms \"2020-01-01T00:00:00Z\")" :note "Milliseconds since a stored timestamp; #f if the input can't be parsed.")
  )
  :related ("time/from-ms" "time/iso" "time/now")
  :row-2-audit (
    (:eng-program "(define incoming \"2020-01-01T00:00:00Z\")\n(define ms (time/to-ms incoming))\n(display (if ms (- (time/now) ms) 'unparseable)) (newline)"
     :math-program "(define (parse s) (if (eq? s 'good) 1000 #f))\n(define (defined? x) (if x #t #f))\n(display (defined? (parse 'good))) (newline)\n(display (defined? (parse 'bad))) (newline)"
     :cs-program "(define (safe-parse s ok fail)\n  (let ((r (if (string? s) (list 'ms 42) #f)))\n    (if r (ok r) (fail))))\n(display (safe-parse \"2020-01-01T00:00:00Z\" cadr (lambda () 'refused))) (newline)\n(display (safe-parse 99 cadr (lambda () 'refused))) (newline)"
     :problem "A record from an external source carries an ISO string. The operator needs to compare it to the current time. The problem is that comparison of strings is lexical, not chronological, and parseable inputs may still be malformed. The audit question is whether the parse uses time/to-ms with a #f guard, or trusts the string blindly."
     :explanation "eng: the incoming string is parsed and the #f case is guarded so a broken value cannot propagate. math: the parser is a partial function; #f marks the inputs outside its domain, completing the partiality. cs: the safe-parse combinator routes to an ok or fail continuation, the Option/Maybe shape."
     :meta "Why time/to-ms with a guard and not blind parse: blind parse would let a broken string cascade into arithmetic that produces NaN, which then contaminates every downstream sum.")
    (:eng "Log the unparseable string with its source. It is likely a data-quality bug upstream."
     :math "The parser is a partial function from Σ* to ℤ; the guard closes the partiality."
     :cs "The CS pattern is safe parse with sentinel.")
)
  :row-3-dimension (
    (:setup "The guarded parse: try to promote a string into a machine value, and fail loudly on refusal."
     :rungs ((:domain "time (ISO string → ms integer or #f)" :code "(define (render ms) (list 'utc ms))\n(display (equal? (render 1720000000000) (render 1720000000000))) (newline)")
             (:domain "customs (attempt to admit a package, or refuse it)" :code "(define (parse s) (if (eq? s 'good) 1000 #f))\n(define (defined? x) (if x #t #f))\n(display (defined? (parse 'good))) (newline)\n(display (defined? (parse 'bad))) (newline)")
             (:domain "type theory (an option type, Some x or None)" :code "(define (parse s) (if (eq? s 'good) 1000 #f))\n(define (defined? x) (if x #t #f))\n(display (defined? (parse 'good))) (newline)\n(display (defined? (parse 'bad))) (newline)"))
     :explanation "In the runtime, an ISO string yields an int or #f. At customs, a package is admitted or held. In type theory, a parse returns Some or None. All three share the shape 'partial function completed by a refusal.'"
     :meta "The shape transfers wherever an input from an untrusted source may be malformed.")
    (:eng "Log every refusal. Refusals are how a system tells its operators about upstream drift."
     :math "The domain of a partial function is the subset on which it is defined; the complement is the refusal set."
     :cs "The CS analog is Option / Maybe."))
  :row-4-proof (
    (:eng-program "(define ms 1720000000000)\n(display (= (time/to-ms (time/from-ms ms)) ms)) (newline)"
     :math-program "(define (from-ms ms) (list 'iso ms))\n(define (to-ms iso) (cadr iso))\n(display (= (to-ms (from-ms 1720000000000)) 1720000000000)) (newline)"
     :cs-program "(define (right-inverse? f g x) (equal? (g (f x)) x))\n(display (right-inverse? (lambda (n) (list 'iso n)) cadr 1720000000000)) (newline)\n(display (right-inverse? (lambda (n) (list 'iso n)) cadr 0)) (newline)"
     :claim "For any ms integer that time/from-ms could produce, time/to-ms is its right inverse: time/to-ms(time/from-ms(ms)) = ms."
     :invariant "∀ ms ∈ ℤ. time/to-ms(time/from-ms(ms)) = ms"
     :meta "The pattern is right-inverse. See book-of-math ch10 for inverse pairs. What falsifies: any integer that round-trips to a different integer — evidence of a precision loss.")
    (:eng "Smoke test: equality holds."
     :math "The pair (from-ms, to-ms) forms an isomorphism restricted to the image of from-ms."
     :cs "The CS pattern is invertible parse.")
)
  :row-5-emergence (
    (:eng-composition "(define (age-ms iso-string)\n  (let ((then (time/to-ms iso-string)))\n    (if then (- (time/now) then) #f)))\n(display (age-ms \"2020-01-01T00:00:00Z\")) (newline)"
     :math-composition #f
     :math-composition-status "honest-null"
     :math-composition-notes "The freshness-gate composes a partial parse with a subtraction under a #f short-circuit; the inverse-pair identity is already proven in row 4, and the short-circuit is control flow, not an algebraic law worth restating."
     :cs-composition "(define (fresh? parse now iso threshold)\n  (let ((then (parse iso)))\n    (and then (< (- now then) threshold))))\n(define (parse s) (if (string? s) 1000 #f))\n(display (fresh? parse 1500 \"ts\" 1000)) (newline)\n(display (fresh? parse 5000 \"ts\" 1000)) (newline)\n(display (fresh? parse 5000 99 1000)) (newline)"
     :base "time/to-ms parses an ISO string to an ms integer or returns #f."
     :emergent "age calculator — a function that reports how long ago an ISO event happened, safely handling malformed input"
     :meta "The composition chains time/to-ms with time/now and a subtraction. What emerges is the age-of-event family: a computed elapsed that gates on parse success. Same family: session freshness checks, cache TTL comparisons, staleness detectors. In book-of-composition ch17 this is the freshness-gate pattern."
     :eng "Log the age and the source string; the pair is enough to explain the number."
     :math "The composition is (parse ∘ subtract) with a refusal short-circuit."
     :cs "The CS pattern name is freshness check. Familiar analogs: HTTP Last-Modified diffs, cache TTL expiry.")
))


;; ═══ R7RS-small (scheme time) — the two clocks and their unit ═══
;; Bare names, no `time/` prefix; documented here beside their Motoi
;; siblings because they answer the same question. Authored 2026-08-02.

(verb
  :name "jiffies-per-second" :std "R7RS-small"
  :library "time"
  :kind "pure"
  :dialect "motoi"
  :signature "(jiffies-per-second) -> integer"
  :arity "0"
  :contract "→ the number of jiffies in one second (integer)"
  :summary "How many jiffies make a second — the unit that gives current-jiffy its meaning."
  :doc "R7RS-small 6.14. A jiffy is whatever small time unit the implementation counts in; this verb says how many of them fit in a second, so a difference of two current-jiffy readings can be turned into seconds. In Motoi the answer is 1000: the clock underneath is Date.now(), which counts milliseconds, so one jiffy is one millisecond. The value is a constant of this implementation, not of the language — portable code divides by it rather than assuming 1000."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(jiffies-per-second)" :note "1000 — in Motoi a jiffy is a millisecond.")
    (:dialect "motoi" :tier "apprentice" :code "(= (jiffies-per-second) 1000)" :note "#t — the value is fixed, not sampled; it does not change between calls.")
    (:dialect "motoi" :tier "intermediate" :code "(exact-integer? (jiffies-per-second))" :note "#t — R7RS-small requires an exact integer, and Motoi supplies one.")
    (:dialect "motoi" :tier "expert" :code "(define (jiffies->seconds j)\n  (/ j (jiffies-per-second)))\n(display (jiffies->seconds 2500))\n(newline)" :note "5/2 — an exact jiffy count divided by an exact rate is an exact rational, so nothing is rounded away. Divide by the unit rather than by a hard-coded 1000, and the code survives a change of clock; call inexact on the result if you want 2.5 to read back.")
    (:dialect "motoi" :tier "master" :code "(define (resolution-ms)\n  (/ 1000 (jiffies-per-second)))\n(display (list 'ms-per-jiffy (resolution-ms)))\n(newline)" :note "(ms-per-jiffy 1) — the finest interval this clock can distinguish is one millisecond; anything shorter measures as zero.")
  )
  :caveats ("1000 is a fact about Motoi, not about Scheme. Another implementation may count microseconds or CPU ticks. Always divide by (jiffies-per-second); never write 1000." "A jiffy of one millisecond means anything faster than a millisecond measures as 0 elapsed. Repeat the work in a loop if you need to time something short." "The verb takes no arguments and does no I/O; it is a constant wearing a procedure's clothes.")
  :drawbacks ("Cannot be changed or configured — the resolution is whatever the host clock offers." "Says nothing about the clock's ACCURACY, only its unit; a millisecond unit does not promise millisecond-accurate readings.")
  :usecases ("Convert a jiffy difference into seconds when timing a computation." "Write portable timing code that does not assume a particular clock unit." "Report the finest interval the runtime can measure.")
  :related ("current-jiffy" "current-second" "time/now" "time/delta")
  :learn (:concept "Units before numbers: a count is meaningless until something states what one of them is." :prerequisites ("current-jiffy" "/") :progression "Read jiffies-per-second first, then current-jiffy, then bracket a computation with two current-jiffy readings and divide the difference by this unit.")
  :row-2-audit (
    (:eng-program "(define (elapsed-seconds j0 j1)\n  (/ (- j1 j0) (jiffies-per-second)))\n(display (elapsed-seconds 1000 3500))\n(newline)"
     :math-program "(define (unit-consistent? j)\n  (= j (* (/ j (jiffies-per-second)) (jiffies-per-second))))\n(display (list (unit-consistent? 2500) (unit-consistent? 7)))\n(newline)"
     :cs-program "(define (portable-seconds j per-second)\n  (/ j per-second))\n(display (list (portable-seconds 2500 (jiffies-per-second))\n               (portable-seconds 2500000 1000000)))\n(newline)"
     :problem "A benchmark bracketed a computation with two current-jiffy readings and now has a raw difference of 2500. The operator has to report seconds, and hard-coding a divisor would silently break on any runtime whose jiffy is not a millisecond."
     :explanation "eng: divide the difference by the unit to get seconds. math: dividing by the unit and multiplying back is the identity, which is what makes the conversion lossless. cs: passing the unit in as a parameter shows the same jiffy count under two different clocks."
     :meta "Reach for jiffies-per-second and NOT a literal 1000: the literal is correct today in Motoi and wrong in any implementation that counts differently. The verb exists precisely so the constant never has to be written down.")
    (:eng "Report the unit alongside the number in any timing log."
     :math "seconds = jiffies / jiffies-per-second — a unit conversion, not a measurement."
     :cs "Injecting the unit makes the conversion testable without a real clock."))
  :row-3-dimension (
    (:setup "The shape is 'a count is meaningless without the size of one'."
     :rungs (
       (:domain "time (this verb)" :code "(display (/ 2500 (jiffies-per-second)))\n(newline)")
       (:domain "audio — samples per second" :code "(define sample-rate 44100)\n(display (list 'seconds (/ 22050 sample-rate)))\n(newline)")
       (:domain "graphics — pixels per unit" :code "(define pixels-per-cm 96)\n(display (list 'cm (/ 288 pixels-per-cm)))\n(newline)"))
     :explanation "A clock reports jiffies and needs jiffies-per-second. An audio buffer reports samples and needs the sample rate. A raster reports pixels and needs a density. In each case the raw count is uninterpretable until the scale is supplied."
     :meta "Every measurement system pairs a count with a unit constant; the constant is the part that makes the count portable.")
    (:eng "Storing the unit next to the count is what makes old logs still readable."
     :math "A count in one unit maps to another by a single scale factor."
     :cs "Unit constants are configuration, not magic numbers."))
  :row-4-proof (
    (:claim "jiffies-per-second is a positive exact integer and returns the same value on every call."
     :eng-program "(display (and (exact-integer? (jiffies-per-second))\n              (> (jiffies-per-second) 0)))\n(newline)"
     :math-program "(define (stable?)\n  (= (jiffies-per-second) (jiffies-per-second)))\n(display (list (stable?) (stable?) (stable?)))\n(newline)"
     :cs-program "(define (round-trips? j)\n  (= j (* (/ j (jiffies-per-second)) (jiffies-per-second))))\n(display (list (round-trips? 1) (round-trips? 999) (round-trips? 60000)))\n(newline)"
     :invariant "jiffies-per-second() > 0, is an exact integer, and is equal on any two calls within a run"
     :meta "Constant-function pattern: purity is what lets a caller hoist the value out of a loop. Falsified by any two calls in one run that disagree.")
    (:eng "Hoisting it out of a hot loop is safe precisely because it is constant."
     :math "A positive divisor, so the conversion to seconds is always defined."
     :cs "A nullary pure function — the classic shape of a compile-time constant exposed at runtime."))
  :row-5-emergence (
    (:base "jiffies-per-second states the size of one jiffy."
     :eng-composition "(define (bench thunk)\n  (let ((t0 (current-jiffy)))\n    (thunk)\n    (/ (- (current-jiffy) t0) (jiffies-per-second))))\n(display (>= (bench (lambda () (sum (list 1 2 3)))) 0))\n(newline)"
     :math-composition "(define (rate-per-second count jiffies)\n  (if (= jiffies 0)\n      'too-fast-to-measure\n      (* count (/ (jiffies-per-second) jiffies))))\n(display (list (rate-per-second 500 250) (rate-per-second 500 0)))\n(newline)"
     :cs-composition "(define (timeout-jiffies seconds)\n  (* seconds (jiffies-per-second)))\n(display (list (timeout-jiffies 5) (timeout-jiffies 0.25)))\n(newline)"
     :emergent "A stopwatch emerges: bracket the work with two clock readings, subtract, and divide by the unit. The same constant read the other way turns a human deadline in seconds into the jiffy count the clock actually compares against."
     :meta "This is the unit-conversion-at-the-boundary family — keep raw counts inside, convert to human units only at the edges, exactly as byte counts, currencies and angles are handled.")
    (:eng "A zero difference means the work was faster than the clock, not that it was free."
     :math "throughput = count · (jiffies-per-second / jiffies)."
     :cs "Deadlines expressed in seconds and compared in jiffies — one multiplication at the boundary.")))

(verb
  :name "current-jiffy" :std "R7RS-small"
  :library "time"
  :kind "io"
  :dialect "motoi"
  :signature "(current-jiffy) -> integer"
  :arity "0"
  :contract "→ jiffies elapsed since an implementation-defined epoch (exact integer)"
  :summary "Read the fast clock: an exact integer count of jiffies since a fixed starting point."
  :doc "R7RS-small 6.14. The reading on its own means nothing — the epoch is implementation-defined and deliberately unspecified. What is meaningful is the DIFFERENCE between two readings, divided by (jiffies-per-second) to get seconds. In Motoi the underlying clock is Date.now(), so a jiffy is a millisecond and the epoch happens to be 1970-01-01T00:00:00Z; do not lean on that, because R7RS does not promise it and another implementation will not match it. The value is an exact integer, as the standard requires."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(exact-integer? (current-jiffy))" :note "#t — R7RS-small requires an exact integer, and Motoi returns one.")
    (:dialect "motoi" :tier "apprentice" :code "(> (current-jiffy) 0)" :note "#t — the count is positive because Motoi's epoch is 1970; the standard does not promise this and portable code must not test it.")
    (:dialect "motoi" :tier "intermediate" :code "(>= (- (current-jiffy) (current-jiffy)) -5)" :note "#t — two readings taken back to back differ by almost nothing; the second is never far behind the first.")
    (:dialect "motoi" :tier "expert" :code "(define (elapsed-jiffies thunk)\n  (let ((t0 (current-jiffy)))\n    (thunk)\n    (- (current-jiffy) t0)))\n(display (>= (elapsed-jiffies (lambda () (sum (list 1 2 3)))) 0))\n(newline)" :note "#t — bracket the work between two readings and subtract; a fast thunk legitimately measures 0.")
    (:dialect "motoi" :tier "master" :code "(define (bench-seconds thunk)\n  (let ((t0 (current-jiffy)))\n    (thunk)\n    (/ (- (current-jiffy) t0) (jiffies-per-second))))\n(display (< (bench-seconds (lambda () (mean (list 1 2 3)))) 60))\n(newline)" :note "#t — the difference divided by the unit is seconds; a trivial computation is comfortably under a minute.")
  )
  :caveats ("The absolute value is MEANINGLESS by design. Only differences carry information, and only after division by (jiffies-per-second)." "AS OF 2026-08-02 THE CLOCK IS NOT MONOTONIC. current-jiffy is Date.now(), which is wall-clock time: an NTP correction or a manual clock change can move it backwards, so a bracketed measurement can come back NEGATIVE. R7RS-small does not require monotonicity, so this is a limit rather than a bug — but do not build a watchdog or a rate limiter on it." "Resolution is one millisecond. Anything faster measures as 0 elapsed; loop the work if you need a number." "Non-deterministic: two calls in the same expression need not return the same value, so it must never appear in a snippet whose output is compared literally." "In Motoi the epoch is the Unix epoch, which makes readings comparable with time/now. That coincidence is not portable.")
  :drawbacks ("No monotonic companion clock is provided, so there is no way to get a reading that cannot jump backwards." "Millisecond resolution is too coarse for micro-benchmarks." "Carries no timezone, calendar or formatting; it is a bare count.")
  :usecases ("Time a computation by bracketing it with two readings." "Build a portable stopwatch by pairing with jiffies-per-second." "Measure the interval between two events in a running program.")
  :related ("jiffies-per-second" "current-second" "time/now" "time/delta")
  :learn (:concept "Relative time: a clock whose readings are only meaningful in pairs, because its origin is deliberately unspecified." :prerequisites ("jiffies-per-second" "-") :progression "Read jiffies-per-second for the unit, then current-jiffy for the reading, then current-second when you need an absolute point in time rather than an interval.")
  :row-2-audit (
    (:eng-program "(define (time-it thunk)\n  (let ((t0 (current-jiffy)))\n    (thunk)\n    (list 'jiffies (- (current-jiffy) t0)\n          'seconds (/ (- (current-jiffy) t0) (jiffies-per-second)))))\n(display (list? (time-it (lambda () (sum (list 1 2 3))))))\n(newline)"
     :math-program "(define (difference-is-small?)\n  (< (abs (- (current-jiffy) (current-jiffy))) 1000))\n(display (difference-is-small?))\n(newline)"
     :cs-program "(define (bracket clock thunk)\n  (let ((t0 (clock)))\n    (thunk)\n    (- (clock) t0)))\n(define fake (let ((n 0)) (lambda () (set! n (+ n 7)) n)))\n(display (list 'real (>= (bracket current-jiffy (lambda () 'work)) 0)\n               'fake (bracket fake (lambda () 'work))))\n(newline)"
     :problem "A benchmark must report how long a thunk took. The operator has to choose between the absolute clock (current-second, which answers 'when') and the interval clock (current-jiffy, which answers 'how long'), and only one of them is exact enough to subtract without float noise."
     :explanation "eng: report both the raw jiffies and the converted seconds so the reader can see the unit. math: two readings taken in one expression differ by less than a second, which is the sanity check that the clock is not wild. cs: injecting the clock as a parameter makes the bracketing testable with a fake that returns known values."
     :meta "Reach for current-jiffy and NOT current-second for intervals: current-jiffy is an exact integer, so the subtraction is exact. current-second is a double whose subtraction carries float error, and it is specified against a different time scale.")
    (:eng "A benchmark that logs only seconds hides whether the clock could resolve the work at all."
     :math "Δ = j₁ − j₀, an exact integer difference."
     :cs "Bracketed timing with an injectable clock — the standard testable shape."))
  :row-3-dimension (
    (:setup "The shape is 'a reading whose origin is arbitrary, so only differences mean anything'."
     :rungs (
       (:domain "time (this verb)" :code "(display (>= (- (current-jiffy) (current-jiffy)) -1000))\n(newline)")
       (:domain "surveying — a benchmark height above an arbitrary datum" :code "(define heights (list 104 109 101))\n(display (list 'rise (- (cadr heights) (car heights))))\n(newline)")
       (:domain "audio — a sample index within a stream" :code "(define (samples->ms i rate) (/ (* i 1000) rate))\n(display (list 'ms (- (samples->ms 44100 44100) (samples->ms 22050 44100))))\n(newline)"))
     :explanation "A jiffy count sits above an unspecified epoch. A survey height sits above an arbitrary datum. A sample index sits after an arbitrary stream start. In all three the absolute number is a bookkeeping artefact and the difference is the measurement."
     :meta "Affine quantities — differences are meaningful, absolutes are not; the same reason temperatures in Celsius may be subtracted but not divided.")
    (:eng "Publishing the absolute reading invites someone to compare it against a different origin."
     :math "An affine space: points subtract to vectors, but points do not add."
     :cs "Opaque handles with a defined difference operation — the pattern behind monotonic clocks everywhere."))
  :row-4-proof (
    (:claim "current-jiffy returns an exact integer, and two readings in the same run differ by far less than a day."
     :eng-program "(display (exact-integer? (current-jiffy)))\n(newline)"
     :math-program "(define (bounded?)\n  (< (abs (- (current-jiffy) (current-jiffy))) 86400000))\n(display (list (bounded?) (bounded?)))\n(newline)"
     :cs-program "(define (integer-difference? )\n  (exact-integer? (- (current-jiffy) (current-jiffy))))\n(display (integer-difference?))\n(newline)"
     :invariant "∀ calls. exact-integer?(current-jiffy()) ∧ exact-integer?(j₁ − j₀) — the difference of two readings is itself exact"
     :meta "Exactness-closure pattern: an exact clock is what makes the interval exact. Falsified by any reading that is not an exact integer, or any difference that acquires a fractional part. Note the invariant does NOT claim j₁ ≥ j₀ — the clock is not monotonic; see :caveats.")
    (:eng "An exact difference is one fewer source of noise in a benchmark."
     :math "ℤ is closed under subtraction, so intervals stay exact."
     :cs "Integer clocks avoid the float drift that plagues second-valued clocks."))
  :row-5-emergence (
    (:base "current-jiffy gives one reading of the interval clock."
     :eng-composition "(define (stopwatch thunk)\n  (let ((t0 (current-jiffy)))\n    (let ((r (thunk)))\n      (list 'result r 'seconds (/ (- (current-jiffy) t0) (jiffies-per-second))))))\n(display (list? (stopwatch (lambda () (sum (list 1 2 3 4))))))\n(newline)"
     :math-composition "(define (throughput n thunk)\n  (let ((t0 (current-jiffy)))\n    (thunk)\n    (let ((d (- (current-jiffy) t0)))\n      (if (<= d 0) 'too-fast (* n (/ (jiffies-per-second) d))))))\n(display (symbol? (throughput 100 (lambda () 'work))))\n(newline)"
     :cs-composition "(define (deadline-passed? start budget-seconds)\n  (> (- (current-jiffy) start)\n     (* budget-seconds (jiffies-per-second))))\n(display (deadline-passed? (current-jiffy) 60))\n(newline)"
     :emergent "A stopwatch and a deadline emerge from one verb read twice. The same subtraction that measures elapsed time also answers whether a budget has run out — measurement and enforcement are the same comparison pointed in opposite directions."
     :meta "This is the bracket-and-compare family — profilers, timeouts, rate limiters and animation loops are all two clock readings and one subtraction.")
    (:eng "A too-fast result is information: it says the work is below the clock's resolution."
     :math "Rate is a count divided by an interval, so a zero interval has no rate."
     :cs "Deadline checks must use a clock that cannot jump — which this one can; see :caveats.")))

(verb
  :name "current-second" :std "R7RS-small"
  :library "time"
  :kind "io"
  :dialect "motoi"
  :signature "(current-second) -> number"
  :arity "0"
  :contract "→ seconds since the Unix epoch, with a fractional part"
  :summary "Read the absolute clock: the current time as a number of seconds, fractional part included."
  :doc "R7RS-small 6.14. Where current-jiffy answers 'how long', current-second answers 'when'. Motoi computes it as Date.now() / 1000, so it is seconds since 1970-01-01T00:00:00Z on the UTC scale, carrying a fractional part down to the millisecond. R7RS-small specifies this verb against International Atomic Time (TAI), which differs from UTC by a whole number of leap seconds — currently 37 — so Motoi's answer is off the letter of the standard by that constant. For every practical purpose in Motoi the number is a Unix timestamp; use it to stamp events, and use current-jiffy to measure intervals."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(number? (current-second))" :note "#t — a number, not a string; format it yourself if you want a date.")
    (:dialect "motoi" :tier "apprentice" :code "(> (current-second) 1000000000)" :note "#t — a Unix timestamp in seconds passed one billion in 2001, so any present-day reading clears it.")
    (:dialect "motoi" :tier "intermediate" :code "(< (abs (- (/ (current-jiffy) (jiffies-per-second)) (current-second))) 1)" :note "#t — the two clocks agree once the jiffy count is divided by its unit; both sit on the same epoch in Motoi.")
    (:dialect "motoi" :tier "expert" :code "(define (stamp event)\n  (list 'event event 'at (current-second)))\n(display (list (car (stamp 'boot)) (cadr (stamp 'boot))))\n(newline)" :note "(event boot) — attach an absolute time to an event so two runs can be compared after the fact.")
    (:dialect "motoi" :tier "master" :code "(define (age-seconds stamped-at)\n  (- (current-second) stamped-at))\n(display (>= (age-seconds (current-second)) 0))\n(newline)" :note "#t — the age of something stamped a moment ago is zero or a hair more, never negative on a well-behaved clock.")
  )
  :caveats ("AS OF 2026-08-02 THIS IS UTC, NOT TAI. R7RS-small 6.14 specifies current-second on the International Atomic Time scale; Motoi returns Date.now()/1000, which is UTC and therefore about 37 seconds behind TAI and does not count leap seconds. The difference is a constant offset, invisible in ordinary use, but it is a divergence from the letter of the standard." "R7RS-small says the result is INEXACT, and it is: (exact? (current-second)) answers #f. There was nothing to satisfy that requirement with until the exactness tower landed 2026-08-03." "Use current-jiffy, not current-second, for intervals: subtracting two doubles introduces float error and the value is specified against a different time scale." "Non-deterministic; never write a snippet that compares its output literally." "Not monotonic — the same wall-clock jumps that affect current-jiffy affect this verb, so an age computed from a stored stamp can come back negative.")
  :drawbacks ("No timezone, calendar or formatting; converting to a readable date is your own work (see time/iso)." "Millisecond resolution at best, because the underlying clock counts milliseconds." "The fractional part makes equality comparisons useless in practice.")
  :usecases ("Stamp an event with an absolute time that survives across runs." "Compute the age of something recorded earlier." "Compare a Motoi timestamp with one produced by another system on the Unix epoch.")
  :related ("current-jiffy" "jiffies-per-second" "time/now" "time/iso" "time/from-ms")
  :learn (:concept "Absolute versus relative time: one clock names a moment, the other measures a gap, and they are not interchangeable." :prerequisites ("current-jiffy" "-") :progression "Learn current-jiffy for intervals, then current-second for absolute stamps, then time/iso to turn a stamp into something a person can read.")
  :row-2-audit (
    (:eng-program "(define (record event)\n  (list event (current-second)))\n(display (length (record 'deploy)))\n(newline)"
     :math-program "(define (clocks-agree?)\n  (< (abs (- (/ (current-jiffy) (jiffies-per-second)) (current-second))) 1))\n(display (clocks-agree?))\n(newline)"
     :cs-program "(define (age-of stamp now)\n  (- now stamp))\n(display (list (age-of 1000 1042) (>= (age-of (current-second) (current-second)) 0)))\n(newline)"
     :problem "A log line must say WHEN something happened, in a form another machine can compare against its own clock. An interval reading would be useless here: the reader has no access to this run's arbitrary epoch."
     :explanation "eng: pair the event with an absolute stamp. math: the two clocks are checked against each other and agree within a second. cs: age is a subtraction that works on any pair of stamps, real or supplied."
     :meta "Reach for current-second and NOT current-jiffy for stamps: a jiffy reading is only comparable inside one run, because R7RS leaves its epoch undefined. A second reading names a moment that another system can also name.")
    (:eng "An absolute stamp is what makes two machines' logs alignable."
     :math "A point on a time line, not a length along it."
     :cs "Wall-clock time for records, interval clock for measurement — never the other way round."))
  :row-3-dimension (
    (:setup "The shape is 'name a point on a shared scale so separate observers can compare notes'."
     :rungs (
       (:domain "time (this verb)" :code "(display (> (current-second) 0))\n(newline)")
       (:domain "navigation — a latitude on a shared globe" :code "(define (north-of? a b) (> a b))\n(display (north-of? 51.5 40.7))\n(newline)")
       (:domain "version control — a commit's position in a shared history" :code "(define (later? a b) (> a b))\n(display (later? 1720000042 1720000000))\n(newline)"))
     :explanation "A timestamp names a moment on a scale both machines know. A latitude names a place on a globe both navigators know. A commit position names a point in a history both clones know. The shared origin is what makes any of them comparable across observers."
     :meta "Absolute coordinates require an agreed origin; that agreement is the whole value of the Unix epoch.")
    (:eng "Agreeing on the epoch is cheaper than reconciling two private ones."
     :math "A coordinate on a shared axis, where both differences and order are meaningful."
     :cs "Globally comparable identifiers — the same requirement as a monotonic sequence number."))
  :row-4-proof (
    (:claim "current-second sits on the same epoch as current-jiffy scaled by its unit, and never runs backwards within a single expression on a well-behaved clock."
     :eng-program "(display (< (abs (- (/ (current-jiffy) (jiffies-per-second)) (current-second))) 1))\n(newline)"
     :math-program "(define (nondecreasing?)\n  (>= (+ 1 (current-second)) (current-second)))\n(display (list (nondecreasing?) (nondecreasing?)))\n(newline)"
     :cs-program "(define (is-number-not-string?)\n  (and (number? (current-second)) (not (string? (current-second)))))\n(display (is-number-not-string?))\n(newline)"
     :invariant "|current-jiffy()/jiffies-per-second() − current-second()| < 1 in Motoi, because both derive from Date.now()"
     :meta "Shared-source pattern: two clocks that agree do so because they are one clock behind the interface. Falsified by any reading pair that disagrees by a second or more. NOTE the invariant is a MOTOI fact, not an R7RS one — the standard leaves the jiffy epoch free and puts current-second on TAI.")
    (:eng "Agreement between the two clocks is what lets a stamp and an interval be compared."
     :math "Both are affine images of one underlying millisecond counter."
     :cs "One source, two interfaces — the divergence risk is zero by construction."))
  :row-5-emergence (
    (:base "current-second names the present moment as a number."
     :eng-composition "(define (with-stamp event payload)\n  (list 'at (current-second) 'event event 'payload payload))\n(display (length (with-stamp 'save (list 1 2 3))))\n(newline)"
     :math-composition "(define (freshness stamp max-age)\n  (let ((age (- (current-second) stamp)))\n    (if (< age max-age) 'fresh 'stale)))\n(display (list (freshness (current-second) 60)\n               (freshness 0 60)))\n(newline)"
     :cs-composition "(define (rate-limited? last-stamp min-gap)\n  (< (- (current-second) last-stamp) min-gap))\n(display (list (rate-limited? (current-second) 5)\n               (rate-limited? 0 5)))\n(newline)"
     :emergent "A freshness check emerges: stamp on write, subtract on read, compare against a budget. The same three lines answer 'is this cache entry still good', 'has this token expired' and 'is this caller going too fast'."
     :meta "This is the time-to-live family — cache expiry, session timeouts and rate limits are one stored stamp and one subtraction against a threshold.")
    (:eng "Storing the stamp rather than the deadline keeps the policy changeable after the fact."
     :math "age = now − stamp; fresh ⟺ age < ttl."
     :cs "A clock that can jump backwards makes a TTL fire early or late; see :caveats.")))

;; ═══ 2 blocking-pause verbs (added 2026-08-02) ═══

(verb
  :name "sleep" :std "Motoi"
  :library "time"
  :kind "state-change"
  :signature "(sleep seconds) -> unspecified"
  :summary "Block for at least the given number of seconds by busy-waiting; refuses anything negative or over 5."
  :explanation "sleep pauses the program for a duration given in SECONDS. It is a busy-wait, not a yield: the implementation spins on the wall clock until the target instant passes, so the process stays hot and nothing else runs meanwhile. The duration is a lower bound — the spin exits on the first check past the target, so you always get at least what you asked for and usually a fraction of a millisecond more. Two arguments are rejected outright: anything that is not a non-negative number, and anything greater than 5, which exists so a mistyped duration cannot hang a REPL. (sleep 0) is legal and returns immediately."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(length (list (sleep 0)))" :note "1 — sleep returns exactly one value and it carries no information; a zero-second sleep returns immediately.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((t0 (time/now))) (sleep 0.05) (>= (- (time/now) t0) 40))" :note "#t — fifty milliseconds of sleep leaves at least forty on the wall clock; the pause is a floor, never a ceiling.")
    (:dialect "motoi" :tier "expert" :code "(let ((t0 (time/now))) (sleep 0) (< (- (time/now) t0) 1000))" :note "#t — a zero sleep is effectively free, which makes it safe inside a loop guard.")
  )
  :caveats ("Durations above 5 seconds RAISE: (sleep 6) errors with \"sleep: refusing to hang more than 5s\". This is a deliberate anti-hang guard, not a bug." "Negative or non-numeric durations RAISE: (sleep -1) errors with \"sleep: expected non-negative seconds\"." "This is a busy-wait, not a yield. The CPU spins for the whole duration; nothing else on the process gets to run." "The unit is SECONDS. (sleep 200) is not a fifth of a second, it is an error. Use sleep-ms for milliseconds." "The pause is a lower bound only. Never assert an exact elapsed time; assert >=." "sleep does not advance the animation frame counter or the audio clock. Only tick-frame and audio-tick! do that.")
  :drawbacks ("Busy-waiting burns a core for the whole duration, which is wasteful for anything but the very short pauses it was designed for." "The 5-second cap makes sleep unusable for genuine waiting; it is a pacing tool, not a scheduler." "Because it blocks the single interpreter thread, nothing can be done during the pause, including drawing.")
  :usecases ("Pacing a terminal demo so a human can read each step." "Inserting a short deliberate delay between two side effects in a script." "Teaching the difference between blocking and scheduling, next to the non-blocking wait clause.")
  :related ("sleep-ms" "time/now" "time/delta" "current-jiffy" "sync")
  :learn (:concept "Blocking and scheduling are different things: one stops the world, the other asks to be resumed later." :prerequisites ("time/now") :progression "Learn sleep for the blocking case, sleep-ms when the duration is naturally in milliseconds, then contrast both with the scheduler's non-blocking wait clause.")
  :provenance "Motoi-own; lib/media/media.js line 528, a Date.now() spin loop with a 5-second cap. Authored 2026-08-02 from the implementation."
  :row-2-audit (
    (:problem "A terminal demo prints three steps so fast that a viewer sees only the last one. The operator needs a readable pause between them without building a scheduler."
     :eng-program "(define (step n) (display n) (sleep 0.01))\n(for-each step (list 1 2 3))\n(newline)"
     :math-program "(define t0 (time/now))\n(for-each (lambda (n) (sleep 0.01)) (list 1 2 3))\n(>= (- (time/now) t0) 20)"
     :cs-program "(define (paced thunk pause) (thunk) (sleep pause) 'done)\n(paced (lambda () 'work) 0.01)"
     :explanation "Each step blocks for ten milliseconds, so the three prints are separated on the wall clock and the total is measurably at least twenty. The pause is a floor, so the math program asserts >= rather than =."
     :meta "Reaching for the scheduler's wait clause would return a tagged value and NOT block, which is exactly the foot-gun the source comment calls out. sleep is the honest verb when the requirement is that the program actually stops.")
    (:eng "If the requirement is 'the human must see it', the program must actually stop."
     :math "Elapsed time is bounded below by the sum of the requested pauses."
     :cs "Blocking is the simplest correct answer when there is nothing else to run."))
  :row-3-dimension (
    (:setup "Advancing time deliberately shows up once per clock in this runtime, and the clocks do not agree on what advancing means."
     :rungs (
       (:domain "wall clock" :code "(length (list (sleep 0)))")
       (:domain "animation" :code "(begin (tick-frame) (sync))")
       (:domain "audio" :code "(begin (audio-tick! 60) (audio-time))")
     )
     :explanation "sleep spends real time and moves no counter. tick-frame moves the animation counter and spends no real time. audio-tick! moves the audio clock and spends no real time. Three clocks, three different meanings of 'later'."
     :meta "The dimension is which timebase moves. Confusing them is the commonest timing bug in a cart.")
    (:eng "Name the clock you meant before you advance anything."
     :math "Three independent monotone sequences, with no morphism between them."
     :cs "Wall time, logical time and sample time are separate axes."))
  :row-4-proof (
    (:claim "sleep returns exactly one uninformative value, and the elapsed wall time is at least the requested duration."
     :eng-program "(let ((t0 (time/now))) (sleep 0.05) (>= (- (time/now) t0) 40))"
     :math-program "(let ((t0 (time/now))) (sleep 0.02) (sleep 0.02) (>= (- (time/now) t0) 30))"
     :cs-program "(length (list (sleep 0)))"
     :invariant "For all s with 0 <= s <= 5, (sleep s) returns after at least s seconds of wall time have passed; for all other s it raises."
     :meta "The proof asserts a LOWER bound only. An upper-bound assertion would flake on any loaded machine, and a gate that flakes teaches nothing.")
    (:eng "Assert the floor, never the ceiling, on anything the operating system schedules."
     :math "The guarantee is one-sided: elapsed >= requested."
     :cs "Timing tests must be inequalities or they are flaky by construction."))
  :row-5-emergence (
    (:base "sleep alone stops the program. Chained with time/now it becomes a measured pace."
     :eng-composition "(define t0 (time/now))\n(for-each (lambda (n) (sleep 0.01)) (list 1 2 3))\n(>= (- (time/now) t0) 20)"
     :math-composition "(define (timed-pause s) (let ((t0 (time/now))) (sleep s) (- (time/now) t0)))\n(>= (timed-pause 0.03) 20)"
     :cs-composition "(define (rate-limit thunk pause) (thunk) (sleep pause) 'ok)\n(map (lambda (n) (rate-limit (lambda () n) 0.005)) (list 1 2 3))"
     :emergent "A rate limiter: a thunk plus a pause plus map gives you a bounded-throughput pipeline with no queue, no timer and no scheduler — the whole mechanism is one blocking call."
     :meta "Emergence is simplicity — when there is nothing else to run, blocking IS the scheduler, and the code says so plainly.")
    (:eng "The cheapest rate limiter is a pause in the loop body."
     :math "Total time is bounded below by the count times the pause."
     :cs "Blocking backpressure needs no data structure at all."))
)

(verb
  :name "sleep-ms" :std "Motoi"
  :library "time"
  :kind "state-change"
  :signature "(sleep-ms ms) -> unspecified"
  :summary "Block for at least the given number of MILLISECONDS by busy-waiting; refuses anything negative or over 5000."
  :explanation "sleep-ms is sleep with a millisecond argument. It divides by 1000 and then does the same wall-clock spin, so the guarantees are identical: the pause is a lower bound, the process stays hot, and nothing else runs meanwhile. The cap is 5000 milliseconds, matching sleep's 5 seconds, and negative or non-numeric arguments raise. It exists because milliseconds are the unit people reach for — the runtime's own clock verbs report milliseconds too — and because the scheduler's wait clause takes milliseconds but does NOT block, which is a genuine trap. When you mean 'stop here for 200 ms', sleep-ms is the verb that does it."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(length (list (sleep-ms 10)))" :note "1 — sleep-ms returns exactly one value and it carries no information; the pause is the effect.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((t0 (time/now))) (sleep-ms 60) (>= (- (time/now) t0) 50))" :note "#t — sixty milliseconds of sleep leaves at least fifty on the clock; the pause is a floor.")
    (:dialect "motoi" :tier "expert" :code "(let ((t0 (time/now))) (sleep-ms 20) (sleep 0.02) (>= (- (time/now) t0) 30))" :note "#t — the two verbs are the same spin in different units and compose freely.")
  )
  :caveats ("Durations above 5000 ms RAISE: (sleep-ms 6000) errors with \"sleep-ms: refusing to hang more than 5000 ms\"." "Negative or non-numeric durations RAISE: (sleep-ms -5) errors with \"sleep-ms: expected non-negative ms\"." "The unit is MILLISECONDS. (sleep-ms 5) is five thousandths of a second, not five seconds. Mixing this up with sleep is the classic error." "This is a busy-wait, not a yield. A 5000 ms sleep-ms spins a core for five full seconds." "The pause is a lower bound only. Assert >=, never =." "The scheduler's wait clause also takes milliseconds and does NOT block. If a pause seems to be ignored, check which of the two you called.")
  :drawbacks ("Busy-waiting for up to five seconds is a real waste of a core, and the verb makes that easy to do by accident." "Having both sleep and sleep-ms doubles the chance of a unit mix-up, which the error message cannot catch when the value is in range for both." "Blocks the single interpreter thread, so nothing draws or responds during the pause.")
  :usecases ("Pausing a kid's first program for a readable moment — the literal 'wait 200 milliseconds'." "Spacing out a sequence of side effects where the natural unit is milliseconds." "Demonstrating blocking against the non-blocking wait clause, side by side.")
  :related ("sleep" "time/now" "time/delta" "jiffies-per-second" "current-jiffy")
  :learn (:concept "The same operation in two units is two verbs, and picking the wrong one is a bug the type system cannot see." :prerequisites ("sleep" "time/now") :progression "Learn sleep-ms as the millisecond face of sleep, then always name the unit in the variable that holds the duration.")
  :provenance "Motoi-own; lib/media/media.js line 543, added 2026-07-19 as an additive alias of sleep. Authored 2026-08-02 from the implementation."
  :row-2-audit (
    (:problem "A beginner writes 'wait 200 milliseconds' between two prints and finds the program runs instantly, because the verb they reached for returned a tagged clause instead of pausing."
     :eng-program "(define t0 (time/now))\n(display 'a)\n(sleep-ms 30)\n(display 'b)\n(newline)\n(>= (- (time/now) t0) 20)"
     :math-program "(define (elapsed-of ms) (let ((t0 (time/now))) (sleep-ms ms) (- (time/now) t0)))\n(>= (elapsed-of 40) 30)"
     :cs-program "(define (blocks? ms) (let ((t0 (time/now))) (sleep-ms ms) (>= (- (time/now) t0) (- ms 10))))\n(list (blocks? 20) (blocks? 40))"
     :explanation "Bracketing the pause with two clock readings turns 'did it wait' into a measurable fact. The programs assert a floor a little below the request so a coarse clock cannot make a correct pause look like a failure."
     :meta "Reaching for the scheduler's wait clause here returns a value and continues immediately — the source comment names this as a foot-gun that cannot be fixed without a signature change. sleep-ms is the honest verb when the requirement is a real pause.")
    (:eng "Measure the pause; do not assume it happened."
     :math "Bracketing with a clock converts an intention into an inequality."
     :cs "A blocking call and a scheduling call have the same shape and opposite semantics."))
  :row-3-dimension (
    (:setup "The same duration expressed in different units recurs everywhere a clock meets a human."
     :rungs (
       (:domain "milliseconds" :code "(length (list (sleep-ms 10)))")
       (:domain "seconds" :code "(length (list (sleep 0.01)))")
       (:domain "jiffies" :code "(/ 10 (jiffies-per-second))")
     )
     :explanation "Ten milliseconds, one hundredth of a second and ten jiffies are the same interval written three ways. Only the last one carries its unit in the expression, which is why portable timing code divides by jiffies-per-second instead of writing a bare number."
     :meta "The dimension is the unit, and the lesson is that a bare number never states one.")
    (:eng "Put the unit in the name if it cannot be in the type."
     :math "Unit conversion is a scale factor; the danger is that both scales are plain numbers."
     :cs "Dimensional analysis catches the bug the compiler cannot."))
  :row-4-proof (
    (:claim "sleep-ms and sleep are the same spin in different units, and both guarantee only a lower bound."
     :eng-program "(let ((t0 (time/now))) (sleep-ms 60) (>= (- (time/now) t0) 50))"
     :math-program "(let ((a (let ((t0 (time/now))) (sleep-ms 30) (- (time/now) t0)))) (>= a 20))"
     :cs-program "(let ((t0 (time/now))) (sleep-ms 20) (sleep 0.02) (>= (- (time/now) t0) 30))"
     :invariant "For all m with 0 <= m <= 5000, (sleep-ms m) is equivalent to (sleep (/ m 1000)) and returns after at least m milliseconds of wall time."
     :meta "The cs program runs both verbs in one bracket, which is the cheapest way to show they share a timebase rather than merely resembling each other.")
    (:eng "Prove the equivalence by measuring both in one bracket."
     :math "The two verbs differ by a fixed scale factor and nothing else."
     :cs "An alias should be tested against the thing it aliases, not on its own."))
  :row-5-emergence (
    (:base "sleep-ms alone stops the program. Chained with a list of durations it becomes a rhythm."
     :eng-composition "(define t0 (time/now))\n(for-each sleep-ms (list 10 10 10))\n(>= (- (time/now) t0) 20)"
     :math-composition "(define (total-of ms-list) (let ((t0 (time/now))) (for-each sleep-ms ms-list) (- (time/now) t0)))\n(>= (total-of (list 10 20)) 25)"
     :cs-composition "(define (beat-out pattern) (for-each (lambda (ms) (sleep-ms ms) (display '.)) pattern) (newline) 'done)\n(beat-out (list 5 5 5))"
     :emergent "A rhythm player: a list of millisecond gaps plus for-each plays a pattern in real time, which is the smallest possible sequencer and needs no timer, no queue and no callback."
     :meta "Emergence is that a data structure — a list of gaps — becomes a temporal structure the moment it meets a blocking pause.")
    (:eng "A list of gaps is a rhythm as soon as something waits between them."
     :math "Total elapsed is bounded below by the sum of the list."
     :cs "The simplest sequencer is a fold with a delay in the body."))
)

(verb
  :name "current-jiffy" :std "R7RS-small"
  :library "time"
  :kind "pure"
  :signature "(current-jiffy) -> exact-integer"
  :summary "Returns the current value of an implementation-defined monotonic-ish counter, in jiffies."
  :provenance "R7RS §6.14 (system interface); implemented in lib/base/r7rs-small.js as Date.now()."
  :explanation "current-jiffy returns a count of jiffies. A jiffy is whatever small unit of time the implementation picked; (jiffies-per-second) tells you how many of them make a second. In Motoi one jiffy is exactly one millisecond, because the verb is Date.now(). The point of the jiffy pair is that you never have to know the unit: take two readings, subtract them, divide by (jiffies-per-second), and you have elapsed seconds on any conforming Scheme. R7RS says the epoch is arbitrary — the absolute value is meaningless, only differences carry information. Because Motoi's clock is the wall clock and not a monotonic one, a system clock adjustment during a measurement can make a difference come out negative; the standard permits this and code that times things should treat a negative delta as 'measurement invalid', not as 'negative time'."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(exact? (current-jiffy))" :note "#t — the reading is an exact integer, so subtracting two of them is exact.")
    (:dialect "motoi" :tier "intermediate" :code "(let* ((t0 (current-jiffy))\n       (r  (apply + (list 1 2 3)))\n       (t1 (current-jiffy)))\n  (>= (- t1 t0) 0))" :note "Two readings around a computation; the difference is the elapsed jiffy count.")
    (:dialect "motoi" :tier "expert" :code "(define (timed thunk)\n  (let* ((t0 (current-jiffy))\n         (v  (thunk))\n         (t1 (current-jiffy)))\n    (list 'value v 'seconds (/ (- t1 t0) (jiffies-per-second)))))\n(display (car (timed (lambda () 'done)))) (newline)" :note "A reusable timer: value plus elapsed seconds, unit-independent.")
  )
  :caveats ("The epoch is arbitrary. A single reading means nothing; only differences do." "Motoi's jiffy is the wall clock (Date.now()), not a monotonic clock — an NTP step or manual clock change during a measurement can produce a negative delta." "Resolution is one millisecond. Anything faster than that measures as 0 jiffies; time a loop of many iterations instead of one." "Never write a test that asserts a literal jiffy value — it changes every run.")
  :drawbacks ("Millisecond resolution is far too coarse for micro-benchmarks; a single verb call always reads 0." "Not monotonic, so it cannot be used to implement a timeout that must survive a clock adjustment." "Returns jiffies, not seconds — forgetting to divide by (jiffies-per-second) produces a number 1000× too large in Motoi and a differently-wrong number on another Scheme.")
  :usecases ("Timing a computation by subtracting two readings." "Building a portable elapsed-seconds helper on top of the jiffy pair." "Rate limiting: remember the jiffy of the last event and compare against the current one." "Seeding a low-stakes pseudo-random value when SRFI-27 is not wanted.")
  :related ("current-second" "jiffies-per-second" "time/delta" "time/every-ms")
  :learn (:concept "Elapsed time is a difference of two clock readings divided by the clock's own rate; the unit is discovered from the runtime, never assumed." :prerequisites ("jiffies-per-second") :progression "Learn current-jiffy for exact interval arithmetic, then current-second for a human-scale absolute reading, then time/delta for per-frame animation.")
  :row-2-audit (
    (:eng-program "(define (timed thunk)\n  (let* ((t0 (current-jiffy))\n         (v  (thunk))\n         (t1 (current-jiffy)))\n    (list 'value v 'jiffies (- t1 t0))))\n(display (car (timed (lambda () (apply + (list 1 2 3)))))) (newline)"
     :math-program "(define (elapsed-seconds t0 t1) (/ (- t1 t0) (jiffies-per-second)))\n(display (elapsed-seconds 1000 3500)) (newline)\n(display (elapsed-seconds 42 42)) (newline)"
     :cs-program "(define (valid-delta? t0 t1) (>= (- t1 t0) 0))\n(display (valid-delta? 100 250)) (newline)\n(display (valid-delta? 250 100)) (newline)"
     :problem "The operator has a cart that stutters and wants to know which of two routines is slow. The instinct is to reach for current-second and subtract, but that returns an inexact float whose differences accumulate representation error over a long run. The audit question is which clock verb gives an EXACT reading, so a difference of readings is an exact integer and never drifts: that is current-jiffy, not current-second."
     :explanation "eng: a timer wrapper takes two readings around a thunk and reports the jiffy difference alongside the value. math: converting jiffies to seconds is one division by the runtime-supplied rate, and a zero-length interval converts to exactly 0. cs: a validity guard, because the clock is the wall clock and a backwards step is possible."
     :meta "Why current-jiffy and not current-second: (exact? (current-jiffy)) is #t and (exact? (current-second)) is usually #f, so jiffy differences are exact integer arithmetic while second differences are floating-point subtraction of two large nearly-equal numbers — the classic catastrophic-cancellation shape. Why not time/delta: that verb reports the frame interval inside a tick loop and is meaningless outside one.")
    (:eng "Log the delta, never the reading. A dashboard that plots current-jiffy directly plots an arbitrary epoch and tells you nothing."
     :math "elapsed = (t₁ − t₀) / rate, where rate = (jiffies-per-second). The unit cancels."
     :cs "The CS pattern is instrumented span — capture, run, capture, subtract. Related: performance.now(), System.nanoTime(), clock_gettime.")
)
  :row-3-dimension (
    (:setup "The arbitrary-origin counter: a monotonically advancing tick whose absolute value is meaningless and whose differences are the whole content."
     :rungs ((:domain "time (two jiffy readings around a computation)" :code "(define (timed thunk)\n  (let* ((t0 (current-jiffy))\n         (v  (thunk))\n         (t1 (current-jiffy)))\n    (list 'value v 'jiffies (- t1 t0))))\n(display (car (timed (lambda () 'done)))) (newline)")
             (:domain "odometer (mileage of a trip = reading out minus reading in)" :code "(define (trip-miles out in) (- out in))\n(display (trip-miles 48210 48035)) (newline)")
             (:domain "affine space (points have no origin; differences are vectors)" :code "(define (difference b a) (- b a))\n(display (difference 3500 1000)) (newline)\n(display (difference 103500 101000)) (newline)"))
     :explanation "A jiffy reading is a point on a line with no marked zero. An odometer reading is the same: 48,210 miles tells you nothing about this trip, but the difference of two readings is exactly the trip. In an affine space points cannot be added but their difference is a well-defined vector. All three share the shape 'the value is arbitrary, the difference is the datum.'"
     :meta "The shape transfers wherever a counter is started at an unknown moment. The tell is that adding two readings is nonsense while subtracting them is meaningful.")
    (:eng "Never persist a raw reading across runs; persist the difference or persist a wall-clock timestamp instead."
     :math "Points of an affine space subtract to vectors; the vectors add, the points do not."
     :cs "The CS analog is the monotonic counter — sequence numbers, logical clocks, frame counters."))
  :row-4-proof (
    (:eng-program "(define t (current-jiffy))\n(display (and (exact? t) (integer? t) (> t 0))) (newline)"
     :math-program "(define (split-additive a b c) (= (- c a) (+ (- b a) (- c b))))\n(display (split-additive 1000 1750 3500)) (newline)\n(display (split-additive 0 0 0)) (newline)"
     :cs-program "(define a (current-jiffy))\n(define b (current-jiffy))\n(display (<= a b)) (newline)"
     :claim "Two readings taken in program order satisfy t₀ ≤ t₁ under a stable clock, and the elapsed jiffies of a span equal the sum of the elapsed jiffies of its consecutive sub-spans."
     :invariant "∀ readings a ≤ b ≤ c. (c − a) = (b − a) + (c − b)"
     :meta "The pattern is additivity of a measure over adjacent intervals — the same law that makes a Riemann integral splittable. See book-of-math ch on measure and additivity. What falsifies: a clock adjustment between two readings, which makes b < a and turns the ordering claim false while leaving the additivity claim true. That is exactly why the ordering assertion needs a stable clock and the additivity assertion does not.")
    (:eng "Smoke test: the reading is an exact positive integer and successive readings do not go backwards."
     :math "Additivity over adjacent intervals: m([a,c]) = m([a,b]) + m([b,c])."
     :cs "The CS pattern is interval arithmetic on a counter.")
)
  :row-5-emergence (
    (:eng-composition "(define (elapsed-seconds t0 t1) (/ (- t1 t0) (jiffies-per-second)))\n(define (stopwatch)\n  (let ((t0 (current-jiffy)))\n    (lambda () (elapsed-seconds t0 (current-jiffy)))))\n(define watch (stopwatch))\n(display (>= (watch) 0)) (newline)"
     :math-composition "(define (rate n t0 t1)\n  (let ((secs (/ (- t1 t0) (jiffies-per-second))))\n    (if (= secs 0) 'undefined (/ n secs))))\n(display (rate 500 1000 3000)) (newline)\n(display (rate 500 1000 1000)) (newline)"
     :cs-composition "(define last-fire 0)\n(define (may-fire? now gap)\n  (if (>= (- now last-fire) gap)\n      (begin (set! last-fire now) #t)\n      #f))\n(display (may-fire? 1000 250)) (newline)\n(display (may-fire? 1100 250)) (newline)\n(display (may-fire? 1300 250)) (newline)"
     :base "current-jiffy returns an exact tick count on an arbitrary epoch."
     :emergent "stopwatch and rate limiter — a closure that captures a start reading and answers 'how long since?' on demand, and its sibling that answers 'is it time yet?'"
     :meta "The composition chains current-jiffy with jiffies-per-second and a captured origin. What emerges is the elapsed-since family: throughput meters, rate limiters, debounce guards, cooldown timers in games. Same family: token buckets, exponential backoff, animation easing on wall time. In book-of-composition this is the captured-origin shape — close over the start, expose only the difference."
     :eng "Log the rate, not the count. A count without its window is not a measurement."
     :math "The composition is a divided difference: (n items) / (Δjiffies / rate)."
     :cs "The CS pattern name is rate limiter. Familiar analogs: token bucket, debounce, cooldown.")
))

(verb
  :name "current-second" :std "R7RS-small"
  :library "time"
  :kind "pure"
  :signature "(current-second) -> number"
  :summary "Returns the current time as a count of seconds since a fixed epoch."
  :provenance "R7RS §6.14 (system interface); implemented in lib/base/r7rs-small.js as Date.now() / 1000."
  :explanation "current-second returns an absolute wall-clock reading in seconds. Unlike current-jiffy, whose epoch is arbitrary, current-second is anchored: R7RS specifies TAI seconds since 1970-01-01 00:00:00 TAI, and Motoi supplies POSIX seconds (Date.now() / 1000), which is the same number minus the accumulated leap seconds. Use current-second when you need a value that means something outside this process — a timestamp to store, to compare against another machine's clock, or to show a person. Use current-jiffy when you need to measure how long something took, because jiffy readings are exact integers and second readings are floats."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(> (current-second) 0)" :note "#t — the reading is a positive count of seconds since 1970.")
    (:dialect "motoi" :tier "intermediate" :code "(number? (current-second))" :note "#t — a number, not a date object; formatting is left to the caller.")
    (:dialect "motoi" :tier "expert" :code "(define (stamp label) (list label (current-second)))\n(display (car (stamp 'saved))) (newline)" :note "An event record carrying an absolute timestamp that survives the process.")
  )
  :caveats ("Motoi returns POSIX seconds, not the TAI seconds R7RS specifies — the two differ by the accumulated leap-second offset (37 s as of 2026). Do not use this verb where leap-second-exact astronomy matters." "The result is a float built by dividing milliseconds by 1000, so it carries at most millisecond resolution however many digits it prints." "Exactness is not stable: (exact? 3.0) is #t in Motoi, so a reading that lands exactly on a whole second reports as exact and every other reading reports as inexact. Never branch on (exact? (current-second))." "Wall clock, not monotonic — it can jump backwards. Do not build timeouts on it.")
  :drawbacks ("Float subtraction of two large nearly-equal readings loses precision; current-jiffy is the correct verb for measuring durations." "No calendar structure at all — no year, month, day, or zone. Converting to a human date is the caller's problem." "Diverges from the R7RS TAI definition, so a program ported to a leap-second-correct Scheme will read a different number for the same instant.")
  :usecases ("Stamping an event with an absolute time that outlives the process." "Comparing a locally-observed time against a timestamp received from elsewhere." "Recording created-at / modified-at fields in a saved record." "Deciding whether cached data is older than a wall-clock cutoff.")
  :related ("current-jiffy" "jiffies-per-second" "time/delta")
  :learn (:concept "Absolute time and elapsed time are different measurements needing different verbs: an anchored epoch for the first, an exact tick counter for the second." :prerequisites ("current-jiffy") :progression "Learn current-second for timestamps, current-jiffy for durations, and never substitute one for the other.")
  :row-2-audit (
    (:eng-program "(define (stamp label) (list label (current-second)))\n(display (car (stamp 'cart-saved))) (newline)"
     :math-program "(define (age-seconds then now) (- now then))\n(display (age-seconds 1000 1750)) (newline)\n(display (age-seconds 1750 1750)) (newline)"
     :cs-program "(define (stale? stamped now ttl) (> (- now stamped) ttl))\n(display (stale? 1000 1200 300)) (newline)\n(display (stale? 1000 1400 300)) (newline)"
     :problem "The operator saves a cart and wants the saved file to say when it was saved, so a person opening it next week can tell. The instinct is to reach for current-jiffy because it is the other clock verb, but a jiffy reading has an arbitrary epoch and is meaningless in a file that outlives the process. The audit question is whether the number needs to mean something OUTSIDE this run: if yes, current-second; if no, current-jiffy."
     :explanation "eng: an event stamp pairs a label with an absolute reading that survives serialization. math: age is a plain difference of two absolute readings, and a zero-age record differences to exactly 0. cs: a staleness check compares that age against a time-to-live."
     :meta "Why current-second and not current-jiffy: the jiffy epoch is arbitrary, so a stored jiffy is uninterpretable in the next process. Why not time/delta: that reports a frame interval and does not exist outside a tick loop. The audit tell is the word 'stored' — anything persisted needs an anchored epoch.")
    (:eng "Store the absolute second on the record. Compute ages at read time, never at write time."
     :math "age = now − then, on a common anchored epoch."
     :cs "The CS pattern is the epoch timestamp. Related: Unix time, ISO-8601 instants, HTTP Date headers.")
)
  :row-3-dimension (
    (:setup "The anchored reading: a measurement taken against a fixed, externally-agreed origin so the value travels."
     :rungs ((:domain "time (seconds since the 1970 epoch)" :code "(define (stamp label) (list label (current-second)))\n(display (car (stamp 'saved))) (newline)")
             (:domain "surveying (elevation quoted against mean sea level, not the truck's bumper)" :code "(define (above-datum height datum) (- height datum))\n(display (above-datum 412 0)) (newline)")
             (:domain "measure theory (a signed coordinate on a line with a chosen zero)" :code "(define (coordinate x origin) (- x origin))\n(display (coordinate 1750 0)) (newline)\n(display (coordinate 1750 1000)) (newline)"))
     :explanation "A second reading is anchored at 1970, so two machines can compare theirs. A surveyed elevation is anchored at a sea-level datum, so two survey crews can compare theirs. A coordinate is anchored at a chosen zero, which is what turns a point into a number. All three share the shape 'agree on the origin and the reading becomes portable.'"
     :meta "The shape transfers wherever a value has to be compared across parties who never met. The tell is that the origin has to be published, not merely chosen.")
    (:eng "Publish the epoch alongside the number, or the number is only meaningful to the writer."
     :math "Choosing an origin turns an affine point into a coordinate."
     :cs "The CS analog is the absolute address — meaningful anywhere, unlike an offset."))
  :row-4-proof (
    (:eng-program "(define s (current-second))\n(display (and (number? s) (> s 0))) (newline)"
     :math-program "(define (monotone-diff a b) (>= (- b a) 0))\n(display (monotone-diff 1000 1750)) (newline)\n(display (monotone-diff 1750 1750)) (newline)"
     :cs-program "(define a (current-second))\n(define b (current-second))\n(display (<= a b)) (newline)"
     :claim "A reading is a positive number of seconds since the epoch, and under a stable clock two readings taken in program order do not go backwards."
     :invariant "∀ readings a taken before b under a stable clock. a ≤ b ∧ a > 0"
     :meta "The pattern is a non-decreasing observation sequence. See book-of-math ch on order relations. What falsifies: a clock adjustment between the two readings — which is precisely why this verb must not be used to implement a timeout, and why the sibling claim about current-jiffy is the one to lean on for durations.")
    (:eng "Smoke test: positive, numeric, non-decreasing across two adjacent reads."
     :math "The reading is a monotone non-decreasing function of real time under a stable clock."
     :cs "The CS pattern is the observation sequence with a stability precondition.")
)
  :row-5-emergence (
    (:eng-composition "(define (stamp label) (list label (current-second)))\n(define (age-of record now) (- now (cadr record)))\n(define r (stamp 'saved))\n(display (>= (age-of r (current-second)) 0)) (newline)"
     :math-composition "(define (ttl-remaining stamped now ttl) (max 0 (- ttl (- now stamped))))\n(display (ttl-remaining 1000 1200 300)) (newline)\n(display (ttl-remaining 1000 1400 300)) (newline)"
     :cs-composition "(define cache '())\n(define (cache-put! k v t) (set! cache (cons (list k v t) cache)))\n(define (fresh? entry now ttl) (<= (- now (caddr entry)) ttl))\n(cache-put! 'a 1 1000)\n(display (fresh? (car cache) 1100 300)) (newline)\n(display (fresh? (car cache) 1500 300)) (newline)"
     :base "current-second returns an absolute wall-clock reading in seconds."
     :emergent "expiring cache entry — a stored value carrying its own birth time, so any later reader can decide for itself whether the value is still good"
     :meta "The composition chains current-second with a stored stamp and a difference. What emerges is the time-to-live family: HTTP cache-control, DNS records, session tokens, memo tables that forget. Same family: expiry dates on food, certificate validity windows. In book-of-composition this is the self-describing-freshness shape — the datum carries the information needed to judge it."
     :eng "Store the stamp with the value. A cache whose entries do not know their own age cannot be swept."
     :math "The composition is a threshold on a difference: fresh ⟺ now − then ≤ ttl."
     :cs "The CS pattern name is TTL expiry. Familiar analogs: Cache-Control max-age, DNS TTL, JWT exp.")
))

(verb
  :name "jiffies-per-second" :std "R7RS-small"
  :library "time"
  :kind "pure"
  :signature "(jiffies-per-second) -> exact-integer"
  :summary "Returns how many jiffies make one second on this implementation."
  :provenance "R7RS §6.14 (system interface); implemented in lib/base/r7rs-small.js, returns the constant 1000."
  :explanation "jiffies-per-second is the conversion factor that makes current-jiffy portable. R7RS deliberately declines to fix the size of a jiffy — one implementation may tick a thousand times a second, another a million — so every program that wants seconds asks the runtime for the rate and divides. In Motoi the answer is always 1000, because a jiffy is a millisecond. The verb takes no arguments, returns an exact integer, and returns the same number for the life of the process; it is a constant dressed as a procedure so that an implementation with a runtime-discovered clock rate can still conform."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(jiffies-per-second)" :note "1000 — one jiffy is one millisecond in Motoi.")
    (:dialect "motoi" :tier "intermediate" :code "(exact? (jiffies-per-second))" :note "#t — an exact integer, so dividing jiffies by it stays exact.")
    (:dialect "motoi" :tier "expert" :code "(define (jiffies->seconds j) (/ j (jiffies-per-second)))\n(display (jiffies->seconds 2500)) (newline)" :note "5/2 — the portable jiffy-to-second conversion, written once. Both operands are exact, so the answer is the exact rational rather than the double 2.5.")
  )
  :caveats ("The value is 1000 in Motoi but is NOT part of the standard — never hard-code 1000; always call the verb, or the program breaks on any other Scheme." "It is a procedure, not a variable: (jiffies-per-second) with parentheses. Referring to the bare name yields the procedure object." "The rate describes the clock's UNIT, not its resolution or accuracy. A rate of 1000 does not promise that consecutive readings differ by less than 1000.")
  :drawbacks ("A per-implementation constant means benchmark numbers are only comparable after conversion; raw jiffy counts from two Schemes cannot be compared." "Because it is fixed at 1000, Motoi cannot express sub-millisecond timing at all through the jiffy interface.")
  :usecases ("Converting a jiffy difference into seconds." "Writing a portable timer that runs unchanged on another R7RS Scheme." "Computing a per-second rate from a count and a jiffy span." "Deciding whether the host clock is fine-grained enough for a given measurement.")
  :related ("current-jiffy" "current-second" "time/delta")
  :learn (:concept "A portable measurement asks the runtime for its unit rather than assuming one; the constant lives in the implementation, the arithmetic lives in your code." :prerequisites ("current-jiffy") :progression "Learn jiffies-per-second as the companion to current-jiffy, then write one jiffies->seconds helper and never divide by a literal again.")
  :row-2-audit (
    (:eng-program "(define (jiffies->seconds j) (/ j (jiffies-per-second)))\n(display (jiffies->seconds 2500)) (newline)\n(display (jiffies->seconds 0)) (newline)"
     :math-program "(define (convert j rate) (/ j rate))\n(display (= (convert 2000 1000) 2)) (newline)\n(display (= (convert 2000 2000) 1)) (newline)"
     :cs-program "(define (portable? divisor-used) (= divisor-used (jiffies-per-second)))\n(display (portable? (jiffies-per-second))) (newline)\n(display (portable? 60)) (newline)"
     :problem "The operator wrote a benchmark that divides a jiffy difference by 1000 and it reports correct seconds on their machine. Then it is run on a Scheme whose jiffy is a microsecond and every number comes out a thousand times too small. The audit question is whether the divisor was ASKED FOR or ASSUMED — the only correct divisor is (jiffies-per-second)."
     :explanation "eng: one helper owns the conversion so there is exactly one place a wrong divisor could hide. math: the same jiffy count converts to different seconds under different rates, which is the whole reason the rate must be queried. cs: a portability check that compares a hard-coded divisor against the runtime's own answer."
     :meta "Why jiffies-per-second and not the literal 1000: 1000 is true of Motoi and of nothing else in the standard. Why not current-second as the divisor source: that verb returns a reading, not a rate, and dividing by a reading is a unit error. The audit tell is any numeric literal appearing next to a jiffy difference.")
    (:eng "Grep for the literal next to a time computation. A bare 1000 beside a jiffy delta is the bug."
     :math "seconds = jiffies / rate; the rate is a property of the clock, not of the program."
     :cs "The CS pattern is unit-carrying conversion. Related: CLOCKS_PER_SEC in C, TimeSpan.TicksPerSecond in .NET.")
)
  :row-3-dimension (
    (:setup "The queried unit: a scale factor obtained from the instrument rather than baked into the reader."
     :rungs ((:domain "time (jiffies per second)" :code "(define (jiffies->seconds j) (/ j (jiffies-per-second)))\n(display (jiffies->seconds 2500)) (newline)")
             (:domain "cartography (a map's own scale bar, printed on the map)" :code "(define (map->ground cm scale) (* cm scale))\n(display (map->ground 7 25000)) (newline)")
             (:domain "dimensional analysis (multiply by a conversion factor equal to 1)" :code "(define (convert q from-per-to) (/ q from-per-to))\n(display (convert 2000 1000)) (newline)\n(display (convert 2000 2000)) (newline)"))
     :explanation "A jiffy count needs the clock's rate to become seconds. A distance measured on a map needs the map's own scale bar to become ground distance. A quantity in one unit needs a conversion factor to become another. All three share the shape 'the instrument publishes its own scale, and the reader must consult it.'"
     :meta "The shape transfers wherever the same numeral means different amounts on different instruments. The tell is that the number alone is not the measurement.")
    (:eng "Read the scale off the instrument every time. A remembered scale is a defect waiting for a hardware change."
     :math "Conversion is multiplication by a factor equal to 1 in the target units."
     :cs "The CS analog is the self-describing format — the header carries the encoding."))
  :row-4-proof (
    (:eng-program "(define r (jiffies-per-second))\n(display (and (exact? r) (integer? r) (> r 0))) (newline)"
     :math-program "(define (round-trip j rate) (= j (* rate (/ j rate))))\n(display (round-trip 2500 1000)) (newline)\n(display (round-trip 0 1000)) (newline)"
     :cs-program "(display (= (jiffies-per-second) (jiffies-per-second))) (newline)"
     :claim "The rate is a positive exact integer that does not change during the run, so converting jiffies to seconds and back recovers the original count exactly."
     :invariant "∀ j ∈ ℤ. let r = (jiffies-per-second) in r > 0 ∧ r · (j / r) = j"
     :meta "The pattern is an invertible scaling by a nonzero constant. See book-of-math ch on units and linear maps. What falsifies: a rate of 0 (division undefined) or a rate that changes mid-run (two conversions of the same count disagree). Motoi returns a fixed 1000, so both failure modes are excluded here — but the invariant is what a port to another Scheme must re-check.")
    (:eng "Smoke test: positive, exact, integral, and stable across two calls."
     :math "Scaling by a nonzero constant is a bijection on the rationals; the inverse is scaling by its reciprocal."
     :cs "The CS pattern is the immutable configuration constant.")
)
  :row-5-emergence (
    (:eng-composition "(define (jiffies->seconds j) (/ j (jiffies-per-second)))\n(define (throughput n jiffies)\n  (let ((s (jiffies->seconds jiffies)))\n    (if (= s 0) 'too-fast-to-measure (/ n s))))\n(display (throughput 500 2000)) (newline)\n(display (throughput 500 0)) (newline)"
     :math-composition "(define (per-second n jiffies rate)\n  (if (= jiffies 0) 'undefined (/ (* n rate) jiffies)))\n(display (per-second 500 2000 1000)) (newline)\n(display (per-second 500 2000 2000)) (newline)"
     :cs-composition "(define (resolution-ok? wanted-hz) (>= (jiffies-per-second) wanted-hz))\n(display (resolution-ok? 100)) (newline)\n(display (resolution-ok? 1000000)) (newline)"
     :base "jiffies-per-second reports the clock's own unit as an exact integer."
     :emergent "throughput meter with a measurability guard — a rate computation that refuses to divide by a span too short for the clock to see"
     :meta "The composition chains the rate with a jiffy difference and a zero check. What emerges is the measurable-window family: a benchmark that widens its loop until the span is large enough to divide by, a sampler that reports 'below resolution' instead of infinity. Same family: instrument detection limits, minimum exposure times, sample-size floors in statistics. In book-of-composition this is the guarded-division shape."
     :eng "Report 'too fast to measure' rather than a fabricated rate. An unguarded division here produces a division error or a meaningless number."
     :math "The composition is n·r / Δj, undefined at Δj = 0."
     :cs "The CS pattern name is guarded throughput. Familiar analogs: benchmark warm-up loops, minimum sampling windows.")
))
