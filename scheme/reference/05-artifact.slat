;;; 05-artifact.slat — Motoi Scheme Reference · Chapter 05 · library artifact
;;;
;;; 4 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.
;;;
;;; Doctrine: artifact verbs are async — return a 'pending marker; the resulting
;;; event carries the outcome. Compose with event handlers, not synchronous binding.
;;;
;;; CAVEAT (2026-08-02): that doctrine holds for artifact/list, which src/base.js
;;; installs as a DOM surface verb. It does NOT describe artifact/save, /cite or
;;; /delete, which lib/system/artifact.js implements synchronously against
;;; ~/motoi/artifacts/. Those three carry :status "needs-alfred"; read their
;;; :status-note before trusting anything in their rows.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library artifact — 4 verbs.")

(chapter :number "05" :library "artifact" :verb-count 4 :training-eligible #t)

(verb :name "artifact/cite" :std "Motoi" :library "artifact" :tier "core" :kind "state-change"
  :status "needs-alfred"
  :status-note "DIVERGENCE — NOT a typo, needs a ruling. This chapter documents artifact/cite as async: :signature says \"-> pair\", the summary and every row say it returns ('pending msg) and delivers the outcome on an artifact-cite event. lib/system/artifact.js implements it synchronously against ~/motoi/artifacts/ under an in-code \"Doctrine (Alfred, LOCK)\" dated 2026-07-16 — six days before this chapter was authored (2026-07-22). Measured headless on 2026-08-02: (artifact/cite 'a-42) returns #f when nothing is saved under that name, and the alist ((:name a-42) (:path <abs path>) (:size 5) (:mtime 1785704270764)) when there is. Never a pair whose car is 'pending, so (car (artifact/cite id)) raises on the #f. The async contract cannot be honoured headless because the event bus it needs (artifact/on-event) is a browser-only stub in src/base.js that throws outside the DOM; artifact/list, the one genuine DOM verb here, already concedes this by wrapping every snippet in (guard (exn (#t 'pending)) ...). Which contract is canonical decides the public API, so it is not an editor's call. The row-4 proofs below assert the async contract and therefore FAIL today; they are left as authored rather than rewritten to whichever answer happens to be green. Note also that :mtime is wall-clock, so no example may assert it." :signature "(artifact/cite id) -> pair"
  :summary "Async: fetch an artifact by ID; dispatches artifact-cite event with the result."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(artifact/cite 'a-42)" :note "Kick off a cite — returns ('pending msg).")
    (:dialect "motoi" :tier "intermediate" :code "(begin (artifact/cite 'a-42) 'awaiting-event)" :note "Return to event-driven flow.")
    (:dialect "motoi" :tier "expert"       :code "(define (cite-and-track id) (artifact/cite id) (list :cited id :at 'now))\n(cite-and-track 'a-42)" :note "Cite plus local tracking record."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(artifact/cite 'a-42)"
     :math-program "(define (kickoff id) (artifact/cite id))\n(kickoff 'a-42)"
     :cs-program "(define (safe-cite id) (if (symbol? id) (artifact/cite id) (error 'need-symbol)))\n(safe-cite 'a-42)"
     :problem "Reference an artifact in a response — must fire the cite so the surface can display it, without blocking."
     :explanation "eng: fire-and-move-on. math: async kick. cs: type-guarded launch."
     :meta "Reach for artifact/cite and NOT artifact/list-with-id: cite dispatches for THIS id; list is a query.")
    (:eng "Fire and continue reasoning." :math "Async kickoff." :cs "Message-dispatch API."))
  :row-3-dimension (
    (:setup "Async kickoff on an ID; event carries result."
     :rungs (
       (:domain "engineering"  :code "(define (kickoff id) (artifact/cite id))\n(kickoff 'a-42)")
       (:domain "mathematics"  :code "(define (kickoff id) (artifact/cite id))\n(kickoff 'a-42)")
       (:domain "cs / dispatch" :code "(define (kickoff id) (artifact/cite id))\n(kickoff 'a-42)"))
     :explanation "Direct, canonicalized, parsed dispatch."
     :meta "Async request-response by event.")
    (:eng "Non-blocking initiation." :math "Async projection to event-space." :cs "Pub-sub trigger."))
  :row-4-proof (
    (:eng-program "(equal? (car (artifact/cite 'a-42)) 'pending)"
     :math-program "(define (returns-pending? r) (and (pair? r) (eq? (car r) 'pending)))\n(returns-pending? (artifact/cite 'x))"
     :cs-program "(define (deterministic-kick? id) (equal? (car (artifact/cite id)) 'pending))\n(deterministic-kick? 'a-42)"
     :claim "Returns ('pending msg) synchronously; result arrives via event."
     :invariant "∀ id. car(artifact/cite(id)) = 'pending"
     :meta "Pattern: async kickoff with pending marker.")
    (:eng "Non-blocking contract keeps callers responsive." :math "Total return domain includes only 'pending." :cs "Async API discipline."))
  :row-5-emergence (
    (:eng-composition "(define (cite-many ids) (for-each artifact/cite ids))\n(cite-many (list 'a 'b 'c))"
     :math-composition "(define (cite-and-record ids) (map (lambda (id) (artifact/cite id) id) ids))\n(cite-and-record (list 'a 'b))"
     :cs-composition "(define (batch-fire ids on-fire) (for-each (lambda (id) (artifact/cite id) (on-fire id)) ids))\n(batch-fire (list 'a) (lambda (id) id))"
     :base "artifact/cite is an async citation kickoff."
     :emergent "Compositions: eng batch cite, math cite-and-record, cs fire-with-observer."
     :meta "Family: async batch trigger.")
    (:eng "Batch cites fan out; events aggregate." :math "Batched async projection." :cs "Publish-many with observer callback."))
)

(verb :name "artifact/delete" :std "Motoi" :library "artifact" :tier "core" :kind "state-change"
  :status "needs-alfred"
  :status-note "DIVERGENCE — NOT a typo, needs a ruling. This chapter documents artifact/delete as async: :signature says \"-> pair\", the summary and every row say it returns ('pending msg) and delivers the outcome on an artifact-delete event. lib/system/artifact.js implements it synchronously against ~/motoi/artifacts/ under an in-code \"Doctrine (Alfred, LOCK)\" dated 2026-07-16 — six days before this chapter was authored (2026-07-22). Measured headless on 2026-08-02: (artifact/delete 'a-42) returns #t when the file existed and was removed, #f when it did not. A boolean, never a pair, so (car (artifact/delete id)) raises. The async contract cannot be honoured headless because the event bus it needs (artifact/on-event) is a browser-only stub in src/base.js that throws outside the DOM; artifact/list, the one genuine DOM verb here, already concedes this by wrapping every snippet in (guard (exn (#t 'pending)) ...). Which contract is canonical decides the public API, so it is not an editor's call. The row-4 proofs below assert the async contract and therefore FAIL today; they are left as authored rather than rewritten to whichever answer happens to be green. " :signature "(artifact/delete id) -> pair"
  :summary "Async: delete an artifact by ID; dispatches artifact-delete event with the result."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(artifact/delete 'a-42)" :note "Kick off a delete — returns ('pending msg).")
    (:dialect "motoi" :tier "intermediate" :code "(begin (artifact/delete 'a-42) 'awaiting-confirm)" :note "Continue while the event resolves.")
    (:dialect "motoi" :tier "expert"       :code "(define (soft-delete id) (artifact/delete id) (list :deleted-marker id))\n(soft-delete 'a-42)" :note "Post-fire tracking record."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(artifact/delete 'a-42)"
     :math-program "(define (kickoff-delete id) (artifact/delete id))\n(kickoff-delete 'a-42)"
     :cs-program "(define (safe-delete id) (if (symbol? id) (artifact/delete id) (error 'need-symbol)))\n(safe-delete 'a-42)"
     :problem "Remove an artifact but don't block on confirmation — event will confirm."
     :explanation "eng: fire-and-move-on. math: async remove. cs: type-guarded delete."
     :meta "Reach for artifact/delete and NOT sync-remove: sync would block; delete is async and event-confirmed.")
    (:eng "Non-blocking removal." :math "Async projection." :cs "Delete + event pattern."))
  :row-3-dimension (
    (:setup "Async remove-by-id."
     :rungs (
       (:domain "engineering"  :code "(define (kickoff-delete id) (artifact/delete id))\n(kickoff-delete 'a-42)")
       (:domain "mathematics"  :code "(define (kickoff-delete id) (artifact/delete id))\n(kickoff-delete 'a-42)")
       (:domain "cs / dispatch" :code "(define (kickoff-delete id) (artifact/delete id))\n(kickoff-delete 'a-42)"))
     :explanation "Direct, canonicalized, parsed dispatch."
     :meta "Async DELETE by ID.")
    (:eng "Fire once, confirm by event." :math "Async removal projection." :cs "Pub-sub delete."))
  :row-4-proof (
    (:eng-program "(equal? (car (artifact/delete 'a-42)) 'pending)"
     :math-program "(define (returns-pending? r) (and (pair? r) (eq? (car r) 'pending)))\n(returns-pending? (artifact/delete 'x))"
     :cs-program "(define (deterministic-kick? id) (equal? (car (artifact/delete id)) 'pending))\n(deterministic-kick? 'a-42)"
     :claim "Returns ('pending msg); event carries confirmation."
     :invariant "∀ id. car(artifact/delete(id)) = 'pending"
     :meta "Pattern: async kickoff with pending marker.")
    (:eng "Non-blocking removes keep UI responsive." :math "Total return in {'pending}." :cs "Async delete contract."))
  :row-5-emergence (
    (:eng-composition "(define (cleanup-batch ids) (for-each artifact/delete ids))\n(cleanup-batch (list 'a 'b 'c))"
     :math-composition "(define (delete-then-record ids) (map (lambda (id) (artifact/delete id) id) ids))\n(delete-then-record (list 'a 'b))"
     :cs-composition "(define (gc-scan ids should-delete?) (for-each (lambda (id) (when (should-delete? id) (artifact/delete id))) ids))\n(gc-scan (list 'a) (lambda (id) #t))"
     :base "artifact/delete is an async remove kickoff."
     :emergent "Compositions: eng batch cleanup, math delete-then-record, cs GC scanner."
     :meta "Family: async removal pipelines.")
    (:eng "Batch cleanup — events confirm each removal." :math "Batched async projection." :cs "Same shape as GC sweep with per-item confirmation."))
)

(verb :name "artifact/list" :std "Motoi" :library "artifact" :tier "core" :kind "state-change" :signature "(artifact/list options) -> pair"
  :summary "Async: query artifacts by kind/bot/tag/limit; dispatches artifact-list event with results."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(guard (exn (#t 'pending))\n  (artifact/list (list (cons 'kind 'sketch))))" :note "Query by kind.")
    (:dialect "motoi" :tier "intermediate" :code "(guard (exn (#t 'pending))\n  (artifact/list (list (cons 'kind 'note) (cons 'limit 10))))" :note "Kind + limit.")
    (:dialect "motoi" :tier "expert"       :code "(guard (exn (#t 'pending))\n  (begin\n    (define (query-by-tag tag) (artifact/list (list (cons 'tag tag) (cons 'limit 20))))\n    (query-by-tag 'production)))" :note "Named helper for tag-scoped list."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(guard (exn (#t 'pending))\n  (artifact/list (list (cons 'kind 'sketch))))"
     :math-program "(guard (exn (#t 'pending))\n  (begin\n    (define (list-by-kind k) (artifact/list (list (cons 'kind k))))\n    (list-by-kind 'note)))"
     :cs-program "(guard (exn (#t 'pending))\n  (begin\n    (define (safe-list opts) (if (list? opts) (artifact/list opts) (error 'need-alist)))\n    (safe-list (list (cons 'kind 'sketch)))))"
     :problem "Curate a set of artifacts by shared property — without blocking on the query."
     :explanation "eng: query kickoff. math: predicate-shape query. cs: type-guarded list."
     :meta "Reach for artifact/list and NOT artifact/cite: cite is single-ID; list is a filter over the whole store.")
    (:eng "Non-blocking query; result arrives by event." :math "Predicate query on the store." :cs "Async SELECT."))
  :row-3-dimension (
    (:setup "Async filter over a store."
     :rungs (
       (:domain "engineering"  :code "(guard (exn (#t 'pending))\n  (begin\n    (define options (list (cons 'kind 'sketch)))\n    (artifact/list options)))")
       (:domain "mathematics"  :code "(guard (exn (#t 'pending))\n  (begin\n    (define (predicate-options) (list (cons 'kind 'note) (cons 'limit 5)))\n    (artifact/list (predicate-options))))")
       (:domain "cs / dispatch" :code "(guard (exn (#t 'pending))\n  (begin\n    (define msg (list (cons 'kind 'sketch)))\n    (define (parse-query m) m)\n    (artifact/list (parse-query msg))))"))
     :explanation "Direct, math-typed predicate options, parsed dispatch."
     :meta "Async SELECT.")
    (:eng "Query kickoff; event carries page." :math "Predicate over indexed store." :cs "SQL SELECT with async return."))
  :row-4-proof (
    (:eng-program "(guard (exn (#t 'pending))\n  (equal? (car (artifact/list (list (cons 'kind 'sketch)))) 'pending))"
     :math-program "(guard (exn (#t 'pending))\n  (begin\n    (define (returns-pending? r) (and (pair? r) (eq? (car r) 'pending)))\n    (returns-pending? (artifact/list '()))))"
     :cs-program "(guard (exn (#t 'pending))\n  (begin\n    (define (deterministic-kick? opts) (equal? (car (artifact/list opts)) 'pending))\n    (deterministic-kick? '())))"
     :claim "Returns ('pending msg); event carries result set."
     :invariant "∀ opts. car(artifact/list(opts)) = 'pending"
     :meta "Pattern: async kickoff with pending marker.")
    (:eng "Non-blocking queries keep UI responsive." :math "Total return in {'pending}." :cs "Async SELECT contract."))
  :row-5-emergence (
    (:eng-composition "(guard (exn (#t 'pending))\n  (begin\n    (define (list-and-then options continuation) (artifact/list options) (continuation options))\n    (list-and-then (list (cons 'kind 'sketch)) (lambda (o) 'awaiting))))"
     :math-composition "(guard (exn (#t 'pending))\n  (begin\n    (define (list-multi-kinds ks) (for-each (lambda (k) (artifact/list (list (cons 'kind k)))) ks))\n    (list-multi-kinds (list 'sketch 'note))))"
     :cs-composition "(guard (exn (#t 'pending))\n  (begin\n    (define (paginated-list options page-size) (artifact/list (cons (cons 'limit page-size) options)))\n    (paginated-list (list (cons 'kind 'note)) 10)))"
     :base "artifact/list kicks off async queries."
     :emergent "Compositions: eng list-then-continue, math multi-kind fanout, cs pagination."
     :meta "Family: async query pipeline.")
    (:eng "List-then-continue keeps flow non-blocking." :math "Fanout over kind-set." :cs "Pagination pattern."))
)

(verb :name "artifact/save" :std "Motoi" :library "artifact" :tier "core" :kind "state-change"
  :status "needs-alfred"
  :status-note "DIVERGENCE — NOT a typo, needs a ruling. This chapter documents artifact/save as async: :signature says \"-> pair\", the summary and every row say it returns ('pending msg) and delivers the outcome on an artifact-save event. lib/system/artifact.js implements it synchronously against ~/motoi/artifacts/ under an in-code \"Doctrine (Alfred, LOCK)\" dated 2026-07-16 — six days before this chapter was authored (2026-07-22). Measured headless on 2026-08-02: the implementation takes TWO arguments, (artifact/save name content), and returns the absolute path written or #f on failure. Every example in this record passes ONE argument — the options alist the :signature specifies — so `content` is undefined and the write fails: (artifact/save (list (cons 'kind 'x) (cons 'payload 'y))) returns #f and stores nothing. The async contract cannot be honoured headless because the event bus it needs (artifact/on-event) is a browser-only stub in src/base.js that throws outside the DOM; artifact/list, the one genuine DOM verb here, already concedes this by wrapping every snippet in (guard (exn (#t 'pending)) ...). Which contract is canonical decides the public API, so it is not an editor's call. The row-4 proofs below assert the async contract and therefore FAIL today; they are left as authored rather than rewritten to whichever answer happens to be green. This is the sharper half of the divergence: the save examples do not merely mis-describe their return value, they silently persist nothing. The arity is part of what needs ruling — options-alist per the reference, or name+content per the code." :signature "(artifact/save options) -> pair"
  :summary "Async: save an artifact (kind, payload, optional title/bot/tags); dispatches artifact-save event."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(define data (list 'stroke (list 0 0) (list 100 100)))\n(artifact/save (list (cons 'kind 'sketch) (cons 'payload data)))" :note "Minimum required fields.")
    (:dialect "motoi" :tier "intermediate" :code "(define data \"Draft note content\")\n(artifact/save (list (cons 'kind 'note) (cons 'payload data) (cons 'title \"Draft\")))" :note "With optional title.")
    (:dialect "motoi" :tier "expert"       :code "(define (save-tagged kind payload tags) (artifact/save (list (cons 'kind kind) (cons 'payload payload) (cons 'tags tags))))\n(save-tagged 'sketch 'data (list 'production))" :note "Wrapped named helper."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(artifact/save (list (cons 'kind 'sketch) (cons 'payload 'data)))"
     :math-program "(define (kickoff-save o) (artifact/save o))\n(kickoff-save (list (cons 'kind 'x) (cons 'payload 'y)))"
     :cs-program "(define (safe-save opts) (if (and (list? opts) (assoc 'kind opts) (assoc 'payload opts)) (artifact/save opts) (error 'missing-required)))\n(safe-save (list (cons 'kind 'x) (cons 'payload 'y)))"
     :problem "Persist an artifact for later retrieval without blocking on the store."
     :explanation "eng: save kickoff. math: async persist. cs: precondition-guarded save."
     :meta "Reach for artifact/save and NOT artifact/list: save writes; list reads.")
    (:eng "Fire and continue reasoning." :math "Async persist projection." :cs "INSERT + event confirm."))
  :row-3-dimension (
    (:setup "Async persist with metadata."
     :rungs (
       (:domain "engineering"  :code "(define (kickoff-save o) (artifact/save o))\n(kickoff-save (list (cons 'kind 'x) (cons 'payload 'y)))")
       (:domain "mathematics"  :code "(define (kickoff-save o) (artifact/save o))\n(kickoff-save (list (cons 'kind 'x) (cons 'payload 'y)))")
       (:domain "cs / dispatch" :code "(define (kickoff-save o) (artifact/save o))\n(kickoff-save (list (cons 'kind 'x) (cons 'payload 'y)))"))
     :explanation "Direct, canonicalized, parsed dispatch."
     :meta "Async INSERT.")
    (:eng "Fire once, confirm by event." :math "Async persist." :cs "SQL INSERT with async event."))
  :row-4-proof (
    (:eng-program "(equal? (car (artifact/save (list (cons 'kind 'x) (cons 'payload 'y)))) 'pending)"
     :math-program "(define (returns-pending? r) (and (pair? r) (eq? (car r) 'pending)))\n(returns-pending? (artifact/save (list (cons 'kind 'x) (cons 'payload 'y))))"
     :cs-program "(define (deterministic-kick? opts) (equal? (car (artifact/save opts)) 'pending))\n(deterministic-kick? (list (cons 'kind 'x) (cons 'payload 'y)))"
     :claim "Returns ('pending msg); event carries id + confirm."
     :invariant "∀ opts w/ kind+payload. car(artifact/save(opts)) = 'pending"
     :meta "Pattern: async kickoff with pending marker.")
    (:eng "Non-blocking writes." :math "Total return in {'pending}." :cs "Async INSERT contract."))
  :row-5-emergence (
    (:eng-composition "(define (save-batch items) (for-each (lambda (i) (artifact/save i)) items))\n(save-batch (list (list (cons 'kind 'a) (cons 'payload 'd))))"
     :math-composition "(define (save-with-tag items tag) (for-each (lambda (i) (artifact/save (cons (cons 'tags (list tag)) i))) items))\n(save-with-tag (list (list (cons 'kind 'x) (cons 'payload 'y))) 'production)"
     :cs-composition "(define (queue-drain items save-fn) (for-each save-fn items))\n(queue-drain (list (list (cons 'kind 'x) (cons 'payload 'y))) artifact/save)"
     :base "artifact/save kicks off async persistence."
     :emergent "Compositions: eng batch save, math tagged save, cs queue drain."
     :meta "Family: async write pipeline.")
    (:eng "Batch saves fan out; events confirm each." :math "Batched async persist." :cs "Queue-drain to store."))
)
