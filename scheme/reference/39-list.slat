     :cs "Named accessor idiom.")
)
  :row-5-emergence (
    (:eng-composition "(define (pick-days days idxs) (map (lambda (get) (get days)) idxs))\n(display (pick-days (list 'mon 'tue 'wed 'thu 'fri 'sat 'sun) (list first fourth sixth)))\n(newline)"
     :math-composition "'honest-null-math ; accessors-as-values is a first-class-function pattern, not an algebraic composition."
     :cs-composition "(define (project-fields getters record)\n  (map (lambda (g) (g record)) getters))\n(define log-row (list 'level 'INFO 'ts 1729 'user 'alice 'msg \"boot\"))\n(display (project-fields (list second fourth sixth) log-row))\n(newline)"
     :base "sixth returns the sixth element."
