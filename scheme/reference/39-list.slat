     :cs-program "(define (safe-sixth xs default)\n  (if (and (list? xs) (>= (length xs) 6)) (sixth xs) default))\n(display (list (safe-sixth (list 'a 'b 'c 'd 'e 'f 'g) 'MISS) (safe-sixth (list 'x 'y 'z) 'MISS)))\n(newline)"
