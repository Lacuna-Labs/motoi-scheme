;;; 14-collision.slat — Motoi Scheme Reference · Chapter 14 · library collision
;;;
;;; 5 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.
;;; 4 verbs added 2026-08-02: near? · in-rect? · overlap? · layer-bit-index.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library collision — 5 verbs.")

(chapter :number "14" :library "collision" :verb-count 5 :training-eligible #t)

(verb :name "collision/define-layers!" :std "Motoi" :library "collision" :tier "core" :kind "state-change" :signature "(collision/define-layers! layer-names) -> null"
  :summary "Name up to 31 collision layers by index; assigns collision bits."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(collision/define-layers! (list 'player 'enemy 'projectile))" :note "Three named layers, bits 0/1/2.")
    (:dialect "motoi" :tier "intermediate" :code "(collision/define-layers! (list 'player 'enemy 'projectile 'wall 'pickup))" :note "Five layers — a compact platformer collision spec.")
    (:dialect "motoi" :tier "expert"       :code "(define (init-game-layers config) (collision/define-layers! (map car config)) (for-each (lambda (row) (entity/mask! (car row) (cadr row))) config))\n(init-game-layers (list (list 'player (list 'enemy 'wall)) (list 'enemy (list 'wall 'projectile))))" :note "Initialize layers + configure collision masks per layer."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (setup-collisions) (collision/define-layers! (list 'player 'enemy 'projectile 'wall)))\n(setup-collisions)"
     :math-program "(define (layer-bitset-count n) (collision/define-layers! (map (lambda (i) (string->symbol (string-append \"L\" (number->string i)))) (iota n))) n)\n(layer-bitset-count 5)"
     :cs-program "(define (safe-init layers) (if (and (list? layers) (<= (length layers) 31)) (collision/define-layers! layers) (error 'too-many-layers)))\n(safe-init (list 'a 'b 'c))"
     :problem "Collision detection needs pre-registered layer names before entities are spawned; late-registration breaks bit-mask correctness."
     :explanation "eng: startup setup. math: bitset counting. cs: pre-check length."
     :meta "Reach for collision/define-layers! ONCE at startup; the bit assignment order matters.")
    (:eng "Startup routine registers layers." :math "Bit-index assignment is left-to-right." :cs "Idempotent-first, error-on-second-call."))
  :row-3-dimension (
    (:setup "Namespace registration for a discrete label set."
     :rungs (
       (:domain "engineering"  :code "(collision/define-layers! (list 'player 'enemy))")
       (:domain "mathematics"  :code "(define (layer-bitset-count n) (collision/define-layers! (map (lambda (i) (string->symbol (string-append \"L\" (number->string i)))) (iota n))) n)\n(layer-bitset-count 5)")
       (:domain "cs / dispatch" :code "(define (layer-bitset-count n) (collision/define-layers! (map (lambda (i) (string->symbol (string-append \"L\" (number->string i)))) (iota n))) n)\n(layer-bitset-count 5)"))
     :explanation "Hardcoded, math bitset labels, parsed config."
     :meta "Label-to-bit registration is universal.")
    (:eng "Layer namespace fixes collision semantics." :math "Injection Labels → Bits." :cs "Config-driven initialization."))
  :row-4-proof (
    (:eng-program "(define (layer-index? layer) (integer? (layer-bit-index layer)))\n(collision/define-layers! (list 'a 'b))\n(layer-index? 'a)"
     :math-program "(define (bit-order-preserved? layers) (let ((names (map car (map cons layers (iota (length layers)))))) (equal? layers names)))\n(bit-order-preserved? (list 'x 'y 'z))"
     :cs-program "(collision/define-layers! (list 'p 'q 'r))\n(define (layer-bit-index layer) (case layer ((p) 0) ((q) 1) ((r) 2) (else -1)))\n(define bits (map layer-bit-index (list 'p 'q 'r)))\n(equal? bits (delete-duplicates bits))"
     :claim "Each layer name gets a unique bit index; order is preserved."
     :invariant "∀ layers. |bit-indices(layers)| = |layers| ∧ order(bit-indices) = order(layers)"
     :meta "Pattern: name-to-bit bijection.")
    (:eng "Uniqueness prevents mask collision." :math "Bijection Labels ↔ Bits." :cs "Deterministic assignment."))
  :row-5-emergence (
    (:eng-composition "(define (setup-game) (collision/define-layers! (list 'player 'enemy 'wall)) (entity/mask! 'player (list 'enemy 'wall)))\n(setup-game)"
     :math-composition "(define (layer-topology adj) (collision/define-layers! (map car adj)) (map (lambda (row) (entity/mask! (car row) (cdr row))) adj))\n(layer-topology (list (list 'a 'b) (list 'b 'a)))"
     :cs-composition "(define (assoc-ref key alist) (let ((pair (assq key alist))) (if pair (cdr pair) '())))\n(define (init-from-config config) (collision/define-layers! (assoc-ref :layers config)) (for-each (lambda (mask) (entity/mask! (car mask) (cdr mask))) (assoc-ref :masks config)))\n(init-from-config (list (cons :layers (list 'p 'e)) (cons :masks (list (cons 'p (list 'e))))))"
     :base "collision/define-layers! registers labels."
     :emergent "Compositions: eng game setup, math topology-from-adjacency, cs config-driven init."
     :meta "Family: collision configuration.")
    (:eng "Game initialization defines the collision universe." :math "Topology emerges from adjacency lists." :cs "Config-driven bootstrap."))
)

(verb :name "near?" :std "Motoi" :library "collision" :tier "core" :kind "pure" :signature "(near? x1 y1 x2 y2 r) -> boolean"
  :summary "True when the two points are within r of each other — a circle-vs-circle proximity test."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(near? 0 0 3 4 5)" :note "#t — the 3-4-5 triangle puts the second point exactly 5 away, and the radius is inclusive.")
    (:dialect "motoi" :tier "intermediate" :code "(map (lambda (p) (near? 0 0 (car p) (cadr p) 10)) (list (list 6 8) (list 9 9)))" :note "(#t #f) — (6,8) sits exactly 10 away and passes; (9,9) is about 12.7 away and fails.")
    (:dialect "motoi" :tier "expert"       :code "(define (aggro-list px py enemies radius)\n  (filter (lambda (e) (near? px py (car e) (cadr e) radius)) enemies))\n(length (aggro-list 0 0 (list (list 1 1) (list 30 30) (list 2 2)) 10))" :note "2 — only two of the three enemies are inside the ten-pixel aggro radius."))
  :provenance "Motoi core (src/base.js, the game-kit collision block); documented 2026-08-02."
  :status "needs-alfred"
  :caveats ("EXACT RATIONALS ARE SILENTLY WRONG. (near? 0 0 3/2 2 5/2) is #f, but the same point in floats — (near? 0 0 1.5 2 2.5) — is #t. src/base.js computes Math.hypot on the raw arguments, and an exact rational is an object rather than a JS number, so the distance comes out NaN and every comparison against it is false. Same defect in in-rect?, overlap? and dist ((dist 0 0 3/2 2) is +nan.0). Pass inexact coordinates until this is fixed." "The radius is INCLUSIVE: a point at exactly r counts as near. (near? 0 0 3 4 5) is #t." "A negative radius makes every answer #f, since a distance is never negative — it fails silently rather than erroring." "Coordinates are plain numbers, not points; there is no list-of-two form.")
  :row-2-audit (
    (:eng-program "(define (in-blast? bx by ex ey) (near? bx by ex ey 24))\n(list (in-blast? 100 100 110 110) (in-blast? 100 100 200 200))"
     :math-program "(define (euclid-le? x1 y1 x2 y2 r) (<= (+ (* (- x2 x1) (- x2 x1)) (* (- y2 y1) (- y2 y1))) (* r r)))\n(list (near? 0 0 3 4 5) (euclid-le? 0 0 3 4 5))"
     :cs-program "(define (safe-near? x1 y1 x2 y2 r) (if (< r 0) (error 'negative-radius) (near? x1 y1 x2 y2 r)))\n(safe-near? 0 0 1 1 2)"
     :problem "A designer needs a pickup to be collected when the player gets close, but the pickup is round and the player is round — an axis-aligned box test snags on the corners and grabs coins the player visibly never touched."
     :explanation "eng: express a blast radius as one call so the tuning number lives in one place. math: show that near? is the squared-distance inequality, stated with the square root already taken. cs: guard the radius domain before trusting the answer."
     :meta "overlap? would model both actors as boxes and fire early at the diagonal corners; in-rect? treats one side as a rectangle and inherits the same corner bias; dist gives you the number but makes every caller re-type the comparison and re-decide whether the boundary counts. near? is the round-vs-round test with the inclusive boundary already fixed.")
    (:eng "The audit lens is 'does the hit look fair on the diagonal?' — probe one point at exactly r, one just inside, one just outside; a box test fails the diagonal probe." :math "It is the closed disc membership test ‖p₂ − p₁‖ ≤ r, so the boundary belongs to the region." :cs "O(1) per pair with one hypot; the broad-phase primitive behind any radius query."))
  :row-3-dimension (
    (:setup "One centre, one radius, and a yes/no question about whether something else falls inside."
     :rungs (
       (:domain "game"      :code "(near? 0 0 3 4 5)")
       (:domain "logistics" :code "(define (within-delivery? sx sy hx hy km) (near? sx sy hx hy km))\n(list (within-delivery? 0 0 2 2 5) (within-delivery? 0 0 20 20 5))")
       (:domain "topology"  :code "(define (closed-ball? cx cy px py r) (<= (sqrt (+ (* (- px cx) (- px cx)) (* (- py cy) (- py cy)))) r))\n(map (lambda (p) (closed-ball? 0 0 (car p) (cadr p) 5)) (list (list 5 0) (list 4 4)))"))
     :explanation "Rung 1: a game asks whether an enemy is inside the aggro circle. Rung 2: a depot asks whether an address is inside its delivery radius. Rung 3: point-set topology asks whether a point lies in the closed ball of radius r. All three are the same predicate — threshold the distance function and include the boundary."
     :meta "The transfer works because a radius is not a shape, it is a THRESHOLD ON A METRIC. Anything with a distance and a cutoff wears this shape, which is why the same call answers 'did it hit', 'do we deliver', and 'is it in the ball'.")
    (:eng "Every radius rule reduces to one tunable number, which is why designers can balance a game by editing radii alone." :math "The closed ball B̄(c, r) = { p : d(p, c) ≤ r } in the Euclidean metric." :cs "A metric-space range query — the same predicate a spatial index evaluates at its leaves."))
  :row-4-proof (
    (:eng-program "(define (boundary-probe r) (list (near? 0 0 r 0 r) (near? 0 0 (- r 1) 0 r) (near? 0 0 (+ r 1) 0 r)))\n(boundary-probe 10)"
     :math-program "(define (agrees? x1 y1 x2 y2 r) (eq? (near? x1 y1 x2 y2 r) (<= (+ (* (- x2 x1) (- x2 x1)) (* (- y2 y1) (- y2 y1))) (* r r))))\n(list (agrees? 0 0 3 4 5) (agrees? 0 0 3 4 4) (agrees? 1 1 4 5 5))"
     :cs-program "(define (symmetric? x1 y1 x2 y2 r) (eq? (near? x1 y1 x2 y2 r) (near? x2 y2 x1 y1 r)))\n(list (symmetric? 0 0 3 4 5) (symmetric? 7 2 1 9 6))"
     :claim "near? is the closed disc test: it is true at exactly r, false at r plus one, and it does not care which point you name first."
     :invariant "∀ p₁ p₂ r. near?(p₁, p₂, r) ⟺ ‖p₂ − p₁‖ ≤ r ∧ near?(p₁, p₂, r) = near?(p₂, p₁, r)"
     :meta "Pattern: a symmetric closed threshold on a metric. It would be falsified if the boundary case returned #f — that would make it an open ball, and every pickup tuned to exactly r would silently stop firing."))
  :row-5-emergence (
    (:eng-composition "(define (nearest-of px py pts)\n  (fold (lambda (p best) (if (near? px py (car p) (cadr p) (dist px py (car best) (cadr best))) p best))\n        (car pts) (cdr pts)))\n(nearest-of 0 0 (list (list 9 9) (list 2 1) (list 40 3)))"
     :math-composition "(define (ring? cx cy px py inner outer) (and (near? cx cy px py outer) (not (near? cx cy px py inner))))\n(list (ring? 0 0 5 0 3 8) (ring? 0 0 2 0 3 8))"
     :cs-composition "(define (cluster pts r)\n  (map (lambda (p) (length (filter (lambda (q) (near? (car p) (cadr p) (car q) (cadr q) r)) pts))) pts))\n(cluster (list (list 0 0) (list 1 1) (list 50 50)) 5)"
     :base "near? alone answers one proximity question about one pair."
     :emergent "Compositions: eng nearest-neighbour scan, math annulus membership by subtracting an inner disc from an outer one, cs density counting by asking every point how many neighbours share its radius."
     :meta "Family: threshold-on-a-metric. Two radii differenced give a ring; a radius applied pairwise across a set gives density; a shrinking radius gives nearest-neighbour.")
    (:eng "Density counting is how a swarm decides to scatter — the same call, applied N² times." :math "An annulus is the set difference of two closed balls sharing a centre." :cs "The pairwise scan is O(n²); a grid or quadtree replaces it once n grows."))
)

(verb :name "in-rect?" :std "Motoi" :library "collision" :tier "core" :kind "pure" :signature "(in-rect? px py x y w h) -> boolean"
  :summary "True when the point (px,py) lies inside the axis-aligned rectangle at (x,y) of size w×h — left and top edges included, right and bottom excluded."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(in-rect? 5 5 0 0 10 10)" :note "#t — the point sits comfortably inside the ten-by-ten box anchored at the origin.")
    (:dialect "motoi" :tier "intermediate" :code "(list (in-rect? 0 0 0 0 10 10) (in-rect? 9 9 0 0 10 10) (in-rect? 10 10 0 0 10 10))" :note "(#t #t #f) — the top-left corner is inside, the last interior pixel is inside, and the far corner at (10,10) is already outside.")
    (:dialect "motoi" :tier "expert"       :code "(define (hits-in-button clicks bx by bw bh)\n  (length (filter (lambda (c) (in-rect? (car c) (cadr c) bx by bw bh)) clicks)))\n(hits-in-button (list (list 1 1) (list 20 3) (list 8 8)) 0 0 16 16)" :note "2 — two of the three recorded clicks landed on the sixteen-pixel button."))
  :provenance "Motoi core (src/base.js, the game-kit collision block); documented 2026-08-02."
  :status "needs-alfred"
  :caveats ("EXACT RATIONALS ARE SILENTLY WRONG. (in-rect? 1/2 1/2 0 0 10 10) is #f although the point is plainly inside the box; the inexact form (in-rect? 0.5 0.5 0 0 10 10) is #t. src/base.js compares the raw arguments with JavaScript's >= and <, and an exact rational is an object, so every comparison against it is false. Same defect in near?, overlap? and dist." "The span is HALF-OPEN: the left and top edges are inside, the right and bottom edges are outside. (in-rect? 10 10 0 0 10 10) is #f." "A zero or negative width or height makes the box hold nothing; the verb returns #f rather than erroring." "It tests a POINT, not a box — for box-versus-box reach for overlap?.")
  :row-2-audit (
    (:eng-program "(define (on-button? mx my) (in-rect? mx my 100 60 48 16))\n(list (on-button? 110 65) (on-button? 149 65))"
     :math-program "(define (half-open? px py x y w h) (and (>= px x) (< px (+ x w)) (>= py y) (< py (+ y h))))\n(list (in-rect? 10 10 0 0 10 10) (half-open? 10 10 0 0 10 10))"
     :cs-program "(define (checked-in-rect? px py x y w h) (if (or (< w 0) (< h 0)) (error 'negative-extent) (in-rect? px py x y w h)))\n(checked-in-rect? 3 3 0 0 8 8)"
     :problem "A UI is laid out as a strip of buttons packed edge to edge. With an inclusive right edge a click on the seam registers on BOTH buttons, so the handler fires twice and the second one wins at random."
     :explanation "eng: name the hit box once so the layout and the test cannot drift apart. math: restate the rule as the half-open product [x, x+w) × [y, y+h) and check the engine agrees. cs: reject a negative extent, which would otherwise make the predicate vacuously false."
     :meta "overlap? compares two rectangles and would force you to invent a 1×1 box around the point; near? would round the button into a circle and miss its corners; a hand-rolled chain of four comparisons is exactly what keeps getting the edge convention wrong. in-rect? is the point-in-box test with the half-open convention already decided, so adjacent boxes tile without overlapping.")
    (:eng "The audit lens is 'can one click land on two boxes?' — tile two boxes edge to edge and probe the seam; a doubled hit means someone used an inclusive right edge." :math "It is membership in the half-open product [x, x+w) × [y, y+h), which tiles the plane without overlap." :cs "Four comparisons, no allocation; the leaf test of any axis-aligned spatial partition."))
  :row-3-dimension (
    (:setup "An anchor, an extent, and a question about whether one sample falls in the half-open span."
     :rungs (
       (:domain "ui"        :code "(in-rect? 5 5 0 0 10 10)")
       (:domain "scheduling" :code "(define (during? t start dur) (and (>= t start) (< t (+ start dur))))\n(list (during? 9 9 60) (during? 69 9 60))")
       (:domain "indexing"  :code "(define (bucket-of v lo width) (if (and (>= v lo) (< v (+ lo width))) 'in 'out))\n(map (lambda (v) (bucket-of v 0 10)) (list 0 9 10))"))
     :explanation "Rung 1: a pixel is tested against a screen rectangle. Rung 2: a timestamp is tested against a meeting that starts at 9 and runs 60 minutes — the minute the meeting ends belongs to the next slot. Rung 3: a histogram bucket claims values from lo up to but not including lo+width. All three use the half-open interval so neighbours tile without double-counting."
     :meta "The transfer works because in-rect? is a PRODUCT OF TWO HALF-OPEN INTERVALS. Any substrate that must partition a line — time slots, histogram bins, memory pages — reaches for the same convention, and for the same reason: closed-closed double counts the seam, open-open loses it.")
    (:eng "Half-open is the convention that makes adjacent cells tile exactly; the seam belongs to exactly one owner." :math "[a, b) × [c, d) — the product of half-open intervals, the standard cell of a partition." :cs "The same rule behind array slicing, page tables, and bucket indices."))
  :row-4-proof (
    (:eng-program "(define (seam-probe) (list (in-rect? 10 5 0 0 10 10) (in-rect? 10 5 10 0 10 10)))\n(seam-probe)"
     :math-program "(define (matches? px py x y w h) (eq? (in-rect? px py x y w h) (and (>= px x) (< px (+ x w)) (>= py y) (< py (+ y h)))))\n(list (matches? 0 0 0 0 4 4) (matches? 4 0 0 0 4 4) (matches? 2 3 0 0 4 4))"
     :cs-program "(define (empty-never-hits? px py) (or (in-rect? px py 0 0 0 0) 'empty-rect-holds-nothing))\n(empty-never-hits? 0 0)"
     :claim "Exactly one of two edge-to-edge rectangles claims a point on their shared seam, because the span is closed on the left and open on the right."
     :invariant "∀ p x y w h. in-rect?(p, x, y, w, h) ⟺ x ≤ pₓ < x+w ∧ y ≤ p_y < y+h"
     :meta "Pattern: half-open partition. It would be falsified if the seam probe returned two #t values — that is the double-fire bug, and it is invisible until two boxes touch."))
  :row-5-emergence (
    (:eng-composition "(define (route-click cx cy boxes)\n  (let loop ((bs boxes) (i 0))\n    (cond ((null? bs) 'miss)\n          ((in-rect? cx cy (car (car bs)) (cadr (car bs)) (caddr (car bs)) (cadddr (car bs))) i)\n          (else (loop (cdr bs) (+ i 1))))))\n(route-click 12 4 (list (list 0 0 10 10) (list 10 0 10 10)))"
     :math-composition "(define (cell-of px py cw ch)\n  (list (quotient px cw) (quotient py ch)))\n(list (cell-of 12 4 10 10) (in-rect? 12 4 10 0 10 10))"
     :cs-composition "(define (cull sprites vx vy vw vh)\n  (filter (lambda (s) (in-rect? (car s) (cadr s) vx vy vw vh)) sprites))\n(length (cull (list (list 2 2) (list 300 4) (list 5 5)) 0 0 64 64))"
     :base "in-rect? alone answers one point-in-one-box question."
     :emergent "Compositions: eng hit-routing that returns which box owns a click, math grid-cell lookup that agrees with the box test because both use half-open spans, cs viewport culling that keeps only what the camera can see."
     :meta "Family: half-open partitioning. Hit routing, grid indexing and culling are the same predicate applied once, tiled, or filtered.")
    (:eng "Culling is where this earns its keep — one cheap test per sprite removes most of the draw work." :math "Integer division by the cell size is the closed form of the same half-open membership." :cs "The predicate is the leaf of a broad-phase; the loop above it is what you replace when n grows."))
)

(verb :name "overlap?" :std "Motoi" :library "collision" :tier "core" :kind "pure" :signature "(overlap? x1 y1 w1 h1 x2 y2 w2 h2) -> boolean"
  :summary "True when two axis-aligned boxes share interior area — the AABB test. Boxes that merely touch along an edge do not overlap."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(overlap? 0 0 10 10 5 5 10 10)" :note "#t — the two ten-by-ten boxes share a five-by-five corner region.")
    (:dialect "motoi" :tier "intermediate" :code "(list (overlap? 0 0 10 10 10 0 10 10) (overlap? 0 0 10 10 9 0 10 10))" :note "(#f #t) — boxes flush at x=10 only touch, while a one-pixel push to x=9 makes them genuinely intersect.")
    (:dialect "motoi" :tier "expert"       :code "(define (any-hit? me others)\n  (let loop ((o others))\n    (cond ((null? o) #f)\n          ((overlap? (car me) (cadr me) (caddr me) (cadddr me)\n                     (car (car o)) (cadr (car o)) (caddr (car o)) (cadddr (car o))) #t)\n          (else (loop (cdr o))))))\n(any-hit? (list 0 0 8 8) (list (list 40 40 8 8) (list 4 4 8 8)))" :note "#t — the second box in the list clips the player's eight-by-eight body."))
  :provenance "Motoi core (src/base.js, the game-kit collision block); documented 2026-08-02."
  :status "needs-alfred"
  :caveats ("EXACT RATIONALS ARE SILENTLY WRONG. (overlap? 0 0 10 10 1/2 1/2 10 10) is #f although the boxes plainly intersect; the inexact form with 0.5 is #t. src/base.js compares the raw arguments with JavaScript's <, and an exact rational is an object, so every comparison against it is false. Same defect in near?, in-rect? and dist." "TOUCHING IS NOT OVERLAPPING. Two boxes flush at a shared edge answer #f — (overlap? 0 0 10 10 10 0 10 10) is #f. That is what lets tiles sit side by side without fighting." "Boxes are given as x y w h, NOT as x1 y1 x2 y2; passing far corners instead of extents produces plausible-looking wrong answers." "A zero-area box never overlaps anything, and the verb reports that silently rather than erroring." "Axis-aligned only: a rotated sprite must be tested by its bounding box, which will over-report.")
  :row-2-audit (
    (:eng-program "(define (bullet-hits? bx by ex ey) (overlap? bx by 2 2 ex ey 12 12))\n(list (bullet-hits? 10 10 4 4) (bullet-hits? 100 10 4 4))"
     :math-program "(define (span-overlap? a aw b bw) (and (< a (+ b bw)) (< b (+ a aw))))\n(list (overlap? 0 0 10 10 5 5 10 10) (and (span-overlap? 0 10 5 10) (span-overlap? 0 10 5 10)))"
     :cs-program "(define (guarded-overlap? x1 y1 w1 h1 x2 y2 w2 h2)\n  (if (or (<= w1 0) (<= h1 0) (<= w2 0) (<= h2 0)) #f (overlap? x1 y1 w1 h1 x2 y2 w2 h2)))\n(list (guarded-overlap? 0 0 0 0 0 0 10 10) (guarded-overlap? 0 0 4 4 2 2 4 4))"
     :problem "A platformer resolves the player against tiles laid edge to edge. With an inclusive edge test the player standing exactly on a tile boundary registers a collision with the tile beside them and gets shoved sideways every frame."
     :explanation "eng: give the bullet and the enemy their real extents so the test reads as one intent. math: show the 2D test is the conjunction of two independent 1D span tests. cs: reject degenerate zero-area boxes before testing, since a zero-width box can never overlap anything."
     :meta "near? would model both actors as circles and let square crates clip through each other at the flats; in-rect? tests a point, so you would have to test four corners and still miss the case where a thin box crosses a wide one without any corner inside. overlap? is the interior-intersection test for two extents, and its strict inequalities are precisely what let tiles sit flush without fighting.")
    (:eng "The audit lens is 'do flush neighbours fight?' — place two boxes edge to edge and expect #f; a #t there is the jitter bug." :math "Separating-axis theorem specialised to two axes: two AABBs intersect iff their projections onto x and onto y both intersect." :cs "Four comparisons, branch-friendly, no square roots — the standard broad-phase."))
  :row-3-dimension (
    (:setup "Two extents on the same line, and the question of whether they share any interior."
     :rungs (
       (:domain "game"     :code "(overlap? 0 0 10 10 5 5 10 10)")
       (:domain "calendar" :code "(define (clash? s1 d1 s2 d2) (and (< s1 (+ s2 d2)) (< s2 (+ s1 d1))))\n(list (clash? 9 60 10 30) (clash? 9 60 10 30))"                                                          )
       (:domain "intervals" :code "(define (meets? a b c d) (and (< a d) (< c b)))\n(map (lambda (q) (meets? (car q) (cadr q) (caddr q) (cadddr q))) (list (list 0 10 5 15) (list 0 10 10 20)))"))
     :explanation "Rung 1: two sprite boxes are tested for a hit. Rung 2: two meetings are tested for a clash — one ending exactly when the other begins is not a clash. Rung 3: two half-open intervals are tested for a non-empty intersection. All three are the same pair of strict inequalities, once per dimension."
     :meta "The transfer works because an AABB is a PRODUCT OF INTERVALS, and interval intersection is the whole content of the test. Adding a dimension adds a conjunct; nothing else changes, which is why the calendar case is literally the one-dimensional version of the game case.")
    (:eng "Flush-but-not-overlapping is the property that lets you tile a world without self-collision." :math "Interval intersection is non-empty iff a < d and c < b; the AABB case is that statement per axis." :cs "Conjunction over axes — the same reduction generalises to 3D and to n-dimensional bounding volumes."))
  :row-4-proof (
    (:eng-program "(define (flush-probe) (list (overlap? 0 0 10 10 10 0 10 10) (overlap? 0 0 10 10 9 0 10 10)))\n(flush-probe)"
     :math-program "(define (axes-agree? x1 y1 w1 h1 x2 y2 w2 h2)\n  (eq? (overlap? x1 y1 w1 h1 x2 y2 w2 h2)\n       (and (< x1 (+ x2 w2)) (< x2 (+ x1 w1)) (< y1 (+ y2 h2)) (< y2 (+ y1 h1)))))\n(list (axes-agree? 0 0 10 10 5 5 10 10) (axes-agree? 0 0 10 10 20 20 5 5) (axes-agree? 0 0 10 10 10 0 10 10))"
     :cs-program "(define (commutes? x1 y1 w1 h1 x2 y2 w2 h2)\n  (eq? (overlap? x1 y1 w1 h1 x2 y2 w2 h2) (overlap? x2 y2 w2 h2 x1 y1 w1 h1)))\n(list (commutes? 0 0 10 10 5 5 10 10) (commutes? 0 0 4 4 40 40 4 4))"
     :claim "Two boxes that share only an edge do not overlap, and the answer never depends on which box you name first."
     :invariant "∀ A B. overlap?(A, B) ⟺ (Aₓ < Bₓ+B_w ∧ Bₓ < Aₓ+A_w ∧ A_y < B_y+B_h ∧ B_y < A_y+A_h) ∧ overlap?(A, B) = overlap?(B, A)"
     :meta "Pattern: per-axis interval intersection with strict inequalities. It would be falsified if the flush probe returned #t — that is the tile-jitter bug, and it only shows up once a level is packed tightly."))
  :row-5-emergence (
    (:eng-composition "(define (broadphase actors)\n  (length (filter (lambda (pair)\n                    (let ((a (car pair)) (b (cadr pair)))\n                      (overlap? (car a) (cadr a) (caddr a) (cadddr a)\n                                (car b) (cadr b) (caddr b) (cadddr b))))\n                  (list (list (list 0 0 8 8) (list 4 4 8 8))\n                        (list (list 0 0 8 8) (list 90 90 8 8))))))\n(broadphase 'ignored)"
     :math-composition "(define (overlap-area x1 y1 w1 h1 x2 y2 w2 h2)\n  (if (overlap? x1 y1 w1 h1 x2 y2 w2 h2)\n      (* (- (min (+ x1 w1) (+ x2 w2)) (max x1 x2))\n         (- (min (+ y1 h1) (+ y2 h2)) (max y1 y2)))\n      0))\n(list (overlap-area 0 0 10 10 5 5 10 10) (overlap-area 0 0 10 10 40 40 10 10))"
     :cs-composition "(define (quadrant-cull boxes vx vy vw vh)\n  (filter (lambda (b) (overlap? (car b) (cadr b) (caddr b) (cadddr b) vx vy vw vh)) boxes))\n(length (quadrant-cull (list (list 0 0 8 8) (list 500 500 8 8) (list 20 20 8 8)) 0 0 64 64))"
     :base "overlap? alone answers one box-versus-box question."
     :emergent "Compositions: eng a broad-phase pair count, math the intersection AREA computed only when the cheap test says there is one, cs viewport culling of whole boxes rather than points."
     :meta "Family: interval intersection. The boolean is the gate; the area, the penetration depth and the separation vector are all read off the same four clamped edges once the gate opens.")
    (:eng "Run the boolean first and the area second — the cheap test rejects almost every pair." :math "The intersection rectangle is [max(x₁,x₂), min(x₁+w₁, x₂+w₂)) × the same in y; its area is zero exactly when the boolean is false." :cs "Broad-phase then narrow-phase is the standard two-stage collision pipeline."))
)

(verb :name "layer-bit-index" :std "Motoi" :library "collision" :tier "core" :kind "pure" :signature "(layer-bit-index layer) -> integer"
  :status "needs-alfred"
  :summary "Look up the bit index a collision layer name was assigned. IN THE SHIPPING ENGINE IT ALWAYS RETURNS -1, because the registrar that fills its table is shadowed at install time."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(layer-bit-index 'player)" :note "-1 — the not-registered answer, and today the only answer this verb gives.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (collision/define-layers! (list 'player 'enemy 'wall)) (layer-bit-index 'player))" :note "-1 — registering the layers first does NOT change the result; a correct implementation would answer 0 here.")
    (:dialect "motoi" :tier "expert"       :code "(begin (collision/define-layers! (list 'player 'enemy 'wall)) (map layer-bit-index (list 'player 'enemy 'wall 'ghost)))" :note "(-1 -1 -1 -1) — every name, registered or not, reads back as unregistered."))
  :provenance "Motoi (lib/system/domain-verbs.js). Documented 2026-08-02 with the divergence recorded rather than the intent."
  :caveats ("BROKEN AS SHIPPED. lib/system/domain-verbs.js defines both collision/define-layers! (which fills the name→index map) and layer-bit-index (which reads it). core/index.js installs domain-verbs at line 358 and then installs lib/game/world.js at line 432; world.js re-defines collision/define-layers! to store the list on the world object and return undefined, so the map domain-verbs reads is never written. layer-bit-index therefore returns its miss value, -1, for every input." "The miss value -1 is an integer, so any test of the shape (integer? (layer-bit-index x)) passes whether or not the lookup worked. That is exactly how this stayed invisible." "Which collision/define-layers! you get is decided by install ORDER, not by a namespace — a second definition of a name silently wins."
  )
  :row-2-audit (
    (:eng-program "(begin (collision/define-layers! (list 'player 'enemy)) (list 'player (layer-bit-index 'player) 'enemy (layer-bit-index 'enemy)))"
     :math-program "(begin (collision/define-layers! (list 'a 'b 'c)) (list 'expected (list 0 1 2) 'actual (map layer-bit-index (list 'a 'b 'c))))"
     :cs-program "(define (registered? layer) (>= (layer-bit-index layer) 0))\n(begin (collision/define-layers! (list 'player)) (registered? 'player))"
     :problem "An engineer wires collision masks from layer names and wants to turn 'enemy into the bit that masks it. Every lookup comes back -1, so every mask becomes the same sentinel and nothing collides selectively — and because -1 is a perfectly good integer, the obvious sanity check does not catch it."
     :explanation "eng: ask for two named layers and see both miss. math: state the index sequence the registrar promises and print it beside what actually comes back. cs: the honest predicate is (>= idx 0), not (integer? idx) — it is the one that reports the failure."
     :meta "collision/define-layers! is the only sibling here, and it is the sibling that broke this verb: two modules define that name and the later install wins. There is no alternative verb to reach for — until the shadowing is resolved, a program that needs stable layer bits must keep its own alist and index into it by hand.")
    (:eng "The audit lens is 'does a registered name read back as a non-negative index?' — the check must be (>= idx 0); (integer? idx) is a proxy and it passes on the broken build." :math "A registrar should be an injection names → {0,…,n−1}; today the map is constant −1, which is not an injection." :cs "A late binding of the same symbol silently replaced an earlier one; the reader of the shared table was left pointing at an empty map."))
  :row-3-dimension (
    (:setup "A name is handed to a registry and should come back as a stable small integer."
     :rungs (
       (:domain "collision" :code "(begin (collision/define-layers! (list 'player 'enemy)) (layer-bit-index 'player))")
       (:domain "interning" :code "(define (intern names) (map (lambda (p) (cons (car p) (cdr p))) (map cons names (iota (length names)))))\n(cdr (assq 'enemy (intern (list 'player 'enemy 'wall))))")
       (:domain "encoding"  :code "(define (bit-of i) (expt 2 i))\n(map bit-of (list 0 1 2))"))
     :explanation "Rung 1: the shipping verb answers -1 for a name it should have interned. Rung 2: a three-line hand-rolled interner does the job correctly — names paired with their positions, looked up by assq. Rung 3: an index becomes a mask by raising two to it. The shape is one map from labels to positions; only the first rung is broken."
     :meta "The transfer works because interning is a UNIVERSAL move — symbols to slots, layers to bits, words to vocabulary ids. The rung-2 replacement is the workaround: an alist you own cannot be shadowed by install order.")
    (:eng "When a registry verb is unreliable, own the table — an alist in your own module cannot be re-defined out from under you." :math "Interning is a bijection between a finite label set and an initial segment of the naturals." :cs "Name shadowing at install time is a load-order hazard; a namespace or an explicit re-definition guard would have caught it."))
  :row-4-proof (
    (:eng-program "(begin (collision/define-layers! (list 'a 'b 'c)) (map layer-bit-index (list 'a 'b 'c 'zzz)))"
     :math-program "(begin (collision/define-layers! (list 'a 'b)) (list 'distinct-indices? (not (equal? (layer-bit-index 'a) (layer-bit-index 'b)))))"
     :cs-program "(define (proxy-passes? layer) (integer? (layer-bit-index layer)))\n(define (real-check-passes? layer) (>= (layer-bit-index layer) 0))\n(begin (collision/define-layers! (list 'player)) (list 'proxy (proxy-passes? 'player) 'real (real-check-passes? 'player)))"
     :claim "Every layer name — registered or not — reads back as -1, so the registered and unregistered cases are indistinguishable and no two layers get distinct bits."
     :invariant "∀ name. layer-bit-index(name) = −1 (observed on this build; the intended invariant is layer-bit-index(nameᵢ) = i for a registered list)"
     :meta "Pattern: a proxy check that cannot fail. The cs program prints the proxy answering #t next to the real check answering #f on the same input; that pair is the whole bug report."))
  :row-5-emergence (
    (:eng-composition "(define (layer-table names) (map cons names (iota (length names))))\n(define T (layer-table (list 'player 'enemy 'wall)))\n(list 'own-table (cdr (assq 'enemy T)) 'engine-verb (layer-bit-index 'enemy))"
     :math-composition "(define (mask-of idx) (if (< idx 0) 0 (expt 2 idx)))\n(map mask-of (list 0 1 2 (layer-bit-index 'player)))"
     :cs-composition "(define (index-or names name) (let ((hit (assq name (map cons names (iota (length names)))))) (if hit (cdr hit) -1)))\n(list (index-or (list 'player 'enemy) 'enemy) (index-or (list 'player 'enemy) 'ghost))"
     :base "layer-bit-index alone answers -1 for every name it is given."
     :emergent "Compositions: eng a hand-rolled table printed beside the engine verb so the divergence is visible in one line, math a mask builder that must special-case the -1 sentinel, cs a drop-in replacement lookup that returns the index the engine verb was meant to return."
     :meta "Family: name interning. The composition that matters here is the WORKAROUND — index-or is four lines, is not shadowable, and gives the semantics the engine verb advertises.")
    (:eng "Until the shadowing is fixed, ship the four-line replacement and keep the engine verb out of the mask path." :math "Masking by 2ⁱ needs a non-negative i; the sentinel must be filtered, not raised." :cs "A local pure lookup beats a global mutable registry that any later module can re-define."))
)
