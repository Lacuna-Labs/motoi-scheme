      (:code "(define (rational-add p q) (let* ((num (+ (* (car p) (cadr q)) (* (car q) (cadr p)))) (den (* (cadr p) (cadr q))) (d (gcd (abs num) den))) (list (/ num d) (/ den d))))\n(rational-add '(1 4) '(1 6))" :tags (eng composition))
      (:code "(define (fold-gcd xs) (let loop ((xs xs) (acc 0)) (if (null? xs) acc (loop (cdr xs) (gcd acc (car xs))))))\n(fold-gcd '(24 36 60))" :tags (math composition))
      (:code "(define (canonical-scale ratios) (let ((g (let loop ((rs ratios) (acc 0)) (if (null? rs) acc (loop (cdr rs) (gcd acc (car rs))))))) (map (lambda (r) (/ r g)) ratios)))\n(canonical-scale '(10 15 25))" :tags (cs composition))))
    (:base "Chain gcd for a common-divisor across a list." :programs (
