(verb
  :name "math/cube" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/cube x) -> number"
  :arity "1"
  :contract "any real → real"
  :summary "x cubed. Equivalent to (* x x x)."
  :doc "Small helper for readability. Preserves sign of x."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/cube 3)" :note "Returns 27.")
    (:dialect "motoi" :tier "intermediate" :code "(math/cube -2)" :note "Odd power preserves sign. Returns -8.")
    (:dialect "motoi" :tier "expert" :code "(define (sphere-volume r) (* (/ 4 3) math/pi (math/cube r)))\n(sphere-volume 2)" :note "Volume of a unit-radius-2 sphere. About 33.51.")
  )
  :related ("math/square" "math/cbrt" "math/pow")
  :row-2-audit (
    (:problem "A volume-of-a-cube helper needs side³." :programs (
      (:code "(math/cube 3)" :tags (program))
      (:code "(define (box-volume side) (math/cube side))\n(box-volume 4)" :tags (eng program))
      (:code "(define (cube-vs-manual x) (= (math/cube x) (* x x x)))\n(and (cube-vs-manual 3) (cube-vs-manual -2))" :tags (math program))
      (:code "(define (safe-cube x) (if (number? x) (math/cube x) (error 'not-a-number)))\n(safe-cube 5)" :tags (cs program)))
     :explanation "Return x·x·x. Eng: cubic box volume from side length. Math: math/cube agrees with the explicit product. CS: type-guarded wrapper."
     :meta "math/cube is the correct verb. Explicit intent, composable via map. math/pow with a literal 3 also works but hides the intent.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: monomial x³."
     :rungs (
       (:domain "math/*" :code "(math/cube 3)")
       (:domain "volume of a cube (a metaphor domain — side³)" :code "(define (cube-vol s) (list s))")
       (:domain "math — x³" :code "(define (cb x) (* x x x))")
     )
     :explanation "Each rung produces x³ from x."
     :meta "The shape transfers because cubing is a universal polynomial atom.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "cube is odd: cube(-x) = -cube(x)." :programs (
      (:code "(= (math/cube -3) (- (math/cube 3)))" :tags (program))
      (:code "(define (sign-preserved?) (and (< (math/cube -2) 0) (> (math/cube 2) 0)))\n(sign-preserved?)" :tags (eng program))
      (:code "(define (odd-symmetry? x) (= (math/cube (- x)) (- (math/cube x))))\n(and (odd-symmetry? 3) (odd-symmetry? -4) (odd-symmetry? 0))" :tags (math program))
      (:code "(define (cube-monotone? a b) (if (< a b) (< (math/cube a) (math/cube b)) #t))\n(and (cube-monotone? -2 3) (cube-monotone? 1 5))" :tags (cs program)))
     :invariant "∀ x. cube(-x) = -cube(x)" :meta "Odd-function symmetry, and strict monotonicity over ℝ. If broken, the impl loses the sign. See book-of-math ch 9.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain cube with math/pi for sphere volume." :programs (
      (:code "(define (sphere-v r) (* (/ 4 3) math/pi (math/cube r)))
(sphere-v 2)" :tags (composition))
      (:code "(define (rank-by-volume sides) (map (lambda (s) (list s (math/cube s))) (sort sides <)))\n(rank-by-volume (list 3 1 2))" :tags (eng composition))
      (:code "(define (sum-of-cubes n) (let loop ((i 1) (acc 0)) (if (> i n) acc (loop (+ i 1) (+ acc (math/cube i))))))\n(= (sum-of-cubes 3) 36)" :tags (math composition))
      (:code "(define (cube-cache) (let ((seen '())) (lambda (x) (let ((entry (assv x seen))) (if entry (cdr entry) (let ((v (math/cube x))) (set! seen (cons (cons x v) seen)) v))))))\n(let ((c (cube-cache))) (list (c 3) (c 3) (c 4)))" :tags (cs composition)))
     :emergent "geometric-formula. Eng: rank boxes by cubic volume. Math: sum of first-n cubes (= (n(n+1)/2)²). CS: memoized cube evaluator." :meta "Belongs to the family of formula-composition patterns. See book-of-composition ch 10.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "exact" :std "R7RS-small"           :library "math" :tier "core" :kind "pure" :signature "(exact x) -> integer"
  :summary "Convert to exact (integer). R7RS §6.2."
  :provenance "R7RS §6.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(exact 3.5)" :note "7/2 — the exact rational.")
    (:dialect "motoi" :tier "intermediate" :code "(exact 1.5)" :note "3/2.")
    (:dialect "motoi" :tier "expert" :code "(define (money-add . amounts) (apply + (map exact amounts)))\n(money-add 0.10 0.20 0.05)" :note "Sum currency amounts exactly, avoiding 0.1+0.2 float drift.")
  )
  :row-2-audit (
    (:problem "A rational computation needs to convert 3.5 back to 7/2."
     :programs (
       (:code "(exact 3.5)" :tags (program))
       (:code "(define (exact-percent-of x pct) (exact (* x (/ pct 100))))\n(exact-percent-of 200 15)" :tags (eng program))
       (:code "(define (float-rational-fidelity x) (equal? (exact x) (exact (inexact (exact x)))))\n(float-rational-fidelity 0.25)" :tags (math program))
       (:code "(define (safe-exact x) (if (number? x) (exact x) (error 'not-a-number)))\n(safe-exact 3.5)" :tags (cs program)))
     :explanation "Convert to exact form. Eng: exact percentage-of-a-price. Math: round-trip fidelity witness. CS: type-guarded conversion."
     :meta "exact is the correct verb because it names the conversion. inexact->exact is an alias.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: representation conversion."
     :rungs (
       (:domain "math/*" :code "(exact 3.5)")
       (:domain "digital-analog (a metaphor domain — quantize analog to digital)" :code "(define (digitize a) (round (* a 256)))")
       (:domain "math — embedding of ℝ into ℚ (up to precision)" :code "(define (rat-of x) (exact x))"))
     :explanation "Each rung converts a representation to a more precise one."
     :meta "The shape transfers because 'exact' and 'inexact' are two sides of the number tower.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "exact ∘ inexact is identity on exacts."
     :programs (
       (:code "(equal? 7 (exact (inexact 7)))" :tags (program))
       (:code "(define (integer-preserved?) (and (equal? (exact 3.0) 3) (equal? (exact -5.0) -5)))\n(integer-preserved?)" :tags (eng program))
       (:code "(define (exact-integer-idempotent? n) (equal? (exact (exact n)) (exact n)))\n(and (exact-integer-idempotent? 3.5) (exact-integer-idempotent? -2.25))" :tags (math program))
       (:code "(define (yields-exact-type? x) (exact? (exact x)))\n(and (yields-exact-type? 3.5) (yields-exact-type? 0.1))" :tags (cs program)))
     :invariant "∀ n ∈ ℤ. exact(inexact(n)) = n"
     :meta "Round-trip on integers. If broken, precision loss. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain exact with arithmetic for precise fractions."
     :programs (
       (:code "(+ (exact 3.5) (exact 2.5))" :tags (composition))
       (:code "(define (settle-invoice line-items) (let loop ((xs line-items) (total 0)) (if (null? xs) total (loop (cdr xs) (+ total (exact (car xs)))))))\n(settle-invoice (list 0.10 0.20 0.35))" :tags (eng composition))
       (:code "(define (mean-exact xs) (/ (apply + (map exact xs)) (length xs)))\n(mean-exact (list 1.5 2.5 3.5))" :tags (math composition))
       (:code "(define (bounded-precision xs cap) (map (lambda (x) (let* ((r (exact x)) (d (denominator r))) (if (> d cap) (/ (round (* x cap)) cap) r))) xs))\n(bounded-precision (list 0.333333 0.5 0.6666) 100)" :tags (cs composition)))
     :emergent "convert-then-compute. Eng: exact invoice settlement. Math: mean over exact reals. CS: precision-cap admission control."
     :meta "Belongs to the family of precision-preservation patterns. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "inexact" :std "R7RS-small"         :library "math" :tier "core" :kind "pure" :signature "(inexact x) -> number"
  :summary "Convert to inexact (float). R7RS §6.2."
  :provenance "R7RS §6.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(inexact 1)" :note "1.0 — floating-point 1.")
    (:dialect "motoi" :tier "intermediate" :code "(inexact 3/2)" :note "1.5.")
  )
  :row-2-audit (
   
    (:problem "A display layer converts 3/2 to 1.5 for the UI."
     :programs (
       (:code "(inexact 3/2)" :tags (program))
       (:code "(define (percentages-as-floats fractions) (map inexact fractions))\n(percentages-as-floats (list 1/4 1/3 3/8 5/16))" :tags (eng program))
       (:code "(define (float-conservation-check q)\n  (let ((f (inexact q)))\n    (< (abs (- f q)) 1e-12)))\n(and (float-conservation-check 1/2)\n     (float-conservation-check 3/4)\n     (float-conservation-check 7/8))" :tags (math program))
       (:code "(define (safe-inexact x)\n  (cond ((and (number? x) (exact? x)) (inexact x))\n        ((and (number? x) (not (exact? x))) x)\n        (else (error 'not-a-number))))\n(list (safe-inexact 3/2) (safe-inexact 2.5))" :tags (cs program)))
     :explanation "Convert to float. Eng: batch-convert rational percentages to floats. Math: dyadic rationals (denominators = 2^k) convert exactly. CS: type-guarded wrapper that also passes through already-inexact numbers."
     :meta "inexact is the correct verb. exact->inexact is an alias.")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape as exact but the reverse direction."
     :rungs (
       (:domain "math/*" :code "(inexact 3/2)")
       (:domain "resampling (a metaphor domain — analog approximation from a digital exact)" :code "(define (analog e) (list e))")
       (:domain "math — embedding of ℚ into a float representation" :code "(define (float-of x) (list x))")
     )
     :explanation "Each rung converts an exact value to an inexact one."
     :meta "The shape transfers because representations map both ways.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "inexact ∘ exact ≈ identity for representable inputs."
     :programs (
       (:code "(< (abs (- (inexact (exact 3.5)) 3.5)) 1e-15)" :tags (program))
       (:code "(define (idempotent-on-floats? x) (equal? (inexact x) (inexact (inexact x))))\n(and (idempotent-on-floats? 3.14)\n     (idempotent-on-floats? -2.71))" :tags (eng program))
       (:code "(define (integer-to-float-exact? n) (= (inexact n) n))\n(and (integer-to-float-exact? 0)\n     (integer-to-float-exact? 1)\n     (integer-to-float-exact? (- (expt 2 40))))" :tags (math program))
       (:code "(define (loss-on-thirds)\n  (let ((third (/ 1 3)))\n    (> (abs (- (inexact third) third)) 0)))\n(loss-on-thirds)" :tags (cs program)))
     :invariant "∀ representable x. |inexact(exact(x)) − x| < ε"
     :meta "Round-trip up to float precision. See book-of-math ch 10.")
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain inexact with a UI formatter."
     :programs (
       (:code "(define (show-frac n d) (number->string (inexact (/ n d))))\n(show-frac 3 2)" :tags (composition))
       (:code "(define (mean-as-float xs)\n  (inexact (/ (apply + xs) (length xs))))\n(mean-as-float (list 1 2 3 4 5))" :tags (eng composition))
       (:code "(define (leibniz-pi-inexact terms)\n  (inexact (* 4 (let loop ((k 0) (acc 0))\n                  (if (>= k terms) acc\n                      (loop (+ k 1) (+ acc (/ (expt -1 k) (+ (* 2 k) 1)))))))))\n(leibniz-pi-inexact 100)" :tags (math composition))
       (:code "(define (batch-normalize amounts)\n  (let ((total (apply + amounts)))\n    (map (lambda (a) (inexact (/ a total))) amounts)))\n(batch-normalize (list 30 20 50))" :tags (cs composition)))
     :emergent "convert-then-format. Eng: mean-as-float from exact fraction. Math: Leibniz series kept exact then displayed as float at boundary. CS: batch-normalize probabilities as floats."
     :meta "Belongs to the family of presentation-conversion patterns. See book-of-composition ch 15.")
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb :name "exact->inexact" :std "R7RS-small"  :library "math" :tier "core" :kind "pure" :signature "(exact->inexact x) -> number"
  :summary "Alias for inexact. R7RS §6.2."
  :provenance "R7RS §6.2; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(exact->inexact 1/2)" :note "0.5.")
    (:dialect "motoi" :tier "intermediate" :code "(exact->inexact 22/7)" :note "3.142857142857143 — an approximation of pi.")
    (:dialect "motoi" :tier "expert" :code "(define (approx-pi terms) (exact->inexact (let loop ((k 0) (acc 0)) (if (>= k terms) acc (loop (+ k 1) (+ acc (/ (expt -1 k) (+ (* 2 k) 1))))))))\n(* 4 (approx-pi 1000))" :note "Leibniz series for pi kept exact, then displayed as inexact only at the boundary.")
  )
  :row-2-audit (
    (:problem "Same problem as inexact — convert an exact rational to a float for the UI."
     :programs (
       (:code "(exact->inexact 22/7)" :tags (program))
       (:code "(define (percent-string q) (list 'pct (exact->inexact (* q 100))))\n(percent-string 3/8)" :tags (eng program))
       (:code "(define (float-diff-from-exact q) (- (exact->inexact q) q))\n(< (abs (float-diff-from-exact 1/3)) 1e-15)" :tags (math program))
       (:code "(define (safe-e->i x) (if (rational? x) (exact->inexact x) (error 'not-rational)))\n(safe-e->i 22/7)" :tags (cs program)))
     :explanation "Convert to float; result approximates the rational. Eng: percent-formatter. Math: quantization-error probe. CS: type-guarded conversion."
     :meta "exact->inexact is the correct verb because it's the R7RS name. inexact is the alias.")
