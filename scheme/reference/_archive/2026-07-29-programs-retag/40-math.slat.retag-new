      (:code "(< (abs (- (math/log2 1024) 10)) 1e-9)" :tags (eng program))
      (:code "(define (log2-of-power? n)\n  (< (abs (- (math/log2 (math/pow 2 n)) n)) 1e-9))\n(and (log2-of-power? 3) (log2-of-power? 7) (log2-of-power? 0))" :tags (math program))
      (:code "(define (log2-doubling? x)\n  (< (abs (- (math/log2 (* 2 x)) (+ 1 (math/log2 x)))) 1e-9))\n(log2-doubling? 16)" :tags (cs program)))
