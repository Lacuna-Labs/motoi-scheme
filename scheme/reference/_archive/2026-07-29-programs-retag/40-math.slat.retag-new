       (:code "(define (format-progress done total) (let ((pct (exact->inexact (* 100 (/ done total))))) (list 'pct pct 'label (list done '/ total))))\n(format-progress 3 8)" :tags (eng composition))
       (:code "(define (series-partial-sums coeffs) (let loop ((cs coeffs) (acc 0) (out '())) (if (null? cs) (reverse out) (let ((s (+ acc (car cs)))) (loop (cdr cs) s (cons (exact->inexact s) out))))))\n(series-partial-sums (list 1 1/2 1/4 1/8 1/16))" :tags (math composition))
