(verb
  :name "math/lcm" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/lcm a b ...) -> integer"
  :arity "variadic (>=1)"
  :contract "all-integers → nonnegative integer; 0 args → 1"
  :summary "Least common multiple of the inputs."
  :doc "Computed as |a*b|/gcd(a,b), folded across variadic args. If any input is 0, the mathematical LCM is 0; the implementation returns 0 via the || 0 short-circuit."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/lcm 4 6)" :note "Returns 12.")
    (:dialect "motoi" :tier "intermediate" :code "(math/lcm 3 4 5)" :note "LCM of three. Returns 60.")
    (:dialect "motoi" :tier "expert" :code "(define (fraction-common-denom . denoms) (apply math/lcm denoms))\n(fraction-common-denom 2 3 4)" :note "Common denominator to add 1/2 + 1/3 + 1/4: 12.")
  )
  :related ("math/gcd" "nt/lcm")
  :row-2-audit (
    (:problem "A fraction adder needs the LCM of 4 and 6 to find the common denominator." :programs (
      (:code "(define (common-den a b) (math/lcm a b))
(common-den 4 6)" :tags (program))) :explanation "Product/gcd → 12." :meta "math/lcm is the correct verb. Variadic and integer-safe."
     :programs (
       (:code "(define (next-sync a b) (math/lcm a b))
(next-sync 6 8)" :tags (eng program))
       (:code "(define (multiple-of-both? n a b) (= 0 (modulo n (math/lcm a b))))
(multiple-of-both? 24 4 6)" :tags (math program))))
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: least common multiple."
     :rungs (
       (:domain "math/*" :code "(math/lcm 4 6)")
       (:domain "bus schedule (a metaphor domain — when both buses arrive together next)" :code "(define (rendezvous a b) (list a b))")
       (:domain "math — the smallest generator of aℤ ∩ bℤ" :code "(define (lcm-abstract a b) (list a b))")
     )
     :explanation "Each rung finds the smallest shared multiple."
     :meta "The shape transfers because LCM abstracts to any Euclidean domain.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "|a·b| = gcd(a,b) · lcm(a,b)." :programs (
      (:code "(= (* 4 6) (* (math/gcd 4 6) (math/lcm 4 6)))" :tags (program))) :invariant "∀ a b ∈ ℤ. |a·b| = gcd(a,b)·lcm(a,b)" :meta "Fundamental gcd-lcm identity. If broken, either lcm or gcd is wrong. See book-of-math ch 3."
     :programs (
       (:code "(= (math/lcm 4 6) (math/lcm 6 4))" :tags (math program))
       (:code "(= 0 (modulo (math/lcm 3 4 5) 60))" :tags (cs program))))
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (

    (:base "Chain lcm across a list for a common denominator." :programs (
      (:code "(define (multi-lcm xs) (fold math/lcm 1 xs))\n(multi-lcm '(2 3 4))" :tags (composition))) :emergent "reduce-with-lcm." :meta "Belongs to the family of monoid folds. See book-of-composition ch 7."
     :programs (
