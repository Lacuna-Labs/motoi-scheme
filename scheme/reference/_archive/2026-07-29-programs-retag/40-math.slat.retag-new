  :provenance "R7RS §6.2.6; added 2026-07-18 finalization"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(denominator 3/4)" :note "4.")
    (:dialect "motoi" :tier "intermediate" :code "(denominator 6)" :note "1.")
    (:dialect "motoi" :tier "expert" :code "(define (lcd . qs) (let loop ((qs qs) (acc 1)) (if (null? qs) acc (loop (cdr qs) (/ (* acc (denominator (car qs))) (gcd acc (denominator (car qs))))))))\n(lcd 1/2 1/3 1/6)" :note "Least common denominator across a list of rationals.")
  )
  :row-2-audit (
    (:problem "A fraction display extracts the bottom of 3/4 for rendering."
     :programs (
       (:code "(denominator 3/4)" :tags (program))
       (:code "(define (show-fraction q) (list 'over (numerator q) (denominator q)))\n(show-fraction 22/7)" :tags (eng program))
       (:code "(define (integer-witness? n) (= (denominator n) 1))\n(and (integer-witness? 6) (integer-witness? -3) (not (integer-witness? 3/4)))" :tags (math program))
       (:code "(define (safe-denominator x) (if (rational? x) (denominator x) (error 'not-rational)))\n(safe-denominator 5/8)" :tags (cs program)))
     :explanation "Returns 4. Eng: render fraction with numerator/denominator pair. Math: integer test via denominator = 1. CS: type-guarded read."
     :meta "denominator is the correct verb (R7RS).")
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape as numerator."
     :rungs (
       (:domain "math/*" :code "(denominator 3/4)")
       (:domain "mailing address (a metaphor domain — read the zip field)" :code "(define (zip-of addr) (list 'zip-of addr))")
       (:domain "math — second coordinate of a rational (n, d)" :code "(define (second-coord p) (cadr p))"))
     :explanation "Each rung extracts a named field."
     :meta "The shape transfers because field-access is universal.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "For integer n, denominator(n) = 1."
     :programs (
       (:code "(= (denominator 6) 1)" :tags (program))
       (:code "(define (positive-den? q) (> (denominator q) 0))\n(and (positive-den? 3/4) (positive-den? -3/4))" :tags (eng program))
       (:code "(define (product-den-divides? p q) (let ((d (denominator (* p q)))) (or (= 0 (modulo (* (denominator p) (denominator q)) d)) (= 0 (modulo d 1)))))\n(product-den-divides? 1/2 1/3)" :tags (math program))
       (:code "(define (canonical? q) (= 1 (gcd (abs (numerator q)) (denominator q))))\n(canonical? 6/8)" :tags (cs program)))
     :invariant "∀ n ∈ ℤ. denominator(n) = 1"
     :meta "Integer case. See book-of-math ch 6.")
