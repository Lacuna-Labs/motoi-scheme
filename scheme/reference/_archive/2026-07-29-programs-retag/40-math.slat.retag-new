       (:code "(define (insertion-sort xs)\n  (define (insert x sorted)\n    (cond ((null? sorted) (list x))\n          ((equal? (math/compare x (car sorted)) '<) (cons x sorted))\n          (else (cons (car sorted) (insert x (cdr sorted))))))\n  (let loop ((xs xs) (s '()))\n    (if (null? xs) s (loop (cdr xs) (insert (car xs) s)))))\n(insertion-sort '(5 2 9 1 7))" :tags (math composition))
