(verb
  :name "math/hypot" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/hypot a b ...) -> number"
  :arity "variadic (>=1)"
  :contract "all-real → nonnegative real"
  :summary "Euclidean length √(a² + b² + …) computed with overflow protection."
  :doc "Delegates to Math.hypot which uses a scaled algorithm — computes correct answers even when individual squares would overflow or underflow. Prefer this over (math/sqrt (+ (* a a) (* b b))) whenever inputs may be very large or very small."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/hypot 3 4)" :note "Classic 3-4-5 triangle. Returns 5.")
    (:dialect "motoi" :tier "intermediate" :code "(math/hypot 1 2 2)" :note "3-D length √(1+4+4). Returns 3.")
    (:dialect "motoi" :tier "expert" :code "(define (distance p q) (apply math/hypot (map - p q)))\n(distance '(1 2 3) '(4 6 3))" :note "N-D Euclidean distance via map. Returns 5.")
  )
  :related ("math/sqrt" "vec/distance" "vec/norm")
  :row-2-audit (
    (:problem "A distance calculation must stay stable when one leg is very large: hypot(1e200, 1e200)." :programs (
      (:code "(math/hypot 1e200 1e200)" :tags (program))) :explanation "Delegates to a scaled algorithm; returns ~1.414e200 without overflow." :meta "math/hypot is the correct verb because it uses the overflow-safe algorithm. sqrt(a²+b²) would overflow to infinity for such large legs."
     :programs (
       (:code "(define (screen-diagonal w h) (math/hypot w h))
(screen-diagonal 16 9)" :tags (eng program))
       (:code "(define (distance-2d p q) (math/hypot (- (car p) (car q)) (- (cadr p) (cadr q))))
(distance-2d '(1 2) '(4 6))" :tags (math program))))
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: Euclidean norm with overflow protection."
     :rungs (
       (:domain "math/*" :code "(math/hypot 3 4)")
       (:domain "chart bar (a metaphor domain — visual bar length from two component measurements)" :code "(define (bar a b) (list a b))")
       (:domain "math — L² norm computed stably" :code "(define (l2-stable xs) (list xs))")
     )
     :explanation "Each rung computes a magnitude from components without losing precision."
     :meta "The shape transfers to any numerically-stable magnitude calculation.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "hypot returns the same answer as the naive form for well-scaled inputs." :programs (
      (:code "(< (abs (- (math/hypot 3 4) 5)) 1e-9)" :tags (program))) :invariant "∀ a b well-scaled. hypot(a,b) = √(a²+b²)" :meta "Agreement on the safe range. If broken, the stable form drifted. See book-of-math ch 10 (numerical stability)."
     :programs (
       (:code "(= (math/hypot 3 4) (math/hypot 4 3))" :tags (math program))
       (:code "(< (abs (- (math/hypot 5 12) 13)) 1e-9)" :tags (cs program))))
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain hypot with map for n-D distance." :programs (
      (:code "(define (dist p q) (apply math/hypot (map - p q)))
(dist '(1 2 3) '(4 6 3))" :tags (composition))) :emergent "n-D-distance." :meta "Belongs to the family of numerically-stable aggregations. See book-of-composition ch 10."
     :programs (
       (:code "(define (path-length pts) (if (null? (cdr pts)) 0 (+ (apply math/hypot (map - (car pts) (cadr pts))) (path-length (cdr pts)))))
(path-length '((0 0) (3 4) (3 8)))" :tags (math composition))
       (:code "(define (nearest origin points) (car (sort points (lambda (a b) (< (apply math/hypot (map - a origin)) (apply math/hypot (map - b origin)))))))
(nearest '(0 0) '((3 4) (1 1) (5 5)))" :tags (cs composition))))
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
)

(verb
  :name "math/lerp" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/lerp a b t) -> number"
  :arity "3"
  :contract "a and b real, t real (usually in [0,1] but not enforced) → number"
  :summary "Linear interpolation between a and b by parameter t. Returns a + (b-a)*t."
  :doc "At t=0 returns a; at t=1 returns b. Values of t outside [0,1] extrapolate (the function is affine in t). No clamping — use math/clamp on t first for a smoothed limit."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/lerp 0 100 0.25)" :note "Quarter of the way from 0 to 100. Returns 25.")
    (:dialect "motoi" :tier "intermediate" :code "(math/lerp 10 20 0.5)" :note "Midpoint. Returns 15.")
    (:dialect "motoi" :tier "expert" :code "(define (ease-in-out t) (let ((tt (* t t))) (/ tt (+ tt (* (- 1 t) (- 1 t))))))\n(math/lerp 0 200 (ease-in-out 0.3))" :note "Compose lerp with a nonlinear easing curve for animation. Returns about 32.7.")
  )
  :related ("math/clamp" "vec/lerp" "motion/lerp" "motion/ease")
  :row-2-audit (
    (:problem "An animation moves a slider from 0 to 100 over the middle of a frame." :programs (
      (:code "(math/lerp 0 100 0.5)" :tags (program))) :explanation "Linear interp between endpoints." :meta "math/lerp is the correct verb because linear interpolation names the intent. (+ a (* t (- b a))) works but is more error-prone."
     :programs (
       (:code "(define (fade-brightness start end progress) (math/lerp start end progress))
(fade-brightness 20 255 0.5)" :tags (eng program))
       (:code "(define (unlerp a b v) (/ (- v a) (- b a)))
(math/lerp 0 100 (unlerp 0 100 42))" :tags (math program))))
    (:eng "Log the operator's stated problem and the code path chosen; audits catch cases where a sibling verb would silently succeed with wrong answers." :math "The audit lens fixes the mathematical function class (unary, binary, inverse, aggregate) and gates on argument-domain checks stated in the caveats." :cs "Row 2 emphasizes single-call, single-effect: pure functions may be replaced by their memoized result; audits check that no impure sibling was substituted.")
)
  :row-3-dimension (
    (:setup "Same shape: linear blend."
     :rungs (
       (:domain "math/*" :code "(math/lerp 0 100 0.25)")
       (:domain "mixing paint (a metaphor domain — mix of two colors by weight)" :code "(define (mix c1 c2 w) (list c1 c2 w))")
       (:domain "math — affine combination (1-t)a + tb" :code "(math/lerp 0 100 0.5)")
     )
     :explanation "Each rung blends two values by a scalar weight."
     :meta "The shape transfers because affine combinations are universal in metric spaces.")
    (:eng "Reuse of shape across substrates keeps the operator's mental model portable; the same debugging heuristics apply." :math "Cross-domain shape sharing is category-theoretic: the same universal property holds in every domain that satisfies the axioms." :cs "Cross-substrate reuse informs typeclass and trait design: the same shape becomes a shared interface across implementations."))
  :row-4-proof (
    (:claim "lerp(a, b, 0) = a and lerp(a, b, 1) = b." :programs (
      (:code "(and (= (math/lerp 0 100 0) 0) (= (math/lerp 0 100 1) 100))" :tags (program))) :invariant "∀ a b. lerp(a,b,0) = a ∧ lerp(a,b,1) = b" :meta "Endpoint anchors. If broken, the formula is misordered. See book-of-math ch 4."
     :programs (
       (:code "(= (math/lerp 10 20 0.5) 15)" :tags (math program))
       (:code "(= (math/lerp 0 100 (/ 1 2)) 50)" :tags (cs program)))
    )
    (:eng "If the invariant fails at runtime, that is a fault log line — the pure algebra should hold; a break implies the impl regressed." :math "The invariant is the closed-form algebraic identity that defines the verb's essence; falsification by counterexample is what makes it engineering-grade math." :cs "The runnable check is a property test in the sense of QuickCheck; make it a smoke test in CI so regressions are caught before ship.")
)
  :row-5-emergence (
    (:base "Chain lerp with an easing to smooth an animation." :programs (
      (:code "(define (ease-then-lerp a b t)
  (math/lerp a b (* t t (- 3 (* 2 t)))))
(ease-then-lerp 0 100 0.5)" :tags (composition))) :emergent "eased-interpolation: nonlinear time drives lerp." :meta "Belongs to the family of parametric-animation patterns. See book-of-motion ch 4."
     :programs (
       (:code "(define (lerp-color c1 c2 t) (map (lambda (a b) (math/lerp a b t)) c1 c2))
(lerp-color '(255 0 0) '(0 0 255) 0.5)" :tags (math composition))
       (:code "(define (tween-frames a b n) (map (lambda (i) (math/lerp a b (/ i (- n 1)))) (iota n)))
(tween-frames 0 100 5)" :tags (cs composition))))
    (:eng "Emergent patterns bring known operational discipline (retry, throttle, cache) into the verb chain; the operator inherits the pattern's diagnostics." :math "Composition preserves the algebraic properties of each verb; the emergent structure has its own (usually monoid) invariants worth naming." :cs "The named emergent (cache, throttle, sequencer, adapter, pipeline, projection) is the CS pattern-family label; reach for known-idiom debuggers when it appears.")
)
