      (:code "(define (sum-numerators qs) (apply + (map numerator qs)))\n(sum-numerators (list 1/5 2/5 3/5))" :tags (math composition))
      (:code "(define (reduced? q) (= 1 (gcd (abs (numerator q)) (denominator q))))\n(list (reduced? 3/4) (reduced? 6/8))" :tags (cs composition)))
