      (:code "(define m (math/mixed-number '(7 3)))
(define w (list-ref m 0))
(define n (list-ref m 1))
(define d (list-ref m 2))
(= (/ 7 3) (+ w (/ n d)))" :tags (program))
      (:code "(define m (math/mixed-number '(11 4)))\n(= (/ 11 4) (+ (list-ref m 0) (/ (list-ref m 1) (list-ref m 2))))" :tags (eng program))
      (:code "(define (proper-fraction? nd)\n  (let ((m (math/mixed-number nd)))\n    (< (list-ref m 1) (list-ref m 2))))\n(and (proper-fraction? '(7 3)) (proper-fraction? '(22 5)))" :tags (math program))
      (:code "(define (roundtrip? nd)\n  (let ((m (math/mixed-number nd)))\n    (= (/ (car nd) (cadr nd))\n       (+ (list-ref m 0) (/ (list-ref m 1) (list-ref m 2))))))\n(and (roundtrip? '(7 3)) (roundtrip? '(15 4)))" :tags (cs program)))
     :invariant "∀ (n, d) with d ≠ 0. w + n'/d' = n/d, where mixed-number(n,d) = (w, n', d')" :meta "Round-trip identity. If broken, either the whole or the fractional part is off. See book-of-math ch 6.")
