      (:code "(define (angle-differences angles) (if (or (null? angles) (null? (cdr angles))) '() (cons (- (cadr angles) (car angles)) (angle-differences (cdr angles)))))\n(angle-differences (list (atan 1) (atan 2) (atan 5)))" :tags (math composition))
