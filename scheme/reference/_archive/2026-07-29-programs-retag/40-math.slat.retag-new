       (:code "(define (small-relative-error? q) (< (abs (- (exact->inexact q) q)) (* (abs q) 1e-14)))\n(small-relative-error? 1/8)" :tags (eng program))
       (:code "(define (idempotent-on-inexact? x) (= (exact->inexact x) (exact->inexact (exact->inexact x))))\n(and (idempotent-on-inexact? 3.14) (idempotent-on-inexact? 0.1))" :tags (math program))
       (:code "(define (yields-inexact-type? q) (inexact? (exact->inexact q)))\n(and (yields-inexact-type? 1/2) (yields-inexact-type? 22/7))" :tags (cs program)))
