      (:code "(define (bezout-verified? a b) (let ((d (gcd a b))) (and (zero? (modulo a d)) (zero? (modulo b d)))))\n(bezout-verified? 48 36)" :tags (math program))
      (:code "(define (idempotent? a) (= (gcd a a) a))\n(idempotent? 24)" :tags (cs program)))
     :claim "gcd(a, 0) = |a|." :programs (
