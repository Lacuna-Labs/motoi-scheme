(dialect :applies ("motoi") :note "Library weather — 1 verb.")

(chapter :number "71" :library "weather" :verb-count 1 :training-eligible #t)

(verb :name "weather/conjure" :std "Motoi" :library "weather" :tier "core" :kind "state-change" :signature "(weather/conjure state at scale colour) -> symbol"
  :summary "Spawn a transient weather effect (rain, fog, wind) at a position at given scale and tint."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(weather/conjure 'rain (list 100 200) 1.0 'grey)" :note "Spawn rain at world position (100, 200), unit scale, grey tint.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((r (weather/conjure 'thunderstorm (list 50 50) 1.5 'blue))) (if (eq? r 'ok) 'storming 'no-weather))" :note "Guard on the return contract.")
    (:dialect "motoi" :tier "expert"       :code "(define (dread-zone where) (weather/conjure 'fog where 1.0 'grey))\n(dread-zone (list 40 60))" :note "Wrap into a named scene macro."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (mood-cue where intensity tint) (let ((r (weather/conjure 'fog where intensity tint))) (if (eq? r 'ok) 'active 'degraded)))\n(mood-cue (list 40 60) 1.0 'grey)" :tags (eng program))
      (:code "(define (biome->weather biome) (case biome ((tundra) 'blizzard) ((jungle) 'monsoon) ((desert) 'sandstorm) (else 'rain)))\n(weather/conjure (biome->weather 'tundra) (list 0 0) 1.0 'white)" :tags (math program))
      (:code "(define (safe-conjure state at scale tint) (if (symbol? state) (weather/conjure state at scale tint) (error 'need-symbol)))\n(safe-conjure 'fog (list 40 60) 1.0 'grey)" :tags (cs program)))
     :problem "Story beat needs a mood cue that lasts and dissipates without leaking scene elements or crashing when the weather subsystem is offline."
     :explanation "eng: fire-and-forget with fallback. math: biome-typed dispatch. cs: type-guarded call."
     :meta "Reach for weather/conjure and NOT scene/imagine: scene/imagine is persistent (leaks); weather/conjure is transient by design.")
    (:eng "Entity count stays flat over play sessions." :math "Sum-typed return handled totally." :cs "Self-cancelling one-shot pattern."))
  :row-3-dimension (
    (:setup "Bounded-effect emission: time-limited effect with automatic cleanup, status-only return."
     :rungs (
       (:domain "engineering"  :code "(weather/conjure 'fog (list 10 10) 1.0 'grey)")
       (:domain "mathematics"  :code "(define (biome->weather biome) (case biome ((tundra) 'blizzard) ((jungle) 'monsoon) ((desert) 'sandstorm) (else 'rain)))\n(weather/conjure (biome->weather 'tundra) (list 0 0) 1.0 'white)")
       (:domain "cs / dispatch" :code "(define (biome->weather biome) (case biome ((tundra) 'blizzard) ((jungle) 'monsoon) ((desert) 'sandstorm) (else 'rain)))\n(weather/conjure (biome->weather 'tundra) (list 0 0) 1.0 'white)"))
     :explanation "Ops mood cue, math biome-driven type, parsed dispatch."
     :meta "Fire-and-forget is a universal shape.")
    (:eng "Caller is not the janitor." :math "Exponential decay envelope: A(t) = A0·2^(-t/h)." :cs "Oneshot: channel with one value then close."))
  :row-4-proof (
    (:programs (
      (:code "(define (contract-check r) (cond ((eq? r 'ok) 'success) ((and (pair? r) (eq? (car r) 'escalate)) 'escalate) (else 'CONTRACT-VIOLATION)))\n(contract-check 'ok)" :tags (eng program))
      (:code "(define (in-sum-type? r) (or (eq? r 'ok) (and (pair? r) (eq? (car r) 'escalate))))\n(in-sum-type? 'ok)" :tags (math program))
      (:code "(define (contract-check r) (cond ((eq? r 'ok) 'success) ((and (pair? r) (eq? (car r) 'escalate)) 'escalate) (else 'CONTRACT-VIOLATION)))\n(define (no-third-case? r) (not (eq? (contract-check r) 'CONTRACT-VIOLATION)))\n(no-third-case? 'ok)" :tags (cs program)))
     :claim "weather/conjure has a total return contract: value is 'ok or an escalate token; nothing else."
     :invariant "∀ (state, at, scale, tint). conjure(state, at, scale, tint) ∈ {'ok, escalate-token}"
     :meta "Pattern: total return contract — same shape as Result<T,E>.")
    (:eng "Callers can enumerate response cases." :math "Discriminated union of cardinality 2." :cs "Sum-type return; not exceptions."))
  :row-5-emergence (
    (:programs (
      (:code "(define (dread-zone where) (weather/conjure 'fog where 1.0 'grey) (weather/conjure 'shadow where 0.6 'black) (audio/play 'low-drone))\n(dread-zone (list 40 60))" :tags (eng composition))
      (:code "(define (compose-atmosphere channels where) (map (lambda (c) (weather/conjure c where 1.0 'grey)) channels))\n(compose-atmosphere (list 'fog 'wind) (list 0 0))" :tags (math composition))
      (:code "(define (scene-macro name emitters) (for-each (lambda (e) (e)) emitters) name)\n(scene-macro 'dread-zone (list (lambda () (weather/conjure 'fog (list 0 0) 1.0 'grey))))" :tags (cs composition)))
     :base "weather/conjure emits a transient effect."
     :emergent "Compositions: eng dread-zone scene macro, math orthogonal-channel product, cs scene macro-of-composition."
     :meta "Family: scene-composition macros.")
    (:eng "Named scene macros communicate mood beats." :math "Orthogonal channels compose without interference." :cs "Macro-of-composition: naming makes it searchable."))
)
