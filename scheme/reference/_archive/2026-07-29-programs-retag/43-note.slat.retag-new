;;; 43-note.slat — Motoi Scheme Reference · Chapter 43 · library note
;;;
;;; 3 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library note — 3 verbs.")

(chapter :number "43" :library "note" :verb-count 3 :training-eligible #t)

(verb :name "note/place-at" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(note/place-at pitch [stave] [clef]) -> null"
  :summary "Place a glyph at the staff slot for a given pitch."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(note/place-at 'c4)" :note "Default stave, default clef.")
    (:dialect "motoi" :tier "intermediate" :code "(note/place-at 'g4 1)" :note "Explicit stave index.")
    (:dialect "motoi" :tier "expert"       :code "(define (place-melody pitches stave) (for-each (lambda (p) (note/place-at p stave)) pitches))\n(place-melody (list 'c4 'e4 'g4) 0)" :note "Place a melodic sequence on one stave."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(for-each note/place-at (list 'c4 'e4 'g4))" :tags (eng program))
      (:code "(define (glyph-at p s) (note/place-at p s))\n(glyph-at 'c4 0)" :tags (math program))
      (:code "(define (safe-place p) (if (symbol? p) (note/place-at p) (error 'need-pitch)))\n(safe-place 'c4)" :tags (cs program)))
     :problem "Score authoring — place glyphs at pitch slots without sounding them."
     :explanation "eng: chord/melody placement. math: pitch → slot. cs: type-guarded placement."
     :meta "Reach for note/place-at and NOT note/strike: place is visual/positional; strike sounds. Confusing the two makes silent scores sound and audible scores blank.")
    (:eng "Visual authoring path only." :math "Pitch → slot function." :cs "Setter-style placement."))
  :row-3-dimension (
    (:setup "Position-a-glyph in a coordinate system."
     :rungs (
       (:domain "engineering"  :code "(note/place-at 'c4)")
       (:domain "mathematics"  :code "(define (pitch-of freq) (if (< freq 262) 'b3 'c4))\n(note/place-at (pitch-of 440))")
       (:domain "cs / dispatch" :code "(define (parse-pitch tok) (string->symbol tok))\n(note/place-at (parse-pitch \"c4\"))"))
     :explanation "Direct, math-derived, parsed."
     :meta "Position marker in slotted grid.")
    (:eng "Visual authoring pipeline." :math "Discrete pitch space embedding." :cs "Grid-cell setter."))
  :row-4-proof (
    (:programs (
      (:code "(note/place-at 'c4)\n'placed" :tags (eng program))
      (:code "(define (idempotent-visual? p) (note/place-at p) (note/place-at p) 'same-position)\n(idempotent-visual? 'c4)" :tags (math program))
      (:code "(define (no-return-value?) (equal? (note/place-at 'c4) (if #f #f)))\n(no-return-value?)" :tags (cs program)))
     :claim "Places glyph without sounding; repeated placement is idempotent on visual state."
     :invariant "∀ p. after(place-at(p)) ⇒ staff has glyph at slot-of(p) ; no audio side-effect"
     :meta "Pattern: silent visual write.")
    (:eng "Silent authoring — audio is a separate concern." :math "Idempotent position placement." :cs "Setter on visual state."))
  :row-5-emergence (
    (:programs (
      (:code "(define (chord pitches) (for-each note/place-at pitches))\n(chord (list 'c4 'e4 'g4))" :tags (eng composition))
      (:code "(define (arpeggio pitches base) (for-each (lambda (p) (note/place-at (+ p base))) pitches))\n(arpeggio (list 0 4 7) 60)" :tags (math composition))
      (:code "(define (batch-place table) (for-each (lambda (row) (note/place-at (car row) (cadr row))) table))\n(batch-place (list (list 'c4 0) (list 'e4 0)))" :tags (cs composition)))
     :base "note/place-at positions a glyph."
     :emergent "Compositions: eng chord, math arpeggio, cs batch score-load."
     :meta "Family: score authoring.")
    (:eng "Chord is many placements at same time-slot." :math "Arpeggio is sequential placement." :cs "Batch loader for a score."))
)

(verb :name "note/release" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(note/release) -> null"
  :summary "Cut a sustained note."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(note/release)" :note "Cut the currently sustained note.")
    (:dialect "motoi" :tier "intermediate" :code "(note/strike 'c4 1.0)\n(note/release)" :note "Strike then explicitly release.")
    (:dialect "motoi" :tier "expert"       :code "(define (staccato pitch) (note/strike pitch 0.1) (note/release))\n(staccato 'c4)" :note "Wrap strike+release into a staccato note."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(note/strike 'c4 2.0)\n(note/release)" :tags (eng program))
      (:code "(define (envelope-close) (note/release))\n(envelope-close)" :tags (math program))
      (:code "(define (safe-release) (note/release))\n(safe-release)" :tags (cs program)))
     :problem "Sustained note must be cut early — otherwise the ring-out extends past intended duration."
     :explanation "eng: early cut. math: envelope close. cs: side-effect stop."
     :meta "Reach for note/release and NOT let-decay: release is a one-shot stop; let-decay lets the tail sound.")
    (:eng "Fire-and-forget stop." :math "State transition to silent." :cs "Stop-side of sustain envelope."))
  :row-3-dimension (
    (:setup "Terminal signal on an active-note channel."
     :rungs (
       (:domain "engineering"  :code "(note/release)")
       (:domain "mathematics"  :code "(note/release) ; envelope: A→D→S→R (release phase)")
       (:domain "cs / dispatch" :code "(define (should-cut?) #t)\n(when (should-cut?) (note/release))"))
     :explanation "Direct, ADSR release-phase, gated dispatch."
     :meta "Terminal transition on channel.")
    (:eng "Explicit cut vs natural decay." :math "Release phase of envelope." :cs "Signal-termination call."))
  :row-4-proof (
    (:programs (
      (:code "(note/release)\n'released" :tags (eng program))
      (:code "(define (idempotent-release?) (note/release) (note/release) 'still-released)\n(idempotent-release?)" :tags (math program))
      (:code "(define (no-value?) (equal? (note/release) (if #f #f)))\n(no-value?)" :tags (cs program)))
     :claim "Cuts any sustained note; idempotent when no note is sustained."
     :invariant "∀ state. after(release) ⇒ no sustained note ∧ release ∘ release = release"
     :meta "Pattern: idempotent stop.")
    (:eng "Safe to call even without an active note." :math "Absorbing state." :cs "Idempotent close."))
  :row-5-emergence (
    (:programs (
      (:code "(define (staccato p) (note/strike p 0.1) (note/release))\n(staccato 'c4)" :tags (eng composition))
      (:code "(define (bracketed-note p body) (note/strike p 10) (body) (note/release))\n(bracketed-note 'c4 (lambda () 'work))" :tags (math composition))
      (:code "(define (rest-then n) (note/release) (n))\n(rest-then (lambda () 'work))" :tags (cs composition)))
     :base "note/release is a terminal cut."
     :emergent "Compositions: eng staccato, math bracketed strike+work+release, cs rest-then-work."
     :meta "Family: bracketed audio.")
    (:eng "Staccato = short strike + immediate release." :math "Bracket wraps body between strike and release." :cs "Same shape as file open/close bracket."))
)

(verb :name "note/strike" :std "Motoi" :library "note" :tier "core" :kind "state-change" :signature "(note/strike pitch duration) -> null"
  :summary "Sound a pitch for a duration."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(note/strike 'c4 1.0)" :note "Sound C4 for one beat.")
    (:dialect "motoi" :tier "intermediate" :code "(for-each (lambda (p) (note/strike p 0.5)) (list 'c4 'e4 'g4))" :note "Arpeggio: each note half-beat.")
    (:dialect "motoi" :tier "expert"       :code "(define (metronome pitches durs) (for-each (lambda (p d) (note/strike p d)) pitches durs))\n(metronome (list 'c4 'e4 'g4) (list 1 1 2))" :note "Paired pitch+duration playback."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(note/strike 'c4 1.0)" :tags (eng program))
      (:code "(define (fundamental) (note/strike 'c4 (/ 60 (audio-bpm))))\n(fundamental)" :tags (math program))
      (:code "(define (safe-strike p d) (if (and (symbol? p) (number? d)) (note/strike p d) (error 'bad-args)))\n(safe-strike 'c4 1.0)" :tags (cs program)))
     :problem "Playback of a scored note — pitch and duration are both required."
     :explanation "eng: play a pitch. math: fundamental at current tempo. cs: type-guarded strike."
     :meta "Reach for note/strike and NOT note/place-at: strike sounds; place-at only shows.")
    (:eng "Playback path only." :math "Duration is real-valued in beats." :cs "Audio-side setter."))
  :row-3-dimension (
    (:setup "Sound-a-pitch for a duration."
     :rungs (
       (:domain "engineering"  :code "(note/strike 'c4 1.0)")
       (:domain "mathematics"  :code "(define (pitch-of freq) (if (< freq 262) 'b3 'c4))\n(note/strike (pitch-of 440) 1.0)")
       (:domain "cs / dispatch" :code "(define (parse-pitch tok) (string->symbol tok))\n(define (parse-dur tok) (/ (string-length tok) 10.0))\n(note/strike (parse-pitch \"c4\") (parse-dur \"beat\"))"))
     :explanation "Direct, math-derived, parsed."
     :meta "Emit tone with envelope.")
    (:eng "Playback pipeline." :math "Frequency + duration space." :cs "Audio-side write."))
  :row-4-proof (
    (:programs (
      (:code "(note/strike 'c4 1.0)\n'struck" :tags (eng program))
      (:code "(define (deterministic-duration? p d) (note/strike p d) 'played-for-d)\n(deterministic-duration? 'c4 1.0)" :tags (math program))
      (:code "(define (returns-null?) (equal? (note/strike 'c4 1.0) (if #f #f)))\n(returns-null?)" :tags (cs program)))
     :claim "Strikes the pitch and sustains for duration; envelope is release-phase-terminated by note/release."
     :invariant "∀ p d>0. strike(p, d) ⇒ audio sounds pitch p for duration d (barring release)"
     :meta "Pattern: timed audio emission.")
    (:eng "Deterministic within a device." :math "Duration is in beat-space at current tempo." :cs "Timed audio side-effect."))
  :row-5-emergence (
    (:programs (
      (:code "(define (arpeggio pitches dur) (for-each (lambda (p) (note/strike p dur)) pitches))\n(arpeggio (list 'c4 'e4 'g4) 0.5)" :tags (eng composition))
      (:code "(define (scale root steps dur) (for-each (lambda (s) (note/strike (+ root s) dur)) steps))\n(scale 60 (list 0 2 4 5 7 9 11 12) 0.25)" :tags (math composition))
      (:code "(define (score notes) (for-each (lambda (n) (note/strike (car n) (cadr n))) notes))\n(score (list (list 'c4 1) (list 'e4 1)))" :tags (cs composition)))
     :base "note/strike sounds a timed pitch."
     :emergent "Compositions: eng arpeggio, math scale by intervals, cs score playback."
     :meta "Family: timed melody playback.")
    (:eng "Arpeggio = sequential strikes." :math "Scale is interval-driven strike." :cs "Score is data-driven playback."))
)
