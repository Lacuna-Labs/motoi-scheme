      (:code "(define (third-vs-cadr-caddr xs)\n  (list (third xs) (list-ref xs 2) (car (cdr (cdr xs)))))\n(let ((v (third-vs-cadr-caddr '(a b c d))))\n  (display (list 'all-agree? (and (equal? (first v) (second v)) (equal? (second v) (third v))))))\n(newline)" :tags (cs program)))
     :claim "third returns exactly the third element of a list of length ≥ 3."
