;;; 39-list.slat — Motoi Scheme Reference · Chapter 39 · library list
;;;
;;; 15 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;

(dialect :applies ("motoi") :note "Library list — 15 verbs.")

(chapter :number "39" :library "list" :verb-count 15 :training-eligible #t)

;; ═══ 15 verbs in library list ═══

(verb
  :name "iota" :std "SRFI-1"
  :library "list"
  :tier "core"
  :kind "pure"
  :signature "(iota count [start [step]]) -> list"
  :summary "A list of count numbers, starting at start (default 0) with the given step (default 1)."
  :explanation "The SRFI-1 numeric range constructor. Unlike (range a b) which takes explicit endpoints, iota takes a length + optional start + step. Useful when you know how many elements you want more naturally than the endpoint. Empty when count is 0."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(iota 5)" :note "Five numbers starting from 0: (0 1 2 3 4).")
    (:dialect "motoi" :tier "intermediate" :code "(iota 5 10 2)" :note "Five numbers from 10, stepping by 2: (10 12 14 16 18).")
    (:dialect "motoi" :tier "expert" :code "(map (lambda (i) (list i (* i i))) (iota 6))" :note "Pair each index with its square — the classic (i i²) table.")
  )
  :caveats ("Count 0 returns the empty list, not an error." "Step may be negative or zero; negative counts down, zero produces a constant list.")
  :usecases ("Table generation." "Building index lists for map/for-each." "Constructing coordinate grids.")
  :related ("range" "map" "for-each")
  :learn (:concept "Length-first numeric range; SRFI-1 idiom." :prerequisites ("list" "range") :progression "Learn `range` for endpoint-based ranges; iota for length-based.")
  :provenance "R7RS-adjacent / SRFI-1 §Constructors; added 2026-07-18 finalization"
  :row-2-audit (
    (:programs (
      (:code "(define squares (map (lambda (i) (list i (* i i))) (iota 5)))\n(display squares)\n(newline)" :tags (eng program))
      (:code "(define (arith-prog n start step) (map (lambda (i) (+ start (* i step))) (iota n)))\n(display (arith-prog 5 10 2))\n(newline)\n(display (equal? (arith-prog 5 10 2) (iota 5 10 2)))\n(newline)" :tags (math program))
      (:code "(define (safe-iota n) (if (and (integer? n) (>= n 0)) (iota n) (error 'iota-needs-nonneg-int)))\n(display (safe-iota 5))\n(newline)" :tags (cs program)))
     :problem "The operator needs to run a computation over the first N integers to build a lookup table: for each index i, compute (i, f(i)) and add to the table. Candidates: iota (returns 0..N-1 as a list), a hand-written recursive numeric loop (works but noisier), or range with explicit endpoints (equivalent but longer to type). For a length-first index generator, iota is the honest verb — the caller knows the count and iota takes the count."
     :explanation "eng: length-first index generator, one call, exact grain. math: iota is the finite realization of the arithmetic progression a_i = a_0 + i·d for n terms; the closed-form matches iota exactly. cs: guard the count with a type + nonneg check so bad callers fail at the boundary, not silently."
     :meta "Why iota and not range: iota takes a count; the caller does not have to compute the end index. For length-first, iota reads directly.")
    (:eng "Prefer iota for length-known iteration; prefer range for endpoint-known iteration."
     :math "iota(n, start, step) generates the arithmetic progression a_0 = start, a_i = a_{i-1} + step, for i = 0..n-1."
     :cs "Related patterns: range in Python (with different arg order), numpy.arange, Ruby's 0.upto(n).")
)
  :row-3-dimension (
    (:setup "A length-first sequence generator: given a count, produce that many evenly-spaced numbers starting from a base."
     :rungs ((:domain "list" :code "(iota 5)")
             (:domain "seat numbering" :code "(define (arith-prog n start step) (map (lambda (i) (+ start (* i step))) (iota n)))\n(display (arith-prog 5 10 2))\n(newline)\n(display (equal? (arith-prog 5 10 2) (iota 5 10 2)))\n(newline)")
             (:domain "arithmetic progression a_i = a_0 + i·d" :code "(define (ap a0 d n) (map (lambda (i) (+ a0 (* i d))) (iota n)))"))
     :explanation "In list, iota produces the count-indexed sequence. In a theater, numbering the first 5 seats is the same shape: count as input, sequence as output. In math, an arithmetic progression of n terms is a length-first sequence. All three share: count + start + step → sequence."
     :meta "The shape transfers wherever a system needs a numeric sequence known by length rather than by end."))
  :row-4-proof (
    (:programs (
      (:code "(define xs (iota 5 10 2))\n(display xs)\n(newline)\n(display (list 'len (length xs) 'first (car xs) 'last (car (reverse xs))))\n(newline)" :tags (eng program))
      (:code "(define (nth-term-matches? n start step)\n  (let ((xs (iota n start step)))\n    (let loop ((i 0) (rest xs))\n      (cond ((null? rest) #t)\n            ((= (car rest) (+ start (* i step))) (loop (+ i 1) (cdr rest)))\n            (else #f)))))\n(display (nth-term-matches? 5 10 2))\n(newline)\n(display (nth-term-matches? 4 100 -1))\n(newline)" :tags (math program))
      (:code "(define (empty-boundary?) (equal? (iota 0) '()))\n(display (empty-boundary?))\n(newline)" :tags (cs program)))
     :claim "iota returns a list of length count with element i (0-indexed) equal to start + i*step; iota with count 0 is empty."
     :invariant "∀ n ≥ 0 start step. iota(n, start, step) = [start, start+step, ..., start+(n-1)*step]"
     :meta "The pattern is length-first arithmetic sequence. CS pattern name: unfold with count bound. What would falsify: a length mismatch or a wrong step. See book-of-math ch01 on arithmetic progressions.")
    (:eng "The engineering payoff is that iota is a stable index generator across all step values."
     :math "iota is the finite sample of an arithmetic progression."
     :cs "Length-first is safer than endpoint-first for negative steps because it avoids off-by-one errors at the boundary.")
)
  :row-5-emergence (
    (:programs (
      (:code "(define (grid rows cols)\n  (map (lambda (r)\n         (map (lambda (c) (list r c)) (iota cols)))\n       (iota rows)))\n(display (grid 3 2))\n(newline)" :tags (eng composition))
      (:code "(define (sigma-notation n f) (apply + (map f (iota n))))\n(display (sigma-notation 5 (lambda (i) (* i i))))\n(newline)" :tags (math composition))
      (:code "(define (batch-indices total-work workers)\n  (map (lambda (w) (filter (lambda (i) (= (modulo i workers) w)) (iota total-work)))\n       (iota workers)))\n(display (batch-indices 10 3))\n(newline)" :tags (cs composition)))
     :base "iota generates a length-first arithmetic list."
     :emergent "coordinate grid + summation + work-shard. Nesting iota inside map inside iota builds 2D lattices. iota + apply+ realizes finite Σ. iota + modulo + filter partitions integer ranges into worker-strided shards."
     :meta "The composition nests iota inside map inside iota. What emerges is the grid family: coordinate lattices for visualization, board games, matrices. Same shape as np.mgrid, as cross-join in SQL. See book-of-composition ch09 on nested iteration.")
    (:eng "Named iota-based patterns compose cleanly: grid, sigma, shard all share the same length-first substrate."
     :math "The map ∘ iota composition is finite realization of any function on a discrete arithmetic index set — the substrate of Σ, Π, and finite integrals."
     :cs "Same slot as Python range(n), Kotlin (0 until n), Rust 0..n — the finite integer iterator over which everything else is scheduled.")
)
)

(verb
  :name "concatenate" :std "SRFI-1"
  :library "list"
  :tier "core"
  :kind "pure"
  :signature "(concatenate lst-of-lsts) -> list"
  :summary "Flatten a list of lists one level."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(concatenate (list (list 1 2) (list 3 4)))" :note "(1 2 3 4).")
    (:dialect "motoi" :tier "intermediate" :code "(concatenate (map (lambda (n) (iota n)) (list 2 3 4)))" :note "Generate ranges of varying length and glue them.")
  )
  :caveats ("Only one level of flattening; nested lists remain nested.")
  :usecases ("Chaining list-producing operations." "Consequence of a group-by that yields a list-of-lists.")
  :related ("append" "append-map")
  :learn (:concept "One-level flattening — the inverse of a group." :prerequisites ("append") :progression "Learn append-map to fuse the map+concatenate pattern.")
  :provenance "SRFI-1 §Selectors; added 2026-07-18 finalization"
  :row-2-audit (
    (:programs (
      (:code "(define groups (list (list 1 2) (list 3 4 5) (list) (list 6)))\n(display (concatenate groups))\n(newline)" :tags (eng program))
      (:code "(define groups '((1 2) (3 4 5) () (6)))\n(define flat (concatenate groups))\n(display (= (length flat) (apply + (map length groups))))\n(newline)" :tags (math program))
      (:code "(define nested (list (list 1 (list 2 3)) (list 4)))\n(display (concatenate nested))\n(newline)" :tags (cs program)))
     :problem "The operator has a list-of-lists — the natural output of a map over a grouping — and needs it as a single flat list. Candidates: concatenate (one-level flatten, SRFI-1), (apply append lst-of-lsts) (equivalent but reads noisier), or a deep-flatten (wrong: goes more than one level). For a one-level flatten, concatenate is the honest verb — one call, exact grain."
     :programs (
       (:code "(define groups (list (list 1 2) (list 3 4 5) (list) (list 6)))\n(display (concatenate groups))\n(newline)" :tags (program)))
     :explanation "eng: one-level flatten preserving order. math: length is additive across sub-lists. cs: only ONE level flattened — inner (2 3) sub-list survives."
     :meta "Why concatenate and not a deep flatten: concatenate stops at one level, preserving any nested-in-nested structure. Deep flatten would erase legitimate nesting.")
    (:eng "Prefer concatenate over (apply append lst) — same behavior, clearer intent, and safer against very-long outer lists (some Schemes have argument-count limits on apply)."
     :math "concatenate is the fold with append and empty list as seed, restricted to one level."
     :cs "Related patterns: flatten in Ruby (with depth 1), flat in ES2019, chain.from_iterable in Python itertools.")
)
  :row-3-dimension (
    (:setup "A one-level flatten: reduce a list-of-lists to a single list by appending sub-lists in order, without recursing into deeper nesting."
     :rungs ((:domain "list" :code "(concatenate (list (list 1 2) (list 3)))")
             (:domain "unpack many boxes onto one table" :code "(define groups (list (list 1 2) (list 3 4 5) (list) (list 6)))\n(display (concatenate groups))\n(newline)")
             (:domain "monoid fold with append" :code "(define (concat xs) (fold-right append (list) xs))"))
     :explanation "In list, concatenate joins sub-lists. Unpacking boxes onto a table pours multi-container contents into one flat surface. In math, the monoid fold with append is the categorical form. All three share: many containers → one container, one level."
     :meta "The shape transfers wherever many collections need to become one at exactly one level."))
  :row-4-proof (
    (:programs (
      (:code "(define groups (list (list 1 2 3) (list 4 5) (list 6)))\n(define flat (concatenate groups))\n(display (list 'total (length flat) 'sum (apply + (map length groups))))\n(newline)\n(display flat)\n(newline)\n(display (concatenate (list)))\n(newline)" :tags (eng program))
      (:code "(define (empty-identity? xss) (equal? (concatenate xss) (concatenate (cons '() xss))))\n(display (and (empty-identity? '()) (empty-identity? '((1 2))) (empty-identity? '((1 2) () (3)))))\n(newline)" :tags (math program))
      (:code "(define (order-preserved? xss)\n  (let ((flat (concatenate xss)))\n    (equal? flat (apply append xss))))\n(display (order-preserved? '((1 2) (3 4 5) (6))))\n(newline)" :tags (cs program)))
     :claim "concatenate preserves order and total length: |concatenate(xss)| = Σ|xs_i|; concatenate is associative-adjacent (concatenate(concatenate(nested)) equals the naturally-flattened form for two levels)."
     :programs (
       (:code "(define groups (list (list 1 2 3) (list 4 5) (list 6)))\n(define flat (concatenate groups))\n(display (list 'total (length flat) 'sum (apply + (map length groups))))\n(newline)\n(display flat)\n(newline)\n(display (concatenate (list)))\n(newline)" :tags (program)))
     :invariant "∀ lists xs_1..xs_n. |concatenate([xs_1,...,xs_n])| = Σ|xs_i| ∧ concatenate([]) = []"
     :meta "eng: known O(total-length) cost model. math: empty list is a left identity — prepending '() to a list-of-lists doesn't change concatenate. cs: order-preserving equivalent to (apply append ...).")
    (:eng "The engineering payoff is that concatenate has a known cost model: O(total-length) and no double-copying if implemented carefully."
     :math "concatenate is the fold with (∅, ++) as the monoid."
     :cs "One-level flatten is safer than deep flatten because it terminates in one pass and preserves legitimate nesting.")
)
  :row-5-emergence (
    (:programs (
      (:code "(define (find-neighbors board pos)\n  (concatenate (map (lambda (d) (list (list (+ (car pos) (car d)) (+ (cadr pos) (cadr d))))) (list (list 0 1) (list 0 -1) (list 1 0) (list -1 0)))))\n(display (find-neighbors 'grid (list 5 5)))\n(newline)" :tags (eng composition))
      (:code "(define (union-of-sets sets) (delete-duplicates (concatenate sets)))\n(display (union-of-sets '((1 2 3) (2 3 4) (4 5))))\n(newline)" :tags (math composition))
      (:code "(define pages (list (list 'a 'b 'c) (list 'd 'e) (list 'f 'g 'h 'i)))\n(define log (concatenate pages))\n(display (list 'total-entries (length log) 'first (car log) 'last (list-ref log (- (length log) 1))))\n(newline)" :tags (cs composition)))
     :base "concatenate flattens a list-of-lists one level."
     :programs (
       (:code "(define (find-neighbors board pos)\n  (concatenate (map (lambda (d) (list (list (+ (car pos) (car d)) (+ (cadr pos) (cadr d))))) (list (list 0 1) (list 0 -1) (list 1 0) (list -1 0)))))\n(display (find-neighbors 'grid (list 5 5)))\n(newline)" :tags (composition)))
     :emergent "eng: neighbor expansion for grid searches. math: set union via concatenate + delete-duplicates. cs: page-flattening — a paginated stream to one continuous log."
     :meta "The composition chains map (per-direction) with concatenate (join per-direction results). What emerges is the neighbor-expansion family: BFS neighbors, chess-move candidates, grid searches. Same shape as flatMap in functional languages. See book-of-composition ch09 on map+concat idioms.")
)
)

(verb
  :name "delete-duplicates" :std "SRFI-1"
  :library "list"
  :tier "core"
  :kind "pure"
  :signature "(delete-duplicates lst) -> list"
  :summary "Keep only the first occurrence of each distinct element."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(delete-duplicates (list 1 2 1 3 2 4))" :note "(1 2 3 4).")
    (:dialect "motoi" :tier "intermediate" :code "(delete-duplicates '(alice bob alice carol bob))" :note "First-seen author list: (alice bob carol).")
    (:dialect "motoi" :tier "expert"       :code "(define events '((click 100) (view 100) (click 200) (view 100)))\n(delete-duplicates (map car events))" :note "Distinct kinds in order of first occurrence: (click view)."))
  :caveats ("Equality is structural (deep, list-aware). Order is preserved by first-occurrence.")
  :usecases ("Dedup a stream." "Extract distinct tags/keys.")
  :related ("member" "assoc")
  :learn (:concept "Order-preserving deduplication.")
  :provenance "SRFI-1 §Deletion; added 2026-07-18 finalization"
  :row-2-audit (
    (:programs (
      (:code "(define events (list 'click 'view 'click 'scroll 'view))\n(display (delete-duplicates events))\n(newline)" :tags (eng program))
      (:code "(define (representatives xs)\n  (delete-duplicates xs))\n(define classes '(1 -1 1 2 -2 3 3))\n(display (representatives (map abs classes)))\n(newline)" :tags (math program))
      (:code "(define (dedup-and-stats xs)\n  (let ((deduped (delete-duplicates xs)))\n    (list 'in (length xs) 'distinct (length deduped) 'ratio\n          (if (zero? (length xs)) 0 (/ (length deduped) (length xs))))))\n(display (dedup-and-stats '(a b a c a d b)))\n(newline)" :tags (cs program)))
     :problem "The operator has a list containing duplicates and needs the distinct-values-in-first-seen order. Candidates: delete-duplicates (SRFI-1, order-preserving), converting to a hash-set and back (loses order), or a manual fold with a seen-set (correct but noisier). For an order-preserving unique, delete-duplicates is the honest verb."
     :programs (
       (:code "(define events (list 'click 'view 'click 'scroll 'view))\n(display (delete-duplicates events))\n(newline)" :tags (program)))
     :explanation "eng: dedup events preserving observation order. math: canonical representative per equivalence class (abs-based). cs: cardinality-ratio diagnostic to detect duplicate-heavy streams."
     :meta "Why delete-duplicates and not a hash-set: hash-set enumeration order is unspecified, so distinct-in-original-order is not guaranteed.")
    (:eng "Prefer delete-duplicates when downstream code depends on the seen-order. Use hash-table when only distinctness is needed and order does not matter."
     :math "The result is the equivalence-class representative sequence under equal?."
     :cs "Related patterns: uniq (Unix, but requires sorted input for stream form), pandas.Series.unique (preserves order).")
)
  :row-3-dimension (
    (:setup "An order-preserving unique: walk a sequence, emit each element only on its first appearance, discard on repeat."
     :rungs ((:domain "list" :code "(delete-duplicates (list 'a 'b 'a 'c))")
             (:domain "greet each guest exactly once" :code "(define events (list 'click 'view 'click 'scroll 'view))\n(display (delete-duplicates events))\n(newline)")
             (:domain "canonical representatives of equivalence classes" :code "(define (reps eq? xs) (fold-right (lambda (x acc) (if (member x acc) acc (cons x acc))) (list) xs))"))
     :explanation "In list, delete-duplicates keeps first-occurrences. In hospitality, greeting each guest exactly once — even if they walk in, out, and back in — is the same shape. In math, picking one representative per equivalence class is the same operation. All three share: an ordered stream produces a smaller ordered stream by first-seen rule."
     :meta "The shape transfers wherever a stream has legitimate repeats but downstream code wants each identity once."))
  :row-4-proof (
    (:programs (
      (:code "(define input (list 'a 'b 'a 'c 'b 'd))\n(define result (delete-duplicates input))\n(display (list 'input input 'result result 'len (length result)))\n(newline)\n(display (equal? result (delete-duplicates result)))\n(newline)\n(display (list 'no-dup? (equal? (length result) (length (delete-duplicates result)))))\n(newline)" :tags (eng program))
      (:code "(define (subset-relation? xs)\n  (let loop ((rs (delete-duplicates xs)))\n    (or (null? rs)\n        (and (member (car rs) xs) (loop (cdr rs))))))\n(display (map subset-relation? '((a b a) (1 2 3) ())))\n(newline)" :tags (math program))
      (:code "(define (first-occurrence-index xs x)\n  (let loop ((i 0) (rest xs))\n    (cond ((null? rest) #f)\n          ((equal? (car rest) x) i)\n          (else (loop (+ i 1) (cdr rest))))))\n(define input '(c a b a c b))\n(define distinct (delete-duplicates input))\n(display (map (lambda (x) (first-occurrence-index input x)) distinct))\n(newline)" :tags (cs program)))
     :claim "delete-duplicates preserves order-of-first-occurrence and yields a list of distinct elements; length ≤ input length; idempotent."
     :programs (
       (:code "(define input (list 'a 'b 'a 'c 'b 'd))\n(define result (delete-duplicates input))\n(display (list 'input input 'result result 'len (length result)))\n(newline)\n(display (equal? result (delete-duplicates result)))\n(newline)\n(display (list 'no-dup? (equal? (length result) (length (delete-duplicates result)))))\n(newline)" :tags (program)))
     :invariant "∀ xs. delete-duplicates(xs) has |set(xs)| elements ∧ ∀ x. index_in_result(x) = min{i | xs[i] = x} ∧ delete-duplicates(delete-duplicates(xs)) = delete-duplicates(xs)"
     :meta "eng: idempotent (fixed-point). math: result is a subset of input. cs: positions in the deduped result are strictly ascending in the original list."
     :eng "The engineering payoff is that delete-duplicates is a fixed-point operation: running it twice is the same as running it once."
     :math "Idempotent (f ∘ f = f) with respect to distinctness. Length is monotone non-increasing."
     :cs "Order-preserving dedup is O(n²) with equal?-based membership, O(n) with a hash-table.")
)
  :row-5-emergence (
    (:programs (
      (:code "(define (unique-authors posts)\n  (delete-duplicates (map (lambda (p) (car p)) posts)))\n(define posts (list (list 'alice 'title1) (list 'bob 'title2) (list 'alice 'title3)))\n(display (unique-authors posts))\n(newline)" :tags (eng composition))
      (:code "(define (distinct-under f xs)\n  (delete-duplicates (map f xs)))\n(display (distinct-under (lambda (n) (modulo n 3)) '(1 2 3 4 5 6 7 8 9)))\n(newline)" :tags (math composition))
      (:code "(define (dedup-by-key kf items)\n  (let ((seen (make-hash-table)) (acc '()))\n    (for-each (lambda (i)\n                (let ((k (kf i)))\n                  (when (not (hash-table-ref/default seen k #f))\n                    (hash-table-set! seen k #t)\n                    (set! acc (cons i acc)))))\n              items)\n    (reverse acc)))\n(display (dedup-by-key car '((alice 1) (bob 2) (alice 3) (carol 4))))\n(newline)" :tags (cs composition)))
     :base "delete-duplicates removes duplicates in first-seen order."
     :programs (
       (:code "(define (unique-authors posts)\n  (delete-duplicates (map (lambda (p) (car p)) posts)))\n(define posts (list (list 'alice 'title1) (list 'bob 'title2) (list 'alice 'title3)))\n(display (unique-authors posts))\n(newline)" :tags (composition)))
     :emergent "eng: SELECT DISTINCT column extraction. math: partition xs into equivalence classes under f, take one representative each. cs: dedup-by-key retaining full records (whereas delete-duplicates loses non-key data)."
     :meta "The composition chains map (project field) with delete-duplicates (unique). What emerges is the SELECT DISTINCT family: pull a column, take the unique set. Same shape as SQL SELECT DISTINCT author FROM posts. See book-of-composition ch08 on projection idioms.")
)
)

(verb
  :name "unzip" :std "SRFI-1"
  :library "list"
  :tier "core"
  :kind "pure"
  :signature "(unzip lst-of-pairs) -> (first-list second-list)"
  :summary "Inverse of zip. Split a list of pairs into two parallel lists."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(unzip (list (list 1 3) (list 2 4)))" :note "((1 2) (3 4)).")
    (:dialect "motoi" :tier "intermediate" :code "(define alist '((a 1) (b 2) (c 3)))\n(unzip alist)" :note "Split an alist into keys and values: ((a b c) (1 2 3)).")
    (:dialect "motoi" :tier "expert"       :code "(define (xs-ys->points pairs)\n  (let ((split (unzip pairs)))\n    (list 'xs (car split) 'ys (cadr split) 'n (length (car split)))))\n(xs-ys->points '((0 0) (1 1) (2 4) (3 9)))" :note "Structural summary of a plotted curve."))
  :usecases ("Recovering original two-lists after a zip." "Splitting alist into keys + values.")
  :related ("zip" "hash-table->alist")
  :learn (:concept "Inverse operations.")
  :provenance "SRFI-1 §Constructors; added 2026-07-18 finalization"
  :row-2-audit (
    (:programs (
      (:code "(define points (list (list 1 10) (list 2 20) (list 3 30)))\n(define split (unzip points))\n(display (list 'xs (car split) 'ys (cadr split)))\n(newline)" :tags (eng program))
      (:code "(define (mean xs) (/ (apply + xs) (length xs)))\n(define (independent-means samples)\n  (let ((split (unzip samples)))\n    (list 'mean-x (mean (car split)) 'mean-y (mean (cadr split)))))\n(display (independent-means '((10 100) (20 200) (30 300))))\n(newline)" :tags (math program))
      (:code "(define (alist->keys+values a)\n  (let ((s (unzip a)))\n    (values (car s) (cadr s))))\n(call-with-values (lambda () (alist->keys+values '((a 1) (b 2) (c 3))))\n  (lambda (ks vs) (display (list 'keys ks 'values vs))))\n(newline)" :tags (cs program)))
     :problem "The operator has a list of (x, y) points and wants two parallel lists — one of x-coordinates, one of y-coordinates — to feed to two separate downstream computations. Candidates: unzip (the inverse of zip), a pair of maps (works but reads noisier: (map car pts) (map cadr pts)). For a symmetric split-of-pairs, unzip is the honest verb."
     :programs (
       (:code "(define points (list (list 1 10) (list 2 20) (list 3 30)))\n(define split (unzip points))\n(display (list 'xs (car split) 'ys (cadr split)))\n(newline)" :tags (program)))
     :explanation "eng: split (x, y) points for two downstream computations. math: independent per-axis mean from paired samples. cs: alist decomposition into keys and values via multiple return values."
     :meta "Why unzip and not two maps: two maps walk the list twice; unzip walks once and returns both projections.")
    (:eng "Prefer unzip when both projections are needed; prefer map when only one is needed."
     :math "unzip is the inverse of zip on lists of pairs: unzip(zip(xs, ys)) = (xs, ys)."
     :cs "Related patterns: zip(*iterable) in Python (using splat), unzip in Haskell, transpose for matrices.")
)
  :row-3-dimension (
    (:setup "A parallel split: transform a list-of-pairs into a pair-of-lists, inverting the pairwise combination."
     :rungs ((:domain "list" :code "(unzip (list (list 1 3) (list 2 4)))")
             (:domain "unstitch a two-color seam" :code "(define points (list (list 1 10) (list 2 20) (list 3 30)))\n(define split (unzip points))\n(display (list 'xs (car split) 'ys (cadr split)))\n(newline)")
             (:domain "matrix transpose (2×n → n×2)" :code "(define (transpose xss) (apply map list xss))"))
     :explanation "In list, unzip splits pairs. Unstitching a two-color seam recovers the two threads. In linear algebra, a transpose of an n×2 matrix is a 2×n matrix — the same information, different axis. All three share: recover parallel structure from an interleaved form."
     :meta "The shape transfers wherever pairs (or tuples) need to become parallel projections."))
  :row-4-proof (
    (:programs (
      (:code "(define xs (list 1 2 3))\n(define ys (list 10 20 30))\n(define pairs (zip xs ys))\n(define split (unzip pairs))\n(display (list 'xs-eq? (equal? (car split) xs) 'ys-eq? (equal? (cadr split) ys)))\n(newline)" :tags (eng program))
      (:code "(define (length-preserved? pairs)\n  (let ((s (unzip pairs)))\n    (and (= (length pairs) (length (car s)))\n         (= (length pairs) (length (cadr s))))))\n(display (map length-preserved? '(((1 2) (3 4)) () ((a b) (c d) (e f)))))\n(newline)" :tags (math program))
      (:code "(define (roundtrip-equal? pairs)\n  (let ((s (unzip pairs)))\n    (equal? pairs (zip (car s) (cadr s)))))\n(display (map roundtrip-equal? '(((1 10) (2 20) (3 30)) () ((a x) (b y)))))\n(newline)" :tags (cs program)))
     :claim "unzip is the left inverse of zip: (unzip (zip xs ys)) equals (list xs ys) when xs and ys have the same length."
     :programs (
       (:code "(define xs (list 1 2 3))\n(define ys (list 10 20 30))\n(define pairs (zip xs ys))\n(define split (unzip pairs))\n(display (list 'xs-eq? (equal? (car split) xs) 'ys-eq? (equal? (cadr split) ys)))\n(newline)" :tags (program)))
     :invariant "∀ xs, ys with |xs| = |ys|. unzip(zip(xs, ys)) = (xs, ys)"
     :meta "eng: lossless round-trip. math: length preservation across the split. cs: unzip-then-zip = identity on well-formed pair lists (empty case works)."
     :eng "The engineering payoff is that unzip+zip form a lossless round-trip."
     :math "unzip and zip are mutual inverses on same-length parallel lists."
     :cs "Bijection: unzip and zip are inverse functions on a well-typed domain.")
)
  :row-5-emergence (
    (:programs (
      (:code "(define measurements (list (list 't1 22.5) (list 't2 22.8) (list 't3 23.0)))\n(define splits (unzip measurements))\n(define timestamps (car splits))\n(define temps      (cadr splits))\n(display (list 'mean (/ (apply + temps) (length temps)) 'range (list (apply min temps) (apply max temps))))\n(newline)" :tags (eng composition))
      (:code "(define (covariance-inputs pairs)\n  (let* ((s (unzip pairs))\n         (xs (car s))\n         (ys (cadr s))\n         (mx (/ (apply + xs) (length xs)))\n         (my (/ (apply + ys) (length ys))))\n    (map (lambda (x y) (* (- x mx) (- y my))) xs ys)))\n(display (covariance-inputs '((1 2) (2 4) (3 6) (4 8))))\n(newline)" :tags (math composition))
      (:code "(define (transpose rows)\n  (if (null? (car rows))\n    '()\n    (cons (map car rows) (transpose (map cdr rows)))))\n(display (transpose '((1 2 3) (4 5 6))))\n(newline)" :tags (cs composition)))
     :base "unzip splits a list-of-pairs into two parallel lists."
     :programs (
       (:code "(define measurements (list (list 't1 22.5) (list 't2 22.8) (list 't3 23.0)))\n(define splits (unzip measurements))\n(define timestamps (car splits))\n(define temps      (cadr splits))\n(display (list 'mean (/ (apply + temps) (length temps)) 'range (list (apply min temps) (apply max temps))))\n(newline)" :tags (composition)))
     :emergent "eng: column-oriented aggregates over timeseries. math: covariance / pairwise deviation via independent column means. cs: n-column transpose — the general shape of which unzip is the 2-column case."
     :meta "The composition chains unzip with column-wise aggregates. What emerges is the column-oriented view family: same shape as pandas DataFrame column access, as Apache Arrow's columnar format, as SQL projection. See book-of-composition ch08 on column-orientation.")
)
)

(verb :name "second" :std "SRFI-1"  :library "list" :tier "core" :kind "pure" :signature "(second lst) -> value"
  :summary "The second element. Alias for (list-ref lst 1)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(second (list 10 20 30))" :note "20.")
    (:dialect "motoi" :tier "intermediate" :code "(define point (list 'x 12 'y 34))\n(second point)" :note "12 — the x-value in a plist-style pair-of-pairs.")
    (:dialect "motoi" :tier "expert"       :code "(define (edge->target e) (second e))\n(map edge->target '((1 2) (2 3) (3 4)))" :note "Named accessor for graph-edge targets: (2 3 4)."))
  :related ("first" "third" "list-ref") :provenance "SRFI-1 §Selectors; added 2026-07-18 finalization"
  :row-2-audit (
    (:programs (
      (:code "(define point (list 10 20 30))\n(display (list 'y (second point)))\n(newline)" :tags (eng program))
      (:code "(define (pi2 t) (second t))\n(display (map pi2 '((1 2) (10 20) (100 200))))\n(newline)" :tags (math program))
      (:code "(define (edge->target e) (second e))\n(define edges '((a b) (b c) (c d)))\n(display (list 'targets (map edge->target edges)))\n(newline)" :tags (cs program)))
     :problem "The operator has a fixed-shape record represented as a list of known length — a triple like (x y z) — and needs the second field. Candidates: second (SRFI-1 named accessor), (list-ref lst 1) (numeric index — reads noisier), (cadr lst) (chain of pair primitives — reads as low-level cons manipulation). For fixed-shape record access, second is the honest verb: the name declares the intent."
     :programs (
       (:code "(define point (list 10 20 30))\n(display (list 'y (second point)))\n(newline)" :tags (program)))
     :explanation "eng: read the y-slot of a record. math: apply π_2 projection to a batch of pairs. cs: named accessor over graph edges makes 'edge target' explicit at the call site."
     :meta "Why second and not (cadr point): cadr is right, but it reads as pair-manipulation; second reads as position 2 of a record.")
    (:eng "Prefer named positional accessors for fixed-shape records; prefer list-ref only when the index is variable."
     :math "second returns the element at position 1 (0-indexed)."
     :cs "Related patterns: [1] in Python lists, .get(1) in Java lists.")
)
  :row-3-dimension (
    (:setup "A named-position access: pick the element at a canonical position by a self-describing name."
     :rungs ((:domain "list" :code "(second (list 'x 'y 'z))")
             (:domain "silver medal" :code "(define point (list 10 20 30))\n(display (list 'y (second point)))\n(newline)")
             (:domain "π_2 projection" :code "(define (pi2 t) (list-ref t 1))"))
     :explanation "In list, second is the named accessor for position 2. In an awards context, silver refers to the second-place holder without saying 'position 2.' In math, π_2 is the projection to the second coordinate. All three share: a named handle for a canonical position."
     :meta "The shape transfers wherever a fixed-shape record has canonical positions that clients access by name."))
  :row-4-proof (
    (:programs (
      (:code "(display (second (list 'a 'b 'c)))\n(newline)\n(display (equal? (second (list 'a 'b)) (list-ref (list 'a 'b) 1)))\n(newline)" :tags (eng program))
      (:code "(define (pi2-consistent? xs) (equal? (second xs) (list-ref xs 1)))\n(display (map pi2-consistent? '((1 2) (a b c) (10 20 30 40))))\n(newline)" :tags (math program))
      (:code "(define (pure? xs)\n  (equal? (second xs) (second xs)))\n(define xs (list 'a 'b 'c))\n(display (pure? xs))\n(newline)" :tags (cs program)))
     :claim "second returns exactly the second element (index 1) of a list of length ≥ 2."
     :programs (
       (:code "(display (second (list 'a 'b 'c)))\n(newline)\n(display (equal? (second (list 'a 'b)) (list-ref (list 'a 'b) 1)))\n(newline)" :tags (program)))
     :invariant "∀ list xs with |xs| ≥ 2. second(xs) = xs[1] = list-ref(xs, 1)"
     :meta "eng: named accessor stable under refactoring. math: π_2 consistency across representations. cs: purity — two calls yield equal? results."
     :eng "The engineering payoff is that second is a stable named form of the numeric index 1."
     :math "second = π_2 on 2+ tuples."
     :cs "Named accessors help static analysis and refactor tools recognize positional intent.")
)
  :row-5-emergence (
    (:programs (
      (:code "(define (label-triples labels values) (map (lambda (v) (list (first labels) (second labels) (third labels) v)) values))\n(display (label-triples (list 'x 'y 'z) (list 10 20)))\n(newline)" :tags (eng composition))
      (:code "(define (dot2 as bs) (+ (* (first as) (first bs)) (* (second as) (second bs))))\n(display (dot2 '(3 4) '(1 2)))\n(newline)" :tags (math composition))
      (:code "(define (adjacency->neighbors edges node)\n  (map second (filter (lambda (e) (equal? (first e) node)) edges)))\n(display (adjacency->neighbors '((a b) (a c) (b c) (b d)) 'a))\n(newline)" :tags (cs composition)))
     :base "second returns the second element."
     :programs (
       (:code "(define (label-triples labels values) (map (lambda (v) (list (first labels) (second labels) (third labels) v)) values))\n(display (label-triples (list 'x 'y 'z) (list 10 20)))\n(newline)" :tags (composition)))
     :emergent "eng: labeled-record builder. math: 2D dot product spelled with named accessors. cs: adjacency-list neighbor lookup — filter by source, project target."
     :meta "The composition chains first/second/third with map. What emerges is the record-decoration family: a functional shape for adding schema to bare data. See book-of-composition ch08 on record patterns.")
)
)

