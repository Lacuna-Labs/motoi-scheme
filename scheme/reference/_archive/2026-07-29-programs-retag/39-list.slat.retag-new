      (:code "(define (cross-product-z a b)\n  (- (* (first a) (second b)) (* (second a) (first b))))\n(define (magnitude3 v)\n  (sqrt (+ (* (first v) (first v)) (* (second v) (second v)) (* (third v) (third v)))))\n(display (magnitude3 '(2 3 6)))\n(newline)" :tags (math composition))
