;;; 37-lazy.slat — Motoi Scheme Reference · Chapter 37 · library lazy
;;;
;;; 2 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library lazy — 2 verbs.")

(chapter :number "37" :library "lazy" :verb-count 2 :training-eligible #t)

(verb :name "force" :std "R7RS-small" :library "lazy" :tier "core" :kind "pure" :signature "(force promise) -> value"
  :summary "R7RS §4.2.5 — force a promise; evaluates once, memoizes."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(force (delay (+ 1 2)))" :note "3.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((p (delay (* 6 7)))) (force p))" :note "42; second force would skip the body.")
    (:dialect "motoi" :tier "expert"       :code "(define big-table (delay (begin (display \"building\") (list 'a 'b 'c))))\n(force big-table)\n(force big-table)" :note "'building' prints once; second force returns memoized list."))
  :provenance "R7RS §4.2.5; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define counter 0)\n(define p (delay (begin (set! counter (+ counter 1)) counter)))\n(force p)\n(force p)\n(list :counter counter)" :tags (eng program))
      (:code "(define (memoize-thunk t) (let ((p (delay (t)))) (lambda () (force p))))\n(define m (memoize-thunk (lambda () 42)))\n(list (m) (m))" :tags (math program))
      (:code "(define (safe-force p) (if (promise? p) (force p) (error 'not-promise)))\n(safe-force (delay 42))" :tags (cs program)))
     :problem "Large table used by some paths only — eager build wastes memory; naive thunk rebuilds every call."
     :explanation "eng: cache witness via counter. math: memoize adaptor. cs: type-guarded force."
     :meta "Reach for force and NOT a raw lambda: raw lambda re-runs each call; mutable box + guard ships mutable state; force+delay is immutable promise contract.")
    (:eng "Trace the first call — that's where the cost is." :math "Fixed-point of nullary function with state." :cs "Call-by-need — same family as OnceCell, lazy_static!."))
  :row-3-dimension (
    (:setup "Memoized read: first call computes, subsequent are free."
     :rungs (
       (:domain "engineering"  :code "(define (memoize-thunk t) (let ((p (delay (t)))) (lambda () (force p))))\n(define m (memoize-thunk (lambda () 42)))\n(list (m) (m))")
       (:domain "mathematics"  :code "(define (memoize-thunk t) (let ((p (delay (t)))) (lambda () (force p))))\n(define m (memoize-thunk (lambda () 42)))\n(list (m) (m))")
       (:domain "cs / dispatch" :code "(define (memoize-thunk t) (let ((p (delay (t)))) (lambda () (force p))))\n(define m (memoize-thunk (lambda () 42)))\n(list (m) (m))"))
     :explanation "Direct force, expensive-fn wrap, cache-guarded parse."
     :meta "Promise-that-caches is universal.")
    (:eng "HTTP caches, image thumbnails, JIT code." :math "λ_.v after first call." :cs "OnceCell / std::sync::Once."))
  :row-4-proof (
    (:programs (
      (:code "(define c 0)\n(define p (delay (begin (set! c (+ c 1)) c)))\n(define v1 (force p))\n(define v2 (force p))\n(define v3 (force p))\n(and (= v1 v2) (= v2 v3) (= c 1))" :tags (eng program))
      (:code "(define (idempotent-force? p) (equal? (force p) (force p)))\n(idempotent-force? (delay 42))" :tags (math program))
      (:code "(define (returns-value? p) (not (promise? (force p))))\n(returns-value? (delay 42))" :tags (cs program)))
     :claim "force is memoizing: repeated forces return same value; body runs once."
     :invariant "∀ p. force(p) = force(p) ∧ let v = force(p) in force(v) = v when v ∉ Promise"
     :meta "Pattern: call-by-need / memoized thunk.")
    (:eng "One-time work referenced N times without per-call cost." :math "Idempotence of memoized-thunk operator." :cs "Same family as Haskell WHNF, Scala lazy val, Clojure delay/deref."))
  :row-5-emergence (
    (:programs (
      (:code "(define c 0)\n(define p (delay (begin (set! c (+ c 1)) c)))\n(define (repeat-force n) (do ((i 0 (+ i 1))) ((>= i n) c) (force p)))\n(repeat-force 5)" :tags (eng composition))
      (:code "(define (fixpoint p) (let loop ((v (force p))) v))\n(fixpoint (delay 42))" :tags (math composition))
      (:code "(define (singleton-of thunk) (let ((p (delay (thunk)))) (lambda () (force p))))\n(define s (singleton-of (lambda () 'once)))\n(s)" :tags (cs composition)))
     :base "force is the memoizing reader of a delayed thunk."
     :emergent "Compositions: eng repeat-force with counter witness, math fixed-point iteration, cs closure-wrapped singleton."
     :meta "Family: singleton / lazy-singleton.")
    (:eng "Shared expensive resources across the whole program." :math "Fixed-point iteration on idempotent f." :cs "Same slot as sync.Once, Lazy<T>."))
)

(verb :name "make-promise" :std "R7RS-small" :library "lazy" :tier "core" :kind "pure" :signature "(make-promise v) -> promise"
  :summary "R7RS §4.2.5 — wrap a value as a pre-forced promise."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(force (make-promise 42))" :note "42.")
    (:dialect "motoi" :tier "intermediate" :code "(promise? (make-promise 'value))" :note "#t.")
    (:dialect "motoi" :tier "expert"       :code "(define (maybe-cached k get compute) (if (get k) (make-promise (get k)) (delay (compute k))))\n(force (maybe-cached 'x (lambda (k) 'ready) (lambda (k) 'later)))" :note "Uniform promise interface for hit-or-miss lookup."))
  :provenance "R7RS §4.2.5; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (uniform-lookup k table)\n  (let ((found (assoc k table)))\n    (if found (make-promise (cadr found)) (delay 'miss))))\n(force (uniform-lookup 'a (list (list 'a 1))))" :tags (eng program))
      (:code "(define (unit v) (make-promise v))\n(force (unit 42))" :tags (math program))
      (:code "(define (safe-promise v) (if v (make-promise v) (delay 'default)))\n(force (safe-promise 42))" :tags (cs program)))
     :problem "Sometimes value is known at call time, sometimes deferred; downstream wants uniform force-able interface."
     :explanation "eng: hit-or-miss factory. math: monadic unit. cs: null-guarded lift."
     :meta "Reach for make-promise and NOT (delay v): (delay v) registers a thunk the runtime tracks as unforced; make-promise packages an already-forced promise honestly.")
    (:eng "Normalize shape at boundary." :math "Unit / return / pure of promise monad." :cs "Same family as Promise.resolve, Task.FromResult."))
  :row-3-dimension (
    (:setup "Wrap-value-as-shape: lift plain value into container so downstream is uniform."
     :rungs (
       (:domain "engineering"  :code "(make-promise 42)")
       (:domain "mathematics"  :code "(define (unit v) (make-promise v))\n(force (unit 42))")
       (:domain "cs / dispatch" :code "(define (unit v) (make-promise v))\n(force (unit 42))"))
     :explanation "Direct, canonicalized, parsed."
     :meta "Unit / return / pure.")
    (:eng "Uniform boundary avoids caller coercion." :math "Natural transformation Id ⇒ M." :cs "Ready future, Promise.resolve, Observable.Just."))
  :row-4-proof (
    (:programs (
      (:code "(and (equal? (force (make-promise 42)) 42) (equal? (force (make-promise 'hi)) 'hi))" :tags (eng program))
      (:code "(define (left-identity? v) (equal? (force (make-promise v)) v))\n(left-identity? (list 1 2 3))" :tags (math program))
      (:code "(define (is-promise? v) (promise? (make-promise v)))\n(is-promise? 42)" :tags (cs program)))
     :claim "make-promise round-trips through force; result is a promise."
     :invariant "∀ v. force(make-promise(v)) = v ∧ promise?(make-promise(v)) = #t"
     :meta "Pattern: monad-law-1 round trip.")
    (:eng "Value in hand becomes a promise for free." :math "Left-identity monad law: return v >>= f = f v." :cs "Optional.of(v).get() = v family."))
  :row-5-emergence (
    (:programs (
      (:code "(define (uniform-lookup k table)\n  (let ((found (assoc k table)))\n    (if found (make-promise (cadr found)) (delay 'miss))))\n(force (uniform-lookup 'a (list (list 'a 1))))" :tags (eng composition))
      (:code "(define (sum-elim ready deferred) (if ready (make-promise ready) (delay deferred)))\n(force (sum-elim 42 'never))" :tags (math composition))
      (:code "(define (adapter make-ready make-deferred) (lambda (k) (if (make-ready k) (make-promise (make-ready k)) (delay (make-deferred k)))))\n(force ((adapter (lambda (k) k) (lambda (k) 'x)) 42))" :tags (cs composition)))
     :base "make-promise wraps a plain value in a pre-forced promise."
     :emergent "Compositions: eng uniform lookup, math sum elimination, cs adapter closure."
     :meta "Family: adapter / shape-normalizer.")
    (:eng "One call site, one error path, one profile line." :math "(Ready ⊕ Deferred) → Promise." :cs "Gang-of-Four adapter — same slot as CompletableFuture.completedFuture."))
)
