;;; 21-domain.slat — Motoi Scheme Reference · Chapter 21 · library domain
;;;
;;; 1 verb in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library domain — 1 verb.")

(chapter :number "21" :library "domain" :verb-count 1 :training-eligible #t)

(verb :name "domain/of" :std "Motoi" :library "domain" :tier "core" :kind "pure" :signature "(domain/of task-kind) -> record"
  :summary "Classify a task or escalation kind into its operational domain."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(domain/of 'inventory-check)" :note "Look up the domain classification for an inventory-check task.")
    (:dialect "motoi" :tier "intermediate" :code "(assoc :domain (domain/of 'payment-dispute))" :note "Pull just the domain name from the classification record.")
    (:dialect "motoi" :tier "expert"       :code "(define (route-tasks tasks) (map (lambda (t) (list :task t :domain (assoc :domain (domain/of t)))) tasks))\n(route-tasks (list 'restock 'shipping-delay 'legal))" :note "Batch classify tasks for a router."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (default-handler kind) (list 'default kind))\n(define (invoke-payment-handler kind) (list 'payment kind))\n(define (route-by-domain kind)\n  (let ((d (cadr (assoc :domain (domain/of kind)))))\n    (if (eq? d 'payment) (invoke-payment-handler kind) (default-handler kind))))\n(route-by-domain 'inventory-check)" :tags (eng program))
      (:code "(define (partition-tasks tasks) (fold (lambda (h t) (let ((d (assoc :domain (domain/of t)))) (hash-table-update! h d (lambda (v) (cons t v)) (lambda () '())) h)) (make-hash-table) tasks))\n(partition-tasks (list 'a 'b))" :tags (math program))
      (:code "(define (safe-classify kind) (if (symbol? kind) (domain/of kind) (error 'need-symbol)))\n(safe-classify 'restock)" :tags (cs program)))
     :problem "Escalation logic must route by domain; missing classification leads to wrong routing and lost tasks."
     :explanation "eng: route dispatch. math: partition into domain buckets. cs: type-guarded classifier."
     :meta "Reach for domain/of and NOT (route-of): route-of returns the concrete handler; domain/of returns the classification.")
    (:eng "Routing lives one layer above classification." :math "Classification into equivalence classes." :cs "Metadata-returning function."))
  :row-3-dimension (
    (:setup "Classification of tasks by handling domain."
     :rungs (
       (:domain "engineering"  :code "(domain/of 'shipping-delay)")
       (:domain "mathematics"  :code "(define (partition-tasks tasks) (fold (lambda (h t) (let ((d (assoc :domain (domain/of t)))) (hash-table-update! h d (lambda (v) (cons t v)) (lambda () '())) h)) (make-hash-table) tasks))\n(partition-tasks (list 'a 'b))")
       (:domain "cs / dispatch" :code "(define (partition-tasks tasks) (fold (lambda (h t) (let ((d (assoc :domain (domain/of t)))) (hash-table-update! h d (lambda (v) (cons t v)) (lambda () '())) h)) (make-hash-table) tasks))\n(partition-tasks (list 'a 'b))"))
     :explanation "Ops, symbolic tasks, parsed inputs."
     :meta "Classification is a universal shape.")
    (:eng "Classification precedes routing." :math "Equivalence-class projection." :cs "Metadata dispatch pattern."))
  :row-4-proof (
    (:programs (
      (:code "(define (deterministic? kind) (equal? (domain/of kind) (domain/of kind)))\n(deterministic? 'restock)" :tags (eng program))
      (:code "(define (classifies-into-known? kind) (let ((d (assoc :domain (domain/of kind)))) (member d (list 'web-research 'self 'payment 'account 'inventory 'transport))))\n(classifies-into-known? 'restock)" :tags (math program))
      (:code "(define (record-shape? kind) (let ((r (domain/of kind))) (and (list? r) (assoc :domain r) (assoc :reads r) (assoc :via r))))\n(record-shape? 'restock)" :tags (cs program)))
     :claim "domain/of is pure; returns a record with :domain, :reads, :via, :reason."
     :invariant "∀ k. domain/of(k) = domain/of(k) ∧ has-fields(domain/of(k), :domain :reads :via :reason)"
     :meta "Pattern: pure classifier.")
    (:eng "Deterministic classification supports caching." :math "Pure function." :cs "Well-typed record."))
  :row-5-emergence (
    (:programs (
      (:code "(define (batch-classify tasks) (map (lambda (t) (list t (assoc :domain (domain/of t)))) tasks))\n(batch-classify (list 'restock 'shipping))" :tags (eng composition))
      (:code "(define (domain-counts tasks) (fold (lambda (h t) (let ((d (assoc :domain (domain/of t)))) (hash-table-update! h d (lambda (n) (+ n 1)) (lambda () 0)) h)) (make-hash-table) tasks))\n(domain-counts (list 'a 'b 'a))" :tags (math composition))
      (:code "(define (routed-plan tasks) (map (lambda (t) (let ((d (domain/of t))) (list :task t :via (assoc :via d) :reads (assoc :reads d)))) tasks))\n(routed-plan (list 'restock))" :tags (cs composition)))
     :base "domain/of classifies a task."
     :emergent "Compositions: eng batch classify, math domain counts, cs routed plan."
     :meta "Family: task-routing pipelines.")
    (:eng "Batch classification precedes bulk routing." :math "Domain counts drive load balancing." :cs "Routed plans carry all metadata forward."))
)
