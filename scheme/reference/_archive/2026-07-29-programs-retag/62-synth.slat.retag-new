  :row-4-proof (
   
    (:claim "synth/sp1200 returns a status tuple; 'pending-sample-bank means the sample bank isn't wired."
     :programs (
       (:code "(let ((r (synth/sp1200 'kick 0))) (memv (car r) '(ok pending-sample-bank error)))" :tags (program))
       (:code "(define (batch-witness samples)\n  (let loop ((xs samples) (ok #t))\n    (cond ((null? xs) ok)\n          (else (loop (cdr xs) (and ok (let ((r (synth/sp1200 (car xs) 0))) (symbol? (car r)))))))))\n(batch-witness '(kick snare hat crash tom))" :tags (eng program))
       (:code "(define r (synth/sp1200 'kick 0))\n(define (well-formed-tuple? r) (and (list? r) (>= (length r) 1) (symbol? (car r))))\n(well-formed-tuple? r)" :tags (math program))
       (:code "(define r1 (synth/sp1200 'kick 0))\n(define r2 (synth/sp1200 'kick 12))\n(define r3 (synth/sp1200 'kick -12))\n(and (symbol? (car r1)) (symbol? (car r2)) (symbol? (car r3)))" :tags (cs program)))
     :invariant "car(synth/sp1200 _ _) ∈ {ok, pending-sample-bank, error}."
     :meta "Status invariant. See book-of-code ch on status tuples.")
    (:eng "Any other tag is a runtime bug."
     :math "Sum type."
     :cs "Discriminated union."))
  :row-5-emergence (
   
    (:base "synth/sp1200 triggers a sample with pitch shift."
     :programs (
       (:code "(define (drum-loop samples pitches)\n  (for-each (lambda (s p) (synth/sp1200 s p)) samples pitches))\n(drum-loop (list 'kick 'snare 'hat) (list 0 2 -1))" :tags (composition))
       (:code "(define (chromatic-pitch-sweep sample lo hi)\n  (let loop ((p lo))\n    (cond ((> p hi) 'done)\n          (else (synth/sp1200 sample p)\n                (loop (+ p 1))))))\n(chromatic-pitch-sweep 'snare -6 6)" :tags (eng composition))
       (:code "(define (semitone-ratio n) (expt 2 (/ n 12)))\n(define (playback-durations sample-len-ms pitches)\n  (map (lambda (p) (/ sample-len-ms (semitone-ratio p))) pitches))\n(playback-durations 500 '(-12 -6 0 6 12))" :tags (math composition))
       (:code "(define trigger-log '())\n(define (logged-trigger s p)\n  (set! trigger-log (cons (list s p) trigger-log))\n  (synth/sp1200 s p))\n(logged-trigger 'kick 0)\n(logged-trigger 'snare 2)\n(length trigger-log)" :tags (cs composition)))
     :emergent "A pitched-drum sequencer. The pattern is 'iterate samples with per-hit pitch.'"
