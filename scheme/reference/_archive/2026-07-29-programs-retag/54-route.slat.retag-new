;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library route — 1 verb.")

(chapter :number "54" :library "route" :verb-count 1 :training-eligible #t)

(verb :name "route/off-domain" :std "Motoi" :library "route" :tier "core" :kind "state-change" :signature "(route/off-domain task-kind) -> null"
  :summary "Hand off a task to an external escalation handler outside Motoi's automated domain."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(route/off-domain 'payment-dispute)" :note "Route a payment dispute out to the human escalation queue.")
    (:dialect "motoi" :tier "intermediate" :code "(when (floor/problem? 'account-lockout) (route/off-domain 'account-lockout))" :note "Guard the routing on floor-level severity.")
    (:dialect "motoi" :tier "expert"       :code "(define (escalate-if-critical kind ctx) (cond ((floor/problem? kind ctx) (route/off-domain kind) 'awaiting-human) (else 'handle-internally)))\n(escalate-if-critical 'payment-dispute '())" :note "State-function branching on off-domain routing vs internal handling."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (handle-dispute retry-count) (if (>= retry-count 2) (begin (route/off-domain 'payment-dispute) 'exited-to-human) 'retry-again))\n(handle-dispute 2)" :tags (eng program))
      (:code "(define (off-domain-projection ctx task) (route/off-domain task) 'awaiting-human)\n(off-domain-projection '() 'payment-dispute)" :tags (math program))
      (:code "(define (safe-route task) (if (symbol? task) (route/off-domain task) (error 'need-symbol)))\n(safe-route 'payment-dispute)" :tags (cs program)))
     :problem "Auto-retry has failed; loop must exit gracefully to a human without blocking the queue."
     :explanation "eng: bounded-retry exit. math: one-way projection to external domain. cs: type-guarded routing."
     :meta "Reach for route/off-domain and NOT escalate: escalate = programmer error (page an engineer); route/off-domain = business decision (page a human agent).")
    (:eng "Bounded-retry with graceful exit keeps queues live." :math "Projection to external domain has no automatic inverse." :cs "Type-safe boundary keeps the invariant."))
  :row-3-dimension (
    (:setup "Exit-to-external-system: task leaves the automated lane through a designated door."
     :rungs (
       (:domain "engineering / ops" :code "(route/off-domain 'payment-dispute)")
       (:domain "mathematics"       :code "(define (off-domain-projection ctx task) (route/off-domain task) 'awaiting-human)\n(off-domain-projection '() 'payment-dispute)")
       (:domain "cs / dispatch"     :code "(define (off-domain-projection ctx task) (route/off-domain task) 'awaiting-human)\n(off-domain-projection '() 'payment-dispute)"))
     :explanation "Ops routing, projection from ctx, parsed dispatch."
     :meta "Fire-and-forget is a universal shape.")
    (:eng "Ops liveness depends on release." :math "Surjection with no left inverse." :cs "Fork-and-detach pattern."))
  :row-4-proof (
    (:programs (
      (:code "(define (post-route-state task) (route/off-domain task) 'awaiting-human)\n(eq? 'awaiting-human (post-route-state 'x))" :tags (eng program))
      (:code "(define (terminal? task) (route/off-domain task) 'terminal)\n(eq? 'terminal (terminal? 'x))" :tags (math program))
      (:code "(define (no-auto-successor? task) (route/off-domain task) (null? '()))\n(no-auto-successor? 'x)" :tags (cs program)))
     :claim "route/off-domain is a terminal transition: no automatic successor state."
     :invariant "∀ task. auto-successor(state-after-route(task)) = ∅"
     :meta "Pattern: terminal transition with only external re-entry.")
    (:eng "Queue hygiene requires terminal transitions." :math "Absorbing state under automatic-transition relation." :cs "Detached process — SIGHUP no longer reaches it."))
  :row-5-emergence (
    (:programs (
      (:code "(define (escalation-chain task retry-count) (cond ((floor/problem? task) (route/off-domain task) 'exit-to-human) ((< retry-count 3) 'retry) (else (escalate 'max-retries task) 'engineer-paged)))\n(escalation-chain 'payment-dispute 0)" :tags (eng composition))
      (:code "(define (triage-fold tasks) (map (lambda (t) (cond ((floor/problem? t) (route/off-domain t) 'human) (else 'auto))) tasks))\n(triage-fold (list 'payment-dispute 'transient))" :tags (math composition))
      (:code "(define (chain-of-responsibility task ctx) (cond ((floor/problem? task ctx) (route/off-domain task) 'handled-by-human) (else 'handled-internally)))\n(chain-of-responsibility 'payment-dispute '())" :tags (cs composition)))
     :base "route/off-domain is a fire-and-forget terminal transition."
     :emergent "Compositions: eng graduated-escalation ladder, math triage fold, cs chain-of-responsibility with distinct exit routes."
     :meta "Family: graduated escalation.")
    (:eng "Named escalation ladders make on-call sustainable." :math "Decision-tree fold to distinct absorbing states." :cs "Chain-of-responsibility with per-rung exit routes."))
)
