;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library base — 1 verb.")

(chapter :number "08" :library "base" :verb-count 1 :training-eligible #t)

(verb :name "base/make-character" :std "Motoi" :library "base" :tier "core" :kind "constructor" :signature "(base/make-character visual-source [opts]) -> character-id"
  :summary "Promote a visual source (sprite, image, emoji) to a first-class character with physics and animation."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(base/make-character (sprite/address 'hero))" :note "Wrap a sprite into a first-class character.")
    (:dialect "motoi" :tier "intermediate" :code "(base/make-character (sprite/address 'wizard) (list :mass 2 :friction 0.3))" :note "Character with physics options.")
    (:dialect "motoi" :tier "expert"       :code "(define (spawn-cast members) (map (lambda (m) (base/make-character (sprite/address m) (list :group 'cast))) members))\n(spawn-cast (list 'hero 'sidekick 'villain))" :note "Batch character spawn."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (add-hero scene) (base/make-character (sprite/address 'hero)))\n(add-hero 'main-scene)" :tags (eng program))
      (:code "(define (character-from-shape s) (base/make-character s (list :collision 'aabb)))\n(character-from-shape (sprite/address 'circle))" :tags (math program))
      (:code "(define (register-character visual) (if (not (symbol? visual)) (base/make-character visual) (error 'shape 'need-sprite-address)))\n(register-character (sprite/address 'hero))" :tags (cs program)))
     :problem "Bringing a static visual into interactive gameplay requires wrapping it in a character — a body, motion loop, and input surface."
     :explanation "eng: scene entry. math: geometric-shape input. cs: type-guarded factory."
     :meta "Reach for base/make-character and NOT sprite/rasterize: rasterize gives pixels; make-character gives a runtime citizen.")
    (:eng "Character is the game-loop citizen." :math "Constructor Visual → Character." :cs "Factory pattern."))
  :row-3-dimension (
    (:setup "Promoting a raw asset to a runtime citizen."
     :rungs (
       (:domain "engineering"  :code "(base/make-character (sprite/address 'hero))")
       (:domain "mathematics"  :code "(define (character-from-shape s) (base/make-character s (list :collision 'aabb)))\n(character-from-shape (sprite/address 'circle))")
       (:domain "cs / dispatch" :code "(define (add-hero scene) (base/make-character (sprite/address 'hero)))\n(add-hero 'main-scene)"))
     :explanation "Sprites, shapes, loaded assets — all promotable to characters."
     :meta "Promotion is universal.")
    (:eng "Asset-to-citizen pipeline." :math "Injection Visual → Entity." :cs "Constructor abstracts source diversity."))
  :row-4-proof (
    (:programs (
      (:code "(define (unique-ids?) (let ((a (base/make-character (sprite/address 'x))) (b (base/make-character (sprite/address 'x)))) (not (eq? a b))))\n(unique-ids?)" :tags (eng program))
      (:code "(define (character-shape c) (cadr (assoc ':name (cdr c))))\n(define (deterministic-shape? s) (let ((c (base/make-character s))) (equal? (character-shape c) s)))\n(deterministic-shape? 'hero)" :tags (math program))
      (:code "(define (character-id? v) (and (pair? v) (eq? (car v) 'character)))\n(define (id-typed? v) (character-id? (base/make-character (sprite/address v))))\n(id-typed? 'hero)" :tags (cs program)))
     :claim "Each call returns a fresh unique character-id; shape is preserved."
     :invariant "∀ v. character-id?(mk(v)) ∧ character-shape(mk(v)) = v"
     :meta "Pattern: fresh-id constructor.")
    (:eng "Fresh IDs prevent cross-character bugs." :math "Shape-preserving injection." :cs "Well-typed return."))
  :row-5-emergence (
    (:programs (
      (:code "(define (spawn-crowd names) (map (lambda (n) (base/make-character (sprite/address n))) names))\n(spawn-crowd (list 'a 'b 'c))" :tags (eng composition))
      (:code "(define (arrange-in-circle chars r)\n  (map (lambda (c i) (list c (list (* r (cos i)) (* r (sin i)))))\n       chars (iota (length chars))))\n(arrange-in-circle (list (base/make-character (sprite/address 'a))) 100)" :tags (math composition))
      (:code "(define (typed-crowd names types) (map (lambda (n t) (base/make-character (sprite/address n) (list :type t))) names types))\n(typed-crowd (list 'a 'b) (list 'ally 'enemy))" :tags (cs composition)))
     :base "base/make-character constructs a runtime character."
     :emergent "Compositions: eng crowd, math circle arrangement, cs typed cast."
     :meta "Family: character-entity pipelines.")
    (:eng "Crowd-spawn is foundation of populated scenes." :math "Geometric arrangements." :cs "Typed batches yield semantic groups."))
)
