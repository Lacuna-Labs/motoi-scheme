(dialect :applies ("motoi") :note "Library collision — 1 verb.")

(chapter :number "14" :library "collision" :verb-count 1 :training-eligible #t)

(verb :name "collision/define-layers!" :std "Motoi" :library "collision" :tier "core" :kind "state-change" :signature "(collision/define-layers! layer-names) -> null"
  :summary "Name up to 31 collision layers by index; assigns collision bits."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(collision/define-layers! (list 'player 'enemy 'projectile))" :note "Three named layers, bits 0/1/2.")
    (:dialect "motoi" :tier "intermediate" :code "(collision/define-layers! (list 'player 'enemy 'projectile 'wall 'pickup))" :note "Five layers — a compact platformer collision spec.")
    (:dialect "motoi" :tier "expert"       :code "(define (init-game-layers config) (collision/define-layers! (map car config)) (for-each (lambda (row) (entity/mask! (car row) (cadr row))) config))\n(init-game-layers (list (list 'player (list 'enemy 'wall)) (list 'enemy (list 'wall 'projectile))))" :note "Initialize layers + configure collision masks per layer."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (setup-collisions) (collision/define-layers! (list 'player 'enemy 'projectile 'wall)))\n(setup-collisions)" :tags (eng program))
      (:code "(define (layer-bitset-count n) (collision/define-layers! (map (lambda (i) (string->symbol (string-append \"L\" (number->string i)))) (iota n))) n)\n(layer-bitset-count 5)" :tags (math program))
      (:code "(define (safe-init layers) (if (and (list? layers) (<= (length layers) 31)) (collision/define-layers! layers) (error 'too-many-layers)))\n(safe-init (list 'a 'b 'c))" :tags (cs program)))
     :problem "Collision detection needs pre-registered layer names before entities are spawned; late-registration breaks bit-mask correctness."
     :explanation "eng: startup setup. math: bitset counting. cs: pre-check length."
     :meta "Reach for collision/define-layers! ONCE at startup; the bit assignment order matters.")
    (:eng "Startup routine registers layers." :math "Bit-index assignment is left-to-right." :cs "Idempotent-first, error-on-second-call."))
  :row-3-dimension (
    (:setup "Namespace registration for a discrete label set."
     :rungs (
       (:domain "engineering"  :code "(collision/define-layers! (list 'player 'enemy))")
       (:domain "mathematics"  :code "(define (layer-bitset-count n) (collision/define-layers! (map (lambda (i) (string->symbol (string-append \"L\" (number->string i)))) (iota n))) n)\n(layer-bitset-count 5)")
       (:domain "cs / dispatch" :code "(define (layer-bitset-count n) (collision/define-layers! (map (lambda (i) (string->symbol (string-append \"L\" (number->string i)))) (iota n))) n)\n(layer-bitset-count 5)"))
     :explanation "Hardcoded, math bitset labels, parsed config."
     :meta "Label-to-bit registration is universal.")
    (:eng "Layer namespace fixes collision semantics." :math "Injection Labels → Bits." :cs "Config-driven initialization."))
  :row-4-proof (
    (:programs (
      (:code "(define (layer-index? layer) (integer? (layer-bit-index layer)))\n(collision/define-layers! (list 'a 'b))\n(layer-index? 'a)" :tags (eng program))
      (:code "(define (bit-order-preserved? layers) (let ((names (map car (map cons layers (iota (length layers)))))) (equal? layers names)))\n(bit-order-preserved? (list 'x 'y 'z))" :tags (math program))
      (:code "(collision/define-layers! (list 'p 'q 'r))\n(define (layer-bit-index layer) (case layer ((p) 0) ((q) 1) ((r) 2) (else -1)))\n(define bits (map layer-bit-index (list 'p 'q 'r)))\n(equal? bits (delete-duplicates bits))" :tags (cs program)))
     :claim "Each layer name gets a unique bit index; order is preserved."
     :invariant "∀ layers. |bit-indices(layers)| = |layers| ∧ order(bit-indices) = order(layers)"
     :meta "Pattern: name-to-bit bijection.")
    (:eng "Uniqueness prevents mask collision." :math "Bijection Labels ↔ Bits." :cs "Deterministic assignment."))
  :row-5-emergence (
    (:programs (
      (:code "(define (setup-game) (collision/define-layers! (list 'player 'enemy 'wall)) (entity/mask! 'player (list 'enemy 'wall)))\n(setup-game)" :tags (eng composition))
      (:code "(define (layer-topology adj) (collision/define-layers! (map car adj)) (map (lambda (row) (entity/mask! (car row) (cdr row))) adj))\n(layer-topology (list (list 'a 'b) (list 'b 'a)))" :tags (math composition))
      (:code "(define (assoc-ref key alist) (let ((pair (assq key alist))) (if pair (cdr pair) '())))\n(define (init-from-config config) (collision/define-layers! (assoc-ref :layers config)) (for-each (lambda (mask) (entity/mask! (car mask) (cdr mask))) (assoc-ref :masks config)))\n(init-from-config (list (cons :layers (list 'p 'e)) (cons :masks (list (cons 'p (list 'e))))))" :tags (cs composition)))
     :base "collision/define-layers! registers labels."
     :emergent "Compositions: eng game setup, math topology-from-adjacency, cs config-driven init."
     :meta "Family: collision configuration.")
    (:eng "Game initialization defines the collision universe." :math "Topology emerges from adjacency lists." :cs "Config-driven bootstrap."))
)
