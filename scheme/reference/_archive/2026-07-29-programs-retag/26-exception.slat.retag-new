;;; 26-exception.slat — Motoi Scheme Reference · Chapter 26 · library exception
;;;
;;; 5 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.
;;; R7RS §6.11. Wired end-to-end; every code block runs.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library exception — 5 verbs.")

(chapter :number "26" :library "exception" :verb-count 5 :training-eligible #t)

(verb :name "error" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(error message . irritants) -> raises"
  :summary "R7RS §6.11 — raise an error condition with a message and optional extra values."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-exception-handler (lambda (e) 'caught) (lambda () (error \"bad\")))" :note "caught.")
    (:dialect "motoi" :tier "intermediate" :code "(with-exception-handler (lambda (e) (error-object-message e)) (lambda () (error \"nope\" 42)))" :note "nope.")
    (:dialect "motoi" :tier "expert"       :code "(define (guarded v) (with-exception-handler (lambda (e) (error-object-irritants e)) (lambda () (if (positive? v) v (error \"not-positive\" v)))))\n(guarded -3)" :note "Irritants surface the offending value."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(with-exception-handler (lambda (e) 'caught) (lambda () (error \"bad-input\" 42)))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) 'total) (lambda () (error \"partial-defined\")))" :tags (math program))
      (:code "(define (safe-op x) (with-exception-handler (lambda (e) 'fallback) (lambda () (if (number? x) (* x 2) (error \"need-number\" x)))))\n(safe-op 'not-a-num)" :tags (cs program)))
     :problem "Operation must fail loudly with actionable info, not silently return #f."
     :explanation "eng: input validation. math: totality guard on partial function. cs: type-guarded compute."
     :meta "Reach for error and NOT return #f: #f is silently indistinguishable from a valid boolean; error carries message + irritants.")
    (:eng "Named errors point at the offending value." :math "Distinguish 'undefined' from a valid falsy value." :cs "Contract-violation signal."))
  :row-3-dimension (
    (:setup "Named signal with payload."
     :rungs (
       (:domain "engineering"  :code "(with-exception-handler (lambda (e) 'caught) (lambda () (let ((v -1)) (error \"bad-input\" v))))")
       (:domain "mathematics"  :code "(with-exception-handler (lambda (e) 'caught) (lambda () (let ((domain 'real)) (error \"partial-defined\" domain))))")
       (:domain "cs / dispatch" :code "(with-exception-handler (lambda (e) 'total) (lambda () (error \"partial-defined\")))"))
     :explanation "Direct, math-domain, parsed."
     :meta "Named signal with payload is universal.")
    (:eng "Every named error is an assertion of intent." :math "Partial function marker." :cs "Exception-condition primitive."))
  :row-4-proof (
    (:programs (
      (:code "(with-exception-handler (lambda (e) #t) (lambda () (error \"nope\") #f))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) (string? (error-object-message e))) (lambda () (error \"msg\") #f))" :tags (math program))
      (:code "(with-exception-handler (lambda (e) (equal? (error-object-irritants e) (list 1 2))) (lambda () (error \"m\" 1 2) #f))" :tags (cs program)))
     :claim "error unconditionally raises a condition carrying message + irritants."
     :invariant "∀ msg irritants. error(msg, irritants) raises; handler gets an object with message = msg, irritants = list-of-args"
     :meta "Pattern: exception raise with structured payload.")
    (:eng "Handler can inspect message + irritants." :math "Condition-object carries the partial-function witness." :cs "Standard R7RS error contract."))
  :row-5-emergence (
    (:programs (
      (:code "(define (safe-div a b) (with-exception-handler (lambda (e) 'div-by-zero) (lambda () (if (zero? b) (error \"div-by-zero\" a) (/ a b)))))\n(safe-div 10 0)" :tags (eng composition))
      (:code "(define (bounded x lo hi) (with-exception-handler (lambda (e) 'out-of-range) (lambda () (if (<= lo x hi) x (error \"out-of-range\" x lo hi)))))\n(bounded 5 0 3)" :tags (math composition))
      (:code "(define (validate v pred) (with-exception-handler (lambda (e) (list :error (error-object-message e))) (lambda () (if (pred v) v (error \"invalid\" v)))))\n(validate -1 positive?)" :tags (cs composition)))
     :base "error raises a structured condition."
     :emergent "Compositions: eng safe-div, math bounded-range, cs validate wrapper."
     :meta "Family: guard + fallback.")
    (:eng "Safe-div is one of the classic guarded operations." :math "Bounded range is partial function with error signal." :cs "Validate wraps predicate with structured error."))
)

(verb :name "raise" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(raise obj) -> raises"
  :summary "R7RS §6.11 — raise obj as a condition (non-error objects are wrapped)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-exception-handler (lambda (e) 'caught) (lambda () (raise 'error)))" :note "caught.")
    (:dialect "motoi" :tier "intermediate" :code "(with-exception-handler (lambda (e) e) (lambda () (raise 'my-signal)))" :note "Handler receives the raised value.")
    (:dialect "motoi" :tier "expert"       :code "(define (typed-raise kind data) (with-exception-handler (lambda (e) e) (lambda () (raise (list :kind kind :data data)))))\n(typed-raise 'over-budget 500)" :note "Raise a tagged data record."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(with-exception-handler (lambda (e) 'caught) (lambda () (raise 'user-cancel)))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) e) (lambda () (raise 'partial-fn-token)))" :tags (math program))
      (:code "(define (safe-signal v) (with-exception-handler (lambda (e) (equal? e v)) (lambda () (raise v))))\n(safe-signal 'ping)" :tags (cs program)))
     :problem "Non-error signal — user cancel, custom stop token, protocol message — needs the exception channel."
     :explanation "eng: cancel signal. math: partial-fn token. cs: any Scheme value can be raised."
     :meta "Reach for raise and NOT error: raise ships any value; error is specialized for error-message + irritants.")
    (:eng "Any Scheme value can travel the exception channel." :math "Signal is a value, not a text-string." :cs "Generalized signal primitive."))
  :row-3-dimension (
    (:setup "Value-to-handler channel."
     :rungs (
       (:domain "engineering"  :code "(with-exception-handler (lambda (e) e) (lambda () (raise 'partial-fn-token)))")
       (:domain "mathematics"  :code "(with-exception-handler (lambda (e) e) (lambda () (raise 'partial-fn-token)))")
       (:domain "cs / dispatch" :code "(with-exception-handler (lambda (e) e) (lambda () (raise 'partial-fn-token)))"))
     :explanation "Direct, math-domain witness, structured signal."
     :meta "Structured signal transport.")
    (:eng "Cancel signals travel to the enclosing handler." :math "Partial-function witness reaches the guard." :cs "Signal primitive routes across the stack."))
  :row-4-proof (
    (:programs (
      (:code "(with-exception-handler (lambda (e) (eq? e 'x)) (lambda () (raise 'x)))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) (equal? e (list 1 2))) (lambda () (raise (list 1 2))))" :tags (math program))
      (:code "(with-exception-handler (lambda (e) #t) (lambda () (raise 42) #f))" :tags (cs program)))
     :claim "raise sends the value verbatim to the enclosing handler; body after raise does not execute."
     :invariant "∀ v. raise(v) → handler receives v ∧ code after raise is unreachable"
     :meta "Pattern: transfer control with value.")
    (:eng "Value delivery is faithful." :math "Escape from body to handler is total." :cs "Non-local exit with payload."))
  :row-5-emergence (
    (:programs (
      (:code "(define (cancel-flow steps) (with-exception-handler (lambda (e) 'cancelled) (lambda () (for-each (lambda (s) (if (eq? s 'stop) (raise 'user-cancel) s)) steps) 'complete)))\n(cancel-flow (list 'a 'b 'stop 'c))" :tags (eng composition))
      (:code "(define (early-return xs f) (with-exception-handler (lambda (v) v) (lambda () (for-each (lambda (x) (let ((r (f x))) (if r (raise r) 'continue))) xs) #f)))\n(early-return (list 1 2 3) (lambda (x) (if (> x 1) x #f)))" :tags (math composition))
      (:code "(define (handle-signal fn on-signal) (with-exception-handler on-signal fn))\n(handle-signal (lambda () (raise 'ping)) (lambda (s) s))" :tags (cs composition)))
     :base "raise transports a value to the handler."
     :emergent "Compositions: eng cancellable flow, math early-return-with-witness, cs signal handler."
     :meta "Family: non-local control with payload.")
    (:eng "Cancellable flow leaves ops in a clean state." :math "Early return delivers the found witness." :cs "Signal + handler is the pub-sub of control flow."))
)

(verb :name "raise-continuable" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(raise-continuable obj) -> raises"
  :summary "R7RS §6.11 — same as raise (Motoi does not implement continuations)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-exception-handler (lambda (e) 'caught) (lambda () (raise-continuable 'x)))" :note "caught.")
    (:dialect "motoi" :tier "intermediate" :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))" :note "signal.")
    (:dialect "motoi" :tier "expert"       :code "(define (compat-raise v) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable v))))\n(compat-raise 'x)" :note "R7RS-compat entry point."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(with-exception-handler (lambda (e) 'caught) (lambda () (raise-continuable 'x)))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))" :tags (math program))
      (:code "(define (compat-signal v) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable v))))\n(compat-signal 'ping)" :tags (cs program)))
     :problem "Portable code from R7RS-conforming Schemes uses raise-continuable; Motoi implements it as raise."
     :explanation "eng: portability wrap. math: same signal semantics. cs: continuation not supported — same as raise."
     :meta "Reach for raise-continuable ONLY for R7RS-compat; Motoi does not implement continuations, so behaves as raise.")
    (:eng "Portability wrapper." :math "Same value transport as raise." :cs "Continuation-free variant."))
  :row-3-dimension (
    (:setup "R7RS-compat signal."
     :rungs (
       (:domain "engineering"  :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))")
       (:domain "mathematics"  :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))")
       (:domain "cs / dispatch" :code "(with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'signal)))"))
     :explanation "Direct, math-domain, structured."
     :meta "Same shape as raise.")
    (:eng "Interchangeable with raise on Motoi." :math "Semantically identical to raise." :cs "Portability primitive."))
  :row-4-proof (
    (:programs (
      (:code "(with-exception-handler (lambda (e) (eq? e 'x)) (lambda () (raise-continuable 'x)))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) (equal? e (list 1))) (lambda () (raise-continuable (list 1))))" :tags (math program))
      (:code "(with-exception-handler (lambda (e) #t) (lambda () (raise-continuable 'x) #f))" :tags (cs program)))
     :claim "In Motoi, raise-continuable and raise are observationally identical."
     :invariant "∀ v. raise-continuable(v) = raise(v) in Motoi"
     :meta "Pattern: R7RS-compat alias.")
    (:eng "Same guarantees as raise." :math "Alias — same semantics." :cs "Continuation-free environment."))
  :row-5-emergence (
    (:programs (
      (:code "(define (portable-signal v) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable v))))\n(portable-signal 'x)" :tags (eng composition))
      (:code "(define (compat-witness domain) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable domain))))\n(compat-witness 'partial-fn)" :tags (math composition))
      (:code "(define (dual-raise v) (list (with-exception-handler (lambda (e) e) (lambda () (raise v))) (with-exception-handler (lambda (e) e) (lambda () (raise-continuable v)))))\n(dual-raise 'x)" :tags (cs composition)))
     :base "raise-continuable is R7RS-compat alias for raise."
     :emergent "Compositions: eng portable signal, math compat witness, cs dual-raise proof."
     :meta "Family: portability wrapper.")
    (:eng "Portable code runs on Motoi without change." :math "Semantics carry across." :cs "Alias-check for observational equality."))
)

(verb :name "error-object-message" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(error-object-message e) -> string"
  :summary "Extract the error message string from a condition object."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-exception-handler (lambda (e) (error-object-message e)) (lambda () (error \"hi\")))" :note "hi.")
    (:dialect "motoi" :tier "intermediate" :code "(with-exception-handler (lambda (e) (string-length (error-object-message e))) (lambda () (error \"12345\")))" :note "5.")
    (:dialect "motoi" :tier "expert"       :code "(define (fmt-error thunk) (with-exception-handler (lambda (e) (string-append \"ERR: \" (error-object-message e))) thunk))\n(fmt-error (lambda () (error \"broke\")))" :note "Named formatter."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(with-exception-handler (lambda (e) (error-object-message e)) (lambda () (error \"bad\")))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) (string? (error-object-message e))) (lambda () (error \"x\")))" :tags (math program))
      (:code "(define (safe-msg thunk default) (with-exception-handler (lambda (e) (or (error-object-message e) default)) thunk))\n(safe-msg (lambda () (error \"real\")) \"fallback\")" :tags (cs program)))
     :problem "Handler needs the human-readable message from the raised condition."
     :explanation "eng: extract message. math: string projection. cs: fallback default."
     :meta "Reach for error-object-message and NOT (car e): the structure of a condition object is opaque; the extractor is the contract.")
    (:eng "Extractor is the durable contract." :math "String-valued projection." :cs "Well-typed field access."))
  :row-3-dimension (
    (:setup "Field extraction from a structured value."
     :rungs (
       (:domain "engineering"  :code "(with-exception-handler (lambda (e) 'total) (lambda () (error \"partial-defined\")))")
       (:domain "mathematics"  :code "(with-exception-handler (lambda (e) (string? (error-object-message e))) (lambda () (error \"x\")))")
       (:domain "cs / dispatch" :code "(with-exception-handler (lambda (e) (string? (error-object-message e))) (lambda () (error \"x\")))"))
     :explanation "Direct, canonicalized, parsed."
     :meta "Well-known field extractor.")
    (:eng "Field access as narrow contract." :math "Projection to string." :cs "Getter for structured field."))
  :row-4-proof (
    (:programs (
      (:code "(with-exception-handler (lambda (e) (equal? (error-object-message e) \"hi\")) (lambda () (error \"hi\")))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) (string? (error-object-message e))) (lambda () (error \"x\")))" :tags (math program))
      (:code "(with-exception-handler (lambda (e) (string-length (error-object-message e))) (lambda () (error \"12345\")))" :tags (cs program)))
     :claim "Returns the message string passed to error, verbatim."
     :invariant "∀ msg irr. error-object-message(handler(error(msg, irr))) = msg"
     :meta "Pattern: faithful field extraction.")
    (:eng "Message survives the exception path unchanged." :math "String → string identity." :cs "Faithful getter."))
  :row-5-emergence (
    (:programs (
      (:code "(define (log-error thunk logger) (with-exception-handler (lambda (e) (logger (error-object-message e))) thunk))\n(log-error (lambda () (error \"oops\")) (lambda (m) (list :logged m)))" :tags (eng composition))
      (:code "(define (fmt-error thunk fmt) (with-exception-handler (lambda (e) (fmt (error-object-message e))) thunk))\n(fmt-error (lambda () (error \"broke\")) (lambda (m) (string-append \"! \" m)))" :tags (math composition))
      (:code "(define (retry-with-log fn max-retries logger) (let loop ((n 0)) (with-exception-handler (lambda (e) (logger (error-object-message e)) (if (< n max-retries) (loop (+ n 1)) 'gave-up)) fn)))\n(retry-with-log (lambda () 'ok) 3 (lambda (m) m))" :tags (cs composition)))
     :base "error-object-message extracts the message."
     :emergent "Compositions: eng log-error, math fmt-error, cs retry-with-log."
     :meta "Family: error observability.")
    (:eng "Log-error is the smallest useful observability adapter." :math "Formatter composes with message extractor." :cs "Retry loop uses message for diagnostics."))
)

(verb :name "error-object-irritants" :std "R7RS-small" :library "exception" :tier "core" :kind "pure" :signature "(error-object-irritants e) -> list"
  :summary "Extract the irritant list from a condition object."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(with-exception-handler (lambda (e) (error-object-irritants e)) (lambda () (error \"bad\" 1 2)))" :note "(1 2).")
    (:dialect "motoi" :tier "intermediate" :code "(with-exception-handler (lambda (e) (length (error-object-irritants e))) (lambda () (error \"bad\" 1 2 3)))" :note "3.")
    (:dialect "motoi" :tier "expert"       :code "(define (extract-first-irritant thunk) (with-exception-handler (lambda (e) (car (error-object-irritants e))) thunk))\n(extract-first-irritant (lambda () (error \"bad\" 42)))" :note "First irritant."))
  :provenance "R7RS §6.11; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(with-exception-handler (lambda (e) (car (error-object-irritants e))) (lambda () (error \"bad\" 42)))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) (length (error-object-irritants e))) (lambda () (error \"bad\" 1 2 3)))" :tags (math program))
      (:code "(with-exception-handler (lambda (e) (list (error-object-message e) (error-object-irritants e))) (lambda () (error \"bad-input\" 'x)))" :tags (cs program)))
     :problem "Handler needs the offending values from the raised condition."
     :explanation "eng: extract offender. math: count irritants. cs: message + irritants pair."
     :meta "Reach for error-object-irritants and NOT (cdr e): irritants is the contracted field name; opaque access is more portable.")
    (:eng "Irritants pinpoint the offender." :math "List-valued projection." :cs "Well-typed field access."))
  :row-3-dimension (
    (:setup "Extract the irritant list."
     :rungs (
       (:domain "engineering"  :code "(with-exception-handler (lambda (e) 'total) (lambda () (error \"partial-defined\")))")
       (:domain "mathematics"  :code "(with-exception-handler (lambda (e) (length (error-object-irritants e))) (lambda () (error \"bad\" 1 2 3)))")
       (:domain "cs / dispatch" :code "(with-exception-handler (lambda (e) (length (error-object-irritants e))) (lambda () (error \"bad\" 1 2 3)))"))
     :explanation "Direct, canonicalized, parsed."
     :meta "Well-known field extractor.")
    (:eng "Field access as narrow contract." :math "Projection to list." :cs "Getter for structured field."))
  :row-4-proof (
    (:programs (
      (:code "(with-exception-handler (lambda (e) (equal? (error-object-irritants e) (list 1 2))) (lambda () (error \"bad\" 1 2)))" :tags (eng program))
      (:code "(with-exception-handler (lambda (e) (list? (error-object-irritants e))) (lambda () (error \"x\")))" :tags (math program))
      (:code "(with-exception-handler (lambda (e) (= 3 (length (error-object-irritants e)))) (lambda () (error \"bad\" 1 2 3)))" :tags (cs program)))
     :claim "Returns the irritant list exactly as passed to error."
     :invariant "∀ msg irr. error-object-irritants(handler(error(msg, ...irr))) = irr"
     :meta "Pattern: faithful field extraction.")
    (:eng "Irritant list survives the exception path unchanged." :math "List → list identity." :cs "Faithful getter."))
  :row-5-emergence (
    (:programs (
      (:code "(define (report thunk) (with-exception-handler (lambda (e) (list :msg (error-object-message e) :vals (error-object-irritants e))) thunk))\n(report (lambda () (error \"nope\" 1 2)))" :tags (eng composition))
      (:code "(define (first-witness thunk) (with-exception-handler (lambda (e) (car (error-object-irritants e))) thunk))\n(first-witness (lambda () (error \"partial\" 'x)))" :tags (math composition))
      (:code "(define (structured-log thunk) (with-exception-handler (lambda (e) (list :error (error-object-message e) :context (error-object-irritants e))) thunk))\n(structured-log (lambda () (error \"nope\" 'ctx)))" :tags (cs composition)))
     :base "error-object-irritants extracts the payload list."
     :emergent "Compositions: eng report record, math first-witness, cs structured log record."
     :meta "Family: error observability with payload.")
    (:eng "Report record joins message + irritants." :math "First-witness names the partial-function counterexample." :cs "Structured log carries both."))
)
