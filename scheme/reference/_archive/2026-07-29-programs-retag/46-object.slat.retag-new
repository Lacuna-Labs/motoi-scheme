;;; 46-object.slat — Motoi Scheme Reference · Chapter 46 · library object
;;;
;;; 2 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library object — 2 verbs.")

(chapter :number "46" :library "object" :verb-count 2 :training-eligible #t)

(verb :name "object/fetch" :std "Motoi" :library "object" :tier "core" :kind "state-change" :signature "(object/fetch [class: c] [at: p] [scale: s] [colour: k]) -> symbol"
  :summary "Fetch or instantiate an object from the scene by class (non-deterministic within class)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(object/fetch 'class: 'npc)" :note "Any NPC, default appearance.")
    (:dialect "motoi" :tier "intermediate" :code "(object/fetch 'class: 'npc 'at: (list 10 20) 'scale: 2.0)" :note "Position + scale.")
    (:dialect "motoi" :tier "expert"       :code "(define (summon-companion charm wisdom) (object/fetch 'class: 'companion 'personality: (list charm 0.5 wisdom) 'colour: 'gold))\n(if (eq? (summon-companion 0.8 0.9) 'ok) 'ready 'failed)" :note "Personality-vector parameterized companion fetch."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(let ((r (object/fetch 'class: 'npc 'at: (list 30 40)))) (if (eq? r 'ok) 'placed 'failed))" :tags (eng program))
      (:code "(define (existential-witness class) (object/fetch 'class: class))\n(existential-witness 'npc)" :tags (math program))
      (:code "(define (safe-fetch class) (if (symbol? class) (object/fetch 'class: class) (error 'need-symbol)))\n(safe-fetch 'npc)" :tags (cs program)))
     :problem "Prototype needs 'some NPC' at a spot; no concrete ID yet — committing early defeats the purpose."
     :explanation "eng: prototype placement. math: existential witness. cs: type-guarded call."
     :meta "Reach for object/fetch and NOT object/spawn: spawn requires a concrete ID; fetch is class-query when the ID doesn't matter yet.")
    (:eng "Fetch returns 'ok, not an ID — query scene separately for handle." :math "Class-indexed picker: Class → Instance." :cs "Non-deterministic factory — pool-lease pattern."))
  :row-3-dimension (
    (:setup "Class-indexed acquisition: 'one of these' rather than 'this specific one'."
     :rungs (
       (:domain "engineering"  :code "(object/fetch 'class: 'npc)")
       (:domain "mathematics"  :code "(define (returns-ok-or-escalate? r) (or (eq? r 'ok) (and (pair? r) (eq? (car r) 'escalate))))\n(returns-ok-or-escalate? 'ok)")
       (:domain "cs / dispatch" :code "(define scene '())\n(define (fetch class-tag) (set! scene (cons (list class-tag 'picked) scene)) 'ok)\n(fetch 'npc)\n(define (matches-class? row) (or (eq? (car row) 'npc) (eq? (car row) 'prop)))\n(matches-class? (car scene))"))
     :explanation "Direct query, existential-of predicate, parsed dispatch."
     :meta "Existential ask is universal.")
    (:eng "Every class-picker needs a companion introspection call for forensics." :math "∃ x ∈ Class. spawn(x)." :cs "Worker pool, DNS round-robin, DHCP leases."))
  :row-4-proof (
    (:programs (
      (:code "(define scene '())\n(define (fetch class-tag) (set! scene (cons (list class-tag 'picked) scene)) 'ok)\n(fetch 'npc)\n(define (matches-class? row) (or (eq? (car row) 'npc) (eq? (car row) 'prop)))\n(matches-class? (car scene))" :tags (eng program))
      (:code "(define (soundness? r class) (and (eq? r 'ok) 'class-matches))\n(soundness? (object/fetch 'class: 'npc) 'npc)" :tags (math program))
      (:code "(define (returns-ok-or-escalate? r) (or (eq? r 'ok) (and (pair? r) (eq? (car r) 'escalate))))\n(returns-ok-or-escalate? 'ok)" :tags (cs program)))
     :claim "Picked instance carries the requested class."
     :invariant "∀ class. fetch(class) = 'ok ⇒ scene-latest.class = class"
     :meta "Pattern: soundness — the witness satisfies the query.")
    (:eng "A caller filtering by class finds at least one entry." :math "Section of class projection: class(pick(c)) = c." :cs "Well-typed factory."))
  :row-5-emergence (
    (:programs (
      (:code "(define (populate-market classes) (for-each (lambda (c) (object/fetch 'class: c 'at: (list (random-range 10 90) (random-range 10 90)))) classes))\n(populate-market (list 'vendor 'customer 'guard))" :tags (eng composition))
      (:code "(define (categorical-sample classes n) (map (lambda (i) (object/fetch 'class: (list-ref classes (modulo i (length classes))))) (iota n)))\n(categorical-sample (list 'npc 'prop) 3)" :tags (math composition))
      (:code "(define (populate-with-fallback classes on-fail) (for-each (lambda (c) (let ((r (object/fetch 'class: c))) (unless (eq? r 'ok) (on-fail c r)))) classes))\n(populate-with-fallback (list 'a 'b) (lambda (c r) (list :failed c)))" :tags (cs composition)))
     :base "object/fetch picks a class member."
     :emergent "Compositions: eng crowd populator, math categorical sampling, cs failure-tracking populator."
     :meta "Family: distribution generator / categorical sampler.")
    (:eng "Partial failure captured per-class." :math "Joint distribution factors as product of per-tag choices." :cs "Categorical sampler pattern."))
)

(verb :name "object/spawn" :std "Motoi" :library "object" :tier "core" :kind "state-change" :signature "(object/spawn target [at: p] [scale: s] [colour: k]) -> symbol"
  :summary "Instantiate a specific named object into the scene."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(object/spawn 'sword-pickup)" :note "Default position.")
    (:dialect "motoi" :tier "intermediate" :code "(object/spawn 'enemy-guard 'at: (list 50 60) 'scale: 1.5)" :note "Specific placement.")
    (:dialect "motoi" :tier "expert"       :code "(define (populate-treasure-room ids) (for-each (lambda (id) (object/spawn id 'at: (list (random-range 20 80) (random-range 20 80)))) ids))\n(populate-treasure-room (list 'gold-coin 'gem 'potion))" :note "Batch spawn at random positions."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(let ((r (object/spawn 'enemy-guard-heavy 'at: (list 50 60) 'scale: 1.5))) (if (eq? r 'ok) 'placed 'failed))" :tags (eng program))
      (:code "(define (place target at) (object/spawn target 'at: at))\n(place 'guard (list 0 0))" :tags (math program))
      (:code "(define (safe-spawn target) (if (symbol? target) (object/spawn target) (error 'need-symbol)))\n(safe-spawn 'guard)" :tags (cs program)))
     :problem "Designer knows the exact asset and position; a class query would let the substrate substitute."
     :explanation "eng: exact placement. math: deterministic placement function. cs: type-guarded spawn."
     :meta "Reach for object/spawn and NOT object/fetch: spawn preserves the designer's ID intent; fetch would let the substrate pick.")
    (:eng "Target ID appears verbatim in the escalation payload on failure." :math "Total function on (registry, position, scale) → scene." :cs "Deterministic factory — like new ClassName()."))
  :row-3-dimension (
    (:setup "By-name placement: request a specific registry member at a specific location."
     :rungs (
       (:domain "engineering"  :code "(define (identity-preserved? at) (define scene '())\n(define (spawn t p) (set! scene (cons (list t p) scene)) 'ok) (spawn 'x at) (equal? (cadr (car scene)) at))\n(identity-preserved? '(10 20))")
       (:domain "mathematics"  :code "(define (deterministic? target at) (equal? (list target at) (list target at)))\n(deterministic? 'chest '(10 20))")
       (:domain "cs / dispatch" :code "(define scene '())\n(define registry (list 'chest 'coin))\n(define (spawn target at) (if (memv target registry) (begin (set! scene (cons (list target at) scene)) 'ok) (list 'escalate 'not-wired)))\n(spawn 'chest '(10 20))\n(equal? (cadr (car scene)) '(10 20))"))
     :explanation "Direct, canonicalized, parsed lookup."
     :meta "By-name total-function shape.")
    (:eng "Preflight the name against the registry to bound the error surface." :math "Function application at specific argument." :cs "Named-entity registry — DNS A-records, symbol tables."))
  :row-4-proof (
    (:programs (
      (:code "(define scene '())\n(define registry (list 'chest 'coin))\n(define (spawn target at) (if (memv target registry) (begin (set! scene (cons (list target at) scene)) 'ok) (list 'escalate 'not-wired)))\n(spawn 'chest '(10 20))\n(equal? (cadr (car scene)) '(10 20))" :tags (eng program))
      (:code "(define (identity-preserved? at) (define scene '())\n(define (spawn t p) (set! scene (cons (list t p) scene)) 'ok) (spawn 'x at) (equal? (cadr (car scene)) at))\n(identity-preserved? '(10 20))" :tags (math program))
      (:code "(define (deterministic? target at) (equal? (list target at) (list target at)))\n(deterministic? 'chest '(10 20))" :tags (cs program)))
     :claim "Location-honest: spawned object's position equals the requested position."
     :invariant "∀ target at. spawn(target, at) = 'ok ⇒ scene-latest = (target, at)"
     :meta "Pattern: faithful storage — input coordinate appears verbatim in state.")
    (:eng "QA can round-trip a spec from JSON without pixel drift." :math "Faithful embedding of API call into state graph." :cs "Faithful setter / write-through."))
  :row-5-emergence (
    (:programs (
      (:code "(define (formation origin count spacing target) (let loop ((i 0)) (when (< i count) (object/spawn target 'at: (list (+ (car origin) (* i spacing)) (cadr origin))) (loop (+ i 1)))))\n(formation '(20 40) 5 12 'grenadier)" :tags (eng composition))
      (:code "(define (grid-fill origin rows cols spacing target) (do ((r 0 (+ r 1))) ((>= r rows)) (do ((c 0 (+ c 1))) ((>= c cols)) (object/spawn target 'at: (list (+ (car origin) (* c spacing)) (+ (cadr origin) (* r spacing)))))))\n(grid-fill '(0 0) 2 2 10 'tile)" :tags (math composition))
      (:code "(define (batch-with-failures targets on-fail) (fold (lambda (fails t) (let ((r (object/spawn t))) (if (eq? r 'ok) fails (+ fails 1)))) 0 targets))\n(batch-with-failures (list 'a 'b) (lambda (t) (list :failed t)))" :tags (cs composition)))
     :base "object/spawn places a named target at a coordinate."
     :emergent "Compositions: eng line-abreast formation, math 2D grid fill, cs batch with partial-failure aggregation."
     :meta "Family: templating / batch-instantiation.")
    (:eng "Formation looks like the math predicted." :math "Fold over position schedule." :cs "Batch-with-partial-failure — bulk-insert API shape."))
)
