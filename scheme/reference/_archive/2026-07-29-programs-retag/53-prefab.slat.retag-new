;;; 53-prefab.slat — Motoi Scheme Reference · Chapter 53 · library prefab
;;;
;;; 2 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library prefab — 2 verbs.")

(chapter :number "53" :library "prefab" :verb-count 2 :training-eligible #t)

(verb :name "prefab/define" :std "Motoi" :library "prefab" :tier "core" :kind "state-change" :signature "(prefab/define name spec) -> #t"
  :summary "Register a named prefab template — a reusable spawn recipe."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(prefab/define 'enemy-basic '(kind enemy hp 5 sprite \"foe.png\"))" :note "Register an enemy template.")
    (:dialect "motoi" :tier "intermediate" :code "(define (make-tree v) (list 'kind 'tree 'variant v))\n(prefab/define 'tree-oak (make-tree \"oak\"))" :note "Generate specs programmatically.")
    (:dialect "motoi" :tier "expert"       :code "(define (prefab-with-state name kind hp behavior) (prefab/define name (list 'kind kind 'hp hp 'state 'idle 'behavior behavior)))\n(prefab-with-state 'goblin 'enemy 3 'wander)" :note "Helper for consistent template structure."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(prefab/define 'enemy-basic '(kind enemy hp 5 sprite \"foe.png\"))" :tags (eng program))
      (:code "(define (register name spec) (prefab/define name spec) name)\n(register 'x '(kind item))" :tags (math program))
      (:code "(define (safe-define name spec) (if (and (symbol? name) (list? spec)) (prefab/define name spec) (error 'bad-args)))\n(safe-define 'x '(kind item))" :tags (cs program)))
     :problem "Inline spec every time = grep-and-replace bug farm when sprites/attributes change."
     :explanation "eng: single source of truth for template. math: partial function name → spec. cs: type-guarded register."
     :meta "Reach for prefab/define and NOT prefab/spawn: define registers the template; spawn instantiates. Missing the define step yields empty world.")
    (:eng "Silent redefinition is a footgun — log double-defines." :math "Grows the registry monotonically." :cs "REGISTER in plugin system, modprobe symbol table."))
  :row-3-dimension (
    (:setup "Publish named template to shared registry."
     :rungs (
       (:domain "engineering"  :code "(define (coherent? name spec) (define registry '()) (define (d! n s) (set! registry (cons (cons n s) registry))) (define (r n) (cdr (assq n registry))) (d! name spec) (equal? (r name) spec))\n(coherent? 'x '(kind item))")
       (:domain "mathematics"  :code "(define (roundtrip? name spec) (define r '()) (define (d! n s) (set! r (cons (cons n s) r))) (define (rd n) (cdr (assq n r))) (d! name spec) (equal? (rd name) spec))\n(roundtrip? 'a '(b))")
       (:domain "cs / dispatch" :code "(define registry '())\n(define (define! name spec) (set! registry (cons (cons name spec) registry)))\n(define (read name) (cdr (assq name registry)))\n(define! 'coin '(kind coin points 10))\n(equal? (read 'coin) '(kind coin points 10))"))
     :explanation "Direct, canonicalized, parsed dispatch."
     :meta "Name → value in a registry.")
    (:eng "Every registry pays for freedom with collision risk." :math "Partial map Symbol → Value; monotone update." :cs "Symbol table write — env-frame extend, intern."))
  :row-4-proof (
    (:programs (
      (:code "(define registry '())\n(define (define! name spec) (set! registry (cons (cons name spec) registry)))\n(define (read name) (cdr (assq name registry)))\n(define! 'coin '(kind coin points 10))\n(equal? (read 'coin) '(kind coin points 10))" :tags (eng program))
      (:code "(define (coherent? name spec) (define registry '()) (define (d! n s) (set! registry (cons (cons n s) registry))) (define (r n) (cdr (assq n registry))) (d! name spec) (equal? (r name) spec))\n(coherent? 'x '(kind item))" :tags (math program))
      (:code "(define (roundtrip? name spec) (define r '()) (define (d! n s) (set! r (cons (cons n s) r))) (define (rd n) (cdr (assq n r))) (d! name spec) (equal? (rd name) spec))\n(roundtrip? 'a '(b))" :tags (cs program)))
     :claim "Define-then-spawn coherent: after define(name, spec), spawn(name) reads spec."
     :invariant "∀ name spec. after(define(name, spec)) ⇒ read(name) = spec"
     :meta "Pattern: store coherence — write ∘ read = id.")
    (:eng "Designer trusts what they typed is what spawns." :math "read(k, write(k, v, s)) = v." :cs "Fundamental invariant of any k-v store."))
  :row-5-emergence (
    (:programs (
      (:code "(define (define-difficulty tier hp dmg) (prefab/define (string->symbol (string-append \"enemy-\" (symbol->string tier))) (list 'kind 'enemy 'hp hp 'damage dmg)))\n(for-each (lambda (r) (define-difficulty (car r) (cadr r) (caddr r))) (list (list 'easy 3 1) (list 'normal 5 2) (list 'hard 10 4)))" :tags (eng composition))
      (:code "(define (fold-registry rows) (for-each (lambda (r) (prefab/define (car r) (cdr r))) rows))\n(fold-registry (list (cons 'a '(kind item)) (cons 'b '(kind prop))))" :tags (math composition))
      (:code "(define (schema-loader schema) (for-each (lambda (row) (prefab/define (car row) (cdr row))) schema) 'loaded)\n(schema-loader (list (cons 'x '(kind item))))" :tags (cs composition)))
     :base "prefab/define registers a template under a name."
     :emergent "Compositions: eng difficulty-tier compiler, math fold-into-registry, cs schema loader."
     :meta "Family: compile / register-many.")
    (:eng "Compile-step once at load; snapshot-shaped." :math "Fold Schema × () → Registry." :cs "Code-generation / schema-loader pattern."))
)

(verb :name "prefab/spawn" :std "Motoi" :library "prefab" :tier "core" :kind "state-change" :signature "(prefab/spawn name x y) -> id"
  :summary "Instantiate one prefab at (x, y); returns the fresh entity ID."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(prefab/define 'coin '(kind coin))\n(prefab/spawn 'coin 50 50)" :note "Register then instantiate.")
    (:dialect "motoi" :tier "intermediate" :code "(prefab/define 'enemy '(kind enemy hp 5))\n(map (lambda (i) (prefab/spawn 'enemy (* i 20) 30)) (iota 5))" :note "Spawn five along an x-strip.")
    (:dialect "motoi" :tier "expert"       :code "(define (spawn-wave positions difficulty) (map (lambda (p) (let ((id (prefab/spawn (if (> difficulty 2) 'enemy-hard 'enemy-soft) (car p) (cadr p)))) (entity/set! id 'difficulty difficulty) id)) positions))\n(prefab/define 'enemy-hard '(kind enemy hp 10))\n(prefab/define 'enemy-soft '(kind enemy hp 3))\n(spawn-wave (list (list 10 20) (list 50 30)) 3)" :note "Difficulty-branched spawn with per-instance customization."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(prefab/define 'goblin '(kind enemy hp 5))\n(map (lambda (p) (prefab/spawn 'goblin (car p) (cadr p))) (list (list 10 20) (list 30 20) (list 50 20)))" :tags (eng program))
      (:code "(define (place-many prefab positions) (map (lambda (p) (prefab/spawn prefab (car p) (cadr p))) positions))\n(place-many 'goblin (list (list 0 0) (list 1 0)))" :tags (math program))
      (:code "(define (safe-spawn prefab x y) (if (and (symbol? prefab) (number? x) (number? y)) (prefab/spawn prefab x y) (error 'bad-args)))\n(safe-spawn 'goblin 0 0)" :tags (cs program)))
     :problem "Wave of 5 goblins at scripted spots — inline copy-paste is a bug farm."
     :explanation "eng: template + placement data. math: total function Name × ℤ² → EntityId. cs: type-guarded call."
     :meta "Reach for prefab/spawn and NOT prefab/define: define registers only; spawn is the instantiation primitive.")
    (:eng "The returned ID is the handle for post-spawn config." :math "Total on registered subset of names." :cs "Named factory with unique-ID return."))
  :row-3-dimension (
    (:setup "Instantiate registered template into substrate; return fresh handle."
     :rungs (
       (:domain "engineering"  :code "(define (injective? n) (define c 0) (define (mk) (set! c (+ c 1)) c) (equal? n (length (delete-duplicates (map (lambda (i) (mk)) (iota n))))))\n(injective? 5)")
       (:domain "mathematics"  :code "(define (fresh-per-call?) (define c 0) (define (mk) (set! c (+ c 1)) c) (not (= (mk) (mk))))\n(fresh-per-call?)")
       (:domain "cs / dispatch" :code "(define counter 0)\n(define (id) (set! counter (+ counter 1)) counter)\n(define a (id))\n(define b (id))\n(and (not (= a b)) (< a b))"))
     :explanation "Direct, canonicalized, parsed dispatch."
     :meta "Apply template, get handle — substrate-independent constructor.")
    (:eng "Losing the handle leaks the instance until GC/despawn." :math "Template × Substrate → Substrate × Handle." :cs "Handle-based ownership — every allocator that returns a pointer."))
  :row-4-proof (
    (:programs (
      (:code "(define counter 0)\n(define (id) (set! counter (+ counter 1)) counter)\n(define a (id))\n(define b (id))\n(and (not (= a b)) (< a b))" :tags (eng program))
      (:code "(define (injective? n) (define c 0) (define (mk) (set! c (+ c 1)) c) (equal? n (length (delete-duplicates (map (lambda (i) (mk)) (iota n))))))\n(injective? 5)" :tags (math program))
      (:code "(define (fresh-per-call?) (define c 0) (define (mk) (set! c (+ c 1)) c) (not (= (mk) (mk))))\n(fresh-per-call?)" :tags (cs program)))
     :claim "Spawn returns a fresh ID: two spawns with identical args return distinct IDs."
     :invariant "∀ name x y. id₁ = spawn(name,x,y); id₂ = spawn(name,x,y) ⇒ id₁ ≠ id₂"
     :meta "Pattern: fresh-name generation — same shape as gensym, UUID minter, SQL SEQUENCE.")
    (:eng "IDs safe as dict keys, log identifiers, cross-refs — substrate guarantees uniqueness." :math "Injective total function ℕ → EntityId." :cs "Monotone counter / gensym pattern."))
  :row-5-emergence (
    (:programs (
      (:code "(define (spawn-formation prefab origin count spacing) (map (lambda (i) (let ((id (prefab/spawn prefab (+ (car origin) (* i spacing)) (cadr origin)))) id)) (iota count)))\n(prefab/define 'grunt '(kind enemy hp 3))\n(spawn-formation 'grunt (list 20 30) 5 15)" :tags (eng composition))
      (:code "(define (grid-spawn prefab rows cols spacing) (apply append (map (lambda (r) (map (lambda (c) (prefab/spawn prefab (* c spacing) (* r spacing))) (iota cols))) (iota rows))))\n(grid-spawn 'tile 2 2 10)" :tags (math composition))
      (:code "(define (batch-tag prefab n tag) (map (lambda (i) (let ((id (prefab/spawn prefab i 0))) (entity/tag! id tag) id)) (iota n)))\n(batch-tag 'grunt 3 'wave-a)" :tags (cs composition)))
     :base "prefab/spawn instantiates one entity from a template."
     :emergent "Compositions: eng formation, math 2D grid, cs batch-tag-then-mass-config."
     :meta "Family: batch-instantiate-with-label.")
    (:eng "ID list is caller's inventory of the batch." :math "Fold over position schedule; common attribute added by body." :cs "Deploy-with-label — same shape as Kubernetes replicasets."))
)
