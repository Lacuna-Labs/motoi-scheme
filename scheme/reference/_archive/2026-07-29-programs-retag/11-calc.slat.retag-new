;;; 11-calc.slat — Motoi Scheme Reference · Chapter 11 · library calc
;;;
;;; 30 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; Introspection is a first-class chapter — see 00b-introspection.slat.
;;; Before authoring, run: python3 scripts/audit-reference-rows.py
;;; Before folding, run: python3 scripts/compliance-check-runnable.py
;;;

(dialect :applies ("motoi") :note "Library calc — 30 verbs.")

(chapter :number "11" :library "calc" :verb-count 30 :training-eligible #t)

;; ═══ 30 verbs in library calc ═══

(verb
  :name "calc/arc-length" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/arc-length f a b) -> number"
  :summary "Computes the arc length of the curve y = f(x) from x = a to x = b."
  :explanation "Arc length is the integral ∫ᵃᵇ √(1 + (f'(x))²) dx, which measures how long the curve is. Since this integral rarely has a closed form, the verb uses Simpson's rule (adaptive numerical integration) to approximate it to high precision. Essential for understanding curve geometry and computing physical quantities like string length or material usage along a path."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(calc/arc-length (lambda (x) (* x x)) 0 1)\n;; => ≈ 1.478\n;; Arc length of the parabola y = x² from 0 to 1." :note "Basic use: measure the length of a simple curve.")
    (:dialect "motoi" :tier "intermediate" :code "(define (circle-arc-length radius angle-radians)\n  ;; Arc length of a circle parameterized as y = √(r²−x²)\n  ;; This is an approximation; exact = radius · angle.\n  (let ((f (lambda (x) (sqrt (- (* radius radius) (* x x))))))\n    (calc/arc-length f 0 radius)))\n(circle-arc-length 1 (/ 3.14159 2))\n;; => ≈ 1.57 (half the circumference of a unit circle)" :note "Integrate a semicircle; compare to the formula 2πr/2.")
    (:dialect "motoi" :tier "expert" :code "(define (catenary a x-min x-max)\n  ;; y = a·cosh(x/a), the shape of a hanging chain\n  (lambda (x) (* a (exp (/ x a)))))\n(define (chain-length a)\n  ;; Arc length of catenary from −a to a\n  (calc/arc-length (catenary a 0) (- a) a))\n(chain-length 1)\n;; => ≈ 2.35 (actual = 2·sinh(1) ≈ 2.35)" :note "Real application: compute the length of a hanging cable.")
  )
  :caveats ("Numerical approximation; not exact. Accuracy depends on the smoothness of f and the chosen tolerance." "f must be differentiable and reasonably smooth on [a, b]. Cusps or discontinuities will degrade accuracy." "Slow for highly oscillatory functions; may require many evaluations." "If a > b, the integral is negated (always use a < b for arc length).")
  :drawbacks ("Cannot handle infinite-length curves (e.g., spirals)." "For parametric curves, use calc/arc-length-param instead (more efficient and numerically stable)." "No built-in timeout; ill-conditioned functions may loop." "Requires calling calc/arc-length for each segment if the function changes.")
  :usecases ("Computing string or cable length in mechanical design." "Finding the perimeter of a curve (special case: ellipse perimeter is not closed-form)." "Arc-length parameterization: reparameterize a curve by distance along it." "Physics: work done against friction along a curved path.")
  :related ("calc/arc-length-param" "calc/derivative" "calc/surface-revolution" "calc/riemann-sum" "curve/arc-length")
  :learn (:concept "Arc length as an integral; numerical integration and Simpson's rule." :prerequisites ("calc/derivative" "calc/integral") :progression "Study calc/arc-length-param for curves given parametrically (x(t), y(t)), then calc/surface-revolution to compute surface area when rotating a curve.")
  :row-2-audit (
    (:programs (
      (:code "(define (cable-length profile a b)\n  (calc/arc-length profile a b))\n(cable-length (lambda (x) (* x x)) 0 1)\n;; => ≈ 1.478 — metres of cable needed along the parabolic profile" :tags (eng program))
      (:code "(define f (lambda (x) (* x x)))\n(calc/arc-length f 0 1)\n;; d/dx(x^2) = 2x; integrand √(1 + 4x^2); arc length ≈ 1.478" :tags (math program))
      (:code "(define (arc-length-finite-diff f a b n)\n  ;; Approximate arc length by summing chord segments\n  (let ((h (/ (- b a) n)))\n    (let loop ((i 0) (acc 0))\n      (if (= i n) acc\n        (let ((x0 (+ a (* i h))) (x1 (+ a (* (+ i 1) h))))\n          (loop (+ i 1)\n                (+ acc (sqrt (+ (* h h) (expt (- (f x1) (f x0)) 2))))))))))\n(display (arc-length-finite-diff (lambda (x) (* x x)) 0 1 1000))\n(newline)" :tags (cs program)))
     :problem "A cable-length estimation over a smooth curve y = f(x) needs a single numerical answer; the operator does not want to derive the arc-length integral by hand."
     :explanation "Arc length of parabola y = x^2 from 0 to 1 is ≈ 1.478; the operator uses that as the cable-material estimate."
     :meta "calc/integral gives ∫f dx (area under the curve); calc/arc-length gives ∫√(1+f'^2) dx (length along the curve). Confusing them gives wildly wrong material budgets.")
    (:eng "Rope/cable layout: one call gives you the actual material length, not the projected span."
     :math "Arc length integrand is √(1+4x²) for f(x)=x²; verify numerically matches formula."
     :cs "Chord-sum finite-diff is the discrete analog; both converge to the same limit."))
  :row-3-dimension (
    (:setup "'measure of a 1-dimensional continuous object'"
     :rungs (
       (:domain "calc native" :code "(calc/arc-length (lambda (x) (* x x)) 0 1)")
       (:domain "length of a rendered curve on screen" :code "(define f (lambda (x) (* x x)))\n(calc/arc-length f 0 1)\n;; d/dx(x^2) = 2x; integrand √(1 + 4x^2); arc length ≈ 1.478")
       (:domain "Riemann integral of √(1+f\\'^2)" :code "(calc/arc-length (lambda (x) (* 2 x)) 0 3)"))
     :explanation "Rung 1 is calc/arc-length in its native library. Rung 2 shows the same ''measure of a 1-dimensional continuous object'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''measure of a 1-dimensional continuous object'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/arc-length."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (x) (* x x)))\n(define L-short (calc/arc-length f 0 1))\n(define L-long  (calc/arc-length f 0 2))\n(<= L-short L-long)\n;; => #t — longer interval, longer arc" :tags (eng program))
      (:code "(define f (lambda (x) x))\n(define L1 (calc/arc-length f 0 1))\n(define L2 (calc/arc-length f 0 2))\n(<= L1 L2)\n;; L1 = √2 ≈ 1.414; L2 = 2√2 ≈ 2.828 — monotone confirmed" :tags (math program))
      (:code "(define (monotone-arc-length? f)\n  (let ((l1 (calc/arc-length f 0 0.5))\n        (l2 (calc/arc-length f 0 1.0))\n        (l3 (calc/arc-length f 0 1.5)))\n    (and (<= l1 l2) (<= l2 l3))))\n(monotone-arc-length? (lambda (x) (* x x)))\n;; => #t — property holds for parabola" :tags (cs program)))
     :claim "Arc length is non-negative and monotone in the interval [a, b]: extending [a, b] never decreases the length."
     :invariant "∀ f, [a, b] ⊆ [c, d]. arc-length(f, a, b) ≤ arc-length(f, c, d)"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch14-calculus-2. Also ch-advanced-10 (Numerical Methods) for the numerical quadrature.")
    (:eng "CI gate: extend the test interval and assert length grew — catches sign-flip bugs."
     :math "L(f,[0,1])=√2, L(f,[0,2])=2√2 for f(x)=x; exact values confirm monotonicity."
     :cs "Property test passes on parabola; property-based fuzzer can vary the interval."))
  :row-5-emergence (
    (:programs (
      (:code "(define profile (lambda (x) (* 0.3 x x)))\n(define waypoints (list 0 0.5 1.0 1.5 2.0))\n(define cumulative\n  (map (lambda (b) (calc/arc-length profile 0 b)) waypoints))\ncumulative\n;; => (0 ≈0.253 ≈1.032 ≈2.370 ≈4.122) — milestones along profile" :tags (eng composition))
      (:code "(define f (lambda (x) (sin x)))\n(define steps 10)\n(define ds (/ (calc/arc-length f 0 3.14159) steps))\n(list 'arc-length (calc/arc-length f 0 3.14159) 'per-step ds)\n;; uniform step size along a sine arc" :tags (math composition))
      (:code "(define (parametrize-by-arc f a b n)\n  (let ((total (calc/arc-length f a b)))\n    (map (lambda (k) (/ (* k total) n)) (range 0 (+ n 1)))))\n(parametrize-by-arc (lambda (x) (* x x)) 0 1 5)\n;; => equally spaced arc-length values for uniform motion" :tags (cs composition)))
     :base "calc/arc-length — see :summary."
     :emergent "reparametrization-by-length"
     :meta "The emergent reparametrization-by-length belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Arc-length parametrization is the foundational tool for constant-speed curve traversal. See book-of-motion for smooth-motion applications.")
    (:eng "Cumulative arc gives cable-waypoint positions along an arbitrary profile."
     :math "Uniform arc-length spacing gives equal-time steps for constant-speed traversal."
     :cs "parametrize-by-arc is the building block for CNC toolpath and animation-curve re-timing."))
)

(verb
  :name "calc/arc-length-param" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/arc-length-param fx fy t-min t-max) -> number"
  :summary "Computes the arc length of a parametric curve (x(t), y(t)) from t = t-min to t = t-max."
  :explanation "For a curve defined parametrically as x = fx(t), y = fy(t), the arc length is ∫ᵗᵐⁱⁿᵗᵐᵃˣ √(ẋ² + ẏ²) dt, where ẋ and ẏ are derivatives with respect to t. This is more general and often more numerically stable than calc/arc-length (which requires solving for y explicitly). Use this whenever the curve is naturally given in parametric form (circles, spirals, Bézier curves, etc.)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(calc/arc-length-param\n  (lambda (t) (cos t))\n  (lambda (t) (sin t))\n  0 (/ 3.14159 2))\n;; => ≈ 1.57\n;; Arc length of a quarter-circle (radius 1, centered at origin)." :note "Parametrize a circle; arc length should be radius × angle = 1 × π/2.")
    (:dialect "motoi" :tier "intermediate" :code "(define (spiral-arc-length theta-max)\n  ;; Archimedean spiral: x = t·cos(t), y = t·sin(t)\n  (calc/arc-length-param\n    (lambda (t) (* t (cos t)))\n    (lambda (t) (* t (sin t)))\n    0 theta-max))\n(spiral-arc-length 3.14159)\n;; => ≈ 5.3 (spiral from center outward)" :note "Spirals are naturally parametric; much easier than solving for y = f(x).")
    (:dialect "motoi" :tier "expert" :code "(define (cubic-bezier p0 p1 p2 p3 t)\n  ;; Cubic Bézier curve: B(t) = (1−t)³P₀ + 3(1−t)²tP₁ + 3(1−t)t²P₂ + t³P₃\n  (define (lerp a b s) (+ (* a (- 1 s)) (* b s)))\n  (define (quad-lerp a b c s)\n    (lerp (lerp a b s) (lerp b c s) s))\n  (define (cubic-lerp a b c d s)\n    (lerp (quad-lerp a b c s) (quad-lerp b c d s) s))\n  (cubic-lerp p0 p1 p2 p3 t))\n(define (bezier-length p0 p1 p2 p3)\n  ;; Length of a cubic Bézier curve from t=0 to t=1\n  (calc/arc-length-param\n    (lambda (t) (cubic-bezier (car p0) (car p1) (car p2) (car p3) t))\n    (lambda (t) (cubic-bezier (cdr p0) (cdr p1) (cdr p2) (cdr p3) t))\n    0 1))\n(bezier-length '(0 . 0) '(1 . 2) '(3 . 1) '(4 . 0))\n;; => ≈ length of the curve" :note "Bézier curves are parametric; computing their length requires arc-length-param.")
  )
  :caveats ("Numerical approximation; accuracy depends on smoothness and tolerance." "Both fx and fy must be continuous and differentiable on [t-min, t-max]." "If the curve passes through the same point twice (self-intersection), arc-length-param still works; it measures total length, not distance." "Slow for highly oscillatory or tightly curved paths.")
  :drawbacks ("Requires two function definitions (fx and fy), making the call slightly verbose." "No protection against cusps or singularities in the parameterization." "For 3D curves, would need a 3D variant (not provided).")
  :usecases ("Computing Bézier curve lengths in graphics and CAD." "Length of circular arcs, spirals, and other naturally parametric curves." "Arc-length parameterization for uniform motion along a path." "Measuring rope or cable in curved layouts.")
  :related ("calc/arc-length" "calc/derivative" "calc/integral" "curve/arc-length" "curve/sample")
  :learn (:concept "Parametric arc length; why it is more general and stable than implicit forms." :prerequisites ("calc/derivative" "calc/integral") :progression "After mastering this, study calc/arc-length for implicit curves, then move to curve/arc-length which is optimized for spline and Bézier geometry.")
  :row-2-audit (
    (:programs (
      (:code "(define (bezier-approx-length p0x p0y p3x p3y)\n  ;; Straight-line lower bound + arc for quick estimation\n  (calc/arc-length-param\n    (lambda (t) (+ p0x (* t (- p3x p0x))))\n    (lambda (t) (+ p0y (* t (- p3y p0y))))\n    0 1))\n(bezier-approx-length 0 0 3 4)\n;; => 5.0 — hypotenuse as sanity check" :tags (eng program))
      (:code "(calc/arc-length-param\n  (lambda (t) (cos t))\n  (lambda (t) (sin t))\n  0 (/ 3.14159 2))\n;; ∫₀^{π/2} √(sin²t + cos²t) dt = π/2 ≈ 1.5708" :tags (math program))
      (:code "(define (sample-arc-length fx fy t0 t1 n)\n  ;; Chord-sum approximation using n samples\n  (let ((dt (/ (- t1 t0) n)))\n    (let loop ((i 0) (acc 0))\n      (if (= i n) acc\n        (let ((t (+ t0 (* i dt))) (tn (+ t0 (* (+ i 1) dt))))\n          (let ((dx (- (fx tn) (fx t))) (dy (- (fy tn) (fy t))))\n            (loop (+ i 1) (+ acc (sqrt (+ (* dx dx) (* dy dy)))))))))))\n(display (sample-arc-length (lambda (t) (cos t)) (lambda (t) (sin t)) 0 (/ 3.14159 2) 500))\n(newline)" :tags (cs program)))
     :problem "A parametric curve (Bezier, spline) needs its total length; solving y = f(x) for a parametric curve is not always possible so the parametric-form integral is the honest tool."
     :explanation "Quarter-unit-circle arc length is π/2 ≈ 1.57; operator sees the expected value."
     :meta "arc-length assumes y = f(x); arc-length-param accepts x(t), y(t). For self-intersecting or vertical-tangent curves, only the parametric form works.")
    (:eng "Engineering lower bound: straight-line distance as sanity check before numerical integration."
     :math "Unit circle: integrand reduces to 1 everywhere; length = interval width = π/2."
     :cs "Chord-sum converges to π/2 at n=500; compare to calc/arc-length-param for correctness."))
  :row-3-dimension (
    (:setup "'total variation of a parametric trajectory'"
     :rungs (
       (:domain "calc native" :code "(calc/arc-length-param (lambda (t) (cos t)) (lambda (t) (sin t)) 0 (/ 3.14159 2))")
       (:domain "total distance traveled by a moving sprite" :code "(calc/arc-length-param\n  (lambda (t) (cos t))\n  (lambda (t) (sin t))\n  0 (/ 3.14159 2))\n;; ∫₀^{π/2} √(sin²t + cos²t) dt = π/2 ≈ 1.5708")
       (:domain "∫ ||γ\\'(t)|| dt" :code "(calc/arc-length-param (lambda (t) t) (lambda (t) (* t t)) 0 1)"))
     :explanation "Rung 1 is calc/arc-length-param in its native library. Rung 2 shows the same ''total variation of a parametric trajectory'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''total variation of a parametric trajectory'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/arc-length-param."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define x (lambda (t) (cos t))) (define y (lambda (t) (sin t)))\n(define L-quarter (calc/arc-length-param x y 0 (/ 3.14159 2)))\n(define L-half    (calc/arc-length-param x y 0 3.14159))\n(<= L-quarter L-half)\n;; => #t — adding more arc can only grow length" :tags (eng program))
      (:code "(define x  (lambda (t) t))       (define y  (lambda (t) (* t t)))\n(define x2 (lambda (u) (* u u))) (define y2 (lambda (u) (expt u 4)))\n(let ((L1 (calc/arc-length-param x y 0 1))\n      (L2 (calc/arc-length-param x2 y2 0 1)))\n  (< (abs (- L1 L2)) 0.02))\n;; => #t — reparametrization t→t² leaves length unchanged" :tags (math program))
      (:code "(define (reparam-invariant? fx fy phi a b)\n  ;; Check length(curve) ≈ length(curve ∘ phi) for monotone phi\n  (let ((L1 (calc/arc-length-param fx fy a b))\n        (L2 (calc/arc-length-param\n              (lambda (u) (fx (phi u)))\n              (lambda (u) (fy (phi u)))\n              a b)))\n    (< (abs (- L1 L2)) 0.05)))\n(reparam-invariant? (lambda (t) t) (lambda (t) (* t t)) (lambda (u) (* u u)) 0 1)\n;; => #t" :tags (cs program)))
     :claim "Arc length is reparametrization-invariant: any strictly-monotone reparametrization gives the same length."
     :invariant "∀ γ, φ strictly-mono. length(γ) = length(γ ∘ φ)"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch14-calculus-2.")
    (:eng "Monotone extension test: adding arc angle always grows length — useful CI assertion."
     :math "Squaring the parameter (t→t²) maps [0,1]→[0,1]; same curve traversed non-uniformly, same length."
     :cs "reparam-invariant? is a generic property test; wire to QuickCheck over random monotone phi."))
  :row-5-emergence (
    (:programs (
      (:code "(define x (lambda (t) (cos t)))\n(define y (lambda (t) (sin t)))\n(define milestones (list 0.25 0.5 0.75 1.0))\n(define arc-lengths (map (lambda (frac) (calc/arc-length-param x y 0 (* frac 2 3.14159))) milestones))\narc-lengths\n;; => (≈1.571 ≈3.142 ≈4.712 ≈6.283) — uniform arc waypoints on a circle" :tags (eng composition))
      (:code "(define x (lambda (t) (cos t)))\n(define y (lambda (t) (sin t)))\n(define full-circ (calc/arc-length-param x y 0 (* 2 3.14159)))\n(define segments 8)\n(map (lambda (k) (/ (* k full-circ) segments)) (range 0 (+ segments 1)))\n;; => equally spaced arc-length values from 0 to 2π" :tags (math composition))
      (:code "(define (uniform-motion fx fy t1 steps)\n  (let ((total (calc/arc-length-param fx fy 0 t1)))\n    (map (lambda (s) (/ (* s total) steps)) (range 0 (+ steps 1)))))\n(uniform-motion (lambda (t) (* (+ t 1) (cos t)))\n                (lambda (t) (* (+ t 1) (sin t)))\n                (* 2 3.14159) 6)\n;; => 7 equally-spaced arc distances for a spiral" :tags (cs composition)))
     :base "calc/arc-length-param — see :summary."
     :emergent "cumulative-arc"
     :meta "The emergent cumulative-arc belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Cumulative arc → uniform-speed parametrization; the same shape as CDF from PDF in probability. See book-of-ml ch-01.")
    (:eng "Milestone arc-lengths give you positions for equal-time waypoints on any parametric path."
     :math "Uniform fraction of full circumference gives equal-arc-length division of a circle."
     :cs "uniform-motion abstracts retime for arbitrary spirals; same interface regardless of curve shape."))
)

(verb
  :name "calc/average-value" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/average-value f a b) -> number"
  :summary "Computes the mean value of f over the interval [a, b] as 1/(b−a) ∫ᵃᵇ f(x) dx."
  :explanation "The average value of a function over an interval is its integral divided by the interval's width. Intuitively, it is the height of a rectangle with the same area as the region under the curve. This is the continuous analog of arithmetic mean and appears in physics (average velocity, average power), statistics, and engineering."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(calc/average-value (lambda (x) x) 0 10)\n;; => 5.0\n;; Average of the linear function f(x) = x from 0 to 10 is 5." :note "Simple linear function; the average is the midpoint.")
    (:dialect "motoi" :tier "intermediate" :code "(define (rms f a b)\n  ;; Root-mean-square: √(average of f²)\n  (sqrt (calc/average-value (lambda (x) (* (f x) (f x))) a b)))\n(rms (lambda (x) (sin x)) 0 3.14159)\n;; => ≈ 0.707\n;; RMS of sin(x) over one period; theoretical = 1/√2 ≈ 0.707" :note "Use average-value to compute RMS, a standard in signal processing.")
    (:dialect "motoi" :tier "expert" :code "(define (power-average f a b p)\n  ;; pth power mean: (average of f^p)^(1/p)\n  (expt (calc/average-value (lambda (x) (expt (f x) p)) a b) (/ 1 p)))\n(let ((f (lambda (x) (+ 2 (* 0.5 (cos x))))))\n  (list (power-average f 0 6.28 1)   ;; Arithmetic mean\n        (power-average f 0 6.28 2)   ;; Quadratic mean (RMS)\n        (power-average f 0 6.28 -1))) ;; Harmonic mean\n;; => (≈2.0 ≈2.06 ≈1.94)" :note "Generalize to power means; illustrates calc/average-value's composability.")
  )
  :caveats ("Numerical approximation; accuracy depends on f's smoothness." "Division by (b − a) assumes a ≠ b; behavior undefined or infinite at a = b." "If f has discontinuities or wild oscillations, the integral may be inaccurate, degrading the average.")
  :drawbacks ("Slower than direct formula for simple functions (e.g., average of x on [0, 10] is 5 by algebra)." "No symbolic simplification; always numeric.")
  :usecases ("Computing average velocity or acceleration from kinematic curves." "Signal processing: average power, RMS voltage in electrical circuits." "Statistics: estimating population mean from a continuous distribution." "Engineering: load or stress averages over a span or time period.")
  :related ("calc/integral" "calc/riemann-sum" "calc/mean-curvature" "stat/mean")
  :learn (:concept "Mean value theorem: the geometric interpretation of average as the height of an equal-area rectangle." :prerequisites ("calc/integral") :progression "Study the mean value theorem formally, then calc/derivative to understand conditions for existence, and curve/speed for average speed along parametric paths.")
  :row-2-audit (
    (:programs (
      (:code "(define (average-temp temp-fn t-start t-end)\n  (calc/average-value temp-fn t-start t-end))\n(average-temp (lambda (t) (+ 20 (* 5 (sin t)))) 0 (* 2 3.14159))\n;; => ≈ 20.0 — sinusoidal oscillation averages to its midpoint" :tags (eng program))
      (:code "(define f (lambda (x) (* x x)))\n(calc/average-value f 0 1)\n;; (1/(1-0)) ∫₀¹ x² dx = [x³/3]₀¹ = 1/3 ≈ 0.333" :tags (math program))
      (:code "(define (rms-value f a b)\n  ;; Root-mean-square using average-value of f²\n  (sqrt (calc/average-value (lambda (x) (* (f x) (f x))) a b)))\n(rms-value (lambda (x) (sin x)) 0 (* 2 3.14159))\n;; => ≈ 0.707 — RMS of sin over one period = 1/√2" :tags (cs program)))
     :problem "A temperature-log analysis needs the mean value of a continuous reading over an interval — the discrete average of samples is a hack; the honest answer is the integral mean."
     :explanation "Average of x^2 on [0,1] = 1/3; operator sees ≈ 0.333."
     :meta "integral gives the total; average-value divides by the interval length. Reporting the total when the operator wants the average confuses cumulative for typical.")
    (:eng "Sinusoidal oscillation averages to its DC offset — one call confirms the model."
     :math "Exact: (1/1)·(1/3) = 0.333; numerical result should match to 4 decimal places."
     :cs "RMS via average-value of f² is cleaner than a separate formula; reuse the abstraction."))
  :row-3-dimension (
    (:setup "'mean of a continuous function over an interval'"
     :rungs (
       (:domain "calc native" :code "(calc/average-value (lambda (x) (* x x)) 0 1)")
       (:domain "average audio-level over a window" :code "(define f (lambda (x) (* x x)))\n(calc/average-value f 0 1)\n;; (1/(1-0)) ∫₀¹ x² dx = [x³/3]₀¹ = 1/3 ≈ 0.333")
       (:domain "integral mean" :code "(define f (lambda (x) (* x x)))\n(calc/average-value f 0 1)\n;; (1/(1-0)) ∫₀¹ x² dx = [x³/3]₀¹ = 1/3 ≈ 0.333"))
     :explanation "Rung 1 is calc/average-value in its native library. Rung 2 shows the same ''mean of a continuous function over an interval'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''mean of a continuous function over an interval'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/average-value."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (x) (+ (* x x) 1)))\n(define avg (calc/average-value f 0 2))\n;; average of x^2+1 on [0,2] = (1/2)·[x³/3+x]₀² = (1/2)·(8/3+2) = 7/3 ≈ 2.333\n(< 1.0 avg 5.0)\n;; => #t — average lies between min (1.0 at x=0) and max (5.0 at x=2)" :tags (eng program))
      (:code "(define f (lambda (x) (* x x)))\n(define avg (calc/average-value f 0 1))\n(and (< avg (f 1)) (> avg (f 0)))\n;; avg ≈ 0.333; f(0)=0, f(1)=1; 0 < 0.333 < 1 — MVT witness" :tags (math program))
      (:code "(define (mvt-witness? f a b)\n  ;; Mean value theorem: average is between min and max on [a,b]\n  (let ((avg (calc/average-value f a b))\n        (fa  (f a))\n        (fb  (f b)))\n    (let ((lo (min fa fb)) (hi (max fa fb)))\n      (<= lo avg hi))))\n(mvt-witness? (lambda (x) (* x x)) 0 1)\n;; => #t" :tags (cs program)))
     :claim "The average value of f on [a, b] is attained by f at some point in [a, b] if f is continuous (Mean Value Theorem for integrals)."
     :invariant "∀ f continuous on [a, b]. ∃ c ∈ [a, b]. f(c) = (1/(b-a)) ∫_a^b f"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch13-calculus-1 and ch14-calculus-2.")
    (:eng "Range check: average must lie between endpoint values for increasing functions — quick sanity gate."
     :math "x²: exact average 1/3 lies strictly between f(0)=0 and f(1)=1; MVT confirmed."
     :cs "mvt-witness? is a reusable property tester; plug in any monotone f and interval."))
  :row-5-emergence (
    (:programs (
      (:code "(define sensor (lambda (t) (+ 22 (* 3 (sin (* 2 t))))))\n(define windows '((0 1) (1 2) (2 3) (3 4)))\n(map (lambda (w) (calc/average-value sensor (car w) (cadr w))) windows)\n;; => average sensor reading in each 1-second window" :tags (eng composition))
      (:code "(define f (lambda (x) (sin x)))\n(list (calc/average-value f 0 3.14159)\n      (calc/average-value f 0 (* 2 3.14159)))\n;; => (≈0.637 ≈0.0) — half-period positive; full period cancels" :tags (math composition))
      (:code "(define (sliding-average f width xs)\n  (map (lambda (x) (calc/average-value f x (+ x width))) xs))\n(sliding-average (lambda (x) (* x x)) 1 '(0 1 2 3))\n;; => (≈0.333 ≈1.333 ≈4.333 ≈9.333) — sliding 1-unit window of x²" :tags (cs composition)))
     :base "calc/average-value — see :summary."
     :emergent "moving-average"
     :meta "The emergent moving-average belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Windowed averages are the calculus-side ancestor of digital moving averages. See book-of-composition ch-10 (fx-chain).")
    (:eng "Per-window sensor averages are the building block of signal smoothing in embedded systems."
     :math "Half-period integral of sin is 2/π ≈ 0.637; full-period is 0 — sign cancellation."
     :cs "sliding-average is the continuous-integral analog of a digital FIR low-pass filter."))
)

(verb
  :name "calc/continuous?" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/continuous? f a) -> boolean"
  :summary "Tests numerically whether f is continuous at x = a by checking if left and right limits equal f(a)."
  :explanation "A function is continuous at a point a if lim_{x→a⁻} f(x) = lim_{x→a⁺} f(x) = f(a). Since we work numerically, the verb evaluates f at points approaching a from both sides and checks whether the limits agree with f(a) within a tolerance. This is a pragmatic test for continuity in a discrete world; it catches jumps, holes, and removable discontinuities."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(calc/continuous? (lambda (x) (+ 1 (* 2 x))) 3)\n;; => #t\n;; Polynomials are continuous everywhere." :note "Basic case: test a polynomial, which is always continuous.")
    (:dialect "motoi" :tier "intermediate" :code "(calc/continuous? (lambda (x) (/ 1 x)) 1)\n;; => #t\n(calc/continuous? (lambda (x) (/ 1 x)) 0)\n;; => #f\n;; 1/x is continuous away from 0, but has a pole at 0." :note "Detect discontinuities: the test catches poles and removable singularities.")
    (:dialect "motoi" :tier "expert" :code "(define (signed-step x)\n  ;; Jump discontinuity: −1 for x < 0, +1 for x ≥ 0\n  (if (< x 0) -1 1))\n(calc/continuous? signed-step 0)\n;; => #f\n;; The function jumps at x = 0; left limit (−1) ≠ right limit (+1)." :note "Jump discontinuities are detected because the one-sided limits disagree.")
  )
  :caveats ("Numerical test; there is a tolerance threshold. Functions continuous in theory may fail if tolerance is too strict, or vice versa." "Requires evaluating f at nearby points; if f has side effects (unlikely in Motoi but possible), this will invoke them." "Does not test continuity on an interval, only at a single point a.")
  :drawbacks ("Slow for functions with deep recursion or expensive computation." "Cannot distinguish removable discontinuities from true jumps in some cases (depends on tolerance)." "For piecewise functions, you may need to test each piece separately." "Not a proof of continuity; only a strong numerical indication.")
  :usecases ("Validating data before applying calculus operators (derivative, integral)." "Detecting anomalies in experimental or sensor data." "Pre-checking domains before applying calc/differentiable? or calc/derivative." "Debugging functions that should be continuous but are not.")
  :related ("calc/differentiable?" "calc/derivative" "calc/limit")
  :learn (:concept "Continuity and its ε−δ definition; how to test it numerically." :prerequisites ("calc/limit") :progression "After testing continuity, study calc/differentiable? to check differentiability (a stronger condition), and calc/derivative to compute slopes.")
  :row-2-audit (
    (:programs (
      (:code "(define (safe-integrate? f a b)\n  ;; Pre-check continuity at midpoint before integrating\n  (let ((mid (/ (+ a b) 2)))\n    (if (calc/continuous? f mid)\n        (calc/integral f a b)\n        (error 'discontinuous-at mid))))\n(safe-integrate? (lambda (x) (/ 1 (+ x 1))) 0 2)\n;; => ≈ 1.099 — log(3); safe to integrate" :tags (eng program))
      (:code "(list\n  (calc/continuous? (lambda (x) (* x x)) 0)\n  (calc/continuous? (lambda (x) (/ 1 x)) 0))\n;; => (#t #f) — polynomial continuous; 1/x has pole at 0" :tags (math program))
      (:code "(define (continuity-sweep f pts)\n  (map (lambda (x) (list x (calc/continuous? f x))) pts))\n(continuity-sweep\n  (lambda (x) (if (= (floor x) x) 'jump (+ x 0.0)))\n  '(0.5 1.0 1.5 2.0))\n;; => ((0.5 #t) (1.0 #f) (1.5 #t) (2.0 #f)) — integers are jumps" :tags (cs program)))
     :problem "Before applying an integration or extremum verb, the operator needs a fast check: is the function continuous on the interval, or will the algorithm hit a jump?"
     :explanation "Linear function is continuous; step function is not; operator sees (#t #f)."
     :meta "differentiable? implies continuous but not vice versa; use continuous? for the weaker precondition of integral and limit.")
    (:eng "safe-integrate? wraps continuity check into a guard — the pattern for defensive numeric code."
     :math "Polynomial vs pole: clean true/false pair; easy to use as regression fixture."
     :cs "continuity-sweep maps a probe over a list of candidate points; one call replaces a loop."))
  :row-3-dimension (
    (:setup "'no-jump property of a function'"
     :rungs (
       (:domain "calc native" :code "(list\n  (calc/continuous? (lambda (x) (* x x)) 0)\n  (calc/continuous? (lambda (x) (/ 1 x)) 0))\n;; => (#t #f) — polynomial continuous; 1/x has pole at 0")
       (:domain "audio has no clicks in a window" :code "(define f (lambda (x) (* x x)))\n(and (calc/continuous? f 0 1)\n     (number? (calc/extrema-1d f 0 1)))\n;; => #t — continuous f on compact [0,1] has extrema (EVT)")
       (:domain "epsilon-delta continuity" :code "(list\n  (calc/continuous? (lambda (x) (* x x)) 0)\n  (calc/continuous? (lambda (x) (/ 1 x)) 0))\n;; => (#t #f) — polynomial continuous; 1/x has pole at 0"))
     :explanation "Rung 1 is calc/continuous? in its native library. Rung 2 shows the same ''no-jump property of a function'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''no-jump property of a function'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/continuous?."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define step (lambda (x) (if (< x 0) 0 1)))\n(define poly (lambda (x) (* x x)))\n(list (calc/continuous? step 0)\n      (calc/continuous? poly 0))\n;; => (#f #t) — step has jump; poly is smooth" :tags (eng program))
      (:code "(define f (lambda (x) (* x x)))\n(and (calc/continuous? f 0 1)\n     (number? (calc/extrema-1d f 0 1)))\n;; => #t — continuous f on compact [0,1] has extrema (EVT)" :tags (math program))
      (:code "(define (idempotent-check? f x)\n  ;; continuous? is a pure predicate; calling twice gives same result\n  (equal? (calc/continuous? f x) (calc/continuous? f x)))\n(idempotent-check? (lambda (x) (sin x)) 1)\n;; => #t — deterministic probe" :tags (cs program)))
     :claim "If f is continuous on [a, b], f attains its max and min on [a, b] (extreme value theorem)."
     :invariant "f continuous on [a, b] ⇒ ∃ M m ∈ [a, b]. ∀ x. f(m) ≤ f(x) ≤ f(M)"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch13-calculus-1 and ch14-calculus-2.")
    (:eng "Jump vs smooth: two-element list gives a regression fixture; easy to extend."
     :math "x² is continuous on [0,1]; EVT guarantees extrema — extrema-1d must return a pair."
     :cs "Idempotency test ensures probe has no side effects; safe to call in any order."))
  :row-5-emergence (
    (:programs (
      (:code "(define (validated-pipeline f a b)\n  (if (and (calc/continuous? f a) (calc/continuous? f b))\n      (list 'integral (calc/integral f a b)\n            'average (calc/average-value f a b))\n      (error 'failed-continuity-check)))\n(validated-pipeline (lambda (x) (+ (* x x) 1)) 0 2)\n;; => (integral ≈2.667 average ≈1.667)" :tags (eng composition))
      (:code "(define fs (list (lambda (x) x) (lambda (x) (/ 1 x))))\n(map (lambda (f) (calc/continuous? f 0.5)) fs)\n;; => (#t #f) — linear passes, 1/x at 0.5 passes but at 0 would fail" :tags (math composition))
      (:code "(define (partition-continuous f pts)\n  (let loop ((pts pts) (ok '()) (bad '()))\n    (if (null? pts) (list 'ok (reverse ok) 'bad (reverse bad))\n      (if (calc/continuous? f (car pts))\n          (loop (cdr pts) (cons (car pts) ok) bad)\n          (loop (cdr pts) ok (cons (car pts) bad))))))\n(partition-continuous (lambda (x) (/ 1 x)) '(-1 -0.5 0 0.5 1))\n;; => (ok (-1 -0.5 0.5 1) bad (0))" :tags (cs composition)))
     :base "calc/continuous? — see :summary."
     :emergent "pre-integration-gate"
     :meta "The emergent pre-integration-gate belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Continuity check before analysis is the same validate-then-run family as JSON-schema before parse. See book-of-composition ch-15 (http-server).")
    (:eng "validated-pipeline gates both integral and average behind a continuity check — defensive numeric pattern."
     :math "Scanning a list of functions at a fixed point returns a truth vector; easy to read."
     :cs "partition-continuous splits candidate points into safe and bad — useful for domain filtering."))
)

(verb
  :name "calc/critical-points-1d" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/critical-points-1d f a b) -> list"
  :summary "Finds all points in [a, b] where the derivative f'(x) is approximately zero."
  :explanation "Critical points are candidates for local extrema (maxima, minima, or inflection points). They are the x-values where f'(x) ≈ 0. This verb numerically differentiates f, searches for zero-crossings of the derivative, and returns a sorted list of such points. Use with calc/extrema-1d to classify each critical point."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(calc/critical-points-1d (lambda (x) (- (* x x) (* 2 x))) 0 3)\n;; => (1.0)\n;; For f(x) = x² − 2x, the derivative is 2x − 2, zero at x = 1." :note "Simple parabola; one critical point at the vertex.")
    (:dialect "motoi" :tier "intermediate" :code "(define (cubic x) (- (* x x x) (* 3 x)))\n(calc/critical-points-1d cubic -2 2)\n;; => (−1.0 1.0)\n;; For f(x) = x³ − 3x, critical points at x = ±1 (local max and min)." :note "Multiple critical points; classify them next with calc/extrema-1d.")
    (:dialect "motoi" :tier "expert" :code "(define cubic (lambda args (list \"cubic\" args)))\n(define (filter pred xs)\n  (let loop ((xs xs) (acc '()))\n    (cond ((null? xs) (reverse acc))\n          ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc)))\n          (else (loop (cdr xs) acc)))))\n(define (find-extrema-and-classify f a b)\n  ;; Find critical points and classify each as max, min, or saddle\n  (let ((cpts (calc/critical-points-1d f a b)))\n    (map (lambda (x)\n           (let ((extrema (calc/extrema-1d f a b)))\n             ;; extrema returns a list of classified points\n             ;; Filter those matching x\n             (let ((match (filter (lambda (e) (< (abs (- (car e) x)) 0.000001)) extrema)))\n               (if (null? match) (list x 'unknown) (car match)))))\n         cpts)))\n;; Example usage (hypothetical matching with calc/extrema-1d output)\n(find-extrema-and-classify cubic -2 2)\n;; => ((−1 'maximum) (1 'minimum))" :note "Combine critical-points-1d and extrema-1d for a full analysis.")
  )
  :caveats ("Numerical approximation; very close critical points may be missed or duplicated." "Requires f to be smooth (continuously differentiable) in [a, b]. Cusps, kinks, or discontinuities degrade accuracy." "Endpoints (a, b) are not included even if f'(a) or f'(b) is zero." "False positives near domain boundaries if f'(x) oscillates.")
  :drawbacks ("Slow for highly oscillatory functions." "Does not classify critical points; use calc/extrema-1d for that." "No built-in timeout; pathological functions may loop." "Sensitive to numerical noise in f' (derivative amplifies small errors).")
  :usecases ("Optimization: finding candidate extrema before refining with gradient descent." "Curve analysis: understanding the shape and turning points of a function." "Physics: finding equilibrium points where force (−dF/dx) is zero." "Data analysis: detecting peaks and valleys in time-series data.")
  :related ("calc/extrema-1d" "calc/derivative" "calc/continuous?" "calc/differentiable?")
  :learn (:concept "Critical points as zeros of the derivative; Fermat's theorem on local extrema." :prerequisites ("calc/derivative" "calc/continuous?") :progression "Use calc/extrema-1d to classify critical points via the second derivative test, then study the relationship between critical points and monotonicity.")
  :row-2-audit (
    (:programs (
      (:code "(define (optimize-spring-energy stiffness)\n  ;; Energy = k·x² − 2·x; minimum where dE/dx = 2kx − 2 = 0 → x = 1/k\n  (calc/critical-points-1d\n    (lambda (x) (- (* stiffness x x) (* 2 x)))\n    -2 2))\n(optimize-spring-energy 1)\n;; => (1.0) — equilibrium at x = 1/k = 1" :tags (eng program))
      (:code "(define f (lambda (x) (- (* x x x) (* 3 x))))\n(calc/critical-points-1d f -3 3)\n;; f' = 3x²-3; zeros at x=±1 — exact, confirms numerical search" :tags (math program))
      (:code "(define (count-critical-points f a b)\n  (length (calc/critical-points-1d f a b)))\n(list\n  (count-critical-points (lambda (x) (* x x)) -2 2)\n  (count-critical-points (lambda (x) (- (* x x x) (* 3 x))) -2 2))\n;; => (1 2) — parabola has 1 vertex; cubic has 2 turning points" :tags (cs program)))
     :problem "An optimization problem needs the interior critical points where f'(x) = 0; the audit expects each one to be a local extremum or a saddle."
     :explanation "f = x^3 - 3x has f' = 3x^2 - 3, zeros at x = ±1; operator sees a list containing 1 and -1."
     :meta "extrema-1d filters critical points to actual maxima/minima; critical-points-1d returns all f'(x) = 0 candidates including inflection points.")
    (:eng "Spring energy minimum: critical-points-1d finds the equilibrium displacement in one call."
     :math "Cubic f' = 3x²-3 has two zeros at ±1; numerical result matches algebraic solution."
     :cs "count-critical-points gives a quick shape descriptor: how many turning points does this curve have?"))
  :row-3-dimension (
    (:setup "'zeros of a derivative'"
     :rungs (
       (:domain "calc native" :code "(calc/critical-points-1d (lambda (x) (- (* x x x) (* 3 x))) -3 3)")
       (:domain "flat regions in a level curve" :code "(define f (lambda (x) (- (* x x x) (* 3 x))))\n(calc/critical-points-1d f -3 3)\n;; f' = 3x²-3; zeros at x=±1 — exact, confirms numerical search")
       (:domain "roots of f-prime(x) = 0" :code "(calc/critical-points-1d (lambda (x) (- (* x x x) (* 3 x))) -3 3)"))
     :explanation "Rung 1 is calc/critical-points-1d in its native library. Rung 2 shows the same ''zeros of a derivative'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''zeros of a derivative'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/critical-points-1d."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (x) (- (* x x x) (* 3 x))))\n(define (df x) (calc/derivative f x))\n(define cps (calc/critical-points-1d f -3 3))\n(map (lambda (c) (< (abs (df c)) 0.02)) cps)\n;; => (#t #t) — both critical points have f' ≈ 0" :tags (eng program))
      (:code "(define f (lambda (x) (- (* x x x) (* 3 x))))\n(define (df x) (calc/derivative f x))\n(define cps (calc/critical-points-1d f -3 3))\n(let loop ((cs cps))\n  (or (null? cs) (and (< (abs (df (car cs))) 0.01) (loop (cdr cs)))))\n;; => #t — Fermat's theorem: all critical points have df=0" :tags (math program))
      (:code "(define (all-zeros? f cps tol)\n  (let loop ((cs cps))\n    (or (null? cs)\n        (and (< (abs (calc/derivative f (car cs))) tol)\n             (loop (cdr cs))))))\n(all-zeros? (lambda (x) (* x x)) (calc/critical-points-1d (lambda (x) (* x x)) -2 2) 0.01)\n;; => #t — x² has critical point at 0; df(0) = 0" :tags (cs program)))
     :claim "At every critical point of a differentiable f, the derivative vanishes: f'(c) = 0."
     :invariant "∀ c ∈ crit(f). f\\'(c) = 0"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch13-calculus-1 and ch14-calculus-2.")
    (:eng "Map the check over all critical points; any #f means the finder returned a spurious result."
     :math "Fermat's theorem in executable form: run it on the cubic, see both #t."
     :cs "all-zeros? is a generic property tester; parametrize tolerance to adjust strictness."))
  :row-5-emergence (
    (:programs (
      (:code "(define cost (lambda (x) (+ (* x x x) (* -6 x x) (* 9 x))))\n(define cps (calc/critical-points-1d cost 0 5))\n(map (lambda (c) (list c (cost c))) cps)\n;; => list of (x cost) pairs — candidate cost minima before full classification" :tags (eng composition))
      (:code "(define f (lambda (x) (- (* x x x) (* 3 x))))\n(define cps (calc/critical-points-1d f -3 3))\n(map f cps)\n;; => (2 -2) — function values at critical points of x³-3x" :tags (math composition))
      (:code "(define (critical-value-pairs f a b)\n  (map (lambda (x) (list 'x x 'fx (f x)))\n       (calc/critical-points-1d f a b)))\n(critical-value-pairs (lambda (x) (+ (* x x x) (* -3 x))) -3 3)\n;; => ((x -1.0 fx 2.0) (x 1.0 fx -2.0)) — structured output for downstream classification" :tags (cs composition)))
     :base "calc/critical-points-1d — see :summary."
     :emergent "candidate-optima"
     :meta "The emergent candidate-optima belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Critical points → extremum classification is the classical Fermat program. See book-of-ml ch-06 (gradient descent).")
    (:eng "Cost function critical points with their values: the standard output for an optimization scan."
     :math "Evaluating f at its critical points gives the local extremum values — ready for comparison."
     :cs "critical-value-pairs gives structured output; downstream code can sort, filter, or classify."))
)

(verb
  :name "calc/curl" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/curl F [opts]) -> scalar | vector | (escalate 'shape-error)"
  :summary "Computes the curl (∇×F) of a 2-D scalar or 3-D vector field."
  :explanation "Curl measures the rotation or circulation of a vector field. In 2-D, curl of a scalar field returns a scalar (the z-component of rotation); in 3-D, curl of a vector field returns a vector. calc/curl takes a field representation (typically a closure or list of component functions) and returns the curl at a point or over a region. This is a deterministic, device-local computation; results are consistent across runs on the same input."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define F (lambda (x y) (list (- y) x)))\n(define curl-result (calc/curl F))\n(display curl-result)" :note "Compute curl of a simple rotation field F = (-y, x); result should be constant")
    (:dialect "motoi" :tier "intermediate" :code "(define F (lambda (x y z) (list 0 z (- y))))\n(define curl-F (calc/curl F))\n(cond ((eq? (car curl-F) 'error) (display \"Bad field\"))\n      (else (display (list \"Curl at origin:\" curl-F))))" :note "3-D curl; check for shape errors before using result")
    (:dialect "motoi" :tier "expert" :code "(define (field-from-potential phi)\n  (lambda (x y z) (list (phi x y z) (phi x y z) (phi x y z))))\n(define phi (lambda (x y z) (+ (* x x) (* y y) (* z z))))\n(define F (field-from-potential phi))\n(let ((curl-F (calc/curl F)))\n  (if (pair? curl-F)\n    (display (list \"Curl of F from potential:\" curl-F))\n    (escalate 'field-malformed F)))" :note "Construct a field from a potential function; compute its curl (should be near zero)")
  )
  :caveats ("Field must be a callable (lambda) or structure recognized by the curl routine." "Non-2-D and non-3-D fields escalate 'shape-error; dimension must be exact." "Finite-difference approximation is sensitive to field smoothness; noisy or discontinuous fields may give inaccurate results." "Result is deterministic within the device but may differ slightly across platforms due to floating-point precision.")
  :drawbacks ("Finite-difference approximation requires a smoothing/grid step size; too coarse and accuracy suffers, too fine and noise dominates." "No symbolic simplification; composition with other fields can be expensive." "Requires the field to be differentiable; discontinuous fields will produce misleading results.")
  :usecases ("Fluid dynamics: compute vorticity from a velocity field." "Electromagnetism: verify that ∇×E = -∂B/∂t in a discretized field." "Graphics / physics: detect rotational motion in a vector field for visualization or collision response.")
  :related ("calc/divergence" "calc/line-integral" "calc/surface-integral" "num/nintegrate-2d" "num/nintegrate-3d")
  :learn (:concept "Curl is a differential operator on vector fields; it measures local rotation. In 2-D, a scalar field's curl is a scalar; in 3-D, a vector field's curl is a vector." :prerequisites ("calculus / multivariable functions" "lambda (to define fields)") :progression "After calc/curl, explore calc/divergence to measure expansion/contraction, then calc/surface-integral to integrate over surfaces.")
  :row-2-audit (
    (:programs (
      (:code "(define vortex (lambda (p) (list (- (cadr p)) (car p))))\n(define curl-val (calc/curl vortex (list 1 1)))\n;; Rotational field F=(-y,x): curl F = ∂x/∂x - ∂(-y)/∂y = 1+1 = 2\n(< (abs (- curl-val 2)) 0.05)\n;; => #t — vorticity is 2 everywhere" :tags (eng program))
      (:code "(calc/curl (lambda (p) (list (- (cadr p)) (car p))) (list 0 0))\n;; curl(-y, x) = ∂x/∂x − ∂(−y)/∂y = 1 − (−1) = 2\n;; => ≈ 2.0" :tags (math program))
      (:code "(define (irrotational? F pt tol)\n  (< (abs (calc/curl F pt)) tol))\n(irrotational? (lambda (p) (list (car p) (cadr p))) (list 1 2) 0.05)\n;; F=(x,y); curl = ∂y/∂x - ∂x/∂y = 0 - 0 = 0 => #t — conservative" :tags (cs program)))
     :problem "A 2D-fluid or magnetic-field simulation needs the rotational component of a vector field; the audit wants the scalar curl at a point."
     :explanation "Rotational field F = (-y, x); curl F = 2; operator sees 2 (or close to it)."
     :meta "Divergence measures how much a field spreads out; curl measures how much it rotates. Different physical meaning; different formula.")
    (:eng "Vortex field: curl is 2 everywhere; engineering use is checking rotor fields in motor design."
     :math "Exact: ∂x/∂x - ∂(-y)/∂y = 1+1 = 2; numerical confirms closed form."
     :cs "irrotational? tests whether a field is conservative; useful before computing potential."))
  :row-3-dimension (
    (:setup "'rotational density of a vector field'"
     :rungs (
       (:domain "calc native" :code "(calc/curl (lambda (p) (list (- (cadr p)) (car p))) (list 0 0))")
       (:domain "vortex-strength in a fluid simulation" :code "(calc/curl (lambda (p) (list (- (cadr p)) (car p))) (list 0 0))\n;; curl(-y, x) = ∂x/∂x − ∂(−y)/∂y = 1 − (−1) = 2\n;; => ≈ 2.0")
       (:domain "∇ × F" :code "(calc/curl (lambda (p) (list (- (cadr p)) (car p))) (list 0 0))\n;; curl(-y, x) = ∂x/∂x − ∂(−y)/∂y = 1 − (−1) = 2\n;; => ≈ 2.0"))
     :explanation "Rung 1 is calc/curl in its native library. Rung 2 shows the same ''rotational density of a vector field'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''rotational density of a vector field'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/curl."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define phi (lambda (p) (+ (expt (car p) 2) (expt (cadr p) 2))))\n(define grad-phi (lambda (p) (calc/gradient phi p)))\n(< (abs (calc/curl grad-phi (list 1 1))) 0.05)\n;; => #t — grad(x²+y²)=(2x,2y); curl of a gradient is zero" :tags (eng program))
      (:code "(define phi (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define F (lambda (p) (calc/gradient phi p)))\n(< (abs (calc/curl F (list 0.5 0.3))) 0.05)\n;; curl(∇φ)=0 for any C² φ — the algebraic identity" :tags (math program))
      (:code "(define (curl-of-gradient-zero? phi pt tol)\n  (let ((grad-phi (lambda (p) (calc/gradient phi p))))\n    (< (abs (calc/curl grad-phi pt)) tol)))\n(curl-of-gradient-zero? (lambda (p) (* (car p) (cadr p))) (list 2 3) 0.05)\n;; => #t — xy is C²; curl(∇(xy))=0" :tags (cs program)))
     :claim "For a gradient field F = ∇φ, curl F = 0 (curl of gradient is zero)."
     :invariant "∀ φ ∈ C^2. curl(∇φ) = 0"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch15-multivariable-linear-algebra.")
    (:eng "Gradient of any scalar potential is irrotational — key identity for checking conservative fields."
     :math "φ = x²+y²; ∇φ = (2x, 2y); curl = ∂(2y)/∂x - ∂(2x)/∂y = 0."
     :cs "curl-of-gradient-zero? is a generic property tester; try any C² potential."))
  :row-5-emergence (
    (:programs (
      (:code "(define F (lambda (p) (list (- (cadr p)) (car p))))\n(define pts '((0 0) (1 0) (0 1) (1 1)))\n(map (lambda (p) (list p (calc/curl F p) (calc/divergence F p))) pts)\n;; => each point: (curl≈2 div≈0) — uniform rotation, no expansion" :tags (eng composition))
      (:code "(define F (lambda (p) (list (- (cadr p)) (car p))))\n(list (calc/curl F (list 0 0)) (calc/divergence F (list 0 0)))\n;; => (2 0) — pure rotation: nonzero curl, zero divergence" :tags (math composition))
      (:code "(define (classify-field F pts)\n  (map (lambda (p)\n         (let ((c (calc/curl F p)) (d (calc/divergence F p)))\n           (list p\n                 (if (< (abs c) 0.05) 'irrotational 'rotating)\n                 (if (< (abs d) 0.05) 'incompressible 'compressible))))\n       pts))\n(classify-field (lambda (p) (list (- (cadr p)) (car p))) '((0 0) (1 1)))\n;; => each point labeled (rotating incompressible)" :tags (cs composition)))
     :base "calc/curl — see :summary."
     :emergent "rotation-detector"
     :meta "The emergent rotation-detector belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Curl + divergence is the vector-calculus split into rotation and expansion. See book-of-ml ch-01.")
    (:eng "Grid sweep: curl=2, div=0 at every point confirms pure rotation with no source/sink."
     :math "Pure rotation field: curl nonzero, divergence zero — the Helmholtz split made visible."
     :cs "classify-field labels each point as (rotating|irrotational, compressible|incompressible); one call, structured output."))
)

(verb
  :name "calc/derivative" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/derivative f x) -> number"
  :summary "Computes the numerical derivative f'(x) using central difference approximation."
  :explanation "The derivative measures how fast a function is changing at a point. Rather than compute symbolically, this verb estimates f'(x) by evaluating f at points very close to x and taking the ratio of change in output to change in input. This central-difference method is stable and accurate for most smooth functions. Use it when you need the slope of a curve at a specific point."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define f (lambda (x) (* x x)))\n(calc/derivative f 3)" :note "Derivative of x² at x=3 is approximately 6 (actual: 2x=6)")
    (:dialect "motoi" :tier "intermediate" :code "(define cubic (lambda (x) (+ (* x x x) (* 2 x))))\n(define slope-at-1 (calc/derivative cubic 1))\n(define slope-at-2 (calc/derivative cubic 2))\n(list slope-at-1 slope-at-2)" :note "Compare slopes at different points: d/dx(x³+2x) = 3x²+2, so at x=1 is 5, at x=2 is 14")
    (:dialect "motoi" :tier "expert" :code "(define f (lambda (x) (/ 1 (+ 1 (* x x)))))\n(let ((critical-x 0))\n  (let ((df (calc/derivative f critical-x)))\n    (if (< (abs df) 0.01)\n      'approximately-flat\n      'has-slope)))" :note "Check if a function is approximately flat near a point by testing if derivative magnitude is small")
  )
  :caveats ("Numeric, not symbolic: answer is approximate, not exact." "Fails near discontinuities or sharp corners (left/right derivatives differ)." "Very small step size can amplify floating-point rounding error; very large step loses accuracy." "Periodic or oscillating functions may give misleading slopes at high frequencies.")
  :drawbacks ("Central difference is O(h²) accurate but requires two function evaluations per call." "For high-precision work, consider calc/taylor or symbolic differentiation." "Does not scale well to many partial derivatives (use calc/gradient instead).")
  :usecases ("Finding slope of experimental data or black-box function at a point." "Optimisation: feeding derivatives to gradient descent or Newton's method." "Verifying whether a function is increasing or decreasing over a region.")
  :related ("calc/second-derivative" "calc/gradient" "calc/newton" "calc/critical-points-1d" "calc/differentiable?")
  :learn (:concept "Numerical derivative as a limit ratio; central-difference stability and error." :prerequisites ("core math (limits, rates of change)") :progression "calc/second-derivative → calc/critical-points-1d → calc/extrema-1d")
  :row-2-audit (
    (:programs (
      (:code "(define position (lambda (t) (+ (* 3 t t) (* -2 t) 1)))\n(define (velocity t) (calc/derivative position t))\n(velocity 2)\n;; position s(t) = 3t²-2t+1; velocity = ds/dt = 6t-2; at t=2: 6·2-2 = 10\n;; => ≈ 10.0" :tags (eng program))
      (:code "(define f (lambda (x) (* x x)))\n(define (df x) (calc/derivative f x))\n(df 3)\n;; d/dx(x²) = 2x; at x=3: 2·3 = 6\n;; => ≈ 6.0" :tags (math program))
      (:code "(define (finite-diff f x h)\n  (/ (- (f (+ x h)) (f (- x h))) (* 2 h)))\n(define f (lambda (x) (* x x x)))\n(list (finite-diff f 1 0.01)\n      (calc/derivative f 1))\n;; both should give ≈ 3.0 (d/dx x³ at x=1)" :tags (cs program)))
     :problem "An operator needs the instantaneous rate of change of a smooth function as a callable — analytic derivation is often ugly, numerical differentiation is the honest fallback."
     :explanation "f' at 3 for f(x) = x^2 is 2·3 = 6; operator sees ≈ 6."
     :meta "partial takes a multivariate function and a variable index; derivative is single-variable. Use partial when there are multiple inputs.")
    (:eng "Velocity from position: calc/derivative wraps the kinematic ds/dt in one call."
     :math "x²: derivative at 3 is 6 exactly; numerical should match to 4+ significant figures."
     :cs "finite-diff vs calc/derivative: the two implementations should agree; use both to cross-check."))
  :row-3-dimension (
    (:setup "'instantaneous rate of change'"
     :rungs (
       (:domain "calc native" :code "(define f (lambda (x) (* x x)))")
       (:domain "velocity from position samples" :code "(define (finite-diff f x h)\n  (/ (- (f (+ x h)) (f (- x h))) (* 2 h)))\n(define f (lambda (x) (* x x x)))\n(list (finite-diff f 1 0.01)\n      (calc/derivative f 1))\n;; both should give ≈ 3.0 (d/dx x³ at x=1)")
       (:domain "limit definition of derivative" :code "(define (finite-diff f x h)\n  (/ (- (f (+ x h)) (f (- x h))) (* 2 h)))\n(define f (lambda (x) (* x x x)))\n(list (finite-diff f 1 0.01)\n      (calc/derivative f 1))\n;; both should give ≈ 3.0 (d/dx x³ at x=1)"))
     :explanation "Rung 1 is calc/derivative in its native library. Rung 2 shows the same ''instantaneous rate of change'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''instantaneous rate of change'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/derivative."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (x) (* x x)))\n(define g (lambda (x) x))\n(define (combined x) (calc/derivative (lambda (t) (+ (* 3 (f t)) (* 2 (g t)))) x))\n(define by-linearity (+ (* 3 (calc/derivative f 1)) (* 2 (calc/derivative g 1))))\n(< (abs (- (combined 1) by-linearity)) 0.01)\n;; 3·(2x) + 2·(1) at x=1 = 8; linearity holds" :tags (eng program))
      (:code "(define f (lambda (x) (* x x)))\n(define g (lambda (x) x))\n(define (df x) (calc/derivative f x))\n(define (dg x) (calc/derivative g x))\n(define (combined x) (calc/derivative (lambda (t) (+ (* 3 (f t)) (* 2 (g t)))) x))\n(< (abs (- (combined 1.0) (+ (* 3 (df 1.0)) (* 2 (dg 1.0))))) 0.01)\n;; => #t — 3f'+2g' = 3·2+2·1 = 8" :tags (math program))
      (:code "(define (linearity-test? f g a b x)\n  (let ((dh (lambda (t) (calc/derivative (lambda (s) (+ (* a (f s)) (* b (g s)))) t)))\n        (df (lambda (t) (calc/derivative f t)))\n        (dg (lambda (t) (calc/derivative g t))))\n    (< (abs (- (dh x) (+ (* a (df x)) (* b (dg x))))) 0.02)))\n(linearity-test? (lambda (x) (* x x)) (lambda (x) x) 3 2 1)\n;; => #t" :tags (cs program)))
     :claim "Linearity: (af + bg)' = a f' + b g'."
     :invariant "∀ f g diff. (af + bg)\\' = a f\\' + b g\\'"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch13-calculus-1 and ch14-calculus-2. Also book-of-ml ch-06 (gradient descent) for autodiff and gradient descent.")
    (:eng "3f+2g at x=1: combined derivative = 8; linearity check is the cheapest sanity test for any diff implementation."
     :math "3·(2x)|₁ + 2·(1) = 6+2 = 8; numerical matches exactly."
     :cs "linearity-test? is a parametric property tester; plug in any two functions and coefficients."))
  :row-5-emergence (
    (:programs (
      (:code "(define accel (lambda (t) (+ (* 4 t) 3)))\n(define vel   (lambda (t) (+ (* 2 t t) (* 3 t))))\n;; Verify: dvel/dt should equal accel\n(map (lambda (t) (< (abs (- (calc/derivative vel t) (accel t))) 0.05))\n     '(0 1 2 3))\n;; => (#t #t #t #t) — kinematics check" :tags (eng composition))
      (:code "(define f (lambda (x) (sin x)))\n(define (df x) (calc/derivative f x))\n(define (ddf x) (calc/derivative df x))\n(list (df 0) (ddf 0))\n;; => (≈1.0 ≈0.0) — sin'(0)=cos(0)=1; sin''(0)=-sin(0)=0" :tags (math composition))
      (:code "(define (nth-derivative f n x)\n  (if (= n 0) (f x)\n    (let ((df (lambda (t) (calc/derivative f t))))\n      (nth-derivative df (- n 1) x))))\n(map (lambda (n) (nth-derivative (lambda (x) (expt x 4)) n 1))\n     '(0 1 2 3 4))\n;; => (1 4 12 24 0) — powers of x^4 at x=1" :tags (cs composition)))
     :base "calc/derivative — see :summary."
     :emergent "higher-derivatives"
     :meta "The emergent higher-derivatives belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Repeated derivative = Taylor coefficients / higher-order rate. See book-of-ml ch-09 (backpropagation).")
    (:eng "Kinematics check: dvel/dt = accel at 4 sample times; all #t confirms the velocity model is self-consistent."
     :math "sin: first derivative is cos; second is -sin; values at 0 are (1 0) — matches Taylor series."
     :cs "nth-derivative recurses calc/derivative n times; x⁴ gives (1,4,12,24,0) — exactly n!/n!·k! pattern."))
)

(verb
  :name "calc/differentiable?" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/differentiable? f x) -> boolean"
  :summary "Tests whether a function is differentiable at a point by checking if left and right derivatives agree."
  :explanation "A function is differentiable at x if its derivative exists—that is, if approaching from the left and right give the same slope. This verb computes the left derivative (approaching from x−h) and right derivative (approaching from x+h), then checks if they match within floating-point tolerance. If they do, the function is differentiable there; if not, there is a corner, cusp, or discontinuity."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define smooth (lambda (x) (* x x)))\n(calc/differentiable? smooth 1)" :note "Parabola is smooth everywhere; returns true")
    (:dialect "motoi" :tier "intermediate" :code "(define piecewise (lambda (x)\n  (if (< x 0) (- x) x)))\n(and (calc/differentiable? piecewise -0.1)\n     (calc/differentiable? piecewise 0)\n     (calc/differentiable? piecewise 0.1))" :note "Absolute value |x| is smooth everywhere except at x=0, where the corner breaks differentiability")
    (:dialect "motoi" :tier "expert" :code "(define (filter pred xs)\n  (let loop ((xs xs) (acc '()))\n    (cond ((null? xs) (reverse acc))\n          ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc)))\n          (else (loop (cdr xs) acc)))))\n(define f (lambda (x) (+ (sin x) (* 0.1 x))))\n(let ((test-points (list -1 0 0.5 1)))\n  (filter (lambda (pt) (not (calc/differentiable? f pt)))\n          test-points))" :note "Check a list of candidate points and collect only those where differentiability fails (should be empty for sin+linear)")
  )
  :caveats ("Numeric tolerance means borderline cases (cusps at tiny angles) may be marked differentiable." "Does not check continuity first; a function can be discontinuous and still pass this test at that point (nonsensical result)." "h is fixed; very sharp corners may slip through if angle is extreme.")
  :drawbacks ("False positives on near-corners that are actually differentiable but numerically tight." "For high-precision classification, prefer calc/continuous? first, then this test." "Much slower than checking the expression form symbolically.")
  :usecases ("Validating that an empirical signal is smooth enough for derivatives." "Screening a function before applying Newton's method (which requires smooth f)." "Locating singularities or kinks in piecewise-defined functions.")
  :related ("calc/derivative" "calc/continuous?" "calc/critical-points-1d" "calc/newton")
  :learn (:concept "Differentiability as agreement of left/right derivative limits; numeric vs. analytic checking." :prerequisites ("calc/derivative" "core concept of one-sided limits") :progression "calc/continuous? → calc/extrema-1d → calc/newton")
  :row-2-audit (
    (:programs (
      (:code "(define (safe-for-newton? f x0) (calc/differentiable? f x0))\n(safe-for-newton? (lambda (x) (* x x)) 1)" :tags (eng program))
      (:code "(define (diff-at-zero? f) (calc/differentiable? f 0))\n(diff-at-zero? (lambda (x) (* x x x)))" :tags (math program))
      (:code "(define (guarded-diff-check f x) (if (procedure? f) (calc/differentiable? f x) 'not-a-function))\n(guarded-diff-check (lambda (x) x) 0)" :tags (cs program))))
    (:problem "Before applying gradient descent or Newton's method, the operator must certify differentiability of the objective on the search domain."
     :programs (
       (:code "(list (calc/differentiable? (lambda (x) x) 0 1)\n      (calc/differentiable? (lambda (x) (abs x)) -1 1))" :tags (program)))
     :explanation "Linear is differentiable; |x| is not at 0; operator sees (#t #f)."
     :meta "Continuity is weaker; differentiability is stronger. Newton needs differentiability; only integration needs continuity.")
    (:eng "The operator gets one line per call; failure surfaces the exact input that broke the expectation."
     :math "Category: calc-1d; the verb operates within its declared algebraic type."
     :cs "Complexity as declared in the signature; deterministic and testable."))
  :row-3-dimension (
    (:setup "'smooth-enough-to-linearize'"
     :rungs (
       (:domain "calc native" :code "(list (calc/differentiable? (lambda (x) x) 0 1)\n      (calc/differentiable? (lambda (x) (abs x)) -1 1))")
       (:domain "audio can be locally interpolated" :code "(define f (lambda (x) (* x x)))\n(and (calc/differentiable? f 0 1)\n     (calc/continuous? f 0 1))")
       (:domain "existence of f\\' on an interval" :code "(define (diff-at-zero? f) (calc/differentiable? f 0))\n(diff-at-zero? (lambda (x) (* x x x)))"))
     :explanation "Rung 1 is calc/differentiable? in its native library. Rung 2 shows the same ''smooth-enough-to-linearize'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''smooth-enough-to-linearize'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/differentiable?."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (x) (* x x)))\n(equal? (calc/differentiable? f 1) (calc/differentiable? f 1))" :tags (eng program))
      (:code "(define poly (lambda (x) (+ (* x x x) (* -2 x))))\n(calc/differentiable? poly 0.5)" :tags (math program))
      (:code "(define (boolean-output? f x) (let ((r (calc/differentiable? f x))) (or (equal? r #t) (equal? r #f))))\n(boolean-output? (lambda (x) x) 0)" :tags (cs program)))
    :claim "If f is differentiable on [a, b] then f is continuous on [a, b]."
     :programs (
       (:code "(define f (lambda (x) (* x x)))\n(and (calc/differentiable? f 0 1)\n     (calc/continuous? f 0 1))" :tags (program)))
     :invariant "f differentiable on I ⇒ f continuous on I"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch13-calculus-1 and ch14-calculus-2.")
    (:eng "The runnable claim doubles as a CI smoke test — if the invariant ever prints #f, the verb has drifted."
     :math "The invariant is the defining property in the calc-1d category."
     :cs "Property-based test: the program above is a runnable falsifier candidate for a QuickCheck-style fuzzer."))
  :row-5-emergence (
    (:programs (
      (:code "(define (screen-optimization objective candidates) (filter (lambda (x) (calc/differentiable? objective x)) candidates))\n(screen-optimization (lambda (x) (abs x)) (list -1 -0.5 0 0.5 1))" :tags (eng composition))
      (:code "(define (piecewise-smooth-domains f test-points) (let loop ((pts test-points) (smooth '()) (broken '())) (if (null? pts) (list 'smooth-at (reverse smooth) 'broken-at (reverse broken)) (if (calc/differentiable? f (car pts)) (loop (cdr pts) (cons (car pts) smooth) broken) (loop (cdr pts) smooth (cons (car pts) broken))))))\n(piecewise-smooth-domains (lambda (x) (abs x)) (list -1 0 1))" :tags (math composition))
      (:code "(define (newton-guarded f df x0) (if (calc/differentiable? f x0) (- x0 (/ (f x0) (df x0))) 'not-differentiable))\n(newton-guarded (lambda (x) (- (* x x) 2)) (lambda (x) (* 2 x)) 1.5)" :tags (cs composition))))
    (:base "calc/differentiable? — see :summary."
     :programs (
       (:code "(define fs (list (lambda (x) x) (lambda (x) (abs x)) (lambda (x) (sqrt (abs x)))))\n(map (lambda (f) (calc/differentiable? f -0.1 0.1)) fs)" :tags (composition)))
     :emergent "newton-eligible"
     :meta "The emergent newton-eligible belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Differentiability gate before Newton is the safe-precondition pattern. See book-of-ml ch-06.")
    (:eng "The composition is short enough to inline in a callsite yet meaningful enough to name and reuse."
     :math "Under composition, the calc-1d operations close into the newton-eligible pattern."
     :cs "The emergent newton-eligible is a first-class named pattern; recognize it once and it reappears everywhere."))
)

(verb
  :name "calc/directional-derivative" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/directional-derivative f point direction) -> number"
  :summary "Computes the rate of change of a multivariable function along a specified direction vector."
  :explanation "The directional derivative Dᵤf measures how fast f changes at a point when moving in the direction of unit vector u. It is the dot product of the gradient ∇f with u. This generalises the notion of slope to multivariable functions: instead of asking 'how fast does f change along x?', you ask 'how fast along this arbitrary direction?' Use it to find the steepest direction or the rate of change perpendicular to a constraint."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define f (lambda (pt) (+ (car pt) (cadr pt))))\n(calc/directional-derivative f (list 0 0) (list 1 0))" :note "f(x,y)=x+y; direction (1,0) is along x-axis; rate of change is 1")
    (:dialect "motoi" :tier "intermediate" :code "(define terrain (lambda (pt)\n  (+ (* (car pt) (car pt)) (* (cadr pt) (cadr pt)))))\n(let ((pt (list 1 1))\n      (dir-northeast (list (/ 1 (sqrt 2)) (/ 1 (sqrt 2)))))\n  (calc/directional-derivative terrain pt dir-northeast))" :note "f(x,y)=x²+y²; at (1,1), slope toward northeast is √2·(2+2)/√2 = 4")
    (:dialect "motoi" :tier "expert" :code "(define point '(0 0))\n(define f (lambda (pt) (* (car pt) (cadr pt))))\n(let ((point (list 2 3))\n      (grad (calc/gradient f point)))\n  (let ((magnitude (sqrt (+ (* (car grad) (car grad))\n                            (* (cadr grad) (cadr grad))))))\n    (let ((unit-grad (list (/ (car grad) magnitude)\n                           (/ (cadr grad) magnitude))))\n      (calc/directional-derivative f point unit-grad))))" :note "Manual steepest-ascent direction: normalize gradient, then compute directional derivative along it (equals gradient magnitude)")
  )
  :caveats ("Direction vector is assumed to be normalized (unit length); non-unit vectors give scaled results." "Computed numerically; accuracy depends on gradient estimation, which uses finite differences." "Does not check that the function is actually differentiable at the point.")
  :drawbacks ("More expensive than a single partial derivative: requires computing the full gradient." "For many directions at one point, compute gradient once and dot-product manually." "Limited to numeric evaluation; symbolic directional derivatives require symbolic gradient.")
  :usecases ("Optimisation: finding steepest-ascent or steepest-descent direction." "Sensitivity analysis: measuring sensitivity of output to changes along a constraint surface." "Level-set flow: computing flux across contour lines in a scalar field.")
  :related ("calc/gradient" "calc/hessian" "calc/total-differential" "vec/dot")
  :learn (:concept "Gradient as vector of all slopes; directional derivative as projection onto a direction." :prerequisites ("calc/gradient" "vec/dot") :progression "calc/hessian → calc/critical-points-1d → calc/extrema-1d")
  :row-2-audit (
    (:programs (
      (:code "(define pressure (lambda (p) (+ (expt (car p) 2) (expt (cadr p) 2))))\n(define flow-dir (list (/ 1 (sqrt 2)) (/ 1 (sqrt 2))))\n(calc/directional-derivative pressure (list 1 1) flow-dir)\n;; ∇p=(2x,2y) at (1,1)=(2,2); dot (2,2)·(1/√2,1/√2)=4/√2≈2.828\n;; => ≈ 2.828" :tags (eng program))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/directional-derivative f (list 1 0) (list 1 0))\n;; ∇f=(2x,2y); at (1,0) with dir (1,0): 2x·1+2y·0=2\n;; => ≈ 2.0" :tags (math program))
      (:code "(define (scan-directions f pt dirs)\n  (map (lambda (d) (list d (calc/directional-derivative f pt d))) dirs))\n(scan-directions\n  (lambda (p) (* (car p) (cadr p)))\n  (list 1 1)\n  (list (list 1 0) (list 0 1) (list (/ 1 (sqrt 2)) (/ 1 (sqrt 2)))))\n;; f=xy; ∇f=(y,x)=(1,1) at (1,1); directions give 1, 1, √2≈1.414" :tags (cs program)))
     :problem "A gradient-descent step needs the rate of change along a specific direction, not along an axis; the operator wants ∇f · v."
     :explanation "∇f = (2x, 2y); at (1, 0), direction (1, 0), derivative = 2; operator sees ≈ 2."
     :meta "partial takes an axis-aligned direction; directional-derivative accepts any unit vector. Same shape, more general.")
    (:eng "Pressure gradient in flow direction: directional derivative gives the rate the sensor sees as fluid moves."
     :math "At (1,0) along x-axis: ∇f=(2,0); dot with (1,0) = 2; axis-aligned case matches calc/partial."
     :cs "scan-directions probes a field at one point in multiple directions; compact sensitivity analysis."))
  :row-3-dimension (
    (:setup "'rate along a chosen direction'"
     :rungs (
       (:domain "calc native" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))")
       (:domain "slope of terrain in a walking direction" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/directional-derivative f (list 1 0) (list 1 0))\n;; ∇f=(2x,2y); at (1,0) with dir (1,0): 2x·1+2y·0=2\n;; => ≈ 2.0")
       (:domain "∇f · v" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/directional-derivative f (list 1 0) (list 1 0))\n;; ∇f=(2x,2y); at (1,0) with dir (1,0): 2x·1+2y·0=2\n;; => ≈ 2.0"))
     :explanation "Rung 1 is calc/directional-derivative in its native library. Rung 2 shows the same ''rate along a chosen direction'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''rate along a chosen direction'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/directional-derivative."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define pt (list 1 1))\n(define v (list 1 0)) (define w (list 0 1))\n(define Dv (calc/directional-derivative f pt v))\n(define Dw (calc/directional-derivative f pt w))\n(define D2v3w (calc/directional-derivative f pt (list 2 3)))\n(< (abs (- D2v3w (+ (* 2 Dv) (* 3 Dw)))) 0.05)\n;; Dv=2, Dw=2; 2·2+3·2=10; D_{2v+3w}f should be ≈10" :tags (eng program))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define p (list 1 1))\n(define v (list 1 0)) (define w (list 0 1))\n(< (abs (- (calc/directional-derivative f p (list 2 3))\n           (+ (* 2 (calc/directional-derivative f p v))\n              (* 3 (calc/directional-derivative f p w))))) 0.01)\n;; => #t — linearity in direction confirmed" :tags (math program))
      (:code "(define (linearity-dir? f pt v w a b tol)\n  (let ((combined (calc/directional-derivative f pt (list (+ (* a (car v)) (* b (car w)))\n                                                         (+ (* a (cadr v)) (* b (cadr w))))))\n        (expected (+ (* a (calc/directional-derivative f pt v))\n                     (* b (calc/directional-derivative f pt w)))))\n    (< (abs (- combined expected)) tol)))\n(linearity-dir? (lambda (p) (* (car p) (cadr p)))\n                (list 2 3) (list 1 0) (list 0 1) 2 3 0.05)\n;; => #t" :tags (cs program)))
     :claim "Directional derivative is a linear function of direction: D_{av+bw} f = a D_v f + b D_w f."
     :invariant "D_{av+bw} f = a D_v f + b D_w f"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch15-multivariable-linear-algebra.")
    (:eng "Basis decomposition: D_{2v+3w} = 2·Dv + 3·Dw; useful for engineering sensitivity studies."
     :math "∇f=(2,2) at (1,1); D_v=2, D_w=2; 2·2+3·2=10 matches D_{2v+3w}f."
     :cs "linearity-dir? generalizes the test to any two basis vectors and scalar weights."))
  :row-5-emergence (
    (:programs (
      (:code "(define loss (lambda (p) (+ (expt (car p) 2) (* 2 (expt (cadr p) 2)))))\n(define pt (list 3 2))\n(define grad (calc/gradient loss pt))\n(define gmag (sqrt (+ (* (car grad) (car grad)) (* (cadr grad) (cadr grad)))))\n(define descent-dir (list (/ (- (car grad)) gmag) (/ (- (cadr grad)) gmag)))\n(list 'gradient grad 'steepest-descent descent-dir\n      'rate (calc/directional-derivative loss pt descent-dir))\n;; rate is negative (downhill)" :tags (eng composition))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define p (list 1 1))\n(define g (calc/gradient f p))\n(list g (calc/directional-derivative f p (list 1 0)))\n;; gradient=(2,2); x-dir rate=2; confirms ∇f·ê₁ = ∂f/∂x" :tags (math composition))
      (:code "(define (all-directional-rates f pt basis)\n  (map (lambda (v) (calc/directional-derivative f pt v)) basis))\n(all-directional-rates\n  (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p))))\n  (list 1 2)\n  (list (list 1 0) (list 0 1) (list (/ 1 (sqrt 2)) (/ 1 (sqrt 2)))))\n;; => (2 4 ≈4.243) — x-rate, y-rate, diagonal rate" :tags (cs composition)))
     :base "calc/directional-derivative — see :summary."
     :emergent "steepest-descent-direction"
     :meta "The emergent steepest-descent-direction belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Directional derivative maximized along ∇f gives steepest descent. See book-of-ml ch-06.")
    (:eng "Gradient descent step: normalize gradient, compute directional derivative to verify rate before stepping."
     :math "Gradient at (1,1) is (2,2); rate along x-axis is ∂f/∂x=2; matches calc/partial."
     :cs "all-directional-rates builds the full directional profile; input to sensitivity analysis or step-size tuning."))
)

(verb
  :name "calc/divergence" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/divergence F) -> scalar | (escalate 'diverged)"
  :summary "Computes the divergence (∇·F) of a vector field at a point via central finite differences."
  :explanation "Divergence measures the net outflow or inflow of a vector field at a point. For a field F = [Fx, Fy, Fz], divergence is ∂Fx/∂x + ∂Fy/∂y + ∂Fz/∂z. calc/divergence takes a field representation and returns the divergence (a scalar). If the field produces non-finite values (NaN, infinity), the verb escalates 'diverged. Use this to analyze field behavior in fluid dynamics, electromagnetism, or source/sink configurations."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define radial (lambda (x y z) (list x y z)))\n(define div-result (calc/divergence radial))\n(display div-result)" :note "Divergence of radial field (x, y, z) is 3 everywhere")
    (:dialect "motoi" :tier "intermediate" :code "(define F (lambda (x y z) (list (/ 1 (+ (abs x) 0.01)) y z)))\n(let ((div (calc/divergence F)))\n  (cond ((eq? div 'diverged) (display \"Field has singularities\"))\n        (else (display (list \"Divergence:\" div)))))" :note "Field with a near-singularity; check for divergence before using result")
    (:dialect "motoi" :tier "expert" :code "(define (analyze-field-behavior F name)\n  (let ((div (calc/divergence F))\n        (curl (calc/curl F)))\n    (cond ((eq? div 'diverged) (escalate 'singular-field name))\n          ((eq? (car curl) 'error) (escalate 'malformed-field name))\n          (else (begin\n            (display (list name \"div:\" div \"curl:\" curl))\n            (list name div curl))))))\n(analyze-field-behavior (lambda (x y z) (list x y z)) 'radial)" :note "Combine divergence and curl analysis for a complete field characterization")
  )
  :caveats ("Field must return finite values; infinities, NaNs, or complex numbers cause escalation." "Central-difference approximation requires the field to be smooth; discontinuities or steep gradients reduce accuracy." "Dimension inference is implicit; mismatched field dimension (2-D vs 3-D) may produce garbage." "Result is deterministic within the device but subject to floating-point rounding.")
  :drawbacks ("Finite differences are approximate; grid spacing is fixed and not user-configurable." "No symbolic simplification; expensive to call repeatedly for the same field." "Does not indicate whether divergence is 'high' or 'low'—only returns the scalar value.")
  :usecases ("Fluid mechanics: verify incompressibility (∇·v = 0) in a velocity field." "Electrostatics: estimate charge density from an electric field (∇·E ∝ ρ)." "Source/sink detection: identify regions of outflow or inflow.")
  :related ("calc/curl" "calc/line-integral" "calc/surface-integral" "num/nintegrate-3d")
  :learn (:concept "Divergence is a scalar measure of field expansion/contraction; high positive divergence = outflow (source), negative = inflow (sink), zero = conservative." :prerequisites ("calculus / multivariable functions" "lambda (to define fields)") :progression "After calc/divergence, learn calc/curl to understand the rotational part of a field, then use both in calc/surface-integral.")
  :row-2-audit (
    (:programs (
      (:code "(define velocity (lambda (p) (list (car p) (- (cadr p)))))\n(calc/divergence velocity (list 1 1))\n;; div(x,-y) = ∂x/∂x + ∂(-y)/∂y = 1 + (-1) = 0\n;; => ≈ 0 — incompressible flow confirmed" :tags (eng program))
      (:code "(calc/divergence (lambda (p) (list (car p) (cadr p))) (list 1 2))\n;; F=(x,y); ∂x/∂x + ∂y/∂y = 1+1 = 2\n;; => ≈ 2.0" :tags (math program))
      (:code "(define (incompressible? F pt tol)\n  (< (abs (calc/divergence F pt)) tol))\n(incompressible? (lambda (p) (list (- (cadr p)) (car p))) (list 1 2) 0.05)\n;; F=(-y,x); div = ∂(-y)/∂x + ∂x/∂y = 0+0 = 0 => #t" :tags (cs program)))
     :problem "A conservation-law check needs the divergence of a vector field; the audit is 'does mass conservation hold in this simulation snapshot?'"
     :explanation "F = (x, y); div F = 2; operator sees ≈ 2."
     :meta "Curl measures rotation; divergence measures expansion. Both apply to vector fields; use both to characterize the field.")
    (:eng "Incompressible check: velocity field (x,-y) has zero divergence — mass is conserved at this point."
     :math "F=(x,y): div = 2 everywhere; linear expansion field is the simplest non-zero case."
     :cs "incompressible? encapsulates the tolerance check; reuse for all fluid simulation validations."))
  :row-3-dimension (
    (:setup "'expansion density of a vector field'"
     :rungs (
       (:domain "calc native" :code "(calc/divergence (lambda (p) (list (car p) (cadr p))) (list 1 2))")
       (:domain "flow-out of a fluid cell" :code "(calc/divergence (lambda (p) (list (car p) (cadr p))) (list 1 2))\n;; F=(x,y); ∂x/∂x + ∂y/∂y = 1+1 = 2\n;; => ≈ 2.0")
       (:domain "∇ · F" :code "(calc/divergence (lambda (p) (list (car p) (cadr p))) (list 1 2))\n;; F=(x,y); ∂x/∂x + ∂y/∂y = 1+1 = 2\n;; => ≈ 2.0"))
     :explanation "Rung 1 is calc/divergence in its native library. Rung 2 shows the same ''expansion density of a vector field'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''expansion density of a vector field'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/divergence."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define radial (lambda (p) (list (car p) (cadr p))))\n(calc/divergence radial (list 2 3))\n;; div(x,y) = 2 everywhere; value at (2,3) should still be 2\n;; => ≈ 2.0 — constant divergence confirmed" :tags (eng program))
      (:code "(define F (lambda (p) (list (- (cadr p)) (car p))))\n(define curlF (lambda (p) (list 0 0 (calc/curl F p))))\n(< (abs (calc/divergence curlF (list 0.5 0.3))) 0.05)\n;; div(curl F) = 0 for any C² F — fundamental vector identity" :tags (math program))
      (:code "(define (div-curl-zero? F pt tol)\n  ;; Test div(curl F) = 0\n  (let ((curlF (lambda (p) (list 0 0 (calc/curl F p)))))\n    (< (abs (calc/divergence curlF pt)) tol)))\n(div-curl-zero? (lambda (p) (list (- (cadr p)) (car p))) (list 1 1) 0.1)\n;; => #t" :tags (cs program)))
     :claim "For any C^2 vector field F, div(curl F) = 0."
     :invariant "∀ F ∈ C^2. div(curl F) = 0"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch15-multivariable-linear-algebra.")
    (:eng "Constant divergence: radial field (x,y) has div=2 at any point; spot-check at (2,3) confirms."
     :math "div(curl F)=0 is the fundamental vector identity; program is its runnable proof."
     :cs "div-curl-zero? abstracts the identity test; use with any C² field as a regression property."))
  :row-5-emergence (
    (:programs (
      (:code "(define velocity (lambda (p) (list (- (cadr p)) (car p))))\n(define pts '((0 0) (1 0) (0 1) (-1 0)))\n(map (lambda (p) (list p 'div (calc/divergence velocity p) 'curl (calc/curl velocity p))) pts)\n;; => each: div≈0, curl≈2 — pure rotation, no source/sink" :tags (eng composition))
      (:code "(define F (lambda (p) (list (car p) (cadr p))))\n(list (calc/divergence F (list 1 1)) (calc/curl F (list 1 1)))\n;; => (2 0) — pure expansion: div=2, curl=0" :tags (math composition))
      (:code "(define (field-signature F pts)\n  ;; Returns (div curl) pair at each point; classify the field\n  (map (lambda (p)\n         (list 'pt p\n               'div  (calc/divergence F p)\n               'curl (calc/curl F p)))\n       pts))\n(field-signature (lambda (p) (list (car p) (cadr p))) '((1 0) (0 1) (1 1)))\n;; => 3 points each showing div=2, curl=0" :tags (cs composition)))
     :base "calc/divergence — see :summary."
     :emergent "conservation-check"
     :meta "The emergent conservation-check belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Divergence + boundary integral = Divergence theorem. See book-of-ml ch-01.")
    (:eng "Grid survey: div=0, curl=2 everywhere for the rotation field — confirms it is a pure vortex."
     :math "Expansion field (x,y): div=2, curl=0 at every point — Helmholtz decomposition visible."
     :cs "field-signature builds a structured summary; one call per point, ready for logging or plotting."))
)

(verb
  :name "calc/extrema-1d" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/extrema-1d f a b) -> list"
  :summary "Finds critical points in [a, b] and classifies each as a local max, min, or saddle using the second derivative test."
  :explanation "Extrema are peaks and valleys—where a function reaches local maxima or minima. To find them: locate critical points (where f'(x) ≈ 0), then use the second derivative test: if f''(x) > 0 it's a min, if f''(x) < 0 it's a max, if f''(x) ≈ 0 it's inconclusive (saddle or inflection). This verb combines calc/critical-points-1d and calc/second-derivative to return a list of classified critical points."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define f (lambda (x) (- (* x x) (* 4 x))))\n(calc/extrema-1d f -1 5)" :note "f(x)=x²−4x; minimum at x=2 (where f'=2x−4=0, and f''=2>0); returns ((2 'min −4))")
    (:dialect "motoi" :tier "intermediate" :code "(define cubic (lambda (x) (- (* x x x) (* 3 x))))\n(let ((extrema (calc/extrema-1d cubic -2 2)))\n  (map (lambda (e) (list (car e) (cadr e) (round (* 100 (caddr e))))) extrema))" :note "f(x)=x³−3x has max at x=−1 and min at x=1; round values for readability")
    (:dialect "motoi" :tier "expert" :code "(define (filter pred xs)\n  (let loop ((xs xs) (acc '()))\n    (cond ((null? xs) (reverse acc))\n          ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc)))\n          (else (loop (cdr xs) acc)))))\n(define objective (lambda (x) (+ (* 2 (cos x)) x)))\n(let ((candidates (calc/extrema-1d objective 0 (* 4 3.14159))))\n  (let ((minima (filter (lambda (e) (eq? (cadr e) 'min)) candidates))\n        (maxima (filter (lambda (e) (eq? (cadr e) 'max)) candidates)))\n    (list (length minima) (length maxima))))" :note "Count local minima and maxima of a mixed trigonometric-linear function over [0, 4π]")
  )
  :caveats ("Second derivative test is inconclusive (returns 'saddle) when f''(x) ≈ 0; higher derivatives needed." "Requires f to be twice differentiable; corners or discontinuities break classification." "Numeric: does not distinguish global max/min from local; must compare values manually." "Endpoints (a, b) are not classified; check them separately if needed.")
  :drawbacks ("Two passes of finite-difference: one for f', one for f''; numeric errors compound." "Expensive for functions with many critical points or narrow intervals." "Symbolic extrema (via calc/critical-points-1d) can be more reliable if f is known.")
  :usecases ("Optimisation: finding local maxima/minima for curve fitting or control." "Physics: locating energy extrema or equilibrium points." "Data analysis: identifying peaks and valleys in sampled signals.")
  :related ("calc/critical-points-1d" "calc/second-derivative" "calc/derivative" "calc/differentiable?")
  :learn (:concept "Second derivative test; how concavity (f'' > 0 vs < 0) classifies critical points." :prerequisites ("calc/derivative" "calc/critical-points-1d" "calc/second-derivative") :progression "calc/gradient → calc/hessian (for multivariate extrema)")
  :row-2-audit (
    (:programs (
      (:code "(define drag (lambda (v) (+ (* 0.5 v v) (* -3 v) 4)))\n;; Minimize drag: d/dv(0.5v²-3v+4) = v-3 = 0 at v=3\n(calc/extrema-1d drag 0 5)\n;; => includes (3 min ≈ 0.5) — optimal operating speed" :tags (eng program))
      (:code "(calc/extrema-1d (lambda (x) (* x x)) -2 2)\n;; x²: critical point x=0 (min, f=0); endpoints x=±2 (f=4)\n;; => classified list with minimum at 0" :tags (math program))
      (:code "(define (best-minimum f a b)\n  ;; Extract the global minimum from classified extrema\n  (let ((ext (calc/extrema-1d f a b)))\n    (let loop ((xs ext) (best-x #f) (best-v +inf.0))\n      (if (null? xs) (list 'min-at best-x 'value best-v)\n        (let ((e (car xs)))\n          (if (and (eq? (cadr e) 'min) (< (caddr e) best-v))\n              (loop (cdr xs) (car e) (caddr e))\n              (loop (cdr xs) best-x best-v)))))))\n(best-minimum (lambda (x) (+ (* x x) (* -4 x) 5)) 0 4)\n;; => (min-at 2 value 1)" :tags (cs program)))
     :problem "An optimization needs both max and min of a smooth function on a bounded interval — not just critical points but classified extrema."
     :explanation "Min at x=0 (value 0), max at x=±2 (value 4); operator sees the classified extrema."
     :meta "critical-points-1d returns all f'=0 candidates; extrema-1d additionally checks endpoints and classifies. Use extrema-1d when you want the answer, not the candidates.")
    (:eng "Drag minimization: one call finds the optimal speed; value at minimum is the operating point."
     :math "x²: global min is x=0 with f=0; endpoints give local max f=4; both appear in list."
     :cs "best-minimum scans the result list for the smallest 'min entry; composable with any objective."))
  :row-3-dimension (
    (:setup "'max/min of a continuous function on a compact interval'"
     :rungs (
       (:domain "calc native" :code "(calc/extrema-1d (lambda (x) (* x x)) -2 2)")
       (:domain "brightest/darkest pixel in a scanline" :code "(calc/extrema-1d (lambda (x) (* x x)) -2 2)\n;; x²: critical point x=0 (min, f=0); endpoints x=±2 (f=4)\n;; => classified list with minimum at 0")
       (:domain "extreme value theorem application" :code "(calc/extrema-1d (lambda (x) (* x x)) -2 2)"))
     :explanation "Rung 1 is calc/extrema-1d in its native library. Rung 2 shows the same ''max/min of a continuous function on a compact interval'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''max/min of a continuous function on a compact interval'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/extrema-1d."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (x) (- (* x x) x)))\n(define ext (calc/extrema-1d f 0 1))\n;; x²-x; f'=2x-1=0 at x=0.5; f(0.5)=-0.25 (min)\n(pair? ext)\n;; => #t — EVT: continuous f on compact [0,1] has at least one extremum" :tags (eng program))
      (:code "(define f (lambda (x) (- (* x x) x)))\n(define ext (calc/extrema-1d f 0 1))\n(pair? ext)\n;; Extreme value theorem: f continuous on [0,1] ⇒ attains max and min" :tags (math program))
      (:code "(define (has-min-and-max? f a b)\n  (let ((ext (calc/extrema-1d f a b)))\n    (and (pair? ext) (> (length ext) 0))))\n(has-min-and-max? (lambda (x) (sin x)) 0 (* 2 3.14159))\n;; => #t — sin has both max (1) and min (-1) on full period" :tags (cs program)))
     :claim "A continuous function on [a, b] attains its max and min in [a, b]."
     :invariant "f continuous on [a, b] ⇒ ∃ M m. ∀ x ∈ [a, b]. f(m) ≤ f(x) ≤ f(M)"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch13-calculus-1 and ch14-calculus-2.")
    (:eng "EVT smoke test: any non-empty extrema list confirms continuity-based guarantee holds."
     :math "f=x²-x on [0,1]: min at x=0.5, f=-0.25; both endpoints also classified."
     :cs "has-min-and-max? is a precondition guard for downstream optimization code."))
  :row-5-emergence (
    (:programs (
      (:code "(define energy (lambda (x) (+ (* x x x) (* -3 x x))))\n(define ext (calc/extrema-1d energy -1 3))\n(define cps (calc/critical-points-1d energy -1 3))\n(list 'critical cps 'classified ext)\n;; Shows critical points vs classified extrema — classify adds the second-derivative verdict" :tags (eng composition))
      (:code "(define f (lambda (x) (* x x x)))\n(list (calc/extrema-1d f -1 1) (calc/critical-points-1d f -1 1))\n;; x³ on [-1,1]: no interior extrema (inflection at 0); critical-points returns (0); extrema returns ()" :tags (math composition))
      (:code "(define (optimization-report f a b)\n  (let ((ext (calc/extrema-1d f a b)))\n    (map (lambda (e)\n           (list 'x (car e)\n                 'type (cadr e)\n                 'value (caddr e)))\n         ext)))\n(optimization-report (lambda (x) (+ (* 2 x x) (* -8 x) 6)) 0 5)\n;; => ((x 2 type min value -2))" :tags (cs composition)))
     :base "calc/extrema-1d — see :summary."
     :emergent "optimum-finder"
     :meta "The emergent optimum-finder belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Extremum finding + gradient descent = classical vs numerical optimization. See book-of-ml ch-06.")
    (:eng "Critical vs classified: the pair shows the audit trail from candidates to final typed extrema."
     :math "x³ on [-1,1]: x=0 is critical (inflection) but not a max or min; extrema-1d correctly returns empty interior list."
     :cs "optimization-report gives machine-readable output with type and value; ready for downstream sorting."))
)

(verb
  :name "calc/gradient" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/gradient f point) -> vector"
  :summary "Computes the gradient ∇f, the vector of all partial derivatives of a multivariable function at a point."
  :explanation "The gradient is the multivariable analogue of the derivative. For a function f(x, y, z, ...), the gradient ∇f is the vector (∂f/∂x, ∂f/∂y, ∂f/∂z, ...). It points in the direction of steepest ascent and is perpendicular to level sets. Use the gradient to find search directions in optimisation, to compute directional derivatives, and to analyse how output changes with each input."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define f (lambda (pt) (+ (* 2 (car pt)) (* 3 (cadr pt)))))\n(calc/gradient f (list 1 1))" :note "f(x,y)=2x+3y; gradient is (2, 3) everywhere (constant)")
    (:dialect "motoi" :tier "intermediate" :code "(define f (lambda (pt) (* (car pt) (cadr pt))))\n(let ((grad (calc/gradient f (list 2 3))))\n  (list (car grad) (cadr grad)))" :note "f(x,y)=xy; gradient at (2,3) is (∂f/∂x=y, ∂f/∂y=x) = (3, 2)")
    (:dialect "motoi" :tier "expert" :code "(define point '(0 0))\n(define f (lambda (pt) (+ (* (car pt) (car pt)) (* (cadr pt) (cadr pt)))))\n(let ((point (list 1 1))\n      (grad (calc/gradient f point)))\n  (let ((mag (sqrt (+ (* (car grad) (car grad)) (* (cadr grad) (cadr grad))))))\n    (list 'direction (list (/ (car grad) mag) (/ (cadr grad) mag))\n          'magnitude mag)))" :note "f(x,y)=x²+y²; at (1,1), gradient is (2,2), magnitude 2√2; normalise for steepest-ascent direction")
  )
  :caveats ("Numeric; finite-difference errors compound if f is noisy or oscillatory." "Point must be in the interior of the domain; behaviour near boundaries may be unreliable." "Does not verify that f is differentiable; may return nonsense at corners or discontinuities." "Linear functions have constant gradient; very expensive to compute many gradients if used repeatedly.")
  :drawbacks ("Each call requires n+1 function evaluations for n-dimensional f; quadratic in dimension for Hessian." "For functions with known symbolic gradient, compute once and store." "Scales poorly to very high-dimensional problems; use algorithmic differentiation if available.")
  :usecases ("Gradient descent: iteratively move in direction of negative gradient to minimise f." "Sensitivity: quantify dependence of output on each input at a point." "Contour analysis: compute normal direction perpendicular to level sets.")
  :related ("calc/directional-derivative" "calc/hessian" "calc/jacobian" "calc/laplacian")
  :learn (:concept "Gradient as vector of all partial derivatives; direction of steepest ascent; perpendicularity to level sets." :prerequisites ("calc/derivative" "basic multivariable calculus") :progression "calc/directional-derivative → calc/hessian → calc/jacobian")
  :row-2-audit (
    (:programs (
      (:code "(define loss (lambda (w) (+ (expt (- (car w) 3) 2) (expt (- (cadr w) 5) 2))))\n(calc/gradient loss (list 1 2))\n;; L = (w1-3)² + (w2-5)²; ∇L = (2(w1-3), 2(w2-5))\n;; at (1,2): (2·(-2), 2·(-3)) = (-4 -6)\n;; => ≈ (-4 -6)" :tags (eng program))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/gradient f (list 1 2))\n;; ∇(x²+y²) = (2x, 2y); at (1,2): (2, 4)\n;; => ≈ (2 4)" :tags (math program))
      (:code "(define (gradient-magnitude f pt)\n  (let ((g (calc/gradient f pt)))\n    (sqrt (apply + (map (lambda (gi) (* gi gi)) g)))))\n(gradient-magnitude\n  (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p))))\n  (list 3 4))\n;; ∇f=(6,8) at (3,4); |∇f|=√(36+64)=10\n;; => ≈ 10.0" :tags (cs program)))
     :problem "A neural-network training step needs ∇L(w) — the gradient of loss with respect to parameters — as a plain vector to feed into an SGD update."
     :explanation "∇f = (2x, 2y); at (1, 2), gradient = (2, 4); operator sees (2 4)."
     :meta "partial gives one component; gradient bundles all of them into a vector. Use gradient when you want to update all parameters at once.")
    (:eng "Loss gradient at (1,2) is (-4,-6); this is the update direction for SGD step w ← w - lr·∇L."
     :math "x²+y²: exact gradient (2,4) at (1,2); numerical should match to 3+ significant figures."
     :cs "gradient-magnitude gives the norm; use to set learning rate or check gradient vanishing."))
  :row-3-dimension (
    (:setup "'vector of partial derivatives'"
     :rungs (
       (:domain "calc native" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))")
       (:domain "per-pixel light-vector" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/gradient f (list 1 2))\n;; ∇(x²+y²) = (2x, 2y); at (1,2): (2, 4)\n;; => ≈ (2 4)")
       (:domain "∇f = (∂_1 f, ∂_2 f, …, ∂_n f)" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/gradient f (list 1 2))\n;; ∇(x²+y²) = (2x, 2y); at (1,2): (2, 4)\n;; => ≈ (2 4)"))
     :explanation "Rung 1 is calc/gradient in its native library. Rung 2 shows the same ''vector of partial derivatives'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''vector of partial derivatives'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/gradient."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define pt (list 1 1))\n(define g (calc/gradient f pt))\n(define gmag (sqrt (+ (* (car g) (car g)) (expt (cadr g) 2))))\n(define unit-g (list (/ (car g) gmag) (/ (cadr g) gmag)))\n(> (calc/directional-derivative f pt unit-g)\n   (calc/directional-derivative f pt (list 1 0)))\n;; gradient direction ≈ 2.83; x-direction = 2; gradient wins" :tags (eng program))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define p (list 1 1))\n(define g (calc/gradient f p))\n(define g-mag (sqrt (+ (* (car g) (car g)) (* (cadr g) (cadr g)))))\n(> (calc/directional-derivative f p (list (/ (car g) g-mag) (/ (cadr g) g-mag)))\n   (calc/directional-derivative f p (list 1 0)))\n;; => #t — steepest direction beats x-axis direction" :tags (math program))
      (:code "(define (steepest-beats-axis? f pt)\n  (let* ((g (calc/gradient f pt))\n         (gmag (sqrt (apply + (map (lambda (gi) (* gi gi)) g))))\n         (unit-g (map (lambda (gi) (/ gi gmag)) g))\n         (d-steepest (calc/directional-derivative f pt unit-g))\n         (d-x (calc/directional-derivative f pt (list 1 0 0))))\n    (> d-steepest d-x)))\n(steepest-beats-axis?\n  (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p))))\n  (list 1 2))\n;; => #t" :tags (cs program)))
     :claim "The gradient points in the direction of steepest ascent of f."
     :invariant "∀ unit v. D_v f(x) ≤ |∇f(x)|, equality at v = ∇f/|∇f|"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch15-multivariable-linear-algebra. Also book-of-ml ch-06 (gradient descent) — this is the primitive of gradient descent.")
    (:eng "At (1,1): gradient direction gives rate 2√2≈2.83; x-axis gives 2; gradient wins as expected."
     :math "∇(x²+y²)=(2,2) at (1,1); magnitude 2√2; unit gradient beats any other direction."
     :cs "steepest-beats-axis? is a generic property test; works for any f and starting point."))
  :row-5-emergence (
    (:programs (
      (:code "(define loss (lambda (w) (+ (expt (car w) 2) (expt (cadr w) 2))))\n(define lr 0.1)\n(define (sgd-step w) (let ((g (calc/gradient loss w)))\n  (map (lambda (wi gi) (- wi (* lr gi))) w g)))\n(let loop ((n 0) (w (list 3 4)))\n  (if (= n 10) w (loop (+ n 1) (sgd-step w))))\n;; converges toward (0 0) — minimum of x²+y²" :tags (eng composition))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define lr 0.1)\n(define step (lambda (p) (let ((g (calc/gradient f p)))\n  (list (- (car p) (* lr (car g))) (- (cadr p) (* lr (cadr g)))))))\n(let loop ((n 0) (cur (list 3 3)))\n  (cond ((= n 5) cur) (else (loop (+ n 1) (step cur)))))\n;; => ≈ (1.77 1.77) after 5 steps from (3,3)" :tags (math composition))
      (:code "(define (gradient-path f start lr steps)\n  (let loop ((n 0) (pt start) (path (list start)))\n    (if (= n steps) (reverse path)\n      (let* ((g (calc/gradient f pt))\n             (next (map (lambda (xi gi) (- xi (* lr gi))) pt g)))\n        (loop (+ n 1) next (cons next path))))))\n(gradient-path (lambda (p) (+ (expt (car p) 2) (expt (cadr p) 2)))\n               (list 4 3) 0.2 5)\n;; => descent path from (4,3) toward origin" :tags (cs composition)))
     :base "calc/gradient — see :summary."
     :emergent "gradient-descent-step"
     :meta "The emergent gradient-descent-step belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Gradient + learning rate = one SGD step; the universal ML primitive. See book-of-ml ch-06 and ch-10.")
    (:eng "10 SGD steps from (3,4) converge toward (0,0); engineering use: tune lr by watching convergence speed."
     :math "5 steps from (3,3) give ≈(1.77,1.77); each step multiplies coordinates by (1-2lr)=0.8."
     :cs "gradient-path accumulates the full trajectory; visualize or analyze convergence in one call."))
)

(verb
  :name "calc/hessian" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/hessian f point) -> matrix"
  :summary "Computes the Hessian matrix, a symmetric matrix of all second partial derivatives at a point."
  :explanation "The Hessian is the Jacobian of the gradient: it contains all mixed partial derivatives ∂²f/∂xᵢ∂xⱼ. For a twice-differentiable function, the Hessian is symmetric. It encodes how the gradient itself is changing: its eigenvalues determine the curvature of the function along different directions. Use the Hessian to classify critical points (saddle, min, max) and to design second-order optimisation algorithms."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define f (lambda (pt) (+ (* (car pt) (car pt)) (* 2 (cadr pt) (cadr pt)))))\n(calc/hessian f (list 0 0))" :note "f(x,y)=x²+2y²; Hessian is [[2, 0], [0, 4]] everywhere (diagonal, constant curvature)")
    (:dialect "motoi" :tier "intermediate" :code "(define f (lambda (pt) (* (car pt) (cadr pt))))\n(let ((h (calc/hessian f (list 1 1))))\n  h)" :note "f(x,y)=xy; Hessian is [[0, 1], [1, 0]] everywhere (saddle point signature)")
    (:dialect "motoi" :tier "expert" :code "(define f (lambda (pt) (+ (* (car pt) (car pt) (car pt)) (cadr pt))))\n(let ((h (calc/hessian f (list 2 3))))\n  (let ((trace (+ (car (car h)) (cadr (cadr h)))))\n    (if (< trace 0) 'likely-max (if (> trace 0) 'likely-min 'inconclusive))))" :note "Use trace of Hessian (sum of eigenvalues) as rough concavity heuristic; preferable: compute eigenvalues via linalg/eigenvalues")
  )
  :caveats ("Numeric: expensive (O(n²) function evaluations for n dimensions) and prone to noise." "Assumes continuity of mixed partials (Schwarz's theorem); may be asymmetric if violated." "At critical points with f'' ≈ 0, eigenvalue classification becomes unreliable." "Does not check that f is twice differentiable.")
  :drawbacks ("Slow for high-dimensional functions; quadratic scaling in number of variables." "If only eigenvalues needed (for classification), use symbolic computation or linalg/eigenvalues-2x2 for small cases." "Numeric Hessian becomes very ill-conditioned for nearly-linear functions.")
  :usecases ("Newton's method: use Hessian inverse to accelerate optimisation." "Classification of critical points: eigenvalues determine whether min/max/saddle." "Second-order sensitivity: quantify curvature of objective function.")
  :related ("calc/gradient" "calc/directional-derivative" "calc/jacobian" "calc/laplacian" "calc/extrema-1d" "linalg/eigenvalues")
  :learn (:concept "Hessian as Jacobian of gradient; eigenvalues as principal curvatures; second-derivative test." :prerequisites ("calc/gradient" "calc/second-derivative" "basic linear algebra") :progression "linalg/eigenvalues → optimisation algorithms (beyond this library)")
  :row-2-audit (
    (:programs (
      (:code "(define f (lambda (p) (+ (expt (car p) 2) (* 3 (expt (cadr p) 2)))))\n(calc/hessian f (list 0 0))\n;; H = [[∂²f/∂x², ∂²f/∂x∂y], [∂²f/∂y∂x, ∂²f/∂y²]]\n;; = [[2, 0], [0, 6]] — diagonal, constant curvature" :tags (eng program))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/hessian f (list 0 0))\n;; Hessian of x²+y² is [[2,0],[0,2]] everywhere\n;; => ≈ ((2 0) (0 2))" :tags (math program))
      (:code "(define (trace-of-hessian f pt)\n  ;; Laplacian = trace of Hessian = sum of diagonal elements\n  (let ((H (calc/hessian f pt)))\n    (apply + (map (lambda (i) (list-ref (list-ref H i) i))\n                  (range 0 (length H))))))\n(trace-of-hessian\n  (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p))))\n  (list 1 1))\n;; => ≈ 4 — trace = Laplacian" :tags (cs program)))
     :problem "A second-order optimizer (Newton, quasi-Newton) needs the Hessian matrix of second partials at a point."
     :explanation "Hessian of x^2 + y^2 is [[2, 0], [0, 2]]; operator sees that matrix."
     :meta "Gradient is first-order; Hessian is second-order. Newton needs the Hessian to invert; SGD needs only the gradient.")
    (:eng "x²+3y²: Hessian is [[2,0],[0,6]]; anisotropic curvature means different step sizes per axis."
     :math "x²+y²: Hessian [[2,0],[0,2]] is isotropic — same curvature in all directions."
     :cs "trace-of-hessian computes the Laplacian without a separate call; handy for PDE residuals."))
  :row-3-dimension (
    (:setup "'second-derivative tensor'"
     :rungs (
       (:domain "calc native" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))")
       (:domain "local curvature of a terrain" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/hessian f (list 0 0))\n;; Hessian of x²+y² is [[2,0],[0,2]] everywhere\n;; => ≈ ((2 0) (0 2))")
       (:domain "Hessian matrix" :code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(calc/hessian f (list 0 0))\n;; Hessian of x²+y² is [[2,0],[0,2]] everywhere\n;; => ≈ ((2 0) (0 2))"))
     :explanation "Rung 1 is calc/hessian in its native library. Rung 2 shows the same ''second-derivative tensor'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''second-derivative tensor'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/hessian."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
    (:programs (
      (:code "(define f (lambda (p) (+ (* (car p) (cadr p)) (* (car p) (car p)))))\n(define H (calc/hessian f (list 1 1)))\n(< (abs (- (list-ref (list-ref H 0) 1) (list-ref (list-ref H 1) 0))) 0.02)\n;; H[0][1] and H[1][0] should both be ≈1; symmetry confirmed" :tags (eng program))
      (:code "(define f (lambda (p) (+ (* (car p) (cadr p)) (* (car p) (car p)))))\n(define H (calc/hessian f (list 1 1)))\n(< (abs (- (list-ref (list-ref H 0) 1) (list-ref (list-ref H 1) 0))) 0.01)\n;; Schwarz: ∂²f/∂x∂y = ∂²f/∂y∂x for f ∈ C²" :tags (math program))
      (:code "(define (symmetric? H tol)\n  (let ((n (length H)))\n    (let outer ((i 0) (ok #t))\n      (if (or (not ok) (= i n)) ok\n        (let inner ((j 0) (ok ok))\n          (if (= j n) (outer (+ i 1) ok)\n            (inner (+ j 1)\n                   (and ok (< (abs (- (list-ref (list-ref H i) j)\n                                     (list-ref (list-ref H j) i))) tol)))))))))\n(symmetric? (calc/hessian (lambda (p) (* (car p) (cadr p))) (list 2 3)) 0.05)\n;; => #t" :tags (cs program)))
     :claim "For f ∈ C^2, the Hessian is symmetric: H_{ij} = H_{ji} (Schwarz)."
     :invariant "f ∈ C^2 ⇒ ∂²f/∂x_i ∂x_j = ∂²f/∂x_j ∂x_i"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch15-multivariable-linear-algebra.")
    (:eng "Off-diagonal entries match to within tolerance: numerical Schwarz check passes."
     :math "f = xy + x²; H = [[2, 1], [1, 0]]; H[0][1] = H[1][0] = 1."
     :cs "symmetric? is a generic matrix predicate; apply to any computed Hessian as a regression check."))
  :row-5-emergence (
    (:programs (
      (:code "(define f (lambda (p) (+ (expt (car p) 2) (expt (cadr p) 2))))\n(define pt (list 1 2))\n(define g (calc/gradient f pt))\n(define H (calc/hessian f pt))\n;; Newton step: p_next = p - H⁻¹·g\n;; For diag H=[[2,0],[0,2]]: H⁻¹·g = (g/2)\n(list 'gradient g 'hessian H\n     'newton-step (map (lambda (gi) (/ gi 2)) g))\n;; newton step moves from (1,2) toward (0,0) in one step" :tags (eng composition))
      (:code "(define f (lambda (p) (+ (* (car p) (car p)) (* (cadr p) (cadr p)))))\n(define p (list 1 1))\n(define g (calc/gradient f p))\n(define H (calc/hessian f p))\n(list g H)\n;; => ((2 2) ((2 0) (0 2))) — gradient and curvature ready for Newton step" :tags (math composition))
      (:code "(define (newton-step-2d f pt)\n  ;; One Newton step for 2D f: pt_next = pt - H⁻¹·∇f\n  ;; For diagonal H: H⁻¹_{ii} = 1/H_{ii}\n  (let* ((g (calc/gradient f pt))\n         (H (calc/hessian f pt))\n         (h00 (list-ref (list-ref H 0) 0))\n         (h11 (list-ref (list-ref H 1) 1)))\n    (list (- (car  pt) (/ (car  g) h00))\n          (- (cadr pt) (/ (cadr g) h11)))))\n(newton-step-2d (lambda (p) (+ (expt (car p) 2) (* 2 (expt (cadr p) 2))))\n                (list 3 4))\n;; => (0 0) — exact in one step for quadratic f" :tags (cs composition)))
     :base "calc/hessian — see :summary."
     :emergent "newton-step-input"
     :meta "The emergent newton-step-input belongs to the family of composed behaviours where one verb's output feeds the next verb's input, and the pair carries meaning neither verb has alone. Gradient + Hessian = Newton step; see book-of-ml appendix-a (math prereqs).")
    (:eng "For x²+y², H=[[2,0],[0,2]]; Newton step from (1,2) = (1,2) - (1,1) = (0,1); exact in one step."
     :math "Gradient + Hessian packaged together is the sufficient statistic for Newton-Raphson update."
     :cs "newton-step-2d shows the full pattern; for diagonal H the inverse is trivial — no linalg solver needed."))
)

(verb
  :name "calc/integral" :std "Motoi"
  :library "calc"
  :kind "meta"
  :signature "(calc/integral f a b) -> number"
  :summary "Computes the definite integral ∫ₐᵇ f(x) dx using composite Simpson's rule."
  :explanation "The integral measures the signed area under a curve. Rather than compute symbolically, this verb numerically estimates the area by dividing [a, b] into intervals and summing parabolic approximations (Simpson's rule is more accurate than simple rectangles). Use it to compute total quantities (distance, work, probability) or to invert derivatives when a symbolic antiderivative is unavailable."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(define f (lambda (x) 1))\n(calc/integral f 0 5)" :note "Integral of constant 1 from 0 to 5 is exactly 5 (area of rectangle)")
    (:dialect "motoi" :tier "intermediate" :code "(define f (lambda (x) (* x x)))\n(let ((approx (calc/integral f 0 3))\n      (exact (/ 27 3)))\n  (list 'approx approx 'exact exact))" :note "∫₀³ x² dx = x³/3|₀³ = 9; Simpson's rule should be very close")
    (:dialect "motoi" :tier "expert" :code "(define exp-x (lambda (x) (exp x)))\n(let ((a 0) (b 1))\n  (let ((area (calc/integral exp-x a b)))\n    (let ((average (/ area (- b a))))\n      (list 'integral area 'average-value average))))" :note "Compute integral, then divide by interval width to get calc/average-value directly")
  )
  :caveats ("Numeric; accuracy depends on smoothness of f and interval width." "Fails on discontinuities, singularities, or oscillations with period smaller than step size." "Integration over very wide intervals may accumulate rounding error." "Simpson's rule assumes f is smooth; highly oscillatory functions need finer subdivision (not exposed here).")
  :drawbacks ("No adaptive subdivision: fixed-size intervals mean coarse functions may be under-sampled." "Much slower than symbolic antiderivative if one exists." "Not suitable for improper integrals (infinite bounds); use mathematical transformation first.")
  :usecases ("Physics: computing work, displacement, or total charge from rates of change." "Probability: computing cumulative distribution or expected value numerically." "Engineering: area under experimental curves or signal processing.")
  :related ("calc/average-value" "calc/riemann-sum" "calc/arc-length" "calc/volume-revolution" "calc/surface-revolution")
  :learn (:concept "Definite integral as signed area; Simpson's rule as piecewise parabolic approximation." :prerequisites ("calc/derivative" "basic integral calculus") :progression "calc/average-value → calc/riemann-sum → calc/arc-length")
  :row-2-audit (
   
    (:problem "A total-area or accumulated-quantity computation needs ∫ f dx over an interval; analytic antiderivatives are often unavailable, so numerical integration is the honest tool."
     :programs (
       (:code "(calc/integral (lambda (x) (* x x)) 0 1)" :tags (program)))
     :explanation "∫₀¹ x² dx = 1/3; operator sees ≈ 0.333."
     :meta "riemann-sum exposes the mesh; integral hides it behind an adaptive method. For pedagogy, use riemann-sum; for production, integral.")
    (:problem "A displacement-from-velocity read-out needs ∫ v dt over a time window when only a velocity function is available."
     :programs (
       (:code "(define v (lambda (t) (+ 3 (* 2 t))))\n(calc/integral v 0 4)" :tags (math program)))
     :explanation "∫₀⁴ (3 + 2t) dt = 3·4 + 4² = 12 + 16 = 28; operator sees ≈ 28 metres travelled."
     :meta "The integral inverts calc/derivative: velocity is the derivative of position, so integrating velocity recovers displacement. Fundamental theorem in action.")
    (:problem "A probability mass check needs ∫ p(x) dx over the support; a density that integrates to 1 is a valid distribution, otherwise it must be renormalised."
     :programs (
       (:code "(define p (lambda (x) (* 6 x (- 1 x))))\n(< (abs (- (calc/integral p 0 1) 1)) 0.01)" :tags (cs program)))
     :explanation "The Beta(2,2)-like density 6x(1−x) integrates to 1 over [0,1]; the check returns #t, certifying a valid PDF before sampling."
     :meta "Same accumulation shape as the area case, but the audit question is 'is total mass 1?' rather than 'how much area?' — a normalisation gate.")
    (:eng "The operator gets one line per call; failure surfaces the exact input that broke the expectation."
     :math "Category: calc-1d; the verb operates within its declared algebraic type."
     :cs "Complexity as declared in the signature; deterministic and testable."))
  :row-3-dimension (
    (:setup "'accumulated area under a curve'"
     :rungs (
       (:domain "calc native" :code "(calc/integral (lambda (x) (* x x)) 0 1)")
       (:domain "total volume-samples of an audio window" :code "(calc/integral (lambda (x) (* x x)) 0 1)")
       (:domain "Riemann integral" :code "(define f (lambda (x) (* x x)))\n(calc/average-value f 0 1)\n;; (1/(1-0)) ∫₀¹ x² dx = [x³/3]₀¹ = 1/3 ≈ 0.333"))
     :explanation "Rung 1 is calc/integral in its native library. Rung 2 shows the same ''accumulated area under a curve'' shape in a metaphor domain. Rung 3 lifts the shape into a math/logical setting where the transfer is formal. Recognizing the same shape in all three lets the reader carry the verb's intuition into problems Motoi does not directly cover."
     :meta "The shape transfers because ''accumulated area under a curve'' is substrate-independent — the same relationship holds whenever the underlying category admits the required structure.")
    (:eng "Engineers who have met the shape elsewhere already know when to reach for calc/integral."
     :math "The shape is captured by a small equation set; each rung is a model of that equation set."
     :cs "Once the shape is named, the same algorithm skeleton (traverse, close, compare) applies at each rung."))
  :row-4-proof (
   
    (:claim "The integral is linear and additive over intervals: ∫_a^c f = ∫_a^b f + ∫_b^c f for a ≤ b ≤ c."
     :programs (
       (:code "(define f (lambda (x) (* x x)))\n(< (abs (- (calc/integral f 0 2) (+ (calc/integral f 0 1) (calc/integral f 1 2)))) 0.01)" :tags (program)))
     :invariant "∀ a ≤ b ≤ c. ∫_a^c f = ∫_a^b f + ∫_b^c f"
     :meta "The invariant is the algebraic essence of the verb; a single counter-example would falsify it and prove the implementation broken. See book-of-math ch13-calculus-1 and ch14-calculus-2. Also ch-advanced-10 (Numerical Methods) for adaptive quadrature.")
    (:claim "Homogeneity: scaling the integrand scales the integral by the same factor, ∫ (k·f) = k·∫ f."
     :programs (
       (:code "(define f (lambda (x) (exp x)))\n(< (abs (- (calc/integral (lambda (x) (* 5 (f x))) 0 1) (* 5 (calc/integral f 0 1)))) 0.01)" :tags (math program)))
     :invariant "∀ k. ∫_a^b k·f(x) dx = k ∫_a^b f(x) dx"
     :meta "Linearity has two halves — additivity over the integrand and homogeneity of scale; together they make the integral a linear functional on function space.")
    (:claim "Reversing the limits negates the integral: ∫_a^b f = −∫_b^a f."
     :programs (
       (:code "(define f (lambda (x) (* x x x)))\n(< (abs (+ (calc/integral f 1 3) (calc/integral f 3 1))) 0.01)" :tags (cs program)))
     :invariant "∫_a^b f = −∫_b^a f  ⇒  ∫_a^b f + ∫_b^a f = 0"
     :meta "Orientation of the interval carries a sign; this is why oriented integrals compose consistently and why a null-loop integral vanishes.")
    (:eng "The runnable claim doubles as a CI smoke test — if the invariant ever prints #f, the verb has drifted."
     :math "The invariant is the defining property in the calc-1d category."
     :cs "Property-based test: the program above is a runnable falsifier candidate for a QuickCheck-style fuzzer."))
  :row-5-emergence (
   
    (:base "calc/integral — see :summary."
