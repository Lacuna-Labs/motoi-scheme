    (:dialect "motoi" :tier "novice"       :code "(exact/< (exact/rat 1 3) (exact/rat 1 2))" :note "1/3 < 1/2. #t.")
    (:dialect "motoi" :tier "intermediate" :code "(define a (exact/rat 1 4))\n(define b (exact/rat 1 3))\n(define c (exact/rat 1 2))\n(and (exact/< a b) (exact/< b c))" :note "Chained ordering.")
    (:dialect "motoi" :tier "expert"       :code "(define (sort-rationals xs) (sort xs exact/<))\n(sort-rationals (list (exact/rat 1 3) (exact/rat 1 2) (exact/rat 1 4)))" :note "Sort using exact ordering — no float misordering near ties."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
