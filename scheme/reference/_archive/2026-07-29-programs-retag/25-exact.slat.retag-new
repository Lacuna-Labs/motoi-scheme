      (:code "(define (reduced-form? n d) (let ((r (exact/rat n d))) (and (rational? r) (or (= (denominator r) 1) (= (gcd (numerator r) (denominator r)) 1)))))\n(reduced-form? 6 8)" :tags (eng program))
      (:code "(define (equal-under-reduction? n1 d1 n2 d2) (exact/= (exact/rat n1 d1) (exact/rat n2 d2)))\n(equal-under-reduction? 3 4 6 8)" :tags (math program))
