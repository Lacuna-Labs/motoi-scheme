     :explanation "eng: refund. math: additive inverse. cs: type-safe."
     :meta "Reach for exact/neg and NOT (- 0 a): explicit intent, cheaper.")
    (:eng "Refund = -charge." :math "exact/neg : ℚ → ℚ." :cs "Sign-flip on tagged rational."))
  :row-3-dimension (
    (:setup "Additive-inverse projection."
     :rungs (
       (:domain "engineering"  :code "(define (additive-inverse a) (exact/neg a))\n(additive-inverse (exact/rat 3 4))")
       (:domain "mathematics"  :code "(define (additive-inverse a) (exact/neg a))\n(additive-inverse (exact/rat 3 4))")
       (:domain "cs / dispatch" :code "(define (additive-inverse a) (exact/neg a))\n(additive-inverse (exact/rat 3 4))"))
     :explanation "Refunds, math negation, sign flipping on parsed values."
     :meta "Negation is universal.")
    (:eng "Sign flip supports both directions." :math "Group inverse." :cs "One-op transformation."))
  :row-4-proof (
    (:programs (
      (:code "(define (inverse-identity a) (exact/= (exact/+ a (exact/neg a)) (exact/rat 0 1)))\n(inverse-identity (exact/rat 3 4))" :tags (eng program))
      (:code "(define (involution a) (exact/= (exact/neg (exact/neg a)) a))\n(involution (exact/rat 3 4))" :tags (math program))
      (:code "(define (distributes-over-add? a b) (exact/= (exact/neg (exact/+ a b)) (exact/+ (exact/neg a) (exact/neg b))))\n(distributes-over-add? (exact/rat 1 2) (exact/rat 1 3))" :tags (cs program)))
     :claim "exact/neg is the additive inverse; involution; distributes over +."
     :invariant "∀ a. a + (-a) = 0 ∧ -(-a) = a ∧ -(a+b) = (-a) + (-b)"
