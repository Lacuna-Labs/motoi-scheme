(verb :name "exact/rat" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/rat n d) -> rational"
  :summary "Construct an exact rational n/d in reduced form."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/rat 3 4)" :note "3/4.")
