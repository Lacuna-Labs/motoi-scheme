  :row-3-dimension (
    (:setup "Constructor for exact rationals."
     :rungs (
       (:domain "engineering"  :code "(define (as-ratio a b) (exact/rat a b))\n(exact/->string (as-ratio 7 22))")
       (:domain "mathematics"  :code "(define (as-ratio a b) (exact/rat a b))\n(exact/->string (as-ratio 7 22))")
       (:domain "cs / dispatch" :code "(define (as-ratio a b) (exact/rat a b))\n(exact/->string (as-ratio 7 22))"))
     :explanation "Money, math ratios, parsed input."
     :meta "Construction is universal.")
    (:eng "Money is a rational." :math "Every ℚ member built from (n, d)." :cs "Parse-then-construct pattern."))
  :row-4-proof (
