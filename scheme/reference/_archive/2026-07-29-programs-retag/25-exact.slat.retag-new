;;; 25-exact.slat — Motoi Scheme Reference · Chapter 25 · library exact
;;;
;;; 19 verbs in this library. Read chapter 00-intro.slat first.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;
;;; All 19 verbs upgraded to full 15-program standard 2026-07-22.

(dialect :applies ("motoi") :note "Library exact — 19 verbs.")

(chapter :number "25" :library "exact" :verb-count 19 :training-eligible #t)

;; ═══ 19 verbs in library exact ═══

(verb :name "exact/*" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/* a b) -> rational"
  :summary "Multiply two exact rationals; result auto-reduces to lowest terms."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/* (exact/rat 2 3) (exact/rat 3 4))" :note "2/3 × 3/4 = 6/12 = 1/2 exactly. No rounding.")
    (:dialect "motoi" :tier "intermediate" :code "(exact/->string (exact/* (exact/rat 19 2) (exact/rat 5 1)))" :note "5 items at 9.50 each = 95/2 exactly. No float error.")
    (:dialect "motoi" :tier "expert"       :code "(define (compound-scale base scales) (fold (lambda (acc s) (exact/* acc s)) base scales))\n(compound-scale (exact/rat 100 1) (list (exact/rat 1 2) (exact/rat 2 3) (exact/rat 3 4)))" :note "Chained scaling. Every step exact; final result exact."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (financial-total price qty) (exact/* price qty))\n(exact/->string (financial-total (exact/rat 19 2) (exact/rat 5 1)))" :tags (eng program))
      (:code "(define (scale-vector v s) (map (lambda (x) (exact/* x s)) v))\n(scale-vector (list (exact/rat 1 2) (exact/rat 3 4)) (exact/rat 2 3))" :tags (math program))
      (:code "(define (typed-product a b) (if (and (rational? a) (rational? b)) (exact/* a b) (error 'shape 'need-rationals)))\n(typed-product 3 (exact/rat 2 5))" :tags (cs program)))
     :problem "Financial multiply cannot admit float rounding. Every calculation must preserve exact precision. exact/* is the safe primitive."
     :explanation "eng: pricing. math: vector scaling. cs: type-guarded op."
     :meta "Reach for exact/* and NOT *: * is the numeric multiplier and drops precision on floats.")
    (:eng "Money math: cents cannot round." :math "exact/* : ℚ × ℚ → ℚ (closed)." :cs "O(GCD-reduction) per op."))
  :row-3-dimension (
    (:setup "Closure under an exact operation."
     :rungs (
       (:domain "engineering"  :code "(define (scale-vector v s) (map (lambda (x) (exact/* x s)) v))\n(scale-vector (list (exact/rat 1 2) (exact/rat 3 4)) (exact/rat 2 3))")
       (:domain "mathematics"  :code "(define (scale-vector v s) (map (lambda (x) (exact/* x s)) v))\n(scale-vector (list (exact/rat 1 2) (exact/rat 3 4)) (exact/rat 2 3))")
       (:domain "cs / dispatch" :code "(define (scale-vector v s) (map (lambda (x) (exact/* x s)) v))\n(scale-vector (list (exact/rat 1 2) (exact/rat 3 4)) (exact/rat 2 3))"))
     :explanation "Financial, algebraic, parsed — all closed under exact multiplication."
     :meta "Closure is a universal shape.")
    (:eng "Precision preserved through the pipeline." :math "Closure under multiplication in ℚ." :cs "Type-preserving operation."))
  :row-4-proof (
    (:programs (
      (:code "(define (invariant-holds? xs) (fold (lambda (r x) (and r (rational? x))) #t (map (lambda (p) (exact/* (car p) (cdr p))) xs)))\n(invariant-holds? (list (cons (exact/rat 1 2) (exact/rat 2 3))))" :tags (eng program))
      (:code "(define (associativity-check a b c) (equal? (exact/* (exact/* a b) c) (exact/* a (exact/* b c))))\n(associativity-check (exact/rat 1 2) (exact/rat 2 3) (exact/rat 3 4))" :tags (math program))
      (:code "(define (commutativity-check a b) (equal? (exact/* a b) (exact/* b a)))\n(commutativity-check (exact/rat 2 3) (exact/rat 3 4))" :tags (cs program)))
     :claim "exact/* is commutative and associative on ℚ."
     :invariant "∀ a b c ∈ ℚ. a·b = b·a ∧ (a·b)·c = a·(b·c)"
     :meta "Pattern: commutative ring axioms.")
    (:eng "Reordering doesn't change results." :math "ℚ is a commutative ring." :cs "Op composition preserves algebraic law."))
  :row-5-emergence (
    (:programs (
      (:code "(define (compound-scale base scales) (fold exact/* base scales))\n(compound-scale (exact/rat 100 1) (list (exact/rat 1 2) (exact/rat 2 3)))" :tags (eng composition))
      (:code "(define (product-of xs) (fold exact/* (exact/rat 1 1) xs))\n(product-of (list (exact/rat 2 3) (exact/rat 3 4) (exact/rat 4 5)))" :tags (math composition))
      (:code "(define (safe-product xs default) (if (fold (lambda (r x) (and r (rational? x))) #t xs) (fold exact/* default xs) default))\n(safe-product (list (exact/rat 2 3) 5) (exact/rat 1 1))" :tags (cs composition)))
     :base "exact/* multiplies exact rationals."
     :emergent "Compositions: eng compound scaling, math product folding, cs safe-product."
     :meta "Family: exact-arithmetic pipelines.")
    (:eng "Chained scaling is the base of price adjustments." :math "Product folding realizes ∏." :cs "Safe fold rejects non-rational inputs upfront."))
)

(verb :name "exact/+" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/+ a b) -> rational"
  :summary "Add two exact rationals; result auto-reduces to lowest terms."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/+ (exact/rat 1 3) (exact/rat 1 6))" :note "1/3 + 1/6 = 3/6 = 1/2 exactly.")
    (:dialect "motoi" :tier "intermediate" :code "(exact/->string (exact/+ (exact/rat 1 4) (exact/rat 2 4)))" :note "Common denominator handled automatically; result is 3/4.")
    (:dialect "motoi" :tier "expert"       :code "(define (running-sum xs) (fold exact/+ (exact/rat 0 1) xs))\n(running-sum (list (exact/rat 1 3) (exact/rat 1 6) (exact/rat 1 2)))" :note "Accumulate exact fractions; every intermediate is exact."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (ledger-sum items) (fold (lambda (acc it) (exact/+ acc (item-amount it))) (exact/rat 0 1) items))\n(exact/->string (ledger-sum (list)))" :tags (eng program))
      (:code "(define (harmonic-sum n) (let loop ((k 1) (acc (exact/rat 0 1))) (if (> k n) acc (loop (+ k 1) (exact/+ acc (exact/rat 1 k))))))\n(exact/->string (harmonic-sum 4))" :tags (math program))
      (:code "(define (safe-add a b) (if (and (rational? a) (rational? b)) (exact/+ a b) (error 'shape 'need-rat)))\n(safe-add (exact/rat 1 2) (exact/rat 1 3))" :tags (cs program)))
     :problem "Ledger totals must reconcile to the exact cent. Any float rounding introduces reconciliation errors."
     :explanation "eng: ledger sum. math: harmonic series. cs: guarded op."
     :meta "Reach for exact/+ and NOT +: + drops precision when one arg is inexact.")
    (:eng "Ledger sums must be exact." :math "exact/+ : ℚ × ℚ → ℚ." :cs "Closed under addition."))
  :row-3-dimension (
    (:setup "Additive closure on rationals."
     :rungs (
       (:domain "engineering"  :code "(define (harmonic-sum n) (let loop ((k 1) (acc (exact/rat 0 1))) (if (> k n) acc (loop (+ k 1) (exact/+ acc (exact/rat 1 k))))))\n(exact/->string (harmonic-sum 4))")
       (:domain "mathematics"  :code "(define (harmonic-sum n) (let loop ((k 1) (acc (exact/rat 0 1))) (if (> k n) acc (loop (+ k 1) (exact/+ acc (exact/rat 1 k))))))\n(exact/->string (harmonic-sum 4))")
       (:domain "cs / dispatch" :code "(define (harmonic-sum n) (let loop ((k 1) (acc (exact/rat 0 1))) (if (> k n) acc (loop (+ k 1) (exact/+ acc (exact/rat 1 k))))))\n(exact/->string (harmonic-sum 4))"))
     :explanation "Ledger, series, parsed inputs — all closed under +."
     :meta "Closure over addition.")
    (:eng "Additive is the base of accumulation." :math "ℚ is closed under +." :cs "Op preserves type tag."))
  :row-4-proof (
    (:programs (
      (:code "(define (associative? a b c) (equal? (exact/+ (exact/+ a b) c) (exact/+ a (exact/+ b c))))\n(associative? (exact/rat 1 2) (exact/rat 1 3) (exact/rat 1 6))" :tags (eng program))
      (:code "(define (commutative? a b) (equal? (exact/+ a b) (exact/+ b a)))\n(commutative? (exact/rat 2 3) (exact/rat 1 4))" :tags (math program))
      (:code "(define (identity-check a) (equal? (exact/+ a (exact/rat 0 1)) a))\n(identity-check (exact/rat 5 7))" :tags (cs program)))
     :claim "exact/+ is commutative, associative, and has identity 0."
     :invariant "∀ a b c ∈ ℚ. a+b = b+a ∧ (a+b)+c = a+(b+c) ∧ a+0 = a"
     :meta "Pattern: additive monoid.")
    (:eng "Reordering safe." :math "ℚ is an additive monoid with identity." :cs "Sum-fold semantics are stable."))
  :row-5-emergence (
    (:programs (
      (:code "(define (item-cost it) (exact/rat (car it) (cadr it)))\n(define (total-billing items) (fold exact/+ (exact/rat 0 1) (map item-cost items)))\n(total-billing (list))" :tags (eng composition))
      (:code "(define (partial-sum xs) (let loop ((xs xs) (acc (exact/rat 0 1)) (out '())) (cond ((null? xs) (reverse out)) (else (let ((acc2 (exact/+ acc (car xs)))) (loop (cdr xs) acc2 (cons acc2 out)))))))\n(partial-sum (list (exact/rat 1 2) (exact/rat 1 3)))" :tags (math composition))
      (:code "(define (bounded-sum xs cap) (let loop ((xs xs) (acc (exact/rat 0 1))) (cond ((null? xs) acc) ((and cap (exact/> acc cap)) cap) (else (loop (cdr xs) (exact/+ acc (car xs)))))))\n(bounded-sum (list (exact/rat 1 2) (exact/rat 1 3)) #f)" :tags (cs composition)))
     :base "exact/+ sums rationals."
     :emergent "Compositions: eng billing, math partial-sums, cs bounded accumulation."
     :meta "Family: exact accumulation.")
    (:eng "Billing accumulates line items." :math "Partial sums produce sequences." :cs "Bounded accumulation avoids overflow-flavor issues."))
)

(verb :name "exact/-" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/- a b) -> rational"
  :summary "Subtract exact rationals; result auto-reduces."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/- (exact/rat 3 4) (exact/rat 1 4))" :note "3/4 - 1/4 = 1/2 exactly.")
    (:dialect "motoi" :tier "intermediate" :code "(exact/->string (exact/- (exact/rat 5 6) (exact/rat 1 3)))" :note "5/6 - 2/6 = 3/6 = 1/2. LCD handled.")
    (:dialect "motoi" :tier "expert"       :code "(define (balance-after debits credits) (exact/- (fold exact/+ (exact/rat 0 1) credits) (fold exact/+ (exact/rat 0 1) debits)))\n(balance-after (list (exact/rat 5 1)) (list (exact/rat 10 1)))" :note "Net balance from two lists — always exact."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (net-amount gross discount) (exact/- gross discount))\n(exact/->string (net-amount (exact/rat 100 1) (exact/rat 15 1)))" :tags (eng program))
      (:code "(define (difference-quotient f a h) (exact/- (f (exact/+ a h)) (f a)))\n(difference-quotient (lambda (x) (exact/* x x)) (exact/rat 2 1) (exact/rat 1 10))" :tags (math program))
      (:code "(define (safe-sub a b) (if (and (rational? a) (rational? b)) (exact/- a b) (error 'shape 'need-rat)))\n(safe-sub (exact/rat 3 4) (exact/rat 1 4))" :tags (cs program)))
     :problem "Net-amount calculations after discounts must be exact for compliance and reconciliation."
     :explanation "eng: net amount. math: difference quotient. cs: guarded op."
     :meta "Reach for exact/- and NOT -: - is inexact-carrying.")
    (:eng "Discount calculations must preserve precision." :math "exact/- : ℚ × ℚ → ℚ." :cs "Type-preserving."))
  :row-3-dimension (
    (:setup "Subtractive closure."
     :rungs (
       (:domain "engineering"  :code "(define (difference-quotient f a h) (exact/- (f (exact/+ a h)) (f a)))\n(difference-quotient (lambda (x) (exact/* x x)) (exact/rat 2 1) (exact/rat 1 10))")
       (:domain "mathematics"  :code "(define (difference-quotient f a h) (exact/- (f (exact/+ a h)) (f a)))\n(difference-quotient (lambda (x) (exact/* x x)) (exact/rat 2 1) (exact/rat 1 10))")
       (:domain "cs / dispatch" :code "(define (difference-quotient f a h) (exact/- (f (exact/+ a h)) (f a)))\n(difference-quotient (lambda (x) (exact/* x x)) (exact/rat 2 1) (exact/rat 1 10))"))
     :explanation "Business, calculus, parsed differences."
     :meta "Subtractive is a universal shape.")
    (:eng "Deltas everywhere in accounting." :math "ℚ closed under -." :cs "Op preserves representation."))
  :row-4-proof (
    (:programs (
      (:code "(define (inverse-holds? a b) (equal? (exact/- (exact/+ a b) b) a))\n(inverse-holds? (exact/rat 3 4) (exact/rat 1 4))" :tags (eng program))
      (:code "(define (self-diff-zero a) (equal? (exact/- a a) (exact/rat 0 1)))\n(self-diff-zero (exact/rat 5 7))" :tags (math program))
      (:code "(define (anti-commutative? a b) (equal? (exact/- a b) (exact/neg (exact/- b a))))\n(anti-commutative? (exact/rat 2 3) (exact/rat 1 4))" :tags (cs program)))
     :claim "exact/- is the additive inverse: a - a = 0; a - b = -(b - a)."
     :invariant "∀ a b ∈ ℚ. a-a = 0 ∧ a-b = -(b-a)"
     :meta "Pattern: additive inverse.")
    (:eng "Zero-out identity is a common test." :math "Group inverse in ℚ." :cs "Op is inverse-consistent."))
  :row-5-emergence (
    (:programs (
      (:code "(define (running-balance xs) (fold (lambda (acc x) (exact/- acc x)) (exact/rat 100 1) xs))\n(running-balance (list (exact/rat 10 1) (exact/rat 20 1)))" :tags (eng composition))
      (:code "(define (finite-difference f xs) (map (lambda (i) (exact/- (list-ref xs (+ i 1)) (list-ref xs i))) (iota (- (length xs) 1))))\n(finite-difference #f (list (exact/rat 1 1) (exact/rat 2 1) (exact/rat 4 1)))" :tags (math composition))
      (:code "(define (payment-schedule total periods) (let ((per (exact/rat (numerator total) (* periods (denominator total))))) (map (lambda (i) per) (iota periods))))\n(payment-schedule (exact/rat 100 1) 4)" :tags (cs composition)))
     :base "exact/- subtracts exactly."
     :emergent "Compositions: eng balance, math finite differences, cs payment schedule."
     :meta "Family: exact-difference pipelines.")
    (:eng "Balance walks are natural." :math "Finite differences form a lattice." :cs "Payment schedules divide totals exactly."))
)

(verb :name "exact//" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact// a b) -> rational"
  :summary "Divide exact rationals; result auto-reduces. Divisor must be non-zero."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact// (exact/rat 3 4) (exact/rat 1 2))" :note "3/4 ÷ 1/2 = 3/2 exactly.")
    (:dialect "motoi" :tier "intermediate" :code "(exact/->string (exact// (exact/rat 1 3) (exact/rat 1 6)))" :note "1/3 ÷ 1/6 = 2 (integer result, exact).")
    (:dialect "motoi" :tier "expert"       :code "(define (per-unit total qty) (if (equal? qty (exact/rat 0 1)) 'error-div-zero (exact// total qty)))\n(per-unit (exact/rat 100 1) (exact/rat 4 1))" :note "Guarded division protects against divide-by-zero."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (average total count) (if (equal? count (exact/rat 0 1)) 'div-zero (exact// total count)))\n(exact/->string (average (exact/rat 300 1) (exact/rat 4 1)))" :tags (eng program))
      (:code "(define (rate-of a b) (if (equal? b (exact/rat 0 1)) 'undefined (exact// a b)))\n(rate-of (exact/rat 6 1) (exact/rat 4 1))" :tags (math program))
      (:code "(define (safe-div a b) (cond ((not (rational? a)) (error 'shape)) ((not (rational? b)) (error 'shape)) ((equal? b (exact/rat 0 1)) (error 'div-zero)) (else (exact// a b))))\n(safe-div (exact/rat 3 1) (exact/rat 2 1))" :tags (cs program)))
     :problem "Average / rate calculations divide totals; divide-by-zero must be caught explicitly to avoid propagation."
     :explanation "eng: average. math: rate. cs: type + zero guard."
     :meta "Reach for exact// and NOT /: / drops to inexact when needed. exact// stays in ℚ.")
    (:eng "Zero guard is required." :math "exact// : ℚ × ℚ\\{0} → ℚ." :cs "Partial function; guard denominator."))
  :row-3-dimension (
    (:setup "Division within ℚ (with zero guard)."
     :rungs (
       (:domain "engineering"  :code "(define (rate-of a b) (if (equal? b (exact/rat 0 1)) 'undefined (exact// a b)))\n(rate-of (exact/rat 6 1) (exact/rat 4 1))")
       (:domain "mathematics"  :code "(define (rate-of a b) (if (equal? b (exact/rat 0 1)) 'undefined (exact// a b)))\n(rate-of (exact/rat 6 1) (exact/rat 4 1))")
       (:domain "cs / dispatch" :code "(define (rate-of a b) (if (equal? b (exact/rat 0 1)) 'undefined (exact// a b)))\n(rate-of (exact/rat 6 1) (exact/rat 4 1))"))
     :explanation "Business ratios, exact-rational construction, parsed inputs."
     :meta "Division is universal.")
    (:eng "Ratios drive KPIs." :math "ℚ = (ℤ × ℤ*) / ∼." :cs "Op is representation-safe."))
  :row-4-proof (
    (:programs (
      (:code "(define (inverse-property a) (if (equal? a (exact/rat 0 1)) #t (equal? (exact/* a (exact// (exact/rat 1 1) a)) (exact/rat 1 1))))\n(inverse-property (exact/rat 3 4))" :tags (eng program))
      (:code "(define (identity-check a) (equal? (exact// a (exact/rat 1 1)) a))\n(identity-check (exact/rat 5 7))" :tags (math program))
      (:code "(define (double-inverse a) (if (equal? a (exact/rat 0 1)) #t (equal? (exact// (exact/rat 1 1) (exact// (exact/rat 1 1) a)) a)))\n(double-inverse (exact/rat 3 4))" :tags (cs program)))
     :claim "exact// with non-zero divisor is the multiplicative inverse: a / 1 = a; (1/a)·a = 1."
     :invariant "∀ a ∈ ℚ, a ≠ 0. a/1 = a ∧ (1/a)·a = 1"
     :meta "Pattern: field inverse.")
    (:eng "Ratios respect inverse laws." :math "ℚ is a field." :cs "Division and multiplication are dual."))
  :row-5-emergence (
    (:programs (
      (:code "(define (unit-prices totals counts) (map (lambda (t c) (if (equal? c (exact/rat 0 1)) 'div-zero (exact// t c))) totals counts))\n(unit-prices (list (exact/rat 100 1)) (list (exact/rat 4 1)))" :tags (eng composition))
      (:code "(define (mediant a b) (exact// (exact/+ (exact/rat (numerator a) 1) (exact/rat (numerator b) 1)) (exact/+ (exact/rat (denominator a) 1) (exact/rat (denominator b) 1))))\n(mediant (exact/rat 1 2) (exact/rat 1 3))" :tags (math composition))
      (:code "(define (normalize-vector v) (let ((mag (fold exact/+ (exact/rat 0 1) v))) (if (equal? mag (exact/rat 0 1)) v (map (lambda (x) (exact// x mag)) v))))\n(normalize-vector (list (exact/rat 1 1) (exact/rat 2 1)))" :tags (cs composition)))
     :base "exact// divides exactly."
     :emergent "Compositions: eng unit prices, math mediants, cs vector normalization."
     :meta "Family: exact-division pipelines.")
    (:eng "Unit-price computation is standard." :math "Farey mediants use exact division." :cs "Normalization is division by magnitude."))
)

(verb :name "exact/=" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/= a b) -> boolean"
  :summary "#t if two exact rationals are equal (after auto-reduction)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/= (exact/rat 1 2) (exact/rat 2 4))" :note "1/2 = 2/4 → both reduce to 1/2. #t.")
    (:dialect "motoi" :tier "intermediate" :code "(define a (exact/rat 1 2))\n(define b (exact/rat 2 4))\n(define c (exact/rat 3 6))\n(and (exact/= a b) (exact/= b c))" :note "Transitive equality check.")
    (:dialect "motoi" :tier "expert"       :code "(define (dedup-rationals xs) (let loop ((xs xs) (seen '())) (cond ((null? xs) (reverse seen)) ((any (lambda (s) (exact/= (car xs) s)) seen) (loop (cdr xs) seen)) (else (loop (cdr xs) (cons (car xs) seen))))))\n(dedup-rationals (list (exact/rat 1 2) (exact/rat 2 4) (exact/rat 1 3)))" :note "Deduplicate rationals under exact equality."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (invoice-matches? a b) (exact/= a b))\n(invoice-matches? (exact/rat 190 10) (exact/rat 19 1))" :tags (eng program))
      (:code "(define (reduced-equal? a b) (exact/= a b))\n(reduced-equal? (exact/rat 4 8) (exact/rat 1 2))" :tags (math program))
      (:code "(define (checksum-equal? computed expected) (if (and (rational? computed) (rational? expected)) (exact/= computed expected) #f))\n(checksum-equal? (exact/rat 100 1) (exact/rat 100 1))" :tags (cs program)))
     :problem "Reconciliation checks compare rational totals; float = would allow rounding-error mismatches. exact/= is the safe comparator."
     :explanation "eng: invoice matching. math: reduced-form equality. cs: type-safe checksum."
     :meta "Reach for exact/= and NOT =: = converts to float and loses precision.")
    (:eng "Invoice matching must be exact." :math "exact/= is equality after reduction." :cs "Value equality; representation-safe."))
  :row-3-dimension (
    (:setup "Exact equivalence check."
     :rungs (
       (:domain "engineering"  :code "(define (reduced-equal? a b) (exact/= a b))\n(reduced-equal? (exact/rat 4 8) (exact/rat 1 2))")
       (:domain "mathematics"  :code "(define (reduced-equal? a b) (exact/= a b))\n(reduced-equal? (exact/rat 4 8) (exact/rat 1 2))")
       (:domain "cs / dispatch" :code "(define (reduced-equal? a b) (exact/= a b))\n(reduced-equal? (exact/rat 4 8) (exact/rat 1 2))"))
     :explanation "Reconciliation, math equivalence, hash comparison — all exact-equality checks."
     :meta "Equality-under-normalization is universal.")
    (:eng "Reconciliation is exact-equality dispatch." :math "Equivalence relation on ℚ." :cs "Value equality regardless of representation."))
  :row-4-proof (
    (:programs (
      (:code "(define (reflexive? a) (exact/= a a))\n(reflexive? (exact/rat 3 4))" :tags (eng program))
      (:code "(define (symmetric? a b) (equal? (exact/= a b) (exact/= b a)))\n(symmetric? (exact/rat 1 2) (exact/rat 2 4))" :tags (math program))
      (:code "(define (transitive? a b c) (if (and (exact/= a b) (exact/= b c)) (exact/= a c) #t))\n(transitive? (exact/rat 1 2) (exact/rat 2 4) (exact/rat 3 6))" :tags (cs program)))
     :claim "exact/= is an equivalence relation on ℚ."
     :invariant "∀ a b c ∈ ℚ. exact/=(a,a) ∧ exact/=(a,b) ⇔ exact/=(b,a) ∧ (exact/=(a,b) ∧ exact/=(b,c) → exact/=(a,c))"
     :meta "Pattern: equivalence relation (reflexive, symmetric, transitive).")
    (:eng "Equivalence supports fair dispatch." :math "Congruence relation." :cs "Value-equality composes safely."))
  :row-5-emergence (
    (:programs (
