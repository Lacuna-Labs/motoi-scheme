      (:code "(define (min-of xs) (fold (lambda (m x) (if (exact/< x m) x m)) (car xs) (cdr xs)))\n(min-of (list (exact/rat 3 4) (exact/rat 1 3) (exact/rat 2 3)))" :tags (math composition))
