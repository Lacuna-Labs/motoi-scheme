      (:code "(define (antisymmetric a b) (if (and (exact/<= a b) (exact/<= b a)) (exact/= a b) #t))\n(antisymmetric (exact/rat 1 2) (exact/rat 2 4))" :tags (math program))
      (:code "(define (transitive a b c) (if (and (exact/<= a b) (exact/<= b c)) (exact/<= a c) #t))\n(transitive (exact/rat 1 3) (exact/rat 1 2) (exact/rat 2 3))" :tags (cs program)))
     :claim "exact/<= is a non-strict total order (reflexive, antisymmetric, transitive)."
     :invariant "∀ a b c. a≤a ∧ (a≤b ∧ b≤a → a=b) ∧ (a≤b ∧ b≤c → a≤c)"
