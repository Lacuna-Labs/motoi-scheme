      (:code "(define (negate-poly coeffs) (map exact/neg coeffs))\n(negate-poly (list (exact/rat 1 1) (exact/rat -2 1) (exact/rat 3 1)))" :tags (math composition))
      (:code "(define (subtract-vectors a b) (map exact/+ a (map exact/neg b)))\n(subtract-vectors (list (exact/rat 5 1)) (list (exact/rat 2 1)))" :tags (cs composition)))
     :base "exact/neg flips sign."
