     :explanation "eng: threshold. math: interval. cs: guarded op."
     :meta "Reach for exact/< and NOT <: < is float-flavored and loses precision.")
    (:eng "Thresholds must be exact." :math "exact/< is the strict order on ℚ." :cs "Total order on ℚ."))
  :row-3-dimension (
    (:setup "Strict ordering on rationals."
