      (:code "(define (harmonic-mean xs) (exact/inverse (fold exact/+ (exact/rat 0 1) (map exact/inverse xs))))\n(harmonic-mean (list (exact/rat 1 1) (exact/rat 2 1)))" :tags (math composition))
      (:code "(define (safe-inverses xs) (map (lambda (x) (if (exact/= x (exact/rat 0 1)) 'skip (exact/inverse x))) xs))\n(safe-inverses (list (exact/rat 1 2) (exact/rat 0 1)))" :tags (cs composition)))
     :base "exact/inverse flips numerator and denominator."
