      (:code "(define (mixed-form a) (exact/->mixed a))\n(mixed-form (exact/rat 5 3))" :tags (math program))
      (:code "(define (parse-mixed-safe a) (if (rational? a) (exact/->mixed a) (error 'shape 'need-rat)))\n(parse-mixed-safe (exact/rat 22 7))" :tags (cs program)))
     :problem "Mixed-number display is easier to read than improper fractions in recipes, timekeeping, and human communication."
     :explanation "eng: display. math: canonical form. cs: safe conversion."
     :meta "Reach for exact/->mixed for human-readable output.")
    (:eng "Recipe amounts read as mixed numbers." :math "Canonical form of improper fractions." :cs "Structured decomposition."))
  :row-3-dimension (
    (:setup "Decomposition into whole + fractional parts."
     :rungs (
       (:domain "engineering"  :code "(exact/->mixed (exact/rat 7 2))")
       (:domain "mathematics"  :code "(define (mixed-form a) (exact/->mixed a))\n(mixed-form (exact/rat 5 3))")
       (:domain "cs / dispatch" :code "(define (mixed-form a) (exact/->mixed a))\n(mixed-form (exact/rat 5 3))"))
     :explanation "Recipe, math canonical, computed values."
     :meta "Decomposition is universal.")
    (:eng "Human-readable decomposition." :math "Mixed-number form is one canonical presentation." :cs "Structured decomposition."))
  :row-4-proof (
    (:programs (
      (:code "(define (reconstruction a) (let ((m (exact/->mixed a))) (exact/= a (exact/+ (exact/rat (car m) 1) (exact/rat (cadr m) (caddr m))))))\n(reconstruction (exact/rat 7 2))" :tags (eng program))
      (:code "(define (numerator-bounded? a) (let ((m (exact/->mixed a))) (< (cadr m) (caddr m))))\n(numerator-bounded? (exact/rat 7 2))" :tags (math program))
      (:code "(define (list-shape a) (let ((m (exact/->mixed a))) (and (list? m) (= (length m) 3))))\n(list-shape (exact/rat 7 2))" :tags (cs program)))
     :claim "exact/->mixed produces (whole num den) where num < den; reconstruction recovers original."
     :invariant "∀ a. exact/rat(whole·den + num, den) = a where (whole num den) = exact/->mixed(a) ∧ num < den"
     :meta "Pattern: canonical decomposition.")
    (:eng "Reconstruction is round-trip safe." :math "Canonical decomposition." :cs "Structured output preserves information."))
  :row-5-emergence (
    (:programs (
      (:code "(define (recipe-display amounts) (map exact/->mixed amounts))\n(recipe-display (list (exact/rat 3 2) (exact/rat 5 3)))" :tags (eng composition))
      (:code "(define (whole-part a) (car (exact/->mixed a)))\n(whole-part (exact/rat 22 7))" :tags (math composition))
      (:code "(define (structured-display xs) (map (lambda (x) (let ((m (exact/->mixed x))) (list :whole (car m) :num (cadr m) :den (caddr m)))) xs))\n(structured-display (list (exact/rat 7 2)))" :tags (cs composition)))
     :base "exact/->mixed decomposes into (whole num den)."
     :emergent "Compositions: eng recipe display, math whole-part extraction, cs structured display."
     :meta "Family: rational decomposition.")
    (:eng "Recipe display is more human." :math "Whole-part is one canonical projection." :cs "Structured output composes into forms."))
)

(verb :name "exact/->string" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/->string a) -> string"
  :summary "Format an exact rational as a string like \"3/4\" or \"5\" (if integer)."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/->string (exact/rat 3 4))" :note "\"3/4\".")
    (:dialect "motoi" :tier "intermediate" :code "(exact/->string (exact/rat 6 8))" :note "\"3/4\" — reduced first.")
    (:dialect "motoi" :tier "expert"       :code "(define (format-with-label label a) (string-append label \": \" (exact/->string a)))\n(format-with-label \"Total\" (exact/rat 19 2))" :note "Prefixed display."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (print-amount a) (display (exact/->string a)) (newline))\n(print-amount (exact/rat 3 4))" :tags (eng program))
      (:code "(define (as-canonical a) (exact/->string a))\n(as-canonical (exact/rat 6 8))" :tags (math program))
      (:code "(define (safe-str a) (if (rational? a) (exact/->string a) \"NaN\"))\n(safe-str (exact/rat 3 4))" :tags (cs program)))
     :problem "Display of exact rationals to the operator uses a compact string form."
     :explanation "eng: printing. math: canonical string. cs: guarded formatter."
     :meta "Reach for exact/->string for text output.")
    (:eng "Printing amounts." :math "Canonical string form." :cs "Type-safe formatter."))
  :row-3-dimension (
    (:setup "Canonical string representation."
     :rungs (
       (:domain "engineering"  :code "(define (as-canonical a) (exact/->string a))\n(as-canonical (exact/rat 6 8))")
       (:domain "mathematics"  :code "(define (as-canonical a) (exact/->string a))\n(as-canonical (exact/rat 6 8))")
       (:domain "cs / dispatch" :code "(define (as-canonical a) (exact/->string a))\n(as-canonical (exact/rat 6 8))"))
     :explanation "Displays, math notation, computed output."
     :meta "String formatting is universal.")
    (:eng "Human-readable text." :math "Canonical string notation." :cs "Log-friendly output."))
  :row-4-proof (
    (:programs (
      (:code "(define (non-empty? s) (positive? (string-length s)))\n(non-empty? (exact/->string (exact/rat 3 4)))" :tags (eng program))
      (:code "(define (parse-rational-string s) (let ((p (string-split s \"/\"))) (exact/rat (string->number (car p)) (string->number (cadr p)))))\n(define (round-trip? a) (exact/= a (parse-rational-string (exact/->string a))))\n(round-trip? (exact/rat 3 4))" :tags (math program))
      (:code "(define (contains-slash-or-int? a) (let ((s (exact/->string a))) (or (integer? (string->number s)) (string-contains s \"/\"))))\n(contains-slash-or-int? (exact/rat 3 4))" :tags (cs program)))
     :claim "exact/->string is a canonical formatter; round-trips through parser."
     :invariant "∀ a ∈ ℚ. non-empty(exact/->string(a)) ∧ parse-rational-string(exact/->string(a)) = a"
     :meta "Pattern: canonical serialization.")
    (:eng "Non-empty string is a safety property." :math "Round-trip integrity." :cs "Format is parseable."))
  :row-5-emergence (
    (:programs (
      (:code "(define (log-amounts xs) (for-each (lambda (a) (display (exact/->string a)) (newline)) xs))\n(log-amounts (list (exact/rat 3 4) (exact/rat 1 2)))" :tags (eng composition))
      (:code "(define (join-with-comma xs) (fold (lambda (x acc) (if (equal? acc \"\") (exact/->string x) (string-append acc \", \" (exact/->string x)))) \"\" xs))\n(join-with-comma (list (exact/rat 1 2) (exact/rat 3 4)))" :tags (math composition))
      (:code "(define (labeled-display labels xs) (map (lambda (l x) (string-append l \": \" (exact/->string x))) labels xs))\n(labeled-display (list \"a\" \"b\") (list (exact/rat 1 2) (exact/rat 3 4)))" :tags (cs composition)))
     :base "exact/->string canonicalizes to text."
     :emergent "Compositions: eng logging, math join, cs labeled output."
     :meta "Family: text-output pipelines.")
    (:eng "Logging is common." :math "Comma-joined lists." :cs "Labeled outputs for structured display."))
)

(verb :name "exact/float->rat" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/float->rat f) -> rational"
  :summary "Convert a float to an exact rational approximation."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/float->rat 0.5)" :note "1/2 exactly.")
    (:dialect "motoi" :tier "intermediate" :code "(exact/->string (exact/float->rat 0.333333))" :note "Precise ratio approximation.")
    (:dialect "motoi" :tier "expert"       :code "(define (import-floats fs) (map exact/float->rat fs))\n(import-floats (list 0.5 0.25 0.75))" :note "Import a float buffer into exact-rational representation."))
  :provenance "R7RS-inspired; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:programs (
      (:code "(define (upgrade-to-exact fs) (map exact/float->rat fs))\n(upgrade-to-exact (list 0.5))" :tags (eng program))
      (:code "(define (rationalize-float f) (exact/float->rat f))\n(rationalize-float 0.333)" :tags (math program))
      (:code "(define (safe-upgrade f) (if (real? f) (exact/float->rat f) (error 'shape 'need-real)))\n(safe-upgrade 0.5)" :tags (cs program)))
     :problem "Legacy data comes in as floats; upgrading to exact rationals prevents further precision loss."
     :explanation "eng: upgrade. math: rationalize. cs: guarded convert."
     :meta "Reach for exact/float->rat when entering the exact domain from IEEE.")
    (:eng "Upgrading to exact." :math "IEEE ℝ → ℚ (fixed-precision reverse of ->float)." :cs "Entry point to exact ops."))
  :row-3-dimension (
    (:setup "IEEE → exact boundary conversion."
     :rungs (
       (:domain "engineering"  :code "(define (rationalize-float f) (exact/float->rat f))\n(rationalize-float 0.333)")
       (:domain "mathematics"  :code "(define (rationalize-float f) (exact/float->rat f))\n(rationalize-float 0.333)")
       (:domain "cs / dispatch" :code "(define (rationalize-float f) (exact/float->rat f))\n(rationalize-float 0.333)"))
     :explanation "Sensors, math constants, parsed floats — enter exact realm."
     :meta "Boundary entry.")
    (:eng "Sensor upgrade to exact." :math "IEEE → ℚ." :cs "Rationalization step."))
  :row-4-proof (
    (:programs (
      (:code "(define (rational-result? f) (rational? (exact/float->rat f)))\n(rational-result? 0.5)" :tags (eng program))
      (:code "(define (round-trip-close? f) (< (abs (- f (exact/->float (exact/float->rat f)))) 1e-15))\n(round-trip-close? 0.333333)" :tags (math program))
      (:code "(define (recognize-exact-half? f) (exact/= (exact/float->rat 0.5) (exact/rat 1 2)))\n(recognize-exact-half? 0.5)" :tags (cs program)))
     :claim "exact/float->rat returns a rational; round-trip via ->float is close."
     :invariant "∀ f ∈ IEEE ℝ. rational?(exact/float->rat(f)) ∧ |f - exact/->float(exact/float->rat(f))| ≤ ε"
     :meta "Pattern: fixed-precision reverse.")
    (:eng "Type is rational." :math "Bounded round-trip error." :cs "Recognize common floats exactly."))
  :row-5-emergence (
    (:programs (
      (:code "(define (upgrade-record record) (map (lambda (v) (if (real? v) (exact/float->rat v) v)) record))\n(upgrade-record (list 0.5 'label 0.25))" :tags (eng composition))
      (:code "(define (rationalize-all fs) (map exact/float->rat fs))\n(rationalize-all (list 0.5 0.25))" :tags (math composition))
      (:code "(define (safe-batch fs default) (map (lambda (f) (if (real? f) (exact/float->rat f) default)) fs))\n(safe-batch (list 0.5) (exact/rat 0 1))" :tags (cs composition)))
     :base "exact/float->rat converts IEEE to ℚ."
     :emergent "Compositions: eng record upgrade, math batch rationalize, cs safe batch."
     :meta "Family: precision-recovery pipelines.")
    (:eng "Record upgrades preserve non-real fields." :math "Batch conversion." :cs "Safe batches use defaults for non-reals."))
)
