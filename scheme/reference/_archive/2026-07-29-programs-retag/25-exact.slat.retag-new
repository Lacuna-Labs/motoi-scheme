     :meta "Family: exact-sign transformations.")
    (:eng "Batch operations are common." :math "Polynomials support coefficient-wise negation." :cs "Vector subtraction is a+(-b)."))
)

(verb :name "exact/inverse" :std "Motoi" :library "exact" :tier "core" :kind "pure" :signature "(exact/inverse a) -> rational"
  :summary "Multiplicative inverse of a non-zero exact rational."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(exact/inverse (exact/rat 3 4))" :note "4/3.")
    (:dialect "motoi" :tier "intermediate" :code "(define a (exact/rat 3 4))\n(exact/= (exact/* a (exact/inverse a)) (exact/rat 1 1))" :note "Multiplicative-inverse identity.")
    (:dialect "motoi" :tier "expert"       :code "(define (safe-inverse a) (if (equal? a (exact/rat 0 1)) 'div-zero (exact/inverse a)))\n(safe-inverse (exact/rat 2 3))" :note "Guarded inverse rejects zero."))
