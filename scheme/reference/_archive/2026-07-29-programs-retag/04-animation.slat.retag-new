;;; 04-animation.slat — Motoi Scheme Reference · Chapter 04 · library animation
;;;
;;; 3 verbs in this library. Read chapter 00-intro.slat first.
;;; Rewritten 2026-07-26 (#372): the chapter no longer documents browser DOM
;;; reflow policy. Its subject is now the REAL tween lifecycle — a value moving
;;; through time — taught through easing curves (chapter 22), interpolation
;;; (chapter 20), and velocity as a derivative (chapter 11). The three former
;;; DOM verbs (animation/budget, animation/reflow-policy, animation/set-reflow-policy)
;;; are preserved as a broken-example:
;;; broken-examples/animation-dom-reflow-not-motoi-subject.slatl

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library animation — 3 verbs: the tween lifecycle over the framebuffer.")

(chapter :number "04" :library "animation" :verb-count 3 :training-eligible #t)

;;; Animation in Motoi is a value moving through time. A motion verb
;;; (motion/move-to) creates a TWEEN: a start, an end, a duration, and an easing
;;; curve that says HOW the value travels between the endpoints. The three verbs
;;; here are the tween lifecycle. animation/tweens READS the live set;
;;; animation/tick ADVANCES the clock one frame; animation/clear! EMPTIES the
;;; set. The mathematics lives next door: easing/* (chapter 22) is the curve,
;;; curve/eval (chapter 20) is the position at fraction t, calc/derivative
;;; (chapter 11) is the velocity.

(verb :name "animation/tweens" :std "Motoi" :library "animation" :tier "core" :kind "pure" :signature "(animation/tweens) -> list"
  :summary "The live list of in-flight tweens — every value currently moving toward a target. Empty when nothing animates."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(animation/tweens)" :note "Empty list when nothing is moving.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (animation/clear!) (motion/move-to (list 'star 0 0) (list 60 0)) (length (animation/tweens)))" :note "One motion in flight — length 1.")
    (:dialect "motoi" :tier "expert"       :code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (motion/move-to (list 'b 0 0) (list 9 9)) (length (animation/tweens)))" :note "Count everything animating at once."))
  :provenance "Motoi core; rewritten onto real tween lifecycle 2026-07-26 (#372)"
  :row-2-audit (
    (:programs (
      (:code "(begin (animation/clear!) (if (null? (animation/tweens)) (motion/move-to (list 'star 0 0) (list 60 0)) 'busy) (length (animation/tweens)))" :tags (eng program))
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (= (length (animation/tweens)) 1))" :tags (math program))
      (:code "(list? (animation/tweens))" :tags (cs program)))
     :problem "Before spawning more motion you need to know whether the screen is already busy — read the live set, don't guess."
     :explanation "eng: gate on emptiness. math: cardinality of the active set. cs: shape witness (always a list)."
     :meta "Reach for animation/tweens and NOT animation/tick: tweens READS the set; tick ADVANCES it. Reading must not move the clock.")
    (:eng "Probe the live set once, then decide." :math "The active set is finite; its size is a nonnegative integer." :cs "Read-only snapshot of mutable animation state."))
  :row-3-dimension (
    (:setup "Observe the live animation set so the caller can gate, count, or witness its shape."
     :rungs (
       (:domain "engineering"  :code "(begin (animation/clear!) (if (null? (animation/tweens)) 'idle 'animating))")
       (:domain "mathematics"  :code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (length (animation/tweens)))")
       (:domain "cs / dispatch" :code "(list? (animation/tweens))"))
     :explanation "Emptiness gate, cardinality, type witness."
     :meta "Nullary read of a mutable collection.")
    (:eng "Idle-vs-animating is a one-line check." :math "Size of a finite set." :cs "Snapshot read of shared state."))
  :row-4-proof (
    (:programs (
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (= (length (animation/tweens)) (length (animation/tweens))))" :tags (eng program))
      (:code "(begin (animation/clear!) (null? (animation/tweens)))" :tags (math program))
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (and (list? (animation/tweens)) (= 1 (length (animation/tweens)))))" :tags (cs program)))
     :claim "Pure read within a slice: same result until a tick or a motion mutates the set."
     :invariant "∀ t. read(t) = read(t) when no tick ∧ no motion intervenes; (length read) ∈ ℤ≥0"
     :meta "Pattern: state-observation-purity within a frame.")
    (:eng "No locks around a read of the tween list." :math "Reflexivity of = on a pure read." :cs "Read-purity for a single-writer many-reader collection."))
  :row-5-emergence (
    (:programs (
      (:code "(begin (animation/clear!) (let loop ((n 0)) (if (or (>= n 3) (>= (length (animation/tweens)) 2)) (length (animation/tweens)) (begin (motion/move-to (list n 0 0) (list 9 0)) (loop (+ n 1))))))" :tags (eng composition))
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (cond ((null? (animation/tweens)) 'still) ((= 1 (length (animation/tweens))) 'one) (else 'many)))" :tags (math composition))
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (map (lambda (_) (length (animation/tweens))) (list 1 2 3)))" :tags (cs composition)))
     :base "animation/tweens is a nullary read of the live tween set."
     :emergent "Compositions: eng watermark back-pressure, math size-driven branch, cs per-frame sampler."
     :meta "Family: bounded producer / observer of a live collection.")
    (:eng "Degrade by not spawning, rather than overflowing the screen." :math "Branch on the cardinality of the active set." :cs "Same slot as polling a work-queue depth."))
)

(verb :name "animation/tick" :std "Motoi" :library "animation" :tier "core" :kind "state-change" :signature "(animation/tick) -> integer"
  :summary "Advance the animation clock one frame: step every live tween along its easing curve and redraw. Returns the number still in flight."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(begin (animation/clear!) (animation/tick))" :note "Advance one frame; 0 when nothing is animating.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (animation/clear!) (motion/move-to (list 'star 0 0) (list 60 0)) (animation/tick))" :note "One tween stepped; still in flight — 1.")
    (:dialect "motoi" :tier "expert"       :code "(begin (animation/clear!) (motion/move-to (list 'star 0 0) (list 9 0)) (let loop ((n 0)) (if (< n 5) (begin (animation/tick) (loop (+ n 1))) (length (animation/tweens)))))" :note "Drive the clock five frames, then read what remains."))
  :provenance "Motoi core; rewritten onto real tween lifecycle 2026-07-26 (#372)"
  :row-2-audit (
    (:programs (
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (let loop ((n 0)) (if (< n 3) (begin (animation/tick) (loop (+ n 1))) 'stepped)))" :tags (eng program))
      (:code "(map (lambda (frame) (easing/standard (/ frame 4))) (list 0 1 2 3 4))" :tags (math program))
      (:code "(begin (animation/clear!) (number? (animation/tick)))" :tags (cs program)))
     :problem "A tween is a plan; nothing moves until you advance the clock. Each tick samples every tween's curve at the next frame and redraws."
     :explanation "eng: frame loop. math: sample the easing curve at successive frame times. cs: the tick returns the live count as an integer."
     :meta "Reach for animation/tick and NOT animation/tweens to make motion happen: tweens only observes; tick is the thing that moves the clock.")
    (:eng "One tick = one frame of progress." :math "A tick evaluates each tween's easing curve at the next sample point." :cs "Discrete-event step: advance state, emit the new count."))
  :row-3-dimension (
    (:setup "Advance discrete time by one frame and observe progress."
     :rungs (
       (:domain "engineering"  :code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (animation/tick))")
       (:domain "mathematics"  :code "(easing/standard (/ 2 4))")
       (:domain "cs / dispatch" :code "(begin (animation/clear!) (number? (animation/tick)))"))
     :explanation "Advance one frame, evaluate the curve at a frame time, witness the integer count."
     :meta "One step of a discrete-time system.")
    (:eng "Frames are the unit of animation time." :math "t = frame/total maps integer frames to a curve fraction." :cs "State-transition returning the new size."))
  :row-4-proof (
    (:programs (
      (:code "(begin (animation/clear!) (= 0 (animation/tick)))" :tags (eng program))
      (:code "(and (= 0 (easing/linear 0)) (= 1 (easing/linear 1)))" :tags (math program))
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (>= (animation/tick) 0))" :tags (cs program)))
     :claim "Tick on an empty set returns 0 and changes nothing; on a live set it advances every tween one frame and returns the live count."
     :invariant "tick() ∈ ℤ≥0; tweens=∅ ⇒ tick()=0 ∧ state unchanged; easing curve fixes the endpoints c(0)=0, c(1)=1"
     :meta "Pattern: idempotent-on-empty step function.")
    (:eng "Safe to tick even when idle — it costs nothing and returns 0." :math "The step is the identity on the empty state; the curve pins its endpoints." :cs "No-op step returns the zero count."))
  :row-5-emergence (
    (:programs (
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (let loop ((n 0)) (if (or (null? (animation/tweens)) (>= n 60)) n (begin (animation/tick) (loop (+ n 1))))))" :tags (eng composition))
      (:code "(let loop ((f 1) (acc 0)) (if (> f 4) acc (loop (+ f 1) (+ acc (- (easing/linear (/ f 4)) (easing/linear (/ (- f 1) 4)))))))" :tags (math composition))
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (map (lambda (_) (animation/tick)) (list 1 2 3)))" :tags (cs composition)))
     :base "animation/tick is the one verb that advances the animation clock."
     :emergent "Compositions: eng bounded settle-driver (tick until idle or a frame cap), math per-frame deltas summing to the whole displacement, cs fixed-step run loop."
     :meta "Family: fixed-step integrator / game loop.")
    (:eng "A game loop is just tick called until done, with a cap so it always terminates." :math "Summing per-frame deltas of the curve telescopes to the total (1 for the unit curve)." :cs "Same slot as a fixed-timestep update() loop."))
)

(verb :name "animation/clear!" :std "Motoi" :library "animation" :tier "core" :kind "state-change" :signature "(animation/clear!) -> unspecified"
  :summary "Drop every live tween at once — motion stops and the active set becomes empty. The reset at a scene boundary."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(begin (animation/clear!) (null? (animation/tweens)))" :note "Stop all motion; the tween set is now empty.")
    (:dialect "motoi" :tier "intermediate" :code "(begin (motion/move-to (list 'star 0 0) (list 60 0)) (animation/clear!) (null? (animation/tweens)))" :note "After clear, nothing is in flight.")
    (:dialect "motoi" :tier "expert"       :code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (let ((before (length (animation/tweens)))) (animation/clear!) (list before (length (animation/tweens)))))" :note "Capture the count, clear, confirm it dropped to 0 — result (1 0)."))
  :provenance "Motoi core; rewritten onto real tween lifecycle 2026-07-26 (#372)"
  :row-2-audit (
    (:programs (
      (:code "(begin (motion/move-to (list 'a 0 0) (list 9 0)) (animation/clear!) (length (animation/tweens)))" :tags (eng program))
      (:code "(begin (motion/move-to (list 'a 0 0) (list 9 0)) (motion/move-to (list 'b 0 0) (list 9 9)) (animation/clear!) (null? (animation/tweens)))" :tags (math program))
      (:code "(begin (animation/clear!) (animation/clear!) (null? (animation/tweens)))" :tags (cs program)))
     :problem "Starting a new scene while old tweens are still in flight makes motion bleed across scenes — clear first."
     :explanation "eng: reset before a new scene. math: map the active set to ∅. cs: idempotent reset."
     :meta "Reach for animation/clear! and NOT animation/tick to STOP motion: tick advances it; clear removes it. Opposite intents.")
    (:eng "Clear at scene boundaries, not mid-motion." :math "A constant function to the empty set." :cs "Idempotent reset of a collection."))
  :row-3-dimension (
    (:setup "Empty the live animation set so the next scene starts clean."
     :rungs (
       (:domain "engineering"  :code "(begin (animation/clear!) (length (animation/tweens)))")
       (:domain "mathematics"  :code "(begin (motion/move-to (list 'a 0 0) (list 9 0)) (animation/clear!) (null? (animation/tweens)))")
       (:domain "cs / dispatch" :code "(begin (animation/clear!) (animation/clear!) (null? (animation/tweens)))"))
     :explanation "Reset, map-to-empty, idempotent double-clear."
     :meta "Nullary reset of mutable state.")
    (:eng "One reset call at each boundary." :math "Everything ↦ ∅." :cs "Idempotent clear of shared state."))
  :row-4-proof (
    (:programs (
      (:code "(begin (motion/move-to (list 'a 0 0) (list 9 0)) (animation/clear!) (= 0 (length (animation/tweens))))" :tags (eng program))
      (:code "(begin (motion/move-to (list 'a 0 0) (list 9 0)) (animation/clear!) (let ((once (null? (animation/tweens)))) (animation/clear!) (and once (null? (animation/tweens)))))" :tags (math program))
      (:code "(begin (animation/clear!) (motion/move-to (list 'a 0 0) (list 9 0)) (= 1 (length (animation/tweens))))" :tags (cs program)))
     :claim "clear! empties the set; it is idempotent and independent of prior size."
     :invariant "clear(); tweens=∅; clear∘clear = clear; ∀S. clear(S)=∅"
     :meta "Pattern: idempotent reset to a canonical empty state.")
    (:eng "Local reasoning: after clear, the screen is not animating." :math "Constant map: clear(S)=∅ for all S." :cs "Reset is safe to repeat — same slot as truncate."))
  :row-5-emergence (
    (:programs (
      (:code "(define (in-fresh-scene body) (animation/clear!) (let ((r (body))) (animation/clear!) r))\n(in-fresh-scene (lambda () (motion/move-to (list 'a 0 0) (list 9 0)) (length (animation/tweens))))" :tags (eng composition))
      (:code "(define (reset-then f) (animation/clear!) (f))\n(reset-then (lambda () (null? (animation/tweens))))" :tags (math composition))
      (:code "(define (bracket setup teardown body) (setup) (let ((r (body))) (teardown) r))\n(bracket (lambda () (animation/clear!)) (lambda () (animation/clear!)) (lambda () (motion/move-to (list 'a 0 0) (list 9 0)) (length (animation/tweens))))" :tags (cs composition)))
     :base "animation/clear! resets the live tween set to empty."
     :emergent "Compositions: eng fresh-scene wrapper, math reset-to-unit, cs setup/teardown bracket."
     :meta "Family: reset / with-clean-slate / teardown.")
    (:eng "Scene transitions become one clear call, not manual tween removal." :math "Reset supplies the empty state each composition starts from." :cs "Same slot as beforeEach/afterEach in a test harness."))
)
