;;; hash-table-exists-dropped.slatl — Motoi Scheme Reference · broken-examples
;;;
;;; A broken-example is kept ON PURPOSE (CLAUDE.md § Broken-examples teach
;;; the differences). Unlike the ref/update! traps (which run and return a
;;; wrong or late answer), this one is a HARD unbound-symbol error: the name
;;; `hash-table-exists?` was dropped from Motoi's wired surface on 2026-07-24
;;; because it is the SRFI-69 spelling of a predicate SRFI-125 names
;;; `hash-table-contains?`. Two names for one membership test violates the
;;; conformance ladder (adopt the highest standard's name), so the SRFI-69
;;; name was retired.
;;;
;;; Provenance for the DECISION: the standard is LOCKED to SRFI-125 for hash
;;; tables (CLAUDE.md § standard library). SRFI-125 uses `hash-table-contains?`.
;;; The verbatim original verb block is archived at
;;; scheme/reference/_archive/32-hash-divergent-blocks-20260724/.

(dialect :applies ("motoi") :note "broken-example — hash-table-exists? is the dropped SRFI-69 name for hash-table-contains?")

(broken-example :name "hash-table-exists?"
  :library "broken-examples"
  :teaches "membership-predicate-standard-name"
  :std-target "SRFI-125"
  :std-rejected ("SRFI-69")
  :status "dropped"
  :training-eligible #t
  :provenance "scheme/reference/broken-examples/hash-table-exists-dropped.slatl"

  ;; ─── THE BROKEN CODE (unbound symbol) ───
  :broken-code "(hash-table-exists? (make-hash-table) 'k)"
  :broken-output "error: unbound symbol: hash-table-exists?"
  :runs "no — the symbol is not bound in Motoi's wired surface"

  ;; ─── WHY IT IS BROKEN ───
  :why
"`hash-table-exists?` is the SRFI-69 name for the domain-membership predicate.
Motoi's standard library is locked to SRFI-125 for hash tables, and SRFI-125
names the same predicate `hash-table-contains?`. Keeping both would be a
divergent-name duplicate of a standard verb — exactly the shape the CLAUDE.md
conformance ladder forbids (‘a hand-rolled verb that duplicates a standard
verb under a divergent name is a bug’). So the SRFI-69 name was unbound and
the SRFI-125 name is the single wired spelling."

  ;; ─── THE FIX ───
  :fix-code "(hash-table-contains? (make-hash-table) 'k)"
  :fix-output "#f"
  :fix-runs "yes"
  :fix-note
"Rename `hash-table-exists?` to `hash-table-contains?`. Behavior is identical:
returns #t iff the key is bound (regardless of the value it maps to — even a
stored #f counts as present), #f otherwise. This is the value-agnostic read
that distinguishes ‘stored #f’ from ‘never set’, which a ref-with-default
cannot."

  ;; ─── THE LESSON ───
  :lesson
"When one operation has two standard names across SRFI generations, Motoi keeps
the newest/highest standard's name and drops the rest. SRFI-125 supersedes
SRFI-69 for hash tables, so `hash-table-contains?` wins and `hash-table-exists?`
is retired. Port by rename, not by re-adding an alias."

  ;; ─── THE SAME IDEA IN THREE OTHER LIBRARIES ───
  :three-other-libs (
    (:lib "SRFI-125"
     :status "hash-table-contains? is the membership predicate"
     :code "(hash-table-contains? h 'k)   ; => #t / #f"
     :note "The target name. Value-agnostic: a key mapped to #f still reports #t.")
    (:lib "SRFI-69"
     :status "hash-table-exists? was the same predicate under the old name"
     :code "(hash-table-exists? h 'k)"
     :note "The dropped spelling. Identical semantics; different generation of the standard.")
    (:lib "Python"
     :status "the `in` operator / dict.__contains__"
     :code "k in h   # True / False"
     :note "Python has exactly one spelling; the Scheme two-name history is what makes the SRFI port a rename exercise.")
  )

  :motoi-standard
"Target: SRFI-125 `hash-table-contains?` as the single membership predicate.
`hash-table-exists?` dropped from the wired surface 2026-07-24; original verb
block archived under _archive/32-hash-divergent-blocks-20260724/. All live
reference and book programs migrated to `hash-table-contains?`.")
