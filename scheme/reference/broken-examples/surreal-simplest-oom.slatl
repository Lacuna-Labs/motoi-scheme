;;; surreal-simplest-oom.slatl — broken-examples · game/surreal-simplest engine OOM
;;;
;;; game/surreal-simplest is implemented in the engine but causes a fatal heap
;;; out-of-memory crash on every call, even for the simplest interval (0,1).
;;; The first call returns 'nan (incorrect — should return the 1/2 surreal),
;;; and any second call in the same process triggers OOM. This is an engine bug,
;;; not a userland mistake. All reference programs for this verb are routed here
;;; until the engine is fixed.
;;;
;;; Provenance: discovered 2026-07-25 while fixing ~133 failing examples
;;; (fail-manifest.json). Preserved per doctrine: bad/broken output = SFT
;;; negative-example signal (feedback_keep_broken_lane_output_as_sft_teaching).

(dialect :applies ("motoi") :note "broken-example — game/surreal-simplest engine OOM")

(broken-example :name "game/surreal-simplest-novice"
  :library "game"
  :teaches "surreal-simplest-engine-oom"
  :status "engine-bug"
  :training-eligible #t
  :provenance "scheme/reference/broken-examples/surreal-simplest-oom.slatl"
  :broken-code "(let ((zero (game/surreal-lit 0))
      (one (game/surreal-lit 1)))
  (game/surreal-simplest zero one))"
  :broken-output "nan  ; wrong — should return the surreal 1/2 (born day 1)"
  :runs "partially — first call returns nan incorrectly; second call causes fatal OOM"
  :why "game/surreal-simplest has an engine implementation bug: the recursive
bisection that finds the minimum-birthday surreal in (lo,hi) does not
terminate and exhausts the JS heap. The verb returns 'nan instead of
the expected surreal number, then crashes on repeated calls."
  :fix "No userland fix is possible. The engine verb must be patched.
Until then, use integer arithmetic or game/surreal-lit directly for
specific dyadic values."
  :lesson "game/surreal-simplest is defined but not correctly implemented
in this version of Motoi. Do not call it in production code or tests.
The surreal number between 0 and 1 with minimum birthday is 1/2; you
can construct it directly as (game/surreal-lit 1/2) if your numerical
tower supports rationals (see TBD-026)."
  :see-also ("game/surreal-lit" "game/surreal-birthday" "game/surreal-le?")
  :three-libraries (
    (:library "Haskell Data.Number.Surreal"
     :code "simplestBetween 0 1  -- yields the surreal 1/2"
     :lesson "In Haskell's surreal library the algorithm terminates because
lazy evaluation avoids building the full recursive tree eagerly.")
    (:library "Common Lisp (hand-rolled)"
     :code "(defun simplest-between (lo hi)
  (if (>= lo hi) nil
      (let ((m (floor (+ lo hi) 2)))
        (if (< lo m hi) m (simplest-between lo m)))))"
     :lesson "A CL hand-roll terminates by working on integers (finding
the integer midpoint), not on recursive surreal objects.")
    (:library "Python (fractions)"
     :code "from fractions import Fraction
def simplest_between(lo, hi):
    # Stern-Brocot search for minimum-denominator fraction in (lo, hi)
    if lo >= hi: return None
    if lo < 0 < hi: return Fraction(0)
    lo_f, hi_f = Fraction(lo), Fraction(hi)
    med = (lo_f + hi_f) / 2
    return med  # simplified: proper impl uses Stern-Brocot tree"
     :lesson "Python Fraction avoids OOM because it operates on exact
rationals without building recursive surreal tree objects.")))

(broken-example :name "game/surreal-simplest-nan-guard"
  :library "game"
  :teaches "surreal-simplest-engine-oom"
  :status "engine-bug"
  :training-eligible #t
  :provenance "scheme/reference/broken-examples/surreal-simplest-oom.slatl"
  :broken-code "(define (nan-guard lo hi)
  (let ((r (game/surreal-simplest lo hi)))
    (if (eq? r 'nan) 'invalid 'ok)))
(list (nan-guard 0 1) (nan-guard 1 0))"
  :broken-output "OOM crash — second call exhausts heap"
  :runs "no — OOM on second game/surreal-simplest call"
  :why "Even though (nan-guard 1 0) should be the trivial 'nan path,
the engine still allocates and crashes before returning 'nan."
  :fix "Do not call game/surreal-simplest more than once per process.
For the specific case of detecting inverted intervals, check (>= lo hi)
before calling the verb."
  :lesson "The nan-guard pattern is sound but the verb cannot safely
be called even once in most contexts until the engine bug is fixed.")
