;;; 75-image-compose.slat — Motoi Scheme Reference · Chapter 75 · library image-compose
;;;
;;; 15 verbs in this library. Read chapter 00-intro.slat first.
;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; An "image" is a value made by the img/* constructors of chapter 74
;;; (e.g. (img/circle 10 'solid 'red), (img/square 20 'outline 8)). Modes are
;;; quoted 'solid/'outline; colors are palette index 0-15 or quoted names.
;;; The pure combinators return image VALUES; the two draw-image sinks PAINT
;;; and need (set-mode 'sd) first. Every code block RUNS through ./bin/motoi.
;;; Made by Alfred Borden.

(dialect :applies ("motoi") :note "Library image-compose — 15 verbs.")

(chapter :number "75" :library "image-compose" :verb-count 15 :training-eligible #t)

;; ═══ 15 verbs in library image-compose ═══

(verb
  :name "overlay" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(overlay img ...) -> image"
  :summary "Stack images centered on a shared center, first argument painted on top; returns a single image."
  :explanation "overlay takes any number of images and lays them one on top of another, all sharing the same center point. The FIRST argument ends up on top, the last at the bottom — the reading order is the paint order reversed, exactly like the layers panel of a paint program where the top row is drawn last. The result is one image whose bounding box is as wide as the widest layer and as tall as the tallest layer; smaller layers float centered inside it. Reach for overlay whenever a picture is really several pictures sharing a center: a target's rings, a coin's face on its disc, a symbol inside a badge. It is the z-order primitive of the image algebra — beside and above lay things out side by side, but overlay is the only combinator that puts one thing in FRONT of another."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image? (overlay (img/circle 6 'solid 'red) (img/circle 12 'solid 'white)))" :note "A small red disc centered on a larger white one — the classic dot-on-a-plate. #t confirms the result is a single composed image.")
    (:dialect "motoi" :tier "intermediate" :code "(define dot   (img/circle 4 'solid 8))\n(define ring  (img/circle 10 'outline 12))\n(define plate (img/circle 16 'solid 6))\n(image-width (overlay dot ring plate))" :note "Three concentric layers; the reported width is the widest layer (the plate, diameter 32), because overlay's box is the max over its layers.")
    (:dialect "motoi" :tier "expert" :code "(define layers (map (lambda (r) (img/circle r 'outline (if (even? r) 8 12))) (list 4 8 12 16 20)))\n(image? (apply overlay layers))" :note "Build a stack of concentric rings from a list of radii and collapse it in one apply — overlay is variadic, so a computed list of layers folds straight in.")
  )
  :caveats ("The FIRST argument is on top, not the last — get this backwards and your foreground disappears behind the background." "Everything shares one center; overlay cannot offset a layer. To place a layer off-center use place-image on a scene instead." "The result box is the max of the layers' boxes, so a tiny layer over a huge one yields a huge image, not a tiny one." "Transparent regions of an upper layer let lower layers show through; a solid upper layer occludes everything beneath it at those pixels.")
  :drawbacks ("No per-layer opacity or blend mode — layers are opaque where they paint; you cannot do a 50% ghost with overlay alone." "No control of the anchor: all layers are center-aligned. Grids of off-center pieces want place-image or beside/above." "Deeply nested overlays rebuild an intermediate image at every level, so a hundred-layer stack allocates a hundred boxes.")
  :usecases ("Concentric decorations: targets, coins, badges, eyes (pupil on iris on white)." "Compositing a foreground symbol onto a background plate or button." "Layering an outline ring over a solid fill to draw a bordered disc." "Building nested-frame objects like a window with a mullion, or a building of encased squares.")
  :related ("beside" "above" "place-image" "empty-scene" "image-width")
  :learn (:concept "Centered z-ordered layering: many images collapsed into one along the depth axis, foreground first." :prerequisites ("img/circle" "img/square") :progression "Once overlay's centered stacking is clear, learn beside/above for side-by-side layout, then place-image for off-center positioning on a fixed-size scene.")
  :row-2-audit (
    (:problem "A kid drawing a shooting target wants three rings that share a bullseye: a small solid center, a middle ring, and a big outer ring, all lined up on one center so it reads as a single target and not three scattered circles."
     :program "(overlay (img/circle 4 'solid 'red)\n         (img/circle 10 'outline 'white)\n         (img/circle 16 'outline 'red))"
     :eng-program "(define (target radii palette)\n  (apply overlay\n    (map (lambda (r c) (img/circle r (if (= r (apply min radii)) 'solid 'outline) c))\n         radii palette)))\n(image? (target (list 4 10 16) (list 'red 'white 'red)))"
     :math-program "(define (concentric radii)\n  ;; radii listed small-to-large; overlay's first-on-top means small stays visible.\n  (apply overlay (map (lambda (r) (img/circle r 'outline 8)) radii)))\n(image-width (concentric (list 4 10 16)))"
     :cs-program "(define (typed-overlay imgs)\n  (if (and (pair? imgs) (every image? imgs))\n      (apply overlay imgs)\n      (error 'overlay \"needs a non-empty list of images\")))\n(image? (typed-overlay (list (img/circle 4 'solid 8) (img/circle 10 'outline 12))))"
     :explanation "eng: parameterize the target by radii and palette so one function draws any bullseye. math: state the small-to-large order that keeps the center visible. cs: guard that every argument is an image before applying."
     :meta "beside would put the three circles in a row, not on one center — a row of circles is not a target. above stacks them vertically — same problem, wrong axis. place-image could do it but forces you to name a scene size and compute three center coordinates by hand; overlay already means 'same center', so it is the least-error way to say 'these share a bullseye'.")
    (:eng "The audit lens is 'is the foreground actually on top?' — the smoke test is to overlay a tiny bright disc on a big dark one and confirm you can still see the disc; if it vanished, the argument order regressed." :math "overlay is the fold of a binary center-align-and-paint operation over the argument list, with identity the empty (transparent) image." :cs "Variadic z-compositor: O(n) box allocations for n layers, each box the running max of widths and heights."))
  :row-3-dimension (
    (:setup "Combine several contributions that all register to the same reference point, keeping their order of precedence."
     :rungs (
       (:domain "image"   :code "(image? (overlay (img/circle 4 'solid 8) (img/circle 10 'solid 12)))")
       (:domain "stacked-cards" :code "(define (top-of-deck cards) (if (null? cards) 'empty (car cards)))\n(top-of-deck (list 'ace 'king 'queen))")
       (:domain "function-composition" :code "(define (compose f g) (lambda (x) (f (g x))))\n((compose (lambda (x) (* x 2)) (lambda (x) (+ x 1))) 5)"))
     :explanation "Rung 1: images share a center and the first one painted last stays on top. Rung 2: a deck of cards shares one position on the table and the top card is the one you see. Rung 3: composing f after g means f wins at the output — the outermost/first function is what the world sees. All three share the shape 'many things registered to one spot, ordered by who is in front'."
     :meta "The transfer works because layering is precedence: whichever contribution is nearest the observer (top card, foreground layer, outermost function) is the one that shows. Every substrate with a single viewing point and a stack of candidates uses this z-order shape.")
    (:eng "Every layered substrate shares the failure mode 'the wrong thing is on top' — the SRE fix is to make paint order explicit and testable rather than incidental." :math "A total order on layers by depth; the visible pixel is the topmost non-transparent layer at that coordinate." :cs "Painter's-algorithm compositing; the same shape as CSS z-index and a windowing system's stacking order."))
  :row-4-proof (
    (:claim "The width of an overlay is the maximum of its layers' widths (and likewise height): centered stacking never grows the box beyond the widest layer."
     :program "(define a (img/square 10 'solid 8))\n(define b (img/square 30 'solid 12))\n(display (= (image-width (overlay a b)) (max (image-width a) (image-width b)))) (newline)\n(display (= (image-height (overlay a b)) (max (image-height a) (image-height b))))"
     :eng-program "(define (box-audit layers)\n  (let ((o (apply overlay layers)))\n    (list 'overlay-w (image-width o)\n          'max-layer-w (apply max (map image-width layers))\n          'match? (= (image-width o) (apply max (map image-width layers))))))\n(box-audit (list (img/square 10 'solid 8) (img/square 24 'outline 6) (img/square 30 'solid 12)))"
     :math-program "(define (max-width . imgs) (apply max (map image-width imgs)))\n(display (= (image-width (overlay (img/square 8 'solid 8) (img/square 20 'solid 12)))\n            (max-width (img/square 8 'solid 8) (img/square 20 'solid 12))))"
     :cs-program "(define (box-is-max? imgs)\n  (let ((o (apply overlay imgs)))\n    (and (= (image-width o)  (apply max (map image-width imgs)))\n         (= (image-height o) (apply max (map image-height imgs))))))\n(display (box-is-max? (list (img/square 10 'solid 8) (img/square 30 'outline 12))))"
     :invariant "∀ layers L. image-width(overlay L) = max_{l∈L} image-width(l) ∧ image-height(overlay L) = max_{l∈L} image-height(l)"
     :meta "The pattern is that a combinator's box is a monoidal fold — here the fold operator is max. Falsified if an overlay were wider than its widest layer, which would mean centering silently added margin — a bug that would misalign every downstream place-image. book-of-math grounds max as the join of a lattice; the box is the least upper bound of the layer boxes.")
    (:eng "The engineering consequence is that you can predict an overlay's footprint from its layers without rendering it — sizing a scene to hold a target needs only the biggest ring." :math "The box map is a lattice join: width and height are each the ⊔ (max) of the layer coordinates." :cs "Bounding-box-is-max invariant; the same shape as the union of axis-aligned boxes taking the max extent per axis."))
  :row-5-emergence (
    (:base "overlay alone centers a stack of layers into one image."
     :composition "(set-mode 'sd)\n(draw-image/center\n  (overlay (img/square 10 'solid 7)\n           (img/square 20 'outline 6)\n           (img/square 30 'outline 5))\n  80 80)"
     :eng-composition "(define (building floors)\n  ;; each floor is a slightly larger encasing square; overlay nests them.\n  (apply overlay\n    (map (lambda (i) (img/square (* 10 (+ i 1)) (if (= i 0) 'solid 'outline) (- 7 i)))\n         (iota floors))))\n(image? (building 3))"
     :math-composition "(define (nested-squares sizes)\n  ;; overlay of squares sized s1<s2<...<sn ⇒ box = max size = last.\n  (let ((b (apply overlay (map (lambda (s) (img/square s 'outline 8)) sizes))))\n    (list 'box (image-width b) 'largest (apply max sizes))))\n(nested-squares (list 10 20 30))"
     :cs-composition "(define (encase base rings)\n  (fold (lambda (r acc) (overlay acc (img/square r 'outline 5))) base rings))\n(image-width (encase (img/square 10 'solid 7) (list 20 30)))"
     :emergent "A building: squares encased in each other. A small solid square (the door/core) sits inside a medium outline square (the wall) inside a big outline square (the facade), all centered — and the eye reads it as a little tower. This is a scene graph collapsed along the depth axis: each overlay call is a parent node whose children register to its center."
     :meta "This is the compositional-geometry family — recognizable objects built from primitives sharing a frame. The nested-square building generalizes to badges, targets, and picture-in-picture; the shape is a z-buffer with centered anchors. It works because Row 4 fixes the box as the max, so nesting a bigger frame around a smaller one always leaves the inner one visible and centered.")
    (:eng "The audit lens is 'the smallest layer must survive to the top' — an operator building nested frames checks the innermost detail is still visible after every added frame." :math "A rooted tree of centered layers; the rendered image is the depth-first paint of the tree with the root drawn last." :cs "Scene-graph / z-buffer compositing; the shape of every UI that nests a badge inside a button inside a card."))
)

(verb
  :name "beside" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(beside img ...) -> image"
  :summary "Lay images left-to-right in a row, vertically centered; returns one wider image."
  :explanation "beside is horizontal layout. It sets its argument images down in a row, left to right, in the order you write them, each one's vertical middle lined up with its neighbors'. Nothing overlaps — every image gets its own column of pixels, so the row is exactly as wide as all the pieces added together and as tall as the tallest piece. Where overlay answers 'what is in front of what', beside answers 'what comes after what along the x-axis'. It is one half of the layout box-model (above is the other half): reach for it to build a row of tiles, a strip of frames, a word made of letter-images, or the two eyes of a face. Because widths add and heights take the max, beside is the concatenation operator of the picture algebra — gluing images the way you glue strings end to end."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (beside (img/square 10 'solid 8) (img/square 10 'solid 12)))" :note "Two 10-wide squares side by side make a 20-wide row — widths add straight up.")
    (:dialect "motoi" :tier "intermediate" :code "(define eye (img/circle 4 'solid 0))\n(define gap (img/square 6 'solid 'white))\n(image-width (beside eye gap eye))" :note "Two eyes with a spacer square between them; beside threads three pieces into one strip, so the total width is 8 + 6 + 8 = 22.")
    (:dialect "motoi" :tier "expert" :code "(define tiles (map (lambda (c) (img/square 8 'solid c)) (list 8 9 10 11 12)))\n(image-width (apply beside tiles))" :note "A five-color palette swatch built by mapping colors to squares and gluing them in one apply — beside is variadic, so a computed list becomes a row.")
  )
  :caveats ("Pieces are centered on the row's vertical midline, so mixing tall and short images leaves the short ones floating in the middle of their column, not sitting on a shared baseline." "beside does not add spacing; adjacent images touch. Insert a blank img/square or empty-scene if you want a gap." "Order is exactly left-to-right as written — the first argument is leftmost, unlike overlay where the first is on top." "The row's height is the tallest piece; a single tall image makes the whole strip tall.")
  :drawbacks ("No baseline alignment option — everything is center-aligned vertically; text-like layouts that need a common baseline must pad each piece by hand." "No wrapping: a long row does not fold onto a second line. Compose beside with above to build a grid." "Each glue step allocates a new wider image, so building a long row by repeated beside is O(n²) in copied pixels unless you fold once with apply.")
  :usecases ("Rows of tiles, swatches, or inventory slots." "Placing two symmetric features side by side (eyes, wheels, bookends)." "Spelling a word or number from per-glyph images." "Building the columns of a grid before stacking the rows with above.")
  :related ("above" "overlay" "place-image" "image-width" "image-height")
  :learn (:concept "Horizontal concatenation: widths add, height is the max, pieces vertically centered." :prerequisites ("img/square" "image-width") :progression "Master beside for rows, then above for columns; combine the two to lay out a grid, and reach for place-image when a piece must sit at an arbitrary coordinate.")
  :row-2-audit (
    (:problem "A game maker building a health bar wants a row of five little heart squares in a line so the player reads it as one bar, not five loose hearts scattered across the HUD."
     :program "(apply beside\n  (map (lambda (i) (img/square 8 'solid 'red))\n       (iota 5)))"
     :eng-program "(define (health-bar hearts color)\n  (apply beside (map (lambda (i) (img/square 8 'solid color)) (iota hearts))))\n(image-width (health-bar 5 'red))"
     :math-program "(define (row-width piece-w n) (* piece-w n))\n(list 'formula (row-width 8 5)\n      'actual (image-width (apply beside (map (lambda (i) (img/square 8 'solid 'red)) (iota 5)))))"
     :cs-program "(define (bounded-row n)\n  (if (and (integer? n) (> n 0) (< n 100))\n      (apply beside (map (lambda (i) (img/square 8 'solid 'red)) (iota n)))\n      (error 'health-bar \"count out of range\")))\n(image-width (bounded-row 5))"
     :explanation "eng: parameterize the bar by heart count and color. math: the closed form width = piece-width × count, checked against the real render. cs: bound the count so a bad input cannot allocate a mile-wide strip."
     :meta "overlay would stack all five hearts on one center — you would see one heart, not a bar. above would pile them into a vertical column, which is a stack not a bar. place-image would work but makes you compute five x-coordinates and pick a scene width; beside means 'in a row, touching, in order', which is exactly a bar.")
    (:eng "The audit lens is 'the strip width equals the sum of the parts' — the smoke test after any layout change is (= total (apply + parts)); a mismatch means hidden padding crept in." :math "beside is the fold of horizontal concatenation, an associative operation whose identity is the zero-width image; widths form a monoid under +." :cs "Left-to-right concatenator: width is a running sum, height a running max; one apply-fold is O(total pixels), repeated pairwise beside is O(n²)."))
  :row-3-dimension (
    (:setup "Join a sequence of pieces end to end so the whole is the pieces laid out in order with no overlap."
     :rungs (
       (:domain "image"  :code "(image-width (beside (img/square 5 'solid 8) (img/square 7 'solid 12)))")
       (:domain "string" :code "(string-append \"foo\" \"bar\")")
       (:domain "list-length-sum" :code "(+ (length (list 1 2 3)) (length (list 4 5)))"))
     :explanation "Rung 1: images placed side by side make a row whose width is the sum of the pieces' widths. Rung 2: strings appended make a string whose length is the sum of the pieces' lengths. Rung 3: two lists concatenated have length equal to the sum of the lengths. All three share the shape 'concatenate ordered pieces; the size of the whole is the sum of the sizes of the parts'."
     :meta "The transfer works because concatenation is a length-adding monoid: append two things end to end and their measures add. Whether the measure is pixels, characters, or elements, the associative glue and the additive size are the same shape.")
    (:eng "Every concatenation substrate shares the audit 'measure(whole) = Σ measure(part)' and the failure mode 'overlap or gap silently broke the sum'." :math "A free monoid on the pieces with a length homomorphism into (ℕ, +); beside's width is that homomorphism." :cs "Sequence concatenation; the same shape as string-append, list-append, and buffer concatenation in every language."))
  :row-4-proof (
    (:claim "The width of beside is the sum of its pieces' widths, and its height is the maximum of their heights."
     :program "(define a (img/square 10 'solid 8))\n(define b (img/rectangle 14 6 'solid 12))\n(display (= (image-width (beside a b)) (+ (image-width a) (image-width b)))) (newline)\n(display (= (image-height (beside a b)) (max (image-height a) (image-height b))))"
     :eng-program "(define (row-audit pieces)\n  (let ((r (apply beside pieces)))\n    (list 'row-w (image-width r) 'sum-w (apply + (map image-width pieces))\n          'match? (= (image-width r) (apply + (map image-width pieces))))))\n(row-audit (list (img/square 4 'solid 8) (img/square 6 'solid 9) (img/square 8 'solid 10)))"
     :math-program "(define (sum-widths . imgs) (apply + (map image-width imgs)))\n(display (= (image-width (beside (img/square 5 'solid 8) (img/square 9 'solid 12)))\n            (sum-widths (img/square 5 'solid 8) (img/square 9 'solid 12))))"
     :cs-program "(define (width-additive? pieces)\n  (= (image-width (apply beside pieces))\n     (apply + (map image-width pieces))))\n(display (width-additive? (list (img/square 3 'solid 8) (img/square 4 'solid 9) (img/square 5 'solid 10))))"
     :invariant "∀ pieces P. image-width(beside P) = Σ_{p∈P} image-width(p) ∧ image-height(beside P) = max_{p∈P} image-height(p)"
     :meta "The pattern is a mixed fold: width folds with + (a group), height folds with max (a lattice). Falsified if a row were narrower than the sum of its parts, which would mean images secretly overlapped — corrupting every downstream coordinate. This is why beside and overlay differ: beside adds on the layout axis, overlay maxes.")
    (:eng "The engineering consequence is that you can size a HUD strip to hold n items by summing item widths, no rendering needed." :math "Width is a monoid homomorphism (pieces, concat) → (ℕ, +); height is a semilattice homomorphism into (ℕ, max)." :cs "Additive-width / max-height invariant; the same shape as concatenation adding lengths while parallel-max bounds a common dimension."))
  :row-5-emergence (
    (:base "beside alone glues a row of images left to right."
     :composition "(above (beside (img/square 8 'outline 12) (img/square 8 'outline 12))\n       (beside (img/square 8 'outline 12) (img/square 8 'outline 12)))"
     :eng-composition "(define (window-grid rows cols)\n  ;; rows of beside'd panes, stacked by above ⇒ a gridded window wall.\n  (apply above\n    (map (lambda (r)\n           (apply beside (map (lambda (c) (img/square 8 'outline 12)) (iota cols))))\n         (iota rows))))\n(image? (window-grid 3 4))"
     :math-composition "(define (grid-dims cell n-cols n-rows)\n  ;; beside adds cols ⇒ width = cell*cols; above adds rows ⇒ height = cell*rows.\n  (list 'w (* cell n-cols) 'h (* cell n-rows)))\n(grid-dims 8 4 3)"
     :cs-composition "(define (checkerboard n)\n  (apply above\n    (map (lambda (r)\n           (apply beside\n             (map (lambda (c) (img/square 6 'solid (if (even? (+ r c)) 0 15))) (iota n))))\n         (iota n))))\n(image-width (checkerboard 4))"
     :emergent "A grid: rows built by beside, stacked by above. Four window-panes become a two-by-two mullioned window; extend it and you get a wall of windows on a building, or a checkerboard, or a tile map. This is the layout box-model — the same row-then-column nesting that HTML tables, spreadsheet cells, and sprite sheets use."
     :meta "This is the layout / box-model family — a two-axis product of one-dimensional concatenations. beside supplies the horizontal axis, above the vertical; their nesting is a Cartesian grid. It composes cleanly because Row 4 makes beside's width additive and above's height additive, so grid dimensions are just cell-size times counts.")
    (:eng "The audit lens is 'rows must be equal width or the grid ragged-edges' — the operator check is that every beside-row sums to the same width before above stacks them." :math "The grid is the tensor of two free monoids: (cols under beside) ⊗ (rows under above), a rectangular lattice of cells." :cs "Row-major layout; the shape of every table renderer, tile-map, and sprite atlas."))
)

(verb
  :name "above" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(above img ...) -> image"
  :summary "Stack images top-to-bottom in a column, horizontally centered; returns one taller image."
  :explanation "above is vertical layout — the sibling of beside turned ninety degrees. It stacks its images in a column, top to bottom in argument order, each one horizontally centered over the one below. Like beside, nothing overlaps: every image owns its own band of rows, so the column is exactly as tall as all the pieces summed and as wide as the widest piece. The first argument is on top of the column (careful — 'above' names where the first piece sits, the top). Reach for above to pile discs into a snowman, sit a crown on a trunk to make a tree, stack menu rows, or build the rows of a grid before nothing-or-beside makes the columns. In the box-model it is the vertical concatenation operator; heights add, width takes the max — the mirror image of beside's arithmetic."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-height (above (img/square 10 'solid 8) (img/square 12 'solid 6)))" :note "A 10-tall square on a 12-tall square gives a 22-tall column — heights add, exactly the vertical version of beside.")
    (:dialect "motoi" :tier "intermediate" :code "(define crown (img/circle 12 'solid 11))\n(define trunk (img/rectangle 6 16 'solid 5))\n(image? (above crown trunk))" :note "A round green crown sitting on top of a brown trunk rectangle — the first argument (crown) is at the top, so above reads a little tree straight down the page.")
    (:dialect "motoi" :tier "expert" :code "(define discs (map (lambda (r) (img/circle r 'solid 12)) (list 6 9 12)))\n(image-height (apply above discs))" :note "Three discs of growing radius stacked smallest-on-top build a snowman in one apply; total height is the sum of the diameters (12 + 18 + 24 = 54).")
  )
  :caveats ("The FIRST argument is the TOP of the column, not the bottom — reverse the order and your snowman stands on its head." "Pieces are horizontally centered, so a narrow piece over a wide one floats centered above it rather than aligning to a left edge." "No vertical spacing is inserted; stacked images touch edge to edge. Add a blank piece for a gap." "The column's width is the widest piece; one wide image widens the whole stack.")
  :drawbacks ("No left/right alignment option — everything centers horizontally; ragged-left stacks need manual padding." "No column-balancing: above cannot equalize piece heights. Uneven pieces make an uneven column." "Repeated pairwise above copies the growing image each step (O(n²) pixels); fold once with apply above for a long column.")
  :usecases ("Vertical figures: snowmen, trees, totem stacks, traffic lights." "Stacking rows to build a grid (rows from beside, columns from above)." "Menu and list layouts where each entry is its own image band." "Title-over-body compositions like a captioned picture.")
  :related ("beside" "overlay" "place-image" "image-height" "image-width")
  :learn (:concept "Vertical concatenation: heights add, width is the max, pieces horizontally centered, first argument on top." :prerequisites ("img/circle" "image-height") :progression "Learn above alongside beside as the two layout axes; nest them for grids, and switch to place-image when a piece needs a free coordinate rather than a stacked band.")
  :row-2-audit (
    (:problem "A kid wants to draw a snowman: three white discs of growing size, the small one on top, stacked so they read as one figure standing up rather than three circles in a heap."
     :program "(above (img/circle 6 'solid 'white)\n       (img/circle 9 'solid 'white)\n       (img/circle 12 'solid 'white))"
     :eng-program "(define (snowman radii)\n  (apply above (map (lambda (r) (img/circle r 'solid 'white)) radii)))\n(image-height (snowman (list 6 9 12)))"
     :math-program "(define (column-height radii)\n  ;; each disc contributes its diameter 2r to the column height.\n  (apply + (map (lambda (r) (* 2 r)) radii)))\n(list 'formula (column-height (list 6 9 12))\n      'actual (image-height (apply above (map (lambda (r) (img/circle r 'solid 'white)) (list 6 9 12)))))"
     :cs-program "(define (ordered-ascending? xs)\n  (or (null? (cdr xs)) (and (<= (car xs) (cadr xs)) (ordered-ascending? (cdr xs)))))\n(define radii (list 6 9 12))\n(if (ordered-ascending? radii)\n    (image? (apply above (map (lambda (r) (img/circle r 'solid 'white)) radii)))\n    (error 'snowman \"radii must grow downward\"))"
     :explanation "eng: parameterize the snowman by a list of radii. math: the column height is the sum of the diameters. cs: enforce the small-on-top ordering so the figure never comes out top-heavy."
     :meta "overlay would center all three discs on one point — a single disc, not a snowman. beside would lay them in a horizontal row — a caterpillar, not a snowman. place-image would work but forces three y-coordinates and a scene height; above means 'stacked, in order, centered', which is exactly a standing figure.")
    (:eng "The audit lens is 'the column height equals the sum of the parts' — the smoke test is (= total (apply + heights)); a mismatch means overlap or padding leaked in on the vertical axis." :math "above is the fold of vertical concatenation, associative with the zero-height identity; heights form a monoid under +." :cs "Top-to-bottom concatenator: height is a running sum, width a running max; apply-fold is O(total pixels), pairwise is O(n²)."))
  :row-3-dimension (
    (:setup "Stack ordered pieces along one axis so the whole spans the sum of the pieces and no piece overlaps another."
     :rungs (
       (:domain "image" :code "(image-height (above (img/square 5 'solid 8) (img/square 7 'solid 12)))")
       (:domain "stacked-blocks" :code "(define (tower-height blocks) (apply + blocks))\n(tower-height (list 3 3 5))")
       (:domain "vector-add-1d" :code "(+ 6 4)"))
     :explanation "Rung 1: images stacked vertically make a column whose height is the sum of the pieces' heights. Rung 2: physical blocks stacked into a tower reach a height equal to the sum of the block heights. Rung 3: adding one-dimensional lengths along a shared axis gives their total. All three share the shape 'lay pieces along an axis; the extent of the whole is the sum of the extents of the parts'."
     :meta "The transfer works because stacking-along-an-axis is one-dimensional addition: place things nose to tail on a line and their lengths accumulate. The substrate — pixels, bricks, scalars — does not change the additive shape.")
    (:eng "Every stack-along-an-axis substrate shares the audit 'extent(whole) = Σ extent(part)' and the failure 'overlap or gap broke the sum'." :math "A one-dimensional total order with an additive measure; the extent map is a monoid homomorphism into (ℕ, +)." :cs "Axis-aligned stacking; the same shape as summing byte-sizes to lay out a struct or accumulating offsets in a layout pass."))
  :row-4-proof (
    (:claim "The height of above is the sum of its pieces' heights, and its width is the maximum of their widths."
     :program "(define a (img/square 10 'solid 8))\n(define b (img/rectangle 20 6 'solid 12))\n(display (= (image-height (above a b)) (+ (image-height a) (image-height b)))) (newline)\n(display (= (image-width (above a b)) (max (image-width a) (image-width b))))"
     :eng-program "(define (column-audit pieces)\n  (let ((c (apply above pieces)))\n    (list 'col-h (image-height c) 'sum-h (apply + (map image-height pieces))\n          'match? (= (image-height c) (apply + (map image-height pieces))))))\n(column-audit (list (img/square 4 'solid 8) (img/square 6 'solid 9) (img/square 8 'solid 10)))"
     :math-program "(define (sum-heights . imgs) (apply + (map image-height imgs)))\n(display (= (image-height (above (img/square 5 'solid 8) (img/square 9 'solid 12)))\n            (sum-heights (img/square 5 'solid 8) (img/square 9 'solid 12))))"
     :cs-program "(define (height-additive? pieces)\n  (= (image-height (apply above pieces))\n     (apply + (map image-height pieces))))\n(display (height-additive? (list (img/square 3 'solid 8) (img/square 4 'solid 9))))"
     :invariant "∀ pieces P. image-height(above P) = Σ_{p∈P} image-height(p) ∧ image-width(above P) = max_{p∈P} image-width(p)"
     :meta "The pattern is the transpose of beside's: above folds heights with + and widths with max, exactly swapping the two axes' roles. Falsified if a column were shorter than its stacked parts, meaning pieces overlapped vertically — the same class of coordinate corruption beside guards against, rotated ninety degrees. That above and beside are transposes is the whole reason a grid works.")
    (:eng "The engineering consequence is that you can size a stacked menu to hold n rows by summing row heights, without rendering." :math "Height is a monoid homomorphism into (ℕ, +); width is a semilattice homomorphism into (ℕ, max) — the axis-swap of beside." :cs "Additive-height / max-width invariant; the transpose of beside, so the two compose into a two-dimensional layout algebra."))
  :row-5-emergence (
    (:base "above alone stacks a column of images top to bottom."
     :composition "(set-mode 'sd)\n(draw-image/center\n  (above (img/circle 12 'solid 11)\n         (img/rectangle 6 16 'solid 5))\n  60 60)"
     :eng-composition "(define (tree crown-r trunk-w trunk-h)\n  (above (img/circle crown-r 'solid 11)\n         (img/rectangle trunk-w trunk-h 'solid 5)))\n(image-height (tree 12 6 16))"
     :math-composition "(define (tree-height crown-r trunk-h)\n  ;; above adds heights: crown diameter + trunk height.\n  (+ (* 2 crown-r) trunk-h))\n(list 'formula (tree-height 12 16)\n      'actual (image-height (above (img/circle 12 'solid 11) (img/rectangle 6 16 'solid 5))))"
     :cs-composition "(define (forest n)\n  (apply beside\n    (map (lambda (i) (above (img/circle 8 'solid 11) (img/rectangle 4 10 'solid 5))) (iota n))))\n(image-width (forest 3))"
     :emergent "A tree: a round crown stacked above a trunk rectangle. Repeat it with beside and you get a forest; swap the crown for a triangle and it is a pine; stack three discs instead and it is a snowman. This is the layout box-model on the vertical axis — the same stacking that lays out paragraphs, menu rows, and vertical UI flexboxes."
     :meta "This is the layout / box-model family seen down the vertical axis. above builds recognizable upright figures because gravity-shaped objects (trees, snowmen, towers, traffic lights) are stacks of parts; combined with beside it spans the full two-dimensional grid. It composes because Row 4 makes above's height additive, so a tree's height is just crown-diameter plus trunk-height.")
    (:eng "The audit lens is 'the top piece must actually be on top' — the operator check is that the first argument's band occupies the topmost rows of the result." :math "A column is a chain in the vertical order; nesting a column of rows (each a beside) yields the grid lattice." :cs "Vertical block layout; the shape of every document flow, menu stack, and column-major figure."))
)

(verb
  :name "place-image" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(place-image img x y scene) -> image"
  :summary "Return a copy of scene with img centered at coordinate (x,y); the result keeps the scene's size."
  :explanation "place-image is the free-coordinate combinator. Where overlay/beside/above align pieces automatically (center, row, column), place-image lets you drop an image at any (x,y) you choose on top of a background scene — its center lands exactly on that point. The result is a NEW image the same width and height as the scene: the scene is the frame, the placed image is painted into it, and anything that runs off the edge is clipped. This is the primitive you build worlds with: put a ball at (30,40), then place-image the paddle at (100,220), then the score. Repeated place-image calls thread a scene through many placements, each one returning an updated scene — the immutable-canvas way of composing a whole picture from positioned parts. It is the bridge from the auto-layout algebra to explicit coordinates."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (place-image (img/circle 5 'solid 8) 20 20 (empty-scene 60 40)))" :note "A dot placed on a 60x40 scene; the result is still 60 wide — place-image keeps the SCENE's size, not the dot's.")
    (:dialect "motoi" :tier "intermediate" :code "(define scene (empty-scene 100 60 3))\n(define with-ball (place-image (img/circle 6 'solid 12) 30 30 scene))\n(image? (place-image (img/square 8 'solid 8) 70 30 with-ball))" :note "Thread a scene through two placements — a ball then a block — each call returning the next scene. This is how a frame is assembled one object at a time.")
    (:dialect "motoi" :tier "expert" :code "(define (scatter scene coords)\n  (fold (lambda (xy s) (place-image (img/circle 3 'solid 12) (car xy) (cadr xy) s))\n        scene coords))\n(image-width (scatter (empty-scene 80 80) (list (list 10 10) (list 40 40) (list 70 70))))" :note "Fold a list of coordinates into a scene, placing a star at each — the result stays 80 wide because every place-image preserves the scene's frame.")
  )
  :caveats ("The result size is the SCENE's size, not the placed image's — this is the opposite of overlay/beside/above, whose size grows with the pieces." "(x,y) is the CENTER of the placed image, not its top-left corner; draw-image is the top-left sink, place-image is the centered scene-composer." "Anything past the scene edge is clipped away and does not enlarge the frame." "The scene is not mutated — place-image returns a new scene; you must thread the returned value forward.")
  :drawbacks ("No rotation or scaling at placement time — transform the image first with rotate/scale, then place it." "One image per call; placing many objects means many calls (fold them over a coordinate list rather than nesting by hand)." "Off-scene placement is silently clipped, so a bug in your coordinates shows up as a missing object, not an error.")
  :usecases ("Assembling a game frame: ball, paddles, bricks, score, each at its own coordinate." "Positioning sprites at simulation-computed (x,y) positions each tick." "Compositing a label or icon at a fixed spot on a background card." "Building a starfield or particle scatter by folding coordinates into a scene.")
  :related ("empty-scene" "overlay" "draw-image" "draw-image/center" "image-width")
  :learn (:concept "Coordinate placement onto a fixed-size scene: center-at-(x,y), scene-preserving, immutable and threadable." :prerequisites ("empty-scene" "overlay") :progression "Learn empty-scene to make the frame, then place-image to populate it; fold place-image over object lists for whole scenes, and use draw-image to blit onto the live framebuffer instead.")
  :row-2-audit (
    (:problem "A game maker building the opening frame of a pong clone needs the ball in the middle and two paddles at the left and right edges of a fixed 200x120 court — the court size must not change no matter what gets placed on it."
     :program "(let* ((court (empty-scene 200 120 5))\n       (a (place-image (img/circle 5 'solid 15) 100 60 court))\n       (b (place-image (img/rectangle 6 24 'solid 15) 10 60 a)))\n  (place-image (img/rectangle 6 24 'solid 15) 190 60 b))"
     :eng-program "(define (frame w h objects)\n  ;; objects = list of (img x y); fold them onto one immutable court.\n  (fold (lambda (o s) (place-image (car o) (cadr o) (caddr o) s))\n        (empty-scene w h 5) objects))\n(image-width (frame 200 120 (list (list (img/circle 5 'solid 15) 100 60))))"
     :math-program "(define (size-preserved? w h img x y)\n  (let* ((scene (empty-scene w h))\n         (out (place-image img x y scene)))\n    (and (= (image-width out) w) (= (image-height out) h))))\n(display (size-preserved? 200 120 (img/circle 5 'solid 15) 100 60))"
     :cs-program "(define (place-checked img x y scene)\n  (if (and (number? x) (number? y) (image? img) (image? scene))\n      (place-image img x y scene)\n      (error 'place-image \"needs img, numeric x y, and a scene\")))\n(image? (place-checked (img/circle 5 'solid 15) 100 60 (empty-scene 200 120)))"
     :explanation "eng: fold a list of positioned objects onto one court so the frame is data-driven. math: state and check the size-preservation property. cs: guard the argument types before placing."
     :meta "overlay centers everything on one point — it cannot put the ball in the middle and a paddle at the edge. beside/above only do rows and columns, not free coordinates. draw-image places by top-left onto the live framebuffer and returns nothing, so you cannot keep composing. place-image is the one combinator that positions by center AND returns a same-size scene you can thread onward.")
    (:eng "The audit lens is 'the frame size is invariant' — the SRE smoke test after any placement is (= (image-width out) court-width); if the frame grew, an object escaped the scene contract." :math "place-image is scene ↦ scene, a same-size endomorphism on the fixed frame; composing placements stays in the frame." :cs "Immutable canvas update: each call copies the scene and paints one clipped sprite; threading placements is a fold over the scene."))
  :row-3-dimension (
    (:setup "Update a fixed-size container by writing one element at a chosen position, returning a new container of the same shape."
     :rungs (
       (:domain "image" :code "(image-width (place-image (img/circle 4 'solid 8) 10 10 (empty-scene 40 40)))")
       (:domain "vector-set" :code "(define v (make-vector 5 0))\n(vector-set! v 2 99)\n(vector-ref v 2)")
       (:domain "assoc-update" :code "(define (put alist k val) (cons (cons k val) alist))\n(cdr (assq 'x (put '() 'x 7)))"))
     :explanation "Rung 1: place-image writes an image at (x,y) on a same-size scene. Rung 2: vector-set! writes a value at an index in a fixed-length vector. Rung 3: an assoc update writes a value at a key in a map. All three share the shape 'put a value at an address in a container; the container's shape is preserved, only the addressed slot changes'."
     :meta "The transfer works because positioned assignment is addressing-into-a-container: a coordinate, an index, and a key are all just addresses, and writing at an address leaves the container's shape intact. place-image is the two-dimensional, immutable member of that family.")
    (:eng "Every addressed-write substrate shares the audit 'the container shape is unchanged; only the target slot differs' and the failure 'the write ran off the end'." :math "A partial function address → value composed with a same-shape container; the update is an endomorphism fixing all but one coordinate." :cs "Indexed write into a fixed container; the same shape as arr[i]=x, map.put(k,v), and framebuffer poke."))
  :row-4-proof (
    (:claim "place-image preserves the scene's dimensions: the result is exactly as wide and tall as the input scene, regardless of the placed image or coordinate."
     :program "(define scene (empty-scene 50 40))\n(define out (place-image (img/circle 30 'solid 8) 10 10 scene))\n(display (= (image-width out) (image-width scene))) (newline)\n(display (= (image-height out) (image-height scene)))"
     :eng-program "(define (frame-stable? w h placements)\n  (let ((out (fold (lambda (p s) (place-image (car p) (cadr p) (caddr p) s))\n                   (empty-scene w h) placements)))\n    (and (= (image-width out) w) (= (image-height out) h))))\n(display (frame-stable? 80 60 (list (list (img/circle 5 'solid 8) 10 10)\n                                    (list (img/square 40 'solid 12) 70 55))))"
     :math-program "(define (endomorphism-check w h)\n  (let* ((s (empty-scene w h))\n         (s1 (place-image (img/circle 100 'solid 8) 0 0 s)))\n    (list 'in (list w h) 'out (list (image-width s1) (image-height s1))\n          'same? (and (= (image-width s1) w) (= (image-height s1) h)))))\n(endomorphism-check 50 40)"
     :cs-program "(define (size-contract? scene img x y)\n  (let ((out (place-image img x y scene)))\n    (and (= (image-width out) (image-width scene))\n         (= (image-height out) (image-height scene)))))\n(display (size-contract? (empty-scene 64 48) (img/square 200 'solid 8) -10 -10))"
     :invariant "∀ scene img x y. image-width(place-image img x y scene) = image-width(scene) ∧ image-height(...) = image-height(scene)"
     :meta "The pattern is that place-image is an endomorphism on a fixed frame: input and output live in the same size class. Falsified if placing a huge image made the scene grow — which would break every downstream coordinate that assumed a fixed court, and would make place-image behave like overlay. This same-size guarantee is exactly what distinguishes a scene-composer from a piece-combinator.")
    (:eng "The engineering consequence is that a game loop can place any number of sprites without the court ever resizing, so screen coordinates stay valid frame to frame." :math "place-image ∈ End(Scene_{w×h}); the set of w×h scenes is closed under it." :cs "Size-preserving update; the same shape as any in-place array write that cannot resize the array."))
  :row-5-emergence (
    (:base "place-image drops one image at (x,y) on a same-size scene."
     :composition "(define (bricks scene cols)\n  (fold (lambda (i s) (place-image (img/rectangle 14 6 'solid (+ 8 (modulo i 8)))\n                                   (+ 12 (* i 16)) 10 s))\n        scene (iota cols)))\n(image-width (bricks (empty-scene 120 60) 6))"
     :eng-composition "(define (hud scene score-x lives-x)\n  (let* ((s1 (place-image (img/square 6 'solid 15) score-x 8 scene)))\n    (place-image (img/circle 4 'solid 12) lives-x 8 s1)))\n(image? (hud (empty-scene 120 20 3) 10 100))"
     :math-composition "(define (place-fold scene coords)\n  (fold (lambda (xy s) (place-image (img/circle 3 'solid 15) (car xy) (cadr xy) s))\n        scene coords))\n(image-width (place-fold (empty-scene 90 90) (list (list 10 10) (list 45 45) (list 80 80))))"
     :cs-composition "(define (render-entities scene entities)\n  ;; entities = list of (sprite x y); a scene is the immutable accumulator.\n  (fold (lambda (e s) (place-image (car e) (cadr e) (caddr e) s)) scene entities))\n(image-width (render-entities (empty-scene 100 100)\n                              (list (list (img/circle 5 'solid 12) 20 20)\n                                    (list (img/square 8 'solid 8) 70 70))))"
     :emergent "A rendered scene: many positioned objects folded onto one immutable frame. A row of bricks, a HUD, a starfield, a whole game screen — all are place-image folded over a list of (sprite, x, y). This is the retained-mode scene graph / render pass: a display list of positioned sprites collapsed into a frame, exactly how a game engine draws a level and how a compositor lays out windows."
     :meta "This is the scene-graph / render-list family — a display list of (sprite, position) entries reduced onto a canvas. It generalizes to tile maps, particle systems, and windowing compositors. It composes because Row 4 makes place-image a same-size endomorphism, so folding a hundred sprites never changes the frame — the accumulator type is stable, which is what makes the fold well-typed.")
    (:eng "The audit lens is 'the display list is data, the frame is the reduce' — an operator debugging a missing sprite checks the entity's (x,y) is inside the court, since off-scene placements clip silently." :math "The render is fold(place-image) over a display list; the scene is the accumulator in a monoidal reduction fixing the frame size." :cs "Retained-mode render pass; the shape of every engine that reduces a scene graph of positioned nodes into one framebuffer."))
)

(verb
  :name "empty-scene" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(empty-scene w h [color]) -> image"
  :summary "Make a blank w-by-h scene image, transparent by default or filled with an optional background color."
  :explanation "empty-scene is the blank canvas — the starting frame that place-image paints onto. You give it a width and height and get back an image of exactly that size, empty: transparent if you pass no color, or filled solid if you pass a palette index or color name as the third argument. It is the identity element of the scene-composition world: place nothing on it and you still have a valid, correctly-sized image. Every assembled picture begins here — you make an empty-scene of the court/card/HUD size, then thread it through place-image calls to populate it. Because its size is fixed at creation and preserved by every place-image (Row 4 of place-image), empty-scene is what fixes the coordinate system the whole scene will live in. Choose its dimensions to match the world you are drawing; choose its color to be the sky, the felt, or nothing at all."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (empty-scene 100 60))" :note "A blank 100x60 canvas reports width 100 — the scene's size is exactly what you asked for, with nothing drawn yet.")
    (:dialect "motoi" :tier "intermediate" :code "(define sky (empty-scene 120 80 6))\n(list (image-width sky) (image-height sky) (image? sky))" :note "A 120x80 scene filled with palette color 6 as a sky background; the optional third argument turns a transparent frame into a colored one.")
    (:dialect "motoi" :tier "expert" :code "(define (court w h) (empty-scene w h 5))\n(define scene (place-image (img/circle 5 'solid 15) 20 20 (court 80 50)))\n(image-height scene)" :note "Wrap empty-scene in a court constructor, then start placing objects — the scene's height survives placement because empty-scene fixed it and place-image preserves it.")
  )
  :caveats ("With no color argument the scene is TRANSPARENT, not white — placing it over another image lets the lower image show through the empty areas." "The size is fixed at creation; there is no resize. Pick w and h to match the world you intend to draw." "The color argument is a background FILL, not a border — there is no frame line around an empty-scene." "An empty-scene with zero width or height is degenerate; keep both positive.")
  :drawbacks ("No sub-region or margin support — it is a plain filled rectangle; complex backgrounds must be composed by placing images onto it." "Transparency vs. a colored fill is a binary choice at creation; you cannot add a background later without re-composing." "Very large scenes allocate proportional memory up front, so a giant empty-scene costs even before anything is drawn.")
  :usecases ("The starting canvas for any place-image composition (game court, card, HUD)." "A colored background rectangle (sky, felt, wall) to layer objects on." "A transparent frame of known size to overlay onto other images." "A spacer of exact dimensions inside beside/above layouts.")
  :related ("place-image" "overlay" "draw-image" "image-width" "image-height")
  :learn (:concept "The blank fixed-size canvas: transparent-or-filled, the identity/start of scene composition." :prerequisites ("image-width") :progression "Make an empty-scene first, then populate it with place-image; use overlay/beside/above when you want auto-layout instead of a fixed coordinate frame.")
  :row-2-audit (
    (:problem "A simulation author needs a fixed 160x120 world to drop moving particles into every frame. The world's size must be nailed down once so that particle (x,y) coordinates mean the same thing every tick, and the background should be a dark space color."
     :program "(define world (empty-scene 160 120 0))\n(list 'w (image-width world) 'h (image-height world))"
     :eng-program "(define (make-world w h bg) (empty-scene w h bg))\n(define world (make-world 160 120 0))\n(list 'ready? (image? world) 'w (image-width world) 'h (image-height world))"
     :math-program "(define (dims-exact? w h)\n  (let ((s (empty-scene w h)))\n    (and (= (image-width s) w) (= (image-height s) h))))\n(display (dims-exact? 160 120))"
     :cs-program "(define (safe-scene w h)\n  (if (and (integer? w) (integer? h) (> w 0) (> h 0))\n      (empty-scene w h 0)\n      (error 'empty-scene \"width and height must be positive integers\")))\n(image? (safe-scene 160 120))"
     :explanation "eng: a world constructor fixing size and background once. math: verify the returned dimensions exactly match the request. cs: guard against non-positive or non-integer dimensions."
     :meta "overlay/beside/above build their size from their pieces — they cannot give you a FIXED 160x120 frame to place particles into. img/rectangle would draw a filled box but is meant as a shape to compose, not as a coordinate frame for place-image. empty-scene is the one primitive whose whole job is 'a blank canvas of exactly this size', which is what a coordinate system needs.")
    (:eng "The audit lens is 'the frame size is a contract set once' — the SRE probe confirms every world created with the same (w,h) has identical dimensions, so saved coordinates stay valid across sessions." :math "empty-scene is the constant map (w,h) ↦ blank_{w×h}; it is the identity object of the place-image monoid on scenes." :cs "Fixed-size buffer allocation; the same shape as allocating a zeroed array of known length before filling it."))
  :row-3-dimension (
    (:setup "Allocate a fixed-size, empty container up front so later writes have a stable place to land."
     :rungs (
       (:domain "image" :code "(image-width (empty-scene 40 30))")
       (:domain "zeroed-vector" :code "(define v (make-vector 4 0))\n(vector-length v)")
       (:domain "empty-string" :code "(string-length (make-string 5 #\\space))"))
     :explanation "Rung 1: empty-scene allocates a blank image of an exact size. Rung 2: make-vector allocates a zeroed vector of an exact length. Rung 3: make-string allocates a blank string of an exact length. All three share the shape 'reserve a fixed-size empty container now; its extent is set at creation and later operations fill it without changing that extent'."
     :meta "The transfer works because allocation-of-a-blank is the identity/seed step of any fill-in composition: reserve the shape, then populate. The measure — pixels, elements, characters — is fixed by the allocation and preserved by the writes.")
    (:eng "Every allocate-blank substrate shares the audit 'the allocated size equals the requested size' and the failure 'the fill overran the reserved extent'." :math "The unit / identity of a fill monoid: an empty container that composes with any sequence of writes to yield the same-size filled container." :cs "Fixed-size allocation with a default fill; the same shape as calloc, make-array, and pre-sizing a buffer."))
  :row-4-proof (
    (:claim "empty-scene returns an image of exactly the requested width and height."
     :program "(define s (empty-scene 73 41))\n(display (= (image-width s) 73)) (newline)\n(display (= (image-height s) 41)) (newline)\n(display (image? s))"
     :eng-program "(define (dims-audit specs)\n  (map (lambda (wh)\n         (let ((s (empty-scene (car wh) (cadr wh))))\n           (list wh 'ok? (and (= (image-width s) (car wh)) (= (image-height s) (cadr wh))))))\n       specs))\n(dims-audit (list (list 10 10) (list 100 60) (list 320 240)))"
     :math-program "(define (identity-of-frame w h)\n  (let ((s (empty-scene w h)))\n    (list 'requested (list w h) 'got (list (image-width s) (image-height s)))))\n(identity-of-frame 320 240)"
     :cs-program "(define (contract-dims? w h)\n  (let ((s (empty-scene w h)))\n    (and (image? s) (= (image-width s) w) (= (image-height s) h))))\n(display (contract-dims? 128 96))"
     :invariant "∀ w h. image-width(empty-scene w h) = w ∧ image-height(empty-scene w h) = h"
     :meta "The pattern is that a constructor honors its size arguments exactly — the getter recovers the argument with no fudge. Falsified if an empty-scene came back a different size than requested, which would silently offset every place-image coordinate and break the coordinate contract. This exactness is what lets empty-scene serve as the fixed frame place-image preserves.")
    (:eng "The engineering consequence is that you can trust a world's coordinate system to be exactly the size you declared — no hidden margin shifts your sprite positions." :math "The pair (image-width, image-height) is the left inverse of empty-scene: (image-width, image-height) ∘ empty-scene = identity on (w,h)." :cs "Constructor round-trip on dimensions; the same shape as len(make-list n) = n."))
  :row-5-emergence (
    (:base "empty-scene alone makes a blank fixed-size frame."
     :composition "(define (starfield w h stars)\n  (fold (lambda (i s)\n          (place-image (img/circle 1 'solid 15) (* i 11) (* i 7) s))\n        (empty-scene w h 0) (iota stars)))\n(image-width (starfield 100 70 6))"
     :eng-composition "(define (game-screen)\n  (let* ((court (empty-scene 200 120 5))\n         (with-ball (place-image (img/circle 5 'solid 15) 100 60 court)))\n    (place-image (img/rectangle 6 24 'solid 15) 10 60 with-ball)))\n(image? (game-screen))"
     :math-composition "(define (frame-then-fill w h)\n  ;; empty-scene is the seed; place-image folds onto it, size fixed throughout.\n  (let ((filled (place-image (img/square 8 'solid 8) 20 20 (empty-scene w h))))\n    (list 'seed-w w 'filled-w (image-width filled) 'preserved? (= w (image-width filled)))))\n(frame-then-fill 64 64)"
     :cs-composition "(define (compose-scene w h display-list)\n  (fold (lambda (item s) (place-image (car item) (cadr item) (caddr item) s))\n        (empty-scene w h 3) display-list))\n(image-width (compose-scene 90 90 (list (list (img/circle 4 'solid 12) 20 20)\n                                        (list (img/square 6 'solid 8) 60 60))))"
     :emergent "A whole scene, seeded from blank: empty-scene supplies the frame, place-image folds a display list onto it — a starfield, a game screen, a card. empty-scene is the neutral seed of the render pass, the blank sheet a compositor starts every frame from. Together with place-image it is the full immediate-canvas rendering model."
     :meta "This is the seed-and-fold / render-pass family — a neutral empty accumulator plus a reduction that populates it. empty-scene is the monoid identity; place-image is the operation; a display list is the input. It composes because Row 4 fixes empty-scene's size exactly and place-image preserves it, so the accumulator's type (a w×h scene) is invariant through the whole fold.")
    (:eng "The audit lens is 'every frame starts from the same blank' — an operator clearing the screen each tick re-seeds with empty-scene, guaranteeing no ghost of the last frame remains." :math "empty-scene is the identity e such that place-image(nothing, e) = e; the render is e reduced under place-image over the display list." :cs "Clear-then-draw / double-buffer seed; the shape of every render loop that starts each frame from a cleared buffer."))
)

(verb
  :name "rotate" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(rotate deg img) -> image"
  :summary "Turn an image counter-clockwise by deg degrees; the bounding box grows to contain the turned picture."
  :explanation "rotate spins an image counter-clockwise about its center by a given angle in degrees, returning a new image. Because a rotated rectangle no longer fits in its original box, the result's bounding box GROWS to enclose the turned shape — a 30-wide, 10-tall bar rotated 90 degrees comes back 10 wide and 30 tall. rotate is your first affine transform: it moves every pixel to a new coordinate given by a rotation matrix acting on its offset from the center. Reach for it to tilt a shape, spin a sprite, angle a roof, or make a clock hand point somewhere. Angles of 0, 90, 180, 270 keep the box axis-aligned; other angles produce a bigger box with the shape sitting diagonally inside it. Compose rotate with itself, with scale, and with the layout verbs to build tilted and turning figures."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image? (rotate 45 (img/square 20 'solid 8)))" :note "A square turned 45 degrees comes back as a diamond image — still one image, but its bounding box now encloses the tilted corners.")
    (:dialect "motoi" :tier "intermediate" :code "(define bar (img/rectangle 30 10 'solid 12))\n(list 'before (image-width bar) 'after (image-width (rotate 90 bar)))" :note "A 30-wide bar rotated a quarter turn reports width 10 afterward — a 90-degree rotation swaps width and height because the box follows the shape.")
    (:dialect "motoi" :tier "expert" :code "(define (spokes n)\n  (apply overlay (map (lambda (i) (rotate (* i (/ 360 n)) (img/rectangle 2 24 'solid 15))) (iota n))))\n(image? (spokes 6))" :note "Overlay six copies of a thin bar, each rotated by an even fraction of a full turn, to build a spoked wheel or asterisk — rotate plus overlay makes radial symmetry.")
  )
  :caveats ("Rotation is COUNTER-clockwise for positive degrees, the mathematical convention — a positive angle turns left, not right." "The bounding box grows for non-right angles, so a rotated image is bigger than the original and centering it in a layout accounts for the new size." "Angles are degrees, not radians — pass 90, not (/ pi 2)." "Repeated small rotations resample the image each time and can blur or drift; prefer one rotation by the total angle over many tiny ones.")
  :drawbacks ("Non-right-angle rotations require resampling, which softens edges and is lossier than a 90-degree swap." "The growing box means a rotated sprite occupies more space than its art, complicating tight-packed layouts." "No pivot control — rotation is always about the image's own center; to rotate about another point, place the image off-center on a scene first, then rotate the scene.")
  :usecases ("Tilting shapes: angled roofs, leaning signs, italic-looking figures." "Spinning sprites in a game or animation frame by frame." "Building radial symmetry (spokes, stars, mandalas) with overlay." "Pointing hands, arrows, and needles at a computed angle.")
  :related ("scale" "scale/xy" "flip-horizontal" "overlay" "image-width")
  :learn (:concept "Counter-clockwise affine rotation about the center with a growing bounding box; degrees, matrix-driven." :prerequisites ("img/rectangle" "overlay") :progression "Learn rotate as the first affine transform, then scale and scale/xy; combine rotate with overlay for radial symmetry and with above/beside for tilted layouts.")
  :row-2-audit (
    (:problem "A kid drawing a clock wants the hour hand to point to 3 o'clock — a thin vertical bar that should lie flat pointing right instead of standing up. They need to turn the bar a quarter turn without redrawing it at a new angle by hand."
     :program "(rotate -90 (img/rectangle 3 30 'solid 0))"
     :eng-program "(define (clock-hand length angle-deg)\n  (rotate angle-deg (img/rectangle 3 length 'solid 0)))\n(image? (clock-hand 30 -90))"
     :math-program "(define (box-after-90 w h)\n  ;; a 90-degree turn swaps width and height.\n  (list 'expect (list h w)))\n(let ((hand (img/rectangle 3 30 'solid 0)))\n  (list 'before (list (image-width hand) (image-height hand))\n        'after (let ((r (rotate 90 hand))) (list (image-width r) (image-height r)))))"
     :cs-program "(define (rotate-checked deg img)\n  (if (and (number? deg) (image? img)) (rotate deg img)\n      (error 'rotate \"needs a numeric angle and an image\")))\n(image? (rotate-checked -90 (img/rectangle 3 30 'solid 0)))"
     :explanation "eng: a clock-hand function that takes length and angle. math: state that a 90-degree turn swaps width and height and check it. cs: guard the angle and image types."
     :meta "flip-horizontal or flip-vertical only mirror — they cannot point a vertical bar sideways, since a mirror of a vertical bar is still vertical. scale changes size, not orientation. rotate is the only combinator that changes an image's ANGLE; picking a flip or a scale would leave the hand pointing the wrong way.")
    (:eng "The audit lens is 'a quarter turn swaps width and height' — the operator smoke test after a rotation change is that a tall bar becomes a wide one; if the box did not swap, rotation regressed to a no-op." :math "rotate applies the 2x2 rotation matrix R(θ) to each pixel's offset from center; the bounding box is the axis-aligned hull of the rotated corners." :cs "Affine resample: each output pixel samples the source at the inverse-rotated coordinate; cost is O(box area)."))
  :row-3-dimension (
    (:setup "Apply a rotation to a shape so every point moves to the image of a rotation matrix acting on its coordinates."
     :rungs (
       (:domain "image" :code "(image? (rotate 90 (img/rectangle 30 10 'solid 8)))")
       (:domain "point-rotation" :code "(define (rot90 x y) (list (- y) x))\n(rot90 3 0)")
       (:domain "complex-multiply" :code "(define (mul-i re im) (list (- im) re))\n(mul-i 1 0)"))
     :explanation "Rung 1: rotating an image by 90 degrees swaps its width and height because every pixel moves under a quarter-turn. Rung 2: rotating the point (x,y) by 90 degrees sends it to (-y, x). Rung 3: multiplying the complex number x+iy by i gives -y+ix — the same coordinate swap. All three share the shape 'a rotation is a linear map that permutes and negates coordinates by the angle'."
     :meta "The transfer works because rotation IS multiplication by a rotation matrix (equivalently, by a unit complex number). Whether the object is an image, a point, or a complex number, the same R(θ) acts; a 90-degree turn is exactly multiplication by i.")
    (:eng "Every rotation substrate shares the audit 'a 90-degree turn is the (x,y)→(-y,x) swap' and the failure 'the handedness came out reversed (clockwise vs counter-clockwise)'." :math "Rotation is the action of SO(2): R(θ) = [[cosθ,−sinθ],[sinθ,cosθ]], an orthogonal matrix with determinant 1." :cs "Coordinate transform by an orthonormal matrix; the same shape as rotating a vector, a sprite, or a complex phasor."))
  :row-4-proof (
    (:claim "Rotation by 0 degrees is the identity: it returns an image of the same dimensions as the input."
     :program "(define i (img/rectangle 30 10 'solid 8))\n(display (= (image-width (rotate 0 i)) (image-width i))) (newline)\n(display (= (image-height (rotate 0 i)) (image-height i)))"
     :eng-program "(define (identity-audit imgs)\n  (map (lambda (i) (and (= (image-width (rotate 0 i)) (image-width i))\n                        (= (image-height (rotate 0 i)) (image-height i))))\n       imgs))\n(identity-audit (list (img/square 12 'solid 8) (img/rectangle 20 6 'solid 12)))"
     :math-program "(define i (img/square 16 'solid 8))\n(list 'R0-is-identity\n      (and (= (image-width (rotate 0 i)) (image-width i))\n           (= (image-height (rotate 0 i)) (image-height i))))"
     :cs-program "(define (fixed-point? deg img)\n  (and (= (image-width (rotate deg img)) (image-width img))\n       (= (image-height (rotate deg img)) (image-height img))))\n(display (fixed-point? 0 (img/rectangle 30 10 'solid 8)))"
     :invariant "∀ img. rotate(0, img) ≅ img  (a zero-degree rotation preserves dimensions; R(0) = I, the identity matrix)"
     :meta "The pattern is that the transform has an identity element: the zero angle does nothing. Falsified if rotate 0 changed an image's dimensions, which would mean R(0) is not the identity matrix — breaking the group structure of rotations and every animation that interpolates from angle 0. That rotate 0 is identity is what makes rotation a group action rather than an arbitrary remap.")
    (:eng "The engineering consequence is that an animation sweeping the angle from 0 upward starts from an untouched image — frame zero is the original, so no jump on the first tick." :math "R(0) = I is the identity of SO(2); rotate(0) is the identity endomorphism on images up to the box convention." :cs "Identity element of a transform group; the same shape as scale(1) and translate(0) being no-ops."))
  :row-5-emergence (
    (:base "rotate alone turns one image about its center."
     :composition "(apply overlay\n  (map (lambda (i) (rotate (* i 45) (img/rectangle 2 30 'solid 15)))\n       (iota 4)))"
     :eng-composition "(define (mandala petals petal)\n  (apply overlay\n    (map (lambda (i) (rotate (* i (/ 360 petals)) petal)) (iota petals))))\n(image? (mandala 8 (img/rectangle 3 28 'outline 12)))"
     :math-composition "(define (orbit n)\n  ;; n rotated copies at equal angles 360/n apart tile the full turn.\n  (apply overlay (map (lambda (i) (rotate (* i (/ 360 n)) (img/circle 4 'solid 12))) (iota n))))\n(image? (orbit 6))"
     :cs-composition "(define (radial base n)\n  (fold (lambda (i acc) (overlay (rotate (* i (/ 360 n)) base) acc))\n        (img/circle 1 'solid 0) (iota n)))\n(image? (radial (img/rectangle 2 26 'solid 15) 12))"
     :emergent "A mandala: many copies of one motif overlaid, each rotated by an equal share of a full turn. Six spokes make a wheel, eight petals a flower, twelve a clock face. This is rotational symmetry — the cyclic group C_n realized as a picture, the same construction as a kaleidoscope, a snowflake, or a gear."
     :meta "This is the symmetry-group family — a motif acted on by every element of the cyclic group C_n and superimposed. It generalizes to snowflakes (C_6), asterisks, and gears. It composes because rotate is a group action (Row 4: R(0)=I is the identity), so applying the n equally-spaced rotations and overlaying them realizes the whole cyclic orbit of the motif.")
    (:eng "The audit lens is 'equal angular spacing or the mandala wobbles' — the operator checks the angles are exactly i·360/n, since uneven steps break the symmetry the eye is looking for." :math "The overlaid copies are the orbit of the motif under C_n = {R(2πk/n)}; the result has n-fold rotational symmetry." :cs "Group-orbit rendering; the shape of every kaleidoscope, radial menu, and procedurally-symmetric ornament."))
)

(verb
  :name "scale" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(scale factor img) -> image"
  :summary "Resize an image uniformly by a factor; width and height both multiply by the same number."
  :explanation "scale resizes an image by a single factor applied equally to width and height, returning a new image with the same proportions, just bigger or smaller. A factor of 2 doubles both dimensions (quadrupling the area); a factor of 0.5 halves them; a factor of 1 leaves it untouched. It is the uniform member of the affine-scaling family — scale/xy is the version that stretches the axes independently. Reach for scale to zoom a sprite, grow a shape to a target size, or make a family of same-shaped icons at different sizes. Because it multiplies both dimensions by the same number, scale preserves aspect ratio: circles stay circular, squares stay square. It is a diagonal matrix with equal entries acting on every pixel's coordinate — the mathematical dilation about the center."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (scale 2 (img/square 10 'solid 8)))" :note "Scaling a 10-wide square by 2 gives width 20 — the factor multiplies the dimension directly.")
    (:dialect "motoi" :tier "intermediate" :code "(define icon (img/circle 8 'solid 12))\n(list 'small (image-width (scale 0.5 icon)) 'big (image-width (scale 2 icon)))" :note "One circle at half and double size; scale makes a whole size family from a single source image while keeping it circular.")
    (:dialect "motoi" :tier "expert" :code "(define (zoom-ladder img factors)\n  (map (lambda (f) (image-width (scale f img))) factors))\n(zoom-ladder (img/square 10 'solid 8) (list 1 2 3 4))" :note "Map a list of factors over one image to read off the width at each zoom level — scaling is multiplicative, so the widths come out 10, 20, 30, 40.")
  )
  :caveats ("scale multiplies both axes by the SAME factor, so it never changes aspect ratio — use scale/xy when you need to stretch one axis only." "Non-integer factors resample the image and can blur; enlarging past the source resolution invents no new detail, it just spreads pixels." "A factor of 0 collapses the image to nothing; negative factors are not a scale but a flip-and-scale — use flip verbs for mirroring." "Area grows as the SQUARE of the factor, so scale 3 is nine times the pixels, not three — memory and fill cost rise fast.")
  :drawbacks ("Uniform only; anisotropic resizing (wider but not taller) needs scale/xy." "Upscaling is lossy — a small source scaled up is soft, since there is no extra detail to recover." "Repeated scaling compounds resampling error; scale once by the total factor rather than in steps.")
  :usecases ("Zooming a sprite or icon to a target display size." "Generating an icon set at several sizes from one master image." "Growing or shrinking a shape to fit a layout slot." "Uniform dilation in a construction where proportions must be preserved.")
  :related ("scale/xy" "rotate" "flip-horizontal" "image-width" "image-height")
  :learn (:concept "Uniform affine dilation about the center: one factor on both axes, aspect-ratio-preserving." :prerequisites ("img/square" "image-width") :progression "Learn scale for proportional resizing, then scale/xy for independent axes; combine with rotate for scaled-and-turned sprites.")
  :row-2-audit (
    (:problem "A game maker has one master coin sprite but needs it at three sizes for the HUD, the pickup, and the big win animation. Redrawing the coin three times risks three slightly different coins; they want one source resized to each target."
     :program "(let ((coin (img/circle 8 'solid 11)))\n  (list (scale 0.5 coin) (scale 1 coin) (scale 2 coin)))"
     :eng-program "(define (sprite-sizes master factors)\n  (map (lambda (f) (scale f master)) factors))\n(map image-width (sprite-sizes (img/circle 8 'solid 11) (list 0.5 1 2)))"
     :math-program "(define (scaled-width w f) (* w f))\n(let ((coin (img/circle 8 'solid 11)))\n  (list 'formula (scaled-width (image-width coin) 2)\n        'actual (image-width (scale 2 coin))))"
     :cs-program "(define (scale-checked f img)\n  (if (and (number? f) (> f 0) (image? img)) (scale f img)\n      (error 'scale \"factor must be a positive number\")))\n(image-width (scale-checked 2 (img/circle 8 'solid 11)))"
     :explanation "eng: a size-family generator from one master sprite. math: the closed-form scaled width = width × factor, checked. cs: guard against non-positive factors that would collapse or flip the sprite."
     :meta "scale/xy could do it but forces you to pass the same factor twice for both axes — noisy and error-prone when you always want them equal. rotate changes angle, not size. Redrawing by hand risks inconsistency. scale is the one verb that says 'the same picture, uniformly bigger', which is exactly a size family from one master.")
    (:eng "The audit lens is 'the aspect ratio is unchanged' — the operator smoke test is that width/height before equals width/height after; if the ratio drifted, scale silently behaved like scale/xy." :math "scale is the diagonal matrix diag(f,f) acting on centered coordinates; it is a homothety (dilation) with ratio f." :cs "Uniform resample: each output pixel samples the source at 1/f times its centered offset; area cost scales as f²."))
  :row-3-dimension (
    (:setup "Multiply a measured object by a single factor so every dimension grows in the same proportion."
     :rungs (
       (:domain "image" :code "(image-width (scale 3 (img/square 10 'solid 8)))")
       (:domain "recipe-scale" :code "(define (scale-recipe cups servings-factor) (* cups servings-factor))\n(scale-recipe 2 3)")
       (:domain "similar-triangles" :code "(define (scale-side side ratio) (* side ratio))\n(scale-side 5 2)"))
     :explanation "Rung 1: scaling an image by 3 multiplies its width by 3. Rung 2: scaling a recipe for triple the servings multiplies each ingredient by 3. Rung 3: a triangle scaled by ratio 2 has every side twice as long. All three share the shape 'multiply every measure by one common factor; proportions are preserved because the factor is shared'."
     :meta "The transfer works because uniform scaling is scalar multiplication distributed over all dimensions: one factor times each measure. Whether the measures are pixels, cups, or side-lengths, sharing the factor is exactly what preserves shape/ratio.")
    (:eng "Every uniform-scaling substrate shares the audit 'ratios are invariant under the common factor' and the failure 'one dimension got a different factor and the shape distorted'." :math "A homothety / similarity transform: multiplication by a scalar that preserves angles and ratios, scaling all lengths by |f| and areas by f²." :cs "Scalar broadcast over a tuple of measures; the same shape as multiplying every component of a vector by one number."))
  :row-4-proof (
    (:claim "Scaling by 1 is the identity: it returns an image with the same width and height as the input."
     :program "(define i (img/rectangle 24 10 'solid 8))\n(display (= (image-width (scale 1 i)) (image-width i))) (newline)\n(display (= (image-height (scale 1 i)) (image-height i)))"
     :eng-program "(define (identity-audit imgs)\n  (map (lambda (i) (and (= (image-width (scale 1 i)) (image-width i))\n                        (= (image-height (scale 1 i)) (image-height i))))\n       imgs))\n(identity-audit (list (img/square 12 'solid 8) (img/rectangle 20 6 'solid 12)))"
     :math-program "(define (doubling-doubles? i)\n  ;; scale 2 must double width: diag(2,2) multiplies each length by 2.\n  (= (image-width (scale 2 i)) (* 2 (image-width i))))\n(display (doubling-doubles? (img/square 10 'solid 8)))"
     :cs-program "(define (unit-factor-noop? img)\n  (and (= (image-width (scale 1 img)) (image-width img))\n       (= (image-height (scale 1 img)) (image-height img))))\n(display (unit-factor-noop? (img/rectangle 24 10 'solid 8)))"
     :invariant "∀ img. scale(1, img) ≅ img  ∧  ∀ img f. image-width(scale(f,img)) = f·image-width(img)"
     :meta "The pattern is a multiplicative identity plus linearity: factor 1 does nothing, and width scales linearly in the factor. Falsified if scale 1 changed a dimension, meaning diag(1,1) is not the identity — which would break every zoom that interpolates a factor toward 1. That scale is linear in the factor with unit identity is what makes zoom animations smooth.")
    (:eng "The engineering consequence is that a zoom animation crossing factor 1 shows the original image untouched at that frame, and each dimension is exactly factor times the source so layout math is predictable." :math "scale(f) = diag(f,f); scale(1) = I, and width/height are linear in f, so scale(a)∘scale(b) = scale(a·b)." :cs "Multiplicative-identity + linearity; the same shape as multiplying by 1 being a no-op and multiplication distributing over dimensions."))
  :row-5-emergence (
    (:base "scale alone resizes one image proportionally."
     :composition "(above (scale 1 (img/circle 6 'solid 12))\n       (scale 2 (img/circle 6 'solid 12))\n       (scale 3 (img/circle 6 'solid 12)))"
     :eng-composition "(define (size-ramp img factors)\n  (apply beside (map (lambda (f) (scale f img)) factors)))\n(image-width (size-ramp (img/square 6 'solid 8) (list 1 2 3)))"
     :math-composition "(define (geometric-nest img base levels)\n  ;; scale by base^k for k=0..levels-1 ⇒ a self-similar size series.\n  (apply overlay (map (lambda (k) (scale (expt base k) img)) (iota levels))))\n(image? (geometric-nest (img/square 4 'outline 8) 2 4))"
     :cs-composition "(define (icon-set master)\n  (map (lambda (f) (list 'size (* f (image-width master)) 'img (scale f master)))\n       (list 1 2 4)))\n(map (lambda (e) (cadr e)) (icon-set (img/circle 6 'solid 12)))"
     :emergent "A self-similar size series: one motif reproduced at a geometric progression of scales. Overlaid, growing outline squares make a set of nested frames that recede like a hallway of doorways; stacked, they make a perspective ramp. This is scale-invariance made visible — the seed of fractals, level-of-detail sprite sets, and the recursive zoom of a Droste image."
     :meta "This is the self-similarity / scaling-series family — one shape at a geometric ladder of sizes. It generalizes to fractals (repeat at scale r forever), mipmaps (powers-of-two sprite sizes), and perspective ramps. It composes because scale is multiplicative with unit identity (Row 4: scale(a)∘scale(b)=scale(ab)), so a base-to-the-k ladder is exactly a chain of scalings.")
    (:eng "The audit lens is 'the ratio between successive sizes is constant' — an operator building a mipmap ladder checks each level is exactly the base factor times the last, so level-of-detail switches are seamless." :math "The series {scale(r^k) · motif} is the orbit of the motif under the dilation group; constant ratio r means geometric self-similarity." :cs "Geometric size ladder; the shape of every mipmap chain, LOD system, and fractal generator's scale step."))
)

(verb
  :name "scale/xy" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(scale/xy sx sy img) -> image"
  :summary "Resize an image by independent horizontal (sx) and vertical (sy) factors; stretches or squashes."
  :explanation "scale/xy is the anisotropic scale — the version of scale that takes two factors, one for width and one for height, so it can stretch or squash an image out of its original proportions. sx multiplies the width, sy multiplies the height. Pass equal factors and you have plain scale; pass unequal ones and a circle becomes an oval, a square becomes a rectangle. It is the general diagonal-matrix transform, diag(sx, sy) acting on every centered coordinate. Reach for scale/xy to make a shape fit a non-square slot, to flatten a sprite into a shadow, to stretch a bar into a wide banner, or to squash a bounce in an animation. It is where the affine algebra earns its 'affine': independent per-axis scaling is the building block that, with rotation, spans all shape-preserving-up-to-shear deformations."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(list (image-width (scale/xy 2 3 (img/square 10 'solid 8)))\n      (image-height (scale/xy 2 3 (img/square 10 'solid 8))))" :note "A 10x10 square scaled by (2,3) becomes 20 wide and 30 tall — the two factors act on the two axes independently.")
    (:dialect "motoi" :tier "intermediate" :code "(define ball (img/circle 8 'solid 12))\n(image? (scale/xy 1 0.4 ball))" :note "A circle squashed to 40% of its height becomes a flat oval — a shadow or a squash-and-stretch bounce frame from one round sprite.")
    (:dialect "motoi" :tier "expert" :code "(define (banner img target-w)\n  (scale/xy (/ target-w (image-width img)) 1 img))\n(image-width (banner (img/square 10 'solid 8) 80))" :note "Stretch an image to an exact target width while leaving its height alone — dividing the target width by the source width gives the sx factor, so the result is exactly 80 wide.")
  )
  :caveats ("Unequal factors DISTORT — circles become ovals and squares become rectangles; that is the point, but it is a bug if you wanted uniform scaling (use scale)." "Each axis resamples independently, so extreme stretch factors exaggerate blur along the stretched axis." "sx acts on width, sy on height — swapping them stretches the wrong way; keep the argument order straight." "Zero on either axis collapses that dimension to nothing; negative factors mirror-and-scale rather than scale.")
  :drawbacks ("More distortion control means more ways to accidentally warp a sprite; when you want proportions kept, scale is the safer choice." "Independent resampling can produce different sharpness along the two axes, which looks uneven at large factor gaps." "No shear — scale/xy stretches along the axes only; slanting needs a rotate-scale-rotate composition.")
  :usecases ("Fitting an image to a non-square slot by stretching one axis." "Squash-and-stretch animation frames (flatten on impact, stretch in flight)." "Making shadows by squashing a sprite vertically." "Turning a square into a banner or a circle into an ellipse.")
  :related ("scale" "rotate" "flip-vertical" "image-width" "image-height")
  :learn (:concept "Anisotropic affine scaling: independent per-axis factors, the general diagonal-matrix deformation." :prerequisites ("scale") :progression "Learn scale/xy after scale as the two-factor generalization; combine it with rotate to reach the full family of affine shape transforms short of shear.")
  :row-2-audit (
    (:problem "An animator making a bouncing ball wants the squash frame: at the moment of impact the round ball should flatten wide and short, then spring back. They need to squash one sprite along the vertical axis only, keeping its width, so the flatten reads as elastic contact."
     :program "(scale/xy 1.3 0.6 (img/circle 10 'solid 12))"
     :eng-program "(define (squash ball flatten)\n  ;; flatten in [0,1]: 0 = round, 1 = pancake. Conserve area roughly.\n  (scale/xy (+ 1 flatten) (- 1 (* 0.7 flatten)) ball))\n(image? (squash (img/circle 10 'solid 12) 0.5))"
     :math-program "(define (dims-after sx sy w h) (list (* sx w) (* sy h)))\n(let ((ball (img/circle 10 'solid 12)))\n  (list 'formula (dims-after 1.3 0.6 (image-width ball) (image-height ball))\n        'actual (let ((s (scale/xy 1.3 0.6 ball))) (list (image-width s) (image-height s)))))"
     :cs-program "(define (scale-xy-checked sx sy img)\n  (if (and (number? sx) (number? sy) (> sx 0) (> sy 0) (image? img))\n      (scale/xy sx sy img)\n      (error 'scale/xy \"both factors must be positive numbers\")))\n(image? (scale-xy-checked 1.3 0.6 (img/circle 10 'solid 12)))"
     :explanation "eng: a squash function driven by one flatten parameter that conserves rough area. math: state and check the per-axis dimension formula. cs: guard both factors positive."
     :meta "scale multiplies both axes equally — it cannot flatten only the height, so a scale-squashed ball just gets smaller, not squished. rotate changes angle, not proportion. flip-vertical mirrors, it does not compress. scale/xy is the only verb that resizes the two axes independently, which is exactly what a squash-and-stretch frame needs.")
    (:eng "The audit lens is 'width and height changed by DIFFERENT factors' — the operator smoke test is that the aspect ratio deliberately changed; if both axes moved by the same amount, scale/xy collapsed to a plain scale." :math "scale/xy is diag(sx,sy) on centered coordinates; area scales by sx·sy and the aspect ratio multiplies by sx/sy." :cs "Two-axis resample: horizontal and vertical resampling passes with independent factors; cost O(sx·sy·source area)."))
  :row-3-dimension (
    (:setup "Apply a separate multiplier to each dimension of an object so the axes change independently."
     :rungs (
       (:domain "image" :code "(image-height (scale/xy 2 3 (img/square 10 'solid 8)))")
       (:domain "unit-conversion" :code "(define (convert x-factor y-factor x y) (list (* x-factor x) (* y-factor y)))\n(convert 2 3 10 10)")
       (:domain "diagonal-matrix" :code "(define (diag-apply sx sy x y) (list (* sx x) (* sy y)))\n(diag-apply 2 3 5 5)"))
     :explanation "Rung 1: scale/xy multiplies an image's width by sx and height by sy independently. Rung 2: converting a coordinate with separate x and y factors multiplies each axis by its own rate. Rung 3: a diagonal matrix diag(sx,sy) applied to (x,y) gives (sx·x, sy·y). All three share the shape 'each axis gets its own scalar; the transform is a diagonal matrix'."
     :meta "The transfer works because per-axis scaling IS a diagonal linear map: the matrix has the factors on its diagonal and zeros off it, so each coordinate is scaled by exactly its own factor with no cross-talk between axes.")
    (:eng "Every per-axis-scaling substrate shares the audit 'each axis moved by its own factor with no cross-coupling' and the failure 'the axes leaked into each other (that would be a shear, not a scale)'." :math "A diagonal linear transform diag(sx,sy); eigenvectors are the axes, eigenvalues the factors, determinant sx·sy." :cs "Component-wise vector scaling; the same shape as multiplying a 2-vector by a diagonal matrix or a per-channel gain."))
  :row-4-proof (
    (:claim "scale/xy multiplies width by sx and height by sy independently; the area therefore scales by sx·sy."
     :program "(define i (img/square 10 'solid 8))\n(define s (scale/xy 2 3 i))\n(display (= (image-width s) (* 2 (image-width i)))) (newline)\n(display (= (image-height s) (* 3 (image-height i)))) (newline)\n(display (= (* (image-width s) (image-height s)) (* 2 3 (image-width i) (image-height i))))"
     :eng-program "(define (area-audit i sx sy)\n  (let ((s (scale/xy sx sy i)))\n    (list 'area-in (* (image-width i) (image-height i))\n          'area-out (* (image-width s) (image-height s))\n          'ratio-matches? (= (* (image-width s) (image-height s))\n                             (* sx sy (image-width i) (image-height i))))))\n(area-audit (img/square 10 'solid 8) 2 3)"
     :math-program "(define (det-is-area-ratio? i sx sy)\n  (let ((s (scale/xy sx sy i)))\n    (= (/ (* (image-width s) (image-height s)) (* (image-width i) (image-height i)))\n       (* sx sy))))\n(display (det-is-area-ratio? (img/square 10 'solid 8) 2 3))"
     :cs-program "(define (per-axis? i sx sy)\n  (let ((s (scale/xy sx sy i)))\n    (and (= (image-width s) (* sx (image-width i)))\n         (= (image-height s) (* sy (image-height i))))))\n(display (per-axis? (img/square 10 'solid 8) 2 3))"
     :invariant "∀ img sx sy. image-width(scale/xy sx sy img) = sx·image-width(img) ∧ image-height(...) = sy·image-height(img) ⇒ area scales by sx·sy"
     :meta "The pattern is that the two axes are independent and the area is their product — exactly the determinant of diag(sx,sy). Falsified if the area ratio differed from sx·sy, which would mean the two axes are coupled (a shear crept in) and scale/xy is not a pure diagonal transform. That area = sx·sy·original is the geometric meaning of the determinant.")
    (:eng "The engineering consequence is that an animator can budget the fill cost of a stretch (area = sx·sy times the source) and can fit an image to a slot by choosing sx and sy independently." :math "det(diag(sx,sy)) = sx·sy is the area-scaling factor; width and height are the two independent eigenvalue-scaled extents." :cs "Determinant = product-of-axis-factors; the same shape as a diagonal matrix's determinant being the product of its diagonal."))
  :row-5-emergence (
    (:base "scale/xy alone stretches one image per-axis."
     :composition "(above (img/circle 10 'solid 12)\n       (scale/xy 1.4 0.35 (img/circle 10 'solid 0)))"
     :eng-composition "(define (with-shadow sprite)\n  ;; a squashed dark copy under the sprite reads as a ground shadow.\n  (above sprite (scale/xy 1.4 0.35 (img/circle (quotient (image-width sprite) 2) 'solid 0))))\n(image? (with-shadow (img/circle 10 'solid 12)))"
     :math-composition "(define (bounce-frames ball ks)\n  ;; each k gives a (squash-x, squash-y) area-preserving-ish frame.\n  (map (lambda (k) (scale/xy (+ 1 (* 0.3 k)) (- 1 (* 0.2 k)) ball)) ks))\n(map image-width (bounce-frames (img/circle 10 'solid 12) (list 0 1 2)))"
     :cs-composition "(define (squash-stretch-cycle ball)\n  (apply beside\n    (map (lambda (fr) (scale/xy (car fr) (cadr fr) ball))\n         (list (list 1 1) (list 1.4 0.6) (list 0.8 1.3) (list 1 1)))))\n(image-width (squash-stretch-cycle (img/circle 8 'solid 12)))"
     :emergent "A squash-and-stretch animation: a sprite plus its flattened shadow, or a cycle of per-axis-distorted frames that read as an elastic bounce. This is the classic animation principle made from geometry — the same anisotropic deformation that gives a bouncing ball weight, a shadow its ground contact, and a cartoon its life."
     :meta "This is the anisotropic-deformation family — per-axis scaling used to convey elasticity, weight, and grounding. It generalizes to shadows (flatten vertically), impact frames (widen and flatten), and anticipation (stretch tall). It composes with above/beside because scale/xy is a clean diagonal transform (Row 4), so each frame's dimensions are exactly predictable when laid out in a strip.")
    (:eng "The audit lens is 'squash and stretch should roughly conserve volume' — an operator tuning a bounce checks that widening frames also flatten, so the ball keeps its apparent mass." :math "Each frame is diag(sx,sy)·ball; a volume-conserving cycle keeps sx·sy near 1 across frames." :cs "Keyframed anisotropic transform sequence; the shape of every squash-and-stretch rig and every non-uniform sprite deform."))
)

(verb
  :name "flip-horizontal" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(flip-horizontal img) -> image"
  :summary "Mirror an image left-to-right about its vertical center line; dimensions are unchanged."
  :explanation "flip-horizontal mirrors an image across its vertical axis, swapping left and right while keeping top and bottom fixed. A shape looking right comes back looking left; text would read backwards. The dimensions do not change — a mirror is a reflection, not a resize — so width and height are exactly the same before and after. It is a reflection, the one member of the transform family with determinant −1: it reverses handedness. Reach for flip-horizontal to face a sprite the other way (the single most common use in games — one walk cycle, mirrored for both directions), to build bilateral symmetry by mirroring a half, or to create a reflection in water or a mirror. Applying it twice returns the original: flip-horizontal is its own inverse, the defining property of a reflection."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (flip-horizontal (img/rectangle 30 10 'solid 8)))" :note "A mirror keeps the size — the flipped 30-wide bar is still 30 wide, because reflection reverses left-right without resizing.")
    (:dialect "motoi" :tier "intermediate" :code "(define arrow (beside (img/rectangle 12 4 'solid 8) (img/circle 5 'solid 8)))\n(image? (flip-horizontal arrow))" :note "A left-to-right arrow (shaft then head) mirrored becomes a right-to-left arrow — flipping a composed image mirrors the whole layout, head and shaft swapping sides.")
    (:dialect "motoi" :tier "expert" :code "(define half (img/rectangle 10 20 'solid 12))\n(image-width (beside half (flip-horizontal half)))" :note "Beside a shape with its own horizontal mirror to build a bilaterally symmetric figure — the classic way to guarantee left-right symmetry from a single half.")
  )
  :caveats ("Only left-right is swapped; top and bottom stay put. To mirror vertically use flip-vertical." "Dimensions are unchanged — if a size changed, something other than a pure reflection happened." "A symmetric image (like a plain circle or centered square) looks identical after flipping; the mirror is real but invisible on symmetric art." "Text and asymmetric glyphs come out reversed — do not flip a sprite that contains readable letters unless you want them backwards.")
  :drawbacks ("Reflection reverses handedness, so a flipped scene has the opposite chirality — a clockwise spiral becomes counter-clockwise, which may be wrong for the content." "No axis choice beyond the vertical center; to mirror about an off-center line, place the image off-center on a scene first, then flip the scene." "Cannot combine with rotation in one call; a diagonal mirror is a rotate-flip composition.")
  :usecases ("Facing a sprite the other direction (one walk cycle serves both ways)." "Building bilateral symmetry by mirroring a half against itself." "Making a mirror-image reflection for a mirror or shop-window effect." "Reversing an arrow, hand, or directional icon.")
  :related ("flip-vertical" "rotate" "beside" "image-width" "image-height")
  :learn (:concept "Horizontal reflection about the vertical center: size-preserving, handedness-reversing, self-inverse." :prerequisites ("img/rectangle" "beside") :progression "Learn flip-horizontal and flip-vertical as the two axis reflections, then rotate for turns; compose flip with beside/above to build symmetric figures.")
  :row-2-audit (
    (:problem "A game maker drew a character walking to the right and needs the same character walking left. Redrawing a whole mirrored sprite doubles the art work and risks the two directions not matching; they want the left-facing sprite derived from the right-facing one."
     :program "(define hero-right (beside (img/circle 5 'solid 12) (img/rectangle 8 4 'solid 12)))\n(image? (flip-horizontal hero-right))"
     :eng-program "(define (facing sprite dir)\n  ;; dir 'right ⇒ as drawn; dir 'left ⇒ mirrored.\n  (if (eq? dir 'left) (flip-horizontal sprite) sprite))\n(image? (facing (beside (img/circle 5 'solid 12) (img/rectangle 8 4 'solid 12)) 'left))"
     :math-program "(define (size-preserved? img)\n  (let ((f (flip-horizontal img)))\n    (and (= (image-width f) (image-width img))\n         (= (image-height f) (image-height img)))))\n(display (size-preserved? (img/rectangle 30 10 'solid 8)))"
     :cs-program "(define (flip-h-checked img)\n  (if (image? img) (flip-horizontal img)\n      (error 'flip-horizontal \"needs an image\")))\n(image? (flip-h-checked (img/rectangle 30 10 'solid 8)))"
     :explanation "eng: a facing function that mirrors on demand from one source sprite. math: verify reflection preserves both dimensions. cs: guard the argument is an image."
     :meta "rotate 180 would turn the sprite upside-down as well as left-right, so the character would walk on its head. flip-vertical mirrors top-bottom, leaving it still facing right. scale cannot change facing at all. flip-horizontal is the only verb that reverses left-right alone, which is exactly 'face the other way'.")
    (:eng "The audit lens is 'dimensions unchanged, handedness reversed' — the operator smoke test is that width and height match the source while a known left-right asymmetry has swapped sides." :math "flip-horizontal is the reflection matrix diag(−1,1) about the vertical axis; determinant −1 marks the handedness reversal." :cs "Row-reversal resample: each pixel (x,y) maps to (W−1−x, y); O(area) and size-exact."))
  :row-3-dimension (
    (:setup "Reflect an object across an axis so one side becomes the other while the size stays fixed."
     :rungs (
       (:domain "image" :code "(image-width (flip-horizontal (img/rectangle 30 10 'solid 8)))")
       (:domain "list-reverse" :code "(reverse (list 1 2 3 4))")
       (:domain "negate-x" :code "(define (mirror-x x) (- x))\n(mirror-x 7)"))
     :explanation "Rung 1: flipping an image left-right reverses the order of its columns while keeping its width. Rung 2: reversing a list swaps first and last while keeping its length. Rung 3: negating the x-coordinate reflects a point across the y-axis while keeping its distance from the axis. All three share the shape 'reverse order along an axis; the measure along that axis is preserved, only the direction flips'."
     :meta "The transfer works because reflection is order-reversal with fixed measure: flip the sign of one coordinate (or reverse a sequence) and nothing about length changes, only which end is which. The self-inverse property (do it twice, get back the start) is shared by all three.")
    (:eng "Every reflection substrate shares the audit 'the measure is preserved and the operation is its own inverse' and the failure 'a double-flip did not return the original'." :math "An involution: a map f with f∘f = id; here the reflection diag(−1,1), and list-reverse, and x↦−x, are all involutions." :cs "Order-reversal along an axis; the same shape as reversing an array, a string, or negating a coordinate."))
  :row-4-proof (
    (:claim "flip-horizontal is its own inverse: flipping twice returns an image of the original dimensions (an involution)."
     :program "(define i (img/rectangle 30 10 'solid 8))\n(display (= (image-width (flip-horizontal (flip-horizontal i))) (image-width i))) (newline)\n(display (= (image-height (flip-horizontal (flip-horizontal i))) (image-height i)))"
     :eng-program "(define (involution-audit imgs)\n  (map (lambda (i) (and (= (image-width (flip-horizontal (flip-horizontal i))) (image-width i))\n                        (= (image-height (flip-horizontal (flip-horizontal i))) (image-height i))))\n       imgs))\n(involution-audit (list (img/square 12 'solid 8) (img/rectangle 20 6 'solid 12)))"
     :math-program "(define (double-flip-identity? i)\n  ;; diag(-1,1) squared = identity, so dimensions must be untouched.\n  (and (= (image-width (flip-horizontal (flip-horizontal i))) (image-width i))\n       (= (image-height (flip-horizontal (flip-horizontal i))) (image-height i))))\n(display (double-flip-identity? (img/rectangle 30 10 'solid 8)))"
     :cs-program "(define (self-inverse? img)\n  (let ((twice (flip-horizontal (flip-horizontal img))))\n    (and (= (image-width twice) (image-width img))\n         (= (image-height twice) (image-height img)))))\n(display (self-inverse? (img/rectangle 30 10 'solid 8)))"
     :invariant "∀ img. flip-horizontal(flip-horizontal(img)) ≅ img  (reflection is an involution: (diag(−1,1))² = I)"
     :meta "The pattern is involution: applying the operation twice is the identity. Falsified if a double flip changed the image, meaning the reflection is not exact (perhaps it drifts by a pixel) — which would break every symmetry construction that relies on flip being a clean mirror. That flip is self-inverse is what guarantees mirror-of-mirror is the original.")
    (:eng "The engineering consequence is that toggling a sprite's facing left then right returns exactly the original art, so no drift accumulates when a character changes direction repeatedly." :math "flip-horizontal generates a group of order 2 (ℤ/2ℤ); its square is the identity." :cs "Involution / self-inverse operation; the same shape as double-reverse of a list and double-negation of a number."))
  :row-5-emergence (
    (:base "flip-horizontal alone mirrors one image left-right."
     :composition "(beside (img/rectangle 10 20 'solid 12)\n        (flip-horizontal (img/rectangle 10 20 'solid 12)))"
     :eng-composition "(define (symmetric half)\n  ;; a half beside its own mirror is guaranteed left-right symmetric.\n  (beside half (flip-horizontal half)))\n(image-width (symmetric (above (img/circle 5 'solid 12) (img/rectangle 4 10 'solid 5))))"
     :math-composition "(define (butterfly wing)\n  ;; mirror plane down the middle: wing | mirror(wing).\n  (beside wing (flip-horizontal wing)))\n(image? (butterfly (img/circle 8 'outline 13)))"
     :cs-composition "(define (mirror-pair sprite)\n  (list 'right sprite 'left (flip-horizontal sprite)))\n(image? (cadr (mirror-pair (beside (img/circle 5 'solid 12) (img/rectangle 8 4 'solid 12)))))"
     :emergent "A bilaterally symmetric figure: a half placed beside its own mirror. A wing and its reflection make a butterfly; a face-half and its mirror make a whole face; a left silhouette and its flip make a symmetric emblem. This is reflection symmetry — the mirror plane that runs down the middle of butterflies, faces, heraldry, and Rorschach blots."
     :meta "This is the reflection-symmetry family — a motif and its mirror joined across an axis. It generalizes to any bilaterally symmetric object: faces, wings, vases, letters like A and M. It composes with beside because flip-horizontal preserves size (Row 4), so a half and its mirror have equal dimensions and glue into a clean symmetric whole with the mirror plane exactly down the seam.")
    (:eng "The audit lens is 'the seam is exactly centered' — an operator building a symmetric emblem checks the half and its flip are equal width so the mirror plane lands on the true center." :math "The figure is invariant under the reflection group ℤ/2ℤ generated by flip-horizontal; the axis of symmetry is the shared seam." :cs "Mirror-join construction; the shape of every bilateral sprite, symmetric procedural texture, and Rorschach generator."))
)

(verb
  :name "flip-vertical" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(flip-vertical img) -> image"
  :summary "Mirror an image top-to-bottom about its horizontal center line; dimensions are unchanged."
  :explanation "flip-vertical mirrors an image across its horizontal axis, swapping top and bottom while keeping left and right fixed — the vertical-axis counterpart of flip-horizontal. A shape pointing up comes back pointing down; the sky ends up where the ground was. As a reflection it preserves size (width and height are unchanged) and reverses handedness (determinant −1), and like every reflection it is its own inverse. Reach for flip-vertical to turn a sprite upside-down, to cast a water reflection beneath an object (the classic use — an image above its own vertical flip reads as a reflection on a lake), to point an arrow or triangle the other way, or to build top-bottom symmetry. It is the reflection about the x-axis, diag(1,−1) acting on centered coordinates."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-height (flip-vertical (img/rectangle 10 30 'solid 8)))" :note "A vertical flip keeps the height — the 30-tall bar is still 30 tall, because a mirror reflects without resizing.")
    (:dialect "motoi" :tier "intermediate" :code "(define tree (above (img/circle 10 'solid 11) (img/rectangle 4 14 'solid 5)))\n(image? (flip-vertical tree))" :note "A tree (crown above trunk) flipped vertically becomes a trunk-above-crown — the whole above-stack inverts, which is exactly how you make a reflection of a composed figure.")
    (:dialect "motoi" :tier "expert" :code "(define tree (above (img/circle 8 'solid 11) (img/rectangle 4 12 'solid 5)))\n(image-height (above tree (flip-vertical tree)))" :note "Stack a figure above its own vertical flip to build a mirror-on-water reflection — the reflected copy hangs below, doubling the height.")
  )
  :caveats ("Only top-bottom is swapped; left and right stay put. Use flip-horizontal for the other axis." "Dimensions are unchanged; a size change would mean it was not a pure reflection." "A top-bottom-symmetric image looks unchanged after flipping — the reflection is real but invisible on such art." "Handedness reverses, so an upward spiral becomes downward; watch chirality-sensitive content.")
  :drawbacks ("Reverses handedness like any reflection, which can be wrong for directional or text content." "Single fixed axis (the horizontal center); off-center vertical mirroring needs a scene-place-then-flip." "No combined rotate-flip in one call; an upside-down-and-turned result is a composition of two verbs.")
  :usecases ("Turning a sprite upside-down (a falling or defeated character)." "Casting a water or floor reflection beneath an object with above." "Pointing a triangle, arrow, or teardrop the opposite vertical way." "Building top-bottom symmetry from a single half.")
  :related ("flip-horizontal" "rotate" "above" "image-height" "image-width")
  :learn (:concept "Vertical reflection about the horizontal center: size-preserving, handedness-reversing, self-inverse." :prerequisites ("img/rectangle" "above") :progression "Learn flip-vertical beside flip-horizontal as the two axis reflections; compose flip-vertical with above to make reflections and top-bottom-symmetric figures.")
  :row-2-audit (
    (:problem "A kid drawing a lake wants a tree and its reflection in the water: the tree sits on the shore and a mirrored, upside-down copy hangs below it on the water surface. Redrawing the reflection by hand is fiddly; they want it derived from the tree."
     :program "(define tree (above (img/circle 8 'solid 11) (img/rectangle 4 12 'solid 5)))\n(above tree (flip-vertical tree))"
     :eng-program "(define (with-reflection figure)\n  (above figure (flip-vertical figure)))\n(image-height (with-reflection (above (img/circle 8 'solid 11) (img/rectangle 4 12 'solid 5))))"
     :math-program "(define (height-preserved? img)\n  (let ((f (flip-vertical img)))\n    (and (= (image-height f) (image-height img))\n         (= (image-width f) (image-width img)))))\n(display (height-preserved? (img/rectangle 10 30 'solid 8)))"
     :cs-program "(define (flip-v-checked img)\n  (if (image? img) (flip-vertical img)\n      (error 'flip-vertical \"needs an image\")))\n(image? (flip-v-checked (img/rectangle 10 30 'solid 8)))"
     :explanation "eng: a with-reflection helper that stacks a figure above its vertical mirror. math: verify reflection preserves both dimensions. cs: guard the argument is an image."
     :meta "flip-horizontal mirrors left-right, so the reflection would face sideways, not hang below. rotate 180 would flip AND reverse left-right, giving a wrong mirror for an asymmetric tree. scale cannot invert. flip-vertical is the only verb that mirrors top-bottom alone, which is exactly what a water reflection is.")
    (:eng "The audit lens is 'dimensions unchanged, top and bottom swapped' — the operator smoke test is that height matches the source while a known top-bottom asymmetry has inverted." :math "flip-vertical is the reflection diag(1,−1) about the horizontal axis; determinant −1 marks the handedness reversal." :cs "Column-reversal resample: each pixel (x,y) maps to (x, H−1−y); O(area) and size-exact."))
  :row-3-dimension (
    (:setup "Reflect an object across the horizontal axis so top and bottom exchange while the size holds fixed."
     :rungs (
       (:domain "image" :code "(image-height (flip-vertical (img/rectangle 10 30 'solid 8)))")
       (:domain "stack-reverse" :code "(reverse (list 'top 'mid 'bottom))")
       (:domain "negate-y" :code "(define (mirror-y y) (- y))\n(mirror-y 5)"))
     :explanation "Rung 1: flipping an image top-bottom reverses the order of its rows while keeping its height. Rung 2: reversing a top-to-bottom stack turns it bottom-to-top while keeping the count. Rung 3: negating the y-coordinate reflects a point across the x-axis while keeping its distance from it. All three share the shape 'reverse order along the vertical axis; the extent along that axis is preserved, only the direction flips'."
     :meta "The transfer works because vertical reflection is row-order reversal with fixed height: negate the y-coordinate (or reverse the row sequence) and the vertical extent is untouched, only which row is top. Doing it twice restores the original — an involution, like all reflections.")
    (:eng "Every vertical-reflection substrate shares the audit 'height preserved, self-inverse' and the failure 'a double flip did not restore the original ordering'." :math "The involution diag(1,−1); like reverse and y↦−y, it satisfies f∘f = id, generating ℤ/2ℤ." :cs "Row-order reversal; the same shape as reversing the lines of a buffer or negating a vertical coordinate."))
  :row-4-proof (
    (:claim "flip-vertical is its own inverse: flipping twice returns an image of the original dimensions (an involution)."
     :program "(define i (img/rectangle 10 30 'solid 8))\n(display (= (image-height (flip-vertical (flip-vertical i))) (image-height i))) (newline)\n(display (= (image-width (flip-vertical (flip-vertical i))) (image-width i)))"
     :eng-program "(define (involution-audit imgs)\n  (map (lambda (i) (and (= (image-height (flip-vertical (flip-vertical i))) (image-height i))\n                        (= (image-width (flip-vertical (flip-vertical i))) (image-width i))))\n       imgs))\n(involution-audit (list (img/square 12 'solid 8) (img/rectangle 6 20 'solid 12)))"
     :math-program "(define (double-flip-identity? i)\n  (and (= (image-height (flip-vertical (flip-vertical i))) (image-height i))\n       (= (image-width (flip-vertical (flip-vertical i))) (image-width i))))\n(display (double-flip-identity? (img/rectangle 10 30 'solid 8)))"
     :cs-program "(define (self-inverse? img)\n  (let ((twice (flip-vertical (flip-vertical img))))\n    (and (= (image-height twice) (image-height img))\n         (= (image-width twice) (image-width img)))))\n(display (self-inverse? (img/rectangle 10 30 'solid 8)))"
     :invariant "∀ img. flip-vertical(flip-vertical(img)) ≅ img  (reflection is an involution: (diag(1,−1))² = I)"
     :meta "The pattern is involution, mirrored onto the vertical axis: two flips are the identity. Falsified if a double vertical flip changed the image, meaning the mirror is inexact — which would break water-reflection and top-bottom-symmetry constructions. Together, flip-horizontal and flip-vertical are two order-2 generators; their composition is the 180-degree rotation, which is why the Klein-four group of axis symmetries lives inside these two verbs.")
    (:eng "The engineering consequence is that flipping a sprite down and back up returns the exact original, so a tumble animation that ends upright shows no drift." :math "flip-vertical generates ℤ/2ℤ; composed with flip-horizontal it generates the Klein four-group of axis-aligned reflections and the half-turn." :cs "Involution; the same shape as double-reversing rows or double-negating a coordinate."))
  :row-5-emergence (
    (:base "flip-vertical alone mirrors one image top-bottom."
     :composition "(define tree (above (img/circle 8 'solid 11) (img/rectangle 4 12 'solid 5)))\n(above tree (flip-vertical tree))"
     :eng-composition "(define (lake figure)\n  ;; figure above its vertical mirror reads as a reflection on water.\n  (above figure (flip-vertical figure)))\n(image-height (lake (above (img/circle 8 'solid 11) (img/rectangle 4 12 'solid 5))))"
     :math-composition "(define (half-turn img)\n  ;; two axis reflections compose to a 180-degree rotation.\n  (flip-vertical (flip-horizontal img)))\n(let ((i (img/rectangle 20 8 'solid 12)))\n  (list 'w (image-width (half-turn i)) 'h (image-height (half-turn i))))"
     :cs-composition "(define (diamond top)\n  ;; a triangle-ish top above its vertical flip makes a top-bottom symmetric diamond.\n  (above top (flip-vertical top)))\n(image? (diamond (img/rectangle 20 8 'solid 12)))"
     :emergent "A water reflection: a figure stacked above its own vertical flip. The tree and its inverted copy read as a scene reflected on a still lake; a mountain above its flip is a reflection on water; a top-half above its flip is a top-bottom-symmetric diamond. This is reflection symmetry about a horizontal mirror line — the shimmer of every skyline mirrored on water."
     :meta "This is the reflection-symmetry family about the horizontal axis. It generalizes to water reflections, top-bottom-symmetric shapes (diamonds, hourglasses), and — composed with flip-horizontal — the full half-turn and the Klein four-group of axis symmetries. It composes with above because flip-vertical preserves size (Row 4), so a figure and its mirror stack into a seamless reflected scene with the mirror line exactly at the seam.")
    (:eng "The audit lens is 'the mirror line sits exactly at the seam' — an operator building a water reflection checks the figure and its flip are equal height so the reflection meets the original at the waterline." :math "The composition flip-vertical∘flip-horizontal is the 180-degree rotation; the two flips generate the Klein four-group V = {id, H, V, R180}." :cs "Horizontal mirror-join; the shape of every water-reflection effect and top-bottom-symmetric procedural figure."))
)

(verb
  :name "image-width" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(image-width img) -> number"
  :summary "Return the width of an image in pixels."
  :explanation "image-width reads back the horizontal size of an image as a number of pixels. It is a pure query — it looks at the image and returns its width without changing anything. It is the measuring tape of the image algebra: you use it to check that a composition came out the size you expected, to compute a coordinate relative to an image's edge, to center something, or to fit an image into a slot. Because every combinator has a predictable effect on width (beside adds them, overlay maxes them, scale multiplies, flip preserves), image-width is how you verify those laws and how you drive layout arithmetic. Together with image-height it recovers the bounding box that every image carries."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-width (img/rectangle 24 10 'solid 8))" :note "A 24-wide rectangle reports width 24 — the query reads the size straight back.")
    (:dialect "motoi" :tier "intermediate" :code "(define row (beside (img/square 8 'solid 8) (img/square 12 'solid 12)))\n(list 'width (image-width row) 'expected (+ 8 12))" :note "Measure a beside-row and confirm its width is the sum of the pieces — image-width is how you check a layout law held.")
    (:dialect "motoi" :tier "expert" :code "(define (center-x img scene) (quotient (image-width scene) 2))\n(define scene (empty-scene 100 60))\n(place-image (img/circle 5 'solid 12) (center-x (img/circle 5 'solid 12) scene) 30 scene)\n(image-width scene)" :note "Use image-width of the scene to compute a horizontal center coordinate for place-image — measuring drives positioning.")
  )
  :caveats ("Returns the BOUNDING-BOX width, which for a rotated or non-rectangular shape includes empty corners, not just the painted pixels." "The value is pixels at the image's own resolution; scaling the image changes it, so measure after any transform, not before." "It measures the image value, not what is currently on the framebuffer — a drawn image's screen footprint is separate.")
  :drawbacks ("No sub-pixel precision — width is an integer pixel count, so fractional-scale results are rounded." "Gives only the box, not the tight extent of the ink; a diagonal line reports the full box width, over-stating the drawn area." "Measuring is cheap but calling it repeatedly in a hot loop still costs; cache the width if the image does not change.")
  :usecases ("Verifying a composition's size against an expected layout law." "Computing edge- and center-relative coordinates for place-image." "Fitting or scaling an image to a target width." "Asserting invariants in tests (beside adds, overlay maxes).")
  :related ("image-height" "image?" "beside" "scale" "place-image")
  :learn (:concept "Pure width query returning the bounding-box pixel width; the horizontal half of an image's measured box." :prerequisites ("img/rectangle") :progression "Learn image-width and image-height together as the measuring pair, then use them to check combinator laws and drive layout coordinates.")
  :row-2-audit (
    (:problem "A layout author is placing a title bar and needs to know whether their composed logo fits inside a 120-pixel-wide header before they commit it; measuring by eye is unreliable and they want a number to compare against the budget."
     :program "(define logo (beside (img/circle 6 'solid 12) (img/rectangle 30 8 'solid 8)))\n(list 'logo-width (image-width logo) 'fits-120? (<= (image-width logo) 120))"
     :eng-program "(define (fits? img budget) (<= (image-width img) budget))\n(fits? (beside (img/circle 6 'solid 12) (img/rectangle 30 8 'solid 8)) 120)"
     :math-program "(define (width-of-beside a b) (+ (image-width a) (image-width b)))\n(let ((a (img/circle 6 'solid 12)) (b (img/rectangle 30 8 'solid 8)))\n  (list 'measured (image-width (beside a b)) 'predicted (width-of-beside a b)))"
     :cs-program "(define (width-checked img)\n  (if (image? img) (image-width img) (error 'image-width \"needs an image\")))\n(width-checked (img/rectangle 30 8 'solid 8))"
     :explanation "eng: a fits? predicate comparing width against a budget. math: predict the beside width from the parts and confirm the measurement matches. cs: guard that the argument is an image before measuring."
     :meta "There is no sibling that gives width — image-height gives the other axis, image? gives only a yes/no. To get the horizontal size you must call image-width; the alternative is rendering and counting pixels by hand, which is exactly what this query saves you from.")
    (:eng "The audit lens is 'measure, do not guess' — the operator replaces eyeballed sizes with (image-width x) comparisons so a layout budget is checked by a number, not a hunch." :math "image-width is the projection π_w : Image → ℕ recovering the first component of the bounding box." :cs "Constant-time field read of the width; the same shape as .length or .width on a record."))
  :row-3-dimension (
    (:setup "Read back one measured dimension of a structured value without altering the value."
     :rungs (
       (:domain "image" :code "(image-width (img/rectangle 24 10 'solid 8))")
       (:domain "list-length" :code "(length (list 'a 'b 'c 'd))")
       (:domain "string-length" :code "(string-length \"hello\")"))
     :explanation "Rung 1: image-width reads an image's horizontal size. Rung 2: length reads a list's element count. Rung 3: string-length reads a string's character count. All three share the shape 'a pure measure that projects a size out of a structure and returns a number, leaving the structure untouched'."
     :meta "The transfer works because measuring is a projection: a total function from a structured value to a scalar summary. Whether the structure is an image, a list, or a string, the query reads without writing and the answer is a plain number.")
    (:eng "Every measure-query substrate shares the audit 'the query is pure and cheap' and the failure 'the measure disagreed with how the structure was built'." :math "A projection / measure homomorphism from a structure to (ℕ, +) that respects the structure's concatenation (length of concat = sum of lengths)." :cs "Size accessor; the same shape as len(), .size, and .count across data structures."))
  :row-4-proof (
    (:claim "image-width is additive over beside: the width of a row equals the sum of the widths of its pieces."
     :program "(define a (img/square 10 'solid 8))\n(define b (img/square 14 'solid 12))\n(display (= (image-width (beside a b)) (+ (image-width a) (image-width b))))"
     :eng-program "(define (additivity-audit pieces)\n  (= (image-width (apply beside pieces)) (apply + (map image-width pieces))))\n(display (additivity-audit (list (img/square 4 'solid 8) (img/square 6 'solid 9) (img/square 8 'solid 10))))"
     :math-program "(define (homomorphism? a b)\n  (= (image-width (beside a b)) (+ (image-width a) (image-width b))))\n(display (homomorphism? (img/square 7 'solid 8) (img/square 9 'solid 12)))"
     :cs-program "(define (width-sum-contract? pieces)\n  (= (image-width (apply beside pieces)) (apply + (map image-width pieces))))\n(display (width-sum-contract? (list (img/square 3 'solid 8) (img/square 5 'solid 9))))"
     :invariant "∀ a b. image-width(beside(a,b)) = image-width(a) + image-width(b)  (image-width is a monoid homomorphism from beside to +)"
     :meta "The pattern is that the measure respects the operation: image-width carries beside's concatenation to addition of numbers, a homomorphism. Falsified if a row's width differed from the sum of its pieces, meaning either beside overlaps pieces or image-width mis-measures — either way the layout algebra would be unsound. This homomorphism is what lets you predict layout sizes arithmetically instead of by rendering.")
    (:eng "The engineering consequence is that you can compute a row's width from its parts' widths, so a layout's total size is a spreadsheet sum, not a render-and-measure." :math "image-width : (Image, beside) → (ℕ, +) is a monoid homomorphism; likewise image-height over above." :cs "Measure-respects-concatenation; the same shape as len(a++b) = len(a)+len(b)."))
  :row-5-emergence (
    (:base "image-width measures one image's horizontal size."
     :composition "(define pieces (map (lambda (c) (img/square (+ 4 c) 'solid (+ 8 c))) (iota 4)))\n(apply + (map image-width pieces))"
     :eng-composition "(define (pack-into budget imgs)\n  ;; greedily keep prefix that fits a width budget.\n  (let loop ((imgs imgs) (used 0) (kept '()))\n    (cond ((null? imgs) (reverse kept))\n          ((<= (+ used (image-width (car imgs))) budget)\n           (loop (cdr imgs) (+ used (image-width (car imgs))) (cons (car imgs) kept)))\n          (else (reverse kept)))))\n(length (pack-into 30 (map (lambda (c) (img/square 8 'solid 8)) (iota 6))))"
     :math-composition "(define (total-width imgs) (fold + 0 (map image-width imgs)))\n(total-width (list (img/square 5 'solid 8) (img/square 7 'solid 9) (img/square 9 'solid 10)))"
     :cs-composition "(define (widest imgs)\n  (fold (lambda (i m) (max (image-width i) m)) 0 imgs))\n(widest (list (img/square 5 'solid 8) (img/square 12 'solid 9) (img/square 7 'solid 10)))"
     :emergent "A layout engine: widths measured and summed drive packing, fitting, and alignment decisions. Sum the widths to size a row, take the max to size an overlay column, greedily pack a prefix that fits a budget — this is the measurement pass that every text layout, flexbox, and shelf-packer runs before it places anything."
     :meta "This is the measure-then-layout family — a size query feeding a packing or fitting decision. It generalizes to line-breaking (sum glyph widths until the margin), flexbox (measure then distribute), and bin-packing (measure then fit). It composes because image-width is a homomorphism over beside (Row 4), so summed measurements exactly predict laid-out sizes.")
    (:eng "The audit lens is 'the measurement pass precedes the layout pass' — an operator debugging a ragged row checks the measured widths first, since layout decisions are only as good as the measures feeding them." :math "Layout is a fold of the measure homomorphism: Σ widths sizes a row, max widths sizes an overlay." :cs "Measure pass of a layout engine; the shape of every reflow that measures children before positioning them."))
)

(verb
  :name "image-height" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(image-height img) -> number"
  :summary "Return the height of an image in pixels."
  :explanation "image-height reads back the vertical size of an image as a number of pixels — the vertical counterpart of image-width, and its equal partner in recovering an image's bounding box. It is a pure query that returns the height without touching the image. Reach for it to check a column came out the expected height, to compute a vertical coordinate, to align things on a baseline, or to size a scene tall enough to hold a figure. Each combinator has a known effect on height (above sums them, beside maxes them, scale multiplies, flip preserves), so image-height both drives vertical layout arithmetic and verifies those laws. Where image-width is the horizontal tape measure, image-height is the vertical one; you almost always use them as a pair."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image-height (img/rectangle 10 24 'solid 8))" :note "A 24-tall rectangle reports height 24 — the vertical size read straight back.")
    (:dialect "motoi" :tier "intermediate" :code "(define col (above (img/square 8 'solid 8) (img/square 12 'solid 12)))\n(list 'height (image-height col) 'expected (+ 8 12))" :note "Measure an above-column and confirm its height is the sum of the pieces — image-height checks the vertical layout law.")
    (:dialect "motoi" :tier "expert" :code "(define fig (above (img/circle 8 'solid 11) (img/rectangle 4 12 'solid 5)))\n(define scene (empty-scene 60 (+ 8 (image-height fig))))\n(image-height scene)" :note "Size a scene to fit a figure plus a margin by measuring the figure's height — the measurement drives the frame dimensions.")
  )
  :caveats ("Returns the BOUNDING-BOX height, so a rotated shape's height includes empty corners above and below the ink." "Pixels at the image's own resolution; a scaled image reports its scaled height, so measure after transforms." "Measures the image value, not the current framebuffer; screen footprint after drawing is a separate matter.")
  :drawbacks ("Integer pixels only — fractional-scale heights are rounded." "Bounding box, not tight ink extent; a short glyph in a tall box reports the box height." "Cheap per call but not free in a hot loop; cache if the image is fixed.")
  :usecases ("Verifying a column's height against an expected layout law." "Computing vertical coordinates and baselines for place-image." "Sizing a scene tall enough to contain a figure." "Asserting vertical invariants in tests (above sums, beside maxes).")
  :related ("image-width" "image?" "above" "scale" "place-image")
  :learn (:concept "Pure height query returning the bounding-box pixel height; the vertical half of an image's measured box." :prerequisites ("img/rectangle") :progression "Learn image-height with image-width as the measuring pair; use them to verify combinator laws and to compute vertical layout coordinates.")
  :row-2-audit (
    (:problem "A menu designer stacks a variable number of rows and must size the panel behind them exactly tall enough — too short clips the last row, too tall wastes space. They need the stacked height as a number to set the panel."
     :program "(define menu (apply above (map (lambda (i) (img/rectangle 60 10 'outline 8)) (iota 4))))\n(list 'menu-height (image-height menu) 'panel-height (+ 4 (image-height menu)))"
     :eng-program "(define (panel-height rows row-h margin) (+ margin (* rows row-h)))\n(let ((menu (apply above (map (lambda (i) (img/rectangle 60 10 'outline 8)) (iota 4)))))\n  (list 'measured (image-height menu) 'formula (panel-height 4 10 0)))"
     :math-program "(define (height-of-above pieces) (apply + (map image-height pieces)))\n(let ((rows (map (lambda (i) (img/rectangle 60 10 'outline 8)) (iota 4))))\n  (list 'measured (image-height (apply above rows)) 'predicted (height-of-above rows)))"
     :cs-program "(define (height-checked img)\n  (if (image? img) (image-height img) (error 'image-height \"needs an image\")))\n(height-checked (img/rectangle 10 24 'solid 8))"
     :explanation "eng: a panel-height formula from row count and row height. math: predict the above-column height from the pieces and confirm the measurement matches. cs: guard the argument is an image."
     :meta "image-width gives the wrong axis for a stacked menu's height. image? gives only a boolean. To size the panel you must measure the vertical extent with image-height; the alternative is rendering and counting rows, which the query does for you exactly.")
    (:eng "The audit lens is 'size the container from the measured content' — the operator sets the panel height from (image-height menu), so adding a row grows the panel automatically instead of clipping." :math "image-height is the projection π_h : Image → ℕ recovering the second component of the bounding box." :cs "Constant-time field read of the height; the same shape as .height on a record."))
  :row-3-dimension (
    (:setup "Project the size along one axis out of a structured value as a pure number."
     :rungs (
       (:domain "image" :code "(image-height (img/rectangle 10 24 'solid 8))")
       (:domain "column-count" :code "(define (rows-in table) (length table))\n(rows-in (list (list 1 2) (list 3 4) (list 5 6)))")
       (:domain "vector-length" :code "(vector-length (make-vector 7 0))"))
     :explanation "Rung 1: image-height reads an image's vertical size. Rung 2: counting rows reads how tall a table is. Rung 3: vector-length reads how long a vector is. All three share the shape 'project one axis's size out of a structure into a number, without changing the structure'."
     :meta "The transfer works because a size query along an axis is a projection to a scalar: read the extent, return a number, leave the structure alone. The axis — vertical pixels, table rows, vector slots — does not change the read-only projection shape.")
    (:eng "Every axis-size query shares the audit 'the read is pure and matches construction' and the failure 'the reported extent disagreed with how the structure was assembled'." :math "A projection onto one coordinate of a product measure; a homomorphism respecting the axis's concatenation (above)." :cs "Dimension accessor; the same shape as rows(), .height, and .length."))
  :row-4-proof (
    (:claim "image-height is additive over above: the height of a column equals the sum of the heights of its pieces."
     :program "(define a (img/square 10 'solid 8))\n(define b (img/square 14 'solid 12))\n(display (= (image-height (above a b)) (+ (image-height a) (image-height b))))"
     :eng-program "(define (additivity-audit pieces)\n  (= (image-height (apply above pieces)) (apply + (map image-height pieces))))\n(display (additivity-audit (list (img/square 4 'solid 8) (img/square 6 'solid 9) (img/square 8 'solid 10))))"
     :math-program "(define (homomorphism? a b)\n  (= (image-height (above a b)) (+ (image-height a) (image-height b))))\n(display (homomorphism? (img/square 7 'solid 8) (img/square 9 'solid 12)))"
     :cs-program "(define (height-sum-contract? pieces)\n  (= (image-height (apply above pieces)) (apply + (map image-height pieces))))\n(display (height-sum-contract? (list (img/square 3 'solid 8) (img/square 5 'solid 9))))"
     :invariant "∀ a b. image-height(above(a,b)) = image-height(a) + image-height(b)  (image-height is a monoid homomorphism from above to +)"
     :meta "The pattern is the transpose of image-width's law: image-height carries above's vertical concatenation to numeric addition. Falsified if a column's height differed from the sum of its pieces, meaning above overlaps rows or image-height mis-measures — breaking vertical layout soundness. That image-width and image-height are homomorphisms over beside and above respectively is the full arithmetic of the layout box-model.")
    (:eng "The engineering consequence is that a stacked panel's height is the sum of its row heights, computed without rendering, so containers size themselves from content." :math "image-height : (Image, above) → (ℕ, +) is a monoid homomorphism, the vertical partner of image-width over beside." :cs "Measure-respects-vertical-concatenation; the same shape as summing line heights to get a paragraph's height."))
  :row-5-emergence (
    (:base "image-height measures one image's vertical size."
     :composition "(define rows (map (lambda (i) (img/rectangle 40 (+ 6 i) 'outline 8)) (iota 4)))\n(apply + (map image-height rows))"
     :eng-composition "(define (fit-rows budget rows)\n  ;; keep the prefix of rows whose total height fits a vertical budget.\n  (let loop ((rows rows) (used 0) (kept 0))\n    (cond ((null? rows) kept)\n          ((<= (+ used (image-height (car rows))) budget)\n           (loop (cdr rows) (+ used (image-height (car rows))) (+ kept 1)))\n          (else kept))))\n(fit-rows 30 (map (lambda (i) (img/rectangle 40 10 'outline 8)) (iota 6)))"
     :math-composition "(define (total-height imgs) (fold + 0 (map image-height imgs)))\n(total-height (list (img/square 5 'solid 8) (img/square 7 'solid 9) (img/square 9 'solid 10)))"
     :cs-composition "(define (tallest imgs)\n  (fold (lambda (i m) (max (image-height i) m)) 0 imgs))\n(tallest (list (img/square 5 'solid 8) (img/square 12 'solid 9) (img/square 7 'solid 10)))"
     :emergent "A vertical layout engine: heights measured and summed drive stacking, paging, and scroll decisions. Sum row heights to size a menu, take the max to size a beside-row, keep the rows that fit a page — this is the vertical measurement pass behind every document flow, list view, and scroll container."
     :meta "This is the measure-then-layout family on the vertical axis — a height query feeding a stacking or paging decision. It generalizes to page-breaking (sum heights until the page fills), list virtualization (measure then window), and vertical flex distribution. It composes because image-height is a homomorphism over above (Row 4), so summed heights exactly predict stacked sizes.")
    (:eng "The audit lens is 'measure heights before you page-break' — an operator debugging a clipped list checks the summed row heights against the container before blaming the renderer." :math "Vertical layout is a fold of the height homomorphism: Σ heights sizes a column, max heights sizes a row." :cs "Vertical measure pass; the shape of every document reflow and virtualized list that measures rows before placing them."))
)

(verb
  :name "image?" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(image? v) -> boolean"
  :summary "Return #t if the value is an image, #f otherwise; the type predicate for the image algebra."
  :explanation "image? is the type test for the image world: it returns #t when its argument is an image value (anything an img/* constructor or a combinator produced) and #f for anything else — a number, a symbol, a list. It is the guard at the door of every combinator: overlay, beside, scale, and place-image all expect images, and image? is how you check a value before handing it in, or how you confirm a combinator actually returned an image. It is a pure, total predicate — it never errors, it just answers yes or no — which makes it the honest way to discriminate images from the rest of the value space. Throughout this chapter it is the query that makes non-numeric examples printable: wrapping a combinator in image? turns a bare image (which prints opaquely) into a clean #t you can read and test."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(image? (img/circle 5 'solid 8))" :note "A constructed circle is an image, so image? returns #t — the basic yes case.")
    (:dialect "motoi" :tier "intermediate" :code "(list (image? 5) (image? 'red) (image? (list 1 2)) (image? (img/square 8 'solid 8)))" :note "A number, a symbol, and a list are all not images (#f), while a constructed square is (#t) — image? cleanly separates images from the rest of the value space.")
    (:dialect "motoi" :tier "expert" :code "(define (safe-overlay . imgs)\n  (if (fold (lambda (i ok) (and ok (image? i))) #t imgs)\n      (apply overlay imgs)\n      'not-all-images))\n(image? (safe-overlay (img/circle 4 'solid 8) (img/circle 8 'outline 12)))" :note "Guard a variadic overlay by folding image? across every argument first, so a stray non-image is caught before it reaches the combinator.")
  )
  :caveats ("Returns only #t or #f — it never tells you WHAT non-image a value is, only that it is not an image." "It does not validate an image's contents or size; a zero-area or malformed image still answers #t as long as it is the image type." "It is a value-type test, not a check of what is on the framebuffer; a value can be an image without ever having been drawn.")
  :drawbacks ("A yes/no answer gives no diagnostic detail; pair it with number?/symbol? if you need to report what a bad argument actually was." "Cannot distinguish an empty-scene from a constructed shape — both are images; use image-width/height if you need to tell sizes apart." "Guarding every argument with image? adds a pass over the inputs, a small cost on very large argument lists.")
  :usecases ("Guarding combinator inputs before overlay/beside/above/place-image." "Confirming a combinator returned an image (the printable-example trick used throughout this chapter)." "Branching on whether a value is drawable in generic code." "Writing contracts and tests that assert a result is an image.")
  :related ("image-width" "image-height" "overlay" "beside" "place-image")
  :learn (:concept "Pure total type predicate for image values; the door-guard of the image algebra." :prerequisites ("img/circle") :progression "Learn image? as the type test, then image-width/image-height to measure the images it identifies; use it to guard combinator inputs.")
  :row-2-audit (
    (:problem "A tool builds scenes from a list of items that came from user data, and some entries might be numbers or symbols by mistake. Before folding them into a scene with place-image, the tool must weed out anything that is not an image so a bad entry cannot crash the render."
     :program "(define items (list (img/circle 4 'solid 8) 42 (img/square 6 'solid 12) 'oops))\n(length (filter image? items))"
     :eng-program "(define (drawable-only items) (filter image? items))\n(length (drawable-only (list (img/circle 4 'solid 8) 42 (img/square 6 'solid 12) 'oops)))"
     :math-program "(define (partition-images items)\n  (list 'images (length (filter image? items))\n        'non-images (length (filter (lambda (x) (not (image? x))) items))))\n(partition-images (list (img/circle 4 'solid 8) 42 (img/square 6 'solid 12) 'oops))"
     :cs-program "(define (assert-image x)\n  (if (image? x) x (error 'assert-image \"expected an image\")))\n(image? (assert-image (img/circle 4 'solid 8)))"
     :explanation "eng: filter the list down to drawables before rendering. math: partition the input into images and non-images and count each. cs: a hard assertion that fails loudly on a non-image."
     :meta "image-width and image-height would ERROR on a non-image rather than answer cleanly, so they cannot be used to test whether a value is safe to measure. Only image? is total — it answers #f instead of throwing — which is exactly what a guard needs. Reaching for a measurer to test type is the classic mistake this predicate exists to prevent.")
    (:eng "The audit lens is 'filter before you fold' — the operator runs image? as a guard so a malformed entry becomes a dropped item, not a crashed render." :math "image? is the characteristic function 1_Image : Value → {#t,#f} of the set of image values." :cs "Total type predicate; the same shape as number?, string?, and pair? — a domain test that never throws."))
  :row-3-dimension (
    (:setup "Test membership of a value in a type or set, returning a clean boolean without failing."
     :rungs (
       (:domain "image" :code "(image? (img/circle 5 'solid 8))")
       (:domain "number-test" :code "(number? 42)")
       (:domain "set-membership" :code "(define (member? x s) (cond ((null? s) #f) ((equal? x (car s)) #t) (else (member? x (cdr s)))))\n(member? 3 (list 1 2 3))"))
     :explanation "Rung 1: image? tests whether a value is an image. Rung 2: number? tests whether a value is a number. Rung 3: a membership test asks whether an element is in a set. All three share the shape 'a total predicate answering yes/no about membership, never raising an error on a non-member'."
     :meta "The transfer works because a type test IS a set-membership test: a type is a set of values, and the predicate is its characteristic function. Whether the set is images, numbers, or an explicit list, the yes/no-without-failure shape is identical.")
    (:eng "Every membership-predicate substrate shares the audit 'totality — it answers for every input' and the failure 'the predicate threw instead of returning #f for a non-member'." :math "A characteristic function 1_S : X → {⊤,⊥}; totality means it is defined on all of X, not just S." :cs "Type / membership predicate; the same shape as isinstance, typeof checks, and set.contains."))
  :row-4-proof (
    (:claim "image? is total and correct: it returns #t for every constructor/combinator result and #f for non-images, never erroring."
     :program "(display (image? (img/circle 5 'solid 8))) (newline)\n(display (image? (overlay (img/circle 4 'solid 8) (img/square 10 'solid 12)))) (newline)\n(display (image? 5)) (newline)\n(display (image? 'red)) (newline)\n(display (image? (list 1 2)))"
     :eng-program "(define (predicate-audit values)\n  (map (lambda (v) (list v '=> (image? v))) values))\n(predicate-audit (list (img/circle 5 'solid 8) 5 'red (list 1 2) (empty-scene 10 10)))"
     :math-program "(define (closed-under-combinators?)\n  ;; every combinator output must satisfy image?.\n  (and (image? (overlay (img/circle 4 'solid 8) (img/circle 6 'solid 12)))\n       (image? (beside (img/square 4 'solid 8) (img/square 4 'solid 12)))\n       (image? (rotate 30 (img/square 8 'solid 8)))\n       (image? (scale 2 (img/square 8 'solid 8)))))\n(display (closed-under-combinators?))"
     :cs-program "(define (never-throws? values)\n  ;; image? returns a boolean for every input, image or not.\n  (fold (lambda (v ok) (and ok (boolean? (image? v)))) #t values))\n(display (never-throws? (list (img/circle 5 'solid 8) 5 'red (list 1 2))))"
     :invariant "∀ v. image?(v) ∈ {#t,#f}  ∧  image?(c(...)) = #t for every constructor/combinator c  (total predicate, closed over the algebra)"
     :meta "The pattern is closure plus totality: every operation in the image algebra returns something image? accepts, and image? decides every value without failing. Falsified if some combinator produced a value image? rejected — that would mean the algebra is not closed, and a composition could yield a non-image that the next combinator chokes on. Closure under image? is what makes combinators freely chainable.")
    (:eng "The engineering consequence is that you can chain combinators without re-checking types between steps — every output is an image, so the next call is always safe." :math "The image type is closed under the combinators: they form an algebra whose carrier is exactly {v : image?(v)}." :cs "Closure + total predicate; the same shape as a well-typed algebra where every operation returns an inhabitant of the type."))
  :row-5-emergence (
    (:base "image? decides whether one value is an image."
     :composition "(define mixed (list (img/circle 4 'solid 8) 7 (img/square 6 'solid 12) 'x (empty-scene 10 10)))\n(apply beside (filter image? mixed))"
     :eng-composition "(define (safe-scene w h items)\n  (fold (lambda (item s) (if (image? (car item))\n                             (place-image (car item) (cadr item) (caddr item) s)\n                             s))\n        (empty-scene w h) items))\n(image-width (safe-scene 60 60 (list (list (img/circle 4 'solid 8) 20 20)\n                                     (list 99 40 40))))"
     :math-composition "(define (count-drawable items) (length (filter image? items)))\n(count-drawable (list (img/circle 4 'solid 8) 7 (img/square 6 'solid 12) 'x))"
     :cs-composition "(define (validate-all items)\n  (if (fold (lambda (i ok) (and ok (image? i))) #t items) 'all-images 'has-non-image))\n(validate-all (list (img/circle 4 'solid 8) (img/square 6 'solid 12)))"
     :emergent "A type-safe render pipeline: image? filters a mixed input down to drawables, then the layout and place-image verbs run on a clean, validated list. This is the validate-then-process pattern — the same guard a parser runs before evaluation, a form runs before submission, or a scene builder runs before it composites, so malformed data is dropped at the door rather than crashing the render."
     :meta "This is the validate-then-process family — a total predicate filters input to a safe domain before a partial operation consumes it. It generalizes to input sanitization, schema validation, and precondition guards. It composes because image? is total and the algebra is closed under it (Row 4), so filtering by image? yields a list every downstream combinator accepts.")
    (:eng "The audit lens is 'drop bad data at the boundary' — an operator makes image? the gate so the render pass only ever sees images, turning would-be crashes into silently skipped entries." :math "The pipeline is process ∘ filter(image?), restricting a partial operation to the sub-domain where it is total." :cs "Validate-then-process; the shape of every guard that sanitizes input before a partial function runs on it."))
)

(verb
  :name "draw-image" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(draw-image img x y) -> undefined"
  :summary "Blit an image onto the live framebuffer with its top-left corner at (x,y); requires SD mode, returns nothing."
  :explanation "draw-image is a SINK: it takes a composed image value and actually paints it onto the screen framebuffer, with the image's TOP-LEFT corner landing at pixel (x,y). Unlike the pure combinators, it returns nothing (undefined) — its whole effect is the marks it leaves on the canvas. Because it paints, it requires the framebuffer to exist: every block that calls draw-image must first run (set-mode 'sd) to bring up the default 320x240 canvas. This is the bridge from the value world (where you build and transform images purely) to the pixel world (where they become visible). Reach for draw-image when you have finished composing a picture and want to put it on screen at a known corner — a HUD element at the top-left, a tile at grid coordinates, a sprite at its computed position. Its top-left anchoring makes it the natural partner of grid and tile layouts; for centered placement use draw-image/center instead."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (draw-image (img/circle 12 'solid 8) 50 50)" :note "Bring up the SD canvas, then blit a circle with its top-left at (50,50). It paints and prints nothing — the blank output is the correct result for a sink.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n(draw-image (img/square 20 'solid 12) 10 10)\n(draw-image (img/square 20 'outline 8) 40 10)" :note "Two blits onto the same canvas at different top-left corners — draw-image is called once per placed image, and later calls paint over earlier ones where they overlap.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n(for-each (lambda (i) (draw-image (img/square 8 'solid (+ 8 (modulo i 8))) (* i 12) 20))\n          (iota 6))" :note "Paint a row of tiles by iterating over indices and blitting each at a computed x — draw-image inside a for-each is how you render a whole strip from a loop.")
  )
  :caveats ("MUST be preceded by (set-mode 'sd) — calling it without a framebuffer has nowhere to paint." "The anchor is the TOP-LEFT corner, not the center; to center on (x,y) use draw-image/center, which is off by half the width and height." "It returns undefined and prints nothing — an empty result is success, not failure, for this sink." "Later draw-image calls paint OVER earlier ones; paint order is the z-order on the framebuffer, so draw background first, foreground last.")
  :drawbacks ("No return value means you cannot chain it like the pure combinators; it is a statement, not an expression." "Painting past the canvas edge clips silently, so an off-screen coordinate shows up as a missing sprite, not an error." "It commits to pixels immediately; you cannot undo a blit except by repainting over it, so compose in the value world first and blit last.")
  :usecases ("Putting a finished composed image on screen at a known corner." "Rendering tiles or a HUD at grid coordinates (top-left anchoring)." "Blitting sprites at computed positions inside a render loop." "The final step of a pipeline that built an image purely and now shows it.")
  :related ("draw-image/center" "place-image" "set-mode" "overlay" "image-width")
  :learn (:concept "Framebuffer blit at a top-left anchor: the sink that turns an image value into painted pixels, SD-mode required." :prerequisites ("set-mode" "overlay") :progression "Build and transform images purely with the combinators, then draw-image to paint the result; use draw-image/center when the anchor should be the center, or place-image to compose onto a scene value instead of the live canvas.")
  :row-2-audit (
    (:problem "A game maker has composed a score panel purely (a bordered box with pips) and now needs it to appear in the top-left of the HUD at exactly (4,4). They want the panel's corner nailed to that coordinate so it lines up with the screen edge."
     :program "(set-mode 'sd)\n(draw-image (overlay (img/rectangle 40 12 'outline 15)\n                     (img/rectangle 40 12 'solid 0))\n            4 4)"
     :eng-program "(define (hud-at panel x y) (draw-image panel x y))\n(set-mode 'sd)\n(hud-at (overlay (img/rectangle 40 12 'outline 15) (img/rectangle 40 12 'solid 0)) 4 4)"
     :math-program "(set-mode 'sd)\n;; top-left anchor: the image occupies [x, x+w) × [y, y+h).\n(define panel (img/rectangle 40 12 'solid 0))\n(draw-image panel 4 4)\n(list 'occupies-x (list 4 (+ 4 (image-width panel))))"
     :cs-program "(define (draw-checked img x y)\n  (if (and (image? img) (number? x) (number? y)) (draw-image img x y)\n      (error 'draw-image \"needs an image and numeric x y\")))\n(set-mode 'sd)\n(draw-checked (img/rectangle 40 12 'solid 0) 4 4)"
     :explanation "eng: a hud-at helper naming the blit. math: state that a top-left blit occupies [x,x+w)×[y,y+h). cs: guard the image and coordinate types before blitting."
     :meta "place-image composes onto a SCENE VALUE and returns a new image — it never touches the live screen, so the HUD would not appear. draw-image/center would put the panel's CENTER at (4,4), pushing most of it off the top-left edge. draw-image with its top-left anchor is the one sink that lands a corner exactly on a screen coordinate, which is what edge-aligned HUD elements need.")
    (:eng "The audit lens is 'the corner is where you said, and set-mode ran first' — the operator smoke test is that the blit lands flush to the coordinate and that no draw happened before the framebuffer existed." :math "draw-image maps the image's local (0,0) to screen (x,y); the image covers the axis-aligned rectangle [x,x+w)×[y,y+h)." :cs "Framebuffer blit with top-left origin; O(w·h) pixel writes, no return, side-effect only."))
  :row-3-dimension (
    (:setup "Commit a prepared value to an external device at a chosen address, for effect rather than for a returned result."
     :rungs (
       (:domain "image" :code "(begin (set-mode 'sd) (draw-image (img/circle 8 'solid 12) 30 30))")
       (:domain "print" :code "(begin (display \"hello\") (newline))")
       (:domain "vector-write" :code "(define v (make-vector 4 0))\n(vector-set! v 2 99)\n'done")
       )
     :explanation "Rung 1: draw-image commits an image to the framebuffer at (x,y) for its visible effect. Rung 2: display commits a string to the output stream for its printed effect. Rung 3: vector-set! commits a value to a slot for its stored effect. All three share the shape 'perform a side effect at an address; the result is the effect, not a returned value'."
     :meta "The transfer works because a sink is an effectful write: prepare a value purely, then commit it to a mutable target (screen, stream, memory). None of them returns a useful value — the point is the change they make to the world, and all must be sequenced (order matters) rather than composed as expressions.")
    (:eng "Every sink substrate shares the audit 'sequence matters and the device must be ready' and the failure 'committed before initialization (drew before set-mode, wrote before open)'." :math "An effectful action in a sequencing monad: the value is the side effect on a mutable state, not a return." :cs "Output / write side-effect; the same shape as print, file-write, and memory-store — ordered statements, not expressions."))
  :row-4-proof (
    (:claim "draw-image is a pure sink: it paints and returns undefined, so its effect is on the framebuffer and its value is not usable — running it does not error under SD mode."
     :program "(set-mode 'sd)\n(draw-image (img/circle 10 'solid 8) 20 20)\n(display 'painted-ok)"
     :eng-program "(set-mode 'sd)\n(for-each (lambda (xy) (draw-image (img/square 6 'solid 12) (car xy) (cadr xy)))\n          (list (list 10 10) (list 30 10) (list 50 10)))\n(display 'all-blitted)"
     :math-program "(set-mode 'sd)\n;; idempotent-in-value: the second blit at the same spot leaves the same pixels.\n(draw-image (img/square 8 'solid 12) 40 40)\n(draw-image (img/square 8 'solid 12) 40 40)\n(display 'stable)"
     :cs-program "(set-mode 'sd)\n;; sequencing: draw returns nothing, so we thread with begin, not with a value.\n(begin (draw-image (img/circle 5 'solid 8) 10 10)\n       (draw-image (img/circle 5 'solid 8) 30 30)\n       (display 'sequenced))"
     :invariant "∀ img x y (under SD mode). draw-image(img,x,y) commits pixels and yields no value; re-blitting the same image at the same spot is pixel-idempotent"
     :meta "The pattern is effect-without-value under a required precondition (SD mode). Falsified if draw-image threw under SD mode or returned a value you could compose with — either would mean it is not a clean sink. Blitting the same image at the same coordinate twice leaves the framebuffer identical, so the sink is idempotent in the pixels it lands, which is what makes redraw-on-every-frame safe.")
    (:eng "The engineering consequence is that a render loop can blit the same static sprite every frame without accumulating change — the second identical blit is a no-op on pixels, so redraw is safe." :math "draw-image : Image × ℕ × ℕ → Unit; its meaning is the state transition on the framebuffer, idempotent for identical (img,x,y)." :cs "Idempotent write under a precondition; the same shape as writing the same byte to the same address twice."))
  :row-5-emergence (
    (:base "draw-image blits one image onto the framebuffer at a top-left corner."
     :composition "(set-mode 'sd)\n(for-each\n  (lambda (rc)\n    (draw-image (img/square 10 'solid (if (even? (+ (car rc) (cadr rc))) 0 15))\n                (* (car rc) 12) (* (cadr rc) 12)))\n  (list (list 0 0) (list 1 0) (list 0 1) (list 1 1)))"
     :eng-composition "(define (tilemap tiles cols)\n  (set-mode 'sd)\n  (for-each (lambda (i) (draw-image (list-ref tiles (modulo i (length tiles)))\n                                    (* (modulo i cols) 16) (* (quotient i cols) 16)))\n            (iota (* cols 3))))\n(tilemap (list (img/square 14 'solid 8) (img/square 14 'solid 12)) 4)"
     :math-composition "(define (grid-blit cell rows cols)\n  (set-mode 'sd)\n  (for-each (lambda (r)\n              (for-each (lambda (c) (draw-image (img/square (- cell 2) 'outline 12) (* c cell) (* r cell)))\n                        (iota cols)))\n            (iota rows)))\n(grid-blit 12 2 3)"
     :cs-composition "(define (render-layer sprites)\n  (set-mode 'sd)\n  (for-each (lambda (s) (draw-image (car s) (cadr s) (caddr s))) sprites))\n(render-layer (list (list (img/circle 5 'solid 12) 10 10)\n                    (list (img/square 8 'solid 8) 40 40)))"
     :emergent "A tilemap render: images blitted at grid coordinates (col·cell, row·cell) tile the screen into a level. A checkerboard, a dungeon floor, a sprite atlas laid onto a map — all are draw-image driven by grid arithmetic. This is immediate-mode tile rendering, the same nested-loop blit that every 2D tile engine and terminal-cell renderer runs to paint a grid of cells."
     :meta "This is the immediate-mode tile-render family — a nested loop over grid cells blitting one image per cell. It generalizes to sprite atlases, character-cell terminals, and bitmap fonts. It composes because draw-image is a top-left-anchored idempotent sink (Row 4), so cell (r,c) maps cleanly to pixel (c·cell, r·cell) and re-rendering the grid each frame is safe.")
    (:eng "The audit lens is 'grid coordinate times cell size equals pixel corner' — an operator debugging a misaligned tilemap checks the (col·cell, row·cell) arithmetic, since a top-left blit lands exactly there." :math "The tile render is a double fold over rows and columns, mapping cell (r,c) to the blit at (c·cell, r·cell)." :cs "Immediate-mode grid blit; the shape of every tile engine, cell-grid renderer, and bitmap-font drawer."))
)

(verb
  :name "draw-image/center" :std "Motoi"
  :library "image-compose"
  :kind "meta"
  :signature "(draw-image/center img x y) -> undefined"
  :summary "Blit an image onto the live framebuffer centered at (x,y); requires SD mode, returns nothing."
  :explanation "draw-image/center is the centered sink — the same framebuffer blit as draw-image, but anchored at the image's CENTER instead of its top-left corner. You give it the point where the middle of the image should land, and it paints the image so its center sits exactly on (x,y). Like draw-image it returns nothing and needs (set-mode 'sd) first, because it paints onto the live 320x240 canvas. Center anchoring is what you want whenever an object's POSITION means the middle of it: a ball at its center, a planet at its orbit point, a character at its feet-or-belly, a mandala at the screen middle. It saves you the constant 'subtract half the width and half the height' arithmetic that top-left draw-image forces when you think in centers. Reach for draw-image/center for physics-driven and symmetric objects; reach for draw-image when you think in corners (HUD, tiles, edges)."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(set-mode 'sd) (draw-image/center (img/circle 12 'solid 8) 160 120)" :note "Blit a circle centered at (160,120), the middle of the 320x240 screen. It paints and prints nothing — correct for a sink.")
    (:dialect "motoi" :tier "intermediate" :code "(set-mode 'sd)\n(draw-image/center (overlay (img/square 10 'solid 7)\n                            (img/square 20 'outline 6)\n                            (img/square 30 'outline 5))\n                   80 80)" :note "Center a composed nested-square building at (80,80) — draw-image/center lands the composition's middle on the point, so symmetric objects sit exactly where you aim.")
    (:dialect "motoi" :tier "expert" :code "(set-mode 'sd)\n(for-each (lambda (i)\n            (let ((a (* i (/ 6.2832 8))))\n              (draw-image/center (img/circle 4 'solid 12)\n                                 (+ 160 (* 40 (cos a)))\n                                 (+ 120 (* 40 (sin a))))))\n          (iota 8))" :note "Place eight dots on a circle of radius 40 around the screen center by computing each center coordinate from an angle — center anchoring makes the polar placement exact.")
  )
  :caveats ("MUST be preceded by (set-mode 'sd) — it paints to a framebuffer that has to exist first." "The anchor is the CENTER, so the top-left ends up at (x − w/2, y − h/2); mixing it up with draw-image shifts the image by half its size." "Returns undefined and prints nothing — an empty result is success for this sink." "For odd widths the center is between pixels and rounds; a one-pixel offset on tiny images is expected, not a bug.")
  :drawbacks ("No return value, so it is a statement and cannot be chained as an expression." "Off-screen centers clip silently — a bad coordinate looks like a missing object, not an error." "Immediate commit to pixels; undo means repaint. Compose purely, then blit last.")
  :usecases ("Placing physics-driven objects whose position is their center (balls, planets, particles)." "Centering symmetric compositions (mandalas, targets, buildings) on a point." "Polar and radial placement where each object's center is computed from an angle." "Any time the coordinate you have is the middle of the thing, not its corner.")
  :related ("draw-image" "place-image" "set-mode" "overlay" "rotate")
  :learn (:concept "Framebuffer blit at a center anchor: the centered sink, top-left = (x−w/2, y−h/2), SD-mode required." :prerequisites ("set-mode" "draw-image") :progression "Learn draw-image/center alongside draw-image as the center-vs-corner pair; use it for position-is-center objects, and place-image when composing onto a scene value instead of the live canvas.")
  :row-2-audit (
    (:problem "A physics sim tracks a ball by its center coordinate and, each frame, must draw the ball where its center is. Using a top-left blit would force subtracting the radius every frame and would drift if the radius changed; they want to draw at the center directly."
     :program "(set-mode 'sd)\n(define cx 160) (define cy 90)\n(draw-image/center (img/circle 10 'solid 12) cx cy)"
     :eng-program "(define (draw-ball ball cx cy) (draw-image/center ball cx cy))\n(set-mode 'sd)\n(draw-ball (img/circle 10 'solid 12) 160 90)"
     :math-program "(set-mode 'sd)\n;; center anchor: top-left is (x - w/2, y - h/2).\n(define ball (img/circle 10 'solid 12))\n(draw-image/center ball 160 90)\n(list 'center (list 160 90)\n      'top-left (list (- 160 (quotient (image-width ball) 2))\n                      (- 90 (quotient (image-height ball) 2))))"
     :cs-program "(define (draw-center-checked img x y)\n  (if (and (image? img) (number? x) (number? y)) (draw-image/center img x y)\n      (error 'draw-image/center \"needs an image and numeric x y\")))\n(set-mode 'sd)\n(draw-center-checked (img/circle 10 'solid 12) 160 90)"
     :explanation "eng: a draw-ball helper that draws at the tracked center. math: derive the implied top-left (x−w/2, y−h/2) from the center. cs: guard the image and coordinate types before blitting."
     :meta "draw-image would anchor the ball's top-left at the center coordinate, so the ball would sit down-and-right of where the sim thinks it is, and every frame you would hand-subtract the radius. place-image composes onto a scene value and never reaches the live screen. draw-image/center is the one sink that treats the coordinate as the object's center, which is exactly how a physics sim stores position.")
    (:eng "The audit lens is 'position-is-center, and set-mode ran first' — the operator smoke test is that the object's middle lands on the tracked coordinate with no half-width fudge, and nothing drew before the framebuffer existed." :math "draw-image/center maps the image's center to screen (x,y); the top-left falls at (x−w/2, y−h/2)." :cs "Center-anchored blit; O(w·h) writes, no return, computes the corner offset internally so the caller does not."))
  :row-3-dimension (
    (:setup "Place a value by its center reference rather than its corner, so the position names the middle of the thing."
     :rungs (
       (:domain "image" :code "(begin (set-mode 'sd) (draw-image/center (img/circle 8 'solid 12) 160 120))")
       (:domain "align-center" :code "(define (center-offset item-w container-w) (quotient (- container-w item-w) 2))\n(center-offset 20 100)")
       (:domain "midpoint" :code "(define (midpoint a b) (/ (+ a b) 2))\n(midpoint 0 320)"))
     :explanation "Rung 1: draw-image/center paints so the image's middle sits on (x,y). Rung 2: center-alignment computes the offset that centers an item in a container. Rung 3: a midpoint is the center between two endpoints. All three share the shape 'reference a thing by its center; the corner/offset is derived by subtracting half the extent'."
     :meta "The transfer works because center-anchoring is corner-minus-half-extent: given a center and a size, the corner is center − size/2. Whether you are blitting an image, centering a widget, or finding a midpoint, the same half-extent subtraction converts between center and corner.")
    (:eng "Every center-reference substrate shares the audit 'center minus half-extent gives the corner' and the failure 'the object shifted by half its size because a corner was used where a center was meant'." :math "An affine shift by −(w/2, h/2) taking a center reference to a corner reference; the two frames differ by half the extent." :cs "Center-based addressing; the same shape as CSS transform-origin center and centering a widget in a box."))
  :row-4-proof (
    (:claim "draw-image/center anchors at the center: its top-left is (x − w/2, y − h/2), a half-extent shift from draw-image — and it paints without error under SD mode."
     :program "(set-mode 'sd)\n(define ball (img/circle 10 'solid 12))\n(draw-image/center ball 160 90)\n(display (= (- 160 (quotient (image-width ball) 2)) 150))"
     :eng-program "(set-mode 'sd)\n(define panel (img/rectangle 40 20 'solid 8))\n(draw-image/center panel 100 60)\n(list 'center (list 100 60)\n      'implied-top-left (list (- 100 (quotient (image-width panel) 2))\n                             (- 60 (quotient (image-height panel) 2))))"
     :math-program "(set-mode 'sd)\n(define i (img/square 20 'solid 8))\n;; center (x,y) ⇔ corner (x - w/2, y - h/2); check the offset is half the size.\n(draw-image/center i 50 50)\n(display (= (quotient (image-width i) 2) 10))"
     :cs-program "(set-mode 'sd)\n(define i (img/square 20 'solid 8))\n(define (corner-of-center x y img)\n  (list (- x (quotient (image-width img) 2)) (- y (quotient (image-height img) 2))))\n(draw-image/center i 60 60)\n(display (equal? (corner-of-center 60 60 i) (list 50 50)))"
     :invariant "∀ img x y (under SD mode). draw-image/center(img,x,y) ≡ draw-image(img, x−w/2, y−h/2)  where w,h = image dimensions"
     :meta "The pattern is that the two sinks differ by exactly a half-extent translation: center-blit is corner-blit shifted by (−w/2,−h/2). Falsified if draw-image/center landed somewhere other than that shift — it would mean 'center' does not mean center, and physics objects would render off their tracked positions. This exact relationship is why you can freely choose whichever anchor matches how you store position.")
    (:eng "The engineering consequence is that a caller who stores positions as centers can blit directly, and a caller who stores corners can too — the two sinks are interconvertible by a half-size shift, so no manual offset is needed." :math "draw-image/center = draw-image ∘ translate(−w/2, −h/2); the anchor choice is an affine change of reference point." :cs "Two anchors related by a fixed offset; the same shape as center-origin vs corner-origin coordinate conventions."))
  :row-5-emergence (
    (:base "draw-image/center blits one image centered on a point."
     :composition "(set-mode 'sd)\n(for-each (lambda (i)\n            (let ((a (* i (/ 6.2832 6))))\n              (draw-image/center (img/rectangle 3 20 'solid 15)\n                                 (+ 160 (* 30 (cos a)))\n                                 (+ 120 (* 30 (sin a))))))\n          (iota 6))"
     :eng-composition "(define (orbit-blit sprite cx cy radius n)\n  (set-mode 'sd)\n  (for-each (lambda (i)\n              (let ((a (* i (/ 6.2832 n))))\n                (draw-image/center sprite (+ cx (* radius (cos a))) (+ cy (* radius (sin a))))))\n            (iota n)))\n(orbit-blit (img/circle 4 'solid 12) 160 120 50 8)"
     :math-composition "(define (polar-points cx cy r n)\n  (map (lambda (i) (let ((a (* i (/ 6.2832 n))))\n                     (list (+ cx (* r (cos a))) (+ cy (* r (sin a))))))\n       (iota n)))\n(set-mode 'sd)\n(for-each (lambda (p) (draw-image/center (img/circle 3 'solid 15) (car p) (cadr p)))\n          (polar-points 160 120 40 6))"
     :cs-composition "(define (scatter-centers sprite coords)\n  (set-mode 'sd)\n  (for-each (lambda (xy) (draw-image/center sprite (car xy) (cadr xy))) coords))\n(scatter-centers (img/circle 3 'solid 12) (list (list 80 60) (list 160 60) (list 240 60)))"
     :emergent "A radial arrangement: sprites centered on points computed around a circle. Six bars around a hub make a wheel or clock face; eight dots on a ring make an orbit; particles centered at physics positions make a whole system. This is polar/particle placement — the same center-on-a-point blit that draws orbits, radial menus, clock faces, and particle systems."
     :meta "This is the radial / particle-placement family — objects centered on computed points, usually around a circle or at simulation positions. It generalizes to orbits, radial menus, clock hands, and particle emitters. It composes because draw-image/center anchors at the center (Row 4), so a polar coordinate (cx+r·cos θ, cy+r·sin θ) drops the sprite's middle exactly on the ring with no offset arithmetic.")
    (:eng "The audit lens is 'the center coordinate is the polar point, no offset' — an operator debugging a lopsided orbit checks the (cx+r·cosθ, cy+r·sinθ) formula directly, since center-anchoring needs no half-size correction." :math "The arrangement is the image of the angle set {2πk/n} under (cx+r·cosθ, cy+r·sinθ), each point a sprite center." :cs "Polar / particle placement; the shape of every orbit renderer, radial menu, and particle system that positions by center."))
)
