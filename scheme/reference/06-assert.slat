;;; 06-assert.slat — Motoi Scheme Reference · Chapter 06 · library assert
;;;
;;; 3 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

;;;
;;; ─── THE ROW RULES (summary — full doctrine in 00-intro.slat) ───
;;;
;;; Every verb in this chapter has 5 rows. Each row does ONE job. Row
;;; contamination unbalances training data. If you author or edit a verb,
;;; STAY IN LANE.
;;;
;;;   Row 1 (HOW · Composition) — the verb written well; 1/3/5 module ladder
;;;   Row 2 (WHEN · Audit)      — operator's problem + this-verb-not-a-sibling
;;;   Row 3 (WHERE ELSE · Dim)  — same shape in 3 substrates (verb/metaphor/math)
;;;   Row 4 (WHY · Proof)       — claim + runnable test + ∀-invariant
;;;   Row 5 (WITH WHAT ELSE)    — chained verbs → named emergent pattern
;;;
;;; Every row carries the three-discipline lens: :eng · :math · :cs.
;;; No philosopher names in entries (they live in 00-intro.slat).
;;; Real Motoi domains only (no card/*, shop/*, cine/*, flower/*).
;;; Every code block RUNS through ./bin/motoi (or is marked :runs "spec-only").
;;;

(dialect :applies ("motoi") :note "Library assert — 3 verbs.")

(chapter :number "06" :library "assert" :verb-count 3 :training-eligible #t)

(verb :name "assert/check-with" :std "Motoi" :library "assert" :tier "core" :kind "pure" :signature "(assert/check-with pred value msg) -> value"
  :summary "Predicate assertion; raises assertion-failed on falsy; returns value on pass."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(assert/check-with positive? 5 \"must be positive\")" :note "Passes → 5.")
    (:dialect "motoi" :tier "intermediate" :code "(define x 42)\n(let ((n (assert/check-with number? x \"n must be a number\"))) (* n 2))" :note "Chain assertion inside expressions.")
    (:dialect "motoi" :tier "expert"       :code "(define (guarded-scale factor v) (vector-map (lambda (x) (* (assert/check-with number? factor \"factor?\") x)) (assert/check-with vector? v \"vec?\")))\n(guarded-scale 2 (vector 1 2))" :note "Multiple guards inline."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (dose-check d) (assert/check-with (lambda (x) (< x 100)) d \"dose too high\"))\n(dose-check 42)"
     :math-program "(define (identity-witness v) (equal? v (assert/check-with (lambda (x) #t) v \"always\")))\n(identity-witness 42)"
     :cs-program "(define (safe-assert pred v msg) (if (procedure? pred) (assert/check-with pred v msg) (error 'need-predicate)))\n(safe-assert positive? 5 \"pos\")"
     :problem "Guard values inline without breaking expression flow."
     :explanation "eng: dose guard. math: identity-through-pass. cs: type-guarded assertion."
     :meta "Reach for assert/check-with and NOT bare if: check-with returns value on pass so expressions chain.")
    (:eng "One line, one guard, one failure signal." :math "Identity on pass; error on fail." :cs "Chainable predicate check."))
  :row-3-dimension (
    (:setup "Predicate-guarded value pass-through."
     :rungs (
       (:domain "engineering"  :code "(assert/check-with positive? 5 \"pos\")")
       (:domain "mathematics"  :code "(assert/check-with number? 3.14 \"in-domain\")")
       (:domain "cs / dispatch" :code "(assert/check-with string? \"hello\" \"json?\")"))
     :explanation "Domain constraint, algebraic membership, message-shape."
     :meta "Pipeline guard.")
    (:eng "Fail fast, fail loud." :math "Domain predicate at boundary." :cs "Contract-style precondition."))
  :row-4-proof (
    (:eng-program "(define (roundtrip? v) (equal? v (assert/check-with (lambda (x) #t) v \"tt\")))\n(roundtrip? 42)"
     :math-program "(define (identity-on-pass? v) (eq? v (assert/check-with (lambda (x) #t) v \"tt\")))\n(identity-on-pass? 'x)"
     :cs-program "(define (raises-on-fail?) (guard (e (#t #t)) (assert/check-with (lambda (x) #f) 42 \"nope\") #f))\n(raises-on-fail?)"
     :claim "Passes return the value unchanged; fails raise assertion-failed."
     :invariant "∀ pred v. pred(v) ⇒ check-with(pred, v, msg) = v ; ¬pred(v) ⇒ raises assertion-failed"
     :meta "Pattern: guarded identity.")
    (:eng "Value survives the guard on success." :math "Partial identity function." :cs "Precondition contract."))
  :row-5-emergence (
    (:eng-composition "(define (chain-guards v) (assert/check-with positive? (assert/check-with number? v \"num\") \"pos\"))\n(chain-guards 5)"
     :math-composition "(define (all-hold preds v) (fold (lambda (p acc) (assert/check-with p acc \"g\")) v preds))\n(all-hold (list number? positive?) 5)"
     :cs-composition "(define (pipeline v) (assert/check-with positive? (assert/check-with number? v \"n\") \"p\"))\n(pipeline 5)"
     :base "assert/check-with is a guarded pass-through."
     :emergent "Compositions: eng nested guards, math fold-of-predicates, cs pipeline."
     :meta "Family: contract pipeline.")
    (:eng "Chained guards form a contract." :math "Intersection of predicate domains." :cs "Precondition pipeline."))
)

(verb :name "assert/invariants" :std "Motoi" :library "assert" :tier "core" :kind "pure" :signature "(assert/invariants (list (thunk msg) ...)) -> #t"
  :summary "Batch invariant checks; collects ALL failures before raising invariants-failed."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(assert/invariants (list (list (lambda () (> 5 0)) \"positive\")))" :note "Single invariant.")
    (:dialect "motoi" :tier "intermediate" :code "(define x 50)\n(assert/invariants (list (list (lambda () (positive? x)) \"pos\") (list (lambda () (< x 100)) \"bounded\")))" :note "Two invariants.")
    (:dialect "motoi" :tier "expert"       :code "(define (validate-config c) (assert/invariants (list (list (lambda () (assoc :name c)) \":name\") (list (lambda () (assoc :port c)) \":port\"))))\n(validate-config (list (cons :name 'x) (cons :port 80)))" :note "Config validation with named fields."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(assert/invariants (list (list (lambda () (positive? 5)) \"pos\") (list (lambda () (< 5 100)) \"bound\")))"
     :math-program "(define (batch-check ps) (assert/invariants (map (lambda (p) (list p \"chk\")) ps)))\n(batch-check (list (lambda () #t) (lambda () #t)))"
     :cs-program "(define (safe-invariants ps) (if (list? ps) (assert/invariants ps) (error 'need-list)))\n(safe-invariants (list (list (lambda () #t) \"x\")))"
     :problem "Config has many invariants; first-fail loses all subsequent failure info."
     :explanation "eng: batch check. math: conjunction of predicates. cs: type-guarded call."
     :meta "Reach for assert/invariants and NOT sequential check-with: sequential stops at first fail; invariants reports all.")
    (:eng "One error message lists every violation." :math "Conjunction reported honestly." :cs "All-at-once fail-collect."))
  :row-3-dimension (
    (:setup "Batch predicate check with all-fail accumulation."
     :rungs (
       (:domain "engineering"  :code "(define (collects-all?) (guard (e (#t #t)) (assert/invariants (list (list (lambda () #f) \"a\") (list (lambda () #f) \"b\"))) #f))\n(collects-all?)")
       (:domain "mathematics"  :code "(define (collects-all?) (guard (e (#t #t)) (assert/invariants (list (list (lambda () #f) \"a\") (list (lambda () #f) \"b\"))) #f))\n(collects-all?)")
       (:domain "cs / dispatch" :code "(define (collects-all?) (guard (e (#t #t)) (assert/invariants (list (list (lambda () #f) \"a\") (list (lambda () #f) \"b\"))) #f))\n(collects-all?)"))
     :explanation "Config-shape, algebraic, schema-driven."
     :meta "Conjunction with full reporting.")
    (:eng "One trip, full report." :math "Conjunction fold." :cs "JSON schema validator pattern."))
  :row-4-proof (
    (:eng-program "(define (all-hold? ps) (assert/invariants (map (lambda (p) (list p \"h\")) ps)))\n(all-hold? (list (lambda () #t) (lambda () #t)))"
     :math-program "(define (collects-all?) (guard (e (#t #t)) (assert/invariants (list (list (lambda () #f) \"a\") (list (lambda () #f) \"b\"))) #f))\n(collects-all?)"
     :cs-program "(define (empty-ok?) (equal? #t (assert/invariants '())))\n(empty-ok?)"
     :claim "All-pass → #t; any fail → raises with all-fail list; empty → #t (vacuous truth)."
     :invariant "∀ list-of-(thunk,msg). all-pass ⇒ #t ; any-fail ⇒ raises with all-fails collected"
     :meta "Pattern: batch conjunction with total reporting.")
    (:eng "Test reports show every failure." :math "Vacuous truth on empty conjunction." :cs "Fail-collect vs fail-fast."))
  :row-5-emergence (
    (:eng-composition "(define (checked-scale c v) (assert/invariants (list (list (lambda () (positive? c)) \"pos-c\") (list (lambda () (vector? v)) \"vec-v\"))) (* c (vector-ref v 0)))\n(checked-scale 2 (vector 3 4))"
     :math-composition "(define (compose-preds ps) (assert/invariants (map (lambda (p) (list p \"chk\")) ps)))\n(compose-preds (list (lambda () #t) (lambda () #t)))"
     :cs-composition "(define (schema-guard v checks) (assert/invariants checks) v)\n(schema-guard 42 (list (list (lambda () #t) \"ok\")))"
     :base "assert/invariants collects all failures."
     :emergent "Compositions: eng precondition block, math predicate fold, cs schema guard."
     :meta "Family: batch validation.")
    (:eng "Precondition block reports every violation once." :math "Fold of predicates into single truth report." :cs "Schema validator with total reporting."))
)

(verb :name "assert/audit-verify" :std "Motoi" :library "assert" :tier "core" :kind "pure" :signature "(assert/audit-verify value spec) -> #t"
  :summary "Deep structural match; raises audit-failed with failure path on mismatch."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(assert/audit-verify 42 'number)" :note "Simple type audit.")
    (:dialect "motoi" :tier "intermediate" :code "(assert/audit-verify (list 1 2) '(list-of number))" :note "List shape audit.")
    (:dialect "motoi" :tier "expert"       :code "(define (audit-record r)\n  (assert/audit-verify r (list (list ':name 'string) (list ':age 'number))))\n(audit-record (list (list ':name \"a\") (list ':age 30)))" :note "Record-shape audit for deep validation."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(assert/audit-verify (list 1 2 3) '(list-of number))"
     :math-program "(assert/audit-verify 42 'number)"
     :cs-program "(define (safe-audit v spec) (if (or (symbol? spec) (list? spec)) (assert/audit-verify v spec) (error 'bad-spec)))\n(safe-audit 42 'number)"
     :problem "Deeply-nested data — need path pointing to the mismatched offender."
     :explanation "eng: deep audit. math: canonicalized spec. cs: type-guarded audit."
     :meta "Reach for assert/audit-verify and NOT flat check-with: check-with matches one value; audit-verify recurses.")
    (:eng "Failure path pinpoints the offender." :math "Recursive structural match." :cs "Deep validation pattern."))
  :row-3-dimension (
    (:setup "Deep structural equality vs a spec."
     :rungs (
       (:domain "engineering"  :code "(equal? #t (assert/audit-verify 42 'number))")
       (:domain "mathematics"  :code "(equal? #t (assert/audit-verify 42 'number))")
       (:domain "cs / dispatch" :code "(equal? #t (assert/audit-verify 42 'number))"))
     :explanation "Direct, canonicalized, schema-driven."
     :meta "Structural equality against expected shape.")
    (:eng "Deep validation with failure path." :math "Recursive predicate on structure." :cs "JSON-Schema / Protobuf validate."))
  :row-4-proof (
    (:eng-program "(assert/audit-verify 42 'number)"
     :math-program "(equal? #t (assert/audit-verify 42 'number))"
     :cs-program "(define (raises-with-path?) (guard (e (#t #t)) (assert/audit-verify (list 1 'x) '(list-of number)) #f))\n(raises-with-path?)"
     :claim "Match → #t; mismatch → raises audit-failed carrying the path."
     :invariant "∀ v spec. match(v,spec) ⇒ #t ; ¬match(v,spec) ⇒ raises audit-failed with :path"
     :meta "Pattern: deep-structural-match with path.")
    (:eng "Failure path reduces debug time to seconds." :math "Recursive predicate." :cs "Path-carrying validation error."))
  :row-5-emergence (
    (:eng-composition "(define (audit-then-process v spec proc) (assert/audit-verify v spec) (proc v))\n(audit-then-process 42 'number (lambda (x) (* x 2)))"
     :math-composition "(define (spec-pipeline v specs) (fold (lambda (s acc) (assert/audit-verify acc s) acc) v specs))\n(spec-pipeline 42 (list 'number))"
     :cs-composition "(define (contract-in name spec fn) (lambda (v) (assert/audit-verify v spec) (fn v)))\n((contract-in 'x 'number (lambda (v) (* v 2))) 42)"
     :base "assert/audit-verify is a deep structural check."
     :emergent "Compositions: eng audit-then-process, math spec-pipeline fold, cs contract wrapper."
     :meta "Family: contract-in / precondition pipeline.")
    (:eng "Validate at boundary; trust internally." :math "Fold of specs → identity on all-pass." :cs "Same slot as Racket contract-out."))
)
