;;; SCHEMA.slat — Motoi Scheme Reference · error-cards · the card format
;;;
;;; An ERROR CARD is the counterpart to a broken-example. A broken-example
;;; teaches ONE program that does not run and its fix. An error card teaches
;;; ONE KIND of failure — a whole coordinate in the error census — grounded in
;;; the actual runtime behaviour of Motoi, not in a brochure of what a Scheme
;;; "should" do.
;;;
;;; The organizing key is the CENSUS NORMALIZED-KEY: the stable, low-cardinality
;;; string that `normalizeError` (lib/system/verb-stats.js) maps a thrown thing
;;; to. That key is the coordinate `stats/error-count-of` counts against. One
;;; card per key. The card's filename is the key with `:` replaced by `-`
;;;   unbound-symbol          -> unbound-symbol.slatl
;;;   class:ErrorObject       -> class-ErrorObject.slatl
;;;   verb:hash/ref:key       -> verb-hash-ref-key.slatl   (per-verb, rare)
;;;
;;; This is the WRONG SINK made legible. The census tells you a wrong happened
;;; and how often; the card tells you what that wrong MEANS, how to recognize it
;;; at a verb, how to detect it in code, and what the honest fix is. Cards feed
;;; the runtime RAG signal (retrieve by key on throw; steer away on suggest) and
;;; they are training-eligible teaching for the model that reads this reference.
;;;
;;; HONESTY RULE (hard): every :trigger-code must ACTUALLY produce the
;;; :observed-output shown, verified via
;;;   echo '<trigger-code>' | ./bin/motoi run /dev/stdin
;;; and the :normalizes-to must be the key the live census actually records
;;; (verify by running the trigger with MOTOI_STATS_PATH set to a temp file and
;;; reading `stats/error-counts`). No aspirational output. No fabricated key.
;;; If a roster family exists in the normalizer but Motoi does not currently
;;; throw it, the card says so plainly with :census-status "roster-only-not-observed".

(dialect :applies ("motoi") :note "error-card schema — one card per census normalized-key")

(error-card-schema
  :doc "scheme/reference/error-cards"
  :section "schema"
  :audience ("motoi-model" "language-engineer" "sre" "learner")
  :dialect "motoi"
  :provenance "scheme/reference/error-cards/SCHEMA.slat"
  :training-eligible #t
  :confidentiality "public"

  ;; ─── REQUIRED FIELDS ───
  :required (
    (:field :key
      :type "string"
      :doc "The census normalized-key this card is about. EXACTLY the string
`normalizeError` returns and `stats/error-count-of` counts. e.g. \"unbound-symbol\",
\"not-a-procedure\", \"fuel-exhausted\", \"class:ErrorObject\", \"misc-uncategorized\".")

    (:field :name
      :type "string"
      :doc "Short human title. e.g. \"Unbound symbol\".")

    (:field :family
      :type "enum"
      :one-of ("language" "leaky-host" "reader-time" "expand-time" "sandbox" "silent-non-error")
      :doc "Where in the stack the failure originates.
  language          — a real Motoi language error thrown from eval (clean).
  leaky-host        — a raw JS/host error that escaped the engine's guard
                      (message reads like host internals, e.g. \"a.slice is not
                      a function\"). Instructive because it may collide with a
                      language family key.
  reader-time       — thrown while READING source (unbalanced parens, EOF,
                      unterminated string). Fires BEFORE the eval boundary.
  expand-time       — thrown while EXPANDING macros (recursive macro). Fires
                      BEFORE the eval boundary.
  sandbox           — a policy/limit refusal (frozen sandbox, program too big).
  silent-non-error  — NOT an error at all: Motoi returns a wrong-ish value
                      (Infinity, +nan.0, silent coercion, dropped args). The
                      most dangerous class because nothing is thrown.")

    (:field :census-status
      :type "enum"
      :one-of ("counted-real" "counted-via-collision" "roster-only-not-observed"
               "expand-time-uncounted" "reader-time-uncounted" "silent-non-error-uncounted")
      :doc "The honest relationship between this failure and the run-boundary census.
  counted-real            — escapes at eval boundary; census records it under :key.
  counted-via-collision   — escapes and IS counted, but under a DIFFERENT key than
                            its true nature (e.g. a leaky TypeError whose message
                            contains \"not a function\" is recorded as
                            not-a-procedure). Card documents the collision.
  roster-only-not-observed— :key exists in the normalizer's family roster, but
                            Motoi does not currently throw a message that matches
                            it; the coordinate is reserved, not yet seen.
  *-uncounted             — the failure is real but fires BEFORE the eval boundary
                            (reader/expand) or is not an error at all (silent), so
                            the census never sees it.")

    (:field :trigger-code
      :type "string"
      :doc "A minimal program that produces the observed behaviour. MUST run and
MUST reproduce :observed-output verbatim.")

    (:field :observed-output
      :type "string"
      :doc "The exact bytes Motoi prints for :trigger-code (stdout+stderr), verbatim.")

    (:field :normalizes-to
      :type "string"
      :doc "The census key the live census ACTUALLY records for :trigger-code
(may differ from :key when :census-status is counted-via-collision, or be
\"(uncounted)\" when the failure never reaches the boundary).")

    (:field :meaning
      :type "string"
      :doc "What this failure MEANS — plain, honest, one to three paragraphs.")

    (:field :fix-shape
      :type "string"
      :doc "The shape of the fix (not necessarily one line — the class of repair).")

    (:field :lesson
      :type "string"
      :doc "The transferable lesson. Why this happens, what to internalize.")
  )

  ;; ─── OPTIONAL FIELDS (strongly encouraged) ───
  :optional (
    (:field :scheme-classification :type "string"
      :doc "How R7RS / the tradition would name this (e.g. \"unbound variable\",
\"error object from (error ...)\"). Anchors the reader's prior knowledge.")
    (:field :common-causes :type "list-of-string"
      :doc "The everyday coding mistakes that land here.")
    (:field :how-to-detect :type "string"
      :doc "A runnable `guard`/`safe-call` pattern that catches or reveals it in code.")
    (:field :at-the-verb :type "string"
      :doc "How this shows up at a specific verb — the per-verb face of the key.")
    (:field :related-broken-examples :type "list-of-string"
      :doc "Filenames in ../broken-examples/ that instantiate this key.")
    (:field :related-cards :type "list-of-string"
      :doc "Other error-card keys worth reading alongside this one.")
    (:field :census-verbs :type "list-of-string"
      :doc "The introspection calls that observe this key at runtime, e.g.
\"(stats/error-count-of \\\"unbound-symbol\\\")\".")
    (:field :status :type "enum" :one-of ("real" "provisional" "needs-alfred")
      :doc "Card maturity. provisional = minted by the script, not yet hand-authored.
needs-alfred = a decision or fact is missing and must not be fabricated.")
  ))

;;; ─── PRODUCTION ─────────────────────────────────────────────────────────
;;; New cards are born two ways:
;;;   1. HAND-AUTHORED for instructive keys (this directory's real cards).
;;;   2. MINTED by scripts/mint-error-cards.mjs, which reads the live census
;;;      (~/.motoi/stats.slat) + the static family roster in verb-stats.js,
;;;      cross-references existing card files, and scaffolds a :status
;;;      "provisional" stub for any key that has no card yet. A human then
;;;      fills the stub and flips it to :status "real". This is "the system for
;;;      the production of more" — the census surfaces a new wrong, the mint
;;;      makes a place to teach it, a person (or the model) authors the teaching.

(error-card-production
  :from-census "~/.motoi/stats.slat  (override MOTOI_STATS_PATH)"
  :from-roster "lib/system/verb-stats.js  _ERR_FAMILIES + normalizeError"
  :mint-script "scheme/reference/error-cards/scripts/mint-error-cards.mjs"
  :promote-rule "provisional -> real when a human authors :meaning/:fix-shape/:lesson"
  :provenance "scheme/reference/error-cards/SCHEMA.slat")
