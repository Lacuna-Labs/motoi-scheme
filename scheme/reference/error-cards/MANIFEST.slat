;;; MANIFEST.slat — Motoi Scheme Reference · error-cards · machine index
;;;
;;; The machine-readable index of this folder-book (per spec/BOOK-LAYOUT.slat).
;;; One row per card. Programs read THIS for structure; humans + LLMs read
;;; README.slatl. The two must agree — same cards, same order.
;;;
;;; Each row: the census normalized-key the card teaches, its file, the family
;;; it originates in, its honest relationship to the run-boundary census, and
;;; whether the card's :trigger-code was verified live via
;;;   echo '<trigger-code>' | ./bin/motoi run /dev/stdin
;;; The `:verified` flag is the HONESTY RULE made checkable — no card ships at
;;; :status "real" without it.

(dialect :applies ("motoi") :note "machine index for the error-cards folder-book")

(manifest
  :name "motoi-error-cards"
  :title "Motoi Scheme — Error Cards"
  :book-kind "error-card-catalogue"
  :schema "SCHEMA.slat"
  :roster-source "lib/system/verb-stats.js (_ERR_FAMILIES + normalizeError)"
  :census-source "~/.motoi/stats.slat (override MOTOI_STATS_PATH)"
  :mint-script "scripts/mint-error-cards.mjs"
  :card-count 10
  :training-eligible #t
  :confidentiality "public"

  ;; ─── The cards ───────────────────────────────────────────────
  :cards (
    (:key "unbound-symbol"    :file "unbound-symbol.slatl"
     :family "language"        :census-status "counted-real"
     :status "real" :verified #t
     :one-line "A name evaluated with no binding — the clean, common language error.")

    (:key "not-a-procedure"   :file "not-a-procedure.slatl"
     :family "leaky-host"      :census-status "counted-via-collision"
     :status "real" :verified #t
     :one-line "Applying a non-procedure — AND the sink where leaky host TypeErrors collide.")

    (:key "fuel-exhausted"    :file "fuel-exhausted.slatl"
     :family "language"        :census-status "counted-real"
     :status "real" :verified #t
     :one-line "The fuel budget ran out — an UNCATCHABLE error (guard has no fuel to run).")

    (:key "class:ErrorObject" :file "class-ErrorObject.slatl"
     :family "language"        :census-status "counted-real"
     :status "real" :verified #t
     :one-line "A user (error \"...\" irritant ...) that escaped — the R7RS error object.")

    (:key "class:RaisedValue" :file "class-RaisedValue.slatl"
     :family "language"        :census-status "counted-real"
     :status "real" :verified #t
     :one-line "A user (raise obj) of a non-error value that escaped — control signal that got away.")

    (:key "class:TypeError"   :file "class-TypeError.slatl"
     :family "leaky-host"      :census-status "counted-real"
     :status "real" :verified #t
     :one-line "The OTHER leaky-host outcome — a host TypeError whose message isn't 'not a function', so it lands here not in not-a-procedure.")

    (:key "misc-uncategorized" :file "misc-uncategorized.slatl"
     :family "language"        :census-status "counted-real"
     :status "real" :verified #t
     :one-line "The normalizer's floor — real errors whose message matches no family + has no verb slash.")

    (:key "silent-non-error"  :file "silent-non-errors.slatl"
     :family "silent-non-error" :census-status "silent-non-error-uncounted"
     :status "real" :verified #t
     :one-line "The blind spot: a wrong VALUE is returned, nothing thrown, census never sees it.")

    (:key "expand-and-reader-time" :file "expand-and-reader-time.slatl"
     :family "reader-time"     :census-status "reader-time-uncounted"
     :status "real" :verified #t
     :one-line "Real reader/expand errors that fire BEFORE the eval boundary — uncounted upstream.")

    (:key "roster-not-observed" :file "roster-not-observed.slatl"
     :family "language"        :census-status "roster-only-not-observed"
     :status "real" :verified #t
     :one-line "Seven roster keys the normalizer reserves but Motoi never throws today — the drawn-not-visited map.")
  )

  ;; ─── Roster coverage ledger ──────────────────────────────────
  ;; The 14 family keys in _ERR_FAMILIES, and which card covers each. Keeps the
  ;; catalogue honest about what is taught vs. merely reserved.
  :roster-coverage (
    (:key "unbound-symbol"             :covered-by "unbound-symbol.slatl"        :observed #t)
    (:key "macro-fuel-exhausted"       :covered-by "expand-and-reader-time.slatl" :observed #t :note "expand-time, uncounted")
    (:key "fuel-exhausted"             :covered-by "fuel-exhausted.slatl"        :observed #t)
    (:key "program-too-big"            :covered-by "roster-not-observed.slatl"   :observed #f)
    (:key "frozen-sandbox"             :covered-by "roster-not-observed.slatl"   :observed #f)
    (:key "unquote-splicing-misplaced" :covered-by "roster-not-observed.slatl"   :observed #f)
    (:key "not-a-procedure"            :covered-by "not-a-procedure.slatl"       :observed #t)
    (:key "wrong-arity"                :covered-by "roster-not-observed.slatl"   :observed #f :note "silent — arity unchecked")
    (:key "not-a-pair"                 :covered-by "roster-not-observed.slatl"   :observed #f :note "silent — car of non-pair")
    (:key "division-by-zero"           :covered-by "roster-not-observed.slatl"   :observed #f :note "silent — yields +inf.0")
    (:key "unexpected-eof"             :covered-by "expand-and-reader-time.slatl" :observed #t :note "reader-time, uncounted")
    (:key "unexpected-close-paren"     :covered-by "expand-and-reader-time.slatl" :observed #t :note "reader-time, uncounted")
    (:key "unterminated-string"        :covered-by "expand-and-reader-time.slatl" :observed #t :note "reader-time, uncounted")
    (:key "index-out-of-range"         :covered-by "roster-not-observed.slatl"   :observed #f :note "silent — oob read returns nothing")
  ))
