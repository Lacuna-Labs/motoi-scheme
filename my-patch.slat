(composer/canvas (:bind (quote (synth))) (composer/slider :label "Attack" :bind (quote (synth :env :a)) :min 0 :max 2 :step 0.01 :value 0.01) (composer/slider :label "Decay" :bind (quote (synth :env :d)) :min 0 :max 2 :step 0.01 :value 0.1) (composer/slider :label "Sustain" :bind (quote (synth :env :s)) :min 0 :max 1 :step 0.01 :value 0.7) (composer/slider :label "Release" :bind (quote (synth :env :r)) :min 0 :max 4 :step 0.01 :value 0.5))
