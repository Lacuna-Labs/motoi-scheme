#!/usr/bin/env node
// motoi CLI shebang stub.
// Dispatches to src/cli.js. Node ≥ 20.16 required.

import { main } from '../src/cli.js'
import { basename } from 'node:path'

// Two binaries land on PATH — 'motoi' (the fantasy console tool) and
// 'motoi-scheme' (the language REPL). We pass the invocation name to
// main() so it can pick the right default when no subcommand is given.
const invokedAs = basename(process.argv[1] || 'motoi')

// `process.exit` discards whatever is still sitting in the stdout buffer.
// When stdout is a pipe that buffer is 64 KB, so `motoi docs | less` printed
// the first 65,536 bytes of a 148,645-byte manual and stopped mid-sentence —
// with exit code 0, so nothing said it had been cut. Wait for the drain, then
// exit. A closed pipe (EPIPE, e.g. `motoi docs | head`) is normal, not an error.
function flushStdout () {
  if (process.stdout.writableLength === 0) return Promise.resolve()
  return new Promise((resolve) => {
    process.stdout.once('error', resolve)
    process.stdout.write('', resolve)
  })
}

main(process.argv.slice(2), { invokedAs })
  .then(async (code) => { await flushStdout(); process.exit(code ?? 0) })
  .catch((err) => {
    process.stderr.write(`motoi: ${err.stack || err.message}\n`)
    process.exit(1)
  })
