;; the model router (lacuna.model-router, D7: through 1.0 as Ollama's front for the small minds): loopback 11434
(launch (program "/usr/bin/python3") (args "~/code/lacuna/lacuna-box/brain/gateway.py") (keep-alive #t) (throttle-s 5)
        (log "~/.lacuna/logs/brain-gateway.log") (env (@ ("BRAIN_ENGINE" "lme"))))
