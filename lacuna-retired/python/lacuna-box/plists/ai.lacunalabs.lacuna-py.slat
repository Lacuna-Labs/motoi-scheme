;; the legacy API (lacuna.legacy-api, retiring route by route: docs/eng/PYTHON-RETIREMENT-1.0.md): loopback 1137
(launch (program "~/code/lacuna/.venv/bin/python") (args "-m" "uvicorn" "lacuna_api.app:app" "--host" "127.0.0.1" "--port" "1137" "--ws" "websockets")
        (cwd "~/code/lacuna/lacuna-api") (keep-alive #t) (throttle-s 5) (log "~/.lacuna/logs/console-py.log")
        (env (@ ("LANG" "en_US.UTF-8") ("LACUNA_PORT" "1138") ("LACUNA_LAN" "1") ("PATH" "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin")
                ("HOME" "~") ("LACUNA_RAG_WARM" "1"))))
