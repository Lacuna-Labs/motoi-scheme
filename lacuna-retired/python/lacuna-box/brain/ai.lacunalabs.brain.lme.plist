<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THE BRAIN'S PORT, ON THE LME (2026-10-27 cut-over): the engine's front (lacuna-node/models/engine-front.mjs) answers
     :8091 as llama-server did — chat completions, the gateway's fields, /slots save and restore, /health, /slots, /props,
     /metrics, /completion — and speaks slat to the desk's engine (ai.lacunalabs.lme-desk). The label stays the brain's, so
     the gateway, the watchdogs and `lacuna status` read it unchanged. Rollback: lacuna-box/brain/lme-rollback.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>ai.lacunalabs.brain</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/alfred/code/lacuna/lacuna-node/models/engine-front.mjs</string>
		<string>/Users/alfred/.lacuna/lme/desk.sock</string>
		<string>8091</string>
		<string>2</string>
	</array>
	<key>ProcessType</key><string>Interactive</string>
	<key>KeepAlive</key><true/>
	<key>RunAtLoad</key><true/>
	<key>ThrottleInterval</key><integer>5</integer>
	<key>StandardErrorPath</key><string>/Users/alfred/.lacuna/logs/brain.log</string>
	<key>StandardOutPath</key><string>/Users/alfred/.lacuna/logs/brain.log</string>
</dict>
</plist>
