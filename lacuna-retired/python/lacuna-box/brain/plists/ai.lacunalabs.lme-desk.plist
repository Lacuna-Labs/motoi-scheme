<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THE DESK'S ENGINE, ITS RESTART POLICY (lane E1, 2026-10-30; supersedes ../ai.lacunalabs.lme-desk.plist of the 10-27
     cut-over). The program is the launcher, lme-serve.sh, copied beside the versioned binary so a checkout never changes the
     running desk; it waits out the engine's 30 s cadence and refuses a fourth start after three refused loads in 300 s, then
     execs the engine's own command line (the arguments after it). KeepAlive restarts only a failure: a drained engine exits 0
     and stays down for the swap road (switch-brain.sh). ThrottleInterval 30 is at least the cadence (POSTMORTEMS 2026-10-30:
     5 s against 30 s made 139 starts). The swap road edits two things here and nothing else: the argument after `serve` (the
     model) and LME_PROFILE. Install (the lead): cp lacuna-box/brain/lme-serve.sh ~/.lacuna/lme/bin/lme-serve.sh; cp this
     file ~/Library/LaunchAgents/; launchctl bootout gui/$(id -u)/ai.lacunalabs.lme-desk; launchctl bootstrap gui/$(id -u)
     ~/Library/LaunchAgents/ai.lacunalabs.lme-desk.plist (never while the owner's turn runs). Rollback: the previous plist. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>ai.lacunalabs.lme-desk</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/alfred/.lacuna/lme/bin/lme-serve.sh</string>
		<string>/Users/alfred/.lacuna/lme/bin/lme-b5337d4a-nogov-w16</string>
		<string>serve</string>
		<string>/Users/alfred/.ollama/models/blobs/sha256-e8b6a059ba86947a44ace84d6e5679795bc41862c25c30513142588f0e9dba1d</string>
		<string>/Users/alfred/.lacuna/lme/desk.sock</string>
		<string>2</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LME_PROFILE</key><string>desk</string>
		<key>LME_KV_PERSIST</key><string>1</string>
		<key>HOME</key><string>/Users/alfred</string>
	</dict>
	<key>ProcessType</key><string>Interactive</string>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key><false/>
	</dict>
	<key>RunAtLoad</key><true/>
	<key>ThrottleInterval</key><integer>30</integer>
	<key>StandardErrorPath</key><string>/Users/alfred/.lacuna/logs/lme-desk.log</string>
	<key>StandardOutPath</key><string>/Users/alfred/.lacuna/logs/lme-desk.log</string>
</dict>
</plist>
