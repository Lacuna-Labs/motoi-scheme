<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THE DESK'S ENGINE (the LME, 2026-10-27 cut-over; docs/eng/INTEGRATION-NIGHT-2026-10-27.md step 8): the E4B QAT on the
     desk profile (two slots of 32,768), its slots kept across a restart, behind ~/.lacuna/lme/desk.sock (mode 600). The
     binary is a versioned copy (lme-cutover.sh writes it), so a rebuild never changes the running desk. Rollback:
     lacuna-box/brain/lme-rollback.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>ai.lacunalabs.lme-desk</string>
	<key>ProgramArguments</key>
	<array>
		<string>LME_BINARY</string>
		<string>serve</string>
		<string>/Users/alfred/.ollama/models/blobs/sha256-e8b6a059ba86947a44ace84d6e5679795bc41862c25c30513142588f0e9dba1d</string>
		<string>/Users/alfred/.lacuna/lme/desk.sock</string>
		<string>2</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LME_PROFILE</key><string>desk</string>
		<key>LME_KV_PERSIST</key><string>1</string>
		<key>HOME</key><string>/Users/alfred</string>
	</dict>
	<key>ProcessType</key><string>Interactive</string>
	<key>KeepAlive</key><true/>
	<key>RunAtLoad</key><true/>
	<key>ThrottleInterval</key><integer>5</integer>
	<key>StandardErrorPath</key><string>/Users/alfred/.lacuna/logs/lme-desk.log</string>
	<key>StandardOutPath</key><string>/Users/alfred/.lacuna/logs/lme-desk.log</string>
</dict>
</plist>
