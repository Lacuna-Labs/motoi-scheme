<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THE BRAIN GATEWAY (2026-10-18): Ollama's API on :11434 — the brain to llama-server, everything else to Ollama :11435. -->
<plist version="1.0"><dict>
  <key>Label</key><string>ai.lacunalabs.brain-gateway</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string><string>/Users/alfred/code/lacuna/lacuna-box/brain/gateway.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAIN_ENGINE</key><string>lme</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/alfred/.lacuna/logs/brain-gateway.log</string>
  <key>StandardErrorPath</key><string>/Users/alfred/.lacuna/logs/brain-gateway.log</string>
</dict></plist>
