;; LACUNA'S JAIL — the macOS sandbox (Seatbelt) profile Pi and everything it runs live under (2026-10-11).
;;
;; The owner: "it can read things, it can only write to certain places, and it needs to know that." The same mechanism
;; Codex CLI and Claude Code ship on. Later rules win over earlier ones, so each block denies broadly, then opens the
;; few places Lacuna needs. Self-test: ~/.lacuna/jail/jail-test.sh — run it after every macOS update (SBPL is private).
(version 1)
(allow default)

;; ── READS: nothing in the home folder, then only Lacuna's own places ─────────────────────────────────────────────────
(deny file-read* (subpath "/Users/alfred"))
;; names and sizes only, never contents: Node checks every folder on the way to a file (lstat), and Pi would not start
(allow file-read-metadata (subpath "/Users/alfred"))
(allow file-read*
  (literal "/Users/alfred")
  (subpath "/Users/alfred/lacuna-world")            ; its world: workspace, its repos, outbox, mail, journal
  (subpath "/Users/alfred/code/lacuna")             ; its own code and the `lacuna` command — read only (writes below)
  (subpath "/Users/alfred/code/curator")            ; the project it helps build — READ ONLY (the owner: "it needs to know the code base")
  (subpath "/Users/alfred/code/caliper")            ; OUR Caliper, the same one we develop — READ ONLY, never a second copy (2026-10-18)
  (subpath "/Users/alfred/code/sakura-scheme")      ; the language: its grammar (grammar/*.gbnf), its Book, its reader — READ ONLY
  (subpath "/Users/alfred/.pi/agent/bin")           ; the pi launcher
  (subpath "/Users/alfred/.pi/agent/install")       ; Pi's program (your own Pi config and logins stay out)
  (subpath "/Users/alfred/.lacuna/pi-agent")         ; Lacuna's own Pi config: models, router, modes, skills, persona, no keys
  (subpath "/Users/alfred/.local/bin")              ; pi, lacuna-web
  (subpath "/Users/alfred/.lacuna/jail")            ; this profile and the broker's socket
  (subpath "/Users/alfred/.lacuna/models")          ; the Modelfiles
  (literal "/Users/alfred/.lacuna/box.json")        ; the box profile: which brain sits in which seat (2.0 §4)
  (subpath "/Users/alfred/.lacuna/library")         ; offline Wikipedia (Kiwix ZIM files) — read only
  (subpath "/Users/alfred/.local/share/uv")         ; the Wikipedia MCP server's install and its Python
  (literal "/Users/alfred/.gitconfig")
  (subpath "/Users/alfred/.npm")
  (subpath "/Users/alfred/.cache/ms-playwright"))
(deny file-read*
  (literal "/Users/alfred/.pi/agent/auth.json")
  (regex #"/\.env(\.[^/]*)?$"))

;; ── WRITES: its world and temp only; never a git hook, never its own jail or persona ─────────────────────────────────
(deny file-write* (subpath "/Users/alfred"))
(allow file-write*
  (subpath "/Users/alfred/lacuna-world")
  (subpath "/Users/alfred/.lacuna/pi-agent/sessions")
  (literal "/Users/alfred/.lacuna/pi-agent/settings.json")
  (literal "/Users/alfred/.lacuna/pi-agent/models-store.json")
  (literal "/Users/alfred/.lacuna/pi-agent/auth.json")
  (literal "/Users/alfred/.lacuna/pi-agent/mcp-auth.json")   ; remote knowledge servers keep their session here
  (regex #"^/Users/alfred/\.lacuna/pi-agent/[^/]+\.lock(/|$)")   ; Pi locks a file by making <file>.lock beside it
  (subpath "/Users/alfred/.npm"))
(deny file-write*
  (regex #"^/Users/alfred/lacuna-world/repos/[^/]+/\.git/hooks(/|$)")
  (subpath "/Users/alfred/lacuna-world/config"))   ; its config changes go out as patches, in through review

;; ── LOCAL PORTS: Ollama and the painter only. The Curator APIs, QA, the console and every tmux socket are refused ──────────────────
;; (order matters: the tmux deny caught the Ollama connection too when it came after the allow — 2026-10-11)
(deny network-outbound (remote ip "localhost:*"))
(deny network-outbound (subpath "/private/tmp/tmux-501"))
(allow network-outbound (remote ip "localhost:11434"))
(allow network-outbound (remote ip "localhost:8420"))   ; the painter (Flux) — its jobs draw pictures (owner, 2026-10-11)
(allow network-outbound (literal "/Users/alfred/.lacuna/jail/broker.sock"))

;; ── COMMANDS that would step outside: launchd, opening apps, AppleScript, the keychain ───────────────────────────────
(deny process-exec
  (literal "/bin/launchctl")
  (literal "/usr/bin/open")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/security")
  (literal "/usr/bin/sudo"))

;; ── THE OWNER'S PRESS (2026-10-18): only the owner approves. His key, his paired devices and a waiting pairing phrase
;; are never readable or writable from here — the last word in this profile, so no allow above can open them.
(deny file-read* file-write*
  (literal "/Users/alfred/.lacuna/owner-key")
  (literal "/Users/alfred/.lacuna/owner-devices.json")
  (literal "/Users/alfred/.lacuna/owner-pairing.json")
  (regex #"^/Users/alfred/\.lacuna/\.owner-[^/]*\.tmp$"))

;; ── THE BREAK GLASS (work order L6): the owner's stop for everything; never read, written or run from inside the jail.
(deny file-read* file-write* process-exec
  (literal "/Users/alfred/code/lacuna/tools/break-glass.sh")
  (literal "/Users/alfred/.lacuna/break-glass-last.txt"))
