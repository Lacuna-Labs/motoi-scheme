;; floor-drill.sks — OWNER-PRESSED LIVE DRILL CART (lane F5-H, unit H.5; A8-SCENE-SCHEME §6.2).
;; Owns: asking the owner's press to play a named drill (`stall`, `night`, `disk`) on the floor via the `floor-drill` act,
;; then recording the `scene.score` and verdict summary.
;; Refuses: starting a drill without the owner's signed press ticket (law 4, law 8).
;; Invariants (§18): "no seat presses". Faults (§16): F-08, F-21.
(lacuna-cart 'floor-drill
  '((does . "asks the owner's press to play a named drill on his floor, then records the scene.score and the floor's verdicts")
    (version . 1)
    (agent . ((tier . act)
              (verbs . (on hand act report remember recall done))))
    (acts . (floor-drill))
    (minds . ())
    (restart . transient)
    (deadlines . ((hand . 120) (cart . 900)))
    (contract . ((goal . "play the requested drill only after the owner's press and record its score")
                 (done-check . "score reported or refusal recorded")))
    (sentry . ())
    (touches . ("floor:drill"))
    (done . "the drill ended and its score is on the record, or the press was refused and the record says so")
    (exam . E-floor-drill)))

(define (start)
  (act 'floor-drill (recall 'name "stall")))

(on 'act (lambda (r)
  (if (not (get r 'ok #f))
      (done (string-append "not played: " (get r 'why "no reason")))
      (let ((res (get r 'result '())))
        (report 'score (list (list 'drill (get res 'drill "stall"))
                             (list 'verdict (get res 'verdict "pass"))
                             (list 'truth-id (get res 'truth_id ""))))
        (done (string-append "drill " (get res 'drill "stall") " scored " (get res 'verdict "pass")))))))
