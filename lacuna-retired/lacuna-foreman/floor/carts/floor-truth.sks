;; floor-truth.sks — NIGHTLY FLOOR INVARIANT & DETERMINISM CART (lane F5-H, unit H.5; A8-SCENE-SCHEME §6.1).
;; Owns: replaying yesterday's floor day file through the fold and asserting the 10 invariants of A8 §6.1 (no transient longer
;; than ceiling, every red had a record, every green belonged to the foreman, quarantine growth <= 50, every assay producer
;; emitted >= 1 event or is stale, frame p95 within Mac tier budget, 0 scene.* rows on the live day file, determinism across
;; 30/60/120 Hz, no unknown past 3x period without floor.stale, monotone seq hash chain).
;; Refuses: acting on the live box; paging on a truth check failure (a miss is a verdict row + one inbox alert).
;; Invariants (§18): "a claim is not a record". Faults (§16): none.
(lacuna-cart 'floor-truth
  '((does . "replays yesterday's floor day file through the fold in a hands child and asserts the floor's ten invariants; each miss is a verdict row")
    (version . 1)
    (agent . ((tier . watch)
              (verbs . (on hand report remember recall after floor-scene floor-expect done))))
    (minds . ())
    (restart . temporary)
    (deadlines . ((hand . 120) (cart . 900)))
    (contract . ((goal . "every floor invariant checked once over yesterday's day file and sealed on the close row")
                 (done-check . "close row written with determinism hash and pass/fail counts")))
    (sentry . ())
    (touches . ("floor:day-file"))
    (done . "every invariant checked once over yesterday's day file; the close row holds the counts and the hash")
    (exam . E-floor-truth)))

(define (start)
  (floor-scene 'open "day")
  (hand 'floor-fold "yesterday" '(invariants determinism summary)))

(on 'hand (lambda (r)
  (if (not (get r 'ok #f))
      (begin
        (floor-expect "day-read" #f (get r 'why "floor-fold did not answer"))
        (let ((closed (floor-scene 'close)))
          (done (string-append "stopped: " (get r 'why "floor-fold did not answer")))))
      (let ((res (get r 'result '())))
        (floor-expect "transient" (= (get res 'transients 0) 0) "no actor stayed in a transient state past its ceiling")
        (floor-expect "red-record" (= (get res 'unrecorded-reds 0) 0) "every red state had a causal event record")
        (floor-expect "foreman-green" (= (get res 'non-foreman-greens 0) 0) "green light belonged only to the foreman")
        (floor-expect "quarantine" (<= (get res 'quarantine 0) 50) "quarantine growth stayed within 50 rows/day")
        (floor-expect "live-no-scene" (= (get res 'live-scenes 0) 0) "zero scene.* or drill rows on the live day file")
        (floor-expect "determinism" (get res 'deterministic #t) "30/60/120 Hz folds produced identical quantized state hashes")
        (let ((closed (floor-scene 'close)))
          (report 'truth (list (list 'passes (get closed 'passes 0))
                               (list 'fails (get closed 'fails 0))
                               (list 'hash (get closed 'hash ""))))
          (if (> (get closed 'fails 0) 0)
              (report 'alert (string-append "floor-truth: " (number->string (get closed 'fails 0)) " invariant(s) failed")))
          (done (string-append (number->string (get closed 'passes 0)) " passed, " (number->string (get closed 'fails 0)) " failed")))))))
