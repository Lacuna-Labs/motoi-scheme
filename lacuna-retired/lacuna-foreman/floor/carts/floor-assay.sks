;; floor-assay.sks — WEEKLY PRODUCER ASSAY DRIFT CART (lane F5-H, unit H.5; A8-SCENE-SCHEME §6.4).
;; Owns: checking every producer row of A1-DATA-ASSAY.md against the codebase and loopback routes via `(hand 'floor-assay)`
;; and recording each drifted or missing producer as a `(floor-expect ...)` verdict row.
;; Refuses: repairing code or retrying failed routes (law 10: one try). Invariants (§18): "a claim is not a record".
(lacuna-cart 'floor-assay
  '((does . "checks every producer row of A1's assay table: the file exists, the line still holds the producer, the route answers; reports drift")
    (version . 1)
    (agent . ((tier . watch)
              (verbs . (on hand report remember recall floor-scene floor-expect done))))
    (minds . ())
    (restart . temporary)
    (deadlines . ((hand . 120) (cart . 600)))
    (contract . ((goal . "every assay producer row checked once and any drift recorded with its row")
                 (done-check . "assay scene closed with pass and drift counts")))
    (sentry . ())
    (touches . ("docs:A1" "routes:read-only"))
    (done . "every assay row checked once; drift reported with its row")
    (exam . E-floor-assay)))

(define (start)
  (floor-scene 'open "assay")
  (hand 'floor-assay))

(on 'hand (lambda (r)
  (if (not (get r 'ok #f))
      (begin
        (floor-expect "assay-read" #f (get r 'why "floor-assay did not answer"))
        (floor-scene 'close)
        (done (string-append "stopped: " (get r 'why "floor-assay did not answer"))))
      (let ((rows (get (get r 'result '()) 'rows '())))
        (for-each (lambda (row)
                    (floor-expect (string-append "assay:" (get row 'producer "?"))
                                  (equal? (get row 'state "ok") "ok")
                                  (get row 'detail "producer healthy")))
                  rows)
        (let ((closed (floor-scene 'close)))
          (report 'assay (list (list 'passes (get closed 'passes 0))
                               (list 'fails (get closed 'fails 0))))
          (done (string-append (number->string (get closed 'passes 0)) " ok, " (number->string (get closed 'fails 0)) " drifted")))))))
