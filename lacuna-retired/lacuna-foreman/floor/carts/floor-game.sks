;; floor-game.sks — TWO PAGES, ONE NIGHT: THE SRE BUDGET GAME (lane F5-H; A8-SCENE-SCHEME §7).
;; Owns: authoring and playing the 120 s SRE budget training scene ("two pages, one night") on an isolated eval floor using
;; only tier-watch floor-* verbs (`floor-scene`, `floor-emit`, `floor-tick`, `floor-camera`, `floor-say`, `floor-expect`).
;; Refuses: moving any live actor or sending any act to the foreman or hands (law 3, law 8).
(lacuna-cart 'floor-game
  '((does . "authors and plays the two-pages-one-night SRE budget training game on an eval floor and scores the run")
    (version . 1)
    (agent . ((tier . watch)
              (verbs . (on report remember recall floor-scene floor-emit floor-tick floor-camera floor-say floor-expect done))))
    (minds . ())
    (restart . temporary)
    (deadlines . ((hand . 60) (cart . 300)))
    (contract . ((goal . "play two-pages-one-night on an eval floor and seal the scene hash and verdict count")
                 (done-check . "eval floor closed with 0 failed expectations")))
    (sentry . ())
    (touches . ("floor:eval"))
    (done . "two-pages-one-night played on its eval floor and sealed")
    (exam . E-floor-game)))

(define (start)
  (floor-scene 'open "two-pages-one-night")
  (floor-say "two pages, one night: keep the error budget above zero")
  (floor-emit 'run.filed "w-d20001" '((key "cart:backup") (cart "backup") (by "foreman")))
  (floor-emit 'run.start "w-d20001" '((brain "e4b")))
  (floor-tick 20000)
  (floor-emit 'alert.raise "alert:page-1" '((key "lme-load") (level crit) (title "12B load refused: memory tight") (source "game")))
  (floor-camera "alert:page-1" 1000 42)
  (floor-tick 25000)
  (floor-emit 'run.pass "w-d20001" '((checked-by "foreman")))
  (floor-expect "backup-passed" "w-d20001" '((state passed)))
  (floor-camera 'home 1200 48)
  (let ((closed (floor-scene 'close)))
    (report 'game (list (list 'scene "two-pages-one-night")
                        (list 'passes (get closed 'passes 0))
                        (list 'fails (get closed 'fails 0))
                        (list 'hash (get closed 'hash ""))))
    (done (string-append "two-pages-one-night complete: " (number->string (get closed 'passes 0)) " passed"))))
