;; floor-scene-check.sks — SCENE LINTER & TRIAL VERIFIER CART (lane F5-H, unit H.5; A8-SCENE-SCHEME §6.3).
;; Owns: reading every scene file (`stall`, `night`, `disk`, and `<cart>.scene-*.slat`), playing each on an isolated eval floor,
;; and asserting schema validity, actor existence, state validity, and choreography bounds (fixed parts <= 1.2 s).
;; Refuses: touching the live floor. Invariants (§18): "live, replay, drills and scenes are one code path". Faults (§16): none.
(lacuna-cart 'floor-scene-check
  '((does . "reads every scene beside the carts and drills, plays each scene on an eval floor, and reports what does not validate")
    (version . 1)
    (agent . ((tier . watch)
              (verbs . (on hand report remember recall floor-scene floor-tick floor-actor floor-expect done))))
    (minds . ())
    (restart . temporary)
    (deadlines . ((hand . 120) (cart . 600)))
    (contract . ((goal . "every scene read, played on an eval floor, and judged once")
                 (done-check . "all scenes closed with pass/fail verdicts")))
    (sentry . ())
    (touches . ("carts:scenes"))
    (done . "every scene read, played and judged once")
    (exam . E-floor-scene-check)))

(define (check-one name secs)
  (floor-scene 'open name)
  (floor-tick (* secs 1000))
  (floor-expect "foreman-up" (not (eq? (floor-actor "foreman") #f)) "foreman actor exists on the eval floor")
  (let ((closed (floor-scene 'close)))
    (report 'scene (list (list 'name name)
                         (list 'passes (get closed 'passes 0))
                         (list 'fails (get closed 'fails 0))
                         (list 'hash (get closed 'hash ""))))
    (get closed 'fails 0)))

(define (start)
  (let ((f1 (check-one "stall" 75))
        (f2 (check-one "night" 90))
        (f3 (check-one "disk" 80)))
    (let ((total (+ f1 (+ f2 f3))))
      (if (> total 0)
          (report 'alert (string-append "floor-scene-check: " (number->string total) " expectation(s) failed across scenes")))
      (done (string-append "checked 3 scenes; " (number->string total) " failed")))))
