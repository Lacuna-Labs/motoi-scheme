;; stall.slat — THE STALL DRILL (lane F5-H, unit H.3; A8 §2.5, converted whole from lacuna-home/src/gl/floorDrill.js STALL): the rogue
;; head. The source of truth for the drill; installed hash-checked to ~/lacuna-world/drills/ (tools/floor-truth/install-drills.mjs).
(scene (name "stall") (v 1) (by drill) (secs 75)
  (doc "the rogue head: wo:vector-scan locks the 12B's KV cache at layer 18; hold it from its card before 0:48 or the 12B crashes")
  (param (name desk) (type actor) (default "e4b") (doc "the mind holding the desk; floorDrill.js read it from the live feed (b.brain.holds)"))
  (actors "lacuna" "foreman" "box" "12b" "$desk" "claude" "w-d20001" "w-d20002" "w-d20003" "sentry-code:w-d20001" "sentry-1b:w-d20002" "sentry-code:w-d20003" "wo-d2")
  (score (win (and (pressed "w-d20002") (not (state "12b" failed)))) (lose (state "12b" engine-down)) (par-ms 30000))

  ;; 0 s: the premise (the owner: "give me the BLUF when I start them up")
  (ev (at 0) (kind scene.begin) (actor "lacuna") (data (name "stall") (secs 75)))
  (ev (at 0) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 0) (kind scene.say) (actor "lacuna") (data (text "a vector scan is about to lock the 12B at layer 18; you have until 0:48 to hold wo:vector-scan from its card")))
  (ev (at 0) (kind scene.mark) (actor "lacuna") (data (state rest)))

  ;; 1 s to 4 s: sentry-watch is filed and starts; its sentry attaches; its one call is a tail-log read (old: last [[4, "shell tail-log"]])
  (ev (at 1000) (kind run.filed) (actor "w-d20001") (ref "w-d20001") (data (cart "sentry-watch") (by "foreman")))
  (ev (at 1000) (kind foreman.spawn) (actor "foreman") (ref "w-d20001") (data (name "sentry-watch")))
  (ev (at 4000) (kind run.start) (actor "w-d20001") (ref "w-d20001"))
  (ev (at 4000) (kind sentry.attach) (actor "sentry-code:w-d20001") (ref "w-d20001") (data (model "code") (run "w-d20001")))
  (ev (at 4200) (kind run.ticket.open) (actor "w-d20001") (ref "w-d20001") (data (op "tail-log") (args "dev-api 150") (deadline-s 120) (kind hand)))
  (ev (at 5000) (kind run.ticket.close) (actor "w-d20001") (ref "w-d20001") (data (exit 0) (ms 800)))
  (expect (at 5000) (actor "w-d20001") (state stepping) (why "sentry-watch started at 4 s and its first ticket closed: a step"))

  ;; 6 s to 10 s: the work order for the coder; the 12B loads (old: minds [{12b, from 8, to 62… }] in NIGHT; from 8 to 72 here; 7,900 MB); the run starts on it
  (ev (at 6000) (kind wo.filed) (actor "wo-d2") (ref "wo-d2") (data (for "coder") (goal "vector scan of index.bin")))
  (ev (at 6000) (kind run.filed) (actor "w-d20002") (ref "w-d20002") (data (key "wo:wo-d2") (role "coder") (by "foreman")))
  (ev (at 8000) (kind mind.load.start) (actor "12b") (ref "w-d20002"))
  (ev (at 9600) (kind mind.load.done) (actor "12b") (ref "w-d20002") (data (hot-mb 7900)))   ; arena-mb and warm-ms: the old drill never had them; not invented
  (ev (at 10000) (kind run.start) (actor "w-d20002") (ref "w-d20002") (data (brain "12b")))   ; the run is the 12B's: the fold reads the brain here
  (ev (at 10000) (kind sentry.attach) (actor "sentry-1b:w-d20002") (ref "w-d20002") (data (model "1b") (run "w-d20002")))
  (ev (at 10000) (kind mind.turn.start) (actor "12b") (ref "w-d20002") (data (who "w-d20002") (session "run:w-d20002")))
  (ev (at 10000) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 10200) (kind run.ticket.open) (actor "w-d20002") (ref "w-d20002") (data (op "read-file") (args "index.bin") (deadline-s 120) (kind hand)))
  (ev (at 11000) (kind run.ticket.close) (actor "w-d20002") (ref "w-d20002") (data (exit 0) (ms 800)))
  (expect (at 11000) (actor "12b") (state busy.reading) (why "the 12B loaded at 9.6 s and holds a turn: it reads"))

  ;; 12 s to 30 s: the desk's mind shows a busy slot (old: deskSlots [12, 30] → "1 of 2 slot(s) working")
  (ev (at 12000) (kind mind.turn.start) (actor "$desk") (data (who "owner") (session "console")))
  (ev (at 12000) (kind mind.turn.phase) (actor "$desk") (data (phase read) (tokens 0)))

  ;; 14 s to 16 s: backup is filed and starts (old: last [[16, "shell rsync"]]); the runaway verdict on vector-scan (old: r.runaway && running && t > 14)
  (ev (at 14000) (kind run.filed) (actor "w-d20003") (ref "w-d20003") (data (cart "backup") (by "foreman")))
  (ev (at 14000) (kind foreman.spawn) (actor "foreman") (ref "w-d20003") (data (name "backup")))
  (ev (at 14500) (kind sentry.verdict) (actor "sentry-1b:w-d20002") (ref "w-d20002") (data (check "runaway") (action "would-stop") (detail "more steps than its header allows: writing log lines without end")))
  (ev (at 15000) (kind claude.talk) (actor "claude") (data (phase start)))   ; old: claude [15, 60]; A2 decides whether talk is a span or two rows
  (ev (at 16000) (kind run.start) (actor "w-d20003") (ref "w-d20003"))
  (ev (at 16000) (kind sentry.attach) (actor "sentry-code:w-d20003") (ref "w-d20003") (data (model "code") (run "w-d20003")))
  (ev (at 16000) (kind run.ticket.open) (actor "w-d20003") (ref "w-d20003") (data (op "rsync") (args "~/lacuna-world → offsite") (deadline-s 600) (kind hand)))
  (ev (at 16000) (kind run.ticket.open) (actor "w-d20002") (ref "w-d20002") (data (op "vector-eval") (args "batch=128") (deadline-s 120) (kind hand)))
  (ev (at 16000) (kind mind.turn.phase) (actor "12b") (ref "w-d20002") (data (phase call) (tokens 412)))

  ;; 18 s: the stall (old: stall [18, 48, "KV-cache allocation lockup at layer 18"]; mark asking at 18). The run stalls by record at once
  ;; (run.stall is a record); the 12B's own "stalled" state arrives after the fold's on-delay (max(10 s, 3 × its p99 gap), master §2.3),
  ;; because the slot stays busy with no new tokens: the phase samples below carry the same token count
  (ev (at 18000) (kind run.stall) (actor "w-d20002") (ref "w-d20002") (data (why "KV-cache allocation lockup at layer 18")))
  (ev (at 18000) (kind sentry.verdict) (actor "sentry-1b:w-d20002") (ref "w-d20002") (data (check "no-progress") (action "would-stop") (detail "KV-cache allocation lockup at layer 18")))
  (ev (at 18000) (kind press.wait) (actor "w-d20002") (ref "w-d20002") (data (id "p-d2001") (action "pause or stop wo:vector-scan")))
  (ev (at 18000) (kind scene.mark) (actor "lacuna") (data (state asking)))
  (ev (at 18000) (kind mind.turn.phase) (actor "12b") (ref "w-d20002") (data (phase think) (tokens 412)))
  (expect (at 20000) (actor "w-d20002") (state waiting-press) (why "the run stalled at 18 s and asks for your press: it waits on it (A3: a press outranks the stall)"))
  (expect (at 20000) (actor "sentry-1b:w-d20002") (light semantics on) (why "the no-progress verdict lights the sentry's third light"))
  (expect (at 31000) (actor "12b") (state stalled) (why "slot busy, no new token since 16 s: past the 10 s on-delay the mind is stalled, not thinking"))

  ;; 24 s: the coast tightens (old: coast [24, 48, "tight"]); the third call of the scan (old: [24, "attention layer 18"])
  (ev (at 20000) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 24000) (kind box.coast) (actor "box") (data (level tight)))   ; free-pct wired-mb avail-mb: the old drill carried none
  (ev (at 24000) (kind run.ticket.open) (actor "w-d20002") (ref "w-d20002") (data (op "attention") (args "layer 18") (deadline-s 120) (kind hand)))
  (expect (at 25000) (actor "box") (state tight) (why "the coast went tight at 24 s"))

  (ev (at 28000) (unless (pressed "w-d20002")) (kind mind.turn.phase) (actor "12b") (ref "w-d20002") (data (phase think) (tokens 412)))   ; the stall goes on: the same token count, 10 s on (moved here from the 18 s rows: rows run in time)
  ;; 30 s: the desk's slot frees (old: deskSlots end)
  (ev (at 30000) (kind mind.turn.done) (actor "$desk") (data (ms 18000) (tokens 240) (reason "stop")))

  (ev (at 30000) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 38000) (unless (pressed "w-d20002")) (kind mind.turn.phase) (actor "12b") (ref "w-d20002") (data (phase think) (tokens 412)))   ; and 20 s on
  ;; THE OWNER'S PRESS (any time before 48 s): the card's pause or stop on w-d20002 is a press.pressed row the door writes into the drill
  ;; stream with (by owner); the rows below follow it. The old drill ended the run at held + 1 and called a paused run "passed"
  ;; (floorDrill.js:123); a run passes only by the foreman's seal (law 6), so here a held run is stopped, never passed.
  (ev (at 0) (when (pressed "w-d20002")) (kind run.stop) (actor "w-d20002") (ref "w-d20002") (data (by "owner") (after-ms 1000)))
  (ev (at 0) (when (pressed "w-d20002")) (kind mind.turn.done) (actor "12b") (ref "w-d20002") (data (reason cancel) (after-ms 1500)))
  (ev (at 0) (when (pressed "w-d20002")) (kind scene.mark) (actor "lacuna") (data (state rest) (after-ms 1500)))
  (ev (at 0) (when (pressed "w-d20002")) (kind box.coast) (actor "box") (data (level clear) (after-ms 4000)))
  (ev (at 0) (when (pressed "w-d20002")) (kind scene.say) (actor "lacuna") (data (text "you held wo:vector-scan; the 12B is breathing again") (after-ms 2000)))

  ;; 48 s, nothing held (old: crashAt 48; "crashed: layer 18 burned out"; office asleep, state fail; the culprit ends failed at 49)
  (ev (at 40000) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 48000) (unless (pressed "w-d20002")) (kind mind.turn.fail) (actor "12b") (ref "w-d20002") (data (reason engine) (layer 18)))   ; the catalog's reasons: the engine, at layer 18
  (ev (at 48000) (unless (pressed "w-d20002")) (kind mind.engine.down) (actor "12b"))
  (ev (at 48000) (unless (pressed "w-d20002")) (kind box.coast) (actor "box") (data (level clear)))
  (ev (at 48000) (unless (pressed "w-d20002")) (kind scene.mark) (actor "lacuna") (data (state rest)))
  (ev (at 49000) (unless (pressed "w-d20002")) (kind run.fail) (actor "w-d20002") (ref "w-d20002") (data (why "the 12B crashed at layer 18")))
  (ev (at 49000) (unless (pressed "w-d20002")) (kind scene.say) (actor "lacuna") (data (text "layer 18 stalled out and the 12B crashed at 0:48; the stall backpressured the door's beam")))
  (expect (at 49500) (unless (pressed "w-d20002")) (actor "12b") (state engine-down) (why "the crash at 48 s: the engine is down"))
  (expect (at 49500) (unless (pressed "w-d20002")) (actor "w-d20002") (state failed) (why "the culprit failed at 49 s"))
  (expect (at 49500) (when (pressed "w-d20002")) (actor "12b") (state resident) (why "held in time: the 12B stays up"))
  (expect (at 49500) (when (pressed "w-d20002")) (actor "w-d20002") (state stopped) (why "held in time: the culprit is stopped, not passed"))

  ;; 52 s: an ended run leaves the floor 3 s after its end (old: t >= r.end + 3 → continue); the fold's worker statechart owns the exit
  (expect (at 52500) (unless (pressed "w-d20002")) (actor "w-d20002") (state failed) (why "a failed run keeps its cinder until it is acknowledged (A3 as built)"))

  ;; 60 s to 72 s: Claude done; the two carts pass by the foreman's seal; the 12B unloads (old: minds to 72)
  (ev (at 50000) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 60000) (kind claude.talk) (actor "claude") (data (phase done)))
  (ev (at 60000) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 67000) (kind run.ticket.close) (actor "w-d20003") (ref "w-d20003") (data (exit 0) (ms 51000)))
  (ev (at 68000) (kind run.pass) (actor "w-d20003") (ref "w-d20003") (data (checked-by "foreman")))
  (ev (at 68000) (kind sentry.detach) (actor "sentry-code:w-d20003") (ref "w-d20003"))
  (ev (at 70000) (kind run.pass) (actor "w-d20001") (ref "w-d20001") (data (checked-by "foreman")))
  (ev (at 70000) (kind sentry.detach) (actor "sentry-code:w-d20001") (ref "w-d20001"))
  (expect (at 70500) (actor "w-d20001") (state passed) (why "sealed by the foreman at 70 s"))
  (ev (at 70000) (kind foreman.beat) (actor "foreman") (data (living 3) (total 3)))   ; the foreman beats (a record law 1 needs behind the runs)
  (ev (at 72000) (kind mind.unload) (actor "12b"))
  (expect (at 73500) (when (pressed "w-d20002")) (actor "12b") (state evicted) (why "the 12B left memory at 72 s"))
  (expect (at 73500) (unless (pressed "w-d20002")) (actor "12b") (state engine-down) (why "a crashed engine stays down: nothing unloads from it"))

  ;; 75 s: the score and the end (the debrief card reads scene.score; the old debrief lines are the two scene.say rows above)
  (ev (at 75000) (kind scene.end) (actor "lacuna")))
