;; kinds.slat — THE KIND CATALOG, the floor's day-1 contract (lane F5-A, unit A.1; RULINGS-2026-10-30 §1(a) over A2 §3 and the
;; review's §5a; frozen 2026-11-01 by the lead). Owns: every kind of event the floor's log admits, and every producer that may
;; write one. Refuses, by the validator that reads it (validate.js): a kind not here; a producer a kind does not list; a data
;; key outside a kind's fields; a value outside its type; a missing coordinate or ref where the kind requires one. Implements:
;; A2 §2.1 (the envelope), §3 (the kinds), §4.1 (the producer registry), §4.3 (the rate classes), §4.6 (the periods). Invariants
;; (design §18): "guaranteed good data" (the owner): nothing reaches the day file that this table does not name. Faults (§16):
;; none here; a refusal is the validator's reason, counted by floor.quarantine.
;;
;; The forms. (producer <name> (source "…") (period-s <n>|none) (feeds <actor families>) (pseq "<its rule>")): the period is the
;; staleness clock, about three of the producer's samples (A2 §4.1's column; §4.6: "three is a dead feed", the 15 s coast at
;; 45 s); that much silence writes floor.stale once, naming its kinds' sample period. (kind <family.kind> (family <f>)
;; (record <the fold's record kind>) (producers <names>) (fields (<key> <type> ["<unit>"]) …) [(required <keys>)] (actor <rule>)
;; (at required|dash) (ref required|optional) (rate sampler|phase|edge) (period-s <n>|none) (retention keyframe|window …)).
;; Types: int, number (finite), bool, (string <max chars>), (one-of <symbols or integers>), (list number|string <max items>),
;; (counts <keys>) (an object of integer counts), (or <type> null). A value with a unit is ≥ 0; a "%" is 0 to 100. Rate classes
;; (A2 §4.3, a token bucket per producer and kind): sampler 8/s with a burst of 16; phase 50/s with a burst of 200; edge 20/s
;; with a burst of 100; any producer, all kinds, 200/s. Retention: keyframe (the fold's result rides the (state …) keyframe),
;; window (the event lives in the client's ring and is read from the day file on seek), or both. A kind added later is one MAIL
;; line and a dated row here, never a silent edit. 2026-11-01 (the lead, A.5): floor.quarantine's reasons gain cursor, chain and
;; replayed, the three A2 §7, §5.3 and §8.3 name; sentry.verdict's actions are the verdict writer's seven
;; (lacuna-foreman/sentry/verdicts.mjs ACTIONS adds would-kick and refuse); the engine front's day-1 contract (F5-E,
;; RULINGS C-63; lacuna-node/models/engine-front.mjs's header), which this table missed: engine-front writes mind.turn.phase,
;; the turn kinds carry the front's id, slot, deadline-ms, ms, msg, tokens, prompt and prefill-ms, and a fail's reasons add
;; grammar-compile, form, front-timeout and engine (measured: 221 of the live ring's 256 rows were refused before); lme-log
;; writes mind.turn.done and mind.turn.fail for a caller the front's ring never sees (E1's gateway, `gw-` ids), and ollama-ps
;; writes mind.load.done for a small mind Ollama lists; agents-room writes mind.turn.done for a turn the small minds' server
;; answers (the front's ring never sees it); alerts carries no staleness clock (its rows are edges only, so a steady list is
;; silence, not a dead feed; its liveness is the legacy API's own service probe, A2 §4.6's rule for a producer quiet by nature).
;; 2026-11-04 (the owner's turn sentry): turn-sentry writes sentry.verdict for a mind's finished agents-room turn, its ref the mind, (mind …) its id; shadow always.

(producer foreman-bus (source "POST /api/foreman/event opened at the door (A2 §8.3)") (period-s 120) (feeds runs foreman sentries) (pseq "sha256 of the nonce, 12 hex"))
(producer foreman-health (source "GET :1139/health, 5 s probe") (period-s 15) (feeds foreman) (pseq "the probe's t"))
(producer runs-ledger (source "~/lacuna-world/foreman/ledger/runs.slat, byte cursor") (period-s none) (feeds runs sentries minds) (pseq "the line's end offset"))
(producer contracts (source "GET :1139/contracts/<run>?as=data on a bus edge") (period-s none) (feeds runs) (pseq "the contract's step"))
(producer work-orders (source "foreman/desk/work-orders/, fs.watch and reread") (period-s none) (feeds work-orders) (pseq "the file mtime, ms"))
(producer lme-log (source "~/.lacuna/logs/lme-desk.log, byte cursor") (period-s none) (feeds minds) (pseq "byte offset"))
(producer lme-breadcrumbs (source "~/.lacuna/lme/breadcrumbs.slat, byte cursor") (period-s none) (feeds minds) (pseq "byte offset"))
(producer lme-lab (source "~/.lacuna/logs/lme-lab.slat, byte cursor: lme/tools/lab.mjs, as the bench and the exactness runs go (LEAD-LME step 0, 2026-11-02)") (period-s none) (feeds minds) (pseq "byte offset"))
(producer engine-front (source "the front's /turns, by cursor (the engine's socket when the front retires)") (period-s none) (feeds minds) (pseq "the turn's index"))
(producer engine-probe (source "/health and (status) at 5 s") (period-s 15) (feeds minds services) (pseq "the probe's t"))
(producer slots (source "GET :8091/slots at 250 ms") (period-s 1) (feeds minds) (pseq "the sample tick"))
(producer ollama-ps (source "GET :11435/api/ps at 5 s") (period-s 15) (feeds minds services) (pseq "the probe's t"))
(producer procs (source "procs.mjs procsNow at 5 s; probes at 30 s") (period-s 60) (feeds services) (pseq "the tick"))
(producer door-log (source "~/.lacuna/logs/door.slat, byte cursor") (period-s none) (feeds services) (pseq "byte offset"))
(producer hands-log (source "~/.lacuna/logs/hands.slat, byte cursor: a run's receipts (frontend/floor-tail-hands.mjs, 2026-11-06); quiet when no run calls") (period-s none) (feeds runs services box) (pseq "byte offset"))
(producer coast (source "GET :1139/coast at 15 s") (period-s 45) (feeds box) (pseq "the read's at"))
(producer broker (source "GET :1139/broker at 15 s") (period-s 45) (feeds box minds) (pseq "the read's t"))
(producer desk-now (source "GET /api/chat/now at 1 s (the legacy API, until P7)") (period-s none) (feeds minds owner) (pseq "started (ms) + the sequence length"))
(producer desk-quiet (source "GET /api/desk/quiet at 15 s") (period-s 45) (feeds owner) (pseq "the read's t"))
(producer alerts (source "GET /api/alerts at 5 s; alert-state.json mtime") (period-s none) (feeds alerts) (pseq "the row's t (ms)"))
(producer petitions (source "~/.lacuna/petitions.json mtime at 4 s") (period-s none) (feeds presses) (pseq "the file's mtime + the petition id's hash"))
(producer brain-loop (source "in-process emit from turn.mjs") (period-s none) (feeds minds runs) (pseq "a per-turn counter"))
(producer agents-room (source "in-process from agents.mjs") (period-s none) (feeds minds visitors) (pseq "a counter"))
(producer play (source "in-process from the /api/play/* routes") (period-s none) (feeds visitors) (pseq "a counter"))
(producer cortex-log (source "~/lacuna-world/cortex/cortex.log, byte cursor, 10 s buckets") (period-s none) (feeds cortex) (pseq "the log's own seq"))
(producer recalls (source "~/.lacuna/rag/recalls.jsonl, byte cursor") (period-s none) (feeds cortex) (pseq "byte offset"))
(producer forge-runs (source "GET /api/forge/runs at 4 s") (period-s 30) (feeds forge) (pseq "the read's t"))
(producer cloud-ledger (source "~/.lacuna/cloud-ledger.jsonl, byte cursor") (period-s none) (feeds cloud) (pseq "byte offset"))
(producer git (source "git log -20 at 30 s") (period-s none) (feeds claude) (pseq "the commit time"))
(producer wakes (source "~/.lacuna/agents/wakes.jsonl, byte cursor") (period-s none) (feeds minds) (pseq "byte offset"))
(producer owner (source "the drill route (A2 §4.7)") (period-s none) (feeds scenes) (pseq "the drill token's counter"))
(producer scene (source "a scene file or a cart's floor-scene verb; the producer is written scene:<name>") (period-s none) (feeds any) (pseq "the line number in the scene"))
(producer door (source "floor-events.mjs itself (floor.*, box.up, box.down.*)") (period-s 60) (feeds floor box) (pseq "seq"))
(producer claude-threads (source "in-process from frontend/threads.mjs (added 2026-11-01)") (period-s none) (feeds claude) (pseq "a counter"))
(producer disk (source "the box tailer's disk read, and P1's places producer (added 2026-11-01)") (period-s 600) (feeds box) (pseq "the read's t"))
(producer hand-times (source "~/.lacuna/hand-times.jsonl, byte cursor, 10 s windows (added 2026-11-01)") (period-s none) (feeds runs) (pseq "byte offset"))
(producer cascade (source "the foreman's cascade climbs, from the bus (added 2026-11-01)") (period-s none) (feeds minds) (pseq "a counter"))
(producer rolebench (source "the ladder's sittings, tools/rolebench (added 2026-11-01)") (period-s none) (feeds minds) (pseq "the sitting's index"))
(producer sentry-mode (source "~/lacuna-world/foreman/sentry-mode.slat, mtime (added 2026-11-01)") (period-s none) (feeds sentries) (pseq "the file mtime, ms"))
(producer mail (source "~/lacuna-world/foreman/mail/, the new files (added 2026-11-01)") (period-s none) (feeds claude) (pseq "the file's mtime"))
(producer owner-updates (source "in-process from mind/owner-updates.mjs: the owner's words queued into a turn and folded at its round (WORK-CHIPS-CHAT-DESIGN §3.1 #20, 2026-11-06)") (period-s none) (feeds owner) (pseq "a counter"))
(producer owner-keys (source "in-process from the door's owner routes: the flag key (added 2026-11-01)") (period-s none) (feeds owner) (pseq "a counter"))
(producer library (source "in-process from the door's /library/ route: a page of the built library the owner reads (added 2026-11-01, L1's L.3; the addendum of that day)") (period-s none) (feeds owner) (pseq "a counter"))
(producer changes (source "~/lacuna-world/sre/changes.slat, byte cursor: lacuna up, down and restart (added 2026-11-02, CL-FLOOR-SERVICES)") (period-s none) (feeds services) (pseq "byte offset"))
(producer turn-sentry (source "in-process from frontend/turn-sentry.mjs: a mind's finished turn in the agents room, read by the sentry (added 2026-11-04)") (period-s none) (feeds sentries minds) (pseq "the turn's ms × 16 + the row"))
(producer ci-progress (source "~/lacuna-world/ci/progress.slat, byte cursor: tools/ci/ci.mjs as a pass runs (added 2026-11-04)") (period-s none) (feeds runs) (pseq "byte offset"))
(producer vm-audit (source "~/.lacuna/logs/vm-audit.slat, byte cursor: lacuna-foreman/vm-sidecar.mjs, one line an eval (added 2026-11-04)") (period-s none) (feeds runs) (pseq "byte offset"))

