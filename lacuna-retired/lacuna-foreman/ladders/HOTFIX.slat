(ladder (playbook "HOTFIX") (version 1) (role engineer) (done-check "(and (latch-closed?) (eqv? (exit-of (quote test-run)) 0) (eqv? (exit-of (quote git-commit)) 0))")
  (step 1 (allows errors watchdogs git-log read recall) (gives (text "the failure's evidence: the error line, the watchdog, the commit that brought it"))
          (done (receipt git-log) (receipt read)) (budget (in 8192) (out 512) (s 300))
          (says "Name the failure in one line with its evidence and the commit that brought it."))
  (step 2 (allows patch test-run) (gives)
          (done (receipt test-run (exit any))) (budget (in 16384) (out 2048) (s 600))
          (says "Write the smallest test that fails on the current code, for the right reason."))
  (step 3 (allows patch test-run read) (gives)
          (done (receipt test-run (exit 0))) (budget (in 16384) (out 2048) (s 900))
          (says "Make the smallest change that makes it pass; nothing else changes."))
  (step 4 (allows git-commit branch-and-mail) (gives)
          (done (receipt git-commit (exit 0))) (budget (in 4096) (out 256) (s 120))
          (says "Commit on the hotfix branch and mail it; the merge and the release are the owner's presses.")))
