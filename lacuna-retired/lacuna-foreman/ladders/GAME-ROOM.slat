(ladder (playbook "GAME-ROOM") (version 1) (role maker) (done-check "(and (latch-closed?) (eqv? (exit-of (quote make-bundle)) 0))")
  (step 1 (allows make-brief make-write) (gives (text "the owner's words and the frame's rules"))
          (done (receipt make-write)) (budget (in 16384) (out 2048) (s 600))
          (says "Write one whole HTML file under its short name onto the shelf; compact, no network but the four CDNs."))
  (step 2 (allows make-files make-exam) (gives)
          (done (receipt make-files) (receipt make-exam (exit 0))) (budget (in 8192) (out 512) (s 300))
          (says "Check the file is on its shelf and plays in the frame; fix the line the page reports, never guess."))
  (step 3 (allows make-bundle) (gives)
          (done (receipt make-bundle (exit 0))) (budget (in 4096) (out 256) (s 120))
          (says "Cut the bundle record so the made tab shows it; say in two lines how to play it.")))
