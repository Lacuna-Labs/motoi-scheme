(ladder (playbook "WATCHDOG-RED") (version 1) (role operator) (done-check "(latch-closed?)")
  (step 1 (allows recall watchdogs) (gives (text "the dog's whole word, not its colour: summary, level, action, age_s"))
          (done (receipt watchdogs)) (budget (in 4096) (out 256) (s 120))
          (says "Read every dog's latest word on both sides and name the red or stale one."))
  (step 2 (allows watchdogs service service-log health) (gives)
          (done (receipt watchdogs) (receipt service-log)) (budget (in 6144) (out 256) (s 180))
          (says "Re-check the named dog now and read the service it watches."))
  (step 3 (allows code-where read grep outline tail-log files) (gives (text "the probe's code: watch_probes*.py, watch_boot.py"))
          (done (receipt read) (receipt code-where)) (budget (in 12288) (out 512) (s 300))
          (says "Follow the red word to its cause in the probe's code or the service's log."))
  (step 4 (allows patch test-run read) (gives)
          (done (receipt test-run (exit 0)) (receipt patch (file "docs/eng/notes/**"))) (budget (in 16384) (out 2048) (s 600))
          (says "Fix the check with a test, or write the cause and the fix to a note under docs/eng/notes/."))
  (step 5 (allows git-commit branch-and-mail) (gives)
          (done (receipt git-commit (exit 0))) (budget (in 4096) (out 256) (s 120))
          (says "Commit on the run's branch and mail the branch.")))
