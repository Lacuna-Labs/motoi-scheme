(ladder (playbook "CART-REPAIR") (version 1) (role engineer) (done-check "(and (latch-closed?) (eqv? (exit-of (quote strict)) 0))")
  (step 1 (allows cart-run cart-record cart-lint read files recall) (gives (text "the cart's newest artifact and its run record"))
          (done (receipt cart-lint) (receipt cart-record)) (budget (in 8192) (out 512) (s 300))
          (says "Read the cart's newest artifact, its run record and its strict check's verdict."))
  (step 2 (allows read grep outline code-where) (gives)
          (done (receipt read)) (budget (in 12288) (out 512) (s 300))
          (says "Name the stop in one line: environment or program, with the line."))
  (step 3 (allows patch read) (gives)
          (done (receipt patch)) (budget (in 16384) (out 2048) (s 600))
          (says "Write the smallest fix to the cart's file; never delete a verb call to make a check pass."))
  (step 4 (allows strict cart-lint test-run) (gives)
          (done (receipt strict (exit 0)) (receipt cart-lint (exit 0))) (budget (in 8192) (out 512) (s 900))
          (says "Run the strict check on the branch until it passes."))
  (step 5 (allows git-commit branch-and-mail) (gives)
          (done (receipt git-commit (exit 0))) (budget (in 4096) (out 256) (s 120))
          (says "Commit on the run's branch and mail the branch.")))
