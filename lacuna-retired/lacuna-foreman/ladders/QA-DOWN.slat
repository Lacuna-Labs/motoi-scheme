(ladder (playbook "QA-DOWN") (version 1) (role operator) (done-check "(or (latch-closed?) (let ((qa (row-where (quote services) (quote name) \"qa-api\"))) (and qa (get qa (quote up)) (get qa (quote healthy)))))")
  (step 1 (allows services service health) (gives)
          (done (receipt services) (receipt service)) (budget (in 4096) (out 256) (s 120))
          (says "Read the qa-api row: up or down, its pid, and whether a promote is running."))
  (step 2 (allows service-log tail-log errors) (gives (text "the last 200 lines before it died"))
          (done (receipt service-log) (receipt tail-log)) (budget (in 12288) (out 512) (s 180))
          (says "Read the log's last lines and classify: a crash with a traceback, a port in use, a missing key, killed by memory."))
  (step 3 (allows disk coast-sample) (gives)
          (done (receipt disk)) (budget (in 4096) (out 256) (s 120))
          (says "Check the box: disk over the 5 % line and memory not exhausted."))
  (step 4 (allows petition) (gives)
          (done (receipt petition) (answer (names "qa-restart"))) (budget (in 4096) (out 512) (s 120))
          (says "File the qa-restart (or qa-start) card with the class and the quoted line; never act on QA yourself.")))
