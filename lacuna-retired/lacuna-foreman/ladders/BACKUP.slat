(ladder (playbook "BACKUP") (version 1) (role operator) (done-check "(latch-closed?)")
  (step 1 (allows watchdogs tail-log files) (gives (text "which backup the signal is about: the watchdog name or backup.log"))
          (done (receipt watchdogs) (receipt tail-log)) (budget (in 6144) (out 256) (s 120))
          (says "Name which backup the signal is about and read today's backup.log line."))
  (step 2 (allows disk-usage files) (gives)
          (done (receipt disk-usage) (receipt files)) (budget (in 6144) (out 256) (s 180))
          (says "Size the nightlies: a night over 1 GB names what should not be inside."))
  (step 3 (allows bundles bundle-verify) (gives)
          (done (receipt bundle-verify)) (budget (in 6144) (out 256) (s 600))
          (says "Prove the newest backup restores: verify the bundle; a failed restore is a stop and the owner's call."))
  (step 4 (allows note) (gives)
          (done (receipt note) (answer (names "Backups"))) (budget (in 6144) (out 1024) (s 120))
          (says "Write the note: which backup, its age and size, the drill's result, the finding; real or stale, with the evidence.")))
