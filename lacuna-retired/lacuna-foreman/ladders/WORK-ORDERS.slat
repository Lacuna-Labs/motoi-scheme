(ladder (playbook "WORK-ORDERS") (version 1) (role engineer) (done-check "(and (latch-closed?) (eqv? (exit-of (quote test-run)) 0) (eqv? (exit-of (quote git-commit)) 0))")
  (step 1 (allows recall read outline files code-where grep) (gives (text "every file you will change, whole"))
          (done (receipt read)) (budget (in 16384) (out 512) (s 300))
          (says "Recall the playbook for this kind of work and read every file you will change, whole."))
  (step 2 (allows patch read) (gives)
          (done (receipt patch)) (budget (in 16384) (out 2048) (s 600))
          (says "Change only what the order names; a new test is a new file beside the others."))
  (step 3 (allows test-run patch read) (gives)
          (done (receipt test-run (exit 0))) (budget (in 16384) (out 2048) (s 900))
          (says "Run the tests; on a failure read it, fix, and run again: three tries at most."))
  (step 4 (allows git-commit branch-and-mail) (gives)
          (done (receipt git-commit (exit 0))) (budget (in 4096) (out 256) (s 120))
          (says "Commit with a one-line message on lacuna/<run>, then mail the branch; never merge.")))
