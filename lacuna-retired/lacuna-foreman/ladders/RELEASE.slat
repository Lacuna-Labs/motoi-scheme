(ladder (playbook "RELEASE") (version 1) (role operator) (done-check "(latch-closed?)")
  (step 1 (allows release-board branches battery-last errors disk health) (gives)
          (done (receipt release-board) (receipt branches)) (budget (in 8192) (out 512) (s 300))
          (says "Read the gates: no hold, no release running, dev ahead of main, QA on main, the battery's reds, no new error class, disk over the line."))
  (step 2 (allows release-sort) (gives)
          (done (receipt release-sort)) (budget (in 12288) (out 1024) (s 300))
          (says "Sort the working tree by rule: ours, generated, scratch, unsure, secret; a secret stops the release."))
  (step 3 (allows pass) (gives)
          (done (receipt pass (exit 0))) (budget (in 4096) (out 256) (s 3600))
          (says "Run the workflow pass on the simulator, on the owner's press; a red that the change caused stops here."))
  (step 4 (allows promote build) (gives)
          (done (receipt build (exit 0))) (budget (in 4096) (out 256) (s 1800))
          (says "Promote dev to QA and build the iPad app from QA, each on the owner's press."))
  (step 5 (allows install-ipad) (gives)
          (done (receipt install-ipad (exit 0))) (budget (in 4096) (out 256) (s 900))
          (says "Install the kept build on her iPad, on the owner's press."))
  (step 6 (allows release-board battery-last) (gives)
          (done (receipt release-board)) (budget (in 4096) (out 512) (s 120))
          (says "Verify: QA's sha equals main, the iPad reports the build; the battery is next.")))
