(ladder (playbook "ERROR-SPIKE") (version 1) (role triager) (done-check "(latch-closed?)")
  (step 1 (allows errors) (gives)
          (done (receipt errors)) (budget (in 6144) (out 256) (s 120))
          (says "Read the last hour's summary and classes: which class is NEW, RISING or RETURNED, on which side."))
  (step 2 (allows errors tail-log service-log grep) (gives (text "the class's sample and the log at its first minute"))
          (done (receipt tail-log) (receipt service-log) (receipt grep)) (budget (in 12288) (out 512) (s 300))
          (says "Read the top class's sample and the first line of the burst, with what happened just before."))
  (step 3 (allows release-board git-log builds watchdogs) (gives)
          (done (receipt git-log) (receipt release-board) (receipt watchdogs)) (budget (in 8192) (out 512) (s 180))
          (says "Find the cause: a deploy at that minute, an outside refusal, a restart, a watchdog red at the same minute."))
  (step 4 (allows work-order note) (gives)
          (done (receipt work-order) (receipt note) (answer (names "Cause"))) (budget (in 8192) (out 1024) (s 180))
          (says "File the fix as a work order, or write the cause and the evidence; mute nothing whose cause is unknown.")))
