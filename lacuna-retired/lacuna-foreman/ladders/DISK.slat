(ladder (playbook "DISK") (version 1) (role operator) (done-check "(latch-closed?)")
  (step 1 (allows disk disk-eaters jobs) (gives)
          (done (receipt disk)) (budget (in 4096) (out 256) (s 120))
          (says "Read the disk: free GB and percent, the eaters, what is on the owner's list; check no build or battery is writing."))
  (step 2 (allows disk-usage files) (gives (text "~/.lacuna/kv, ~/.lacuna/logs, ~/lacuna-world/worktrees, ~/.lacuna/builds, ~/.lacuna/rag, ~/Lacuna-Backups"))
          (done (receipt disk-usage)) (budget (in 8192) (out 512) (s 300))
          (says "Size Lacuna's own eaters and the backups, in GB."))
  (step 3 (allows recall) (gives)
          (done (answer (names "GB" "%"))) (budget (in 8192) (out 1024) (s 180))
          (says "Put the plan in numbers: free space, the listed files and their total, each eater over 5 GB by name and size; nothing off the owner's list is deleted.")))
