;; route — the smallest playbook, for the index rows and the when/each walk: one read, one act per row, one ask on P0.
(playbook (id "route") (version 2) (cart "route") (type "respond")
  (trigger (every 60))
  (press "standing")
  (may files trash ask)
  (steps
    (step 1 (unit "files") (args "(scratch)") (deadline-s 10) (done "rows"))
    (step 2 (unit "trash") (args "(row)") (deadline-s 10) (done "moved") (each "row"))
    (step 3 (unit "ask") (args "a P0 needs the owner") (deadline-s 0) (done "asked") (when "P0"))
  )
  (done-check "every row moved"))
