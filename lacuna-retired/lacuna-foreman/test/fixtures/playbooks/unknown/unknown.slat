;; unknown — step 2 names a prose unit; the loader refuses it with exit 12 and a sentence naming the step.
(playbook (id "unknown") (version 1) (cart "unknown") (type "respond")
  (trigger (every 60))
  (press "none")
  (may files)
  (steps
    (step 1 (unit "files") (args "(scratch)") (deadline-s 10) (done "rows"))
    (step 2 (unit "restore to scratch from the verify's clone") (args "()") (deadline-s 300) (done "the INDEX reads back"))
  )
  (done-check "nothing: it never loads"))
