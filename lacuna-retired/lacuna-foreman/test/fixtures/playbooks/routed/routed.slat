;; routed — the three-step playbook with a mind job that names its role, function and budget (R1.4: the grid decides who decides).
(playbook (id "routed") (version 1) (cart "routed") (type "respond")
  (trigger (every 60))
  (press "standing")
  (may files trash)
  (never "a fourth step")
  (minds (gist (job "condense") (level "L4") (role swe) (function systems-code) (budget 4096 256)))
  (steps
    (step 1 (unit "files") (args "(scratch)") (deadline-s 10) (done "rows"))
    (step 2 (unit "trash") (args "(path)") (deadline-s 10) (done "moved"))
    (step 3 (unit "gist") (args "condense the rows to one line") (deadline-s 30) (done "one line"))
  )
  (judgment "none")
  (done-check "three receipts, every one exit 0")
  (exam "the stubbed hands and mind answer; the mind request carries the routed model")
  (report (step) (receipt) (grade)))
