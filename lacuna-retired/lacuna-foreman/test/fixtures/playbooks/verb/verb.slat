;; verb — a worker verb as a unit resolves at load (the table holds it) but has no runner in a playbook: refused at run, exit 12.
(playbook (id "verb") (version 1) (cart "verb") (type "respond")
  (trigger (every 60))
  (press "none")
  (may report trash)
  (steps
    (step 1 (unit "report") (args "(step)") (deadline-s 1) (done "reported"))
    (step 2 (unit "trash") (args "(path)") (deadline-s 10) (done "moved"))
  )
  (done-check "never: step 1 is refused"))
