;; three — a synthetic three-step playbook for test/playbook.test.mjs: one read, one act (standing press), one mind job.
(playbook (id "three") (version 1) (cart "three") (type "respond")
  (trigger (every 60))
  (press "standing")
  (may files trash)
  (never "a fourth step")
  (minds (gist (job "condense") (level "L2")))
  (steps
    (step 1 (unit "files") (args "(scratch)") (deadline-s 10) (done "rows"))
    (step 2 (unit "trash") (args "(path)") (deadline-s 10) (done "moved"))
    (step 3 (unit "gist") (args "condense the rows to one line") (deadline-s 30) (done "one line"))
  )
  (judgment "none")
  (done-check "three receipts, every one exit 0")
  (exam "the stubbed hands and mind answer; the record shows 3 rows, 3 receipts, 2 grades, 1 served")
  (report (step) (receipt) (grade)))
