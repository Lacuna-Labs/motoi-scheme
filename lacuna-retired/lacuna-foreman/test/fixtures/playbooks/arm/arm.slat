;; arm — step 2 may fail; step 3 is the failure arm and runs only then; step 4 runs only on P0 rows.
(playbook (id "arm") (version 1) (cart "arm") (type "respond")
  (trigger (every 60))
  (press "standing")
  (may files trash port ask)
  (steps
    (step 1 (unit "files") (args "(scratch)") (deadline-s 10) (done "rows"))
    (step 2 (unit "trash") (args "(path)") (deadline-s 10) (done "moved"))
    (step 3 (unit "port") (args "(1139)") (deadline-s 5) (done "listening") (when "any step fails"))
    (step 4 (unit "ask") (args "the owner names what to clear") (deadline-s 0) (done "named") (when "P0"))
  )
  (done-check "moved, or the arm ran"))
