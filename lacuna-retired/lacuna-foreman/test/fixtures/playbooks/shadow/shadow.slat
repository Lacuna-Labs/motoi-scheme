;; shadow — a Check type with one act: shadow by default until the press; the act is a `would` row, the read runs.
(playbook (id "shadow") (version 1) (cart "shadow") (type "check")
  (trigger (every 60))
  (press "none")
  (may files trash)
  (steps
    (step 1 (unit "files") (args "(scratch)") (deadline-s 10) (done "rows"))
    (step 2 (unit "trash") (args "(path)") (deadline-s 10) (done "moved") (each "row"))
  )
  (done-check "the read ran; nothing acted"))
