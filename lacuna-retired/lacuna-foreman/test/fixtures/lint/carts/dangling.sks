;; lint fixture: dangling
(lacuna-cart 'dangling
  '((does . "reads the disk once and reports it (dangling)")
    (version . 1)
    (restart . temporary)
    (deadlines . ((hand . 60)))
    (contract . ((goal . "reads the disk once") (done-check . "(string? answer)")))
    (sentry . ())
    (agent . ((tier . watch) (verbs . (on hand report done))))
    (touches . ("disk"))
    (done . "one read")
    (exam . U-nowhere)))
(define (start) (hand 'disk))
(on 'hand (lambda (r) (report 'disk (get r 'result '())) (done "one read")))
