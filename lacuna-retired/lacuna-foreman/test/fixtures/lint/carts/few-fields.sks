;; lint fixture: few-fields
(lacuna-cart 'few-fields
  '((does . "reads the disk once and reports it (few-fields)")
    (version . 1)
    (restart . temporary)
    (deadlines . ((hand . 60)))
    (sentry . ())
    (agent . ((tier . watch) (verbs . (on hand report done))))
    (touches . ("disk"))
    (done . "one read")
    (exam . U-few-fields)))
(define (start) (hand 'disk))
(on 'hand (lambda (r) (report 'disk (get r 'result '())) (done "one read")))
