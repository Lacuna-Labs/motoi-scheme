;; lint fixture: dup-handler
(lacuna-cart 'dup-handler
  '((does . "reads the disk once and reports it (dup-handler)")
    (version . 1)
    (restart . temporary)
    (deadlines . ((hand . 60)))
    (contract . ((goal . "reads the disk once") (done-check . "(string? answer)")))
    (sentry . ())
    (agent . ((tier . watch) (verbs . (on hand report done))))
    (touches . ("disk"))
    (done . "one read")
    (exam . U-dup-handler)))
(define (start) (hand 'disk))
(on 'hand (lambda (r) (report 'disk 1)))
(on 'hand (lambda (r) (done "one read")))
