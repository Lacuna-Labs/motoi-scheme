;; lint fixture: drift
(lacuna-cart 'drift
  '((does . "reads the disk once and reports it (drift)")
    (version . 1)
    (restart . temporary)
    (deadlines . ((hand . 60)))
    (contract . ((goal . "reads the disk once") (done-check . "(string? answer)")))
    (sentry . ())
    (agent . ((tier . watch) (verbs . (on hand mind-job mind done))))
    (minds . ((label . ((job . signal->label) (labels . (noise real-error)) (untrusted . #t)))))
    (touches . ("disk"))
    (done . "one read")
    (exam . U-drift)))
(mind-job 'label '(:ask "label it" :needs (line) :labels (noise real-error new-thing) :untrusted #t))
(define (start) (hand 'disk))
(on 'hand (lambda (r) (mind 'label (list (list 'line "x")))))
(on 'mind (lambda (m) (done "one read")))
