;; nightly-rehearsal — the nightly ten-job rehearsal as a watch cart (docs/LACUNA-1.0-POLISH-PASS.md §5.2; TEN-JOBS-2026-10-27).
;; Once a night (every 86400 s) the cart calls `(hand 'ten-rehearsal)`, which runs all ten canonical SRE jobs on
;; `eval:rehearsal-*` sessions through their real `.slat` ladders (`WATCHDOG-RED`, `DISK`, `CART-REPAIR`, `QA-DOWN`,
;; `ERROR-SPIKE`, `WORK-ORDERS`, `HOTFIX`, `RELEASE`, `GAME-ROOM`, `BACKUP`) and mechanical `done-check` forms.
;; Rules:
;;   1. One `(report 'info …)` row per job (`job`, `playbook`, `session`, `outcome`, `steps`, `latch-closed`).
;;   2. One `(report 'warn …)` row for any job whose outcome is not `"pass"`, naming its `job`, `playbook` and mechanical `why`.
;;   3. One `(report 'info …)` summary row (`summary: "ten-rehearsal"`, `at`, `total`, `passed`, `failed`).
;;   4. Tier `watch`: the cart never acts and never pages; every rehearsal session is prefixed `eval:rehearsal-` (Law 8).
;; U-rehearsal: a 10/10 passing night, a 9/10 night with one failing job (one warn naming why), and a read that does not answer.
(lacuna-cart 'nightly-rehearsal
  '((does . "rehearses the ten SRE jobs every night on eval:rehearsal-* sessions through their ladders and done-checks; reports each job, warns with the mechanical why on any failure, and summarizes passed/failed; never acts or pages")
    (version . 1)
    (agent . ((tier . watch)
              (verbs . (on every hand report))))
    (restart . permanent)
    (deadlines . ((hand . 30)))
    (contract . ((goal . "every night, one report row per rehearsed job, a warn naming why when any job fails, and one summary row")
                 (done-check . "a standing cart: ten job info rows and one summary info row each night, a warn per failure; zero acts and zero pages")))
    (sentry . ())
    (touches . ("world:rehearsal"))
    (done . "a standing cart: it runs until the owner stops it")
    (exam . U-rehearsal)))

(define day-s 86400)

(define (job-row row)
  (let ((id (get row 'id ""))
        (pb (get row 'playbook ""))
        (outcome (get row 'outcome "")))
    (report 'info
            (list (list 'job id)
                  (list 'playbook pb)
                  (list 'session (get row 'session ""))
                  (list 'outcome outcome)
                  (list 'steps (get row 'stepCount 0))
                  (list 'latch-closed (get row 'latchClosed #f))))
    (when (not (equal? outcome "pass"))
      (report 'warn
              (list (list 'row "rehearsal.failed")
                    (list 'job id)
                    (list 'playbook pb)
                    (list 'why (get row 'why "failed")))))))

(define (tick) (hand 'ten-rehearsal))
(define (start) (tick))
(every day-s tick)

(on 'hand (lambda (r)
  (if (get r 'ok #f)
      (let ((res (get r 'result '())))
        (map job-row (get res 'rows '()))
        (report 'info
                (list (list 'summary "ten-rehearsal")
                      (list 'at (get res 'at 0))
                      (list 'total (get res 'total 0))
                      (list 'passed (get res 'passed 0))
                      (list 'failed (get res 'failed 0)))))
      (report 'step (string-append "the ten-rehearsal read did not answer: " (get r 'why "no reason") "; tomorrow night reads again")))))

(on 'hand-timeout (lambda (x)
  (report 'step "the ten-rehearsal read overran its 30 s deadline; tomorrow night reads again")))
