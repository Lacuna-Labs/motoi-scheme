;; cart-lint — the cart-refactoring checker (architecture ch. 5 §5.10 row 8; §5.13.3 blueprint 1). One pass over the
;; carts tree: the `cart-lint` read runs `lacuna-foreman/carts/lint.mjs` (code: readCart, the body walk, the exam units,
;; the worker records, the last INDEX.slat) and answers its findings; this cart reports each one and a count by kind.
;; It holds no mind: the check is code, never a 270M (ch. 5 §5.13.1). It repairs nothing; repair-cart does, on a press.
;; U-lint: 10 planted faults, 10 found, 0 on a clean cart (test/carts.test.mjs; fixtures under test/fixtures/lint/).
(lacuna-cart 'cart-lint
  '((does . "reads every cart's header and body against the 3.0 rules and reports each fault with what to fix, counted by kind")
    (version . 2)
    (agent . ((tier . watch)
              (verbs . (on hand report remember recall done))))
    (restart . temporary)
    (deadlines . ((hand . 120) (cart . 600)))
    ;; done when its own lint reads 0 faults: the `cart-lint` read answered and its findings are none (a tree with a
    ;; fault ends the run `fail`, each fault reported); the count is the read's, never the said sentence
    (contract . ((goal . "every fault in the carts tree is named with its cart, its kind and what to fix")
                 (done-check . "(and (has 'cart-lint) (get cart-lint 'ok #f)
                                     (let ((fs (get (get cart-lint 'result '()) 'findings #f))) (and (list? fs) (null? fs))))")))
    (sentry . ())
    (touches . ("carts"))
    (done . "one pass over the carts tree: each fault reported, the count by kind said")
    (exam . U-lint)))

(define (start) (hand 'cart-lint))

;; (kind n) rows, one per kind, in the order first seen
(define (bump kind rows)
  (cond ((null? rows) (list (list kind 1)))
        ((equal? (car (car rows)) kind) (cons (list kind (+ 1 (car (cdr (car rows))))) (cdr rows)))
        (else (cons (car rows) (bump kind (cdr rows))))))

(define (said-counts rows)
  (string-join (map (lambda (r) (string-append (car r) " " (number->string (car (cdr r))))) rows) ", "))

(on 'hand (lambda (r)
  (if (not (get r 'ok #f))
      (done (string-append "stopped: the lint read did not answer (" (get r 'why "no reason") ")"))
      (let ((fs (get (get r 'result '()) 'findings '())))
        (for-each (lambda (f)
                    (remember 'kinds (bump (get f 'kind "?") (recall 'kinds '())))
                    (report 'fault (string-append (get f 'cart "?") " · " (get f 'kind "?") ": " (get f 'says ""))))
                  fs)
        (done (if (null? fs)
                  (string-append "0 faults in " (number->string (get (get r 'result '()) 'carts 0)) " carts")
                  (string-append (number->string (length fs)) " faults: " (said-counts (recall 'kinds '())))))))))
