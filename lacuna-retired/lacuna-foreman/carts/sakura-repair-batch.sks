;; sakura-repair-batch — the repair batch over E-sakura-repair, as a cart (design §12.4 rank 10, §12.6, §15 P7; architecture
;; ch. 5 §5.10 row 10, ch. 6 §6.10). It files one run per frozen slug under key `repair@<slug>` (`(file …)`, design §7.2):
;; each run is a worker with its own contract, its hands (reads of the cart and its history) and its acts (patch on
;; lacuna/<run>, strict, git-commit), driven by the brain's intents and ended by the foreman's done-check (law 6). This
;; cart never repairs and never judges: it keeps `width` runs in flight, follows each run's contract with
;; `(hand 'contract RUN)` every 30 s, files the next slug when one ends, re-files a failed slug once (attempt 2), and
;; counts tackled · right · first try from the contracts, never from a run's words. It reports `(report 'batch …)` on
;; every change; the desk's Automations tile reads the tile row. Self-stop (six-point gate, point 4): three stalls
;; (exit 99) in a row stop the batch and say so; the first-try floor (half the exam's rate over the last 50) waits on
;; the exam's first result and is not armed in version 1.
;; The sample sits between the `@frozen` markers: drawn once by tools/proof/freeze.mjs (seed "E-sakura-repair
;; 2026-10-23", 100 slugs from a pool of 3,626 across 17 kinds; needs-key and no-data-yet out before the run). A redraw
;; bumps the version. Every repair row is evaluation-only (law 9; §12.5): this cart produces no training row.
(lacuna-cart 'sakura-repair-batch
  '((does . "files one repair run per frozen E-sakura-repair slug, keeps eight in flight, follows each contract, and reports tackled, right and first try")
    (version . 2)
    (agent . ((tier . watch)
              (verbs . (on every hand file report remember recall done))))
    (restart . temporary)
    (deadlines . ((hand . 60) (cart . 43200)))
    ;; done when the task-receipts are all ok: its newest batch row says every frozen slug was tackled, none is open or queued,
    ;; and right <= ended, first try <= right; every `contract` read was answered ok and each task in its steps holds its
    ;; task-receipt with exit 0 (right and first try are counted from the contracts by the body, never from a run's words)
    (contract . ((goal . "every frozen slug is tackled once, a failed one twice at most, and the batch says tackled, right and first try from the contracts")
                 (done-check . "(let* ((rows (reported 'batch)) (t (if (null? rows) '() (car (cdr (car (reverse rows))))))
                                      (n (lambda (k) (get t k -1))))
                                 (and (pair? rows) (> (n 'frozen) 0) (= (n 'tackled) (n 'frozen)) (= (n 'open) 0) (= (n 'queued) 0)
                                      (<= (n 'right) (n 'ended)) (<= (n 'first-try) (n 'right))
                                      (= (get (answered 'contract) 'failed 0) 0)
                                      (null? (filter (lambda (s) (and (get s 'ticket #f) (not (eqv? (get (get s 'receipt '()) 'exit -1) 0))))
                                                     steps))))")))
    (sentry . ())
    (touches . ("runs" "carts/automations"))
    (done . "every slug's last run has ended, or three stalls in a row stopped the batch; the tile row is said either way")
    (exam . E-sakura-repair)))

(define width 8)                       ; runs in flight: the broker's run-foreman ceiling (design §10, WALL.runForemen)
(define attempts 2)                    ; a slug is filed at most twice; the second try is not a first try
(define stall-stop 3)                  ; exit 99 this many times in a row stops the batch (six-point gate, point 4)
(define follow-s 30)                   ; how often each open run's contract is read

