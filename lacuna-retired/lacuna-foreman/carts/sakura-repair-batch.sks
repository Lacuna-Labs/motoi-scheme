;; @frozen-end

;; ── small lists: rows are lists; the first item is the key ───────────────────────────────────────────────────────
(define (row-of k rows)
  (cond ((null? rows) #f) ((equal? (car (car rows)) k) (car rows)) (else (row-of k (cdr rows)))))
(define (without k rows) (filter (lambda (r) (not (equal? (car r) k))) rows))
(define (second r) (car (cdr r)))
(define (third r) (car (cdr (cdr r))))
(define (bump! k) (remember k (+ 1 (recall k 0))))
(define (n->s n) (number->string n))

;; ── the tile and the batch row ────────────────────────────────────────────────────────────────────────────────────
(define (tile)
  (string-append (n->s (recall 'tackled 0)) " tackled · " (n->s (recall 'right 0)) " right · " (n->s (recall 'first 0)) " first try"))
(define (say-batch)
  (report 'batch (tile)
          (list (list 'frozen (length e-sakura-repair)) (list 'tackled (recall 'tackled 0)) (list 'right (recall 'right 0))
                (list 'first-try (recall 'first 0)) (list 'ended (recall 'ended 0)) (list 'stalls (recall 'stalls 0))
                (list 'open (length (recall 'open '()))) (list 'queued (length (recall 'queue '()))))))

;; ── filing: one run per slug under repair@<slug>; the run's header names its hands and acts ────────────────────────
(define (goal-of slug kind attempt)
  (string-append "repair the Sakura cart " slug " so the strict check passes (its strict verdict today: " kind "; attempt " (n->s attempt)
                 "). Your checkout of curator is result 0's dir (runs/<run>/curator). Steps, each one call: "
                 "1 files {path: <dir>/carts/automations/" slug ", glob: *} · 2 read {path: <dir>/carts/automations/" slug "/<the .sks file>, n: 400} — read it ONCE, then write the patch · "
                 "3 patch {edits: [{file: \"carts/automations/" slug "/<the .sks file>\", find: \"<exact text in the file, once>\", replace: \"<the new text>\"}]} — literal edits, one find each; an empty find appends · 4 strict {slugs: [\"" slug "\"], quick: true} · "
                 "5 if strict reads works or works-model, git-commit {message: \"repair " slug "\"} and finish; else patch again (at most twice). "
                 "A cart passes strict when it ends with (done …) and never on a bare value; it may not call the network."))
;; the done-check is a FORM the foreman evaluates over the run's results (law 6; intents.mjs doneCheck): `strict` is the strict
;; act's last result, `(get strict 'rows)` its {ran passes of verdicts}; every slug passed and at least one was checked. A check in
;; words was the brain's own word and landed as `pass` on the ledger (2026-10-23). The touches fence (O-19/O-29, I-03) stops a
;; run that wrote outside carts/automations/<slug>/ before this is ever asked.
(define (check-of slug)
  "(let ((r (get strict 'rows #f))) (and r (> (get r 'of 0) 0) (= (get r 'passes 0) (get r 'of 0))))")

(define (file-one! item)
  (let* ((slug (car item)) (kind (second item)) (attempt (third item))
         (id (file (list (list 'key (string-append "repair@" slug)) (list 'cart "sakura-repair-batch")
                         (list 'goal (goal-of slug kind attempt)) (list 'done-check (check-of slug))
                         (list 'hands '(read files outline git-status git-log contract design))
                         (list 'acts '(patch strict git-commit)) (list 'intensity 'normal)
                         (list 'repo 'curator) (list 'touches (list (string-append "carts/automations/" slug "/**")))   ; the checkout at the filing (§8), the jail's touches (O-19)
                         (list 'press 'standing) (list 'hops 7)                                                 ; files · read · patch · strict · commit, with two to spare                                                                 ; T7: the proof's acts are pressed by this cart's word, recorded
                         (list 'evidence (string-append "E-sakura-repair · " kind))))))
    (cond ((not id)                                                   ; the kernel's ceiling: back on the queue, next tick
             (remember 'queue (cons item (recall 'queue '())))
             #f)
          (else
             (when (= attempt 1) (bump! 'tackled))
             (remember 'open (cons (list id slug attempt kind) (recall 'open '())))
             (report 'step (string-append "filed " slug " (attempt " (n->s attempt) ") as " id))
             #t))))

(define (fill!)
  (let ((q (recall 'queue '())))
    (when (and (not (null? q)) (< (length (recall 'open '())) width))
      (remember 'queue (cdr q))
      (when (file-one! (car q))                ; a refused filing (the kernel's ceiling) ends the fill: next tick (2026-10-24: fuel exhausted on a loop)
        (fill!)))))

;; ── following: each open run's contract, by its ticket ────────────────────────────────────────────────────────────
(define (follow)
  (for-each (lambda (o)
              (let ((t (hand 'contract (car o))))
                (remember 'tickets (cons (list t (car o)) (without t (recall 'tickets '()))))))
            (recall 'open '())))

(define (ended! o c)
  (let ((outcome (get c 'outcome "")) (code (get c 'exit -1)) (slug (second o)) (attempt (third o)))
    (remember 'open (without (car o) (recall 'open '())))
    (bump! 'ended)
    (cond ((equal? outcome "pass")
             (bump! 'right) (when (= attempt 1) (bump! 'first)) (remember 'in-row 0))
          (else
             (if (= code 99) (begin (bump! 'stalls) (bump! 'in-row)) (remember 'in-row 0))
             (when (< attempt attempts)
               (remember 'queue (cons (list slug (car (cdr (cdr (cdr o)))) (+ attempt 1)) (recall 'queue '()))))))
    (report 'step (string-append slug " ended: exit " (n->s code) ", outcome " outcome " (attempt " (n->s attempt) ")"))
    (say-batch)
    (cond ((>= (recall 'in-row 0) stall-stop)
             (done (string-append "stopped itself after " (n->s stall-stop) " stalls in a row: " (tile))))
          (else
             (fill!)
             (when (and (null? (recall 'open '())) (null? (recall 'queue '())))
               (done (tile)))))))

(on 'hand (lambda (r)
  (let* ((t (get r 'ticket "")) (pair (row-of t (recall 'tickets '()))))
    (remember 'tickets (without t (recall 'tickets '())))
    (when pair
      ;; the hands answer a read under `rows` (a contract read: the parsed task-state); a run whose contract does not read yet stays
      ;; open; only a NUMBER in its exit ends it here (2026-10-24: the field came back under `result` in the draft and null read as an exit)
      (let ((o (row-of (second pair) (recall 'open '()))) (c (get r 'rows (get r 'result '()))))
        (when (and o (get r 'ok #f) (number? (get c 'exit 'none)))
          (ended! o c)))))))

(on 'hand-timeout (lambda (x) (remember 'tickets (without (get x 'ticket "") (recall 'tickets '())))))

(define (start)
  (remember 'queue (map (lambda (s) (list (car s) (second s) 1)) e-sakura-repair))
  (report 'step (string-append "E-sakura-repair: " (n->s (length e-sakura-repair)) " frozen slugs, " (n->s width) " in flight"))
  (fill!)
  (say-batch))

(define (tick) (follow) (fill!))         ; every tick refills too: after a restart nothing else did (open 0, queue 91, 2026-10-24)
(every follow-s tick)
