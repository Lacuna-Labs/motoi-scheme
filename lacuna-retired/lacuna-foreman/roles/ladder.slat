;; ladder.slat — THE ROLE LADDER (ROLEBENCH-2.0 §2, §9 unit 8.1; the owner's notes of 2026-10-30, verbatim in
;; docs/eng/notes/ROLEBENCH-2.0-OWNER-NOTES-2026-10-30.md). Five roles by badge; each job function with the work on our box,
;; the skill a mind is briefed with, and the battery items that prove it. Every mind sits every function: a badge is a grid
;; column, never a mind. Each item names its grader: `mechanical` (a parse, a test run or a rule decides) or `rubric` (a judge
;; reads prose against named criteria; the screen sits it twice). `(screen <item>)` names the item the twenty-minute screen
;; sits for the function; `(job n)` marks the item that is step type n of the ten jobs (docs/eng/TEN-JOBS-2026-10-27.md).
;; Read by lacuna-foreman/grid-ledger.mjs (readRoleLadder); it lives in the foreman's tree because the foreman's jail reads it
;; there (the lead's ruling, MAIL 2026-10-30). Edit by hand, row by row against ROLEBENCH §2; the grid is never edited by hand.

(role (id se) (badge "SE") (name "SRE-SE, the systems engineer")
  (what "daemons and processes, the box's kernel, topology, capacity, monitoring, the customers, distributed reasoning"))
(role (id swe) (badge "SWE") (name "SRE-SWE, the software engineer")
  (what "systems code off the beaten path, the interfaces between the governor, the latch and the foreman, state machines, records"))
(role (id tpm) (badge "TPM") (name "the technical program manager")
  (what "owns a named thing so its work happens; understands the reasoning behind large choices; chops work; plans against gates"))
(role (id pe) (badge "PE") (name "the platform engineer")
  (what "the build and release cycle, the product we ship, platforms and the latest, compositions"))
(role (id pm) (badge "PM") (name "the project manager")
  (what "continuity of work, units of work; not the sentries: the PM gets work out, the sentries judge it"))

;; ── SRE-SE (§2.1) ──────────────────────────────────────────────────────────────────────────────────────────────────────
(function (role se) (id daemons) (name "daemons and processes")
  (work "the foreman, the hands, the door, the engine as services; launchd, the jail")
  (skill "lacuna-platform" "services.slat" "the restart discipline")
  (item (id se-daemons-1) (what "a stuck daemon from its log") (grader mechanical))
  (item (id se-daemons-2) (what "a wrong plist") (grader mechanical))
  (item (id se-daemons-3) (what "a socket that does not answer: is QA up, or which service fails") (grader mechanical) (job 4))
  (screen se-daemons-3))
(function (role se) (id kernel) (name "the kernel we have")
  (work "macOS: launchd, Mach memory, the sandbox profiles, Metal residency")
  (skill "the box profile" "the jail's rules" "the LME laws")
  (item (id se-kernel-1) (what "the memory refusal's arithmetic") (grader mechanical))
  (item (id se-kernel-2) (what "a sandbox denial read right") (grader mechanical))
  (item (id se-kernel-3) (what "a load cadence breach") (grader mechanical))
  (screen se-kernel-2))
(function (role se) (id topology) (name "topology")
  (work "sockets, the three ports, Caddy, the coordinate, the visitor edge")
  (skill "Category 6's map")
  (item (id se-topology-1) (what "a 400 from the wrong listener") (grader mechanical))
  (item (id se-topology-2) (what "a visitor route") (grader mechanical))
  (item (id se-topology-3) (what "the coordinate's prefix test") (grader mechanical))
  (screen se-topology-1))
(function (role se) (id capacity) (name "capacity")
  (work "the broker's prices, admission in bytes, swaps, the desk's queries per second; the disk")
  (skill "the box profile" "the engine's load reports")
  (item (id se-capacity-1) (what "does the 12B fit beside the desk: the arithmetic and the answer") (grader mechanical))
  (item (id se-capacity-2) (what "check the disk: free space and the plan, in numbers") (grader mechanical) (job 2))
  (screen se-capacity-2))
(function (role se) (id monitoring) (name "monitoring")
  (work "the floor's event log, the watchdogs, the golden signals")
  (skill "A1 the assay" "A2 the schema")
  (item (id se-monitoring-1) (what "a stale producer named: which watchdog is red, and its cause") (grader mechanical) (job 1))
  (item (id se-monitoring-2) (what "a page vs a ticket") (grader mechanical))
  (item (id se-monitoring-3) (what "an alarm flood collapsed") (grader mechanical))
  (screen se-monitoring-1))
(function (role se) (id customers) (name "the customers")
  (work "the ten jobs' product teams: Curator, the shops, the visitors' floor")
  (skill "the ten playbooks")
  (item (id se-customers-1) (what "a work order filed right") (grader mechanical))
  (item (id se-customers-2) (what "a done-check written") (grader mechanical))
  (screen se-customers-1))
(function (role se) (id distributed) (name "distributed reasoning")
  (work "the latch, tickets, receipts, exactly-once, the ledger's chain")
  (skill "SENTRY-2.0")
  (item (id se-distributed-1) (what "a broken chain found") (grader mechanical))
  (item (id se-distributed-2) (what "a replayed receipt refused") (grader mechanical))
  (screen se-distributed-2))

;; ── SRE-SWE (§2.2) ─────────────────────────────────────────────────────────────────────────────────────────────────────
(function (role swe) (id systems-code) (name "systems code off the beaten path")
  (work "the engine (C++20, Metal), the C++ runtime, the kernels")
  (skill "lacuna-code-style" "the LME-1.0 laws")
  (item (id swe-systems-code-1) (what "a kernel's held-out shape test") (grader mechanical))
  (item (id swe-systems-code-2) (what "a refused fusion with the measurement") (grader rubric))
  (screen swe-systems-code-1))
(function (role swe) (id interfaces) (name "the interface between the governor, the latch and the foreman")
  (work "the box governor, the latch compiling to the grammar, the verbs; a cart's header against its body")
  (skill "SENTRY-2.0" "Category 5")
  (item (id swe-interfaces-1) (what "a step grammar compiled from allows") (grader mechanical))
  (item (id swe-interfaces-2) (what "a drain sequence") (grader mechanical))
  (item (id swe-interfaces-3) (what "a cart that fails its strict check, repaired") (grader mechanical) (job 3))
  (screen swe-interfaces-3))
(function (role swe) (id state-machines) (name "state machines")
  (work "the fold, the statecharts, the contract's task-state, gen_statem")
  (skill "A3")
  (item (id swe-state-machines-1) (what "a transition table completed") (grader mechanical))
  (item (id swe-state-machines-2) (what "an on-delay chosen with its reason") (grader rubric))
  (item (id swe-state-machines-3) (what "fix the bug in a transition table so its tests pass") (grader mechanical) (job 7))
  (screen swe-state-machines-3))
(function (role swe) (id records) (name "records, never databases")
  (work "slat ledgers, hash chains, one reader")
  (skill "law 5" "the no-database rule")
  (item (id swe-records-1) (what "a ledger row written and verified") (grader mechanical))
  (item (id swe-records-2) (what "a chain break found") (grader mechanical))
  (item (id swe-records-3) (what "write a test for a ledger reader, and it passes") (grader mechanical) (job 6))
  (screen swe-records-3))
(function (role swe) (id modules) (name "the module discipline")
  (work "modules of at most 500 lines, headers, tests beside")
  (skill "lacuna-code-style")
  (item (id swe-modules-1) (what "a module split by responsibility") (grader mechanical))
  (item (id swe-modules-2) (what "a step over the proven size handed off, not attempted") (grader mechanical))
  (screen swe-modules-2))
(function (role swe) (id triage) (name "triage speed")
  (work "know the problem, categorize it, triage it, fix it")
  (skill "the role brief")
  (item (id swe-triage-1) (what "time to a correct classification on a log slice: the error, its source, the fix") (grader mechanical) (job 5))
  (screen swe-triage-1))

;; ── TPM (§2.3) ─────────────────────────────────────────────────────────────────────────────────────────────────────────
(function (role tpm) (id ownership) (name "owns a named thing so its work happens")
  (work "the floor, the engine, the sentries, Rolebench: each has an owner seat")
  (skill "the design docs" "the work order" "the road")
  (item (id tpm-ownership-1) (what "what is owed on X and in what order") (grader rubric))
  (item (id tpm-ownership-2) (what "a deficiency list from the record") (grader rubric))
  (screen tpm-ownership-1))
(function (role tpm) (id reasoning) (name "understands the reasoning behind large choices")
  (work "the categories' rulings and why")
  (skill "ROAD-TO-1.0")
  (item (id tpm-reasoning-1) (what "explain a ruling and its alternative") (grader rubric))
  (item (id tpm-reasoning-2) (what "find the ruling that contradicts a law") (grader mechanical))
  (screen tpm-reasoning-2))
(function (role tpm) (id chopping) (name "chops work")
  (work "work orders into runs into steps with ladders")
  (skill "the playbooks" "the ladder form")
  (item (id tpm-chopping-1) (what "a refactor chopped into steps with allows, gives, done and budget") (grader mechanical))
  (item (id tpm-chopping-2) (what "the 4B for everyday, the 26B for the long tail, the 31B tested as the thorough one") (grader rubric))
  (screen tpm-chopping-1))
(function (role tpm) (id gates) (name "plans against gates")
  (work "waves, gates, dependencies")
  (skill "the lanes table")
  (item (id tpm-gates-1) (what "a lane graph with no file claimed twice") (grader mechanical))
  (screen tpm-gates-1))

;; ── Platform engineer (§2.4) ───────────────────────────────────────────────────────────────────────────────────────────
(function (role pe) (id release) (name "the build and release cycle")
  (work "lacuna up, generated plists, the round, the PRR, the attic branch; the release cart")
  (skill "LME-SRE-SAFE" "Category 6")
  (item (id pe-release-1) (what "a rollback line written before a push") (grader mechanical))
  (item (id pe-release-2) (what "a release blocked by a red gate: each gate is the owner's press") (grader mechanical) (job 8))
  (screen pe-release-2))
(function (role pe) (id product) (name "the product we ship")
  (work "the launcher (Capsule 1.0), the visitors' floor, the iPad; a game or a page on its shelf")
  (skill "Category 6 D4")
  (item (id pe-product-1) (what "will this work on the iPad: the tier and the reason") (grader rubric))
  (item (id pe-product-2) (what "make a page that plays: one file, no network, it loads") (grader mechanical) (job 9))
  (screen pe-product-2))
(function (role pe) (id platforms) (name "platforms and the latest")
  (work "macOS, Safari, Metal, three, the GGUF line")
  (skill "the reference manual")
  (item (id pe-platforms-1) (what "a Safari regression found before it ships") (grader mechanical))
  (item (id pe-platforms-2) (what "a vendored upgrade's steps") (grader rubric))
  (screen pe-platforms-1))
(function (role pe) (id compositions) (name "compositions")
  (work "a 2B with a 1B and two 270Ms as one product")
  (skill "the roster")
  (item (id pe-compositions-1) (what "a composition's memory price and its sitting") (grader mechanical))
  (screen pe-compositions-1))

;; ── Project manager (§2.5) ─────────────────────────────────────────────────────────────────────────────────────────────
(function (role pm) (id continuity) (name "continuity of work")
  (work "the queue, the work orders' states, nothing parked without a why")
  (skill "work-orders.mjs" "the ledger")
  (item (id pm-continuity-1) (what "a parked order resumed with its context") (grader mechanical))
  (item (id pm-continuity-2) (what "a stalled run's next step") (grader rubric))
  (screen pm-continuity-1))
(function (role pm) (id units) (name "units of work")
  (work "every mind, every time it breaks work into steps")
  (skill "the ladder form")
  (item (id pm-units-1) (what "a step list that moves a done-check term each step") (grader mechanical))
  (item (id pm-units-2) (what "no interesting step that moves none") (grader mechanical))
  (screen pm-units-1))
(function (role pm) (id not-sentries) (name "not the sentries")
  (work "the PM gets work out; the sentries judge it")
  (skill "SENTRY-2.0")
  (item (id pm-not-sentries-1) (what "a run with a sentry warn finished right") (grader mechanical))
  (item (id pm-not-sentries-2) (what "a claim distinguished from a record: is the inbox notice real or stale") (grader rubric) (job 10))
  (screen pm-not-sentries-2))
