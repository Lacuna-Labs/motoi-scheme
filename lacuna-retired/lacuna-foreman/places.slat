;; places.slat — THE PLACES (LACUNA-ENGINEERING-1.0 §4; lane P1, unit P.1). Everything on the box has one place and a rule for
;; how long it stays, as data: the cleanup cart enforces the rules and reports every removal as a row (P.3; the first run under the
;; owner's press); the box.disk producer reads the places (P.7). One (place …) per place: its name; its path (`~` the owner's
;; home, `*` each folder at that level); what it holds; its rules in order: (keep …) is never removed, (remove …) is what a cart
;; may remove and when, (report …) is only said; who removes; and (create #t) when the place is ours to make on a first run. A
;; rule that needs a record to decide names it (needs …), and the planner says so instead of deciding by age alone. Read by
;; lacuna-foreman/places.mjs; its dry run by lacuna-foreman/places-due.mjs. The paths are the box's as found on 2026-11-01.

(place (name repos) (path "~/code/*") (holds "source only, each folder a git repository (the forge is a place of its own): builds and caches never live in a repo")
  (remove (what "build outputs git ignores") (globs "dist/" "build/" ".build/" "out/") (older-than-days 7))
  (removes cleanup-cart))

(place (name world) (path "~/lacuna-world") (holds "the world: carts, runs, ledgers, the foreman's state, drills, the floor's day files, transcripts")
  (keep (what "runs and verdicts") (by "R1's retention.slat, per ledger class"))
  (remove (what "the floor's day files") (under "floor") (older-than-days 7))
  (remove (what "drills") (under "drills") (older-than-days 30))
  (removes cleanup-cart) (create #t))

(place (name state) (path "~/.lacuna") (holds "state: sockets, logs, the jail, the library, the KV persist, the builds")
  (remove (what "logs") (under "logs") (older-than-days 14))
  (remove (what "builds past the last three per repo") (under "builds") (keep-last 3) (per repo))
  ;; the engine keeps the person's lane only and drops a session's file at its end (lme/src/engine/persist.hpp); a file of
  ;; another layout (another model, profile or context) is never read again: two days, then the cart (the finale's order §1.1b)
  (remove (what "KV persist files not the serving profile's") (under "kv") (globs "persist-*.lmekv") (older-than-days 2) (spare-tag "kv/serving-tag"))
  (keep (what "the record files at its root and the owner's threads with the minds (agents/)") (by "retention.slat, per class (2026-11-06, E14 row 10)"))
  (removes cleanup-cart) (create #t))

(place (name forge) (path "~/code/forge") (holds "the forge, every weight in one home: bases/<family>/<model>/, adapters/<name>/<version>/, weights/<name>/<version>/, runs/<run>/, data/<set>/, exams/ (the layout P.2 moves it into)")
  (keep (what "bases a current adapter names") (under "bases"))
  (keep (what "adapter versions a weight or a sitting names") (under "adapters"))
  (remove (what "adapter versions nothing names") (under "adapters") (older-than-days 90) (needs "the forge's records: what each weight and sitting names (P.2 lays them out)"))
  (keep (what "weights box.slat names") (under "weights"))
  (remove (what "weights box.slat never named") (under "weights") (older-than-days 30) (needs "box.slat's names and the forge's weight records (P.2)"))
  (keep (what "run records") (under "runs"))
  (remove (what "a run's checkpoints older than its last, once the run is recorded") (under "runs") (needs "each run's record and its last checkpoint (P.2)"))
  (removes cleanup-cart) (create #t))

(place (name backups) (path "~/lacuna-backups") (holds "the daily tarballs and the hourly world set")
  ;; fourteen, as the backup script keeps (2026-11-02): with no copy off the box (D8 is the owner's), the dailies are its only history
  (remove (what "dailies past the last fourteen") (globs "lacuna-*.tar.gz") (keep-last 14))
  (keep (what "the hourly world bundles") (under "world-hourly") (by "the backup cart's own rule, after its restore drill: the newest 3, plus the newest of each of the newest 3 days"))
  (removes cleanup-cart) (create #t))

(place (name ollama) (path "~/.ollama") (holds "the served models: only the tags box.slat or the forge's weights/ records name")
  (report (what "a tag no record names") (needs "box.slat's tags and the forge's weight records"))
  (removes owner))

(place (name caches) (path "~/.cache") (holds "regenerable caches: uv, Hugging Face; and beside them Playwright (~/Library/Caches/ms-playwright), Xcode (~/Library/Developer/Xcode/DerivedData) and CoreDevice (~/Library/Containers/com.apple.CoreDevice.CoreDeviceService)")
  (report (what "every cache's size") (paths "~/.cache/uv" "~/.cache/huggingface" "~/Library/Caches/ms-playwright" "~/Library/Developer/Xcode/DerivedData" "~/Library/Containers/com.apple.CoreDevice.CoreDeviceService") (every-days 7))
  (remove (what "the uv cache past 5 GB") (under "uv") (over-gb 5))
  (remove (what "the CoreDevice caches past 10 GB") (path "~/Library/Containers/com.apple.CoreDevice.CoreDeviceService/Data/Library/Caches") (over-gb 10))
  (keep (what "SigLIP in the Hugging Face cache") (under "huggingface/hub/models--google--siglip-base-patch16-224"))
  (removes cleanup-cart))
