;; cascade/rules.slat — THE CASCADE'S HARD RULES IN NATIVE SLATL
(rules
  (job 'signal->label :answer "label"
    (rule :field "line" :match ("Traceback \\(most recent call last\\)") :never ("noise")
          :why "a traceback is never noise")
    (rule :field "line" :match ("^\\s*([A-Za-z_][\\w.]*)?(Error|Exception)\\b") :never ("noise")
          :why "a line that opens with an exception is never noise")
    (rule :field "line" :match ("\\b(ERROR|CRITICAL|FATAL)\\b" "[A-Za-z_]\\w*(Error|Exception)\\b") :never ("noise")
          :why "an Error or Exception at error level is never noise"))
  (job 'command->verb :answer "verb")
  (job 'output->route :answer "label"))
