;; the foreman (lacuna.foreman), under its own jail profile (foreman.sb never changes, and nor does the node path it allows)
(launch (program "/usr/bin/sandbox-exec")
        (args "-f" "~/code/lacuna/lacuna-box/foreman/foreman.sb" "/opt/homebrew/Cellar/node/26.0.0/bin/node" "~/code/lacuna/lacuna-foreman/foreman.mjs")
        (cwd "~/code/lacuna/lacuna-foreman") (keep-alive #t) (throttle-s 5) (log "~/.lacuna/logs/foreman.log")
        (env (@ ("FOREMAN_NAME" "studio") ("HOME" "~"))))
