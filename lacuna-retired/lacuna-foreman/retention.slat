;; retention.slat — RETENTION AS DATA (lane R1, unit R1.7; ROLEBENCH-2.0 §7 "RAG compression, retention, audit"; the owner's
;; notes of 2026-10-30). One `(class …)` per ledger class: what it holds, where it lives (globs under the world and the state
;; dirs), how long a row stays (`(keep days)`, `(keep forever)`), what happens to a row past its time (`drop` writes one
;; `(dropped …)` row naming what went; `condense` replaces rows with a summary row that cites them; `forever` never drops), and
;; the cadence of the condense. The reader is retention.mjs; the weekly audit cart (memory-audit.sks, owed) reads this file and
;; never its own table. A class with no row here is kept forever and named by the audit as unruled. Days are whole days UTC.
(retention (version 2) (date "2026-11-06")
  (class floor-events (holds "the floor's (ev …) log, hash-chained day files and their keyframes")
    (paths "~/lacuna-world/floor/events-*.slat" "~/lacuna-world/floor/state-*.slat") (keep 7) (past drop))
  (class runs (holds "a run's folder: its receipts, its drive log, its record")
    (paths "~/lacuna-world/runs/w-*" "~/lacuna-world/foreman/ledger/runs.slat") (keep forever) (past forever))
  (class contracts (holds "a run's contract and its done-check")
    (paths "~/lacuna-world/runs/w-*/CONTRACT.slat") (keep forever) (past forever))
  (class verdicts (holds "the sentries' verdict rows with their evidence ids")
    (paths "~/lacuna-world/foreman/ledger/verdicts.slat") (keep forever) (past forever))
  (class grid (holds "the role grid's measured cells and its ledger half")
    (paths "~/lacuna-world/foreman/grid.slat" "~/lacuna-world/foreman/ledger/grid.slat") (keep forever) (past forever))
  (class conversation (holds "the owner's turns with every seat")
    (paths "~/.lacuna/conversation.jsonl") (keep 1) (past condense) (condense hourly (cites rows) (into "~/.lacuna/condensed.json")))
  (class sentry-evidence (holds "the sentries' evidence set: the rows the labelers and locators read")
    (paths "~/lacuna-world/sentry/*") (keep 90) (past drop))
  (class drills (holds "the floor's drills and their rows")
    (paths "~/.lacuna/drills.jsonl") (keep 30) (past drop))
  ;; 2026-11-06 (order E14 row 10; records-10): the record files at the state root and the owner's threads with the minds had no
  ;; class, so the audit named them unruled and no rule said what stays. Each file is named, never a `~/.lacuna/*` glob: a glob's
  ;; folder is walked whole, and the logs, the jail and the KV files would be named unruled in their turn.
  (class owner-threads (holds "the owner's threads with each mind and their project marks: his words, kept like the conversation")
    (paths "~/.lacuna/agents") (keep forever) (past forever))
  (class acts (holds "what was done and by whom: the audit trail, the owner's acts and commitments, the forge's decisions, the cloud's spend")
    (paths "~/.lacuna/audit.jsonl" "~/.lacuna/owner-acts.jsonl" "~/.lacuna/commitments.jsonl"
           "~/.lacuna/forge-decisions.jsonl" "~/.lacuna/cloud-ledger.jsonl") (keep forever) (past forever))
  (class errors (holds "the error store and its old log")
    (paths "~/.lacuna/errors.db" "~/.lacuna/errors.jsonl") (keep 90) (past drop))
  (class telemetry (holds "timings and samples the panels read; a file unwritten for 30 days is past its time")
    (paths "~/.lacuna/hand-times.jsonl" "~/.lacuna/ui-times.jsonl" "~/.lacuna/minds-live.jsonl"
           "~/.lacuna/map-history.jsonl" "~/.lacuna/brain-cache.jsonl" "~/.lacuna/calls.jsonl" "~/.lacuna/certainty.jsonl"
           "~/.lacuna/foreman-events.jsonl" "~/.lacuna/sessions.jsonl" "~/.lacuna/notices.jsonl") (keep 30) (past drop))
  (class state (holds "the state the services rewrite in place, one value each and never rows: settings, grants, pairings, seats, plans, marks")
    (paths "~/.lacuna/acts-done.json" "~/.lacuna/alert-state.json" "~/.lacuna/boot.json" "~/.lacuna/box.json"
           "~/.lacuna/brain-profile.json" "~/.lacuna/caliper-run.json" "~/.lacuna/cart-grants.json"
           "~/.lacuna/claude-chat.json" "~/.lacuna/cloud-sight.json" "~/.lacuna/condensed.json" "~/.lacuna/desk-seen.json"
           "~/.lacuna/desk.json" "~/.lacuna/disk-plan.json" "~/.lacuna/disk-rules.json" "~/.lacuna/embed.json"
           "~/.lacuna/forge-seen.json" "~/.lacuna/home-board.json" "~/.lacuna/ipad-refresh.json"
           "~/.lacuna/jobs-runner.json" "~/.lacuna/jobs-said.json" "~/.lacuna/last-model.json" "~/.lacuna/limits.json"
           "~/.lacuna/mode.json" "~/.lacuna/notify.json" "~/.lacuna/owner-devices.json" "~/.lacuna/owner-pairing.json"
           "~/.lacuna/petitions.json" "~/.lacuna/proof-last.json" "~/.lacuna/rulings-imported.json"
           "~/.lacuna/run-grants.json" "~/.lacuna/seats-ui.json" "~/.lacuna/sentinel-baseline.json"
           "~/.lacuna/terminal-seats.json" "~/.lacuna/wake-pending.json" "~/.lacuna/work-order.json"
           "~/.lacuna/workers.json") (keep forever) (past forever)))
