(document
  :name  "restructure-report-2026-07-16"
  :date  "2026-07-16"
  :owner "The Engineer"

  :inputs
  ("lacuna-labs/design-docs/architect-motoi-core-vs-module-2026-07-16.slat"
   "motoi-scheme/scratch/motoi-core-verbs-list.slat"
   "motoi-scheme/scratch/motoi-module-packages.slat")

  :terminology-lock
  "'modules' NOT 'extensions' — per Alfred's hour-12b lock. Folder is
   motoi-scheme/modules/, not extensions/.")

;; ================================================================
;; PHASE 1 — CORE split
;; ================================================================

(phase-1-core
  :status "landed"
  :outcome "CORE-first invariant established; 322-verb (+15 K-6 → 337) partition wired via new core/ entry."

  :files-created
  ("motoi-scheme/core/core-verbs.js — the 337-verb CORE_VERBS Set (source of truth for CORE partition)"
   "motoi-scheme/core/index.js — installCore(env) + makeCoreEnv() + coreCoverage() introspection")

  :files-modified
  ("motoi-scheme/src/lib-loader.js — installLibs now calls installCore first, then adds 4 module installers"
   "motoi-scheme/src/index.js — exports installCore/makeCoreEnv/CORE_VERBS/coreCoverage/isCore"
   "motoi-scheme/tests/wave-2-lib-loader.test.mjs — spot-check module names updated to core/*/module/* prefix")

  :core-declared-verbs 337
  :core-declared-note
  "322 from architect list + 15 K-6 pedagogy verbs (math/area-model,
   math/place-value etc.) that Alfred locked as CORE 2026-07-16."

  :core-actually-present-in-env 78
  :core-gap-note
  "259 CORE verbs are declared in the reference/core-verbs.js registry
   but not yet implemented in lib/*. Pre-existing engineering gap — the
   restructure did NOT delete any implementation; missing verbs were
   missing before Phase 1 too. The Sakura reference has always been
   ahead of the runtime; Motoi inherits that gap.

   No regression: extended env still holds 573 verbs (17 installers,
   0 failed). CORE partition tags what SHOULD be in CORE; runtime
   implementation catches up in subsequent lanes."

  :core-installer-count 13
  :core-installers
  ("core/base/r7rs-small" "core/base/alg" "core/graphics/sprite"
   "core/graphics/easing" "core/graphics/text" "core/media/media"
   "core/game/game" "core/graphics/animation" "core/game/game-instances"
   "core/game/scene" "core/ai/ai" "core/system/system" "core/system/time-verbs"))

;; ================================================================
;; PHASE 2 — Cruft archive
;; ================================================================

(phase-2-cruft
  :status "landed (documentation + partial reference strip)"
  :outcome "Cruft archive folder authored with disposition records for 55 BUCKET-1 verbs."

  :files-created
  ("motoi-scheme/_archive/cruft-2026-07-16/README.slat — full disposition record")

  :bucket-1-cruft-count 55
  :cruft-categories
  (("redundant-constants" 4 "const/ln2 const/ln10 const/sqrt2 const/sqrt3")
   ("orphan-single-verb-libs" 4 "floor/problem? route/off-domain domain/of weather/conjure")
   ("reference-duplicates" 20 "big-bang game/state game/step game/frame game/stop entity/state matrix/{determinant,identity,rows,multiply,add,sub} linalg/{eigenvalues,inverse,gram-schmidt,characteristic-poly,vec-add} after sprite sprites")
   ("cross-lib-non-canonical" 3 "const/{pi,e,tau} — math/{pi,e,tau} kept canonical")
   ("misc-small-aliases" 24 "note-dots, misspelled variants, one-off aliases without runtime binding"))

  :reference-stripping
  "Physical stripping of 55 individual verb records from
   MOTOI-SCHEME-REFERENCE.slat is queued as a follow-up. Per the
   Architect's cruft-disposition doctrine ('archive from ship, keep in
   the reference SLAT under an :archived flag with :provenance pointer.
   NEVER delete'), the records will be marked with :archived not removed.
   The archive README fully specifies which records get the flag."

  :runtime-impact "None — cruft removal is corpus-scope-only, not runtime-verb removal.")

;; ================================================================
;; PHASE 3 — Sakura-dialect relocation (BUCKET 2)
;; ================================================================

(phase-3-sakura
  :status "landed"
  :outcome "5 surface/* verbs relocated from Motoi to Sakura dialect."

  :files-created
  ("sakura-scheme/docs/SAKURA-DIALECT-REFERENCE.slat — first pass of Sakura's own dialect reference")

  :files-modified
  ("motoi-scheme/scheme/MOTOI-SCHEME-REFERENCE.slat — surface library section (lines 14598-14688) replaced with relocation pointer")

  :verbs-relocated 5
  :verbs "surface/curtain, surface/describe, surface/digest, surface/dim, surface/spotlight"
  :implementation-note
  "surface/* verbs were reference-only in Motoi — no lib/*/surface.js
   existed. Relocation is a pure reference move + Sakura authorship.
   No runtime code moved (there wasn't any). Programs previously calling
   surface/* would have failed at runtime anyway; going forward they
   declare #!dialect sakura or (import (sakura surface)).")

;; ================================================================
;; PHASE 4 — Duplicate canonicalization (BUCKET 3)
;; ================================================================

(phase-4-duplicates
  :status "landed (alias registry authored)"
  :outcome "Canonical mapping documented for 9 cross-library aliases + 20 reference-duplicate records."

  :files-created
  ("motoi-scheme/scheme/REFERENCE-ALIASES.slat — canonical name mapping for the training-pair generator and RAG lookup")

  :aliases-declared 9
  :aliases
  (("const/pi -> math/pi") ("const/e -> math/e") ("const/tau -> math/tau")
   ("nt/gcd -> math/gcd") ("nt/lcm -> math/lcm")
   ("matrix/multiply -> matrix/*") ("matrix/add -> matrix/+") ("matrix/sub -> matrix/-")
   ("linalg/vec-add -> vec/+"))

  :reference-duplicates-declared 20
  :runtime-impact
  "None — both alias and canonical remain callable. Docs-emitter and
   training-pair-generator route through the canonical name. Reference-
   duplicate records unchanged in the SLAT; the alias registry tells
   downstream tools which is the primary.")

