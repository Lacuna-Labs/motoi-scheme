;;; pass-3-wave-1-report-2026-07-16.slat
;;;
;;; Migration report — Motoi Pass-3 Wave 1 (lib migration, leaf modules).
;;;
;;; Executed 2026-07-16 by The Engineer (Opus 4.7).
;;; Per Alfred's greenlight; per design doc:
;;;   /Users/alfred/code/lacuna-labs/design-docs/architect-motoi-pass-3-lib-migration-2026-07-16.slat
;;;
;;; Purpose: extract leaf lib modules from scheme-lang/src/ into
;;; motoi-scheme/lib/ so Motoi ships graphics/audio/game/media/ai/system
;;; libraries alongside the runtime — unblocking the "examples don't
;;; work" ROADMAP.slat gap #1 (breakout, play, etc).

(migration-report
  :n           "pass-3-wave-1-report-2026-07-16"
  :author      "The Engineer (Opus 4.7)"
  :date        "2026-07-16"
  :status      :complete
  :audience    :engineering
  :dialect     :motoi
  :provenance  (:design "lacuna-labs/design-docs/architect-motoi-pass-3-lib-migration-2026-07-16.slat"
                :roadmap "motoi-scheme/ROADMAP.slat gap #1"
                :first-pass "motoi-scheme/MOTOI-FIRST-PASS.slat"))

;; ---------------------------------------------------------------------------
;; 1. FILES MIGRATED — 21 leaf modules + 1 adapter + 1 shim = 23 new files
;; ---------------------------------------------------------------------------

(files-migrated
  :count 23

  :lib/base
    (("r7rs-types.js"    :from "scheme-lang/src/r7rs-types.js"    :status :ok :sakura-neutralized :none)
     ("r7rs-small.js"    :from "scheme-lang/src/r7rs-small.js"    :status :ok :sakura-neutralized :header+decisions+Ch-inlined)
     ("alg.js"           :from "scheme-lang/src/alg.js"           :status :ok :sakura-neutralized :header)
     ("topo.js"          :from "scheme-lang/src/topo.js"          :status :ok :sakura-neutralized :header))

  :lib/graphics
    (("framebuffer.js"   :from "scheme-lang/src/framebuffer.js"   :status :ok :sakura-neutralized :mode-alias+palette-comment)
     ("animation.js"     :from "scheme-lang/src/animation.js"     :status :ok :sakura-neutralized :header)
     ("sprite.js"        :from "scheme-lang/src/sprite.js"        :status :ok :sakura-neutralized :header-only
       :notes "'blossom' default color-name preserved as public verb signature; changing it would break Sakura-dialect scripts."))

  :lib/audio
    (("sound.js"         :from "scheme-lang/src/sound.js"         :status :ok :sakura-neutralized :env-var-renamed
       :notes "process.env.SAKURA_SOUND check → process.env.MOTOI_SOUND ?? process.env.SAKURA_SOUND (backwards-compat).")
     ("audio-driver.js"  :from "scheme-lang/src/audio-driver.js"  :status :ok :sakura-neutralized :tmpfile-prefix
       :notes "tmp file 'sakura-tone-<pid>.wav' → 'motoi-tone-<pid>.wav'."))

  :lib/game
    (("game-theory.js"   :from "scheme-lang/src/game-theory.js"   :status :ok :sakura-neutralized :header)
     ("game-instances.js":from "scheme-lang/src/game-instances.js":status :ok :sakura-neutralized :header)
     ("juggle.js"        :from "scheme-lang/src/juggle.js"        :status :ok :sakura-neutralized :header)
     ("prefab.js"        :from "scheme-lang/src/prefab.js"        :status :ok :sakura-neutralized :comment)
     ("scene.js"         :from "scheme-lang/src/scene.js"         :status :ok :sakura-neutralized :global-slot
       :notes "globalThis.__sakura_scene_spawn_id__ → __motoi_scene_spawn_id__. Internal only.")
     ("game.js"          :from "scheme-lang/src/game.js"          :status :ok :sakura-neutralized :header
       :notes "media.js import rewired to '../media/media.js'. 'blossom' default color preserved as public arg."))

  :lib/media
    (("media.js"         :from "scheme-lang/src/media.js"         :status :ok :sakura-neutralized :cart-header-string
       :notes "framebuffer.js/sound.js/animation.js imports rewired across lib subdirs. Cart-snapshot header comment 'sakura scheme cart snapshot' → 'motoi scheme cart snapshot'. slatToCart still reads legacy snapshots (keys on '#!json-blob', not the comment)."))

  :lib/ai
    (("ai.js"             :from "scheme-lang/src/ai.js"           :status :ok :sakura-neutralized :dialect-refs
       :notes "Header refs to 'Sakura runtime, Curator, Lacuna Engineering' generalized to 'downstream dialects'. Provider seam (setAiProvider) untouched."))

  :lib/system
    (("system.js"        :from "scheme-lang/src/system.js"        :status :ok :sakura-neutralized :header
       :notes "_sakuraStub property protocol preserved — cross-file marker used by base.js/verbStatus.js/autocomplete.js; renaming is a repo-wide refactor deferred.")
     ("time-verbs.js"    :from "scheme-lang/src/time-verbs.js"    :status :ok :sakura-neutralized :ref-path
       :notes "docs/SAKURA-SCHEME-REFERENCE.slat citations updated to MOTOI-SCHEME-REFERENCE.slat.")
     ("eng.js"           :from "scheme-lang/src/eng.js"           :status :ok :sakura-neutralized :env-factory-ref)
     ("ops.js"           :from "scheme-lang/src/ops.js"           :status :ok :sakura-neutralized :none
       :notes "registry.js import points to Wave-1 shim (see registry.js entry below); full reference-gated registration returns in Wave 2+.")
     ("registry.js"      :from "scheme-lang/src/registry.js (registerPrimitive fragment)" :status :ok :type :shim
       :notes "Wave-1 shim. Provides registerPrimitive that delegates to env.define. Alfred's floor doctrine preserved: no auto-stub bypass — the reference-gate is ADDED in Wave 2+ when reference-loader.js migrates."))

  :adapters/
    (("base.js"          :from "scheme-lang/src/adapters.js"      :status :ok :sakura-neutralized :header
       :notes "Interface + 14 no-op stubs — the SHAPE per architect design. Sakura provides overrides via setAdapters() at boot.")))

;; ---------------------------------------------------------------------------
;; 2. ADAPTER SHAPE
;; ---------------------------------------------------------------------------

(adapter-shape
  :path "motoi-scheme/adapters/base.js"
  :size-lines ~105
  :seams 14

  :seam-list
    (emit
     _setCurrentCaller
     _getCurrentCaller
     canvasPowerGetTier      ;; default returns 'operator'
     chipWrite
     chipEvent
     logEvent
     currentCorrelationId    ;; default returns null
     withCorrelation         ;; default: (id, fn) => fn()
     mintCorrelationId       ;; default: fresh random string
     chatChipPublish
     bricklayCacheKey        ;; default returns ''
     bricklayCacheGet        ;; default returns null
     bricklayCacheSet)

  :api
    (setAdapters
     getAdapters
     "+ named exports for every seam that resolve state at call time")

  :behavior
    "All 14 seams default to no-ops (or 'nothing happened' sentinels).
     Motoi programs run standalone with zero host wiring. A downstream
     dialect calls setAdapters({...}) once at boot to inject its
     runtime services; the named exports pick up the override
     immediately, even for modules that imported before boot.")

;; ---------------------------------------------------------------------------
;; 3. SAKURA-BRAND ITEMS NEUTRALIZED
;; ---------------------------------------------------------------------------

(sakura-brand-neutralized
  :cherry-blossom-glyph "None found in Wave 1 target files. Verified by test: tests/pass-3-wave-1-smoke.test.mjs walks every migrated .js and asserts no '✿'."
  :cherry-blossom-hex-codes "No hex color codes tied to a Sakura identity found; palette in framebuffer.js is PICO-8's 16-color set. Kept as neutral default; pink at index 14 is generic (comment 'Sakura's petal' stripped to 'pink')."
  :dot-sakura-paths "None in Wave 1 files. (~/.sakura paths are all in ide/*, repl/*, which are Wave 2/3.) Verified by test."

  :other-brand-items-neutralized
    ((:file "lib/graphics/framebuffer.js"
       :changes ("MODES.default introduced as canonical; MODES.sakura kept as backwards-compat alias."
                 "Palette entry 14 comment '// pink — Sakura's petal' → '// pink'."
                 "Constructor comment 'Defaults to sakura petal (14)' → 'Defaults to palette entry 14 (pink)'."))

     (:file "lib/graphics/sprite.js"
       :changes ("Header 'A Sakura sprite is NOT a bitmap' → 'A Motoi sprite is NOT a bitmap'."
                 "'blossom' default color-name PRESERVED (public verb signature)."))

     (:file "lib/game/scene.js"
       :changes ("globalThis.__sakura_scene_spawn_id__ → __motoi_scene_spawn_id__. Internal only."))

     (:file "lib/audio/audio-driver.js"
       :changes ("tmpfile prefix 'sakura-tone-' → 'motoi-tone-'."))

     (:file "lib/audio/sound.js"
       :changes ("process.env.SAKURA_SOUND !== 'off' → process.env.MOTOI_SOUND ?? process.env.SAKURA_SOUND !== 'off' (backwards-compat)."))

     (:file "lib/media/media.js"
       :changes ("Cart-snapshot header string '; sakura scheme cart snapshot' → '; motoi scheme cart snapshot'."
                 "Legacy snapshots still load (parser keys on '#!json-blob' marker, not on the comment)."))

     (:file "lib/base/r7rs-small.js"
       :changes ("Doctrine header: 'Sakura Scheme aims for R7RS-small compliance' → 'Motoi Scheme aims for R7RS-small compliance'."
                 "Error messages: 'not supported in Sakura Scheme' → 'not supported in Motoi Scheme'."
                 "features symbol: (sym 'sakura-scheme') → (sym 'motoi-scheme')."
                 "Inlined a private Ch class since motoi-scheme/src/reader.js does not (yet) export Ch/ch. Follow-up: port Ch/ch into motoi's reader so all consumers share the interned registry."))

     (:file "lib/ai/ai.js"
       :changes ("Header: 'The interface Sakura Scheme scripts use' → 'The interface Motoi Scheme scripts use'."
                 "Provider-seam docs generalized from '(Sakura runtime, Curator, Lacuna Engineering) call setAiProvider' → 'Downstream dialects call setAiProvider'."
                 "config path 'scheme-lang.config.slat' → 'motoi.config.slat'."))

     (:file "lib/system/time-verbs.js"
       :changes ("Ref path 'docs/SAKURA-SCHEME-REFERENCE.slat' → 'MOTOI-SCHEME-REFERENCE.slat'."))

     (:file "lib/base/alg.js"
       :changes ("Header ref to 'makeSakuraEnv' → 'any downstream env factory'."))

     (:file "lib/system/eng.js"
       :changes ("Header ref to 'makeBaseEnv and makeSakuraEnv' → 'any downstream env factory'."))

     (:file "lib/game/prefab.js"
       :changes ("Comment 'Might be a plain object OR a Sakura record' → 'plain object OR a dialect record'."))

     (:file "lib/game/game.js"
       :changes ("Header note added; 'blossom' default color-arg preserved (public signature).")))

  :items-deliberately-preserved
    ((:item "_sakuraStub property protocol"
       :reason "Cross-file marker used by base.js, verbStatus.js, autocomplete.js (all in scheme-lang and motoi-scheme sides). Renaming to _motoiStub is a repo-wide refactor — deferred to a coordinated pass. Wave-1 files that touch it (alg.js:265, system.js:212) leave the property name intact.")

     (:item "'blossom' color-name (sprite.js, game.js)"
       :reason "Public verb signature: (sprite 'ball 40 40 'blossom) is documented behavior. Changing it silently would break existing Sakura-dialect scripts. Kept.")

     (:item "MODES.sakura alias (framebuffer.js)"
       :reason "Backwards-compat with (fb-mode 'sakura) calls in Sakura scripts. Now aliased to same value as 'default; both work."))

  :items-not-in-scope
    "Reference-manual filename (SAKURA-SCHEME-REFERENCE.slat vs MOTOI-SCHEME-REFERENCE.slat) — updated in time-verbs.js citation; other references are in files not yet migrated (reference-loader.js is Wave 2).")

;; ---------------------------------------------------------------------------
;; 4. HERMETIC-VERIFICATION RESULTS
;; ---------------------------------------------------------------------------

(hermetic-verification
  :goal "Verify motoi-scheme/src/dispatch.js no longer imports from sakura-scheme sibling paths (Architect design finding)."

  :actual-status :NOT-HERMETIC-CONFIRMED

  :evidence
    "grep -E '^import.*\\.\\.\\/\\.\\.' motoi-scheme/src/dispatch.js returns 6 non-hermetic imports:
       import { emit } from '../../lib/logbus.js'
       import { _setCurrentCaller, _getCurrentCaller } from '../../surface/card-api/index.js'
       import { getTier as canvasPowerGetTier } from '../../lib/canvasPower.js'
       import { write as chipWrite } from '../../lib/chipSink.js'
       import { chipEvent } from '../../lib/chipEvent.js'
       import { publish as chatChipPublish } from '../../lib/chatChipBus.js'"

  :root-cause
    "motoi-scheme/src/dispatch.js was direct-copied from sakura-scheme/scheme-lang/src/runtime/dispatch.js in Pass-1 without adapter-substitution. All 6 sibling paths are Sakura-runtime services that MUST be injected via the new motoi-scheme/adapters/base.js interface."

  :fix-scope
    "Wave 5 per the architect design doc. Wave-1 scope is leaf-lib migration; dispatch.js decoupling is a distinct workstream that:
       (a) rewrites dispatch.js to import from '../../adapters/base.js' (now landed)
       (b) sakura-scheme calls setAdapters({emit, _setCurrentCaller, ...}) at boot
       (c) seal-test: rm -rf ~/code/sakura-scheme AND motoi still builds"

  :wave-1-impact
    :NONE
    "Wave-1 lib modules do NOT depend on dispatch.js — they are pure library
     modules registering verbs on a passed-in env. The lib is hermetic even
     while dispatch.js is not. Motoi standalone builds and lib/* tests pass
     regardless of dispatch.js state.")

;; ---------------------------------------------------------------------------
;; 5. TESTS
;; ---------------------------------------------------------------------------

(tests
  :baseline "motoi-scheme/tests/ was empty before this pass (ROADMAP gap #2)."

  :added
    "tests/pass-3-wave-1-smoke.test.mjs — 24 smoke tests covering:
       · adapters/base.js: 14 seams present, no-op defaults return
         sensible values, setAdapters() overrides take effect
       · lib/base/*: value classes + installers exported
       · lib/graphics/framebuffer.js: Framebuffer + palette shape,
         mode aliases (default + sakura backwards-compat)
       · every migrated file: dynamic import succeeds
       · Sakura-brand neutralization: recursive check for '✿' and
         '~/.sakura' in lib/ + adapters/"

  :run "node --test tests/pass-3-wave-1-smoke.test.mjs"
  :result "24 pass, 0 fail (94ms)"

  :scheme-lang-test-migration
    "Deferred. scheme-lang/tests/ has l234.test.mjs, media.test.mjs,
     r7rs-small/, reference/, repl/, verbs/, ide/ — but these are
     INTEGRATION tests that spawn the sakura-scheme BIN. Porting them
     requires (a) motoi-scheme/bin/motoi to run the migrated lib
     verbs end-to-end and (b) an env-factory (see Wave 2 base.js split).
     Ship-the-smoke-tests now; port full parity tests when Wave 2+
     lands the extended env factory."

  :follow-up-tests-needed
    ("verb-level parity tests for alg/*, eng/*, ops/*, topo/*, game-theory/*"
     "framebuffer roundtrip tests (paint → render → snapshot)"
     "audio smoke tests (BellAdapter TTY-noop verification)"
     "adapter injection roundtrip (setAdapters + verify override called)"))

;; ---------------------------------------------------------------------------
;; 6. BLOCKERS / OPEN ITEMS
;; ---------------------------------------------------------------------------

(blockers-open-items
  :wave-2-prerequisites
    ("reference-loader.js migration is required to restore full
      reference-gated verb registration (currently Wave-1 shim in
      lib/system/registry.js delegates to env.define with no gate)."
     "base.js split — src/base.js is lean; lib/base/loader.js should
      aggregate installR7rsSmall + installAlg + installEng + installTime
      + registerMedia into a makeExtendedBaseEnv factory."
     "reference-impls.js (2,488 lines) migration — decides whether the
      full 1,157-verb reference impl set lands in Motoi or splits.")

  :wave-5-prerequisite
    "Adapter-based decoupling of motoi-scheme/src/dispatch.js. The
     adapter shape is landed (adapters/base.js) — dispatch.js just needs
     6 import-path rewrites. Alfred sign-off in architect design blocker
     :b8 still pending.")

  :Ch-class-note
    "lib/base/r7rs-small.js inlined a private Ch class because
     motoi-scheme/src/reader.js does not export Ch/ch. Downstream
     eq?-across-modules on Ch values will return #f (different classes);
     eqv?/equal? on .value works. Follow-up: port Ch/ch into motoi's
     reader for a single interned registry.")

