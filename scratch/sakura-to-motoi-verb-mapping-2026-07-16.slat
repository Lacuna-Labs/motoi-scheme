;;; sakura-to-motoi-verb-mapping-2026-07-16.slat
;;;
;;; Per-verb salvage disposition for the 262 SAKURA-DIALECT verbs plus
;;; 19 AMBIGUOUS verbs identified in reference-audit-2026-07-16.slat.
;;; Unblocks the mechanical Sakura -> Motoi rewriter (step 1 in
;;; motoi-copilot-balance-and-sakura-reuse-2026-07-16.slat step-plan).
;;;
;;; :doc              "sakura-to-motoi-verb-mapping-2026-07-16"
;;; :audience         :engineer
;;; :confidentiality  :internal
;;; :training-eligible #f
;;; :dialect          "motoi"
;;; :provenance       "architect-sakura-mapping-lane-2026-07-16"
;;; :owner            "The Architect"
;;; :date             "2026-07-16"
;;; :tags             (:motoi :sakura :salvage :verb-mapping :rewriter
;;;                    :wave-3-planning :corpus-strip)
;;;
;;; DISPOSITIONS
;;;   MAP         — clean 1:1 Motoi equivalent (or trivial dashed<->slashed
;;;                 alias). Rewriter substitutes; pair keeps its shape.
;;;   REWRITE     — structural mapping exists but pair must be re-authored
;;;                 (e.g., card/emit -> (text/draw + cortex/write); a card
;;;                 API is not a chat-emit API). Do NOT auto-rewrite; either
;;;                 hand-lift or drop.
;;;   DROP        — no clean analog; verb is Sakura product-specific
;;;                 (Curator UI, Curator's Etsy/podcast/radio/shoppe stack,
;;;                 Cortex retriever surfaces). Any pair using this verb is
;;;                 UNSALVAGEABLE unless the whole pair is re-authored.
;;;   ADD-TO-MOTOI — the verb is generically useful for a game/kid/hobbyist
;;;                 stack, missing from Motoi. Alfred reviews top-10 for
;;;                 CORE/MODULE promotion.
;;;   AMBIGUOUS   — reference audit already flagged; needs Alfred call.
;;;
;;; SCOPE
;;;   262 SAKURA-DIALECT verbs (see reference-audit) + 19 AMBIGUOUS = 281.
;;;   Every verb listed once. No fabrication: Motoi target must exist in
;;;   MOTOI-BASE per the same audit or be explicitly flagged ADD-TO-MOTOI.
;;;
;;; ROSETTA CONSULTED
;;;   MOTOI-BASE inventory pulled from reference-audit-2026-07-16.slat
;;;   (936 verbs). Notable available primitives frequently referenced below:
;;;     surface/curtain, surface/dim, surface/spotlight, surface/describe
;;;     cortex/{read,write,remember,recall,query,forget,keys,size,topk}
;;;     text/draw, artifact/{save,list,cite,delete}
;;;     grid/{dot,clear,glow}, grid/flower-*
;;;     scene/{clear,grid,imagine,load,spawn-many}
;;;     entity/*, world/*, object/{spawn,fetch}, prefab/{define,spawn}
;;;     ai/{seek,flee,wander,decide,utility,bt-*,bb-*}
;;;     group/{count,each,find}, motion/*, camera-*, part/*
;;;
;;; ==========================================================================

(mapping
  :date "2026-07-16"
  :source "reference-audit-2026-07-16.slat"
  :sakura-verb-count 262
  :ambiguous-verb-count 19
  :total 281

  :summary-counts
  ;; Sum = 281 = 262 SAKURA-DIALECT + 19 AMBIGUOUS (per reference-audit).
  ;; 6 of the 19 AMBIGUOUS rows re-resolve to MAP here because the missing
  ;; slashed form already exists in Motoi-base (dashed alias case).
  ((:disposition MAP           :count  29
    :note "Clean 1:1 substitution. Rewriter emits token swap. Includes
           dashed-alias mappings like conway-* -> grid-* and motion-* ->
           motion/* and animation-* -> animation/*, plus a handful of
           semantic 1:1s (imagine -> scene/imagine, summon -> object/spawn,
           register-tick -> on-tick, sway! -> world/sway-all!).")
   (:disposition REWRITE       :count   5
    :note "Structural rewrite required. Do NOT auto-substitute. Hand-lift
           or drop the pair. Members: card/emit + card-emit -> text/draw +
           cortex/write, camera-zoom-to-card -> world/camera-snap! + entity/pos,
           cine/follow -> world/camera-follow! (with scene lift), paint-grid
           -> per-cell grid/dot + grid/glow.")
   (:disposition DROP          :count 216
    :note "Curator UI / shop / podcast / radio / Cortex-LLM / cine surfaces.
           No Motoi analog. Any pair referencing ONLY these verbs is
           unsalvageable. Any pair mixing DROP verbs with MAP verbs must
           also be dropped (partial rewrite yields broken code).")
   (:disposition ADD-TO-MOTOI  :count  19
    :note "Verb is generically useful for Motoi Copilot but missing.
           Top-10 rankings above. Clusters: form/* (form, form-group,
           form-list, form-of, submit = 5), part/character (eye-contact,
           walk-cycle, walk-together = 3), assert/* (audit-verify,
           invariants, check-with = 3), plus singletons escalate, next,
           done, hand-off, interrupted, rasterize-text, svg-set,
           flower/paint.")
   (:disposition AMBIGUOUS     :count  12
    :note "Alfred call. Rewriter pipeline halts on any pair referencing
           these until Alfred rules MAP or DROP. Members: ctx-get, ctx-set,
           ctx-result, field, dot-count, set-dot-alpha, set-dot-color,
           set-dot-radius, apply-markdown, analog-pad, rule-conway,
           define-form.")
   (:total 281))

  :top-10-add-to-motoi-candidates
  (;; Ranked by (a) generic utility to any kid/hobbyist stack, (b) how
   ;; often the pattern surfaces in Sakura fences, (c) low API-surface cost.
   (1 "escalate"
      :sakura-lib "core"
      :why "Generic control-flow verb: bubble a condition upward past the
            current handler. Useful in ANY game/agent stack, not Sakura-
            specific. Cheap to add to base as a Scheme-level primitive."
      :suggested-motoi "escalate"
      :suggested-module "core"
      :priority :HIGH)
   (2 "next"
      :sakura-lib "core"
      :why "Iteration/state-machine advance. Currently only 'radio/next' in
            Motoi. A bare 'next' as a scheduler/queue advance would let
            kid-level pair state code without a shop metaphor."
      :suggested-motoi "next"
      :suggested-module "core"
      :priority :MEDIUM)
   (3 "done"
      :sakura-lib "core"
      :why "Marker/return-value for a completed step (used by act/sequence
            in Sakura). Generic. Composes with big-bang and on-tick."
      :suggested-motoi "done"
      :suggested-module "core"
      :priority :MEDIUM)
   (4 "form / form-group / form-list / form-of / define-form"
      :sakura-lib "core"
      :why "Form-input primitives (text box, select, submit). Kids build
            Q&A programs constantly. Sakura's card/form binding is heavy;
            a plain 'form' + 'submit' pair (analog of HtDP's on-key + text)
            would unlock a whole class of first-month kid programs."
      :suggested-motoi "form/{define,ref,submit,list}"
      :suggested-module "form (new small module)"
      :priority :MEDIUM)
   (5 "eye-contact / walk-cycle / walk-together / in-formation"
      :sakura-lib "core"
      :why "Character-behavior primitives one layer above part/*. Any kid
            programming a two-character scene reaches for 'walk-together'.
            Currently Motoi has part/wave, part/nod etc. but no gait or
            gaze primitives. Cheap: implement as macros over part/step +
            part/look-toward."
      :suggested-motoi "part/eye-contact, part/walk-cycle, part/walk-together"
      :suggested-module "part"
      :priority :MEDIUM)
   (6 "svg-set"
      :sakura-lib "core"
      :why "Set an SVG element property. Motoi has plot/render-svg but no
            direct SVG-set primitive. Kids doing web-embed programs want
            live DOM-attribute writes. Small, self-contained."
      :suggested-motoi "svg/set!"
      :suggested-module "svg (new small module)"
      :priority :LOW)
   (7 "rasterize-text"
      :sakura-lib "core"
      :why "Render text-to-pixels into a surface layer. Sakura has this
            because of Curator's canvas cards; kids need it too for badge/
            hud/label patterns. Currently Motoi has sprite/rasterize but no
            text-to-raster primitive; text/draw is immediate-mode only."
      :suggested-motoi "text/rasterize"
      :suggested-module "text"
      :priority :MEDIUM)
   (8 "interrupted / imagine / summon / hand-off"
      :sakura-lib "core"
      :why "Persona-adjacent control verbs that read as generic when
            stripped of Sakura context: interrupted? (input handler
            preemption), imagine (open a scratch world - already exists as
            scene/imagine), summon (spawn from prefab - already exists as
            object/spawn / prefab/spawn), hand-off (baton to another
            actor). Only 'interrupted' and 'hand-off' truly missing;
            others map. See main table."
      :suggested-motoi "input/interrupted?, actor/hand-off"
      :suggested-module "input, actor (new)"
      :priority :LOW)
   (9 "flower/paint"
      :sakura-lib "flower"
      :why "Motoi already has grid/flower-* + entity/shape-flower!, but no
            direct 'paint a flower at (x,y)' primitive. The flower motif is
            core to Motoi's identity (blossoms-dancing self-model). One
            verb, cheap."
      :suggested-motoi "flower/paint"
      :suggested-module "flower (new small module)"
      :priority :LOW)
   (10 "check-with / invariants / audit-verify"
       :sakura-lib "core"
       :why "Contract/assertion helpers. Any hobbyist writing a small
             simulator uses these. Motoi has 'error' + 'guard' from R7RS
             but no lightweight 'check-with' predicate-assertion or
             'invariants' block. Optional but pedagogically strong."
       :suggested-motoi "assert/check-with, assert/invariants"
       :suggested-module "assert (new small module)"
       :priority :LOW))

  :notes-for-rewriter-implementer
  ("For every MAP row: emit a token-level substitution in
    sakura-to-motoi-rewrite.py. Fence-tag swap (scheme -> motoi) is
    orthogonal and applies to every pair regardless."
   "For every REWRITE row: DO NOT auto-substitute. Mark pair for
    hand-authoring or DROP it from the mechanical pipeline. Cost of a
    silent wrong-rewrite (model learns to call text/draw + cortex/write
    where the pair originally called card/emit for a UI beat) is a
    corrupted refusal/behavior training signal."
   "For every DROP row: pair is UNSALVAGEABLE by mechanical rewrite. If
    the pair references ONLY DROP verbs, discard. If it references some
    DROP verbs mixed with MAP verbs, DROP the whole pair — partial
    rewrite yields broken code."
   "AMBIGUOUS rows halt the pipeline until Alfred rules. Recommend Alfred
    scan the 15 AMBIGUOUS rows in one sitting; each is a yes/no.")

  ;; ==========================================================================
  ;; PER-VERB DISPOSITIONS
  ;; ==========================================================================

  ;; ----- afford (1) -----
  (verb :sakura "afford/deep-think" :disposition DROP
        :notes "Sakura Cortex-scale-up gate — decides whether to call the
                big remote model. Not a Motoi concept. Any pair using this
                is Sakura persona/cost-control material.")

  ;; ----- ai (10) -----
  (verb :sakura "ai/classify"      :disposition DROP
        :notes "Curator LLM wrapper. Motoi has no cloud-LLM verbs and
                should not.")
  (verb :sakura "ai/embed"         :disposition DROP :notes "Same as above.")
  (verb :sakura "ai/generate"      :disposition DROP :notes "Same as above.")
  (verb :sakura "ai/policy"        :disposition DROP
        :notes "Curator agent-policy DSL. Sakura-specific.")
  (verb :sakura "ai/policy-act"    :disposition DROP :notes "Same.")
  (verb :sakura "ai/rank"          :disposition DROP :notes "LLM ranker.")
  (verb :sakura "ai/rerank"        :disposition DROP :notes "LLM reranker.")
  (verb :sakura "ai/summarize"     :disposition DROP :notes "LLM summariser.")
  (verb :sakura "ai/translate"     :disposition DROP :notes "LLM translator.")
  (verb :sakura "ai/vector-search" :disposition DROP
        :notes "Sakura Cortex vector-search. Motoi cortex/topk covers
                similar shape but semantics differ; do not auto-map.")

  ;; ----- ask (1) -----
  (verb :sakura "ask/reasoner" :disposition DROP
        :notes "Sakura persona hook to ask the reasoner subsystem. Not
                a Motoi concept.")

  ;; ----- cadence (2) -----
  (verb :sakura "cadence/may-propose?" :disposition DROP
        :notes "Sakura conversation-cadence gate. Persona-only.")
  (verb :sakura "cadence/plan"         :disposition DROP :notes "Same.")

  ;; ----- card (10) -----
  ;; All card/* verbs are Curator UI-card primitives. Not portable.
  (verb :sakura "card/activity"          :disposition DROP)
  (verb :sakura "card/activity-done"     :disposition DROP)
  (verb :sakura "card/activity-progress" :disposition DROP)
  (verb :sakura "card/ask"               :disposition DROP
        :notes "Kid-facing card question API. Motoi has no card concept;
                a card/ask pair does not lower to any Motoi primitive
                without pulling in the whole card runtime.")
  (verb :sakura "card/audio-pulse"       :disposition DROP)
  (verb :sakura "card/audio-pulse-off"   :disposition DROP)
  (verb :sakura "card/do"                :disposition DROP)
  (verb :sakura "card/emit"              :disposition REWRITE
        :motoi "text/draw + cortex/write"
        :notes "The emit-a-message shape can be rewritten as: draw the
                text with text/draw, log it to cortex with cortex/write.
                Not mechanical — needs hand-lift because card/emit's UI
                affordance (position, styling) is lost.")
  (verb :sakura "card/physics!"          :disposition DROP)
  (verb :sakura "card/transition"        :disposition DROP)

  ;; ----- cine (7) -----
  ;; Cinematographic camera DSL — Motoi has camera-* and world/camera-*
  ;; primitives that are simpler. Not a 1:1.
  (verb :sakura "cine/comfort"    :disposition DROP)
  (verb :sakura "cine/follow"     :disposition REWRITE
        :motoi "world/camera-follow!"
        :notes "Semantics overlap but cine/follow chains cine/frame; the
                rewrite must lift the whole cinematographic scene. Not
                mechanical.")
  (verb :sakura "cine/following?" :disposition DROP)
  (verb :sakura "cine/frame"      :disposition DROP
        :notes "Sakura cinematographic frame (shot boundary). Motoi has
                'frame' and 'camera-frame' but different semantics.")
  (verb :sakura "cine/shot"       :disposition DROP)
  (verb :sakura "cine/shots"      :disposition DROP)
  (verb :sakura "cine/stop"       :disposition MAP :motoi "world/camera-snap!"
        :notes "'End the current follow' -> snap back is close enough for
                mechanical rewrite; verify semantics on QA sample.")

  ;; ----- core / act, sequence, and Sakura DSL primitives (207) -----
  (verb :sakura "act" :disposition MAP :motoi "begin"
        :notes "Sakura's (act 'verb '((k v)...)) form lowers to a bare
                verb-call in Motoi. But because 'act is a quoted symbol
                wrapper, mechanical rewrite must strip the quote too.
                The analyst's example (act 'cortex/recall ...) becomes
                (cortex/recall ...). Rewriter needs a special-case AST
                pattern for this — NOT a token substitution.")
  (verb :sakura "add-shop" :disposition DROP
        :notes "Curator shop-registry mutator.")
  (verb :sakura "age-layer" :disposition DROP
        :notes "Curator canvas age-band mutator.")
  (verb :sakura "anomaly-recent" :disposition DROP
        :notes "Curator anomaly detector query.")
  (verb :sakura "app-clear!" :disposition DROP :notes "Curator app registry.")
  (verb :sakura "app-list"   :disposition DROP :notes "Same.")
  (verb :sakura "app-of"     :disposition DROP :notes "Same.")
  (verb :sakura "audit-verify" :disposition ADD-TO-MOTOI
        :motoi "assert/audit-verify"
        :notes "Assertion helper. See top-10 candidate #10.")
  (verb :sakura "button"      :disposition DROP :notes "Card UI widget.")
  (verb :sakura "button-list" :disposition DROP :notes "Same.")
  (verb :sakura "button-of"   :disposition DROP :notes "Same.")
  (verb :sakura "camera-zoom-to-card" :disposition REWRITE
        :motoi "world/camera-snap! + entity/pos"
        :notes "Zoom-to-card lowers to snap-camera-to-entity-position.
                Needs hand-lift because the card reference must be
                translated to an entity ref first.")

  ;; canvas-* (14) — Curator's variable-topology canvas surface.
  (verb :sakura "canvas-cell-age"          :disposition DROP)
  (verb :sakura "canvas-cell-alive?"       :disposition DROP)
  (verb :sakura "canvas-cell-set!"         :disposition DROP)
  (verb :sakura "canvas-clear-region"      :disposition DROP)
  (verb :sakura "canvas-cols"              :disposition DROP)
  (verb :sakura "canvas-pause"             :disposition DROP)
  (verb :sakura "canvas-power-tier"        :disposition DROP)
  (verb :sakura "canvas-region-live-count" :disposition DROP)
  (verb :sakura "canvas-resume"            :disposition DROP)
  (verb :sakura "canvas-rows"              :disposition DROP)
  (verb :sakura "canvas-rule"              :disposition DROP)
  (verb :sakura "canvas-rule-set!"         :disposition DROP)
  (verb :sakura "canvas-spawn-pattern"     :disposition DROP)

  ;; card-* dashed (34) — same story as card/* slashed.
  (verb :sakura "card-anchor-settle"  :disposition DROP)
  (verb :sakura "card-ask"            :disposition DROP)
  (verb :sakura "card-canvas-rect"    :disposition DROP)
  (verb :sakura "card-close"          :disposition DROP)
  (verb :sakura "card-do"             :disposition DROP)
  (verb :sakura "card-each"           :disposition DROP)
  (verb :sakura "card-ease-aside"     :disposition DROP)
  (verb :sakura "card-effect"         :disposition DROP)
  (verb :sakura "card-emit"           :disposition REWRITE
        :motoi "text/draw + cortex/write"
        :notes "Same as card/emit above.")
  (verb :sakura "card-find-by-kind"   :disposition DROP)
  (verb :sakura "card-focus!"         :disposition DROP)
  (verb :sakura "card-get"            :disposition DROP)
  (verb :sakura "card-id-of"          :disposition DROP)
  (verb :sakura "card-kind"           :disposition DROP)
  (verb :sakura "card-kinds"          :disposition DROP)
  (verb :sakura "card-land"           :disposition DROP)
  (verb :sakura "card-lean-aside"     :disposition DROP)
  (verb :sakura "card-list"           :disposition DROP)
  (verb :sakura "card-open"           :disposition DROP)
  (verb :sakura "card-open-then"      :disposition DROP)
  (verb :sakura "card-pluck"          :disposition DROP)
  (verb :sakura "card-reach"          :disposition DROP)
  (verb :sakura "card-rect"           :disposition DROP)
  (verb :sakura "card-rows"           :disposition DROP)
  (verb :sakura "card-screen-rect"    :disposition DROP)
  (verb :sakura "card-set!"           :disposition DROP)
  (verb :sakura "card-settle-breath"  :disposition DROP)
  (verb :sakura "card-toss"           :disposition DROP)
  (verb :sakura "card-unfocus!"       :disposition DROP)
  (verb :sakura "card-visible?"       :disposition DROP)
  (verb :sakura "card-where"          :disposition DROP)
  (verb :sakura "cards-list"          :disposition DROP)

  (verb :sakura "check-with" :disposition ADD-TO-MOTOI
        :motoi "assert/check-with"
        :notes "Predicate assertion. Top-10 candidate #10.")
  (verb :sakura "coin-emit" :disposition DROP :notes "Curator reward UI.")

  ;; conway-* (32) — Curator's Conway variant (rainbow / tribes / rounds).
  ;; Motoi has grid-* general Life primitives that cover the base case;
  ;; the rainbow/tribes/rounds decorations are Curator gameplay.
  (verb :sakura "conway-cell-age-band"        :disposition DROP)
  (verb :sakura "conway-cell-glow"            :disposition DROP)
  (verb :sakura "conway-cell-lineage"         :disposition DROP)
  (verb :sakura "conway-cell-mixed-parents"   :disposition DROP)
  (verb :sakura "conway-cell?"                :disposition MAP
        :motoi "grid-cell?"
        :notes "General-life cell predicate. grid-cell? is the Motoi form.")
  (verb :sakura "conway-cols"                 :disposition MAP :motoi "grid-cols")
  (verb :sakura "conway-end-round"            :disposition DROP)
  (verb :sakura "conway-feed-corner"          :disposition DROP)
  (verb :sakura "conway-fire-rainbow"         :disposition DROP)
  (verb :sakura "conway-init"                 :disposition MAP :motoi "grid-init")
  (verb :sakura "conway-live-count"           :disposition MAP :motoi "grid-live-count")
  (verb :sakura "conway-rainbow-active?"      :disposition DROP)
  (verb :sakura "conway-round-scores"         :disposition DROP)
  (verb :sakura "conway-round-tick"           :disposition DROP)
  (verb :sakura "conway-round-ticks-total"    :disposition DROP)
  (verb :sakura "conway-rows"                 :disposition MAP :motoi "grid-rows")
  (verb :sakura "conway-set-rule"             :disposition DROP
        :notes "Motoi grid-* is fixed-rule; no per-run rule mutator.")
  (verb :sakura "conway-soup-flush"           :disposition DROP)
  (verb :sakura "conway-spawn-beehive"        :disposition DROP)
  (verb :sakura "conway-spawn-blinker"        :disposition DROP)
  (verb :sakura "conway-spawn-block"          :disposition DROP)
  (verb :sakura "conway-spawn-cell"           :disposition MAP :motoi "grid-cell-set!")
  (verb :sakura "conway-spawn-corner"         :disposition DROP)
  (verb :sakura "conway-spawn-glider"         :disposition DROP)
  (verb :sakura "conway-spawn-gosper"         :disposition DROP)
  (verb :sakura "conway-spawn-lwss"           :disposition DROP)
  (verb :sakura "conway-spawn-r-pent"         :disposition DROP)
  (verb :sakura "conway-spawn-startup-gun"    :disposition DROP)
  (verb :sakura "conway-step"                 :disposition MAP :motoi "grid-step")
  (verb :sakura "conway-tick-count"           :disposition MAP :motoi "grid-step-count")
  (verb :sakura "conway-tick-rainbow"         :disposition DROP)
  (verb :sakura "conway-tribe-counts"         :disposition DROP)
  (verb :sakura "conway-underdog"             :disposition DROP)

  (verb :sakura "create-listing-from" :disposition DROP :notes "Etsy shop verb.")
  (verb :sakura "define-app"          :disposition DROP :notes "Curator app manifest.")
  (verb :sakura "define-button"       :disposition DROP :notes "Curator UI widget.")
  (verb :sakura "define-card"         :disposition DROP :notes "Curator card kind.")
  (verb :sakura "done"                :disposition ADD-TO-MOTOI
        :motoi "done"
        :notes "Generic step-completion marker. Top-10 #3.")
  (verb :sakura "emoji-by-name"       :disposition DROP :notes "Curator emoji palette.")
  (verb :sakura "emoji-paint-pixel"   :disposition DROP)
  (verb :sakura "emoji-prop"          :disposition DROP)
  (verb :sakura "emoji-turn"          :disposition DROP)
  (verb :sakura "escalate"            :disposition ADD-TO-MOTOI
        :motoi "escalate"
        :notes "Bubble a condition upward. Top-10 #1.")
  (verb :sakura "eye-contact"         :disposition ADD-TO-MOTOI
        :motoi "part/eye-contact"
        :notes "Character-behavior primitive. Top-10 #5.")
  (verb :sakura "fleet-do"            :disposition DROP :notes "Curator card-fleet iterator.")
  (verb :sakura "fleet-each"          :disposition DROP)
  (verb :sakura "flip-card"           :disposition DROP)
  (verb :sakura "fold-card"           :disposition DROP)
  (verb :sakura "form"                :disposition ADD-TO-MOTOI
        :motoi "form/define"
        :notes "Form-input primitive. Top-10 #4.")
  (verb :sakura "form-group"          :disposition ADD-TO-MOTOI
        :motoi "form/group"
        :notes "Same cluster as above.")
  (verb :sakura "form-list"           :disposition ADD-TO-MOTOI
        :motoi "form/list")
  (verb :sakura "form-of"             :disposition ADD-TO-MOTOI
        :motoi "form/of")
  (verb :sakura "hand-off"            :disposition ADD-TO-MOTOI
        :motoi "actor/hand-off"
        :notes "Baton-pass between actors. Top-10 #8.")
  (verb :sakura "imagine"             :disposition MAP
