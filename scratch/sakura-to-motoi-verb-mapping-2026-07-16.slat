  (verb :sakura "analog-pad" :disposition AMBIGUOUS
        :notes "Reads like a gamepad-abstraction (analog stick). If so,
                belongs in Motoi input/. If it's a Curator canvas UI thing,
                DROP. Alfred call.")
  (verb :sakura "animation-budget" :disposition MAP
        :motoi "animation/budget"
        :notes "Dashed alias of slashed form which IS Motoi-base. Safe
                mechanical map; would otherwise be AMBIGUOUS.")
  (verb :sakura "animation-reflow-policy" :disposition MAP
        :motoi "animation/reflow-policy")
