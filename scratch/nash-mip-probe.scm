(define (cumulative xs)
  (let loop ((rest xs) (run 0) (acc '()))
    (if (null? rest)
      (reverse acc)
      (loop (cdr rest) (+ run (car rest)) (cons (+ run (car rest)) acc)))))
(define (production-plan demand cap unit-cost holding-cost)
  (let* ((n (length demand))
         (cum (cumulative demand))
         (rows (map (lambda (t)
                      (append (map (lambda (i) (if (<= i t) 1 0)) (iota n))
                              (list '<= (- (* cap (+ t 1)) (list-ref cum t)))))
                    (iota n)))
         (obj (map (lambda (t) (+ unit-cost (* holding-cost (- n t)))) (iota n)))
         (idle (ops/mip-solve rows obj (list ':integers (iota n)))))
    (if (pair? idle)
      (list 'produce (map (lambda (u) (- cap u)) idle))
      (list 'no-plan idle))))
(display (production-plan (list 10 20 15) 25 5 2))
(newline)
