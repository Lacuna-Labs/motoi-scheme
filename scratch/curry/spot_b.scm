(define (p l x) (display l) (display " => ") (write x) (newline))
(define (windows xs k) (map (lambda (i) (take-right (take xs (+ i k)) k)) (iota (+ 1 (- (length xs) k)))))
(p "windows" (windows (list 1 2 3 4 5) 3))
(p "tail-n" (take-right (list 'l1 'l2 'l3) (min 10 3)))
