(define (chunk xs n) (if (< (length xs) n) (list xs) (let-values (((h r) (split-at xs n))) (cons h (chunk r n)))))
(p "chunk" (chunk (list 1 2 3 4 5 6 7) 3))
(p "let-values-ex" (let-values (((h r) (split-at (list 1 2 3 4 5) 2))) (list 'head h 'rest r)))
