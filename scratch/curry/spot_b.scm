(define (run-lengths xs) (if (null? xs) (list) (let* ((h (car xs)) (run (take-while (lambda (x) (equal? x h)) xs))) (cons (list h (length run)) (run-lengths (drop xs (length run)))))))
(p "rle" (run-lengths (list 'a 'a 'b 'c 'c 'c)))
(define (lex xs) (if (null? xs) (list) (let* ((kind (if (number? (car xs)) number? symbol?)) (tok (take-while kind xs))) (cons tok (lex (drop xs (length tok)))))))
(p "lex" (lex (list 1 2 'a 'b 3)))
(define (tokens xs)
  (let loop ((rest (drop-while (lambda (x) (eq? x 'space)) xs)) (out (list)))
    (if (null? rest) (reverse out)
        (let* ((tok (take-while (lambda (x) (not (eq? x 'space))) rest))
               (after (drop-while (lambda (x) (not (eq? x 'space))) rest)))
          (loop (drop-while (lambda (x) (eq? x 'space)) after) (cons tok out))))))
(p "tokens" (tokens (list 'space 'a 'b 'space 'space 'c 'space)))
(define (merge-sort xs)
  (if (< (length xs) 2) xs
      (let-values (((a b) (split-at xs (quotient (length xs) 2))))
        (let merge ((l (merge-sort a)) (r (merge-sort b)) (out (list)))
          (cond ((null? l) (append-reverse out r))
                ((null? r) (append-reverse out l))
                ((< (car l) (car r)) (merge (cdr l) r (cons (car l) out)))
                (else (merge l (cdr r) (cons (car r) out))))))))
(p "merge-sort" (merge-sort (list 5 3 9 1 7 2 8)))
(define (deal players cards) (if (null? players) (list) (let-values (((h r) (split-at cards (quotient (length cards) (length players))))) (cons (list (car players) h) (deal (cdr players) r)))))
(p "deal" (deal (list 'ana 'ben 'cy) (iota 9)))
(p "differences" (map - (cdr (list 1 4 9 16 25)) (drop-right (list 1 4 9 16 25) 1)))
(define (trim pp xs) (let ((front (drop-while pp xs))) (reverse (drop-while pp (reverse front)))))
(p "trim" (list (trim zero? (list 0 0 5 7 0 0)) (trim zero? (list 0 0 0))))
(define (segments xs) (if (null? xs) (list) (list (list (car xs)) (drop-right (cdr xs) 1) (last-pair xs))))
