(define (p l x) (display l) (display " => ") (write x) (newline))
(p "pair?-arr" (pair? (list 1 2)))
(p "pair?-dot" (pair? (cons 1 2)))
(p "pair?-null" (pair? (list)))
(p "boolean?" (boolean? #t))
(p "integer?" (integer? 3))
(p "cons-arr" (cons 1 (list 2 3)))
(p "cons-dot" (cons 1 2))
(p "cdr-dot" (cdr (cons 1 2)))
(p "list-ref" (list-ref (list 1 2 3) 1))
(p "filter" (filter odd? (list 1 2 3)))
(p "cons*-0" (guard (e (#t 'arity-error)) (cons*)))
(p "list-tab-neg" (list-tabulate -3 (lambda (i) i)))
(p "display-dot" (list 'a (cons 1 2)))
(p "assq2" (assq 'a (list (list 'a 'b 'c))))
(p "eq?" (eq? 'a 'a))
(p "cadr" (cadr (list 1 2 3)))
(p "let*" (let* ((a 1) (b (+ a 1))) b))
(p "cond=>" (cond ((assq 'a (list (list 'a 1))) => cadr) (else 'no)))
(p "apply-consstar" (apply cons* (list 1 2 (list 3))))
(p "string?" (string? "x"))
(p "map2" (guard (e (#t 'no-map2)) (map + (list 1 2) (list 10 20))))
(p "for-each" (begin (for-each (lambda (x) x) (list 1 2)) 'ok))
(p "exact" (guard (e (#t 'none)) (exact 3.0)))
(p "truncate" (guard (e (#t 'none)) (truncate 2.7)))
