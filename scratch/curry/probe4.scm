(define (p label x) (display label) (display " => ") (write x) (newline))
(p "named-let" (let loop ((i 0) (acc '())) (if (= i 3) (reverse acc) (loop (+ i 1) (cons i acc)))))
(p "do" (guard (e (#t 'no-do)) (do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 3) (reverse acc)))))
(p "when" (when #t 'yes))
(p "case" (case 2 ((1) 'one) ((2) 'two) (else 'other)))
(p "string-join?" (guard (e (#t 'no-string-join)) (string-join (list "a" "b") "-")))
(p "hash" (guard (e (#t 'no-hash)) (let ((h (make-hash-table))) (hash-table-set! h 'a 1) (hash-table-ref/default h 'a #f))))
(p "assq" (assq 'a '((a 1))))
(p "list->string" (list->string (list #\a #\b)))
(p "string->list" (string->list "ab"))
(p "max" (apply max (list 1 5 3)))
(p "abs" (abs -3))
(p "modulo" (modulo 7 3))
(p "list?" (list? (list 1)))
(p "null?" (null? '()))
(p "equal?" (equal? (list 1 2) (list 1 2)))
(p "symbol->string" (symbol->string 'abc))
(p "vector->list" (vector->list (vector 1 2)))
(p "square" (guard (e (#t 'none)) (square 4)))
(p "gcd" (gcd 12 18))
(p "exact->inexact" (guard (e (#t 'none)) (exact->inexact 3)))
(p "/" (/ 6 3))
(p "assoc-list" (assoc (list 1) (list (list (list 1) 'x))))
