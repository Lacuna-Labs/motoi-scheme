(define (p label x) (display label) (display " => ") (write x) (newline))
;; divergence probes
(p "cons*-improper"  (cons* 1 2 3))
(p "cons*-sym-tail"  (cons* 1 'a))
(p "unfold-nonlist-tail" (unfold (lambda (x) (> x 2)) (lambda (x) x) (lambda (x) (+ x 1)) 1 (lambda (s) s)))
(p "append-rev-nonlist" (append-reverse (list 3 2 1) 9))
(p "xcons-pair-of"   (xcons (xcons (list) 3) 1))
;; helper availability
(p "every"  (every odd? (list 1 3)))
(p "any"    (any odd? (list 2 3)))
(p "assoc"  (assoc 'b '((a 1) (b 2))))
(p "sort"   (sort (list 3 1 2) <))
(p "reverse" (reverse (list 1 2 3)))
(p "apply"  (apply + (list 1 2 3)))
(p "length" (length (list 1 2 3)))
(p "member" (member 2 (list 1 2 3)))
(p "list-index" (list-index odd? (list 2 4 5)))
