(define (p l x) (display l) (display " => ") (write x) (newline))
(define (tag-with tail) (lambda (h) (xcons tail h)))
(p "xcons-curry" (map (tag-with (list 'units 'cm)) (list 3 5 8)))
(p "cons*-header" (cons* 'name 'score (list 'alice 'bob)))
(p "times-table" (list-tabulate 3 (lambda (r) (list-tabulate 3 (lambda (c) (* (+ r 1) (+ c 1)))))))
(define (collect-evens xs)
  (let loop ((rest xs) (acc (list)))
    (cond ((null? rest) (append-reverse acc (list 'done)))
          ((even? (car rest)) (loop (cdr rest) (cons (car rest) acc)))
          (else (loop (cdr rest) acc)))))
(p "collect-evens" (collect-evens (list 1 2 3 4 5 6)))
(p "append-rev-dot" (append-reverse (list 1 2) 9))
(p "census" (map proper-list? (list (list 1 2) (list) 42 "text" (cons 1 2) (cons 1 (list 2 3)))))
(p "tabulate-even" (list-tabulate 4 (lambda (i) (list i (even? i)))))
(p "pascal-check" (list-tabulate 0 (lambda (i) i)))
(define (split-on sep xs)
  (let loop ((rest xs) (cur (list)) (out (list)))
    (cond ((null? rest) (reverse (cons (append-reverse cur (list)) out)))
          ((eq? (car rest) sep) (loop (cdr rest) (list) (cons (append-reverse cur (list)) out)))
          (else (loop (cdr rest) (cons (car rest) cur) out)))))
(p "split-on" (split-on 'gap (list 'a 'b 'gap 'c 'gap 'd)))
(define (make-queue front back) (list front back))
(define (dequeue q)
  (let ((front (car q)) (back (cadr q)))
    (if (null? front)
        (let ((f (append-reverse back (list))))
          (if (null? f) (list 'empty q) (list (car f) (make-queue (cdr f) (list)))))
        (list (car front) (make-queue (cdr front) back)))))
(p "dequeue" (dequeue (make-queue (list) (list 'c 'b 'a))))
(define (next-row prev)
  (list-tabulate (+ 1 (length prev))
                 (lambda (i)
                   (+ (if (= i 0) 0 (list-ref prev (- i 1)))
                      (if (= i (length prev)) 0 (list-ref prev i))))))
(define (pascal n)
  (let loop ((k 1) (row (list 1)) (acc (list (list 1))))
    (if (= k n) (reverse acc) (let ((nr (next-row row))) (loop (+ k 1) nr (cons nr acc))))))
(p "pascal" (pascal 5))
(p "buckets" (list-tabulate 3 (lambda (b) (filter (lambda (x) (= b (modulo x 3))) (list 1 2 3 4 5 6 7 8)))))
(p "copy-xcons" (fold-right (lambda (x acc) (xcons acc x)) (list) (list 1 2 3)))
(p "alist-dot" (map (lambda (pp) (xcons (cadr pp) (car pp))) (list (list 'a 1) (list 'b 2))))
