(define (p l x) (display l) (display " => ") (write x) (newline))
(p "take" (guard (e (#t 'no-take)) (take (list 1 2 3 4) 2)))
(p "drop" (guard (e (#t 'no-drop)) (drop (list 1 2 3 4) 2)))
(p "list-head" (guard (e (#t 'no-list-head)) (list-head (list 1 2 3) 2)))
(p "list-tail" (list-tail (list 1 2 3 4) 2))
(p "min" (min 3 10))
(p "last-pair-improper" (last-pair (cons 1 (cons 2 3))))
(p "last-pair-1" (last-pair (list 9)))
(p "last" (guard (e (#t 'no-last)) (last (list 1 2 3))))
(p "take-right-neg" (guard (e (#t 'err)) (take-right (list 1 2 3) -1)))
(p "drop-right-neg" (guard (e (#t 'err)) (drop-right (list 1 2 3) -1)))
(p "take-right-over" (guard (e (#t 'err)) (take-right (list 1 2 3) 9)))
(p "split-at-over" (guard (e (#t 'err)) (split-at (list 1 2) 5)))
(p "split-at-0" (call-with-values (lambda () (split-at (list 1 2 3) 0)) list))
(p "split-at-len" (call-with-values (lambda () (split-at (list 1 2 3) 3)) list))
(p "take-while-none" (take-while odd? (list 2 4)))
(p "drop-while-all" (drop-while odd? (list 1 3)))
(p "assoc-cdr" (cdr (assq 'a (list (list 'a 1 2)))))
(p "values-2" (call-with-values (lambda () (values 1 2)) +))
(p "string-length" (string-length "abc"))
(p "char-upcase?" (guard (e (#t 'none)) (list->string (map char-upcase (string->list "ab")))))
