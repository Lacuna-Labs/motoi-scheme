  (verb "audio/bar-clock")
  (verb "audio/key")
  (verb "audio/spectrum")
  (verb "audio/listen")
  (verb "audio/lufs")
  ;; NOTE: 14 dashed core-namespace audio aliases (audio-play, audio-halt,
