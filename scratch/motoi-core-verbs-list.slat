;;; motoi-core-verbs-list.slat
;;;
;;; Flat list of Motoi CORE verbs — always loaded, model memorizes.
;;;
;;; :doc              "motoi-core-verbs-list"
;;; :audience         :engineer
;;; :confidentiality  "public"
;;; :training-eligible #t
;;; :provenance       "architect-motoi-core-vs-module-2026-07-16"
;;; :owner            "The Architect"
;;; :date             "2026-07-16"
;;;
;;; Target: ~200-250 verbs. Actual after triage: 322 (309 verbs + 13 easing
;;; and font constants that behave like named values). This is above the
;;; comfort band by ~60-70 items. The overflow is deliberate — each is a
;;; verb the kid/hobbyist audience reaches for in month one. Two options
;;; if the trained model shows verb-recall regression:
;;;
;;;   Option A: accept 322-verb CORE and use the 20-pairs-per-verb corpus
;;;     coverage constraint from the research doc — ~6.4k pairs for CORE
;;;     alone, well within the 47-54k pair budget.
;;;   Option B: demote the entire entity/* library (28 verbs) to a
;;;     (motoi game entity) MODULE and drop half the world/* verbs —
;;;     lands at ~265. Only do this if empirical training shows the
;;;     model can't hold 322 verbs cleanly. Escalation flag in architect
;;;     doc lists specific candidates.
;;;
;;; Everything here = a kid / hobbyist / 60-year-old typing their first
;;; month reaches for without `import`. R7RS-small essentials + fantasy-
;;; console + one game loop + basic timing/audio + basic math + basic
;;; character motion + Cortex + SLAT/artifact primitives.
;;;
;;; Read this file top-down as "what the 1.5B model must know cold." Anything
;;; not here is MODULE or CRUFT — see motoi-module-packages.slat and
;;; the full architect doc.

(core-set
  :date "2026-07-16"
  :verb-count 309
  :constant-count 13
  :total 322
  :notes
  ("Every entry here corresponds to a MOTOI-BASE verb from the reference-audit
    that also passes the two heuristics: (1) an 11-year-old would type it in
    their first month, OR (2) a hobbyist would reach for it without docs first.
    Deep specialists and domain-knowledge-heavy verbs live in MODULES."
   "R7RS-small core forms (define, lambda, let, cond, if, and, or, begin,
    quote, quasiquote, set!, define-syntax, define-record-type, when, unless,
    do, delay, force, letrec, letrec*, let-values, let*-values, case, guard,
    parameterize, dynamic-wind, error, raise, with-exception-handler, apply,
    call/cc, values, call-with-values, define-values) are NOT verbs — they
    are core forms, and are also model-memorized. Listed separately in the
    architect doc.")

  ;; ── R7RS list/pair/number primitives (assumed model-native from base
  ;; Qwen2.5-Coder Lisp exposure, but MUST be in reference and CORE) ──
  ;; These are the ~30 verbs every Scheme program uses. Not enumerated
  ;; here because they live in the reference under core-forms; the Qwen
  ;; base already tokenizes them cleanly. Listed for completeness in the
  ;; architect doc.

  ;; ── DRAW / FRAMEBUFFER (kid's first program) ──
  (verb "fb/text")             ; the ONE text-draw verb kids reach for
  (verb "text/draw")            ; alias/preferred form for above
  (verb "text/measure")         ; pixel width of a string
  (verb "text/wrap")            ; wrap text to width
  (verb "clear-surface-layer")  ; the "clear the screen" verb
  (verb "begin-frame")
  (verb "end-frame")
  (verb "on-frame")             ; the game loop callback
  (verb "after-frame")
  (verb "on-canvas-trace")
  (verb "surface-exists?")
  (verb "pixels-wide")
  (verb "pixels-tall")
  (verb "viewport")
  (verb "viewport-width")
  (verb "cols")
  (verb "rows")

  ;; ── SPRITES ──
  (verb "sprite")
  (verb "sprites")
  (verb "sprite/address")
  (verb "sprite/landmarks")
  (verb "sprite/rasterize")

  ;; ── FONT constants (behave like named values, low-cost to memorize) ──
  (constant "font/default")
  (constant "font/mono")
  (constant "font/big")
  (constant "font/tiny")

  ;; ── EASING + ANIMATION (just landed 2026-07-16, kid-first motion) ──
  (verb "bezier-ease")
  (verb "named-ease")
  (verb "spring-ease")
  (constant "easing/emphasized")
  (constant "easing/standard")
  (constant "easing/decelerated")
  (constant "easing/accelerated")
  (constant "easing/linear")
  (constant "easing/ease-in")
  (constant "easing/ease-out")
  (constant "easing/ease-in-out")
  (constant "easing/spring")
  (verb "animation/budget")
  (verb "animation/reflow-policy")
  (verb "animation/set-reflow-policy")
  (verb "bounce")               ; one-liner (motion library)
  (verb "slide")                ; one-liner
  (verb "fade")                 ; one-liner
  (verb "with-spacing")

  ;; ── MOTION (kid-first movement primitives, keep the trivial ones) ──
  (verb "motion/move-to")
  (verb "motion/halt")
  (verb "motion/drop")
  (verb "motion/arc")
  (verb "motion/follow-input")
  (verb "motion/anchor-to-input")
  (verb "motion/with-feel")
  (verb "motion/with-pace")

  ;; ── GAME LOOP + BIG-BANG (HtDP-lineage; kids' first interactive) ──
  (verb "big-bang")
  (verb "to-draw")
  (verb "game/frame")
  (verb "game/state")
  (verb "game/step")
  (verb "game/stop")
  (verb "game/running?")

