;; ── SEPARATE: core-language forms (memorized by model alongside verbs) ──
;;
;; These are not "verbs" per se — they are the reader/interpreter special
;; forms. All 53 core forms in the reference stay in CORE by definition.
;; Listed here so the training-pair generator knows to include them:
;;
;;   define / lambda / let / let* / letrec / letrec* / let-values /
;;   let*-values / if / cond / when / unless / case / and / or / not /
;;   begin / do / quote / quasiquote / unquote / unquote-splicing / set! /
;;   define-syntax / syntax-rules / let-syntax / letrec-syntax /
;;   define-record-type / delay / force / lazy / make-promise /
;;   dynamic-wind / with-exception-handler / raise / raise-continuable /
;;   error / guard / apply / call-with-current-continuation / call/cc /
;;   values / call-with-values / define-values / parameterize /
;;   make-parameter / eof-object? / import / include / cond-expand /
;;   define-library / export / rename / prefix
