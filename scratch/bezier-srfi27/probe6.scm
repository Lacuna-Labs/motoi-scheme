(display (list 'pair (equal? (cons 1 2) (cons 1 2)) 'vec (equal? (vector 1 2) (vector 1 2)))) (newline)
(define (count-distinct-eq xs)
  (let loop ((rest xs) (seen (list)) (n 0))
    (cond ((null? rest) n)
          ((memq (car rest) seen) (loop (cdr rest) seen n))
          (else (loop (cdr rest) (cons (car rest) seen) (+ n 1))))))
(define srcs (map (lambda (_) (make-random-source)) (iota 50)))
(display (list 'distinct (count-distinct-eq srcs))) (newline)
(define one (make-random-source))
(display (list 'repeat-collapses (count-distinct-eq (list one one one)))) (newline)
(define (estimate-pi n)
  (let loop ((i 0) (inside 0))
    (if (>= i n) (/ (* 4.0 inside) n)
        (let ((x (random-real)) (y (random-real)))
          (loop (+ i 1) (if (< (+ (* x x) (* y y)) 1) (+ inside 1) inside))))))
(define p (with-seed 1618 (lambda () (estimate-pi 1500))))
(display (list p (< (abs (- p 3.14159)) 0.2) (= p (with-seed 1618 (lambda () (estimate-pi 1500)))))) (newline)
