(define (estimate-pi n)
  (let loop ((i 0) (inside 0))
    (if (>= i n) (/ (* 4.0 inside) n)
        (let ((x (random-real)) (y (random-real)))
          (loop (+ i 1) (if (< (+ (* x x) (* y y)) 1) (+ inside 1) inside))))))
(display (with-seed 1618 (lambda () (estimate-pi 4000)))) (newline)
(define (histogram n trials)
  (let ((counts (make-vector n 0)))
    (for-each (lambda (_) (let ((k (random-integer n))) (vector-set! counts k (+ 1 (vector-ref counts k))))) (iota trials))
    (vector->list counts)))
(display (with-seed 8 (lambda () (histogram 6 6000)))) (newline)
(define (exp-variate rate) (/ (- (log (- 1 (random-real)))) rate))
(define (mean xs) (/ (apply + xs) (length xs)))
(display (with-seed 6 (lambda () (mean (map (lambda (_) (exp-variate 2)) (iota 1000)))))) (newline)
(define (shuffle lst)
  (let loop ((pool lst) (out (list)))
    (if (null? pool) (reverse out)
        (let* ((k (random-integer (length pool))) (pick (list-ref pool k)))
          (loop (append (take pool k) (drop pool (+ k 1))) (cons pick out))))))
(display (with-seed 5150 (lambda () (shuffle (iota 10))))) (newline)
