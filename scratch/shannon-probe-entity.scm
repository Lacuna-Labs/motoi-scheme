(entity/make 'e 10 20)
(display (list 'state-by-sym (entity/state 'e))) (newline)
(define h (world/spawn 'hero 5 6))
(display (list 'spawn-> h)) (newline)
(display (list 'state-by-val (entity/state h))) (newline)
(display (list 'x (entity/x h) 'y (entity/y h))) (newline)
(entity/hp! h 100)
(display (list 'hp (entity/hp h) 'ref-hp (entity/ref h 'hp))) (newline)
(entity/damage! h 5)
(display (list 'after-dmg (entity/hp h))) (newline)
(display (list 'id-based (entity/hp! 5 100) 'hp5 (entity/hp 5))) (newline)
(display (list 'ref-missing (entity/ref h 'age))) (newline)
(entity/set! h 'age 0)
(display (list 'ref-age (entity/ref h 'age))) (newline)
(display (list 'entity-id (entity/id h))) (newline)
(display (list 'state-hero (entity/state 'hero))) (newline)
