;;; conversation lane in motoi." Alfred 2026-07-16 hour-9l: "Physics. Chemistry. Etc."

(conversation-lane
  :subject "Motoi lib/ layout — utility + scientific-computing domains"
  :status  :active-with-alfred
  :owner   "Alfred"
  :where   "motoi-scheme/scratch/libs-conversation.slat")

;; ---------------------------------------------------------------------------
;; APPROVED LAYOUT (Alfred hour-9j via AskUserQuestion)
;; ---------------------------------------------------------------------------

(approved-utility-layout
  :status :locked
  :structure
  "motoi-scheme/
   ├── src/           engine core (13 files already there — reader/interp/base/macro/...)
   ├── lib/           standard libraries
   │   ├── base/         alg · r7rs-small · r7rs-types
   │   ├── graphics/     framebuffer · sprite · scene · animation
   │   ├── audio/        sound · audio-driver
   │   ├── game/         game · game-instances · game-theory · prefab · juggle
   │   ├── media/        media
   │   ├── ai/           ai (light ML)
   │   ├── system/       system · time-verbs · ops · topo · eng
   │   └── dev/          ide · web-ide · launcher · repl-plugins
   ├── adapters/      environment adapters (host/browser/node)
   └── (rest as before)")

;; ---------------------------------------------------------------------------
;; PENDING — scientific-computing domain libs (Alfred hour-9l said "Physics. Chemistry. Etc.")
;; ---------------------------------------------------------------------------

(proposed-domain-layout
  :status :awaiting-alfred-confirmation
  :interpretation
  "Motoi should be 'batteries included' Julia-style. Beyond the utility layout,
   add domain libs for scientific computing. Each is Motoi Scheme code
   implementing computational primitives + simulations — NOT RAG knowledge
   (that lives in graph-of-science)."

  :proposed-domain-subdirs
  ("lib/physics/     mechanics · dynamics · thermodynamics · EM · waves · N-body"
   "lib/chemistry/   elements · compounds · reactions · kinetics · stoichiometry"
   "lib/biology/     evolution · genetics · ecology · physiology"
   "lib/stats/       distributions · tests · regression · sampling"
   "lib/astronomy/   celestial mechanics · orbital simulation"
   "lib/earth/       geology · weather · climate models"
   "lib/economics/   supply/demand · game-theory (extends lib/game) · macro"
   "lib/linguistics/ tokenization · morphology · phonology · syntax")

  :composes-with
  ("Each domain lib gets its own MANIFEST + tests + example programs"
   "Each ALSO gets a companion book (book-of-physics, book-of-chemistry, etc.)
    in scheme-books/ that teaches the domain via Motoi code — same shape as
    book-of-math"
   "Copilot corpus expands: these books become training material"))

