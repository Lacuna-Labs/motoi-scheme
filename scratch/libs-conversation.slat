   (:destination "SPLIT"            :count 5  :note "adapters · base · game · wired-verbs · wired-verbs-priya-i-p")
   (:destination "ARCHIVE"          :count 5  :note "dispatch · interp · macro · reader · registry (superseded by Pass-1)")
   (:destination "Lacuna dialect"   :count 0  :note "no clear Lacuna modules in scheme-lang today"))
  :waves 6
