;;; shapes-book-appendix.slat — STAGING (scratch) · book appendix ·
;;; "The Six Teaching Shapes" — anchor seeds for dialogue-explosion.
;;;
;;; Written 2026-07-29. STAGING COPY (scratch). Ready to promote into a book's
;;; appendix block once Alfred names the host book (candidates: Book of Motoi
;;; appendices, or cs-curriculum). Mirrors the reference chapter 00g-shapes.slat
;;; but framed for the BOOK side: each record is an ANCHOR (a seed), not a
;;; finished dialogue. The dialogue-explosion pass turns each anchor into many
;;; conversations (anchor = seed doctrine); it does NOT invent the code — the
;;; code is fixed, runnable, and graded by the interpreter.
;;;
;;; AXIS: sensation (4S) throughout. These are concrete, hands-on, runnable
;;; lessons — the axis that regressed in Mk2 CPT and is over-weighted on purpose.
;;;
;;; Every :seed-code block RUNS through ./bin/motoi (verified 2026-07-29) except
;;; the two Shape-4 blocks marked :expect-error, which MUST fail.
;;;
;;; Made by Alfred Borden.

(dialect :applies ("motoi") :note "Book appendix — the six teaching shapes, as explosion anchors. Audience: a learner being shown how one verb becomes a family of lessons.")

(appendix
  :title "The Six Teaching Shapes"
  :kind "explosion-anchors"
  :axis "sensation"
  :training-eligible #t
  :confidentiality "public"
  :author "Alfred Borden"
  :reference-companion "00g-shapes.slat"
  :anchor-verb "fold"
  :explosion-contract
  "Each anchor below is a SEED. The fold explodes it along three axes: register
   (kid-seeded / layperson / PhD), Bloom band, and — where a lens fits — one of
   the 16 philosopher shapes (name never surfaces in the pair, only the shape).
   The seed-code is FIXED: the interpreter re-grades every exploded pair against
   :expect, so no explosion may drift the code. Weight the explosion toward the
   sensation axis: the felt, concrete, 'watch-it-run' framing before the abstract
   one."
  :prose
"# The six teaching shapes (appendix)

Made by Alfred Borden.

This appendix is the seed bank. Each of the six shapes is a way of turning one
verb — here, `fold` — into a runnable lesson, and each seed below is a starting
point a teacher can grow into a whole conversation. The point of putting them in
the book is simple: the model has to be taught the shapes THEMSELVES, not only
the verbs. A model that has read a thousand folds but never seen the shape of a
lesson can answer 'what does fold do' and still not know how to TEACH fold. This
appendix closes that gap.

Read the reference companion 00g-shapes.slat for the full account of the six
shapes and the 15-program grid. Here we keep the seeds, tagged for growth."
)

;; ─── Shape 0 · verb-identity (the grid) ───
(anchor :shape "0" :name "verb-identity" :axis "sensation" :verb "fold"
  :seed "The identity of a verb is its full grid: five rows, three disciplines, fifteen runnable programs. Show a learner one cell of fold's grid and grow it into 'what is fold, really?'"
  :seed-code "(fold + 0 (list 1 2 3 4))" :expect "10"
  :grow-toward ("what a verb IS across eng/math/cs" "why 15 and not 1" "one row at a time")
  :registers ("kid: a machine that eats a list and hands back one thing" "layperson: reduce a column of numbers to a total" "PhD: the catamorphism (α×β→β)×β×[α]→β"))

;; ─── Shape 1 · run-and-explain ───
(anchor :shape "1" :name "run-and-explain" :axis "sensation" :verb "fold"
  :seed "Predict, run, then trace the run step by step. The lesson is watching the answer come to be."
  :seed-code "(fold cons '() (list 1 2 3 4 5))" :expect "(5 4 3 2 1)"
  :trace "(cons 1 '())=>(1); (cons 2 '(1))=>(2 1); (cons 3 '(2 1))=>(3 2 1); ...=>(5 4 3 2 1)"
  :grow-toward ("predict-before-run habit" "substitution trace" "why the list reverses")
  :registers ("kid: watch each number jump to the front of the line" "layperson: each item stacks on top of the last" "PhD: SRFI-1 element-first order makes fold cons the reversal"))

;; ─── Shape 2 · decompose-and-label ───
(anchor :shape "2" :name "decompose-and-label" :axis "sensation" :verb "fold"
  :seed "Name the parts: signature, purpose, inventory, template. Then swap one part on purpose."
  :seed-code "(define (sum xs) (fold + 0 xs))\n(sum (list 1 2 3 4))" :expect "10"
  :labels (:signature "(list-of number) -> number" :inventory "combiner +, seed 0, list xs" :template "(fold <combiner> <seed> <list>)")
  :grow-toward ("HtDP-style decomposition" "same template, different organs (sum vs reverse)" "labels enable deliberate substitution")
  :registers ("kid: fold has three slots — what to combine with, what to start with, what to fold" "layperson: the recipe has three ingredients" "PhD: the template is the fold skeleton; combiner and seed instantiate it"))

;; ─── Shape 3 · build-up ladder ───
(anchor :shape "3" :name "build-up-ladder" :axis "sensation" :verb "fold" :second-voices ("iota" "filter")
  :seed "Climb generate -> filter -> reduce -> abstract, and make every rung run on its own."
  :rungs (
    (:rung 1 :label "generate" :code "(iota 6)" :expect "(0 1 2 3 4 5)")
    (:rung 2 :label "filter"   :code "(filter odd? (iota 6))" :expect "(1 3 5)")
    (:rung 3 :label "reduce"   :code "(fold + 0 (filter odd? (iota 6)))" :expect "9")
    (:rung 4 :label "abstract" :code "(define (sum-odd n) (fold + 0 (filter odd? (iota n))))\n(sum-odd 10)" :expect "25"))
  :grow-toward ("one runnable step at a time" "each rung wraps the last in one idea" "never hold the whole program in your head")
  :registers ("kid: build it like Lego, one brick each time" "layperson: add one step, run, add the next" "PhD: the pipeline generate/filter/reduce is the map-filter-fold triad"))

;; ─── Shape 4 · reversals ───
(anchor :shape "4" :name "reversals" :axis "sensation" :verb "fold" :second-voices ("filter")
  :seed "Go backward: from words to code, and from broken to fixed. Some seeds MUST fail."
  :words->code (:prompt "sum the squares of 1..5" :code "(fold + 0 (map (lambda (x) (* x x)) (iota 5 1)))" :expect "55")
  :broken->fixed (
    (:broken "(fold-left + 0 (list 1 2 3))" :expect-error "unbound symbol: fold-left"
     :fixed "(fold + 0 (list 1 2 3))" :fixed-expect "6"
     :lesson "fold-left is R6RS acc-first, deliberately unbound in Motoi; use SRFI-1 fold.")
    (:broken "(filter 42 (iota 6))" :expect-error "not a function: 42"
     :fixed "(filter even? (iota 6))" :fixed-expect "(0 2 4)"
     :lesson "filter's first argument must be a predicate, not a value."))
  :grow-toward ("code<->description both directions" "broken-for-the-right-reason is a lesson" "error class, not exit code")
  :registers ("kid: what did I do wrong, and how do I fix it?" "layperson: read the error, it names the mistake" "PhD: the interpreter's refusal of fold-left is a free correctness gate on R6RS/Racket names"))

;; ─── Shape 5 · comprehension vocabulary ───
(anchor :shape "5" :name "comprehension-vocabulary" :axis "sensation" :verb "fold" :second-voices ("filter" "fold-right")
  :seed "Name the pieces — combiner, seed, predicate, pure, tail-position — so the shape becomes sayable."
  :seed-code "(fold + 0 (filter odd? (list 1 2 3 4 5)))" :expect "9"
  :vocabulary (
    (:term "combiner" :points-at "+")
    (:term "seed" :points-at "0")
    (:term "predicate" :points-at "odd?")
    (:term "pure" :points-at "the whole fold — no effect, same answer every time")
    (:term "tail-position" :points-at "fold recurs in tail position; fold-right does not"))
  :grow-toward ("point-and-name each piece" "vocabulary turns tokens into shape" "the words make the other five shapes teachable")
  :registers ("kid: this plus sign is the 'combiner'; give the pieces names" "layperson: knowing the words lets you ask better questions" "PhD: the fold vocabulary is the interface every reduction shares"))
