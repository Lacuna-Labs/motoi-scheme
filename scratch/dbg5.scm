(define t '(("C" 0)("Bb" 10)))
(display (assoc "C" t))(newline)
(display (cadr (assoc "C" t)))(newline)
(define (pn->midi s)
  (let* ((n (string-length s))
         (oct (string->number (substring s (- n 1) n)))
         (pc (substring s 0 (- n 1)))
         (pair (assoc pc t)))
    (if (and oct pair) (+ (cadr pair) (* 12 (+ oct 1))) 60)))
(display (pn->midi "C4"))(newline)
(display (pn->midi "Bb3"))(newline)
