(display (motion/pocket 16 3)) (newline)
(display (motion/pocket 16 5)) (newline)
(display (motion/pocket 20 7)) (newline)
(display (motion/pocket 32 7)) (newline)
(define p (motion/pocket 20 7))
(define (contains? x xs) (if (null? xs) #f (or (= x (car xs)) (contains? x (cdr xs)))))
(display (and (contains? 0 p) (contains? 20 p) (contains? -20 p))) (newline)
(define (test-multiple-configs)
  (let loop ((cfgs '((16 3) (24 5) (32 7))) (all-ok #t))
    (cond ((null? cfgs) all-ok)
          (else (let* ((cfg (car cfgs)) (ps (motion/pocket (car cfg) (cadr cfg))))
                  (loop (cdr cfgs) (and all-ok (let inner ((xs ps)) (if (null? xs) #t (if (member (- (car xs)) ps) (inner (cdr xs)) #f))))))))))
(display (test-multiple-configs)) (newline)
(define cad (motion/cadence 120 'q))
