;; take row5
(define (chunk xs n) (if (null? xs) '() (cons (take xs n) (chunk (drop xs n) n))))
(display (chunk (list 1 2 3 4 5 6 7) 3))
(newline)
(define (window xs k n) (take (drop xs k) n))
(display (window (list 'a 'b 'c 'd 'e 'f) 2 3))
(newline)
(define (bounded xs cap) (if (> (length xs) cap) (append (take xs cap) (list '...)) xs))
(display (list (bounded (list 1 2 3 4 5) 3) (bounded (list 1 2) 3)))
(newline)
