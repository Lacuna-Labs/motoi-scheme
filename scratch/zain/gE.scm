(define (try th) (guard (e (#t 'raised)) (th)))
(define (nv x) (cond ((null? x) 'EMPTY) ((pair? x) 'pair) ((eq? x x) x) (else 'other)))

;; --- first ---
(display (list 'A1 (first (list 'ada 'brue 'cyd))))
(newline)
(display (list 'A2 (first (list 9)) 'A2b (try (lambda () (first '())))))
(newline)
(display (list 'A3 (if (first '()) 'truthy 'false)))
(newline)
(display (list 'A4 (first (list (list 1 2) (list 3 4)))))
(newline)
(display (list 'A5 (equal? (first (list 1 2 3)) (car (list 1 2 3)))))
(newline)
(display (list 'A6 (try (lambda () (first "abc"))) 'A6b (try (lambda () (car "abc")))))
(newline)

;; --- last ---
(display (list 'B1 (last (list 'ada 'brue 'cyd))))
(newline)
(display (list 'B2 (last (list 9))))
(newline)
(display (list 'B3 (if (last '()) 'truthy 'false)))
(newline)
(display (list 'B4 (last (list 1 2 3)) 'B4b (last-pair (list 1 2 3))))
(newline)
(display (list 'B5 (last (list 1 2 (list 3 4)))))
(newline)

;; --- take ---
(display (list 'C1 (take (list 1 2 3 4 5) 2)))
(newline)
(display (list 'C2 (take (list 1 2) 5) 'C2b (take (list 1 2) 0) 'C2c (take '() 3)))
(newline)
(display (list 'C3 (try (lambda () (take (list 1 2) -1)))))
(newline)
(display (list 'C4 (take (cons 1 2) 1)))
(newline)
(display (list 'C5 (eq? (take (list 1 2 3) 3) (list 1 2 3))))
(newline)

;; --- drop ---
(display (list 'D1 (drop (list 1 2 3 4 5) 2)))
(newline)
(display (list 'D2 (drop (list 1 2) 5) 'D2b (drop (list 1 2) 0)))
(newline)
(display (list 'D3 (try (lambda () (list-tail (list 1 2) 5)))))
(newline)
(display (list 'D4 (append (take (list 1 2 3 4) 2) (drop (list 1 2 3 4) 2))))
(newline)
(display (list 'D5 (drop (cons 1 2) 1)))
(newline)
(display (list 'D6 (let ((xs (list 1 2 3))) (list (eq? (drop xs 1) (drop xs 1)) (equal? (drop xs 1) (list-tail xs 1))))))
(newline)
