(define (safe-retail ys new) (if (list? new) (begin (set-cdr! ys new) ys) (cons (car ys) new)))
(display (list 'list-tail (safe-retail (list 1 2) (list 8 9)) 'atom-tail (safe-retail (list 1 2) 7)))(newline)
