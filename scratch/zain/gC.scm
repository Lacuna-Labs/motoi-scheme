(define (make-counter) (list 'count 0))
(define (bump! c) (set-car! (cdr c) (+ 1 (cadr c))) c)
(define cc (make-counter))
(bump! cc)(bump! cc)
(display cc)(newline)
(define (swap-heads! a b) (let ((tmp (car a))) (set-car! a (car b)) (set-car! b tmp)))
(define pa (list 1 2))(define qa (list 8 9))
(swap-heads! pa qa)
(display (list 'p pa 'q qa))(newline)
