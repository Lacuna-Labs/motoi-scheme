(define (tail-shared? build)
  (let ((host (build)) (t (list 8 9)))
    (set-cdr! host t)
    (eq? (cdr host) t)))
(display (list 'proper-list (tail-shared? (lambda () (list 1 2 3))) 'cons-pair (tail-shared? (lambda () (cons 1 2)))))(newline)
