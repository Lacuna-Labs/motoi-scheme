(define (try th) (guard (e (#t 'raised)) (th)))
;; zip
(display (list 'Z1 (zip (list 1 2 3) (list 'a 'b 'c))))
(newline)
(display (list 'Z2 (zip (list 1 2 3) (list 'a 'b))))
(newline)
(display (list 'Z3 (try (lambda () (zip (list 1 2))))))
(newline)
(display (list 'Z4 (try (lambda () (zip (list 1 2) (list 'a 'b) (list 'x 'y))))))
(newline)
(display (list 'Z5 (zip '() (list 1 2)) 'Z5b (zip (list 1 2) '())))
(newline)
(display (list 'Z6 (zip 5 (list 1 2)) 'Z6b (zip (list 1 2) 5)))
(newline)
(display (list 'Z7 (equal? (zip (list 1 2) (list 'a 'b)) (map list (list 1 2) (list 'a 'b)))))
(newline)
(display (list 'Z8 (map list (list 1 2) (list 'a 'b) (list 'x 'y))))
(newline)
(display (list 'Z9 (map list (list 1 2))))
(newline)
;; range
(display (list 'R1 (range 0 5)))
(newline)
(display (list 'R2 (try (lambda () (range 5)))))
(newline)
(display (list 'R3 (range 3 1) 'R3b (range 2 2)))
(newline)
(display (list 'R4 (range -2 2)))
(newline)
(display (list 'R5 (range 0 3.5) 'R5b (range 0.5 3)))
(newline)
(display (list 'R6 (try (lambda () (range 0 5 2)))))
(newline)
(display (list 'R7 (length (range 0 10)) 'R7b (first (range 0 10)) 'R7c (last (range 0 10))))
(newline)
(display (list 'R8 (try (lambda () (range 'a 'b)))))
(newline)
;; composites, pre-run for rows
(display (map (lambda (p) (list 'pair p)) (zip (list 'x 'y) (list 1 2))))
(newline)
(define (enumerate xs) (zip (range 0 (length xs)) xs))
(display (enumerate (list 'a 'b 'c)))
(newline)
(define (dot a b) (apply + (map (lambda (p) (* (first p) (last p))) (zip a b))))
(display (dot (list 1 2 3) (list 4 5 6)))
(newline)
(define (alist ks vs) (zip ks vs))
(display (assoc 'b (alist (list 'a 'b) (list 1 2))))
(newline)
(display (map (lambda (i) (* i i)) (range 1 6)))
(newline)
(display (apply + (range 1 101)))
(newline)
(define (evens n) (filter even? (range 0 n)))
(display (evens 10))
(newline)
(define (grid w h) (apply append (map (lambda (y) (map (lambda (x) (list x y)) (range 0 w))) (range 0 h))))
(display (grid 3 2))
(newline)
(display (list 'zip-drops-third (zip (list 1 2) (list 'a 'b))))
(newline)
