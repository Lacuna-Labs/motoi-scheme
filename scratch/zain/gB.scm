(display '---)(newline)
(define tail (list 8 9))
(define host (list 1 2 3))
(set-cdr! host tail)
(set-car! tail 'CHANGED)
(display (list 'host host 'tail tail 'shared (eq? (cdr host) tail)))(newline)
(display '---)(newline)
(define pr (cons 1 (list 8 9)))
(define t2 (list 8 9))
