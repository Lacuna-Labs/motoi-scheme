(define (try th) (guard (e (#t 'raised)) (th)))
(display '=== ) (newline)
;; first row2
(define queue (list 'ada 'brue 'cyd))
(display (list 'next-up (first queue) 'waiting (length (drop queue 1))))
(newline)
(define (head-of s) (first s))
(display (map head-of (list (list 1 2) (list 'x) (list "s" "t"))))
(newline)
(display (list 'list (try (lambda () (first (list 1 2))))
               'empty (if (first '()) 'truthy-NON-VALUE 'false)
               'dotted (if (first (cons 1 2)) 'truthy-NON-VALUE 'false)
               'string (first "abc")))
(newline)
;; first row3
(define xs (list 1 2 3))
(display (first xs))
(newline)
(define race (list 'ada 'brue 'cyd))
(display (list 'winner (first race)))
(newline)
(define seq (list 5 8 13 21))
(display (list 'a0 (first seq)))
(newline)
;; first row4
(display (list 'first=car (map (lambda (l) (equal? (first l) (car l)))
                               (list (list 1) (list 1 2) (list "s" 2) (list (list 3) 4)))))
(newline)
(define (rebuild l) (equal? l (cons (first l) (drop l 1))))
(display (map rebuild (list (list 1) (list 1 2 3))))
(newline)
(display (list 'unchanged (let ((l (list 1 2 3))) (first l) (length l))))
(newline)
;; first row5
(define (label-run xs) (list (first xs) (length xs)))
(display (label-run (list 'ore 'ore 'ore)))
(newline)
(define (argmax-by f xs) (first (sort xs (lambda (a b) (> (f a) (f b))))))
(display (argmax-by (lambda (n) n) (list 3 9 4)))
(newline)
(define (peek stack) (if (null? stack) 'empty (first stack)))
(display (list (peek (list 1 2)) (peek '())))
(newline)
