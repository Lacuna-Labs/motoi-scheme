(define (try th) (guard (e (#t 'raised)) (th)))
(define (kind v) (cond ((null? v) 'empty-list) ((pair? v) 'pair) (else (list 'NONVALUE (if v 'truthy 'falsy)))))
(define a (list 'p 'q 'r))
(list-set! a 1 'CHANGED)
(display (list 'after a))
(newline)
(display (list 'oob (try (lambda () (begin (list-set! a 9 'z) (length a))))))
(newline)
(define b (list 1 2 3))
(display (list 'list-set-result (list-set b 1 'X) 'original-b b))
(newline)
(display (list 'list-set-oob (list-set b 9 'X) 'list-set-nonlist (list-set 5 0 'X)))
(newline)
(display (list 'list-set!-returns (kind (list-set! (list 1 2) 0 'z))))
(newline)
(display (list 'list-set!-nonlist (try (lambda () (list-set! 5 0 'z)))))
(newline)
(display (list 'list-set!-pair (try (lambda () (list-set! (cons 1 2) 0 'z)))))
(newline)
