(define slot (list 'empty 0))
(set-car! slot 'ore)
(list-set! slot 1 7)
(display (list 'slot slot 'note 'second-field-needed-list-set))(newline)
(define board (list 'ada 'shift-lead))
(define whoever-is-looking board)
(set-car! board 'brue)
(display (list 'board board 'other-viewer whoever-is-looking))(newline)
(define (make-counter) (list 0))
(define (bump! c) (set-car! c (+ 1 (car c))) c)
(define c (make-counter))
(bump! c)(bump! c)
(display (list 'counter c))(newline)
(define xs (list 1 2 3))
(display (list 'cdr-is-a-fresh-copy (eq? (cdr xs) (cdr xs))))(newline)
(set-car! (cdr xs) 'LOST)
(display (list 'xs xs))(newline)
