(define (try th) (guard (e (#t 'raised)) (th)))
(display (list 'E1 (let ((e '())) (list-set! e 0 'x) (list 'len (length e) 'e e))))
(newline)
(display (list 'E2 (let ((xs (list 'p 'q 'r))) (list-set! xs 6 'FAR)
                     (list 'len (length xs) 'hole-null (null? (list-ref xs 4))
                           'hole-truthy (if (list-ref xs 4) 'truthy 'false)))))
(newline)
(display (list 'E3 (let ((xs (list 1 2 3))) (list-set! xs 3 'APP) (list 'len (length xs) 'xs xs))))
(newline)
;; vector-set! contrast
(display (list 'V1 (try (lambda () (let ((v (vector 1 2 3))) (vector-set! v 9 'x) v)))))
(newline)
;; row candidates: list-head
(define page (list 'a 'b 'c 'd 'e))
(display (list 'shown (list-head page 2) 'hidden (list-tail page 2)))
(newline)
(display (list 'agree (map (lambda (k) (equal? (list-head (list 1 2 3) k) (take (list 1 2 3) k))) (list 0 1 2 3 9))))
(newline)
;; row candidates: list-set
(define board (list 'empty 'empty 'empty))
(define moved (list-set board 1 'x))
(display (list 'before board 'after moved))
(newline)
(define (update-all xs v) (map (lambda (i) (list-set xs i v)) (list 0 1 2)))
(display (update-all (list 'a 'b 'c) 'Z))
(newline)
(define (safe-set xs i v) (if (and (>= i 0) (< i (length xs))) (list-set xs i v) (error "index out of range" i)))
(display (list (safe-set (list 1 2 3) 1 9) (try (lambda () (safe-set (list 1 2 3) 9 9)))))
(newline)
;; row candidates: list-set!
(define grid (list 0 0 0 0))
(list-set! grid 2 'X)
(display grid)
(newline)
(define (fill! xs v) (let loop ((i 0)) (if (< i (length xs)) (begin (list-set! xs i v) (loop (+ i 1))) xs)))
(display (fill! (list 1 2 3) '-))
(newline)
(define (swap! xs i j) (let ((t (list-ref xs i))) (list-set! xs i (list-ref xs j)) (list-set! xs j t) xs))
(display (swap! (list 'a 'b 'c) 0 2))
(newline)
;; row candidates: nth
(define row (list 'name 'age 'city))
(display (list 'field1 (nth row 1)))
(newline)
(define (col table i) (map (lambda (r) (nth r i)) table))
(display (col (list (list 1 2) (list 3 4) (list 5 6)) 1))
(newline)
(define (safe-nth xs i) (if (and (>= i 0) (< i (length xs))) (nth xs i) 'out-of-range))
(display (list (safe-nth (list 1 2) 1) (safe-nth (list 1 2) 9)))
(newline)
