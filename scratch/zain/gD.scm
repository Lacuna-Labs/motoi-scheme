(define (try th) (guard (e (#t 'raised)) (th)))
(define (kind v) (cond ((null? v) 'empty-list) ((pair? v) 'pair) (else 'NON-VALUE)))
(display (list 'take-dotted (try (lambda () (take (cons 1 (cons 2 3)) 2)))
               'drop-dotted (try (lambda () (drop (cons 1 (cons 2 3)) 1)))))(newline)
(display (list 'drop-shares (let ((xs (list 1 2 3))) (eq? (drop xs 1) (list-tail xs 1)))
               'drop-eq-list-tail (equal? (drop (list 1 2 3) 1) (list-tail (list 1 2 3) 1))
               'list-tail-too-far (try (lambda () (list-tail (list 1 2) 5)))))(newline)
(display (list 'first-of-1 (first (list 'only)) 'last-of-1 (last (list 'only))
               'first-empty (kind (first '())) 'last-empty (kind (last '()))
               'first-string (try (lambda () (kind (first "abc"))))))(newline)
(display (list 'take-exact (take (list 1 2 3) 3) 'take-all (take (list 1 2 3) 99)
               'drop-exact (drop (list 1 2 3) 3) 'drop-past (drop (list 1 2 3) 99)))(newline)
(display (list 'take+drop=whole (equal? (append (take (list 1 2 3 4) 2) (drop (list 1 2 3 4) 2)) (list 1 2 3 4))
               'lengths (list (length (take (list 1 2 3 4) 2)) (length (drop (list 1 2 3 4) 2)))))(newline)
(display (list 'split-at (split-at (list 1 2 3 4) 2) 'take-right (take-right (list 1 2 3 4) 2) 'last-pair (last-pair (list 1 2 3))))(newline)
