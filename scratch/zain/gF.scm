(define (try th) (guard (e (#t 'raised)) (th)))
(display (list 'S1 (first "abc") 'string? (string? (first "abc")) 'char? (char? (first "abc"))))
(newline)
(display (list 'S2 (last "abc") 'string? (string? (last "abc"))))
(newline)
(display (list 'S3 (try (lambda () (first (cons 1 2)))) 'S3b (try (lambda () (last (cons 1 2))))))
(newline)
(display (list 'S4 (if (first (cons 1 2)) 'truthy 'false)))
(newline)
(display (list 'S5 (try (lambda () (first 5)))))
(newline)
;; row candidates
(define readings (list 12.4 12.6 12.5 13.1))
(display (list 'first (first readings) 'last (last readings) 'span (- (last readings) (first readings))))
(newline)
(define (window xs k n) (take (drop xs k) n))
(display (window (list 'a 'b 'c 'd 'e 'f) 2 3))
(newline)
(define (chunk xs n)
  (if (null? xs) '() (cons (take xs n) (chunk (drop xs n) n))))
(display (chunk (list 1 2 3 4 5 6 7) 3))
(newline)
(define (rotate xs k) (append (drop xs k) (take xs k)))
(display (rotate (list 1 2 3 4 5) 2))
(newline)
(display (list 'take+drop (let ((xs (list 1 2 3 4 5)))
  (map (lambda (k) (equal? xs (append (take xs k) (drop xs k)))) (list 0 1 2 3 4 5)))))
(newline)
(display (list 'lengths (let ((xs (list 1 2 3 4 5)))
  (map (lambda (k) (list (length (take xs k)) (length (drop xs k)))) (list 0 2 5 9)))))
(newline)
(display (list 'first=car (equal? (first (list 1 2)) (car (list 1 2)))
               'last=car-last-pair (equal? (last (list 1 2 3)) (car (last-pair (list 1 2 3))))))
(newline)
