(define (try th) (guard (e (#t 'raised)) (th)))
(define (kind v) (cond ((null? v) 'empty-list) ((pair? v) 'pair) (else (list 'NONVALUE (if v 'truthy 'falsy)))))
(display (list 'set-car-empty (try (lambda () (set-car! '() 1)))))
(newline)
(display (list 'set-cdr-nonlist (try (lambda () (set-cdr! (list 1 2) 7)))))
(newline)
(define pp (cons 1 2))
(set-cdr! pp 7)
(display (list 'cons-cell-dotted-ok pp))
(newline)
(define zs (list 1 2 3))
(display (list 'set-car-returns (kind (set-car! zs 5))))
(newline)
(define lit '(1 2 3))
(display (list 'mutate-quoted (try (lambda () (begin (set-car! lit 'Q) lit)))))
(newline)
(define sh (list 1 2 3))
(define alias sh)
(set-car! sh 'SHARED)
(display (list 'aliased alias))
(newline)
