(define allowed (list 1 2 3 5 8))
(define (permitted? code) (if (memv code allowed) #t #f))
(display (map permitted? (list 2 4 8)))(newline)
(display (list 'sym (memv 'c '(a b c d)) 'chr (memv #\c (list #\a #\c)) 'str (memv "b" (list "a" "b")) 'flo (memv 2.0 (list 1.0 2.0)) 'miss (memv 9 '(1 2))))(newline)
(define route (list 1 2 3 4 5 6))
(define (rest-of-journey from) (memv from route))
(display (list 'from-4 (rest-of-journey 4) 'from-9 (rest-of-journey 9)))(newline)
(define seq (list 5 8 13 21 34))
(display (list 'suffix (memv 13 seq) 'length-from (length (memv 13 seq)) 'absent (memv 7 seq)))(newline)
(define xs (list 1 2 3 4))
(display (list 'tail (memv 3 xs) 'is-suffix (equal? (memv 3 xs) (list-tail xs 2)) 'miss (memv 9 xs)))(newline)
(define (memv-agrees-with-eqv? x ys0)
  (equal? (memv x ys0)
          (let loop ((ys ys0)) (cond ((null? ys) #f) ((eqv? (car ys) x) ys) (else (loop (cdr ys)))))))
(display (list 'ints (memv-agrees-with-eqv? 3 (list 1 2 3))
               'chars (memv-agrees-with-eqv? #\b (list #\a #\b))
               'rationals (memv-agrees-with-eqv? 1/2 (list 1/3 1/2))))(newline)
(display (list 'memv-equals-memq (equal? (memv 1/2 (list 1/2)) (memq 1/2 (list 1/2))) 'member-finds-it (member 1/2 (list 1/2)) 'eqv-says (eqv? 1/2 1/2)))(newline)
(define vowels (list #\a #\e #\i #\o #\u))
(define (vowel? c) (if (memv c vowels) #t #f))
(display (map vowel? (list #\a #\z #\o)))(newline)
(define (dedupe ds)
  (cond ((null? ds) '())
        ((memv (car ds) (cdr ds)) (dedupe (cdr ds)))
        (else (cons (car ds) (dedupe (cdr ds))))))
(display (dedupe (list 1 2 1 3 2 4)))(newline)
(define (safe-member x ys) (if (member x ys) #t #f))
(display (list 'memv-on-rational (if (memv 1/2 (list 1/2)) 'found 'MISSED) 'member-on-rational (safe-member 1/2 (list 1/2))))(newline)
