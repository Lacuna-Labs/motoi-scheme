(define chart (list (list 12 'window) (list 13 'aisle) (list 14 'middle)))
(display (list 'seat-13 (assv 13 chart) 'seat-99 (assv 99 chart)))
(newline)
(define f (list (list 0 1) (list 1 1) (list 2 2) (list 3 6)))
(define (apply-f n) (let ((e (assv n f))) (if e (cadr e) 'undefined)))
(display (map apply-f (list 0 3 7)))
(newline)
(define t (list (list 1 'a) (list 2 'b) (list 3 'c)))
(display (list 'entry (assv 2 t) 'is-member (if (assv 2 t) #t #f) 'miss (assv 9 t)))
(newline)
(define (assv-agrees-with-eqv? k tt)
  (let ((found (assv k tt))
        (hand (let loop ((xs tt)) (cond ((null? xs) #f) ((eqv? (caar xs) k) (car xs)) (else (loop (cdr xs)))))))
    (equal? found hand)))
(display (list 'ints (assv-agrees-with-eqv? 2 (list (list 1 'a) (list 2 'b)))
               'rationals (assv-agrees-with-eqv? 1/2 (list (list 1/2 'half)))))
(newline)
(define t2 (list (list 1/2 'half)))
(display (list 'assq (assq 1/2 t2) 'assv (assv 1/2 t2) 'assoc (assoc 1/2 t2)
               'assv-equals-assq (equal? (assv 1/2 t2) (assq 1/2 t2))))
(newline)
(define opcodes (list (list 0 'nop) (list 1 'load) (list 2 'store) (list 3 'halt)))
(define (decode n) (let ((e (assv n opcodes))) (if e (cadr e) 'illegal)))
(display (map decode (list 0 2 3 9)))
(newline)
(define (table->function tt fallback)
  (lambda (k) (let ((e (assv k tt))) (if e (cadr e) fallback))))
(define fib (table->function (list (list 0 0) (list 1 1) (list 2 1) (list 3 2) (list 4 3)) 'out-of-table))
(display (map fib (list 0 4 9)))
(newline)
(define (safe-lookup k tt) (let ((e (assoc k tt))) (if e (cadr e) 'absent)))
(define t3 (list (list 1/2 'half) (list 2 'two)))
(display (list 'assv-path (if (assv 1/2 t3) 'found 'MISSED) 'assoc-path (safe-lookup 1/2 t3)))
(newline)
