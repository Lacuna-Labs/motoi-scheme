(define (try th) (guard (e (#t 'raised)) (th)))
;; list-head
(display (list 'H1 (list-head (list 1 2 3 4) 2) 'H2 (list-head (list 1 2) 9)
               'H3 (list-head (list 1 2) 0) 'H4 (list-head '() 3)
               'H5 (list-head (cons 1 2) 1) 'H6 (list-head (list 1 2) -1)))
(newline)
(display (list 'H7 (equal? (list-head (list 1 2 3) 2) (take (list 1 2 3) 2))))
(newline)
(display (list 'H8 (eq? (list-head (list 1 2 3) 3) (list 1 2 3))))
(newline)
(display (list 'H9 (map (lambda (k) (list-head (list 1 2 3) k)) (list 0 1 2 3))))
(newline)
(display (list 'H10 (let ((xs (list 1 2 3))) (equal? xs (append (list-head xs 1) (list-tail xs 1))))))
(newline)
;; list-set
(display (list 'S1 (list-set (list 1 2 3) 1 99)))
(newline)
(display (list 'S2 (let* ((xs (list 1 2 3)) (ys (list-set xs 1 99))) (list 'orig xs 'new ys 'same (eq? xs ys)))))
(newline)
(display (list 'S3 (list-set (list 1 2 3) 9 'FAR) 'S3b (list-set (list 1 2 3) -1 'NEG)))
(newline)
(display (list 'S4 (list-set 5 0 'x) 'S4b (list-set "ab" 0 'x) 'S4c (list-set '() 0 'x)))
(newline)
(display (list 'S5 (try (lambda () (list-set (cons 1 2) 0 'x)))))
(newline)
;; list-set!
(display (list 'M1 (let ((xs (list 1 2 3))) (list-set! xs 1 99) xs)))
(newline)
(display (list 'M2 (let ((xs (list 1 2 3))) (if (list-set! xs 0 'a) 'truthy-NON-VALUE 'false))))
(newline)
(display (list 'M3 (let ((xs (list 'p 'q 'r))) (list-set! xs 6 'FAR) (list 'len (length xs) 'xs xs))))
(newline)
(display (list 'M4 (try (lambda () (list-set! 5 0 'x)))
               'M4b (try (lambda () (list-set! (cons 1 2) 0 'x)))
               'M4c (try (lambda () (list-set! '() 0 'x)))))
(newline)
(display (list 'M5 (let ((xs (list 1 2 3))) (list-set! xs -1 'NEG) (list 'len (length xs) 'xs xs))))
(newline)
(display (list 'M6 (let* ((xs (list 1 2 3)) (alias xs)) (list-set! xs 0 'A) (list 'xs xs 'alias alias 'eq (eq? xs alias)))))
(newline)
(display (list 'M7 (let ((xs (list 1 2 3))) (list-set! xs 1.7 'F) (list 'len (length xs) 'xs xs))))
(newline)
;; nth
(display (list 'N1 (nth (list 'a 'b 'c) 1)))
(newline)
(display (list 'N2 (if (nth (list 1 2) 9) 'truthy-NON-VALUE 'false)
               'N2b (if (nth (list 1 2) -1) 'truthy-NON-VALUE 'false)))
(newline)
(display (list 'N3 (try (lambda () (list-ref (list 1 2) 9)))))
(newline)
(display (list 'N4 (equal? (nth (list 1 2 3) 0) (first (list 1 2 3)))
               'N4b (equal? (nth (list 1 2 3) 2) (list-ref (list 1 2 3) 2))))
(newline)
(display (list 'N5 (nth "abc" 1) 'N5b (nth (cons 1 2) 0)))
(newline)
(display (list 'N6 (map (lambda (i) (nth (list 'x 'y 'z) i)) (list 0 1 2))))
(newline)
