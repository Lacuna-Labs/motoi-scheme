;; Spawn coins in a checkerboard pattern.
(world/reset!)
(let ((rows 6)
      (cols 8)
      (cell-size 60)
      (x-start 100)
      (y-start 100))
  (let row-loop ((r 0))
    (when (< r rows)
      (let col-loop ((c 0))
        (when (< c cols)
          (when (= (modulo (+ r c) 2) 0)
            (let ((x (+ x-start (* c cell-size) (/ cell-size 2)))
                  (y (+ y-start (* r cell-size) (/ cell-size 2))))
              (world/spawn (string->symbol (string-append "coin-" (number->string r) "-" (number->string c)))
                           `((x . ,x) (y . ,y) (sprite . "coin")))))
          (col-loop (+ c 1))))
      (row-loop (+ r 1)))))
(world/step)
