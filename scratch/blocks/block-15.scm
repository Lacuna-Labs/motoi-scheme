;; Spawn coins along the four edges of the screen.
(world/reset!)
(let ((margin 50)
      (spacing 120))
  ;; Top edge
  (let loop ((i 0))
    (when (< i 6)
      (let ((x (+ 100 (* i spacing)))
            (y margin))
        (world/spawn (string->symbol (string-append "top-" (number->string i)))
                     `((x . ,x) (y . ,y) (sprite . "coin"))))
      (loop (+ i 1))))
  ;; Bottom edge
  (let loop ((i 0))
    (when (< i 6)
      (let ((x (+ 100 (* i spacing)))
            (y (- 600 margin)))
        (world/spawn (string->symbol (string-append "bottom-" (number->string i)))
                     `((x . ,x) (y . ,y) (sprite . "coin"))))
      (loop (+ i 1))))
  ;; Left edge
  (let loop ((i 0))
    (when (< i 3)
      (let ((x margin)
            (y (+ 150 (* i 120))))
        (world/spawn (string->symbol (string-append "left-" (number->string i)))
                     `((x . ,x) (y . ,y) (sprite . "coin"))))
      (loop (+ i 1))))
  ;; Right edge
  (let loop ((i 0))
    (when (< i 3)
      (let ((x (- 800 margin))
            (y (+ 150 (* i 120))))
        (world/spawn (string->symbol (string-append "right-" (number->string i)))
                     `((x . ,x) (y . ,y) (sprite . "coin"))))
      (loop (+ i 1)))))
(world/step)
