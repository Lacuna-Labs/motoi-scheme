(display "norm C6 {0,3}: ") (display (alg/normalizer (alg/cyclic 6) '(0 3))) (newline)
(display "norm C4 {0,2}: ") (display (alg/normalizer (alg/cyclic 4) '(0 2))) (newline)
(display "left-cosets C6 {0,2,4}: ") (display (alg/left-cosets (alg/cyclic 6) '(0 2 4))) (newline)
(display "right-cosets C6 {0,2,4}: ") (display (alg/right-cosets (alg/cyclic 6) '(0 2 4))) (newline)
(display "quotient C6 {0,2,4}: ") (display (alg/quotient (alg/cyclic 6) '(0 2 4))) (newline)
(display "action C4 rotate pt: ") (display (alg/action (alg/cyclic 4) 0 (lambda (g x) (modulo (+ g x) 4)))) (newline)
(display "commutator C6 (abelian): ") (display (alg/commutator (alg/cyclic 6) 2 3)) (newline)
(display "commutator D3 refs: ") (display (alg/commutator (alg/dihedral 3) '(ref 0) '(ref 1))) (newline)
(display "centralizer D3 ref0: ") (display (alg/centralizer (alg/dihedral 3) '(ref 0))) (newline)
(display "centralizer C6 elt: ") (display (alg/centralizer (alg/cyclic 6) 2)) (newline)
(display "generate D3 {rot1}: ") (display (alg/generate (alg/dihedral 3) '((rot 1)))) (newline)
(display "generate C6 {2}: ") (display (alg/generate (alg/cyclic 6) '(2))) (newline)
(display "generators D3: ") (display (alg/generators (alg/dihedral 3))) (newline)
(display "subgroups D3: ") (display (alg/subgroups (alg/dihedral 3))) (newline)
(display "is-subgroup D3 rots: ") (display (alg/is-subgroup? (alg/dihedral 3) '((rot 0) (rot 1) (rot 2)))) (newline)
(display "is-subgroup C6 bad {1,2}: ") (display (alg/is-subgroup? (alg/cyclic 6) '(1 2))) (newline)
(display "isomorphism C4 C4: ") (display (alg/isomorphism? (alg/cyclic 4) (alg/cyclic 4) (lambda (x) x))) (newline)
