;;; tokenizer-sanity-2026-07-16.slat
;;;
;;; Qwen tokenizer sanity check against Motoi CORE verbs.
;;; Answers: how many subword pieces does Qwen produce per Motoi verb?
;;; Decision gate: avg > 3 pieces → flag for tokenizer extension.
;;;
;;; :doc              "tokenizer-sanity-2026-07-16"
;;; :audience         :engineer
;;; :confidentiality  :internal
;;; :training-eligible #f
;;; :dialect          "motoi"
;;; :provenance       "the-engineer training-foundation-lane 2026-07-16"
;;; :owner            "The Engineer"
;;; :tags             (:motoi :copilot :qwen2.5-coder :tokenizer :sanity-check
;;;                    :decision-gate :training-foundation)

(document
  :name          "tokenizer-sanity-2026-07-16"
  :date          "2026-07-16"
  :owner         "The Engineer"
  :audience      :engineer
  :confidentiality :internal
  :training-eligible #f
  :inputs
  ("motoi-scheme/scratch/motoi-core-verbs-list.slat        ; 322 CORE entries (309 verbs + 13 constants)"
   "Qwen/Qwen2.5-Coder-1.5B-Instruct tokenizer            ; via transformers AutoTokenizer, fast mode"
   "research/small-model-dsl-teaching-2026-07-16.slat     ; section 4 :tokenizer-note — decision gate")
  :method
  "Loaded Qwen tokenizer (vocab_size 151643). Tokenized top-200 verbs
   from CORE list in listed order (kid-first-month reach set). For each
   verb, called encode(v, add_special_tokens=False) and recorded the
   piece count + decoded pieces. Computed histogram + average + top-15
   worst.")

;; ==========================================================================
;; HEADLINE
;; ==========================================================================

(headline
  :avg-subwords-per-verb 3.00
  :median 3
  :min 1
  :max 7
  :verdict "AT-GATE-BOUNDARY."
  :rationale
  "Research doc (small-model-dsl-teaching section 4) sets the trigger at
   avg > 3 pieces. Actual measured is 3.00 — sitting exactly on the line.
   This is a WARNING BAND, not a red flare. Tokenizer extension is not
   urgent, but should be treated as an EARNED OPTIMIZATION for later
   training rounds if verb-recall underperforms. First training pass may
   proceed without extension.")

;; ==========================================================================
;; HISTOGRAM
;; ==========================================================================

(histogram
  :verbs-analyzed 200
  :bins
  ((:pieces 1 :count 15  :pct  7.5)
   (:pieces 2 :count 42  :pct 21.0)
   (:pieces 3 :count 92  :pct 46.0)
   (:pieces 4 :count 34  :pct 17.0)
   (:pieces 5 :count 13  :pct  6.5)
   (:pieces 6 :count  3  :pct  1.5)
   (:pieces 7 :count  1  :pct  0.5))
  :cumulative
  ((:at-or-below-2 :count 57  :pct 28.5)
   (:at-or-below-3 :count 149 :pct 74.5)
   (:at-or-below-4 :count 183 :pct 91.5)
   (:at-or-above-5 :count 17  :pct  8.5)))

;; ==========================================================================
;; TOP-15 WORST-TOKENIZED VERBS
;; ==========================================================================

(worst-tokenized
  :top-15
  ((:verb "geom/circle-circumference"  :pieces 7 :decoded ("geom" "/c" "ircle" "-c" "irc" "um" "ference"))
   (:verb "easing/decelerated"         :pieces 6 :decoded ("e" "asing" "/de" "cel" "er" "ated"))
   (:verb "easing/accelerated"         :pieces 6 :decoded ("e" "asing" "/" "accel" "er" "ated"))
   (:verb "easing/ease-in-out"         :pieces 6 :decoded ("e" "asing" "/e" "ase" "-in" "-out"))
   (:verb "on-canvas-trace"            :pieces 5 :decoded ("on" "-c" "anvas" "-tr" "ace"))
   (:verb "easing/emphasized"          :pieces 5 :decoded ("e" "asing" "/em" "phas" "ized"))
   (:verb "easing/ease-in"             :pieces 5 :decoded ("e" "asing" "/e" "ase" "-in"))
   (:verb "easing/ease-out"            :pieces 5 :decoded ("e" "asing" "/e" "ase" "-out"))
   (:verb "animation/set-reflow-policy":pieces 5 :decoded ("animation" "/set" "-ref" "low" "-policy"))
   (:verb "motion/anchor-to-input"     :pieces 5 :decoded ("motion" "/" "anchor" "-to" "-input"))
   (:verb "motion/with-feel"           :pieces 5 :decoded ("motion" "/" "with" "-fe" "el"))
   (:verb "motion/with-pace"           :pieces 5 :decoded ("motion" "/" "with" "-" "pace"))
   (:verb "input/may-i?"               :pieces 5 :decoded ("input" "/m" "ay" "-i" "?"))
   (:verb "sub-position-per-beat"      :pieces 5 :decoded ("sub" "-position" "-per" "-be" "at"))
   (:verb "audio/onset-strength"       :pieces 5 :decoded ("audio" "/on" "set" "-st" "rength")))

  :pattern-observations
  ("The `easing/*` family accounts for 5 of the top-15. Because 'easing/'
    prefixes always split as ('e', 'asing', '/...'), every one of the
    ~8 easing verbs inherits a 3-piece prefix tax. Same pattern for
    'motion/' which splits ('motion', '/...' or '/', ...) reliably."
   "Hyphenated compound tails ('-in-out', '-per-beat', '-onset-strength')
    are the second-largest driver. The tokenizer breaks at every '-' and
    at every '/' but does not group Motoi's compound verb-names as
    domain-atoms."
   "Question-mark suffix ('may-i?') pushes an extra piece; predicate-`?`
    is a Scheme idiom the base tokenizer does not compact."))

;; ==========================================================================
;; SINGLE-TOKEN VERBS (FREE — no tax)
;; ==========================================================================

(single-token-verbs
  :count 15
  :verbs
  ("viewport" "cols" "rows" "sprite" "sprites"
   "bounce" "slide" "fade" "touch" "after"
   "wait" "stop" "frame" "note" "random")
  :note "These verbs are common English words already in the tokenizer as
         single pieces. Zero tokenization overhead. This is where Motoi's
         plain-English verb-naming style pays off directly.")

;; ==========================================================================
;; DECISION GATE
;; ==========================================================================

(decision-gate
  :threshold "avg > 3 subword pieces per verb → flag tokenizer extension"
  :measured 3.00
  :verdict :on-the-line
  :recommendation :defer-with-followup

  :rationale
  ("Sitting exactly at threshold is a warning, not a stop. First training
    pass can proceed against the stock Qwen tokenizer. Full FT on 47k
    pairs at 3 epochs may compensate through composition-context signal."
   "8.5% of top-200 CORE verbs (17 verbs) split into 5+ pieces. These are
    the highest-cost verbs during both training (more tokens to predict
    per verb) and inference (more tokens to generate). Worth watching in
    training-loss curves — if the model plateaus, these may be the drag."
   "The easing/* and motion/* families are systematic — adding ~20
    high-frequency verb names as new tokens would cut ~40% of the top-200
    verb-piece total. High-leverage lift IF the first training round
    shows verb-recall issues on these families specifically.")

  :extension-lift-if-triggered
  ("Add ~200 Motoi-specific tokens to Qwen vocabulary (embedding-layer
    resize from 151643 → ~151843)."
   "Retrain embedding rows for new tokens; freeze existing rows for first
    epoch (warmup), then unfreeze for co-adaptation."
   "Trade-off: complicates training pipeline, requires custom tokenizer
    build + tokenizer.json patch, forces every downstream deployment
    (GGUF, MLX, ONNX) to re-quantize with the extended vocab. Non-trivial
    engineering but well-understood territory (Qwen team ships extended
    tokenizer variants for domain models already)."
   "Recommended ONLY IF Round 1 verb-recall on easing/motion/hyphenated
    verb families is materially worse than on single-token verb families."))

;; ==========================================================================
;; WHAT THIS MEANS FOR THE CORPUS
;; ==========================================================================

(corpus-implication
  :average-pair-length-adjustment
  "Motoi pairs will average ~200-400 tokens per pair (per research doc
   section 4). The tokenizer measurement here tightens that estimate:
   with 3.00 subwords per verb and 5-15 verbs per typical pair, the
   verb-content of a pair alone is 15-45 tokens. Add prose framing +
   S-expression punctuation (which Qwen tokenizes tightly) and the
   200-400 range holds."

  :verb-coverage-implication
  "The 20-pairs-per-verb coverage constraint (from research doc section 3)
   remains achievable. Each of the 322 CORE verbs × ~20 pairs = ~6,400
   pair-slots, well within the 47-54k budget. Tokenizer piece-count does
   not change this arithmetic."

  :attention-cost
  "3 pieces per verb means the attention layer sees each verb as a
   sequence-of-3, not as an atom. The model must learn to bind those
   three pieces to the same semantic action. 1.5B parameters is enough
   capacity for this per MultiPL-T Racket precedent (~40k pairs on a 1B
   model taught Racket's built-in vocabulary successfully).")

;; ==========================================================================
;; ARTIFACTS
;; ==========================================================================

(artifacts
  :raw-json "/tmp/tokenizer-results.json (200-verb detail, per-piece decode)"
  :verb-list "/tmp/motoi-top200-verbs.txt"
  :script "In-lined in this scratch note; re-run with:
           from transformers import AutoTokenizer
           tok = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-Coder-1.5B-Instruct')
           for v in verbs: print(v, len(tok.encode(v, add_special_tokens=False)))")

;; ==========================================================================
;; OPEN ITEMS
;; ==========================================================================

(open-items
  ("Full 322-verb sweep (not just top-200) if a completeness signal is
    needed. Top-200 covers the kid-first-month reach; the remaining 122
    are still CORE but lower-frequency. Expected avg for full 322 is
    within 0.1 of the top-200 measurement based on similar naming
    patterns."
   "Extension probe: measure same statistic on Qwen2.5-Coder-3B tokenizer.
    Same vocab expected (Qwen uses one tokenizer across sizes), but
    confirming makes the backup-model path predictable."
   "Round-1 diagnostic: after first training pass, plot verb-recall
    accuracy against per-verb piece count. If correlation is strong
    (worse recall for higher piece counts), decision gate flips to
    :extend-tokenizer for Round 2."))

;; ==========================================================================
;; END
;; ==========================================================================
