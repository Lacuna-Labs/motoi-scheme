;;; 31-group.slat — Motoi Scheme Reference · Chapter 31 · library group
;;;
;;; 3 verbs in this library. Read chapter 00-intro.slat first.
;;; Full 15-program standard authored 2026-07-22.

(dialect :applies ("motoi") :note "Library group — 3 verbs.")

(chapter :number "31" :library "group" :verb-count 3 :training-eligible #t)

(verb :name "group/count" :std "Motoi" :library "group" :tier "core" :kind "pure" :signature "(group/count tag) -> integer"
  :summary "Count alive entities with a given tag."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(group/count 'enemy)" :note "Count of tagged entities.")
    (:dialect "motoi" :tier "intermediate" :code "(if (< (group/count 'enemy) 5) (prefab/spawn 'enemy 0 0) 'skip)" :note "Gate spawn on population.")
    (:dialect "motoi" :tier "expert"       :code "(define (populate-until tag target spawn) (let loop () (when (< (group/count tag) target) (spawn) (loop))))\n(populate-until 'enemy 3 (lambda () 'spawned))" :note "Fill to target population."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(define (spawn-if-low tag k spawn) (when (< (group/count tag) k) (spawn)))\n(spawn-if-low 'enemy 5 (lambda () 'spawn))"
     :math-program "(define (cardinality tag) (group/count tag))\n(cardinality 'enemy)"
     :cs-program "(define (safe-count tag) (if (symbol? tag) (group/count tag) (error 'need-symbol)))\n(safe-count 'enemy)"
     :problem "Wave manager needs current population count before deciding to spawn more."
     :explanation "eng: population gate. math: cardinality read. cs: type-guarded count."
     :meta "Reach for group/count and NOT group/find + length: find allocates a list; count is a direct read.")
    (:eng "Cheap read for a gating decision." :math "Cardinality of tag-set." :cs "O(1) or O(n) depending on index; either way no allocation of ID list."))
  :row-3-dimension (
    (:setup "Tag-population read for capacity decisions."
     :rungs (
       (:domain "engineering"  :code "(group/count 'enemy)")
       (:domain "mathematics"  :code "|{e : tag(e) = 'enemy}|")
       (:domain "cs / dispatch" :code "(group/count (parse-tag msg))"))
     :explanation "Direct, set-cardinality, parsed dispatch."
     :meta "Cardinality of a tag class.")
    (:eng "Gate work on population." :math "Counting measure on tag class." :cs "SELECT COUNT(*) over tag column."))
  :row-4-proof (
    (:eng-program "(define a (group/count 'enemy))\n(define b (group/count 'enemy))\n(= a b)"
     :math-program "(define (nonneg?) (>= (group/count 'enemy) 0))\n(nonneg?)"
     :cs-program "(define (returns-int?) (integer? (group/count 'enemy)))\n(returns-int?)"
     :claim "Pure read of the tag-index; returns nonneg integer."
     :invariant "∀ tag. group/count(tag) ∈ ℤ≥0 ∧ pure within a slice"
     :meta "Pattern: monotone-counter read.")
    (:eng "Cheap enough to poll each frame." :math "Nonneg integer." :cs "Read of aggregate stat over indexed collection."))
  :row-5-emergence (
    (:eng-composition "(define (auto-populate tag target spawn) (let loop () (when (< (group/count tag) target) (spawn) (loop))))\n(auto-populate 'enemy 3 (lambda () 'spawn))"
     :math-composition "(define (proportion tag total) (if (zero? total) 0 (/ (group/count tag) total)))\n(proportion 'enemy 10)"
     :cs-composition "(define (metric-emit tag on-change) (let ((prev 0)) (lambda () (let ((c (group/count tag))) (unless (= c prev) (on-change c)) (set! prev c)))))\n((metric-emit 'enemy (lambda (c) c)))"
     :base "group/count is a tag-population read."
     :emergent "Compositions: eng auto-populator, math proportion, cs delta-emit metric."
     :meta "Family: population-driven pipeline.")
    (:eng "Auto-populator keeps the world at target density." :math "Proportion is a ratio of cardinalities." :cs "Delta-emit is monotone counter with change-notify."))
)

(verb :name "group/each" :std "Motoi" :library "group" :tier "core" :kind "state-change" :signature "(group/each tag fn) -> integer"
  :summary "Call fn on each alive entity with a tag, in birth order; return count."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(group/each 'enemy (lambda (id) (entity/set! id 'alert #t)))" :note "Mass config.")
    (:dialect "motoi" :tier "intermediate" :code "(group/each 'enemy (lambda (id) (entity/damage! id 1)))" :note "Damage all tagged.")
    (:dialect "motoi" :tier "expert"       :code "(define (target-tag tag target) (group/each tag (lambda (id) (entity/set! id 'target target))))\n(target-tag 'enemy 'player)" :note "Retarget an entire group."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(group/each 'formation (lambda (id) (entity/set! id 'wave 1)))"
     :math-program "(define (map-across-tag tag f) (group/each tag f))\n(map-across-tag 'enemy (lambda (id) id))"
     :cs-program "(define (safe-each tag fn) (if (and (symbol? tag) (procedure? fn)) (group/each tag fn) (error 'bad-args)))\n(safe-each 'enemy (lambda (id) id))"
     :problem "Configure every entity in a group without allocating an ID list."
     :explanation "eng: mass config. math: map over tag class. cs: type-guarded traversal."
     :meta "Reach for group/each and NOT (for-each ... (group/find tag)): each streams; find + for-each allocates.")
    (:eng "Streaming traversal; no ID list allocation." :math "Map over the tag class." :cs "Iterator pattern with side effects."))
  :row-3-dimension (
    (:setup "Streaming traversal over a tag class."
     :rungs (
       (:domain "engineering"  :code "(group/each 'wave (lambda (id) (config id)))")
       (:domain "mathematics"  :code "(group/each 'x (lambda (id) (transform id)))")
       (:domain "cs / dispatch" :code "(group/each (parse-tag msg) handler)"))
     :explanation "Direct, algebraic, parsed dispatch."
     :meta "Map/iterate over tag class.")
    (:eng "Mass config in one call." :math "Applies f pointwise across class." :cs "Iterator with side-effect closure."))
  :row-4-proof (
    (:eng-program "(define c 0)\n(group/each 'enemy (lambda (id) (set! c (+ c 1))))\n(= c (group/count 'enemy))"
     :math-program "(define (count-matches-cardinality? tag) (define c 0) (group/each tag (lambda (id) (set! c (+ c 1)))) (= c (group/count tag)))\n(count-matches-cardinality? 'enemy)"
     :cs-program "(define (returns-count?) (integer? (group/each 'enemy (lambda (id) id))))\n(returns-count?)"
     :claim "Returned integer equals group/count(tag); traversal is exhaustive."
     :invariant "∀ tag fn. group/each(tag, fn) = group/count(tag) ∧ fn called once per alive entity"
     :meta "Pattern: exhaustive traversal with witness.")
    (:eng "Return value confirms traversal was complete." :math "Cardinality = call count." :cs "Iterator pattern with completion witness."))
  :row-5-emergence (
    (:eng-composition "(define (retarget-wave tag target) (group/each tag (lambda (id) (entity/set! id 'target target))))\n(retarget-wave 'enemy 'player)"
     :math-composition "(define (accumulate tag f init) (let ((acc init)) (group/each tag (lambda (id) (set! acc (f acc id)))) acc))\n(accumulate 'enemy + 0)"
     :cs-composition "(define (broadcast tag msg send) (group/each tag (lambda (id) (send id msg))))\n(broadcast 'unit 'move (lambda (id m) 'sent))"
     :base "group/each streams a callback over a tag class."
     :emergent "Compositions: eng mass retarget, math fold-accumulator, cs broadcast."
     :meta "Family: streaming traversal.")
    (:eng "Retarget-wave: one call configures a whole wave." :math "Fold over the tag class." :cs "Publish-many pattern with per-entity dispatch."))
)

(verb :name "group/find" :std "Motoi" :library "group" :tier "core" :kind "pure" :signature "(group/find tag) -> list"
  :summary "List all alive entity IDs with a tag, in birth order."
  :examples (
    (:dialect "motoi" :tier "novice"       :code "(group/find 'enemy)" :note "List of entity IDs.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((first (car (group/find 'enemy)))) first)" :note "Get first tagged.")
    (:dialect "motoi" :tier "expert"       :code "(define (nearest tag pos) (let ((ids (group/find tag))) (car (sort ids (lambda (a b) (< (dist a pos) (dist b pos)))))))\n(nearest 'enemy (list 0 0))" :note "Find nearest tagged entity."))
  :provenance "Motoi core; 15-program standard filled 2026-07-22"
  :row-2-audit (
    (:eng-program "(let ((ids (group/find 'enemy))) (if (null? ids) 'none (car ids)))"
     :math-program "(define (tag-set tag) (group/find tag))\n(tag-set 'enemy)"
     :cs-program "(define (safe-find tag) (if (symbol? tag) (group/find tag) (error 'need-symbol)))\n(safe-find 'enemy)"
     :problem "Need the concrete ID list — for sorting, filtering, or picking a specific member."
     :explanation "eng: pick first or handle none. math: enumerate tag set. cs: type-guarded find."
     :meta "Reach for group/find and NOT group/each: each streams but yields no list; find gives you the list to compute over.")
    (:eng "List materializes; caller pays for allocation." :math "Enumeration of tag class." :cs "SELECT id FROM entities WHERE tag = ?."))
  :row-3-dimension (
    (:setup "Enumerate members of a tag class."
     :rungs (
       (:domain "engineering"  :code "(group/find 'enemy)")
       (:domain "mathematics"  :code "{e : tag(e) = 'enemy}")
       (:domain "cs / dispatch" :code "(group/find (parse-tag msg))"))
     :explanation "Direct enumeration, algebraic set, parsed dispatch."
     :meta "List-materialization of tag class.")
    (:eng "Caller pays allocation for computability." :math "Set of entities in class." :cs "SELECT id WHERE tag = ?."))
  :row-4-proof (
    (:eng-program "(= (length (group/find 'enemy)) (group/count 'enemy))"
     :math-program "(define (cardinality-match? tag) (= (length (group/find tag)) (group/count tag)))\n(cardinality-match? 'enemy)"
     :cs-program "(define (returns-list?) (list? (group/find 'enemy)))\n(returns-list?)"
     :claim "|group/find(tag)| = group/count(tag) ; return is a list of alive entity IDs."
     :invariant "∀ tag. length(group/find(tag)) = group/count(tag) ∧ each ∈ list is alive ∧ has tag"
     :meta "Pattern: enumeration matches cardinality.")
    (:eng "Count and find agree — invariant is auditable." :math "Enumeration and cardinality coincide on finite sets." :cs "Same result-set count as COUNT(*)."))
  :row-5-emergence (
    (:eng-composition "(define (nearest tag pos) (let ((ids (group/find tag))) (if (null? ids) #f (car (sort ids (lambda (a b) (< (dist a pos) (dist b pos))))))))\n(nearest 'enemy (list 0 0))"
     :math-composition "(define (filter-tag tag pred) (filter pred (group/find tag)))\n(filter-tag 'enemy (lambda (id) (< id 100)))"
     :cs-composition "(define (top-k tag k score) (take (sort (group/find tag) (lambda (a b) (> (score a) (score b)))) k))\n(top-k 'enemy 3 (lambda (id) id))"
     :base "group/find enumerates the tag class."
     :emergent "Compositions: eng nearest-search, math filter-by-predicate, cs top-k selection."
     :meta "Family: enumerate-then-compute.")
    (:eng "Nearest-search chains find + sort + car." :math "Filter is a set restriction." :cs "Same pattern as SELECT + WHERE + ORDER + LIMIT."))
)
