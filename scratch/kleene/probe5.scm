(display (list (char-upcase #\a) (char->integer #\a) (integer->char 98) (char-whitespace? #\space)))(newline)
(display (list (string #\a #\b) (list->string (list #\a #\b)) (string->list "ab")))(newline)
(display (fold + 0 (list 1 2 3)))(newline)
(display (fold-right cons (list) (list 1 2 3)))(newline)
(display (list (string-length "abc") (substring "abcdef" 1 3) (string-append "a" "b")))(newline)
