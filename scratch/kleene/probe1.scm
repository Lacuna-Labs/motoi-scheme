(display (list 'null-empty (string-null? "") 'null-a (string-null? "a"))) (newline)
(display (list 'prefix (string-prefix? "he" "hello") (string-prefix? "lo" "hello") (string-prefix? "" "hello") (string-prefix? "hello" "he"))) (newline)
(display (list 'suffix (string-suffix? "lo" "hello") (string-suffix? "he" "hello") (string-suffix? "" "hello"))) (newline)
(display (string-concatenate (list "ab" "cd" "ef"))) (newline)
(display (string-concatenate (list))) (newline)
(display (string-tokenize "a  b c")) (newline)
(display (string-tokenize "")) (newline)
(display (string-fold cons (list) "abc")) (newline)
(display (string-fold-right cons (list) "abc")) (newline)
(display (string-any char-numeric? "ab3c")) (newline)
(display (string-any char-numeric? "abc")) (newline)
(display (string-every char-alphabetic? "abc")) (newline)
(display (string-every char-alphabetic? "")) (newline)
(display (string-index-right "hello" #\l)) (newline)
(display (string-skip "aaab" #\a)) (newline)
