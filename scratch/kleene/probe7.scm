(display (list (cadr (list 1 2 3)) (caar (list (list 1)))))(newline)
(display (string-ref "abc" 1))(newline)
(display (assoc "b" (list (list "a" 1) (list "b" 2))))(newline)
(display (list (null? (list)) (char-numeric? #\3) (char-alphabetic? #\a) (char-upcase #\a)))(newline)
(display (list (string-trim "  x ") (number->string 255 16)))(newline)
(display (list (string-downcase "AB") (string-upcase "ab")))(newline)
(display (list (boolean? #f) (not #f) (eq? 'a 'a)))(newline)
(display (list (char->integer #\0) (- (char->integer #\7) (char->integer #\0))))(newline)
(display (list (expt 10 2) (floor 2.5) (truncate 2.9) (exact 2.0)))(newline)
(display (last (list 1 2 3)))(newline)
(display (list (string-index "hello" #\l) (string-contains "hello" "ll")))(newline)
