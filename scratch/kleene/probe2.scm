(display (string-any (lambda (c) (if (char-numeric? c) (list 'found c) #f)) "ab3c")) (newline)
(display (string-every (lambda (c) (if (char-alphabetic? c) (char-upcase c) #f)) "abc")) (newline)
(write (string-fold cons (list) "abc")) (newline)
(display (string-fold (lambda (c n) (+ n 1)) 0 "hello")) (newline)
(display (string-fold-right (lambda (c acc) (string-append acc (string c))) "" "abc")) (newline)
(display (list 'win (string-fold (lambda (c a) (cons c a)) (list) "abcdef" 1 4))) (newline)
(display (list 'win-r (string-fold-right cons (list) "abcdef" 1 4))) (newline)
(display (list 'any-win (string-any char-numeric? "a1b2" 2 4))) (newline)
(display (list 'idxr-win (string-index-right "hello" #\l 0 3))) (newline)
(display (list 'skip-win (string-skip "aaab" #\a 0 2))) (newline)
(display (list 'tok-win (string-tokenize "ab cd ef" #f 3 8))) (newline)
