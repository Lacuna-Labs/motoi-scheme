
(verb
  :name "math/sin" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/sin x) -> number"
  :arity "1"
  :contract "x in radians → real in [-1, 1]"
  :summary "Sine of x, where x is in radians."
  :doc "Delegates to Math.sin. The argument is an angle in RADIANS, not degrees — multiply degrees by (/ math/pi 180) first. The result is always in [-1, 1]. Periodic with period 2π. For the inverse, use math/asin."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/sin 0)" :note "Returns 0 — sin(0) = 0.")
    (:dialect "motoi" :tier "intermediate" :code "(math/sin (/ math/pi 2))" :note "Returns 1 — sin(π/2) = 1. Note the argument is in radians.")
    (:dialect "motoi" :tier "expert" :code "(define (deg->rad d) (* d (/ math/pi 180)))\n(display (math/sin (deg->rad 30)))" :note "sin(30°) ≈ 0.5 — convert degrees to radians first.")
  )
  :related ("math/cos" "math/tan" "math/asin" "math/atan2" "math/pi")
  :row-2-audit (
    (:problem "The operator needs the vertical component of a force applied at an angle θ (radians)." :program "(define (vertical mag theta) (* mag (math/sin theta)))\n(vertical 10 (/ math/pi 6))" :explanation "Vertical component is magnitude times sin of the angle." :meta "math/sin is correct for the OPPOSITE-over-hypotenuse component. math/cos gives the adjacent (horizontal) component — do not confuse them."
     :eng-program "(define (wave t amp freq) (* amp (math/sin (* 2 math/pi freq t))))\n(wave 0.25 1 1)"
     :math-program "(define (unit-y theta) (math/sin theta))\n(unit-y (/ math/pi 2))")
    (:eng "Log the stated angle units; the most common trig fault is feeding degrees where radians are expected." :math "The audit lens fixes math/sin as a unary periodic function with range [-1,1]; gate on the radians precondition." :cs "Row 2 emphasizes a single pure call; sin may be replaced by its cached value for a fixed argument.")
)
  :row-3-dimension (
    (:setup "Same shape: the opposite-over-hypotenuse projection of an angle."
     :rungs (
       (:domain "math/*" :code "(math/sin (/ math/pi 2))")
       (:domain "signal processing (a periodic oscillation)" :code "(define (osc t) (math/sin (* 2 math/pi t)))\n(osc 0.25)")
       (:domain "geometry — the y-coordinate on the unit circle" :code "(define (unit-y theta) (math/sin theta))\n(unit-y 0)"))
     :explanation "Each rung reads the vertical projection of an angle onto the unit circle."
     :meta "The shape transfers because sine is THE canonical periodic projection.")
    (:eng "Portable mental model: sine is always 'height on the circle', across every substrate." :math "Cross-domain sharing is the universal property of the circle group acting on the plane." :cs "The shared shape becomes a reusable oscillator primitive across implementations."))
  :row-4-proof (
    (:claim "sin²(x) + cos²(x) = 1 for all x." :program "(< (abs (- (+ (math/square (math/sin 1.2)) (math/square (math/cos 1.2))) 1)) 1e-9)" :invariant "∀ x. sin²x + cos²x = 1" :meta "The Pythagorean identity. If broken, precision drift or a unit bug. See book-of-math ch 11."
     :math-program "(< (abs (- (math/sin (- math/pi 0.3)) (math/sin 0.3))) 1e-9)"
     :cs-program "(and (<= (math/sin 5) 1) (>= (math/sin 5) -1))")
    (:eng "A runtime failure of the Pythagorean identity is a fault line — the pure algebra must hold." :math "The identity is the defining relation between sine and cosine on the unit circle." :cs "Make the identity a CI property test to catch a regressed trig implementation.")
)
  :row-5-emergence (
    (:base "Chain sin with an amplitude and frequency for a wave." :composition "(define (wave t amp freq) (* amp (math/sin (* 2 math/pi freq t))))\n(wave 0.1 2 3)" :emergent "amplitude × sin(2πft) = a sinusoid." :meta "Belongs to the family of oscillator patterns. See book-of-composition ch 14."
     :math-composition "(define (unit-circle theta) (list (math/cos theta) (math/sin theta)))\n(unit-circle (/ math/pi 4))"
     :cs-composition "(define (samples n) (map (lambda (i) (math/sin (* 2 math/pi (/ i n)))) (iota n)))\n(samples 4)")
    (:eng "The oscillator pattern inherits known DSP discipline (windowing, aliasing awareness)." :math "cos + sin compose into a point on the circle; the emergent structure is the circle group." :cs "The named emergent (oscillator / sampler) is a reusable signal primitive.")
)
)

(verb
  :name "math/cos" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/cos x) -> number"
  :arity "1"
  :contract "x in radians → real in [-1, 1]"
  :summary "Cosine of x, where x is in radians."
  :doc "Delegates to Math.cos. The argument is an angle in RADIANS, not degrees. The result is always in [-1, 1]. Cosine is sine shifted by π/2: cos(x) = sin(x + π/2). For the inverse, use math/acos."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/cos 0)" :note "Returns 1 — cos(0) = 1.")
    (:dialect "motoi" :tier "intermediate" :code "(math/cos math/pi)" :note "Returns -1 — cos(π) = -1.")
    (:dialect "motoi" :tier "expert" :code "(define (horizontal mag theta) (* mag (math/cos theta)))\n(display (horizontal 10 (/ math/pi 3)))" :note "Horizontal component of a force at π/3 radians ≈ 5.")
  )
  :related ("math/sin" "math/tan" "math/acos" "math/atan2" "math/pi")
  :row-2-audit (
    (:problem "The operator needs the horizontal component of a vector at angle θ (radians)." :program "(define (horizontal mag theta) (* mag (math/cos theta)))\n(horizontal 10 (/ math/pi 3))" :explanation "Horizontal component is magnitude times cosine of the angle." :meta "math/cos gives the ADJACENT-over-hypotenuse component. math/sin gives the vertical — do not swap them."
     :eng-program "(define (power vrms irms phi) (* vrms irms (math/cos phi)))\n(power 120 2 0.2)"
     :math-program "(define (unit-x theta) (math/cos theta))\n(unit-x 0)")
    (:eng "Log the angle units; degrees-for-radians is the classic trig fault." :math "The audit lens fixes math/cos as a unary periodic function, range [-1,1]; gate on radians." :cs "A single pure call; cos may be replaced by its cached value for a fixed argument.")
)
  :row-3-dimension (
    (:setup "Same shape: the adjacent-over-hypotenuse projection of an angle."
     :rungs (
       (:domain "math/*" :code "(math/cos math/pi)")
       (:domain "electrical engineering (the power factor)" :code "(define (power-factor phi) (math/cos phi))\n(power-factor 0.2)")
       (:domain "geometry — the x-coordinate on the unit circle" :code "(define (unit-x theta) (math/cos theta))\n(unit-x 0)"))
     :explanation "Each rung reads the horizontal projection of an angle onto the unit circle."
     :meta "The shape transfers because cosine is the canonical horizontal projection.")
    (:eng "Portable model: cosine is 'width on the circle' everywhere." :math "The universal property of the circle group's action on the plane." :cs "A reusable projection primitive across implementations."))
  :row-4-proof (
    (:claim "cos(-x) = cos(x) — cosine is even." :program "(< (abs (- (math/cos -1.3) (math/cos 1.3))) 1e-9)" :invariant "∀ x. cos(-x) = cos(x)" :meta "Cosine is an even function. If broken, a sign bug. See book-of-math ch 11."
     :math-program "(< (abs (- (+ (math/square (math/sin 0.7)) (math/square (math/cos 0.7))) 1)) 1e-9)"
     :cs-program "(and (<= (math/cos 5) 1) (>= (math/cos 5) -1))")
    (:eng "A runtime failure of evenness is a fault line — the algebra must hold." :math "Evenness is a defining symmetry of cosine about the y-axis." :cs "Make evenness and the Pythagorean identity CI property tests.")
)
  :row-5-emergence (
    (:base "Pair cos with sin to place a point on the unit circle." :composition "(define (on-circle theta r) (list (* r (math/cos theta)) (* r (math/sin theta))))\n(on-circle (/ math/pi 6) 2)" :emergent "r·cos, r·sin = polar-to-cartesian." :meta "Belongs to the family of coordinate-conversion patterns. See book-of-composition ch 12."
     :math-composition "(define (rotate x y theta) (list (- (* x (math/cos theta)) (* y (math/sin theta))) (+ (* x (math/sin theta)) (* y (math/cos theta)))))\n(rotate 1 0 (/ math/pi 2))"
     :cs-composition "(define (ring n r) (map (lambda (i) (let ((a (* 2 math/pi (/ i n)))) (list (* r (math/cos a)) (* r (math/sin a))))) (iota n)))\n(ring 4 1)")
    (:eng "The polar-to-cartesian pattern inherits geometry-pipeline discipline." :math "cos + sin compose into rotations; the emergent structure is SO(2)." :cs "The named emergent (rotation / coordinate transform) is a reusable geometry primitive.")
)
)

(verb
  :name "math/tan" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/tan x) -> number"
  :arity "1"
  :contract "x in radians → real; unbounded near odd multiples of π/2"
  :summary "Tangent of x, where x is in radians."
  :doc "Delegates to Math.tan. The argument is in RADIANS. tan(x) = sin(x)/cos(x), so it is UNBOUNDED and blows up near odd multiples of π/2 (where cos → 0) — expect very large magnitudes, not an error, near those points. For the inverse, use math/atan or math/atan2."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/tan 0)" :note "Returns 0 — tan(0) = 0.")
    (:dialect "motoi" :tier "intermediate" :code "(math/tan (/ math/pi 4))" :note "Returns ≈ 1 — tan(π/4) = 1.")
    (:dialect "motoi" :tier "expert" :code "(define (slope-from-angle theta) (math/tan theta))\n(display (slope-from-angle (/ math/pi 3)))" :note "tan(60°) ≈ 1.732 — the slope of a line at that angle.")
  )
  :related ("math/sin" "math/cos" "math/atan" "math/atan2")
  :row-2-audit (
    (:problem "The operator needs the slope (rise/run) of a line inclined at angle θ (radians)." :program "(define (slope theta) (math/tan theta))\n(slope (/ math/pi 4))" :explanation "Slope equals the tangent of the inclination angle." :meta "math/tan is correct for slope-from-angle. Beware θ near π/2 where the slope is unbounded; guard the input if it can approach vertical."
     :eng-program "(define (rise run theta) (* run (math/tan theta)))\n(rise 10 (/ math/pi 6))"
     :math-program "(define (tan-def theta) (/ (math/sin theta) (math/cos theta)))\n(tan-def (/ math/pi 4))")
    (:eng "Log the angle and guard near π/2; the failure mode is a huge value, not an exception." :math "The audit lens fixes math/tan as a unary function with poles at odd multiples of π/2." :cs "A single pure call, but not total in the practical sense near the poles — document the guard.")
)
  :row-3-dimension (
    (:setup "Same shape: the ratio of opposite to adjacent (rise over run)."
     :rungs (
       (:domain "math/*" :code "(math/tan (/ math/pi 4))")
       (:domain "surveying (a grade/slope)" :code "(define (grade theta) (math/tan theta))\n(grade (/ math/pi 12))")
       (:domain "geometry — sin over cos" :code "(define (tan-def theta) (/ (math/sin theta) (math/cos theta)))\n(tan-def 0)"))
     :explanation "Each rung reads a slope as the opposite/adjacent ratio."
     :meta "The shape transfers because tangent IS the slope of the angle.")
    (:eng "Portable model: tangent is 'slope from angle' everywhere." :math "The ratio sin/cos on the unit circle." :cs "A reusable slope primitive across implementations."))
  :row-4-proof (
    (:claim "tan(x) = sin(x)/cos(x) away from the poles." :program "(< (abs (- (math/tan 0.6) (/ (math/sin 0.6) (math/cos 0.6)))) 1e-9)" :invariant "∀ x with cos(x) ≠ 0. tan x = sin x / cos x" :meta "The defining ratio. If broken, an implementation bug. See book-of-math ch 11."
     :math-program "(< (abs (- (math/tan (- 0.5)) (- (math/tan 0.5)))) 1e-9)"
     :cs-program "(< (abs (- (math/tan (/ math/pi 4)) 1)) 1e-9)")
    (:eng "A failure of the sin/cos identity is a fault line away from the poles." :math "The ratio identity is the definition of tangent." :cs "Property-test the identity on inputs bounded away from π/2.")
)
  :row-5-emergence (
    (:base "Use tan to turn an angle into a slope for a line." :composition "(define (line-at theta) (lambda (x) (* x (math/tan theta))))\n((line-at (/ math/pi 4)) 5)" :emergent "closure over tan(θ) = a line through the origin at that angle." :meta "Belongs to the family of parametric-line patterns. See book-of-composition ch 12."
     :math-composition "(define (project dist theta) (list (* dist (math/cos theta)) (* dist (math/sin theta))))\n(project 10 (math/atan 1))"
     :cs-composition "(define (slopes angles) (map math/tan angles))\n(slopes (list 0 (/ math/pi 6) (/ math/pi 4)))")
    (:eng "The parametric-line pattern inherits geometry-pipeline discipline." :math "tan composes with atan into the identity away from poles; the emergent structure is a chart of the circle." :cs "The named emergent (line factory / slope map) is a reusable geometry primitive.")
)
)

(verb
  :name "math/asin" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/asin x) -> number"
  :arity "1"
  :contract "x in [-1, 1] → radians in [-π/2, π/2]; |x| > 1 → NaN"
  :summary "Arcsine (inverse sine) of x; returns an angle in radians."
  :doc "Delegates to Math.asin. The argument MUST be in [-1, 1] — outside that range the result is NaN (not an error), because sine never exceeds 1 in magnitude. The result is the principal angle in [-π/2, π/2], in radians. Inverse of math/sin on that principal branch."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/asin 0)" :note "Returns 0 — asin(0) = 0.")
    (:dialect "motoi" :tier "intermediate" :code "(math/asin 1)" :note "Returns ≈ 1.5708 (π/2) — the largest principal arcsine.")
    (:dialect "motoi" :tier "expert" :code "(define (angle-from-ratio opp hyp) (math/asin (/ opp hyp)))\n(display (angle-from-ratio 1 2))" :note "asin(0.5) ≈ 0.5236 (π/6) — recover an angle from an opposite/hypotenuse ratio.")
  )
  :related ("math/sin" "math/acos" "math/atan" "math/atan2")
  :row-2-audit (
    (:problem "The operator has an opposite/hypotenuse ratio and needs the angle (radians)." :program "(define (angle opp hyp) (math/asin (/ opp hyp)))\n(angle 1 2)" :explanation "Arcsine inverts the opposite-over-hypotenuse ratio into an angle." :meta "math/asin is correct when you have the SINE ratio. If you have opposite AND adjacent, prefer math/atan2 — it covers all four quadrants; asin only spans [-π/2, π/2]."
     :eng-program "(define (incline rise hyp) (math/asin (/ rise hyp)))\n(incline 3 5)"
     :math-program "(< (abs (- (math/sin (math/asin 0.4)) 0.4)) 1e-9)")
    (:eng "Guard the domain: a ratio > 1 (e.g. from a measurement error) yields NaN, not an exception." :math "The audit lens fixes math/asin as the principal inverse of sine, domain [-1,1]." :cs "A single pure call; the NaN-on-out-of-domain contract must be stated so callers check.")
)
  :row-3-dimension (
    (:setup "Same shape: recover an angle from a bounded sine ratio."
     :rungs (
       (:domain "math/*" :code "(math/asin 0.5)")
       (:domain "navigation (a bearing from a sine)" :code "(define (elevation ratio) (math/asin ratio))\n(elevation 0.5)")
       (:domain "geometry — inverse of sin on [-π/2, π/2]" :code "(< (abs (- (math/asin (math/sin 0.3)) 0.3)) 1e-9)"))
     :explanation "Each rung inverts a bounded sine ratio back into a principal angle."
     :meta "The shape transfers because arcsine is the principal inverse of sine.")
    (:eng "Portable model: asin is 'angle from a sine ratio', within the principal branch." :math "The principal-branch inverse of the sine restriction." :cs "A reusable angle-recovery primitive."))
  :row-4-proof (
    (:claim "sin(asin(x)) = x for x in [-1, 1]." :program "(< (abs (- (math/sin (math/asin 0.6)) 0.6)) 1e-9)" :invariant "∀ x ∈ [-1,1]. sin(asin x) = x" :meta "Right inverse of sine on the domain. If broken, a branch or precision bug. See book-of-math ch 11."
     :math-program "(< (abs (- (math/asin 1) (/ math/pi 2))) 1e-9)"
     :cs-program "(and (<= (math/asin 1) (/ math/pi 2)) (>= (math/asin -1) (- (/ math/pi 2))))")
    (:eng "A failure of sin(asin x)=x is a fault line on the valid domain." :math "The right-inverse identity defines the principal branch." :cs "Property-test on random x in [-1,1]; also assert NaN for |x|>1.")
)
  :row-5-emergence (
    (:base "Use asin to recover an incline angle, then feed it forward." :composition "(define (incline-and-run rise hyp) (let ((theta (math/asin (/ rise hyp)))) (list theta (math/cos theta))))\n(incline-and-run 3 5)" :emergent "asin then cos = recover the angle, then its adjacent component." :meta "Belongs to the family of recover-then-reproject patterns. See book-of-composition ch 12."
     :math-composition "(define (both-angles ratio) (list (math/asin ratio) (math/acos ratio)))\n(both-angles 0.5)"
     :cs-composition "(define (angles ratios) (map math/asin ratios))\n(angles (list 0 0.5 1))")
    (:eng "The recover-then-reproject pattern inherits geometry-pipeline discipline." :math "asin composes with sin into the identity on [-1,1]; the emergent structure is a chart." :cs "The named emergent (angle recovery map) is a reusable geometry primitive.")
)
)

(verb
  :name "math/acos" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/acos x) -> number"
  :arity "1"
  :contract "x in [-1, 1] → radians in [0, π]; |x| > 1 → NaN"
  :summary "Arccosine (inverse cosine) of x; returns an angle in radians."
  :doc "Delegates to Math.acos. The argument MUST be in [-1, 1] — outside that range the result is NaN. The result is the principal angle in [0, π], in radians. Inverse of math/cos on that principal branch. Commonly used to recover the angle between two vectors from their normalized dot product."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/acos 1)" :note "Returns 0 — acos(1) = 0.")
    (:dialect "motoi" :tier "intermediate" :code "(math/acos 0)" :note "Returns ≈ 1.5708 (π/2).")
    (:dialect "motoi" :tier "expert" :code "(define (angle-between dot) (math/acos dot))\n(display (angle-between 0.5))" :note "For unit vectors, acos of their dot product ≈ 1.0472 (π/3) is the angle between them.")
  )
  :related ("math/cos" "math/asin" "math/atan" "math/atan2")
  :row-2-audit (
    (:problem "The operator has the normalized dot product of two unit vectors and needs the angle between them (radians)." :program "(define (angle-between dot) (math/acos dot))\n(angle-between 0.5)" :explanation "Arccosine of the dot product of unit vectors gives the angle between them." :meta "math/acos is correct for the vector-angle from a dot product. Ensure the dot product is CLAMPED to [-1,1] first — floating-point drift can push it just outside and produce NaN."
     :eng-program "(define (bond-angle dot) (math/acos dot))\n(bond-angle -0.333)"
     :math-program "(< (abs (- (math/cos (math/acos 0.4)) 0.4)) 1e-9)")
    (:eng "Clamp the input to [-1,1] before calling; drift-induced NaN is the classic acos fault." :math "The audit lens fixes math/acos as the principal inverse of cosine, domain [-1,1], range [0,π]." :cs "A single pure call; state the NaN-on-out-of-domain contract so callers clamp.")
)
  :row-3-dimension (
    (:setup "Same shape: recover an angle from a bounded cosine ratio."
     :rungs (
       (:domain "math/*" :code "(math/acos 0)")
       (:domain "3D graphics (angle between vectors from a dot product)" :code "(define (vec-angle dot) (math/acos dot))\n(vec-angle 0.5)")
       (:domain "geometry — inverse of cos on [0, π]" :code "(< (abs (- (math/acos (math/cos 1.0)) 1.0)) 1e-9)"))
     :explanation "Each rung inverts a bounded cosine ratio back into a principal angle in [0, π]."
     :meta "The shape transfers because arccosine is the principal inverse of cosine.")
    (:eng "Portable model: acos is 'angle from a cosine / dot product', within [0, π]." :math "The principal-branch inverse of the cosine restriction." :cs "A reusable vector-angle primitive."))
  :row-4-proof (
    (:claim "cos(acos(x)) = x for x in [-1, 1]." :program "(< (abs (- (math/cos (math/acos -0.7)) -0.7)) 1e-9)" :invariant "∀ x ∈ [-1,1]. cos(acos x) = x" :meta "Right inverse of cosine on the domain. If broken, a branch or precision bug. See book-of-math ch 11."
     :math-program "(< (abs (- (+ (math/asin 0.5) (math/acos 0.5)) (/ math/pi 2))) 1e-9)"
     :cs-program "(and (<= (math/acos -1) math/pi) (>= (math/acos 1) 0))")
    (:eng "A failure of cos(acos x)=x is a fault line on the valid domain." :math "The complementary identity asin(x)+acos(x)=π/2 also holds and is worth a check." :cs "Property-test on random x in [-1,1]; also assert NaN for |x|>1.")
)
  :row-5-emergence (
    (:base "Use acos on a clamped dot product for a robust vector angle." :composition "(define (clamp x lo hi) (max lo (min hi x)))\n(define (safe-angle dot) (math/acos (clamp dot -1 1)))\n(safe-angle 1.0000001)" :emergent "clamp then acos = a drift-safe vector-angle." :meta "Belongs to the family of guard-then-compute patterns. See book-of-composition ch 10."
     :math-composition "(define (both ratio) (list (math/acos ratio) (- (/ math/pi 2) (math/asin ratio))))\n(both 0.3)"
     :cs-composition "(define (angles dots) (map (lambda (d) (math/acos (max -1 (min 1 d)))) dots))\n(angles (list -1 0 1))")
    (:eng "The guard-then-compute pattern inherits numerical-robustness discipline." :math "acos composes with cos into the identity on [-1,1]; asin+acos is constant π/2." :cs "The named emergent (clamped angle map) is a reusable numerically-safe primitive.")
)
)

(verb
  :name "math/atan" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/atan x) -> number"
  :arity "1"
  :contract "any real x → radians in (-π/2, π/2)"
  :summary "Arctangent (inverse tangent) of x; returns an angle in radians."
  :doc "Delegates to Math.atan. Accepts ANY real number (no domain restriction) and returns the principal angle in (-π/2, π/2), in radians. Because it takes a single slope value it CANNOT distinguish quadrants — use math/atan2 when you have separate y and x components and need the full (-π, π] range."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/atan 0)" :note "Returns 0 — atan(0) = 0.")
    (:dialect "motoi" :tier "intermediate" :code "(math/atan 1)" :note "Returns ≈ 0.7854 (π/4) — atan(1) = π/4.")
    (:dialect "motoi" :tier "expert" :code "(define (angle-of-slope m) (math/atan m))\n(display (angle-of-slope 1.732))" :note "atan(√3) ≈ 1.0472 (π/3) — recover the inclination angle from a slope.")
  )
  :related ("math/tan" "math/atan2" "math/asin" "math/acos")
  :row-2-audit (
    (:problem "The operator has a slope (rise/run) and needs the inclination angle (radians)." :program "(define (incline slope) (math/atan slope))\n(incline 1)" :explanation "Arctangent of the slope gives the inclination angle." :meta "math/atan is correct for a single slope value. If you have SEPARATE rise and run (and the run may be negative or zero), use math/atan2 — atan alone loses the quadrant and cannot represent vertical."
     :eng-program "(define (pitch rise run) (math/atan (/ rise run)))\n(pitch 3 4)"
     :math-program "(< (abs (- (math/tan (math/atan 2)) 2)) 1e-9)")
    (:eng "If run can be zero or negative, atan silently gives the wrong quadrant — prefer atan2 there." :math "The audit lens fixes math/atan as a total unary function with range (-π/2, π/2)." :cs "A single pure call; note the quadrant limitation in the caveats.")
)
  :row-3-dimension (
    (:setup "Same shape: recover an angle from an unbounded slope value."
     :rungs (
       (:domain "math/*" :code "(math/atan 1)")
       (:domain "civil engineering (a roof pitch from rise/run)" :code "(define (pitch slope) (math/atan slope))\n(pitch 0.5)")
       (:domain "geometry — inverse of tan on (-π/2, π/2)" :code "(< (abs (- (math/atan (math/tan 0.5)) 0.5)) 1e-9)"))
     :explanation "Each rung inverts an unbounded slope back into a principal angle."
     :meta "The shape transfers because arctangent is the principal inverse of tangent.")
    (:eng "Portable model: atan is 'angle from a single slope', within (-π/2, π/2)." :math "The principal-branch inverse of the tangent restriction." :cs "A reusable angle-from-slope primitive."))
  :row-4-proof (
    (:claim "tan(atan(x)) = x for all real x." :program "(< (abs (- (math/tan (math/atan 3.5)) 3.5)) 1e-9)" :invariant "∀ x. tan(atan x) = x" :meta "Right inverse of tangent on the whole real line. If broken, a branch bug. See book-of-math ch 11."
     :math-program "(< (abs (- (math/atan -2) (- (math/atan 2)))) 1e-9)"
     :cs-program "(and (< (math/atan 1e9) (/ math/pi 2)) (> (math/atan -1e9) (- (/ math/pi 2))))")
    (:eng "A failure of tan(atan x)=x is a fault line for all x." :math "atan is an odd function; atan(-x) = -atan(x) is a second checkable identity." :cs "Property-test on random reals, including large magnitudes near the asymptotes.")
)
  :row-5-emergence (
    (:base "Use atan to turn a slope into an angle, then a direction." :composition "(define (heading slope) (let ((a (math/atan slope))) (list a (math/cos a) (math/sin a))))\n(heading 1)" :emergent "atan then cos/sin = slope to a unit direction vector." :meta "Belongs to the family of slope-to-direction patterns. See book-of-composition ch 12."
     :math-composition "(define (approx-pi) (* 4 (math/atan 1)))\n(approx-pi)"
     :cs-composition "(define (angles slopes) (map math/atan slopes))\n(angles (list 0 1 -1 100))")
    (:eng "The slope-to-direction pattern inherits geometry-pipeline discipline." :math "4·atan(1) = π — a classic identity; the emergent structure links tangent to the circle constant." :cs "The named emergent (direction map) is a reusable geometry primitive.")
)
)

(verb
  :name "math/atan2" :std "Motoi"
  :library "math"
  :kind "pure"
  :dialect "motoi"
  :signature "(math/atan2 y x) -> number"
  :arity "2"
  :contract "any real y, x → radians in (-π, π]; note argument order is (y x)"
  :summary "Two-argument arctangent of y/x that respects the quadrant; returns an angle in radians."
  :doc "Delegates to Math.atan2. Takes SEPARATE y and x components — NOTE the order is (math/atan2 y x), y FIRST — and returns the angle of the point (x, y) from the positive x-axis, in (-π, π] radians. Unlike math/atan it uses the signs of BOTH arguments to pick the correct quadrant, and it handles x = 0 (vertical) correctly. This is the verb to convert cartesian coordinates to a polar angle."
  :since "1.0"
  :examples (
    (:dialect "motoi" :tier "novice" :code "(math/atan2 1 1)" :note "Returns ≈ 0.7854 (π/4) — the point (1,1) is at 45°.")
    (:dialect "motoi" :tier "intermediate" :code "(math/atan2 0 -1)" :note "Returns ≈ 3.1416 (π) — the point (-1,0) is at 180°. atan alone could not tell this from 0.")
    (:dialect "motoi" :tier "expert" :code "(define (bearing dx dy) (math/atan2 dy dx))\n(display (bearing -1 -1))" :note "Point (-1,-1) is at ≈ -2.356 rad (-135°) — the full quadrant is preserved, y passed first.")
  )
  :related ("math/atan" "math/sin" "math/cos" "math/hypot")
  :row-2-audit (
    (:problem "The operator has a displacement (dx, dy) and needs the heading angle, correct in all four quadrants (radians)." :program "(define (heading dx dy) (math/atan2 dy dx))\n(heading -1 -1)" :explanation "atan2 with y first returns the quadrant-correct angle of the displacement." :meta "math/atan2 is correct here — math/atan (/ dy dx) would collapse (-1,-1) and (1,1) to the same angle and blow up when dx=0. Remember the (y x) order."
     :eng-program "(define (wind-dir north east) (math/atan2 east north))\n(wind-dir -1 0)"
     :math-program "(< (abs (- (math/atan2 1 1) (/ math/pi 4))) 1e-9)")
    (:eng "The two classic atan2 faults: swapping the (y x) order, and reaching for atan instead — both give wrong headings. Log the component order." :math "The audit lens fixes math/atan2 as a binary function, range (-π, π], quadrant-aware." :cs "A single pure call; the (y, x) argument order is the most error-prone part — state it loudly.")
)
  :row-3-dimension (
    (:setup "Same shape: cartesian (x, y) to a quadrant-correct polar angle."
     :rungs (
       (:domain "math/*" :code "(math/atan2 1 1)")
       (:domain "robotics (a heading from a displacement vector)" :code "(define (heading dx dy) (math/atan2 dy dx))\n(heading 0 1)")
       (:domain "geometry — polar angle of a point, all quadrants" :code "(define (polar-angle x y) (math/atan2 y x))\n(polar-angle -1 0)"))
     :explanation "Each rung reads the polar angle of a point using both signs to pick the quadrant."
     :meta "The shape transfers because atan2 is THE cartesian-to-polar angle.")
    (:eng "Portable model: atan2 is 'the true heading of a vector', across every substrate." :math "The full argument function of a nonzero complex number / plane vector." :cs "A reusable cartesian-to-polar primitive."))
  :row-4-proof (
    (:claim "atan2(sin θ, cos θ) = θ for θ in (-π, π]." :program "(< (abs (- (math/atan2 (math/sin 1.2) (math/cos 1.2)) 1.2)) 1e-9)" :invariant "∀ θ ∈ (-π,π]. atan2(sin θ, cos θ) = θ" :meta "Round-trips a point on the unit circle back to its angle, quadrant intact. If broken, a quadrant or order bug. See book-of-math ch 11."
     :math-program "(< (abs (- (math/atan2 1 1) (/ math/pi 4))) 1e-9)"
     :cs-program "(and (<= (math/atan2 1 -1) math/pi) (> (math/atan2 -1 -1) (- math/pi)))")
    (:eng "A failure of the unit-circle round-trip is a fault line — usually a swapped (y x)." :math "The round-trip identity distinguishes atan2 from atan by preserving the quadrant." :cs "Property-test θ across all four quadrants; assert the (y, x) order in a doc test.")
)
  :row-5-emergence (
    (:base "Pair atan2 with hypot to convert cartesian to full polar coordinates." :composition "(define (to-polar x y) (list (math/hypot x y) (math/atan2 y x)))\n(to-polar 3 4)" :emergent "hypot + atan2 = cartesian-to-polar (r, θ)." :meta "Belongs to the family of coordinate-conversion patterns. See book-of-composition ch 12."
     :math-composition "(define (angle-diff a b) (math/atan2 (math/sin (- a b)) (math/cos (- a b))))\n(angle-diff 3 0.2)"
     :cs-composition "(define (headings points) (map (lambda (p) (math/atan2 (cadr p) (car p))) points))\n(headings (list (list 1 1) (list -1 1) (list -1 -1)))")
    (:eng "The cartesian-to-polar pattern inherits geometry-pipeline discipline; angle-diff via atan2 avoids wraparound bugs." :math "hypot + atan2 compose into the polar chart; the emergent structure is the plane's polar coordinates." :cs "The named emergent (to-polar / normalized angle-difference) is a reusable geometry primitive.")
)
)
