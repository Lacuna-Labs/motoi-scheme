(display "is-subgroup C6 {0,2,4} T: ") (display (alg/is-subgroup? (alg/cyclic 6) '(0 2 4))) (newline)
(display "is-subgroup C6 {0,3} T: ") (display (alg/is-subgroup? (alg/cyclic 6) '(0 3))) (newline)
(display "is-subgroup C6 whole: ") (display (alg/is-subgroup? (alg/cyclic 6) '(0 1 2 3 4 5))) (newline)
(display "derived D3: ") (display (alg/derived-subgroup (alg/dihedral 3))) (newline)
(display "derived C6: ") (display (alg/derived-subgroup (alg/cyclic 6))) (newline)
(display "left-cosets D3 rotsub: ") (display (alg/left-cosets (alg/dihedral 3) '((rot 0) (rot 1) (rot 2)))) (newline)
(display "generators C4: ") (display (alg/generators (alg/cyclic 4))) (newline)
(display "quotient D3 by rots: ") (display (alg/quotient (alg/dihedral 3) '((rot 0) (rot 1) (rot 2)))) (newline)
(display "action orbit on colors: ") (display (alg/action (alg/cyclic 3) 0 (lambda (g x) (modulo (+ x g) 3)))) (newline)
(display "homom is record?: ") (display (pair? (alg/homomorphism (alg/cyclic 4) (alg/cyclic 4) (lambda (x) x)))) (newline)
(display "homom car: ") (display (car (alg/homomorphism (alg/cyclic 4) (alg/cyclic 4) (lambda (x) x)))) (newline)
