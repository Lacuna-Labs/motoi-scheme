;; --- Motion runtime: a tiny world built on real Motoi primitives ---
;; Positions and velocities are vecs (plain (x y) lists, so car/cadr work).
;; Integration is forward Euler on vec/add + vec/scale. Nothing here is
;; special engine magic — it is ordinary Scheme over vec/*, sqrt, sin, cos, atan.
(define PI (* 4 (atan 1)))
(define (dsqrt x) (sqrt x))
(define (dcos x) (cos x))
(define (dsin x) (sin x))
(define (datan2 y x) (atan y x))
(define *world* '())
(define (world/reset!) (set! *world* '()))
(define (world/spawn tag x y)
  (let ((e (vector tag (vec/make x y) (vec/make 0 0))))
    (set! *world* (cons e *world*))
    e))
(define (entity/set-vel! e vx vy) (vector-set! e 2 (vec/make vx vy)))
(define (entity/set-pos! e x y)  (vector-set! e 1 (vec/make x y)))
(define (entity/vel e) (vector-ref e 2))
(define (entity/pos e) (vector-ref e 1))
(define (entity/x e)   (car  (vector-ref e 1)))
(define (entity/y e)   (cadr (vector-ref e 1)))
(define (world/step dt)
  (for-each
   (lambda (e) (vector-set! e 1 (vec/add (vector-ref e 1)
                                         (vec/scale (vector-ref e 2) dt))))
   *world*))
(define (world/count) (length *world*))
(define (entity/distance a b)
  (let ((pa (entity/pos a)) (pb (entity/pos b)))
    (sqrt (+ (expt (- (car pa) (car pb)) 2)
             (expt (- (cadr pa) (cadr pb)) 2)))))
(define (entity/overlaps? a b) (< (entity/distance a b) 0.5))
;; --- end runtime ---
(world/reset!)
(define birds (list (world/spawn 'bird -3 2)
                    (world/spawn 'bird 3 -1)
                    (world/spawn 'bird 0 -3)
                    (world/spawn 'bird -2 -2)
                    (world/spawn 'bird 2 2)))
(for-each (lambda (b) (entity/set-vel! b 1 0.5)) birds)
(let loop ((n 30))
  (when (> n 0)
    (for-each
     (lambda (self)
       (let ((sep-x 0) (sep-y 0)
             (avg-vx 0) (avg-vy 0)
             (avg-x 0) (avg-y 0)
             (count 0))
         (for-each
          (lambda (other)
            (let* ((spos (entity/pos self))
                   (opos (entity/pos other))
                   (dx (- (car spos) (car opos)))
                   (dy (- (cadr spos) (cadr opos)))
                   (dist (dsqrt (+ (* dx dx) (* dy dy)))))
              (when (< dist 2.0)
                (when (> dist 0.01)
                  (set! sep-x (+ sep-x (/ dx dist)))
                  (set! sep-y (+ sep-y (/ dy dist))))
                (let ((ov (entity/vel other)))
                  (set! avg-vx (+ avg-vx (car ov)))
                  (set! avg-vy (+ avg-vy (cadr ov))))
                (set! avg-x (+ avg-x (car opos)))
                (set! avg-y (+ avg-y (cadr opos)))
                (set! count (+ count 1)))))
          birds)
         (when (> count 0)
           (let* ((center-x (/ avg-x count))
                  (center-y (/ avg-y count))
                  (spos (entity/pos self))
                  (coh-x (- center-x (car spos)))
                  (coh-y (- center-y (cadr spos)))
                  (v (entity/vel self))
                  (vx (car v))
                  (vy (cadr v)))
             (entity/set-vel! self 
                              (+ vx (* 0.05 sep-x) (* 0.02 (/ avg-vx count)) (* 0.01 coh-x))
                              (+ vy (* 0.05 sep-y) (* 0.02 (/ avg-vy count)) (* 0.01 coh-y)))))))
     birds)
    (world/step 0.016)
    (loop (- n 1))))
(map entity/pos birds)
