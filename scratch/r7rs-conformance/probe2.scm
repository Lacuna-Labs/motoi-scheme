(define-syntax swap!
  (syntax-rules ()
    ((_ a b) (let ((tmp a)) (set! a b) (set! b tmp)))))
(define x 1) (define y 2)
(swap! x y)
(display (list x y)) (newline)
(display `(1 ,(+ 1 1) ,@(list 3 4))) (newline)
(display (call-with-current-continuation (lambda (k) (+ 1 (k 42))))) (newline)
(display (dynamic-wind (lambda () (display "[")) (lambda () 'mid) (lambda () (display "]")))) (newline)
(display (let-values (((a b) (values 1 2))) (+ a b))) (newline)
(display (string->number "1/2")) (newline)
(display (exact->inexact 1/3)) (newline)
(display (guard (e (#t (list 'caught e))) (raise 'boom))) (newline)
(display (with-exception-handler (lambda (e) 'h) (lambda () 1))) (newline)
(display (do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 3) acc))) (newline)
(display (case 3 ((1 2) 'low) ((3 4) 'mid) (else 'hi))) (newline)
(display (assoc 2 '((1 a) (2 b)))) (newline)
(display (vector-map + #(1 2) #(10 20))) (newline)
(display (string-map char-upcase "abc")) (newline)
(display (apply + 1 2 '(3 4))) (newline)
(display (call-with-values (lambda () (values 1 2)) +)) (newline)
(display (number->string 255 16)) (newline)
(display (exact (floor 3.7))) (newline)
(display (char->integer #\λ)) (newline)
(display (parameterize () 1)) (newline)
