(require 'game/world)
(world/gravity! 0 0)
(define hero (world/spawn 'hero 20 20))
(define (steer)
  (when (input/down? 'right) (entity/accel! hero 1 0))
  (when (input/down? 'left)  (entity/accel! hero -1 0)))
(define (push-right) (entity/accel! hero 4 0))
(push-right)
(world/step)
(display (entity/x hero))
(newline)
