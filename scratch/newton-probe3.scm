(define q (phys/quantity 9.8 '((length . 1) (time . -2))))
(define tag (phys/quantity->tag q))
(display tag) (newline)
(display (cadr (assq ':value tag))) (newline)
(display (cadr (assq ':dimension tag))) (newline)
(display (= (length tag) 2)) (newline)
(define reconstructed (phys/quantity (cadr (assq ':value tag)) (cadr (assq ':dimension tag))))
(display (equal? q reconstructed)) (newline)
(display (phys/quantity->tag (phys/quantity 5.0 '((length . 1))))) (newline)
