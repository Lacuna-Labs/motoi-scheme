(define (try thunk) (call/cc (lambda (k) (with-exception-handler (lambda (e) (k 'RAISED)) thunk))))
(define (p label v) (display label) (display " => ") (display v) (newline))
(display "=== 1 cxr (only cadr/caddr live in src/base.js) ===") (newline)
(p "(cadr '(1))"   (try (lambda () (cadr (list 1)))))
(p "(caddr '(1 2))" (try (lambda () (caddr (list 1 2)))))
(p "(caar '(1 2))  [r7rs-small.js]" (try (lambda () (caar (list 1 2)))))
(p "(cdddr '(1))   [r7rs-small.js]" (try (lambda () (cdddr (list 1)))))
(display "=== 2 take/drop/list-head ===") (newline)
(p "(take '(1 2) 5)"      (try (lambda () (take (list 1 2) 5))))
(p "(drop '(1 2) 5)"      (try (lambda () (drop (list 1 2) 5))))
(p "(list-head '(1 2) 5)" (try (lambda () (list-head (list 1 2) 5))))
(p "(take 5 1)"           (try (lambda () (take 5 1))))
(p "(take '(1 2 3) 2) ok" (take (list 1 2 3) 2))
(p "(drop '(1 2 3) 2) ok" (drop (list 1 2 3) 2))
(p "(take '(1 2) 2) ok"   (take (list 1 2) 2))
(display "=== 3 first/last/nth ===") (newline)
(p "(first '())"        (try (lambda () (first (list)))))
(p "(last '())"         (try (lambda () (last (list)))))
(p "(nth '(1 2) 9)"     (try (lambda () (nth (list 1 2) 9))))
(p "(first \"abc\")"    (try (lambda () (first "abc"))))
(p "(first '(7 8)) ok"  (first (list 7 8)))
(p "(last '(7 8)) ok"   (last (list 7 8)))
(p "(nth '(7 8) 1) ok"  (nth (list 7 8) 1))
(display "=== 4 list-set!  [r7rs-small.js] ===") (newline)
(p "(list-set! '(1) 5 'x)" (try (lambda () (list-set! (list 1) 5 'x))))
(display "=== 5 zip ===") (newline)
(p "(zip '(1 2) '(3 4) '(5 6))" (zip (list 1 2) (list 3 4) (list 5 6)))
(p "(zip '(1 2) '(3 4)) ok"     (zip (list 1 2) (list 3 4)))
(display "=== 6 range ===") (newline)
(p "(range 0 5 2)"   (range 0 5 2))
(p "(range 0 5) ok"  (range 0 5))
(p "(range 5 0 -1)"  (range 5 0 -1))
(p "(range 0 5 0)"   (try (lambda () (range 0 5 0))))
(display "=== 7 assv/memv  [r7rs-small.js] ===") (newline)
(p "(assv 1/2 '((1/2 half)))" (assv 1/2 (list (list 1/2 'half))))
(p "(memv 1/2 '(1/2))"        (memv 1/2 (list 1/2)))
(display "=== 8 =? ===") (newline)
(p "(=? 1 1 2)"      (=? 1 1 2))
(p "(=? 1 1 1)"      (=? 1 1 1))
(p "(=? '(1 2) '(1 2)) ok" (=? (list 1 2) (list 1 2)))
(p "(=? 1 2) ok"     (=? 1 2))
(display "=== 9 inspect ===") (newline)
(p "(inspect (vector 1 2))" (inspect (vector 1 2)))
(p "(inspect (cons 1 2))"   (inspect (cons 1 2)))
(p "(inspect 1/2)"          (inspect 1/2))
(p "(inspect (list 1 2))"   (inspect (list 1 2)))
