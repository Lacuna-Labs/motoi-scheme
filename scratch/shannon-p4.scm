(define (filter pred xs)
  (let loop ((xs xs) (acc '()))
    (cond ((null? xs) (reverse acc))
          ((pred (car xs)) (loop (cdr xs) (cons (car xs) acc)))
          (else (loop (cdr xs) acc)))))
(define (find-generator G candidates)
  (let ((n (alg/order G)))
    (car (filter (lambda (a) (= (alg/element-order G a) n)) candidates))))
(define G (alg/group-from-table '((e a b c d f g)
                                  (a b c d f g e)
                                  (b c d f g e a)
                                  (c d f g e a b)
                                  (d f g e a b c)
                                  (f g e a b c d)
                                  (g e a b c d f))))
(display (list 'order (alg/order G))) (newline)
(display (map (lambda (x) (alg/element-order G x)) '(e a b c d f g))) (newline)
(display (find-generator G '(a b c d f g))) (newline)
