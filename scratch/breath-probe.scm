(display (sin 1.0)) (newline)
(display (* 3.14159 2)) (newline)
;; breath offset: amplitude * sin(2*pi*rate*t)
(define pi 3.141592653589793)
(define (breath-offset amp rate t) (* amp (sin (* 2 pi rate t))))
(for-each (lambda (t) (display "t=") (display t) (display " y=") (display (breath-offset 2.0 0.3 t)) (newline))
  '(0.0 0.5 1.0 1.5 2.0))
;; a character as an alist of data
(define (make-character name)
  (list (cons 'name name) (cons 'pos (vec/make 0 0 0)) (cons 'pose 'standing)))
(define (char-get c k) (cdr (assq k c)))
(define mira (make-character "mira"))
(display (char-get mira 'name)) (newline)
(display (vec/make 200 180 0)) (newline)
