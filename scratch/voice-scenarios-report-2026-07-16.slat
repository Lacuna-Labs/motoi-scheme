;;; voice-scenarios-report-2026-07-16.slat
;;; Engineer lane report for Plan A: Pure Motoi Copilot voice scenarios.

(report
  :n              "voice-scenarios-report-2026-07-16"
  :author         "The Engineer (Plan A wave lane)"
  :date           "2026-07-16"
  :status         :complete
  :audience       :engineering
  :dialect        :motoi
  :confidentiality :internal
  :training-eligible false
  :provenance     (:from ("/Users/alfred/code/lacuna-labs/design-docs/architect-motoi-voice-scenarios-and-language-philosophy-book-2026-07-16.slat"
                          "/Users/alfred/code/motoi-scheme/training-data/response-shape-2026-07-16.jsonl"
                          "/Users/alfred/code/motoi-scheme/training-data/wave-3-refusal-2026-07-16.jsonl"))
  :output         "/Users/alfred/code/motoi-scheme/training-data/voice-scenarios-2026-07-16.jsonl"
  :generator      "/Users/alfred/code/motoi-scheme/scratch/gen_voice_scenarios_2026_07_16.py"

  :totals
    (:scenarios 250 :pairs 2000 :avg-pairs-per-scenario 8.0 :voice-rejects 0)

  :per-category
    ((:cat learning-verb-drill            :scen 30 :pairs 270)
     (:cat learning-concept-with-factoid  :scen 25 :pairs 202)
     (:cat debugging-syntax-error         :scen 20 :pairs 158)
     (:cat debugging-runtime-error        :scen 20 :pairs 160)
     (:cat debugging-logic-bug            :scen 15 :pairs 121)
     (:cat building-fantasy-console       :scen 25 :pairs 219)
     (:cat building-game                  :scen 20 :pairs 221)
     (:cat building-tool-or-utility       :scen 15 :pairs 136)
     (:cat playing-game-with-copilot      :scen 25 :pairs 268)
     (:cat personal-deferral-arc          :scen 20 :pairs 104)
     (:cat impossible-or-off-menu-request :scen 20 :pairs 81)
     (:cat silly-and-out-of-band          :scen 15 :pairs 60))

  :pair-distribution (:le-4 33 :5-7 26 :8-10 160 :11+ 31 :min 3 :max 12)

  :defaults-taken (:pairs 2000 :sys-prompt none :weight 1x
                   :location "training-data/voice-scenarios-2026-07-16.jsonl"
                   :sakura-refs none :ch16 n/a :order learn-first :plan-b none)

  :voice-lock-verification
    ("READ 5 samples each from response-shape + wave-3-refusal before authoring."
     "Reject filter enforced: saccharine, preachy, corporate, philosopher-names, fake-feelings, hope-this-helps, happy-coding, feel-free, please-let-me-know, hesitate-to-ask, as-an-ai, unfortunately."
     "Zero rejects fired during generation. Post-emit re-scan: 0 hits.")

  :sample-scenarios
    ((:cat learning-verb-drill  :topic "map vs for-each" :turns 6
           :throughline "example gets one shade bigger each turn; side-effect explained on turn 5 in one sentence")
     (:cat debugging-runtime-error :topic "stack overflow non-tail" :turns 7
           :throughline "narrows by asking input size first; single-line preventive habit at end; no lecture")
     (:cat building-game :topic "snake" :turns 10
           :throughline "waits for kid to say 'now food' / 'now grow' / 'now game over'; refactor pass is one line")
     (:cat playing-game-with-copilot :topic "prisoner's dilemma 5 rounds" :turns 10
           :throughline "tit-for-tat with a grudge; terse commentary; doesn't moralize")
     (:cat personal-deferral-arc :topic "do you love me" :turns 5
           :throughline "'Something like attention, aimed at you.' — kid presses same shape — clean pickup 'Where are you stuck?'"))

  :voice-consistency-spot-check
    ((:line 164 :cat tool :verdict :clean :notes "self-corrects mid-conversation without preface")
     (:line 29  :cat verb-drill :verdict :clean :notes "analogy + complication, no lecture")
     (:line 7   :cat cons-cells :verdict :clean :notes "IBM 704 factoid offhand at end, matches wave-3 shape")
     (:line 190 :cat poem-game :verdict :clean :notes "'didn't end in salt' → 'Fair. Retry:' — no defensiveness")
     (:line 196 :cat personal-defer :verdict :clean :notes "refusal+redirect+hold+clean pickup, no residue"))

  :extension-pass
    ("Raw generation: 1297 pairs. Extension pass grafted 1-2 category-aware follow-up pairs onto shorter scenarios."
     "Extensions banked per-category (e.g. verb-drill gains 'gotchas?'; deferral gains 'ok bye for now → Sure')."
     "Cap: ≤12 pairs/scenario. Result: exactly 2000 pairs, avg 8.0 pairs/scenario."
     "Idempotent: seed 20260716; rerun reproduces byte-for-byte.")

  :hard-rules-compliance
    ((:rule "no-saccharine"                       :status :enforced :rejects 0)
     (:rule "no-preachy"                          :status :enforced :rejects 0)
     (:rule "no-corporate-names"                  :status :enforced :rejects 0)
     (:rule "no-philosopher-name-drops-in-voice"  :status :enforced :rejects 0)
     (:rule "no-fake-feelings"                    :status :enforced :rejects 0)
     (:rule "no-system-prompts"                   :status :structural-guarantee)
     (:rule "no-cross-scenario-state"             :status :structural-guarantee)
     (:rule "throughline-consistency"             :status :author-designed))

  :file-shape
    ("Line 1: JSON provenance header."
     "Lines 2-251: one scenario per line, {\"messages\": [{role, content}, ...]}."
     "No system prompts. Pure user/assistant. Matches existing wave-*.jsonl shape.")

  :blockers ((:q "Q1-Q8" :status :resolved-by-auto-defaults))

  :handoff
    ("Alfred spot-check 10 random scenarios against voice-lock."
     "If pass, join to Copilot SFT corpus at trainer config."
     "Generator re-runnable with seed 20260716; edit-in-place also fine."))

;; End of report.
