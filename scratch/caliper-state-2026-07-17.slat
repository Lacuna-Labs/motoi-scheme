((doc caliper-state)
 (:date "2026-07-17")
 (:location "/Users/alfred/code/caliper/")
 (:version "0.3.0")
 (:status "beta")

 (:runtime
  (:node ">= 18.0.0, ESM, TypeScript 5.5")
  (:python "aggregator + parsers for ZAP / WebPageTest / OpenAPI (pyproject.toml)")
  (:test-runner "vitest 2.x")
  (:dependencies "commander, chalk, yaml"))

 (:core-purpose
  "One number 0-1000 for web-build quality. Aggregates 11 categories \
(performance, a11y, security headers, active security, coverage, bundle \
size, type-safety, lint, visual regression, e2e, preset-defined custom) \
into a single score with explicit confidence. Node orchestrates + Python \
aggregates.")

 (:scenario-layer
  (:gate "dev-mode-only (CALIPER_DEV=1 or --mode dev)")
  (:location "src/scenario/")
  (:pieces
   (yaml.ts "YAML DSL parser -> Scenario IR")
   (scheme/interp.ts "Caliper-Scheme interpreter, 15 primitives + (scenario ...) + (define-verb ...)")
   (emit-playwright.ts "IR -> Playwright TypeScript emitter")
   (studio/server.ts "drag-drop web builder"))
  (:primitives-15
   :ACT (goto tap/click type hover scroll-to key)
   :WAIT (wait wait-for)
   :ASSERT (assert screenshot)
   :FLOW (let* if when)
   :READ (get-attr get-text)
   :EXTEND (call-verb))
  (:builtin-verbs
   (tap-then-wait land-on probe-field settle-and-check-clean press-n-times))
  (:step-kinds-total 22
   (goto tap click type hover scroll-to key screenshot
    wait wait-for wait-for-event
    assert assert-no-error assert-text assert-emits assert-visible
    let if when
    get-attr get-text
    call-verb)))

 (:what-it-can-drive
  (:playwright-browser "YES via emit-playwright.ts -> generated .spec.ts")
  (:verb-invocation-runtime "NO — Caliper emits static test plans only; \
does not itself invoke Sakura runtime verbs. call-verb inside .csk \
resolves to a compile-time verb library that returns Step[].")
  (:session-continuity "NO — Playwright session survives within one test, \
but no notion of multi-day/persistent-storage.")
  (:multi-window "NO — one page fixture per test.")
  (:direct-runtime "NO — designed as static-emit -> Playwright."))

 (:invocation-flow
  (:cli
   (caliper scenario emit <path> "compiles .yaml/.csk to .spec.ts")
   (caliper scenario validate <path> "parses + reports errors")
   (caliper studio "drag-drop builder"))
  (:library
   (parseScenarioYAML compileScheme compileSchemeOne
    emitPlaywright builtinVerbs startStudio)))

 (:reporting
  (:score "0-1000 with confidence percent")
  (:artifacts "caliper-reports/caliper-report.{json,md}")
  (:scenario-emit "writes .spec.ts alongside source; adopter runs Playwright")
  (:exit-codes "0 pass, 1 score<600, 2 critical security finding, 3 error"))

 (:gaps-for-product-viability-testing
  ;; The audit-6 lane needs to script a shop-operator flow
  ;; (login -> list shops -> transfer -> save -> sign out -> next-day-return)
  ;; without an LLM. Current gaps:
  (session-lifecycle
   "no session/create + session/destroy primitives; Playwright cookies exist \
but scenario DSL cannot request 'log in as X'.")
  (day-jump
   "no way to simulate time passage between sessions (persistence check).")
  (friction-capture
   "no primitive to log 'this took N clicks / this error message was unclear' \
without failing the test.")
  (verb-existence-probe
   "no primitive to verify a verb the operator wants to call actually \
exists in the runtime — right now missing verb is a runtime crash, not \
a clean audit finding.")
  (cart-content-check
   "no deep-equal check against a saved-cart path.")
  (multi-window
   "no primitive for opening two shops in parallel and comparing state.")
  (empty-state-detection
   "no primitive to flag 'page rendered but has no data'.")))
