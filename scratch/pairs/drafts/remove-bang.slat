;;; DRAFT -- remove!
;;; Edited 2026-08-03 by Priya.
;;; AUTHORED, not model-seeded. The drafting batch
;;; (scratch/pairs/draft_records.py, see draft_run.log) skipped
;;; this verb because an edited draft already existed, so no raw
;;; model output for it survives. Claiming model provenance here
;;; would be provenance nobody can check.
;;; Structure, examples, row programs, caveats and provenance are
;;; authored, not generated.
;;;
;;; Every :note is the literal placeholder PENDING-ENGINE. NOTHING in this
;;; file was run. The notes are filled by a deterministic script once the
;;; cons-cell engine lands. A printed value here would be a value nobody ran.
;;;
;;; Spec basis: ../spec-pack/remove-bang.slatl -- read ../spec-pack/00-SOURCES.md first,
;;; the normative SRFI-1 text is NOT in this repo.

(verb
  :name "remove!"
  :std "SRFI-1"
  :library "higher-order"
  :tier "core"
  :kind "state-change"
  :signature "(remove! pred lst) -> list"
  :summary "The elements of lst NOT satisfying pred, kept by unlinking the ones that do. The argument is destroyed."
  :explanation "remove! is filter! with the predicate read the other way: filter! keeps what passes, remove! drops it. The suite tests them with the same list and the same predicate at list.sld:503-509 and list.sld:484-490, and the two results are complementary. Everything true of filter! structurally is true here -- cells are unlinked, nothing is allocated, the result is eq? to the argument only when the FIRST element survives, which for remove! means only when the first element FAILS the predicate. The bang is a licence to destroy. After the call the cells that made up the argument have been re-used, so the variable you passed in no longer names what it named. Bind the result and read only that. The reason both names exist is the same reason span! and break! both exist: the sentence a caller wants to write is sometimes \"keep the valid ones\" and sometimes \"drop the expired ones\", and making one of those go through a negation is where the polarity bugs come from."
  :examples (
    (:dialect "motoi" :tier "novice"
     :code "(define xs (list 0 7 8 8 43 -4))\n(display (remove! even? xs))\n(newline)"
     :note "PENDING-ENGINE")
    (:dialect "motoi" :tier "intermediate"
     :code ";; complementary to filter!: together they account for every element.\n(define a (list 0 7 8 43))\n(define b (list 0 7 8 43))\n(display (list 'removed (remove! even? a) 'filtered (filter! even? b)))\n(newline)"
     :note "PENDING-ENGINE")
    (:dialect "motoi" :tier "expert"
     :code ";; the head survives only when the first element fails the predicate.\n(define xs (list 2 3 4 5))\n(define left (remove! even? xs))\n(display (list 'left left 'head-was-dropped (not (eq? left xs))))\n(newline)"
     :note "PENDING-ENGINE")
  )
  :caveats ("The argument is destroyed. list.sld:503-509 asserts every cell of the result came from the argument."
             "The result is eq? to the argument only when the first element does NOT satisfy pred. Otherwise the old variable names a dropped cell."
             "Order is preserved among the elements that remain."
             "pred is called on every element; there is no early exit."
             "remove! and filter! are complementary. Calling both on one list is impossible -- the first call destroys the input to the second.")
  :drawbacks ("Having the complementary pair doubles the surface for one behaviour and doubles the chance of reading the wrong polarity."
             "Like filter!, the leftover binding is a fragment rather than a truncation."
             "Wanting both halves is common and this verb cannot supply them; the pure partition can.")
  :usecases ("Purging expired entries from a private cache list in place."
             "Dropping sentinel or padding values out of a freshly-decoded buffer."
             "Any \"delete where\" pass over a list with exactly one owner.")
  :related ("remove"
             "filter!"
             "delete!"
             "partition"
             "delete-duplicates!")
  :learn (:concept "Complementary selection and predicate polarity"
          :prerequisites ("remove" "filter!" "partition" "not")
          :progression "Write the same purge with filter! and with remove! and see which one needed a not. The one that did not is the one to keep.")
  :provenance "SRFI-1 linear-update procedures; conformance evidence scratch/r7rs-conformance/larceny/list.sld:503-509; signature derived from the remove record in scheme/reference/33-higher-order.slat. Drafted 2026-08-03; NOT RUN."
  :status "needs-alfred"
  :row-2-audit (
    (:eng-program "(define xs (list 0 7 8 43))\n(display (remove! even? xs))\n(newline)"
     :math-program "(define a (list 0 7 8 43))\n(define b (list 0 7 8 43))\n(display (equal? (remove even? a) (remove! even? b)))\n(newline)"
     :cs-program "(define xs (list 2 3 4))\n(define left (remove! even? xs))\n(display (not (eq? left xs)))\n(newline)"
     :problem "The operator wants to purge expired entries from a private cache list. Candidates: remove (fresh list, source intact), filter with a negated predicate (same result, one negation), or remove! (no allocation, source destroyed). Choosing remove over filter here is not efficiency, it is that \"drop the expired\" is the sentence, and writing it as \"keep the not-expired\" adds a step where a mistake can live."
     :explanation "eng: the survivors come back and the cache variable is unusable. math: remove! agrees with remove everywhere, and complements filter! on the same input. cs: the head survives only when the first entry is a survivor, so the identity of the result is data-dependent."
     :meta "Polarity is chosen for the reader, not for the machine. Both compile to the same work.")
    (:eng "Write the sentence you mean. A negation at the call site is a defect with a delay fuse."
     :math "remove(p) = filter(not-p); the duality is exact and the naming is for humans."
     :cs "Data-dependent result identity is the shared hazard of the whole filter family.")
  )
  :row-3-dimension (
    (:setup "Dropping the entries that match a test by unlinking them and closing the gap."
     :rungs (
             (:domain "list" :code "(display (remove! even? (list 1 2 3 4)))\n(newline)")
             (:domain "a shelf cleared of expired stock" :code "(define shelf (list 'fresh 'expired 'fresh))\n(display (remove! (lambda (i) (eq? i 'expired)) shelf))\n(newline)")
             (:domain "a guest list with cancellations struck out" :code "(define guests (list 'coming 'cancelled 'coming))\n(display (remove! (lambda (g) (eq? g 'cancelled)) guests))\n(newline)")
     )
     :explanation "In list, matching cells are bypassed. Clearing expired stock off a shelf leaves the remaining items in the same order with the gaps closed. Striking cancellations off a guest list does the same to a roster, and the roster is still a roster. All three share a deletion defined by a property rather than by position."
     :meta "The shape transfers wherever the thing to remove is identified by a test rather than by an index.")
    (:eng "Deleting by property scales; deleting by index breaks as soon as two things are deleted."
     :math "Property-based deletion is the complement of property-based selection, and one traversal answers both."
     :cs "This is why databases express deletion as a predicate over rows and not as a list of positions.")
  )
  :row-4-proof (
    (:eng-program "(define left (remove! even? (list 1 2 3 4)))\n(display (list 'left left 'len (length left)))\n(newline)"
     :math-program "(define (complement? p xs)\n  (and (equal? (append (filter p xs) (remove p xs))\n               (append (filter p xs) (remove p xs)))\n       (= (length xs) (+ (length (filter p xs)) (length (remove p xs))))))\n(display (list (complement? even? (list 1 2 3 4)) (complement? even? (list))))\n(newline)"
     :cs-program "(define xs (list 0 7 8))\n(define cells (pair-fold cons (list) xs))\n(define left (remove! even? xs))\n(display (every (lambda (c) (memq c cells)) (pair-fold cons (list) left)))\n(newline)"
     :claim "remove! returns the elements of lst that do not satisfy pred, in order, in a list built from lst's own cells. It is equal? to (remove pred lst) and complementary to (filter pred lst): the two lengths sum to the length of lst."
     :invariant "forall pred, proper lst. equal?(remove!(pred, lst), remove(pred, lst)) and |filter(pred,lst)| + |remove(pred,lst)| = |lst| and every cell of remove!(pred,lst) is a cell of lst"
     :meta "The pattern is complementary order-preserving selection. What would falsify the claim: lengths that do not sum, a reordering, or an allocated cell. Note the lengths law has to be checked on the PURE verbs -- once remove! has run there is no list left to filter, which is itself the reason partition exists.")
    (:eng "The law you want to check cannot be checked on the destructive verbs. That is a finding, not an inconvenience."
     :math "Complementarity is a conservation law: nothing is created and nothing is lost, only sorted into two piles."
     :cs "partition computes both piles in one pass and is the verb the law is actually testable on.")
  )
  :row-5-emergence (
    (:eng-composition "(define (purge! xs bad) (remove! (lambda (x) (eq? x bad)) xs))\n(display (purge! (list 'a 'b 'a) 'a))\n(newline)"
     :math-composition "(define (split-by p xs) (list (filter p xs) (remove p xs)))\n(display (split-by even? (list 1 2 3 4)))\n(newline)"
     :cs-composition "(define (clean rows) (remove null? rows))\n(display (clean (list (list 1) (list) (list 2))))\n(newline)"
     :base "remove! drops the matching cells and closes the gaps."
     :emergent "eng: a purge by value, which is where delete! comes from -- delete! is remove! with the predicate fixed to an equality against one object. math: the split into both piles again, and again it must use the pure verbs. cs: dropping empty rows is the commonest real use, and it is written pure because rows nearly always came from somewhere else."
     :meta "The family is predicate deletion. What emerges is the ladder from remove! down to delete! -- as the predicate gets more specific the verb gets more convenient, and the hazard stays exactly the same.")
    (:eng "A more convenient verb with the same hazard is a more dangerous verb, because it invites use."
     :math "Fixing a predicate to equality against a constant is specialisation, not a new operation."
     :cs "The commonest real filters run on data with other owners, which is why the pure forms dominate in practice.")
  )
)
