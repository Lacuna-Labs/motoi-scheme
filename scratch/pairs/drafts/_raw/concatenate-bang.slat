     :cs-program "(define (safe-concatenate! lst)\n  (if (pair? lst)\n      (concatenate! lst)\n      (error 'concatenate! \"argument must be a list of lists\")))\n(safe-concatenate! (list (list 'a) (list 'b)))"
     :claim "concatenate! destroys the original list structure and returns a new single-level list formed by relinking the cons cells."
     :invariant "forall lst. |concatenate!(lst)| = (apply append lst) and not (eq? lst (concatenate! lst))"
