     :math-program "(define (cycle-check lst)\n  (and (not (list? lst)) (not (proper-list? lst)) (not (dotted-list? lst)) (circular-list? lst) (not (null-list? lst))))\n(display (cycle-check (circular-list 1 2 3)))\n(newline)"
     :cs-program "(display (list (not (list? (circular-list 1 2 3))) (not (length+ (circular-list 1 2 3)))))\n(newline)"
     :problem "The operator needs to verify that the circular-list is indeed a circular structure and not a proper list, dotted list, or null list."
