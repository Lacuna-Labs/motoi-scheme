;;; DRAFT -- take-while!
;;; Edited 2026-08-03 by Priya.
;;; AUTHORED, not model-seeded. The drafting batch
;;; (scratch/pairs/draft_records.py, see draft_run.log) skipped
;;; this verb because an edited draft already existed, so no raw
;;; model output for it survives. Claiming model provenance here
;;; would be provenance nobody can check.
;;; Structure, examples, row programs, caveats and provenance are
;;; authored, not generated.
;;;
;;; Every :note is the literal placeholder PENDING-ENGINE. NOTHING in this
;;; file was run. The notes are filled by a deterministic script once the
;;; cons-cell engine lands. A printed value here would be a value nobody ran.
;;;
;;; Spec basis: ../spec-pack/take-while-bang.slatl -- read ../spec-pack/00-SOURCES.md first,
;;; the normative SRFI-1 text is NOT in this repo.

(verb
  :name "take-while!"
  :std "SRFI-1"
  :library "list"
  :tier "core"
  :kind "state-change"
  :signature "(take-while! pred lst) -> list"
  :summary "The longest prefix of lst whose elements all satisfy pred, produced by cutting the spine at the first failure. The argument is destroyed."
  :explanation "Where take! is told where to cut, take-while! discovers it: the predicate walks the list and the cut lands at the first element that fails. The suite asserts (eq? r x) and (eq? (cdr r) (cdr x)) at list.sld:518-522, so once again the returned prefix is not a copy, it is the argument with its spine severed. The bang is a licence to destroy. After the call the cells that made up the argument have been re-used, so the variable you passed in no longer names what it named. Bind the result and read only that. There is one case worth naming because it looks like a bug and is not: if the FIRST element fails, the prefix is empty, there is no cell to cut, and the argument comes back untouched. So take-while! sometimes destroys and sometimes does not, decided at run time by data. A caller that reasons \"it has a bang, so my variable is gone\" is right to stop using the variable, but must not assume the variable changed."
  :examples (
    (:dialect "motoi" :tier "novice"
     :code "(define xs (list 2 18 3 10 22 9))\n(display (take-while! even? xs))\n(newline)"
     :note "PENDING-ENGINE")
    (:dialect "motoi" :tier "intermediate"
     :code ";; the cut lands at the first odd element; xs is shortened to match.\n(define xs (list 2 18 3 10 22 9))\n(define evens (take-while! even? xs))\n(display (list 'evens evens 'xs xs 'same (eq? evens xs)))\n(newline)"
     :note "PENDING-ENGINE")
    (:dialect "motoi" :tier "expert"
     :code ";; the empty-prefix case: nothing is cut, so nothing is destroyed.\n(define xs (list 3 4 5))\n(define got (take-while! even? xs))\n(display (list 'got got 'xs-intact xs))\n(newline)"
     :note "PENDING-ENGINE")
  )
  :caveats ("The argument is destroyed when the prefix is non-empty. list.sld:518-522 asserts (eq? r x) and (eq? (cdr r) (cdr x))."
             "When the first element fails the predicate the result is the empty list and the argument is left whole. The destruction is data-dependent."
             "The elements after the cut are not returned. span! is the verb that gives you both sides."
             "pred is called on elements in order and stops at the first failure; do not rely on it being called on the rest.")
  :drawbacks ("Whether the call destroyed anything cannot be known without inspecting the data, which makes the failure mode intermittent rather than reproducible."
             "It is the destructive verb most likely to pass a test suite by accident, because small test lists often fail on the first element."
             "Predicates with side effects interact badly with the early stop: the tail never sees them.")
  :usecases ("Trimming a self-owned buffer at the first sentinel value."
             "Consuming a run of same-shaped records off the front of a stream you assembled."
             "Lexing-style prefix scans where the remainder is discarded rather than parsed.")
  :related ("take-while"
             "drop-while"
             "span!"
             "break!"
             "take!")
  :learn (:concept "Data-dependent destruction"
          :prerequisites ("take-while" "take!" "set-cdr!" "eq?")
          :progression "Learn take-while, then take!, then see how take-while! inherits the danger of one and the run-time indecision of the other.")
  :provenance "SRFI-1 linear-update procedures; conformance evidence scratch/r7rs-conformance/larceny/list.sld:518-522; signature derived from the take-while record in scheme/reference/39-list.slat. Drafted 2026-08-03; NOT RUN."
  :status "needs-alfred"
  :row-2-audit (
    (:eng-program "(define xs (list 2 18 3 10))\n(display (list 'prefix (take-while! even? xs) 'xs xs))\n(newline)"
     :math-program "(define a (list 2 18 3 10))\n(define b (list 2 18 3 10))\n(display (equal? (take-while even? a) (take-while! even? b)))\n(newline)"
     :cs-program "(define xs (list 3 4 5))\n(define got (take-while! even? xs))\n(display (list 'empty-prefix got 'argument-untouched xs))\n(newline)"
     :problem "The operator wants the leading run of matching elements from a list they built. Candidates: take-while (copies the run, source intact), filter (wrong -- it keeps matches from everywhere, not just the front), or take-while! (no allocation, source cut). The decision is the usual ownership one, with a wrinkle: take-while! may not destroy anything at all, so a test that happens to fail on element one will not reveal the hazard."
     :explanation "eng: the run comes back and the source variable is shortened to the same run. math: as a value take-while! agrees with take-while everywhere. cs: on an empty prefix nothing is written, which is why this verb hides its own danger better than take! does."
     :meta "A hazard that fires on some inputs and not others is worse than one that always fires, because the always-fires kind gets caught on day one.")
    (:eng "Intermittent damage is harder to find than constant damage; treat the bang as unconditional even when the write is not."
     :math "Value agreement with take-while is total; effect agreement is conditional on the prefix being non-empty."
     :cs "Test inputs should include a first-element failure and a whole-list match, or the boundary goes unexamined.")
  )
  :row-3-dimension (
    (:setup "Keeping the leading run that satisfies a test, by cutting the sequence where the run ends."
     :rungs (
             (:domain "list" :code "(display (take-while! even? (list 2 4 5 6)))\n(newline)")
             (:domain "a queue served until the first refusal" :code "(define q (list 'ready 'ready 'blocked 'ready))\n(display (take-while! (lambda (s) (eq? s 'ready)) q))\n(newline)")
             (:domain "a numeric series read until it leaves range" :code "(display (take-while! (lambda (n) (< n 100)) (list 3 40 99 100 5)))\n(newline)")
     )
     :explanation "In list, the cut lands at the first failing element. A queue served until the first refusal stops there by policy, not by count, and what follows is a different problem. A series read until it leaves range is the same stop rule applied to numbers. All three share a boundary discovered by the data rather than supplied by the caller."
     :meta "The shape transfers wherever a run ends at a condition rather than at an index.")
    (:eng "A stop rule beats a count when the data decides where the boundary is."
     :math "The prefix is maximal: the element at the cut is the first counterexample, which is what makes the answer unique."
     :cs "Early termination is the reason this cannot be written as filter and then a length.")
  )
  :row-4-proof (
    (:eng-program "(define xs (list 2 18 3))\n(define r (take-while! even? xs))\n(display (list 'r r 'eq-to-arg (eq? r xs)))\n(newline)"
     :math-program "(define (maximal? p xs)\n  (let ((r (take-while p xs)))\n    (and (every p r)\n         (or (= (length r) (length xs))\n             (not (p (list-ref xs (length r))))))))\n(display (list (maximal? even? (list 2 4 5 6)) (maximal? even? (list 1 2)) (maximal? even? (list 2 4))))\n(newline)"
     :cs-program "(define xs (list 1 2 3))\n(define r (take-while! even? xs))\n(display (list 'nothing-destroyed (equal? xs (list 1 2 3)) 'result r))\n(newline)"
     :claim "take-while! returns the maximal prefix of lst all of whose elements satisfy pred. That result is equal? to (take-while pred lst). When the prefix is non-empty it is eq? to lst; when it is empty, lst is unchanged."
     :invariant "forall pred, proper lst. r = take-while!(pred,lst) satisfies every(pred,r) and (|r| = |lst| or not pred(lst[|r|])) and (|r| > 0 implies eq?(r, lst))"
     :meta "The pattern is a maximal prefix under a predicate. What would falsify the claim: a result whose next element also satisfies pred (not maximal), an element in the result failing pred, or a fresh list returned in the non-empty case.")
    (:eng "State both halves of maximality -- all of these pass, and the next one does not -- or the proof admits short answers."
     :math "Maximality is what makes the prefix unique; without it every prefix of a matching run would qualify."
     :cs "The empty-prefix branch needs its own assertion because it is the branch where the effect disappears.")
  )
  :row-5-emergence (
    (:eng-composition "(define (serve-ready! q)\n  (take-while! (lambda (s) (eq? s 'ready)) q))\n(display (serve-ready! (list 'ready 'ready 'blocked)))\n(newline)"
     :math-composition "(define (run-and-rest p xs)\n  (let ((rest (drop-while p xs)))\n    (list (take-while! p xs) rest)))\n(display (run-and-rest even? (list 2 4 5 6)))\n(newline)"
     :cs-composition "(define (chunk-by p xs)\n  (if (null? xs)\n      (list)\n      (let ((run (take-while p xs)))\n        (if (null? run)\n            (cons (list (car xs)) (chunk-by p (cdr xs)))\n            (cons run (chunk-by p (drop xs (length run))))))))\n(display (chunk-by even? (list 2 4 5 6 8)))\n(newline)"
     :base "take-while! keeps the leading run that satisfies a predicate and cuts the list there."
     :emergent "eng: a server that drains work until the first blocked item. math: pairing the run with the remainder requires reading the remainder first, which is the argument span! exists to settle. cs: chunking a list into runs cannot use the destructive verb at all -- every chunk after the first needs a list the destructive version has already eaten."
     :meta "The family is run-segmentation. What emerges is a boundary on where linear update is usable: it serves one-shot consumption, and it cannot serve any algorithm that revisits the source.")
    (:eng "One-shot consumption is the whole domain of these verbs; anything that loops over the source is out."
     :math "Runs partition a sequence, and a partition needs both sides -- which a prefix-only verb cannot supply."
     :cs "Chunking is the standard counterexample: it looks like repeated take-while and cannot be repeated take-while!.")
  )
)
