;;; SPEC-PACK — delete!
;;;
;;; Assembled 2026-08-03 by build_spec_pack.py from IN-REPO sources ONLY.
;;; Standard: SRFI-1   Family: linear-update
;;;
;;; READ THIS FIRST: the normative SRFI-1 document is NOT in this repo.
;;; See 00-SOURCES.md. Everything below is either a verbatim in-repo slice
;;; (with file:line) or a note explicitly labelled DERIVED.


;;; ── 1. CONTRACT (DERIVED from the in-repo evidence in §2-§5) ──

(contract :verb "delete!" :std "SRFI-1"
  :text "Unlinks every element equal to x, under an optional equality predicate given as the THIRD argument. The suite calls (delete! 5 x <) and then requires every cell of the result to be one of x's original cells.")


;;; ── 2. CONFORMANCE SUITE (verbatim) ──
;;; scratch/r7rs-conformance/larceny/list.sld — "Adapted from
;;; srfi-1-test.sps" (list.sld:183). The file carries its own caveat
;;; at list.sld:171-173: "Some of these tests are not portable
;;; because they require the procedures designated as 'linear update'
;;; variants in the spec (eg append!) to side-effect their arguments."
(conformance-suite
    ;; scratch/r7rs-conformance/larceny/list.sld:576-582
         (test-assert (let* ((x     (list 1 48 2 5 37))
                             (cells (pair-fold cons '() x))
                             (r     (delete! 5 x <)))
                        (and (equal? r '(1 2 5))
                             (every (lambda (x) (memq x cells))
                                    (pair-fold cons '() r))
                             #t)))
)

