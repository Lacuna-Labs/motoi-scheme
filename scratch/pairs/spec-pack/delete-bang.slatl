(part-summary
    ;; ABSENT from both spec/srfi-1.slatl and spec/r7rs-small.slatl.
)

;;; ── 4. CURRENT IMPLEMENTATION ──
(implementation
    ;; lib/std/srfi-1.js:57
    'delete!', 'delete-duplicates!', 'concatenate!', 'take!', 'drop-right!',
    ;; lib/std/srfi-1.js:858
    ['delete!', 'delete'], ['delete-duplicates!', 'delete-duplicates'],
    ;; lib/std/srfi-1.js:954
    ['delete!', 'delete'], ['delete-duplicates!', 'delete-duplicates'],
)

