(part-summary
    ;; ABSENT from both spec/srfi-1.slatl and spec/r7rs-small.slatl.
)

;;; ── 4. CURRENT IMPLEMENTATION ──
(implementation
    ;; lib/std/srfi-1.js:58
    'span!', 'break!', 'map!', 'alist-delete!',
    ;; lib/std/srfi-1.js:860
    ['span!', 'span'], ['break!', 'break'], ['map!', 'map'],
    ;; lib/std/srfi-1.js:956
    ['span!', 'span'], ['break!', 'break'], ['map!', 'map'],
)

;;; ── 5. STATUS ──
(status :value "needs-alfred"
  :because "The normative SRFI-1 text for this verb is not in the repo.
