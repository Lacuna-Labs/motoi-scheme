;;; ── 1. CONTRACT (DERIVED from the in-repo evidence in §2-§5) ──

(contract :verb "pair-fold" :std "SRFI-1"
  :text "Like fold, but f is applied to each successive PAIR (cdr-tail) of the list rather than each element. The suite's test is severe: f is (lambda (pair tail) (set-cdr! pair tail) pair), which destroys the list as it walks it. That only terminates if pair-fold has already taken the cdr of each pair BEFORE calling f, and it only produces (3 2 1) if the pairs handed to f are the argument's own cells.")


;;; ── 2. CONFORMANCE SUITE (verbatim) ──
;;; scratch/r7rs-conformance/larceny/list.sld — "Adapted from
;;; srfi-1-test.sps" (list.sld:183). The file carries its own caveat
;;; at list.sld:171-173: "Some of these tests are not portable
;;; because they require the procedures designated as 'linear update'
;;; variants in the spec (eg append!) to side-effect their arguments."
(conformance-suite
    ;; scratch/r7rs-conformance/larceny/list.sld:402-412
                             (r (list x (cdr x) (cddr x)))
                             (y (pair-fold (lambda (pair tail) 
                                             (set-cdr! pair tail) pair) 
                                           '()
                                           x)))
                        (and (equal? y '(3 2 1))
                             (every (lambda (c) (memq c r))
                                    (list y (cdr y) (cddr y)))
                             #t)))
         
         (test (pair-fold-right cons '() '(a b c)) '((a b c) (b c) (c)))
)

