(implementation
    ;; lib/std/srfi-1.js:54
    'append!', 'reverse!', 'append-reverse!', 'filter!', 'remove!', 'partition!',
    ;; lib/std/srfi-1.js:857
    ['filter!', 'filter'], ['remove!', 'remove'], ['partition!', 'partition'],
    ;; lib/std/srfi-1.js:953
    ['filter!', 'filter'], ['remove!', 'remove'], ['partition!', 'partition'],
)

