;;; ── 1. CONTRACT (DERIVED from the in-repo evidence in §2-§5) ──

(contract :verb "list-copy" :std "R7RS-small"
  :text "A shallow copy. The suite walks the original and the copy in lockstep and requires (not (eq? c cp)) at EVERY cdr position -- so every cell of the spine is fresh, not just the first. It also requires (list-copy '(1 2 3 . 4)) to answer (1 2 3 . 4), i.e. an improper list copies its spine and keeps its non-list tail.")


;;; ── 2. CONFORMANCE SUITE (verbatim) ──
;;; scratch/r7rs-conformance/larceny/list.sld — "Adapted from
;;; srfi-1-test.sps" (list.sld:183). The file carries its own caveat
;;; at list.sld:171-173: "Some of these tests are not portable
;;; because they require the procedures designated as 'linear update'
;;; variants in the spec (eg append!) to side-effect their arguments."
(conformance-suite
    ;; scratch/r7rs-conformance/larceny/list.sld:218-232
         (test-assert (call-with-current-continuation
                       (lambda (abort)
                         (let* ((c  (list 1 2 3 4 5))
                                (cp (list-copy c)))
                           (or (equal? c cp)
                               (abort #f))
                           (let loop ((c c) (cp cp))
                             (if (not (null? c))
                                 (begin
                                   (or (not (eq? c cp))
                                       (abort #f))
                                   (loop (cdr c) (cdr cp)))))
                           #t))))
         
         (test (list-copy '(1 2 3 . 4)) '(1 2 3 . 4))
)

