;;; ── 1. CONTRACT (DERIVED from the in-repo evidence in §2-§5) ──

(contract :verb "concatenate!" :std "SRFI-1"
  :text "One-level flatten of a list of lists, relinking the sub-lists instead of copying them. The suite's value test is the same as concatenate's; the identity requirement follows from append!, which concatenate! is defined in terms of.")


;;; ── 2. CONFORMANCE SUITE (verbatim) ──
;;; scratch/r7rs-conformance/larceny/list.sld — "Adapted from
;;; srfi-1-test.sps" (list.sld:183). The file carries its own caveat
;;; at list.sld:171-173: "Some of these tests are not portable
;;; because they require the procedures designated as 'linear update'
;;; variants in the spec (eg append!) to side-effect their arguments."
(conformance-suite
    ;; scratch/r7rs-conformance/larceny/list.sld:351-354
         (test (concatenate '((1 2 3) (4 5 6) () (7 8 9))) '(1 2 3 4 5 6 7 8 9))
         
         (test (concatenate! `(,(list 1 2 3) ,(list 4 5 6) () ,(list 7 8 9)))
               '(1 2 3 4 5 6 7 8 9))
)

