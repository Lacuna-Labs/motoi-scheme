;;; ── 1. CONTRACT (DERIVED from the in-repo evidence in §2-§5) ──

(contract :verb "circular-list" :std "SRFI-1"
  :text "Builds a circular list from its arguments: the last cdr points back at the head. The suite pins that it is NOT a list? and NOT a proper-list? and NOT a dotted-list?, that circular-list? says #t, that null-list? says #f, that length+ returns #f on it, and -- the load-bearing one -- that the elements are stored by IDENTITY and the cycle really closes: with x = (circular-list a b c), (eq? a (cadddr x)) is #t.")


;;; ── 2. CONFORMANCE SUITE (verbatim) ──
;;; scratch/r7rs-conformance/larceny/list.sld — "Adapted from
;;; srfi-1-test.sps" (list.sld:183). The file carries its own caveat
;;; at list.sld:171-173: "Some of these tests are not portable
;;; because they require the procedures designated as 'linear update'
;;; variants in the spec (eg append!) to side-effect their arguments."
(conformance-suite
    ;; scratch/r7rs-conformance/larceny/list.sld:234-242
         (test-assert (not (list? (circular-list 1 2 3))))
         (test-assert (let* ((a (list 'a))
                             (b (list 'b))
                             (c (list 'c))
                             (x (circular-list a b c)))
                        (and (eq? a (car x))
                             (eq? b (cadr x))
                             (eq? c (caddr x))
                             (eq? a (cadddr x)))))
    ;; scratch/r7rs-conformance/larceny/list.sld:251-256
         (test-assert (not (proper-list? (circular-list 1 2 3))))
         
         (test-assert (not (circular-list? '(1 2 3 4 5))))
         (test-assert (not (circular-list? '())))
         (test-assert (not (circular-list? '(1 2 . 3))))
         (test-assert (circular-list? (circular-list 1 2 3)))
    ;; scratch/r7rs-conformance/larceny/list.sld:261-265
         (test-assert (not (dotted-list? (circular-list 1 2 3))))
         
         (test-assert (null-list? '()))
         (test-assert (not (null-list? '(1 2))))
         (test-assert (not (null-list? (circular-list 1 2))))
    ;; scratch/r7rs-conformance/larceny/list.sld:336-337
         (test-assert (not (length+ (circular-list 1 2 3))))
         (test (length+ '(1 2 3 4)) 4)
    ;; scratch/r7rs-conformance/larceny/list.sld:360-362
         (test (zip '(1 2 3) '(4 5 6)) '((1 4) (2 5) (3 6)))
         (test (zip '() '() '() '()) '())
         (test (zip '(1) (circular-list 1 2)) '((1 1)))
)

