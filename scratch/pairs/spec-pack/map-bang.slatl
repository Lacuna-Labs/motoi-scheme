;;; ── 1. CONTRACT (DERIVED from the in-repo evidence in §2-§5) ──

(contract :verb "map!" :std "SRFI-1"
  :text "Maps f over lst, writing each result back into the cell it came from. The suite is explicit and is the clearest test in the file: after (map! (lambda (x) (* x x)) l), BOTH the result and l itself equal (1 4 9). The argument list is overwritten element by element.")


;;; ── 2. CONFORMANCE SUITE (verbatim) ──
;;; scratch/r7rs-conformance/larceny/list.sld — "Adapted from
;;; srfi-1-test.sps" (list.sld:183). The file carries its own caveat
;;; at list.sld:171-173: "Some of these tests are not portable
;;; because they require the procedures designated as 'linear update'
;;; variants in the spec (eg append!) to side-effect their arguments."
(conformance-suite
    ;; scratch/r7rs-conformance/larceny/list.sld:451-454
         (test-assert (let* ((l (list 1 2 3))
                             (m (map! (lambda (x) (* x x)) l)))
                        (and (equal? m '(1 4 9))
                             (equal? l '(1 4 9)))))
)

