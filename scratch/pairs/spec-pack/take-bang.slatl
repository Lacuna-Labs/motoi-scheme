;;; summary, NOT the standard's text.
(part-summary
    ;; ABSENT from both spec/srfi-1.slatl and spec/r7rs-small.slatl.
)

;;; ── 4. CURRENT IMPLEMENTATION ──
(implementation
    ;; lib/std/srfi-1.js:57
    'delete!', 'delete-duplicates!', 'concatenate!', 'take!', 'drop-right!',
    ;; lib/std/srfi-1.js:859
    ['concatenate!', 'concatenate'], ['take!', 'take'], ['drop-right!', 'drop-right'],
    ;; lib/std/srfi-1.js:955
    ['concatenate!', 'concatenate'], ['take!', 'take'], ['drop-right!', 'drop-right'],
)

;;; ── 5. STATUS ──
(status :value "needs-alfred"
  :because "The normative SRFI-1 text for this verb is not in the repo.
           The CONTRACT above is DERIVED from the in-repo conformance
           suite and part summary, not quoted from the standard.")
