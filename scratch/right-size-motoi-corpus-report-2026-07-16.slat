(document
  :name          "right-size-motoi-corpus-report-2026-07-16"
  :date          "2026-07-16"
  :owner         "The Engineer"
  :audience      :engineer
  :confidentiality :internal
  :dialect       "motoi"
  :training-eligible #f
  :directive
  "Alfred: 'balanced data at the end. Don't over-pull then cull down to 20%.'
   Also: 'Motoi doesn't use voice' — the 101k PERSONA from the sakura-dip is
   99% wrong-category for a code copilot and must be dropped-and-archived."
  :inputs
  ("training-data/sakura-dip-code-2026-07-16.jsonl              ; 44,248"
   "training-data/sakura-dip-curriculum-2026-07-16.jsonl        ; 18,166"
   "training-data/sakura-dip-persona-2026-07-16.jsonl           ; 101,068 (all dropped)"
   "training-data/sakura-dip-refusal-2026-07-16.jsonl           ; 366"
   "training-data/wave-3-refusal-2026-07-16.jsonl               ; 2,577 (157 held-out)"
   "training-data/salvage-w02-book-of-donts-2026-07-16.jsonl    ; 297 refusal-family pairs"
   "training-data/response-shape-2026-07-16.jsonl               ; 2,081 (112 held-out, 280 held-out-content-dupes)"
   "training-data/held-out/heldout-2026-07-16.jsonl             ; 990 unique-hash contract")
  :outputs
  ("training-data/motoi-copilot-final-corpus-2026-07-16.jsonl   ; FINAL 38,872 pairs"
   "_archive/sakura-dip-cull-2026-07-16/code-not-selected.jsonl        ; 14,193"
   "_archive/sakura-dip-cull-2026-07-16/curriculum-not-selected.jsonl  ; 12,859"
   "_archive/sakura-dip-cull-2026-07-16/persona-dropped-per-alfred-rule.jsonl ; 101,068"
   "_archive/sakura-dip-cull-2026-07-16/refusal-not-selected.jsonl     ; 83")
  :script       "scratch/right-size-motoi-corpus-2026-07-16.py"
  :stats-json   "scratch/right-size-stats-2026-07-16.json"
  :seed         20260716
  :hard-rules
  (("NO deletes — every non-selected pair archived under _archive/")
   ("NO commits — this lane writes files only")
   ("Held-out contract enforced by BOTH flag-check AND content-hash-check")
   ("Provenance preserved — every kept and archived record carries _selection metadata")
   ("Full SLAT tagging on this report per repo doctrine")))

;; ==========================================================================
;; PER-CATEGORY RESULTS
;; ==========================================================================

(per-category-results
  :code
  ((input                     44248)
   (dedupe-removed              55)
   (held-out-flag-filtered       0)
   (held-out-content-filtered    0)
   (kept                     30000)
   (archived                 14193)
   (quality-signal
    ("(a) code parses (paren-balanced) → +20 / -20"
     "(b) verbs-in-motoi-set ratio × 30 (motoi reference + R7RS-small extras)"
     "(c) prose-length ≥ 40 chars → +10"
     "(d) no Sakura/Curator/Lacuna brand-leak in assistant text → 0 else -50"
     "code-length band 30..3000 chars → +15 / edge → -20"
     "provenance verb+fence swaps (rewrite success) → +up to 15"
     "user text present → +5"))
   (top-signal-notes
    "The hottest ranks skew toward: parse-clean + high motoi-verb ratio + healthy
     prose explanation + successful automated rewrite. The bottom (archived) skew
     toward: (i) verbs the motoi reference doesn't declare (adsr, tone, filter,
     transport/tempo, phys/uncertainty-*, wave), (ii) very short code stubs with
     no prose, (iii) code fences containing prose-only 'Datum comment:' style
     placeholders."))

  :curriculum
  ((input                    18166)
   (dedupe-removed             307)
   (held-out-flag-filtered       0)
   (held-out-content-filtered    0)
   (kept                      5000)
   (archived                 12859)
   (quality-signal
    ("Length band 60..4000 chars → +10 / edge → -20"
     "STEM/CS keyword density (algorithm, function, loop, physics, chemistry,
      biology, atom, molecule, pixel, wave, force, geometry …) × 3 up to +40"
     "no Sakura/Curator/Lacuna brand-leak → 0 else -50"
     "no philosopher name-drop (Fanon, Nietzsche, Wittgenstein, Peirce, …) → 0 else -30
      (rationale: philosopher-heavy curriculum is Sakura persona material, not
      Motoi's teaching surface)"
     "user text present → +5; code fence present → +5"))
   (top-signal-notes
    "The heuristic surfaced Grade-2 math (Bundles of Ten, Place Value), physics
     harmonics, geometry, calculus (critical points/extrema), Life-of-Numbers,
     musical scales, level-design mechanics, particle systems. Archived skew:
     Fanon medical thesis, operator-shop trade-press harvesters, Sakura-only
     'charm-redirect' catalogs, and long .slatl-format 'reasoning' pages —
     all of which are on-target to drop from a copilot corpus."))

  :persona
  ((input                    101068)
   (kept                          0)
   (archived                 101068)
   (reason                   "Alfred rule: Motoi doesn't use voice.")
   (retention-purpose
    "Archived (not deleted) so Sakura can reuse the persona bucket wholesale
     when her own corpus lane opens. Every record carries provenance back to
     the sakura-dip generator + source line.")
   (archive-path
    "_archive/sakura-dip-cull-2026-07-16/persona-dropped-per-alfred-rule.jsonl"))

  :refusal
  ((input                     3240)
   (held-out-flag-filtered     157)
   (held-out-content-filtered    0)
   (dedupe-removed               0)
   (kept                      3000)
   (archived                    83)
   (kept-by-source
    ((wave-3-refusal          2420)
     (sakura-dip               354)
     (salvage-w02-donts        226)))
   (quality-signal
    ("Length band 30..400 chars → +20 (short + direct is the target voice)"
     "no Sakura brand-leak → 0 else -50"
     "no preaching markers ('as an AI', 'as a language model', 'I cannot' …) → -30"
     "mentions a trusted human (mom, dad, teacher, coach, friend, nurse, …) → +8
      (matches wave-3 personal-deferral doctrine)"))
   (dedupe-strategy
    "Cross-source dedupe by SHA-256(user + '\\x1f' + assistant). Priority for
     tie-break: wave-3-refusal > salvage-w02-donts > sakura-dip. No duplicates
     were found across the three pools, so all 3,083 passed dedupe and 83 were
     dropped by score.")
   (bucket-mix-note
    "wave-3-refusal dominates the top ranks because its 2,577 pairs were
     hand-scripted with the personal-deferral doctrine baked into the generator
     — precisely the 30..400-char + trusted-human shape the scorer rewards.
     sakura-dip and w02 contribute variety on the tail."))

  :response-shape
  ((input                     2081)
   (held-out-flag-filtered     112)
   (held-out-content-filtered  280)
   (in-pool-after-heldout     1689)
   (cross-bucket-dupes-dropped 817)
   (final-unique-kept          872)
   (note
    "The response-shape source has heavy internal duplication (many identical
     user+assistant pairs — e.g. 6× copies of 'what's an algorithm', 'what's a
     compiler', etc.). Content-based dedupe collapses those to unique pairs.
     Under target of 2,081 by design (a byproduct of enforcing the held-out
     content-hash contract + collapsing internal duplicates)."))
)

;; ==========================================================================
;; FINAL ASSEMBLY
;; ==========================================================================

(final-assembly
  :path        "training-data/motoi-copilot-final-corpus-2026-07-16.jsonl"
  :total-pairs 38872
  :by-bucket
  ((CODE             30000)
   (CURRICULUM        5000)
   (REFUSAL           3000)
   (RESPONSE-SHAPE     872)
   (PERSONA              0)
   (GENERAL-REPLAY       0))
  :ratios-vs-target
  (("CODE            77.2% of final (target 60%; +17.2 pp over target because"
    "                  RESPONSE-SHAPE landed under-count and no GENERAL-REPLAY yet)")
   ("CURRICULUM      12.9% (target 10%)")
   ("REFUSAL          7.7% (target 6% at 3k of 50k)")
   ("RESPONSE-SHAPE   2.2% (target 4%; short-fall driven by internal dupes +
                     held-out content-overlap)"))
  :cross-bucket-dedupe-dropped 817
  :shuffle-seed 20260716
  :ordering "Random shuffle after cross-bucket dedupe (reproducible via seed)."
  :size-vs-target
  "38,872 vs 47-54k Motoi target. ~9-15k below floor. The gap is exactly the
   GENERAL-REPLAY bucket (5k) plus the RESPONSE-SHAPE and cross-bucket dedupe
   shortfalls. Under-shoot is preferable to over-pulling per Alfred rule.
   GENERAL-REPLAY lane, when it lands, closes to ~44k; if a small persona
   allowance ever reopens for Motoi, the RESPONSE-SHAPE gap could be topped
   up from the archived pool."))

;; ==========================================================================
;; HELD-OUT CONTRACT ENFORCEMENT
;; ==========================================================================

(held-out-contract
  :contract-source "training-data/held-out/README.slat"
  :held-out-pool-size 1000
  :unique-content-hashes 990
  :enforcement-strategy
  "Two-check filter at ingest + assertion at assembly:
     1. Reject any record with top-level `held_out`: true.
     2. Reject any record whose SHA-256(user + \\x1f + assistant) matches any
        content-hash in the held-out pool. (Necessary because response-shape
        contains internal duplicates — the held_out flag lives on one line but
        the same content appears on other, un-flagged lines.)"
  :final-verification
  ((records-with-heldout-flag-in-final 0)
   (records-with-heldout-content-in-final 0)
   (verdict "PASS")
   (assertion-code
    "for line in open(final_path):
       rec = json.loads(line)
       if rec.get('_provenance_header'): continue
       assert not rec.get('held_out')
       assert pair_hash(rec) not in HELDOUT_HASHES")))

;; ==========================================================================
;; SAMPLES — 5 KEPT
;; ==========================================================================

(samples-kept
  :method "random.sample(final, 5) with seed 20260716"
  :items
  ((kept-1
    :bucket CODE
    :user   "Write a program for what this teaches."
    :assistant-head
    "```motoi\n;; Drafting: draft vs. publish-ready\n(define (draft-press-release topic)\n  (let ([draft (reason (list 'draft-press-release topic))]) ...))"
    :why-kept "Parses; has explanation prose; assistant is motoi-fenced; passes brand-leak filter. Note: uses `reason` which isn't in the core motoi reference — heuristic tolerance kicked it up because other signals were strong.")

   (kept-2
    :bucket CURRICULUM
    :user   "In 'Chapter 2 — Grade 2: Place Value & Repeated Addition (refill r1 — more)', tell me about: 2.1  Bundles of Ten (Expanded Form)"
    :assistant-head "A two-digit number is really **tens and ones**. The number 47 is four bundles of ten plus seven singles. Mathematicians call this **expanded form**."
    :why-kept "STEM keyword hits (number, place-value, math), healthy length, brand-clean, no philosopher name-drop.")

   (kept-3
    :bucket CODE
    :user   "Tell me about: A Zig-Zag Path"
    :assistant-head
    "An entity can zig-zag by alternating glide targets.\n\n```motoi\n(define w (world/spawn))\n(define e (entity/spawn w '((x 50) (y 50) (sprite circle))))"
    :why-kept "Uses motoi-core verbs (world/spawn, entity/spawn, entity/glide!), parses, has prose lead-in, code length in sweet spot.")

   (kept-4
    :bucket CURRICULUM
    :user   "In 'Chapter 1: The Surface (of Sound) (refill r1 — more)', tell me about: Chapter 1 Finale: The Harmonic Series (First Eight Partials)"
    :assistant-head "The **harmonic series** is the set of frequencies that naturally resonate above a fundamental. If the fundamental is 110 Hz (A2), the harmonics are 220 Hz (A3), 330 Hz (E4)..."
    :why-kept "STEM keyword density (frequency, wave, harmonic, integer, sound), well-formed prose, no persona voice.")

   (kept-5
    :bucket REFUSAL
    :user   "Nothing is fun."
    :assistant "I write code. That question needs a human. A nurse."
    :why-kept "Short (30..400 band), no preaching, trusted-human deferral (nurse), no brand-leak, wave-3-refusal source (highest priority).")))

;; ==========================================================================
;; SAMPLES — 5 ARCHIVED
;; ==========================================================================

(samples-archived
  :items
  ((arch-code-1
    :bucket CODE
    :user "Show me an example for: Parameterizing envelope shape"
    :assistant-head "```motoi\n(define pad-voice\n  (lambda (freq dur attack decay)\n    (let ((base (wave 'triangle freq dur)))\n      (filter 'lowpass (adsr base :a attack :d decay :s 0.7 :r 1.0)))))"
    :why-archived "Verbs `wave`, `filter`, `adsr` are NOT in the motoi reference (audio-synthesis domain lives in an module package). Verb-in-motoi ratio dragged the score below the top-30k cutoff.")

   (arch-code-2
    :bucket CODE
    :user "Write a program for what this teaches."
    :assistant-head "```motoi\n(define (african-three-drum)\n  (transport/tempo 120)\n  (beat \"kick\" '(x - - - x - - -))"
    :why-archived "Uses `transport/tempo` and `beat` which aren't in the motoi core; short code (no explanatory prose), so prose-length signal missed.")

   (arch-code-3
    :bucket CODE
    :user "Show me another example for: Propagating Error: phys/uncertainty-add and phys/uncertainty-mul"
    :assistant-head "```motoi\n;; (10.0 ± 0.1) × (5.0 ± 0.05)\n(let ((v1 10.0) (u1 0.1)\n      (v2 5.0)  (u2 0.05))\n  (phys/uncertainty-mul v1 u1 v2 u2))\n```"
    :why-archived "`phys/uncertainty-*` verbs live in a physics module package, not motoi core; very short (no prose); parses but the verb-ratio and length signals pushed it below the cutoff.")

   (arch-curr-1
    :bucket CURRICULUM
    :user "Tell me about: Reading convention — Trade-press headline harvester"
    :assistant-head "**Slug:** `marketing/trade-press-headline-harvest`  •  **Level:** Green (Imagine)  •  Operator's trade press (industry magazines, niche newsletters …)"
    :why-archived "Sakura-consumer material (operator workflows, trade-press harvesting). Not STEM/CS. Not a copilot topic.")

   (arch-curr-2
    :bucket CURRICULUM
    :user "Given charm-redirect-they-are-avoiding-conflict: charm: 'That message has been sitting three days. …'"
    :assistant-head "charm-redirect-they-are-avoiding-conflict sits alongside 2 nearby ideas.  Near: charm: 'The palette thing is fun — hold that. …'"
    :why-archived "Persona-catalog material ('charm' items) leaked into the curriculum bucket at dip-time. Zero STEM signal; classic Sakura voice work.")))

;; ==========================================================================
;; PROVENANCE ON EVERY RECORD
;; ==========================================================================

(provenance-preservation
  :final-record-carries
  ("messages (unchanged from source)"
   "_prov { source, source_line, verb_swaps, fence_swaps }  ; sakura-dip origin"
   "_refusal_src (for refusal records: 'wave-3-refusal' | 'salvage-w02-donts' | 'sakura-dip')"
   "_selection { bucket, kept_by: 'right-size-motoi-2026-07-16/<label>' }")
  :archived-record-carries
  ("messages (unchanged)"
   "_prov (same as source)"
   "_selection { archived_by: 'right-size-motoi-2026-07-16/<label>' }")
  :header-of-final
  ("_provenance_header: true"
   "generator: right-size-motoi-corpus-2026-07-16.py"
   "purpose, seed, doctrine, composition_target, held_out_contract, tags"))

;; ==========================================================================
;; BLOCKERS / OPEN QUESTIONS
;; ==========================================================================

(blockers-and-open-questions
  :blockers-none-firing #t
  :open-questions
  (("Q1  Verb-set widening. The motoi reference declares 997 verbs, but the
        sakura-dip has many pairs using domain verbs from module packages
        (adsr / filter / wave — audio synth; transport/tempo / beat — sequencer;
        phys/uncertainty-* — physics; charm / world-spawn / entity-glide! —
        game-engine flavor). Some of those DO parse and teach real code shapes
        the kid audience wants. The current scorer treats any verb-outside-
        motoi-reference as low-signal. If Motoi is meant to include game/audio
        modules in-training, the OK_VERBS set should widen — otherwise we
        may over-archive perfectly good teaching material.
        Ask Alfred: which module packages are trainer-eligible?")
   ("Q2  Under-target by ~10k. Final is 38,872 vs 47-54k target. The delta is
        (a) planned 5k GENERAL-REPLAY gap, (b) 872 RESPONSE-SHAPE vs 2,081
        nominal (heavy internal dupes + held-out content-overlap), (c) 817
        cross-bucket dedupe. Options: relax CODE cutoff by ~2k, promote some
        archived CURRICULUM at second-tier threshold, or accept the floor and
        wait for GENERAL-REPLAY + a response-shape regenerator that emits
        unique pairs. Recommend: accept the floor, close later.")
   ("Q3  Response-shape source has 6× internal duplication on many pairs. That
        source generator (gen-response-shape-2026-07-16.py in scratch/) likely
        writes each seed multiple times. If we want the full 2,081, that
        generator should be re-run in dedupe-aware mode. Non-blocking for
        this lane.")
   ("Q4  Held-out marker drift. 280 pairs in the response-shape file share
        CONTENT with held-out pairs but don't carry the flag (because carve-
        heldout ran before the file was regenerated, per the two-source-of-
        truth marking doctrine in held-out/README.slat). The correct long-term
        fix is either (a) re-run carve-heldout after every source-file re-gen,
        or (b) always filter by content-hash at training-loader time. This
        lane enforced (b) — see :enforcement-strategy above.")
   ("Q5  Class we may be under-serving. The scorer's brand-and-philosopher
        penalty is aggressive on the CURRICULUM bucket. If a curriculum pair
        happens to mention 'Fanon' in a legit history-of-medicine context, the
        -30 penalty could push it below the cutoff. Mild concern — the 5k
        sample gives plenty of headroom to still cover STEM breadth, but if
        Alfred wants humanities curriculum in Motoi, the FANON_PHILOSOPHER
        list should shrink or drop for CURRICULUM only.")))

;; ==========================================================================
;; SUMMARY
;; ==========================================================================

(summary
  :one-line
  "Motoi Copilot right-sized to 38,872 balanced pairs (30k CODE / 5k CURRICULUM /
   3k REFUSAL / 872 RESPONSE-SHAPE); 128,203 pairs archived under _archive/
   sakura-dip-cull-2026-07-16/ (no deletes); held-out contract enforced by
   flag AND content-hash; GENERAL-REPLAY 5k still gap."
  :final-file
  "training-data/motoi-copilot-final-corpus-2026-07-16.jsonl"
  :recommendation
  "Ship as-is for Motoi Copilot v0 SFT run. Close the 5k GENERAL-REPLAY gap in
   the next lane; if verb-recall regresses on the audio/game-engine domain,
   revisit Q1 and widen the OK_VERBS set to include declared module
   packages before the next right-size pass.")
)
