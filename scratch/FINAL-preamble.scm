(define TWO-PI (* 2 3.141592653589793))
(define (midi->freq n) (* 440.0 (expt 2.0 (/ (- n 69) 12.0))))
(define (wave-sample f t) (math/sin (* TWO-PI f t)))
(define pitch-class-table
  '(("C" 0)("C#" 1)("Db" 1)("D" 2)("D#" 3)("Eb" 3)
    ("E" 4)("F" 5)("F#" 6)("Gb" 6)("G" 7)("G#" 8)
    ("Ab" 8)("A" 9)("A#" 10)("Bb" 10)("B" 11)))
(define (pitch-name->midi s)
  (let* ((n (string-length s))
         (oct (string->number (substring s (- n 1) n)))
         (pc (substring s 0 (- n 1)))
         (pair (assoc pc pitch-class-table)))
    (if (and oct pair) (+ (cadr pair) (* 12 (+ oct 1))) 60)))
(define (as-freq p)
  (cond ((and (number? p) (< p 128)) (midi->freq p))
        ((number? p) p)
        ((symbol? p) (midi->freq (pitch-name->midi (symbol->string p))))
        ((string? p) (midi->freq (pitch-name->midi p)))
        (else 440.0)))
(define (wave f n dt) (map (lambda (k) (wave-sample (as-freq f) (* k dt))) (iota n)))
(define (tone f dur) (wave f 6 0.001))
;; audio/play 'tone freq dur  |  audio/play 'note "C4" dur
(define (audio/play kind pitch dur) (wave pitch 6 0.001))
(define (make-tone f) (lambda () (tone f 1.0)))
(define (beep) (tone 440.0 0.15))
(define (chime) (list (tone 523.25 0.3) (tone 659.25 0.3) (tone 783.99 0.3)))
(define (note/strike pitch dur . rest) (list (as-freq pitch) (wave pitch 4 0.001)))
(define (note/place-at beat pitch dur . rest) (list beat (note/strike pitch dur)))
(define (additive f amps t)
  (let loop ((k 1) (as amps) (acc 0.0))
    (if (null? as) acc
        (loop (+ k 1) (cdr as) (+ acc (* (car as) (wave-sample (* k (as-freq f)) t)))))))
(define (create-periodic-wave reals . imags) reals)
(define (make-voice profile) profile)
(define (voice/create kind) kind)
(define (base/at-beat beat . body) (cons beat body))
(define (base/across-beats beats . body) (if (pair? beats) (map (lambda (b) (cons b body)) beats) (cons beats body)))
(define (beat name pos) (list 'beat name pos))
(define (with-voice v . body) (cons v body))
(define (with-dynamics d . body) (cons d body))
(define (section-voice name . body) (cons name body))
(define (transpose semis . notes) (map (lambda (n) (+ n semis)) notes))
(define (transport/tempo-curve . pts) pts)
(define (synth/play voice pitch dur) (wave pitch 6 0.001))
(define (base/land-on-downbeat . body) (cons 0 body))
(define (create-section-voice name profile) (list name profile))
(define (define-voice name profile) (list name profile))
(define (pedal/press) 'pedal-down)
(define (pedal/release) 'pedal-up)
(define (note-play-for pitch dur) (note/strike pitch dur))
(define (note-play pitch dur) (note/strike pitch dur))
(define (note-play-note pitch dur vel) (note/strike pitch dur vel))
(define (parallel . voices) voices)
(define (play-line . notes) (map as-freq notes))
(define (chord/play notes dur) (map as-freq notes))
(define (chord/build . notes) (map as-freq notes))
(define (silence-for beats) (list 'rest beats))
(define (rest-for beats) (list 'rest beats))
(define (silence dur) (list 'rest dur))
;; a trill is rapid alternation between two frequencies — sample both
(define (trill a b dur . rest) (list (wave a 3 0.001) (wave b 3 0.001)))
(define (grace-note orn main dur) (list (as-freq orn) (as-freq main)))

(display (as-freq 'C4)) (newline)
(display (as-freq "A4")) (newline)
(display (note/strike 60 1.0 64)) (newline)
(display (note/place-at 0 'G4 'quarter)) (newline)
(display (tone 440 1.0)) (newline)
(display (create-periodic-wave '(0.0 1.0 0.4) '(0.0 0.0 0.0))) (newline)
(display (base/at-beat 0 'kick)) (newline)
(display (beat 'snare 2)) (newline)
(display (transpose 12 60 62 64)) (newline)
(display (additive 220.0 '(1.0 0.5 0.25) 0.001)) (newline)
