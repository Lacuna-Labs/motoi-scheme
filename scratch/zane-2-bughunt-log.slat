(:doc "zane-2-bughunt-log"
 :agent "zane-2"
 :scope ("lib/game/*" "lib/audio/*" "lib/ai/*" "lib/system/*")
 :started "2026-07-17"
 :baseline (:tests 324 :pass 324 :fail 0)
 :ended-tests (:tests 396 :pass 396 :fail 0)
 :fixes (
   (:id "BUG-1"
    :severity "high"
    :classes ("type-mismatch" "silent-failure")
    :file "lib/game/game.js + lib/game/entity.js + lib/game/scene.js"
    :verbs ("entity/tag!" "entity/untag!" "entity/has-tag?" "entity/hits-tag" "entity/make" "scene/*")
    :summary "entity/spawn stored tags as Set, entity/make + spawnOne stored as Array. tag!/untag!/has-tag?/hits-tag disagreed on shape — one path threw TypeError, the other silently failed."
    :fix "Normalized all creation sites to Set + added _tagSet(e) helper that live-migrates any Array-shaped legacy tags to Set on first read. Idempotent."
    :test "BUG-1 (4 tests)")

   (:id "BUG-2"
    :severity "high"
    :classes ("determinism-lie" "coverage-gap")
    :file "lib/game/misc.js"
    :verbs ("with-seed" "random-int" "random-range" "random-pick" "randint" "rng-uniform")
    :summary "with-seed only reached (random). random-int / random-range / random-pick / randint / rng-uniform (registered in src/base.js) bypassed the LCG entirely — two runs with the same seed diverged whenever those verbs were used."
    :fix "Rebound all five base random verbs inside installMisc to route through the shared _seededUniform() draw. Now with-seed covers the entire random surface."
    :test "BUG-2 (4 tests)")

   (:id "BUG-3"
    :severity "medium"
    :classes ("determinism-lie")
    :file "lib/game/part.js"
    :verbs ("part/shake")
    :summary "part/shake called Math.random() directly, bypassing with-seed. Any animation using shake diverged on replay."
    :fix "Import seededRandom from misc.js and route the jitter through it."
    :test "BUG-3 (1 test)")

   (:id "BUG-4"
    :severity "medium"
    :classes ("determinism-lie")
    :file "lib/ai/steering.js"
    :verbs ("ai/wander")
    :summary "ai/wander called Math.random() directly. Boid replay under with-seed still diverged frame-to-frame."
    :fix "Import seededRandom from misc.js and route the jitter through it."
    :test "BUG-4 (1 test)")

   (:id "BUG-11"
    :severity "medium"
    :classes ("state-corruption" "off-by-one")
    :file "lib/system/time-verbs.js"
    :verbs ("time/delta")
    :summary "clock.last was updated BEFORE the unit was validated. A call with a bogus unit returned 'nan but still consumed the wall-clock tick, so the next legit call under-reported its elapsed time."
    :fix "Validate unit first via convertUnit(0, u); return 'nan without touching clock.last on invalid units."
    :test "BUG-11 (1 test)")

   (:id "BUG-12"
    :severity "high"
    :classes ("silent-failure" "verb-signature-mismatch")
    :file "lib/game/scheduler.js"
    :verbs ("on-tick" "after")
    :summary "typeof fn === 'function' rejected Scheme Closures (which are Closure class instances with .params, not JS functions). Every Scheme (on-tick (lambda () …)) returned -1 without registering."
    :fix "Added isCallable helper matching the pattern used in game.js / game-instances.js / game-theory.js: fn is callable iff it's a JS function or has .params."
    :test "BUG-12 (2 tests)")

   (:id "BUG-15"
    :severity "high"
    :classes ("silent-failure" "verb-signature-mismatch")
    :file "lib/game/game-instances.js"
    :verbs ("big-bang" "game/step")
    :summary "Same typeof-only guard on the big-bang step-fn slot. Scheme closures got nulled out, so (game/step id) never advanced state. Additionally, stepInstance called stepFn(...) directly instead of going through apply — even if we'd let the closure through, calling it as a JS fn would fail."
    :fix "Route through _isCallable + apply(fn, args, {n:200000}) when the fn is a Closure."
    :test "BUG-15 (1 test)")

   (:id "BUG-16"
    :severity "medium"
    :classes ("data-shape-corruption" "silent-failure")
    :file "lib/ai/cortex-io.js"
    :verbs ("cortex/write")
    :summary "cortex/write only unwrapped top-level Syms. Nested Syms inside alists/objects serialized as {\"name\":\"...\"} plain objects — on read-back the caller got a nonsensical shape (data-shape corruption)."
    :fix "Moved the recursive norm() helper above cortex/write and route the value through it before storage."
    :test "BUG-16 (1 test)")

   (:id "BUG-17"
    :severity "low"
    :classes ("coercion-gap" "consistency")
    :file "lib/game/world.js"
    :verbs ("world/camera-bounds!")
    :summary "world/camera-bounds! stored { x, y, w, h } raw — every other world/camera-* verb coerced via Number(). Callers passing Sym / string args got a bounds record that didn't compare with the numeric camera position."
    :fix "Number()-coerce all four params to match the surrounding verbs. Low impact today (no reader touches cameraState.bounds), but locking the shape prevents downstream drift."
    :test "no dedicated test — covered by consistency scan and the other camera tests already exercising cameraState")

   (:id "BUG-18"
    :severity "low"
    :classes ("silent-failure")
    :file "lib/game/game-theory.js"
    :verbs ("game/grundy")
    :summary "grundy() rejected Scheme closures via typeof-only guard. Since game-theory.js is behind (import (motoi game-theory)), impact today = zero — but any Scheme caller loading the module and passing a lambda-generated moves-fn silently returned 0 without recursing."
    :fix "Added _isCallable + _callFn helpers routing through interp.apply."
    :test "no dedicated test — module not wired into makeCoreEnv; fix stands ready for when it is.")
 ))
