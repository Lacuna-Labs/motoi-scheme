(define (euler-step x v dt)
  (let ((a (- x)))
    (list (+ x (* v dt)) (+ v (* a dt)))))
(define (run-euler steps dt)
  (let loop ((n 0) (x 1.0) (v 0.0) (max-x 1.0))
    (if (>= n steps)
        (list 'euler 'final-x x 'final-v v 'max-x max-x)
        (let ((next (euler-step x v dt)))
          (loop (+ n 1) (car next) (cadr next) (max max-x (abs (car next))))))))
(define (semi-euler-step x v dt)
  (let* ((a (- x)) (v* (+ v (* a dt))))
    (list (+ x (* v* dt)) v*)))
(define (run-semi-euler steps dt)
  (let loop ((n 0) (x 1.0) (v 0.0) (max-x 1.0))
    (if (>= n steps)
        (list 'semi-euler 'final-x x 'final-v v 'max-x max-x)
        (let ((next (semi-euler-step x v dt)))
          (loop (+ n 1) (car next) (cadr next) (max max-x (abs (car next))))))))
(define (verlet-step x v a-cur dt)
  (let* ((x* (+ x (* v dt) (* 0.5 a-cur dt dt)))
         (a* (- x*))
         (v* (+ v (* 0.5 (+ a-cur a*) dt))))
    (list x* v* a*)))
(define (run-verlet steps dt)
  (let loop ((n 0) (x 1.0) (v 0.0) (a -1.0) (max-x 1.0))
    (if (>= n steps)
        (list 'verlet 'final-x x 'max-x max-x)
        (let ((next (verlet-step x v a dt)))
          (loop (+ n 1) (car next) (cadr next) (caddr next) (max max-x (abs (car next))))))))
(define (rk4-step x v dt)
  (let* ((k1x v) (k1v (- x))
         (k2x (+ v (* 0.5 dt k1v))) (k2v (- (+ x (* 0.5 dt k1x))))
         (k3x (+ v (* 0.5 dt k2v))) (k3v (- (+ x (* 0.5 dt k2x))))
         (k4x (+ v (* dt k3v))) (k4v (- (+ x (* dt k3x)))))
    (list (+ x (* (/ dt 6) (+ k1x (* 2 k2x) (* 2 k3x) k4x)))
          (+ v (* (/ dt 6) (+ k1v (* 2 k2v) (* 2 k3v) k4v))))))
(define (run-rk4 steps dt)
  (let loop ((n 0) (x 1.0) (v 0.0) (max-x 1.0))
    (if (>= n steps)
        (list 'rk4 'final-x x 'max-x max-x)
        (let ((next (rk4-step x v dt)))
          (loop (+ n 1) (car next) (cadr next) (max max-x (abs (car next))))))))
(display (run-euler 500 0.1)) (newline)
(display (run-semi-euler 500 0.1)) (newline)
(display (run-verlet 500 0.1)) (newline)
(display (run-rk4 500 0.1)) (newline)
