;; The motion runtime — a tiny world built on real Motoi primitives.
;; Entity = (vector tag pos vel mass gscale glyph). Everything here is plain
;; Scheme over vec/* — no ripped display verbs, no fabrication.
(define PI  (* 4 (atan 1)))
(define TAU (* 2 PI))
(define (dsqrt x) (sqrt x))
(define (dcos x)  (cos x))
(define (dsin x)  (sin x))
(define (datan2 y x) (atan y x))
(define (mod a b) (- a (* b (floor (/ a b)))))

(define *world*   '())
(define *gravity* 0.0)
(define *floor*   #f)
(define (world/reset!)    (set! *world* '()) (set! *gravity* 0.0) (set! *floor* #f))
(define (world/make)      (world/reset!) '*world*)
(define (world/gravity! g) (set! *gravity* g))
(define (world/floor! y)   (set! *floor* y))

(define (world/spawn tag x y)
  (let ((e (vector tag (vec/make x y) (vec/make 0 0) 1.0 1.0 tag)))
    (set! *world* (cons e *world*))
    e))
(define (entity/set-vel! e vx vy) (vector-set! e 2 (vec/make vx vy)))
(define (entity/set-pos! e x y)   (vector-set! e 1 (vec/make x y)))
(define (entity/vel e)  (vector-ref e 2))
(define (entity/pos e)  (vector-ref e 1))
(define (entity/x e)    (car  (vector-ref e 1)))
(define (entity/y e)    (cadr (vector-ref e 1)))
(define (entity/mass! e m)          (vector-set! e 3 m) e)
(define (entity/mass e)             (vector-ref e 3))
(define (entity/gravity-scale! e s) (vector-set! e 4 s) e)
(define (entity/sprite! e g)        (vector-set! e 5 g) e)
(define (entity/sprite e)           (vector-ref e 5))

(define (world/step dt)
  (for-each
   (lambda (e)
     (let* ((g  (* *gravity* (vector-ref e 4)))
            (v  (vec/add (vector-ref e 2) (vec/make 0 (* g dt))))
            (p  (vec/add (vector-ref e 1) (vec/scale v dt))))
       (vector-set! e 2 v)
       (when (and *floor* (> (cadr p) *floor*))
         (set! p (vec/make (car p) *floor*))
         (vector-set! e 2 (vec/make (car v) 0)))
       (vector-set! e 1 p)))
   *world*))

(define (world/each f)  (for-each f *world*))
(define (world/count)   (length *world*))
(define (entity/distance a b)
  (let ((pa (entity/pos a)) (pb (entity/pos b)))
    (sqrt (+ (expt (- (car pa) (car pb)) 2)
             (expt (- (cadr pa) (cadr pb)) 2)))))
(define (entity/overlaps? a b) (< (entity/distance a b) 0.5))
(define (entity/nearest e)
  (let loop ((xs *world*) (best #f) (bd 1e30))
    (cond ((null? xs) best)
          ((eq? (car xs) e) (loop (cdr xs) best bd))
          (else (let ((d (entity/distance e (car xs))))
                  (if (< d bd) (loop (cdr xs) (car xs) d)
                      (loop (cdr xs) best bd)))))))
(define (world/nearest e) (entity/nearest e))

;; easing — thin wrappers over the real easing library
(define (ease-in t)     (easing/apply 'ease-in t))
(define (ease-out t)    (easing/apply 'ease-out t))
(define (ease-in-out t) (easing/apply 'ease-in-out t))
