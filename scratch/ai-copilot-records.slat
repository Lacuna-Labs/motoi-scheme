
(verb
  :name "copilot/ask" :std "Motoi"
  :library "ai"
  :kind "io"
  :signature "(copilot/ask prompt . opts) -> string | #f"
  :summary "Ask the Motoi Copilot persona a language question; returns #f on the bare console with no model, like llm/ask."
  :explanation "Copilot/ask is llm/ask wrapped in the Motoi Copilot persona: a terse, warm coder that knows the verb registry and has no world knowledge outside the language. Before calling the model it scans your prompt for registered verb names and injects their docs/contracts as context, then appends an 'in scope:' hint. Same wire protocol as llm/ask, same soft degrade: with no model it returns #f — the persona and registry context are prepared, but there is no model to answer, so #f is honest."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (or (copilot/ask \"how do I get the first element of a list?\") \"offline: ask the reference instead\"))" :note "#f offline; the fallback prints. Runs green.")
    (:dialect "motoi" :tier "intermediate" :code "(define (ask-or q d) (or (copilot/ask q) d))\n(display (ask-or \"what is map?\" \"(offline) see copilot/what-is\"))" :note "Wrap with an offline default that points at the offline-safe copilot/what-is.")
    (:dialect "motoi" :tier "expert" :code "(define (ask* q) (or (copilot/ask q) (let ((w (copilot/what-is q))) (cadr (assq ':confidence w)))))\n(display (ask* \"car\"))" :note "Degrade from the model answer to copilot/what-is's offline registry confidence.")
  )
  :caveats ("Returns #f offline — test with (or ...); it is a boolean, not a string." "The persona has NO world knowledge outside the language — do not ask it general questions." "It injects registry context for verbs it spots in the prompt; unmentioned verbs get no context.")
  :drawbacks ("Synchronous; a real call blocks." "Offline it cannot answer at all — use copilot/what-is for offline facts." "Registry spotting is name-based; typo'd verb names get no context.")
  :usecases ("In-language coding help when a model is present." "Persona-scoped Q&A for a cart's help command." "Gate optional help behind (or ...) with an offline fallback to copilot/what-is.")
  :related ("llm/ask" "copilot/what-is" "copilot/explain" "llm/config")
  :learn (:concept "Copilot/ask is llm/ask + a persona + registry context; it #f-degrades, and its offline-safe sibling is copilot/what-is." :prerequisites ("or" "assq") :progression "Fall back to copilot/what-is offline; compare with copilot/explain which grounds on verb docs.")
  :row-2-audit (
    (:eng-program "(display (or (copilot/ask \"hi\") 'offline))"
     :math-program "(define (defined? v) (if v 1 0)) (display (defined? (copilot/ask \"hi\")))"
     :cs-program "(display (boolean? (copilot/ask \"hi\")))"
     :problem "A cart's help button printed the token #f into the chat pane on a model-less box. The fix is (or (copilot/ask q) (copilot/what-is-summary q)) so the offline path shows real registry facts instead of the sentinel."
     :explanation "eng: fallback replaces the #f sentinel with offline facts. math: 0/1 indicator for a help-availability metric. cs: the offline return is a boolean, confirmed."
     :meta "Wrong sibling: ai/generate would RAISE, aborting the help panel. copilot/ask is right for the soft #f-degrade; copilot/what-is is the offline-fact fallback.")
    (:eng "Symptom 'literal #f in help'. Fix: fall back to registry facts via copilot/what-is."
     :math "Answer-present is a Bernoulli indicator; offline 0."
     :cs "Sentinel-return degradation, eliminated by or."))
  :row-3-dimension (
    (:setup "answer-or-fall-back-to-facts: give a rich answer when a model exists, else the raw facts"
     :rungs (
       (:domain "motoi copilot" :code "(display (or (copilot/ask \"car\") 'facts))")
       (:domain "a cache with a source-of-truth fallback" :code "(define (get cache key src) (or (assq key cache) (src key))) (display (get (list) 'k (lambda (k) 'from-source)))")
       (:domain "a memo that recomputes on miss" :code "(define (memo hit compute) (or hit (compute))) (display (memo #f (lambda () 'computed)))"))
     :explanation "Each prefers a fast/rich source and falls back to a slower/plainer one on a miss. The shape is prefer-rich-else-plain."
     :meta "Portable shape: cache-with-fallback. Offline copilot/ask is the miss branch, and the facts are the fallback.")
    (:eng "Every enriched answer needs a plain-facts fallback."
     :math "A partial enrichment function extended by the identity facts."
     :cs "Cache-aside with a source-of-truth."))
  :row-4-proof (
    (:claim "Offline, copilot/ask is #f, so (or (copilot/ask q) d) = d for all q."
     :program "(define d 'facts) (display (and (eq? (or (copilot/ask \"a\") d) d) (eq? (or (copilot/ask \"b\") d) d)))"
     :invariant "∀ q. backend=none ⇒ copilot/ask(q) = #f ⇒ (or (copilot/ask q) d) = d"
     :meta "Left-identity of or with #f. Falsified by a truthy offline answer. See book-of-code ch05 (or algebra)."
     :eng-program "(display (eq? (or (copilot/ask \"q\") 'd) 'd))"
     :math-program "(define (left-id x) (eq? (or #f x) x)) (display (left-id 5))"
     :cs-program "(display (boolean? (copilot/ask \"r\")))")
    (:eng "Offline determinism you can test."
     :math "or is a monoid with #f as left identity."
     :cs "Short-circuit or absorbs #f."))
  :row-5-emergence (
    (:base "copilot/ask answers, or #f."
     :eng-composition "(define (help q) (or (copilot/ask q) (let ((w (copilot/what-is q))) (list 'facts (cadr (assq ':confidence w))))))\n(display (help \"car\"))"
     :emergent "a graceful help function: model answer online, registry facts offline."
     :meta "Progressive enhancement. See book-of-composition ch10 (enhancement tiers).")
    (:base "copilot/ask in a fallback chain."
     :math-composition "(define (first-of thunks) (cond ((null? thunks) 'none) (((car thunks)) => (lambda (r) r)) (else (first-of (cdr thunks)))))\n(display (first-of (list (lambda () (copilot/ask \"x\")) (lambda () \"static help\"))))"
     :emergent "a responder chain: copilot then a static string, first non-#f wins."
     :meta "Chain of responsibility. See book-of-composition ch12.")
    (:base "copilot/ask cached per prompt."
     :cs-composition "(define cache (list)) (define (ask* q) (let ((h (assoc q cache))) (if h (cdr h) (let ((r (or (copilot/ask q) 'offline))) (set! cache (cons (cons q r) cache)) r))))\n(display (ask* \"car\"))"
     :emergent "memoized help: each prompt answered at most once."
     :meta "Memoization. See book-of-composition ch08.")
    (:eng "Graceful help, responder chain, and memo cache shape a help surface."
     :math "Each folds over sources, absorbing #f."
     :cs "Progressive enhancement / chain-of-responsibility / memoization."))
)

(verb
  :name "copilot/explain" :std "Motoi"
  :library "ai"
  :kind "io"
  :signature "(copilot/explain form) -> string | #f"
  :summary "Explain a Scheme form in plain language, GROUNDED on the docs of any verbs it mentions; degrades offline to those collected docs (or #f when no known verb is present)."
  :explanation "Copilot/explain walks a form, collects the registered docs for every verb symbol it contains, and hands them to the model as grounding context — so the explanation cites the real registry, not a hallucination. Its degrade is smarter than #f: offline, if the form mentioned any KNOWN verbs, it returns 'No LLM configured; known docs:' followed by those docs — genuinely useful without a model. Only when NO known verb is present and there is no model does it return #f."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (copilot/explain '(car x)))" :note "Offline this returns the collected doc for car — 'No LLM configured; known docs: car: ...'. Runs green.")
    (:dialect "motoi" :tier "intermediate" :code "(display (or (copilot/explain '(+ 1 2)) \"no known verbs and no model\"))" :note "+ is a known verb, so the offline docs come back; the (or ...) fallback only fires for a totally unknown form.")
    (:dialect "motoi" :tier "expert" :code "(define (explain-safe form) (let ((r (copilot/explain form))) (if r r \"nothing known offline\")))\n(display (string? (explain-safe '(map f xs))))" :note "map is known, so a doc string comes back offline; explain-safe guarantees a string.")
  )
  :caveats ("Offline it returns collected DOCS when known verbs are present, and #f only when none are — it is NOT a plain #f-degrade." "It walks symbols in the FORM; pass a quoted form (or a symbol), not a bare string." "The grounding is only as good as the docs in the registry.")
  :drawbacks ("Synchronous when a model is present." "Offline it can only echo docs, not synthesize an explanation." "Unknown verbs contribute no grounding.")
  :usecases ("Explain a snippet with registry-grounded docs when a model is present." "Offline doc lookup for the verbs in a form." "Teaching surfaces that must stay honest about what they know.")
  :related ("copilot/ask" "copilot/what-is" "copilot/fix" "llm/config")
  :learn (:concept "Grounding on registry docs makes the degrade useful: offline you still get the real docs of the verbs in the form, not a blank." :prerequisites ("quote" "string?") :progression "Compare with copilot/what-is (single symbol) and copilot/ask (freeform).")
  :row-2-audit (
    (:eng-program "(display (string? (copilot/explain '(car x))))"
     :math-program "(define (has-docs? form) (if (copilot/explain form) 1 0)) (display (has-docs? '(car x)))"
     :cs-program "(display (string? (copilot/explain '(cdr y))))"
     :problem "A tutor panel showed nothing for '(car x)' on a model-less box because the author assumed copilot/explain always needs a model. In fact it returns the collected car docs offline; the fix is simply to render that string rather than gating the whole panel on a model."
     :explanation "eng: the offline return is already a useful doc string. math: 1 when known docs exist (they do for car). cs: confirm it is a string offline for a known verb."
     :meta "Wrong sibling: copilot/ask returns #f with no docs; copilot/explain grounds on the form's verbs and so gives more offline. Use explain when you have a FORM; ask for freeform questions.")
    (:eng "Symptom 'blank tutor panel'. Fix: render the offline doc string explain already returns."
     :math "Known-docs-present is an indicator; for known verbs it is 1 even offline."
     :cs "Degrade returns real data (a doc string), not just a sentinel."))
  :row-3-dimension (
    (:setup "explain-grounded: describe a thing using the real facts you have about its parts"
     :rungs (
       (:domain "motoi form" :code "(display (string? (copilot/explain '(car x))))")
       (:domain "a lookup-and-join of part docs" :code "(define docs (list (cons 'a \"first\") (cons 'b \"second\"))) (define (describe parts) (map (lambda (p) (cdr (assq p docs))) parts)) (display (describe (list 'a 'b)))")
       (:domain "assembling a definition from a glossary" :code "(define g (list (cons 'sum \"adds numbers\"))) (define (gloss k) (let ((h (assq k g))) (if h (cdr h) \"?\"))) (display (gloss 'sum))"))
     :explanation "Each explains a whole by gathering documented facts about its parts. The shape is compose-explanation-from-known-parts."
     :meta "Portable shape: grounded explanation. Offline copilot/explain composes from the registry docs it collected.")
    (:eng "A grounded explanation is only as strong as the facts about its parts."
     :math "A fold over the documented components."
     :cs "Join of per-symbol metadata into a description."))
  :row-4-proof (
    (:claim "For a form containing a known verb, copilot/explain returns a string offline (never #f)."
     :program "(display (and (string? (copilot/explain '(car x))) (string? (copilot/explain '(cdr y)))))"
     :invariant "∀ form. (form contains a known verb) ⇒ copilot/explain(form) is a string even when backend=none"
     :meta "The grounded degrade guarantees a string when any part is documented. Falsified if a known-verb form returned #f offline. See book-of-code ch11 (graceful degradation)."
     :eng-program "(display (string? (copilot/explain '(cons a b))))"
     :math-program "(define (has? form) (if (copilot/explain form) 1 0)) (display (has? '(car x)))"
     :cs-program "(display (string? (copilot/explain '(map f xs))))")
    (:eng "Known verbs guarantee an offline explanation string."
     :math "Presence of a documented part forces a non-#f result."
     :cs "Total on forms with at least one known symbol."))
  :row-5-emergence (
    (:base "copilot/explain grounds on form docs."
     :eng-composition "(define (explain-each forms) (map (lambda (f) (if (copilot/explain f) 'has-docs 'unknown)) forms))\n(display (explain-each (list '(car x) '(cons a b))))"
     :emergent "a batch explainer: map explain over forms = a doc-coverage view of a snippet."
     :meta "Same family as documentation coverage. See book-of-ml ch02 (coverage).")
    (:base "copilot/explain feeding a known-count."
     :math-composition "(define (known-count forms) (length (filter (lambda (f) (string? (copilot/explain f))) forms)))\n(display (known-count (list '(car x) '(cdr y))))"
     :emergent "a groundedness metric: how many forms explain cleanly from the registry."
     :meta "Counting grounded forms. See book-of-ml ch02.")
    (:base "copilot/explain behind a cache."
     :cs-composition "(define cache (list)) (define (explain* f) (let ((h (assoc f cache))) (if h (cdr h) (let ((r (copilot/explain f))) (set! cache (cons (cons f r) cache)) r))))\n(display (string? (explain* '(car x))))"
     :emergent "memoized explanations: each form explained once."
     :meta "Memoization. See book-of-composition ch08.")
    (:eng "Batch explainer, groundedness metric, and memo cache shape an explanation surface."
     :math "Map / filter-count / fixpoint over grounded explanations."
     :cs "Coverage view / metric / memoization."))
)

(verb
  :name "copilot/fix" :std "Motoi"
  :library "ai"
  :kind "io"
  :signature "(copilot/fix error-or-form) -> form | #f"
  :summary "Suggest a corrected S-expression for a broken form or error; returns #f on the bare console with no model."
  :explanation "Copilot/fix takes broken code or an error (or, with no argument, the last error) and asks the model for ONLY the corrected S-expression — no prose. It returns the repaired form, or #f when there is no model to consult. Because a wrong 'fix' could be worse than none, the degrade is a hard #f offline: it never guesses a repair without a model."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (or (copilot/fix \"(cxr 1)\") \"offline: no fix suggested\"))" :note "#f offline; the fallback prints. Runs green.")
    (:dialect "motoi" :tier "intermediate" :code "(define (fix-or broken d) (or (copilot/fix broken) d))\n(display (fix-or \"(car)\" '(car (list 1 2)) ))" :note "Supply your own known-good default when no model is present.")
    (:dialect "motoi" :tier "expert" :code "(define (try-fix broken) (let ((f (copilot/fix broken))) (if f (list 'suggested f) 'no-suggestion)))\n(display (try-fix \"(+ 1 'a)\"))" :note "Branch on the #f return to distinguish 'suggested from 'no-suggestion offline.")
  )
  :caveats ("Returns #f offline — test with (or ...); never treat #f as a repaired form." "It returns ONLY the corrected S-expression when wired, not an explanation." "Called with no argument it uses the last error; be sure one occurred.")
  :drawbacks ("Synchronous when a model is present." "Offline it cannot suggest anything — #f, by design." "A model's fix is a suggestion, not a guarantee; review it.")
  :usecases ("Auto-suggest a repair for a failing form when a model is present." "'Did you mean' style fixes in an editor." "Gate the suggestion behind (or ...) with a known-good default.")
  :related ("copilot/explain" "copilot/pretty-error" "copilot/complete" "llm/config")
  :learn (:concept "A repair suggestion is only offered with a model; offline it hard-#f-degrades rather than risk a wrong fix." :prerequisites ("or" "if") :progression "Pair with copilot/pretty-error (explain the error) and copilot/complete (fill holes).")
  :row-2-audit (
    (:eng-program "(display (or (copilot/fix \"(car)\") 'no-fix))"
     :math-program "(define (offered? v) (if v 1 0)) (display (offered? (copilot/fix \"(car)\")))"
     :cs-program "(display (boolean? (copilot/fix \"(car)\")))"
     :problem "An auto-repair feature applied #f as if it were a corrected form, replacing user code with the token #f on a model-less box. The fix is to branch on the return: only apply a fix when copilot/fix returns a truthy form."
     :explanation "eng: guard application behind a truthiness check. math: 0/1 whether a fix was offered (offline 0). cs: confirm the offline return is a boolean."
     :meta "Wrong sibling: ai/generate RAISES; copilot/fix #f-degrades. For repairs you want the soft #f so a missing model is a no-op, not a crash.")
    (:eng "Symptom 'user code replaced with #f'. Fix: only apply a truthy suggestion."
     :math "Fix-offered is a Bernoulli indicator; offline 0."
     :cs "Sentinel-return; never apply the sentinel."))
  :row-3-dimension (
    (:setup "suggest-or-decline: propose a correction, or decline when unsure"
     :rungs (
       (:domain "motoi copilot" :code "(display (or (copilot/fix \"(car)\") 'decline))")
       (:domain "a spell-corrector with a threshold" :code "(define (correct w known) (if (member w known) w 'no-suggestion)) (display (correct \"cet\" (list \"cat\" \"cot\")))")
       (:domain "a validator that only flags" :code "(define (check n) (if (> n 0) n 'invalid)) (display (check -3))"))
     :explanation "Each proposes a fix when confident and declines otherwise, never forcing a bad correction. The shape is suggest-or-decline."
     :meta "Portable shape: optional correction with an explicit decline. Offline copilot/fix always declines (#f).")
    (:eng "A corrector must be allowed to decline rather than force a wrong fix."
     :math "A partial repair function; declining is the off-domain value."
     :cs "Optional-return correction."))
  :row-4-proof (
    (:claim "Offline, copilot/fix is #f, so a guarded apply never changes the input."
     :program "(define (apply-fix broken) (let ((f (copilot/fix broken))) (if f f broken))) (display (equal? (apply-fix \"(car)\") \"(car)\"))"
     :invariant "∀ broken. backend=none ⇒ copilot/fix(broken) = #f ⇒ apply-fix(broken) = broken"
     :meta "No model = no change (identity). Falsified by a truthy offline fix. See book-of-code ch11 (safe no-op)."
     :eng-program "(display (eq? (or (copilot/fix \"(car)\") 'same) 'same))"
     :math-program "(define (left-id x) (eq? (or #f x) x)) (display (left-id 9))"
     :cs-program "(display (boolean? (copilot/fix \"(car)\")))")
    (:eng "Offline apply is a safe identity."
     :math "or with #f is left-identity; guarded apply is the identity."
     :cs "Sentinel forces the no-op branch."))
  :row-5-emergence (
    (:base "copilot/fix suggests a repair or #f."
     :eng-composition "(define (fix-or-keep broken) (let ((f (copilot/fix broken))) (if f f broken)))\n(display (fix-or-keep \"(car)\"))"
     :emergent "a safe auto-fixer: apply a suggestion when offered, keep the original otherwise."
     :meta "Same family as an optimistic-update-with-rollback. See book-of-composition ch11 (safe apply).")
    (:base "copilot/fix over a batch."
     :math-composition "(define (fixable forms) (length (filter (lambda (f) (copilot/fix f)) forms)))\n(display (fixable (list \"(car)\" \"(cdr)\")))"
     :emergent "a repairability meter: how many forms got a suggestion (offline, zero)."
     :meta "Counting suggestions. See book-of-ml ch02.")
    (:base "copilot/fix then pretty-error."
     :cs-composition "(define (diagnose broken) (or (copilot/fix broken) (copilot/pretty-error broken)))\n(display (string? (diagnose \"unbound: foo\")))"
     :emergent "a diagnosis ladder: try a fix, else at least a readable error (pretty-error works offline)."
     :meta "Degradation ladder. See book-of-composition ch10.")
    (:eng "Safe auto-fixer, repairability meter, and diagnosis ladder shape a repair surface."
     :math "Identity-on-miss / counting / fallback chain."
     :cs "Safe apply / metric / degradation ladder."))
)

(verb
  :name "copilot/complete" :std "Motoi"
  :library "ai"
  :kind "io"
  :signature "(copilot/complete partial) -> form | #f"
  :summary "Fill #!hole placeholders (or continue a partial form) via the model; returns #f on the bare console with no model."
  :explanation "Copilot/complete fills #!hole placeholders in a Scheme form, returning ONLY the completed S-expression. With no #!hole it behaves like llm/complete on the form's text. Either way it returns #f when there is no model — it never fabricates a completion offline. Use it for hole-driven scaffolding where you mark the gaps and let the model fill them, with a #f-safe fallback."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (or (copilot/complete '(define (square x) #!hole)) \"offline: no completion\"))" :note "#f offline; the fallback prints. Runs green.")
    (:dialect "motoi" :tier "intermediate" :code "(define (complete-or partial d) (or (copilot/complete partial) d))\n(display (complete-or '(+ 1 #!hole) '(+ 1 2)))" :note "Provide a known-good default form for the offline case.")
    (:dialect "motoi" :tier "expert" :code "(define (fill-all partials d) (map (lambda (p) (or (copilot/complete p) d)) partials))\n(display (fill-all (list '(a #!hole) '(b #!hole)) 'offline))" :note "Batch hole-filling with a per-item fallback; offline every slot is the fallback.")
  )
  :caveats ("Returns #f offline — test with (or ...); it is a boolean, not a form." "Mark gaps with the #!hole placeholder; without one it behaves like llm/complete." "It returns only the filled S-expression when wired, no prose.")
  :drawbacks ("Synchronous when a model is present." "Offline it cannot fill holes — #f, by design." "The fill is the model's; validate before use.")
  :usecases ("Hole-driven code scaffolding when a model is present." "Template completion where gaps are marked." "Gate completion behind (or ...) with a default form.")
  :related ("llm/complete" "copilot/fix" "copilot/scaffold" "llm/config")
  :learn (:concept "Hole-filling is a completion convention over marked gaps; it #f-degrades like llm/complete." :prerequisites ("or" "map" "quote") :progression "Compare with llm/complete (text) and copilot/scaffold (writes a stub file).")
  :row-2-audit (
    (:eng-program "(display (or (copilot/complete '(a #!hole)) 'offline))"
     :math-program "(define (filled? v) (if v 1 0)) (display (filled? (copilot/complete '(a #!hole))))"
     :cs-program "(display (boolean? (copilot/complete '(a #!hole))))"
     :problem "A snippet generator inserted the literal #f where a hole should have been filled, on a model-less box. The fix is (or (copilot/complete p) default-form) so the offline case yields a valid default form, not the sentinel."
     :explanation "eng: fallback supplies a valid default form. math: 0/1 whether a fill occurred (offline 0). cs: confirm the offline return is a boolean."
     :meta "Wrong sibling: copilot/scaffold WRITES a stub file and works offline; copilot/complete fills in-memory and #f-degrades. Use scaffold when you want a file, complete when you want a form.")
    (:eng "Symptom 'literal #f in generated code'. Fix: default form via or."
     :math "Fill-present is a Bernoulli indicator; offline 0."
     :cs "Sentinel-return degradation, eliminated by or."))
  :row-3-dimension (
    (:setup "fill-or-default: complete a template's gaps, or use a default when the filler is absent"
     :rungs (
       (:domain "motoi copilot" :code "(display (or (copilot/complete '(a #!hole)) 'default))")
       (:domain "a template with placeholders" :code "(define (fill t v) (map (lambda (x) (if (eq? x '_) v x)) t)) (display (fill (list 'a '_ 'c) 'b))")
       (:domain "a form with a default arg" :code "(define (greet name) (string-append \"hi \" name)) (display (greet \"world\"))"))
     :explanation "Each fills a gap from a source, defaulting when the source is unavailable. The shape is template-fill-with-default."
     :meta "Portable shape: gap-filling. Offline copilot/complete takes the default branch.")
    (:eng "Every templating step needs a default for the unfilled case."
     :math "A partial fill function extended by a constant."
     :cs "Placeholder substitution with a fallback."))
  :row-4-proof (
    (:claim "Offline, copilot/complete is #f, so (or (copilot/complete p) d) = d for all p."
     :program "(define d '(x)) (display (and (eq? (or (copilot/complete '(a #!hole)) d) d) (eq? (or (copilot/complete '(b #!hole)) d) d)))"
     :invariant "∀ p. backend=none ⇒ copilot/complete(p) = #f ⇒ (or (copilot/complete p) d) = d"
     :meta "Left-identity of or with #f. Falsified by a truthy offline fill. See book-of-code ch05 (or algebra)."
     :eng-program "(display (eq? (or (copilot/complete '(a #!hole)) 'd) 'd))"
     :math-program "(define (left-id x) (eq? (or #f x) x)) (display (left-id 3))"
     :cs-program "(display (boolean? (copilot/complete '(a #!hole))))")
    (:eng "Offline determinism you can test."
     :math "or is a monoid with #f as left identity."
     :cs "Short-circuit or absorbs #f."))
  :row-5-emergence (
    (:base "copilot/complete fills holes or #f."
     :eng-composition "(define (scaffold-form template) (or (copilot/complete template) (list 'stub template)))\n(display (scaffold-form '(define f #!hole)))"
     :emergent "a form scaffolder: fill when a model exists, wrap as a stub otherwise."
     :meta "Same family as template instantiation. See book-of-composition ch09 (templates).")
    (:base "copilot/complete in a fallback chain."
     :math-composition "(define (first-of thunks) (cond ((null? thunks) 'none) (((car thunks)) => (lambda (r) r)) (else (first-of (cdr thunks)))))\n(display (first-of (list (lambda () (copilot/complete '(a #!hole))) (lambda () '(a 0)))))"
     :emergent "a filler chain: model then a static form, first non-#f wins."
     :meta "Chain of responsibility. See book-of-composition ch12.")
    (:base "copilot/complete cached per template."
     :cs-composition "(define cache (list)) (define (complete* p) (let ((h (assoc p cache))) (if h (cdr h) (let ((r (or (copilot/complete p) 'offline))) (set! cache (cons (cons p r) cache)) r))))\n(display (complete* '(a #!hole)))"
     :emergent "memoized completion: each template filled once."
     :meta "Memoization. See book-of-composition ch08.")
    (:eng "Form scaffolder, filler chain, and memo cache shape a completion surface."
     :math "Template fill / fold / fixpoint over the completer."
     :cs "Template instantiation / chain-of-responsibility / memoization."))
)

(verb
  :name "copilot/scaffold" :std "Motoi"
  :library "ai"
  :kind "state-change"
  :signature "(copilot/scaffold kind . opts) -> path | #f"
  :summary "Write a stub file for a verb/cart/test/module/chapter/appendix and return its absolute path; WORKS OFFLINE — no model needed."
  :explanation "Copilot/scaffold writes a small starter file to disk and returns its absolute path. Unlike the rest of copilot/*, it needs NO model — it emits a deterministic template chosen by :kind (verb, cart, test, module, chapter, appendix, or a generic scaffold). Options: :name, :purpose, :dir. Files land under scratch/scaffold/ by default; a caller-supplied :dir is sandboxed to the cwd or ~/.motoi/ ~/motoi/, falling back to the default if it escapes. It is the only write-verb in this tier, so its perm is state-change."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (string? (copilot/scaffold \"verb\" :name \"my-verb\")))" :note "Writes a verb stub and returns its path (a string) — works offline. Runs green.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((path (copilot/scaffold \"cart\" :name \"hello\" :purpose \"say hi\")))\n  (display (string? path)))" :note "A cart stub with a purpose; the return is the absolute path.")
    (:dialect "motoi" :tier "expert" :code "(define (scaffold-many kinds)\n  (map (lambda (k) (string? (copilot/scaffold k :name (string-append k \"-demo\")))) kinds))\n(display (scaffold-many (list \"verb\" \"test\" \"module\")))" :note "Scaffold several kinds; each returns a path, so each check is #t.")
  )
  :caveats ("WORKS OFFLINE — it is template-driven, not model-driven; do not gate it on a model." "It WRITES a file (perm state-change) — the only writer in this tier." ":dir is sandboxed to cwd / ~/.motoi/ / ~/motoi/; an out-of-sandbox :dir falls back to scratch/scaffold/." "Returns #f only on a filesystem write failure, not on a missing model.")
  :drawbacks ("It touches the filesystem — side-effecting, unlike the read-only copilot/* verbs." "The stub is a minimal template, not a finished artifact." ":name is sanitized for filenames; odd characters become underscores.")
  :usecases ("Bootstrap a new verb/cart/test/module/chapter/appendix file." "Generate consistent starter files offline." "Batch-create scaffolds for a project skeleton.")
  :related ("copilot/complete" "copilot/fix" "copilot/ask" "llm/config")
  :learn (:concept "Not all copilot verbs need a model: scaffold is deterministic template emission and so runs fully offline, at the cost of a filesystem write." :prerequisites ("string?" "map" "string-append") :progression "Contrast with copilot/complete (in-memory, model-driven, #f-degrades).")
  :row-2-audit (
    (:eng-program "(display (string? (copilot/scaffold \"verb\" :name \"a\")))"
     :math-program "(define (wrote? kind) (if (copilot/scaffold kind :name \"m\") 1 0)) (display (wrote? \"cart\"))"
     :cs-program "(display (string? (copilot/scaffold \"module\" :name \"b\")))"
     :problem "A project bootstrapper skipped scaffolding on a model-less CI runner because the author assumed all copilot/* verbs need a model. In fact scaffold is offline-safe; the fix removes the model gate so stub files are created in CI as intended."
     :explanation "eng: scaffold returns a real path with no model. math: 1 whenever the write succeeds (offline it does). cs: confirm the offline return is a string (the path)."
     :meta "Wrong sibling: copilot/complete is in-memory and #f-degrades; scaffold writes a file offline. Use scaffold to create files, complete to fill forms.")
    (:eng "Symptom 'no stub files in CI'. Fix: drop the model gate — scaffold is offline-safe."
     :math "Write-success is an indicator; offline it is 1."
     :cs "Returns a path (string), not a sentinel, offline."))
  :row-3-dimension (
    (:setup "emit-from-template: produce an artifact deterministically from a kind + name"
     :rungs (
       (:domain "motoi scaffold" :code "(display (string? (copilot/scaffold \"verb\" :name \"x\")))")
       (:domain "a string template" :code "(define (stub name) (string-append \"(verb :name \" name \")\")) (display (stub \"foo\"))")
       (:domain "a constant factory" :code "(define (make-pair a b) (cons a b)) (display (make-pair 1 2))"))
     :explanation "Each produces a structured artifact from parameters, deterministically. The shape is parameterized construction."
     :meta "Portable shape: a factory / template emitter. Scaffold is the file-writing instance.")
    (:eng "Deterministic emitters need no external service and always succeed given valid inputs."
     :math "A total function from parameters to an artifact."
     :cs "Factory pattern; template method."))
  :row-4-proof (
    (:claim "copilot/scaffold returns a string path offline for every supported kind."
     :program "(display (and (string? (copilot/scaffold \"verb\" :name \"a\")) (string? (copilot/scaffold \"cart\" :name \"b\")) (string? (copilot/scaffold \"test\" :name \"c\"))))"
     :invariant "∀ kind ∈ {verb,cart,test,module,chapter,appendix,…}. write succeeds ⇒ copilot/scaffold(kind) is a string path, no model required"
     :meta "Deterministic, offline totality (barring a filesystem failure). Falsified only by a write error. See book-of-code ch14 (deterministic emitters)."
     :eng-program "(display (string? (copilot/scaffold \"module\" :name \"m\")))"
     :math-program "(define (n kind) (if (string? (copilot/scaffold kind :name \"m\")) 1 0)) (display (n \"chapter\"))"
     :cs-program "(display (string? (copilot/scaffold \"appendix\" :name \"z\")))")
    (:eng "Every supported kind yields a path offline."
     :math "A total function into the set of paths."
     :cs "No model dependency; deterministic output."))
  :row-5-emergence (
    (:base "copilot/scaffold writes one stub."
     :eng-composition "(define (skeleton names) (map (lambda (n) (string? (copilot/scaffold \"verb\" :name n))) names))\n(display (skeleton (list \"a\" \"b\")))"
     :emergent "a project skeleton: map scaffold over names = a set of starter files."
     :meta "Same family as project bootstrapping. See book-of-composition ch14 (bootstrappers).")
    (:base "copilot/scaffold feeding a count."
     :math-composition "(define (made kinds) (length (filter string? (map (lambda (k) (copilot/scaffold k :name \"m\")) kinds))))\n(display (made (list \"verb\" \"cart\")))"
     :emergent "a creation tally: how many files were successfully written."
     :meta "Counting successes. See book-of-ml ch02.")
    (:base "copilot/scaffold then complete."
     :cs-composition "(define (scaffold-and-note kind) (let ((p (copilot/scaffold kind :name \"n\"))) (if p (list 'wrote (string? p)) 'failed)))\n(display (scaffold-and-note \"verb\"))"
     :emergent "a create-then-report step: write the stub, report the outcome — the base of a generator pipeline."
     :meta "Pipeline stage with reporting. See book-of-composition ch11.")
    (:eng "Project skeleton, creation tally, and create-then-report shape a scaffolding surface."
     :math "Map / count / staged construction."
     :cs "Bootstrapper / success counting / pipeline stage."))
)

(verb
  :name "copilot/pretty-error" :std "Motoi"
  :library "ai"
  :kind "io"
  :signature "(copilot/pretty-error error) -> string"
  :summary "Rewrite a cryptic error into a clear, beginner-actionable paragraph; degrades OFFLINE to a hand-shaped fallback (the :message field or the error text) — always returns a string."
  :explanation "Copilot/pretty-error asks the model to rewrite an error in one clear paragraph a beginner can act on. Its degrade is graceful and ALWAYS returns a string: offline, it extracts the :message field from an error alist if present, else the error's message property, else the error rendered as text. So a surface can rely on getting SOMETHING readable with or without a model — it never returns #f."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(display (copilot/pretty-error \"unbound: foo\"))" :note "Offline this returns the text itself (a string) — never #f. Runs green.")
    (:dialect "motoi" :tier "intermediate" :code "(display (copilot/pretty-error (list (list ':message \"list is empty\"))))" :note "Offline it extracts the :message field: 'list is empty'.")
    (:dialect "motoi" :tier "expert" :code "(define (explain-error e) (let ((p (copilot/pretty-error e))) (if (string? p) p \"(no message)\")))\n(display (string? (explain-error (list (list ':message \"boom\")))))" :note "pretty-error always returns a string, so the string? branch always holds.")
  )
  :caveats ("ALWAYS returns a string — offline it falls back to the :message field or the error text, never #f." "Pass an error alist (with a :message pair), an error object, or a string." "The offline fallback is the raw message, not a rewritten explanation.")
  :drawbacks ("Synchronous when a model is present." "Offline the 'pretty' version is just the raw message — no rewriting." "Only as clear as the underlying :message.")
  :usecases ("Turn a cryptic error into beginner-friendly prose when a model is present." "Always-safe error rendering for a UI, online or off." "Pair with copilot/fix to explain then repair.")
  :related ("copilot/fix" "copilot/explain" "copilot/rag" "llm/config")
  :learn (:concept "A total-string degrade: the verb guarantees a readable string with or without a model by extracting the message offline." :prerequisites ("string?" "list") :progression "Pair with copilot/fix (a repair, which #f-degrades) for a diagnose-and-fix flow.")
  :row-2-audit (
    (:eng-program "(display (string? (copilot/pretty-error \"unbound: foo\")))"
     :math-program "(define (readable? e) (if (string? (copilot/pretty-error e)) 1 0)) (display (readable? \"boom\"))"
     :cs-program "(display (string? (copilot/pretty-error (list (list ':message \"x\")))))"
     :problem "An error banner rendered '#f' on a model-less box because the author assumed pretty-error needs a model. It does not — it extracts the message offline; the fix is to render its string directly, always."
     :explanation "eng: pretty-error already returns a string offline. math: 1 always — it is total. cs: confirm the offline return is a string for both a raw string and a :message alist."
     :meta "Wrong sibling: copilot/fix #f-degrades (a repair may not exist). pretty-error always returns a string (there is always SOME message). Use pretty-error to render, fix to repair.")
    (:eng "Symptom '#f in the error banner'. Fix: render pretty-error's string — it is always a string."
     :math "Readable is total: always 1."
     :cs "Total-string return; no sentinel."))
  :row-3-dimension (
    (:setup "present-or-fallback-to-raw: render a nice message, or the raw one when the renderer is absent"
     :rungs (
       (:domain "motoi copilot" :code "(display (string? (copilot/pretty-error \"boom\")))")
       (:domain "a formatter with a raw fallback" :code "(define (fmt x) (if (number? x) (number->string x) \"?\")) (display (fmt 42))")
       (:domain "a message extractor" :code "(define (msg e) (let ((h (assq ':message e))) (if h (cadr h) \"unknown\"))) (display (msg (list (list ':message \"hi\"))))"))
     :explanation "Each renders a human-facing string, degrading to a raw value when the nice renderer is unavailable. The shape is present-or-raw."
     :meta "Portable shape: presentation with a raw fallback. Offline pretty-error is the raw-message case.")
    (:eng "A presenter must always return SOMETHING renderable, even raw."
     :math "A total function into strings."
     :cs "Formatter with a guaranteed fallback."))
  :row-4-proof (
    (:claim "copilot/pretty-error always returns a string, online or offline."
     :program "(display (and (string? (copilot/pretty-error \"a\")) (string? (copilot/pretty-error (list (list ':message \"b\"))))))"
     :invariant "∀ error. copilot/pretty-error(error) is a string (never #f), regardless of backend"
     :meta "Totality via the message-extraction fallback. Falsified by any #f return. See book-of-code ch11 (total presenters)."
     :eng-program "(display (string? (copilot/pretty-error \"x\")))"
     :math-program "(define (n e) (if (string? (copilot/pretty-error e)) 1 0)) (display (n \"y\"))"
     :cs-program "(display (string? (copilot/pretty-error (list (list ':message \"z\")))))")
    (:eng "Always a string — safe to render unconditionally."
     :math "A total function into the string type."
     :cs "No #f branch to handle."))
  :row-5-emergence (
    (:base "copilot/pretty-error renders one error."
     :eng-composition "(define (render-all errs) (map copilot/pretty-error errs))\n(display (render-all (list \"a\" (list (list ':message \"b\")))))"
     :emergent "an error log renderer: map pretty-error over errors = a list of readable strings, always."
     :meta "Same family as a log formatter. See book-of-composition ch10 (renderers).")
    (:base "copilot/pretty-error feeding a length check."
     :math-composition "(define (all-strings? errs) (= (length errs) (length (filter string? (map copilot/pretty-error errs)))))\n(display (all-strings? (list \"a\" (list (list ':message \"b\")))))"
     :emergent "a totality check: every error renders to a string (always true)."
     :meta "Postcondition verification. See book-of-code ch09.")
    (:base "copilot/pretty-error then fix."
     :cs-composition "(define (diagnose e) (list (copilot/pretty-error e) (or (copilot/fix e) 'no-fix)))\n(display (diagnose \"unbound: foo\"))"
     :emergent "a diagnose-and-repair pair: a readable explanation plus a suggested fix (or 'no-fix offline)."
     :meta "Explain-then-repair. See book-of-composition ch11.")
    (:eng "Log renderer, totality check, and diagnose-and-repair shape an error surface."
     :math "Map / postcondition / pairing."
     :cs "Renderer / invariant check / explain-then-repair."))
)

(verb
  :name "copilot/rag" :std "Motoi"
  :library "ai"
  :kind "io"
  :signature "(copilot/rag question) -> record"
  :summary "Retrieval-augmented answer over the verb registry; returns a record ((:answer …) (:sources …)) whose :sources work OFFLINE (keyword search) even when :answer is #f."
  :explanation "Copilot/rag retrieves the most relevant verbs from the registry for a question — by embedding similarity when a sidecar is up, else by keyword substring match on verb docs/contracts — then hands the top matches plus the question to the model. It ALWAYS returns a record with :answer and :sources. Offline, :answer is #f (no model to synthesize) but :sources is a real, ranked list of registry matches — so the retrieval half works with no model at all. That split is the point: retrieval is offline-capable; generation needs a model."
  :examples (
    (:dialect "motoi" :tier "novice" :code "(let ((r (copilot/rag \"how do I get the first element of a list\")))\n  (display (list? (cadr (assq ':sources r)))))" :note "Offline :sources is a real list of registry matches (keyword search). Runs green.")
    (:dialect "motoi" :tier "intermediate" :code "(let ((r (copilot/rag \"car list\")))\n  (display (or (cadr (assq ':answer r)) 'no-model-answer)))" :note ":answer is #f offline; the fallback symbol prints while :sources still holds matches.")
    (:dialect "motoi" :tier "expert" :code "(define (rag-sources q) (cadr (assq ':sources (copilot/rag q))))\n(display (> (length (rag-sources \"car list append\")) 0))" :note "The retrieval half is usable offline: pull :sources and count the registry hits.")
  )
  :caveats ("ALWAYS returns a record; offline :answer is #f but :sources is a real ranked list — read :sources for the offline-usable half." "Retrieval is keyword-based offline, embedding-based when a sidecar is up." "Sources are registry entries (name/doc/contract/score), not documents from a file store.")
  :drawbacks ("The generative :answer needs a model; offline it is #f." "Keyword retrieval is coarser than embedding retrieval." "Only searches the verb registry, not arbitrary corpora.")
  :usecases ("Ground a help answer in real registry verbs when a model is present." "Offline verb discovery via :sources keyword search." "Show 'related verbs' for a question with no model.")
  :related ("copilot/what-is" "copilot/ask" "ai/vector-search" "llm/config")
  :learn (:concept "RAG splits into retrieval (offline-capable) and generation (needs a model): :sources is always real, :answer is #f offline." :prerequisites ("assq" "cadr" "list?" "length") :progression "Compare offline keyword :sources with ai/vector-search's embedding retrieval; pair with copilot/what-is.")
  :row-2-audit (
    (:eng-program "(let ((r (copilot/rag \"car list\"))) (display (list? (cadr (assq ':sources r)))))"
     :math-program "(let ((r (copilot/rag \"car list\"))) (display (if (> (length (cadr (assq ':sources r))) 0) 1 0)))"
     :cs-program "(let ((r (copilot/rag \"car list\"))) (display (eq? (cadr (assq ':answer r)) #f)))"
     :problem "A help widget showed 'no results' offline because it read :answer (which is #f) and ignored :sources (which held real matches). The fix reads :sources for the offline-usable retrieval half and only treats :answer as the model-dependent part."
     :explanation "eng: :sources is a real list offline. math: 1 when at least one source matched (it does for 'car list'). cs: confirm :answer is #f offline while :sources is populated."
     :meta "Wrong sibling: ai/vector-search RAISES with no sidecar; copilot/rag degrades to KEYWORD retrieval and still returns sources. Use rag for registry-grounded help that must work offline.")
    (:eng "Symptom 'no results offline'. Fix: read :sources, not just :answer."
     :math "Source-count > 0 is the retrieval indicator; offline it can still be 1."
     :cs "The record has two halves; :answer is model-bound, :sources is not."))
  :row-3-dimension (
    (:setup "retrieve-then-generate: fetch relevant context, then synthesize — where fetch works without the generator"
     :rungs (
       (:domain "motoi registry rag" :code "(display (list? (cadr (assq ':sources (copilot/rag \"car list\")))))")
       (:domain "a keyword search over a table" :code "(define docs (list (cons 'car \"first element\") (cons 'cdr \"rest\"))) (define (search w) (filter (lambda (p) (> (string-length (cdr p)) 0)) docs)) (display (length (search \"first\")))")
       (:domain "a lookup that returns matches" :code "(define (matches k table) (filter (lambda (p) (eq? (car p) k)) table)) (display (length (matches 'a (list (cons 'a 1) (cons 'b 2)))))"))
     :explanation "Each fetches relevant items from a store; synthesis is a separate, optional step. The shape is retrieve-then-(maybe)-generate."
     :meta "Portable shape: RAG = retrieval + generation, decoupled. Offline copilot/rag does retrieval only.")
    (:eng "Retrieval and generation are separable; retrieval should stand alone."
     :math "A filter/rank over a store, composed with an optional generator."
     :cs "Two-stage pipeline where stage one is model-free."))
  :row-4-proof (
    (:claim "Offline, copilot/rag returns a record with :answer #f and a list :sources."
     :program "(let ((r (copilot/rag \"car list\"))) (display (and (eq? (cadr (assq ':answer r)) #f) (list? (cadr (assq ':sources r))))))"
     :invariant "backend=none ⇒ copilot/rag(q) = ((:answer #f) (:sources L)) where L is a list"
     :meta "The retrieval half is model-independent; only :answer depends on the backend. Falsified if :answer were non-#f offline or :sources not a list. See book-of-ml ch05 (RAG decomposition)."
     :eng-program "(let ((r (copilot/rag \"append\"))) (display (list? (cadr (assq ':sources r)))))"
     :math-program "(let ((r (copilot/rag \"car list\"))) (display (>= (length (cadr (assq ':sources r))) 0)))"
     :cs-program "(let ((r (copilot/rag \"car\"))) (display (eq? (cadr (assq ':answer r)) #f)))")
    (:eng "Offline you always get a sources list and a #f answer."
     :math "Retrieval is a total function of the query and registry."
     :cs "Record shape is invariant; only :answer varies with the backend."))
  :row-5-emergence (
    (:base "copilot/rag retrieves sources + (maybe) an answer."
     :eng-composition "(define (related q) (map (lambda (s) (cadr (assq ':name s))) (cadr (assq ':sources (copilot/rag q)))))\n(display (list? (related \"car list\")))"
     :emergent "a 'related verbs' finder: pull the names out of :sources = a discovery tool, offline-safe."
     :meta "Same family as a related-items panel. See book-of-composition ch10.")
    (:base "copilot/rag feeding a coverage count."
     :math-composition "(define (hits q) (length (cadr (assq ':sources (copilot/rag q)))))\n(display (> (hits \"car list append\") 0))"
     :emergent "a retrieval-recall meter: how many registry verbs a question surfaces."
     :meta "Counting retrieved items. See book-of-ml ch02.")
    (:base "copilot/rag with a generation fallback."
     :cs-composition "(define (answer q) (let ((r (copilot/rag q))) (or (cadr (assq ':answer r)) (list 'sources-only (length (cadr (assq ':sources r)))))))\n(display (answer \"car list\"))"
     :emergent "a graceful RAG: the model answer online, a sources-only summary offline."
     :meta "Progressive enhancement over a two-stage pipeline. See book-of-composition ch10.")
    (:eng "Related-verbs finder, recall meter, and graceful RAG shape a retrieval surface."
     :math "Map / count / enhancement over the sources list."
     :cs "Discovery panel / recall counting / progressive enhancement."))
)
