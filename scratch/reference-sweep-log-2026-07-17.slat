(reference-sweep-log
  :run-at "2026-07-17"
  :agent "reference-sweeper"
  :scope "scheme/MOTOI-SCHEME-REFERENCE.slat"
  :directive "all of the reference manual, all of it is in reference to motoi. No references to anything to do with Sakura or remove it and replace it with something else."
  :backup "scheme/MOTOI-SCHEME-REFERENCE.slat.bak-2026-07-17-sakura-sweep"
  :grep-before 38
  :grep-after 0
  :verb-entries-kept 0
  :verb-entries-removed 0
  :test-suite "npm test — 383/383 pass"

  :change-summary "All 38 Sakura references removed. Prose lines were reworded to speak of 'consumer dialects' generically instead of naming Sakura. Example literals (color names like 'sakura-pink, palette names like 'sakura, cortex string values like \"sakura-dark\", sprite names like 'sakura, verb references like 'sakura/cloud-reason, anchor names like '#anchor/sakura-mouth) were replaced with Motoi-neutral equivalents. No verb entries were removed — every :name in the file was already Motoi-namespaced (no 'sakura/*' verb entries existed). No verb signatures were touched. Section-header comments referencing 'Sakura->Motoi mapping' were reworded to 'dialect->Motoi mapping'. The one relocated-library note (surface) was recast as 'a consumer dialect' without naming Sakura. Wiki-link callouts like [[feedback_sakura_action_glow]] and [[project_sakura_reply_dot_matrix]] and [[curator-canvas-is-sakuras-home]] were removed in favor of plain neutral prose."

  :sample-edits (
    (:location "line 1 (prologue dialect header)"
     :before "Dialect verbs (Sakura, Lacuna) are documented separately in their consumer repositories."
     :after "Dialect verbs are documented separately in their consumer repositories.")

    (:location "line 70 (:audience metadata)"
     :before ":audience (\"motoi-runtime-authors\" \"sakura-training\" \"kid-readers\" \"operator-scriptors\")"
     :after ":audience (\"motoi-runtime-authors\" \"motoi-copilot-training\" \"kid-readers\" \"operator-scriptors\")")

    (:location "paint-glow doc-body (~line 18312)"
     :before "Wired: yes. The canonical Sakura signature (8px sakura-magic\\nglow per [[feedback_sakura_action_glow]])."
     :after "Wired: yes. The canonical action-signal glow (8px halo) that\\nconsumers use to signal a paint act just fired.")

    (:location "paint-text doc-body (~line 18354)"
     :before "sakura's spoken-reply pattern — addressable dots, twinkle, motion\\n(paint-text reply\\n            '#anchor/sakura-mouth\\n            ':stroke-mode 'handwriting\\n            ':colour 'sakura-pink"
     :after "spoken-reply pattern — addressable dots, twinkle, motion\\n(paint-text reply\\n            '#anchor/speaker-mouth\\n            ':stroke-mode 'handwriting\\n            ':colour 'petal-pink")

    (:location "sprite verb, intermediate example (~line 5233)"
     :before "(sprite 'sakura (turn 90) (size 2))  -- Fetch 'sakura', rotate it 90 degrees..."
     :after "(sprite 'blossom (turn 90) (size 2))  -- Fetch 'blossom', rotate it 90 degrees...")

    (:location "cortex/read pref example (~line 5503)"
     :before "(pref \"theme\" \"sakura-dark\")"
     :after "(pref \"theme\" \"midnight\")")

    (:location "cortex/write novice example (~line 5527)"
     :before "(cortex/write \"favorite-color\" \"sakura-pink\")"
     :after "(cortex/write \"favorite-color\" \"petal-pink\")")

    (:location "unless intermediate example (~line 18119)"
     :before "(act 'sakura/cloud-reason (list ':context ctx) 'check-finding)"
     :after "(act 'cloud-reason (list ':context ctx) 'check-finding)")

    (:location "section header (~line 14871)"
     :before "; --- library: surface (RELOCATED to Sakura dialect, 2026-07-16) ---"
     :after "; --- library: surface (RELOCATED to a consumer dialect, 2026-07-16) ---")

    (:location "section header (~line 18400)"
     :before "; --- library: control (1 verb, added 2026-07-16 from Sakura->Motoi mapping) ---"
     :after "; --- library: control (1 verb, added 2026-07-16 from dialect->Motoi mapping) ---")
  )

  :substitution-vocabulary (
    (:from "'sakura-pink"        :to "'petal-pink"          :reason "color literal, kept a floral pink Motoi-neutral")
    (:from "'sakura"             :to "'garden or 'blossom"  :reason "palette/sprite name — depends on context")
    (:from "\"sakura-dark\""      :to "\"midnight\""          :reason "theme string value")
    (:from "\"sakura-pink\""      :to "\"petal-pink\""        :reason "color string value")
    (:from "\"sakura\""           :to "\"garden\""            :reason "theme string value")
    (:from "'#anchor/sakura-mouth" :to "'#anchor/speaker-mouth" :reason "anchor address")
    (:from "'sakura/cloud-reason" :to "'cloud-reason"         :reason "dropped dialect namespace prefix — verb docs live in consumer repo anyway")
    (:from "Sakura dialect"      :to "consumer dialect"     :reason "prose reword")
    (:from "Sakura, Lacuna"      :to "(removed enumeration; used 'consumer dialects')" :reason "prologue prose")
    (:from "Sakura-flavored"     :to "dialect-flavored"     :reason "prose reword")
    (:from "Sakura-specific"     :to "dialect-specific"     :reason "prose reword")
    (:from "Sakura Magic"        :to "canonical action-signal glow" :reason "descriptive rename")
    (:from "sakura's spoken-reply" :to "spoken-reply"       :reason "removed persona attribution")
    (:from "Sakura's home"       :to "(callout removed)"    :reason "wiki-link removed, plain prose kept")
    (:from "[[feedback_sakura_*]] [[project_sakura_*]] [[curator-canvas-is-sakuras-home]]" :to "(removed)" :reason "cross-repo wiki callouts")
    (:from "sakura-training"     :to "motoi-copilot-training" :reason "audience tag reference to Motoi Copilot per Alfred's spec")
  )

  :verb-entries-review (
    :note "Scanned all :name fields for sakura/* prefix — zero found. Every verb in this reference was already Motoi-namespaced. The Sakura language appeared only in prose, example literals, section-header comments, and cross-repo wiki callouts. NOTHING was deleted structurally — only rewritten."
  )

  :hard-rules-honored (
    "IN PLACE edit"
    "Verb signatures FROZEN (no :signature touched)"
    "No commits"
    "Backup taken before edits"
    "Post-sweep grep -i sakura = 0"
    "npm test — 383/383 pass"
  )

  :audit-note "The word 'blossom' remains in the reference as it is a plain English word for a flower and appears elsewhere in Motoi (sprite names, examples) — it is not a Sakura reference. Similarly 'petal' and 'garden' are neutral flower vocabulary. If Alfred wants those excised too, a further pass is trivial."
)
