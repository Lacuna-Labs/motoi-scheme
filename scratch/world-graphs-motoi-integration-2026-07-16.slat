;;; world-graphs-motoi-integration-2026-07-16.slat
;;; The Engineer — Motoi integration lane
;;; Task: Alfred: "add these world graphs to Motoi where necessary."

(dialect :applies ("motoi"))

(report
  :title "World-Graphs → Motoi Integration"
  :when  "2026-07-16"
  :agent "the-engineer"
  :directive "Alfred: add these world graphs to Motoi where necessary."
  :persona-filter "Motoi Copilot = coder-jokes persona, no world knowledge, no philosophy. Base = Qwen2.5-Coder-7B-Instruct.")

;;; ------------------------------------------------------------------
;;; FULL INVENTORY — 11 graph-of-* directories found under curator/objects/
;;; ------------------------------------------------------------------

(inventory
  :source-root "/Users/alfred/code/curator/objects/"
  :graphs
  ((:name "graph-of-art-movement"  :size-mb 1.7  :nodes-file "GRAPH-OF-ART-MOVEMENT-1.0.slat"
    :one-liner "Style-eras across artistic traditions — Art Deco, Impressionism, Bauhaus, Ukiyo-e, Baroque, Mid-Century Modern, Byzantine, Ming ceramics, Gutai, Négritude, Harajuku, Nordic Noir.")
   (:name "graph-of-brand"          :size-mb 5.6  :nodes-file "BRAND-OBJECTS-1.0.slat"
    :one-liner "Brand-identity-bearing names — luxury houses, marks, canonical members.")
   (:name "graph-of-cultural-work"  :size-mb 0.4  :nodes-file "GRAPH-OF-CULTURAL-WORK-1.0.slat"
    :one-liner "Named cultural works and artifacts.")
   (:name "graph-of-event"          :size-mb 1.8  :nodes-file "GRAPH-OF-EVENT-1.0.slat"
    :one-liner "Named episodes in time — what happened WHEN, WHO was there, WHERE, WHY it mattered (moon landing, treaties, elections).")
   (:name "graph-of-institution"    :size-mb 2.2  :nodes-file "GRAPH-OF-INSTITUTION-1.0.slat"
    :one-liner "Museums, libraries, universities, religions, governments, guilds, foundations, presses, NGOs.")
   (:name "graph-of-life"           :size-mb 1.5  :nodes-file "GRAPH-OF-LIFE-1.0.slat"
    :one-liner "What people ARE to one another (relations), FEEL (emotions), DO (actions/skills), REPEAT (rituals), LIVE AMONG (domestic objects), COMMUNICATE (cultural forms), life-arc stages.")
   (:name "graph-of-objects"        :size-mb 0    :nodes-file "(empty directory)"
    :one-liner "Empty placeholder — no content authored yet.")
   (:name "graph-of-person"         :size-mb 2.4  :nodes-file "GRAPH-OF-PERSON-1.0.slat"
    :one-liner "1,270 historical humans across 67 disciplines — philosophers, artists, writers, composers, scientists, statesmen, craft-tradition masters, spiritual teachers.")
   (:name "graph-of-science"        :size-mb 2.4  :nodes-file "GRAPH-OF-SCIENCE-1.0.slat"
    :one-liner "2,018 science nodes: physics laws/particles, chemistry elements/compounds, biology processes/cell-types/anatomy, math theorems/algorithms, CS 254 nodes (algorithms/data-structures/protocols/architectures), astronomy, earth-science, medicine.")
   (:name "graph-of-store"          :size-mb 25   :nodes-file "GRAPH-OF-STORE-1.0.slat"
    :one-liner "Product-nameable commerce categories — Curator/Sakura sales domain.")
   (:name "graph-of-world"          :size-mb 3.6  :nodes-file "GRAPH-OF-WORLD-1.0.slat"
    :one-liner "Physical/biological/geographical/natural things — body parts, animals, plants, weather, phenomena, places, seasons, times of day, vehicles, materials. Target ~30-50k nodes.")))

;;; ------------------------------------------------------------------
;;; CLASSIFICATION per Motoi Copilot persona filter
;;; ------------------------------------------------------------------

(classification
  :yes-motoi
  (((:graph "graph-of-science"
     :rationale
     "Motoi ships physics/chem/bio modules per spec. CS subdiscipline (254 nodes: algorithms, data-structures, protocols, architectures) is directly coder-domain. Math (167 nodes: theorems, equations, spaces) anchors verb naming and comedic-code idioms (fibonacci, sieve, hashmap). Kinds :algorithm 49, :data-structure 20, :protocol 21, :architecture 29 all first-class Motoi material. Discipline coverage lets Motoi make grounded science jokes without hallucinating."
     :action "COPIED to /Users/alfred/code/motoi-scheme/graphs/graph-of-science")))

  :no-stays-sakura
  (((:graph "graph-of-person"        :rationale "Historical humans = world knowledge. Motoi persona excludes world knowledge by spec.")
    (:graph "graph-of-institution"   :rationale "Museums, universities, religions, governments = world knowledge Sakura persona.")
    (:graph "graph-of-life"          :rationale "Interpersonal relations / emotions / rituals / domestic-objects = Sakura's persona/world domain. Motoi Copilot doesn't reason about how humans live together.")
    (:graph "graph-of-art-movement"  :rationale "Cultural/aesthetic knowledge = Sakura. Motoi coder-jokes persona has no aesthetic-theory reason to know Bauhaus vs Impressionism.")
    (:graph "graph-of-cultural-work" :rationale "Named cultural works = Sakura cultural knowledge.")
    (:graph "graph-of-event"         :rationale "Historical events (moon landing, treaties) = world knowledge. Excluded from Motoi persona.")
    (:graph "graph-of-brand"         :rationale "Brand identities = Curator commerce domain. Motoi has no commerce persona.")
    (:graph "graph-of-store"         :rationale "Product-nameable commerce categories = Curator/Sakura commerce. Motoi has no commerce persona.")
    (:graph "graph-of-objects"       :rationale "Empty directory (0 bytes, no content authored). Nothing to copy.")))

  :ambiguous-flagged-for-alfred
  (((:graph "graph-of-world"
     :size-mb 3.6
     :ambiguity
     "Prompt itself flags this ambiguous. Content = physical/biological/geographical/natural things (body parts, animals, plants, weather, places, seasons, materials, vehicles, food). A pure coder-jokes persona doesn't reason about oaks or fjords in normal operation. HOWEVER: (a) module/verb naming often pulls from world vocabulary (list-of-fruits, animal-name predicates in exercises); (b) code examples read better with world referents than abstract foos; (c) comedic-code idioms often use world nouns (make-fibonacci-rabbits, count-the-sheep); (d) science graph already cross-references world for taxa, so Motoi's science graph will have dangling refs into a graph Motoi doesn't hold. Argues either way."
     :recommendation "Await Alfred decision. If YES: cp -R same pattern as graph-of-science; also unblocks graph-of-science cross-refs to world/. If NO: strip world cross-refs from Motoi's graph-of-science CROSS-REFS.slat during ingestion."
     :action "NOT COPIED — held for Alfred"))))

;;; ------------------------------------------------------------------
;;; WHAT WAS COPIED
;;; ------------------------------------------------------------------

(actions-taken
  ((:action "mkdir"    :target "/Users/alfred/code/motoi-scheme/graphs/")
   (:action "cp -R"    :from "/Users/alfred/code/curator/objects/graph-of-science"
                       :to   "/Users/alfred/code/motoi-scheme/graphs/graph-of-science"
                       :size-mb 2.4
                       :files-copied 10
                       :includes ("README.slat" "MANIFEST.slat" "RULES.slat" "FACETS.slat"
                                  "GRAPH-OF-SCIENCE-1.0.slat" "CROSS-REFS.slat"
                                  "PROVENANCE.slat" "build.py" "seeds/" "_archive/"))
   (:action "write"    :target "/Users/alfred/code/motoi-scheme/graphs/MANIFEST.slat"
                       :purpose "collection-level manifest with provenance + not-copied dossier + flagged-for-alfred dossier"))
  :no-deletes-verified #t
  :curator-source-untouched #t)

;;; ------------------------------------------------------------------
;;; OPEN QUESTIONS FOR ALFRED
;;; ------------------------------------------------------------------

(questions-for-alfred
  ((:q1 "graph-of-world for Motoi — YES for example fodder / verb naming / cross-ref closure, or NO to keep Motoi world-knowledge-free?")
   (:q2 "graph-of-science currently declares :dialect \"sakura\" in its MANIFEST.slat. Do we (a) leave as-is and let Motoi read it dialect-agnostic, (b) fork Motoi's copy to :dialect \"motoi\", or (c) publish under :dialect :applies (\"motoi\" \"sakura\")? Currently left as-is per no-rewrite v1.0 ingestion.")
   (:q2b "If (b) or (c) — should Motoi's copy stay in sync with Curator's copy when Curator's regenerates, or fork permanently at this snapshot?")
   (:q3 "graph-of-science CROSS-REFS.slat references graph-of-person / graph-of-institution / graph-of-cultural-work / graph-of-event / graph-of-world / graph-of-store — all of which Motoi does NOT hold. Options: (a) leave dangling refs (loader must tolerate), (b) strip during ingestion pass, (c) leave and audit later. Currently (a) by inaction.")
   (:q4 "graph-of-objects is empty (0 bytes). Delete-tolerant to notice? Or just note it and move on? (Left alone per no-deletes.)")))

