(define (mex lst) (let loop ((m 0)) (if (member m lst) (loop (+ m 1)) m)))
(define gc (make-hash-table))
(define (grundy pos moves-fn)
  (or (hash-table-ref/default gc pos #f)
      (let ((g (mex (map (lambda (p) (grundy p moves-fn)) (moves-fn pos))))) (hash-table-set! gc pos g) g)))
(define (unequal-split-moves state)
  (apply append
    (map (lambda (i)
           (let ((n (list-ref state i)))
             (if (< n 3) '()
                 (map (lambda (a)
                        (let ((b (- n a)))
                          (append (take state i) (list a b) (drop state (+ i 1)))))
                      (range 1 (quotient (- n 1) 2))))))
         (range 0 (length state)))))
(display (unequal-split-moves '(7)))(newline)
(display (grundy '(7) unequal-split-moves))
