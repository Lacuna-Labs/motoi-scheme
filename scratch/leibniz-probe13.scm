(define Fc (lambda (x y) (list (- y) x)))
(display (list 'curl2d (calc/curl Fc (list 1 1)) 'truth 2)) (newline)
(display (list 'curl2d-b (calc/curl Fc (list 3 -4)) 'truth 2)) (newline)
(define F3 (lambda (x y z) (list 0 z (- y))))
(display (list 'curl3d (calc/curl F3 (list 0 0 0)) 'truth '(-2 0 0))) (newline)
(define (field-from-potential phi)
  (lambda (x y z) (list (phi x y z) (phi x y z) (phi x y z))))
(define phi (lambda (x y z) (+ (* x x) (* y y) (* z z))))
(define Fp (field-from-potential phi))
(display (list 'curl-pot (calc/curl Fp (list 1 1 1)) 'truth '(0 0 0))) (newline)
(define radial (lambda (x y z) (list x y z)))
(display (list 'div-radial (calc/divergence radial (list 1 2 3)) 'truth 3)) (newline)
(define Fs (lambda (x y z) (list (/ 1 (+ (abs x) 0.01)) y z)))
(display (list 'div-sing-at0 (calc/divergence Fs (list 0 1 1)))) (newline)
(display (list 'div-sing-at1 (calc/divergence Fs (list 1 1 1)))) (newline)
(display (list 'escalate-shape (calc/divergence radial))) (newline)
(define d (calc/divergence radial (list 1 2 3)))
(display (list 'is-pair (pair? d) 'is-number (number? d))) (newline)
