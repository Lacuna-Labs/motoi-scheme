(define p (make-parameter 10))
(display (p)) (newline)
(define q (make-parameter 5 (lambda (x) (* x 2))))
(display (q)) (newline)
(display (parameterize ((p 99)) (p))) (newline)
(display (p)) (newline)
(display (with-exception-handler (lambda (e) (error-object-type e)) (lambda () (error "boom")))) (newline)
(display (with-exception-handler (lambda (e) (error-object-type e)) (lambda () (escalate 'over-budget 5)))) (newline)
(display (with-exception-handler (lambda (e) (error-object-type e)) (lambda () (raise 'plain)))) (newline)
(display (last-error)) (newline)
(display (string? (get-environment-variable "MOTOI_DEMO_PLAIN"))) (newline)
(display (get-environment-variable "MOTOI_DEMO_PLAIN")) (newline)
(display (get-environment-variable "MOTOI_DEMO_TOKEN")) (newline)
(display (get-environment-variable "NO_SUCH_VAR_XYZ")) (newline)
(display (> (length (get-environment-variables)) 0)) (newline)
