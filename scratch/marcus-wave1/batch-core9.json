[
["cl-all", "(let loop ((xs (command-line))) (if (null? xs) 'all-strings (if (string? (car xs)) (loop (cdr xs)) 'not-all)))"],
["cl-exp", "(define (flag? name)\n  (let loop ((xs (command-line)))\n    (cond ((null? xs) #f)\n          ((string=? (car xs) name) #t)\n          (else (loop (cdr xs))))))\n(display (list (flag? \"--verbose\") (flag? \"run\")))\n(newline)"],
["cl-r2e", "(define (arg-count) (length (command-line)))\n(display (list 'positive (> (arg-count) 0)))\n(newline)"],
["cl-r2m", "(display (list 'list (list? (command-line)) 'strings (let loop ((xs (command-line))) (if (null? xs) #t (and (string? (car xs)) (loop (cdr xs)))))))\n(newline)"],
["cl-r2c", "(define (has? s) (if (member s (command-line)) #t #f))\n(display (list (has? \"run\") (has? \"--nope\")))\n(newline)"],
["cl-r3a", "(display (list? (command-line)))\n(newline)"],
["cl-r3b", "(display (if (null? (command-line)) 'no-context 'has-context))\n(newline)"],
["cl-r3c", "(display (list 'strings-only (let loop ((xs (command-line))) (if (null? xs) #t (and (string? (car xs)) (loop (cdr xs)))))))\n(newline)"],
["cl-r4e", "(display (list (list? (command-line)) (string? (car (command-line)))))\n(newline)"],
["cl-r4m", "(display (equal? (command-line) (command-line)))\n(newline)"],
["cl-r4c", "(display (list 'eq (eq? (command-line) (command-line)) 'equal (equal? (command-line) (command-line))))\n(newline)"],
["cl-r5e", "(define (option? s) (and (> (string-length s) 1) (char=? (string-ref s 0) #\\-)))\n(display (list (option? \"--verbose\") (option? \"run\")))\n(newline)"],
["cl-r5m", "(define (partition-args)\n  (let loop ((xs (command-line)) (opts '()) (rest '()))\n    (cond ((null? xs) (list (reverse opts) (reverse rest)))\n          ((and (> (string-length (car xs)) 0) (char=? (string-ref (car xs) 0) #\\-)) (loop (cdr xs) (cons (car xs) opts) rest))\n          (else (loop (cdr xs) opts (cons (car xs) rest))))))\n(display (length (car (partition-args))))\n(newline)"],
["cl-r5c", "(define (arg-at i default)\n  (let ((xs (command-line)))\n    (if (< i (length xs)) (list-ref xs i) default)))\n(display (list (string? (arg-at 0 'missing)) (arg-at 99 'missing)))\n(newline)"],
["f-r2e", "(define (supports? f) (if (memq f (features)) #t #f))\n(display (list (supports? 'ratios) (supports? 'threads)))\n(newline)"],
["f-r2m", "(display (list (length (features)) (length (map symbol->string (features)))))\n(newline)"],
["f-r2c", "(display (if (memq 'full-unicode (features)) 'unicode-path 'ascii-path))\n(newline)"],
["f-r3a", "(display (memq 'r7rs (features)))\n(newline)"],
["f-r3b", "(display (list 'declared (length (features))))\n(newline)"],
["f-r3c", "(display (sort (map symbol->string (features)) string<?))\n(newline)"],
["f-r4e", "(display (list (list? (features)) (length (features)) (memq 'no-such-feature (features))))\n(newline)"],
["f-r4m", "(display (list 'equal (equal? (features) (features)) 'eq (eq? (features) (features))))\n(newline)"],
["f-r4c", "(display (map symbol? (features)))\n(newline)"],
["f-r5e", "(define (need f) (if (memq f (features)) 'ok (list 'missing f)))\n(display (list (need 'exact-closed) (need 'posix)))\n(newline)"],
["f-r5m", "(define (feature-set) (map symbol->string (features)))\n(display (list 'has-r7rs (if (member \"r7rs\" (feature-set)) #t #f) 'size (length (feature-set))))\n(newline)"],
["f-r5c", "(define (pick-impl)\n  (cond ((memq 'ratios (features)) (lambda (a b) (/ a b)))\n        (else (lambda (a b) (quotient a b)))))\n(display ((pick-impl) 1 3))\n(newline)"]
]
