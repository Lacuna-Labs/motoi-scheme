[
["weh.novice", "(with-exception-handler (lambda (e) 'caught) (lambda () (error \"boom\")))"],
["weh.inter", "(with-exception-handler (lambda (e) (error-object-message e)) (lambda () (error \"disk full\")))"],
["weh.noraise", "(with-exception-handler (lambda (e) 'caught) (lambda () (* 6 7)))"],
["weh.expert", "(define (attempt thunk fallback)\n  (with-exception-handler (lambda (e) fallback) thunk))\n(display (list (attempt (lambda () (/ 10 2)) 'failed) (attempt (lambda () (error \"nope\")) 'failed)))\n(newline)"],
["weh.rethrow", "(with-exception-handler (lambda (outer) (list 'outer outer)) (lambda () (with-exception-handler (lambda (inner) (raise 'again)) (lambda () (raise 'first)))))"],
["eot.error", "(with-exception-handler (lambda (e) (error-object-type e)) (lambda () (error \"x\")))"],
["eot.escalate", "(with-exception-handler (lambda (e) (error-object-type e)) (lambda () (escalate 'over-budget 500)))"],
["eot.raise-sym", "(with-exception-handler (lambda (e) (error-object-type e)) (lambda () (raise 'my-signal)))"],
["eot.number", "(error-object-type 42)"],
["eot.expert", "(define (classify thunk)\n  (with-exception-handler (lambda (e) (list (error-object-type e) (error-object-irritants e))) thunk))\n(display (list (classify (lambda () (escalate 'out-of-fuel 3))) (classify (lambda () (error \"plain\" 7)))))\n(newline)"],
["fe.sym", "(file-error? 'anything)"],
["fe.err", "(with-exception-handler (lambda (e) (file-error? e)) (lambda () (error \"disk\")))"],
["fe.unbound", "(with-exception-handler (lambda (e) (list (file-error? e) (error-object-message e))) (lambda () (open-input-file \"/no/such/file\")))"],
["re.true", "(with-exception-handler (lambda (e) (read-error? e)) (lambda () (read (open-input-string \"(1 2\"))))"],
["re.false", "(with-exception-handler (lambda (e) (read-error? e)) (lambda () (error \"not a read problem\")))"],
["re.sym", "(read-error? 'anything)"],
["re.msg", "(with-exception-handler (lambda (e) (error-object-message e)) (lambda () (read (open-input-string \"(1 2\"))))"],
["le.bare", "(last-error)"],
["le.null", "(null? (last-error))"],
["le.inspect", "(inspect (last-error))"],
["le.after", "(begin (with-exception-handler (lambda (e) 'caught) (lambda () (error \"boom\"))) (inspect (last-error)))"],
["le.string?", "(string? (last-error))"]
]
