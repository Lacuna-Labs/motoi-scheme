[
["le.types", "(list (null? (last-error)) (pair? (last-error)) (list? (last-error)) (string? (last-error)) (boolean? (last-error)) (symbol? (last-error)))"],
["le.eqempty", "(equal? (last-error) '())"],
["le.eqself", "(eq? (last-error) (last-error))"],
["le.inspect", "(inspect (last-error))"],
["le.len", "(with-exception-handler (lambda (e) (list 'raised (error-object-message e))) (lambda () (length (last-error))))"],
["le.display", "(begin (display \"[\") (display (last-error)) (display \"]\") (newline))"],
["le.after-caught", "(begin (with-exception-handler (lambda (e) 'c) (lambda () (error \"boom\"))) (inspect (last-error)))"]
]
