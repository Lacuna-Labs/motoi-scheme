[
["eot.r2.eng", "(define (route thunk)\n  (with-exception-handler (lambda (e) (list 'kind (error-object-type e) 'why (error-object-message e))) thunk))\n(display (list (route (lambda () (escalate 'out-of-fuel 3))) (route (lambda () (error \"bad tile\" 9)))))\n(newline)"],
["eot.r2.math", "(display (with-exception-handler (lambda (e) (eq? (error-object-type e) 'outside-domain)) (lambda () (escalate 'outside-domain -1))))\n(newline)"],
["eot.r2.cs", "(define (tag-of thunk) (with-exception-handler (lambda (e) (error-object-type e)) thunk))\n(display (list (tag-of (lambda () (escalate 'timeout))) (tag-of (lambda () (car '())))))\n(newline)"],
["eot.r3.a", "(with-exception-handler (lambda (e) (error-object-type e)) (lambda () (escalate 'over-budget 500)))"],
["eot.r3.b", "(display (with-exception-handler (lambda (e) (error-object-type e)) (lambda () (escalate 'divide-by-zero))))\n(newline)"],
["eot.r3.c", "(display (with-exception-handler (lambda (e) (symbol? (error-object-type e))) (lambda () (error \"anything\"))))\n(newline)"],
["eot.r4.eng", "(display (with-exception-handler (lambda (e) (eq? 'my-tag (error-object-type e))) (lambda () (escalate 'my-tag))))\n(newline)"],
["eot.r4.math", "(display (list (with-exception-handler (lambda (e) (error-object-type e)) (lambda () (error \"m\"))) (error-object-type 42) (error-object-type \"s\")))\n(newline)"],
["eot.r4.cs", "(display (with-exception-handler (lambda (e) (error-object-type e)) (lambda () (raise 'my-signal))))\n(newline)"],
["eot.r5.eng", "(define (dispatch thunk table)\n  (with-exception-handler (lambda (e) (let ((hit (assq (error-object-type e) table))) (if hit ((cdr hit) e) 'unhandled))) thunk))\n(display (dispatch (lambda () (escalate 'out-of-fuel 2)) (list (cons 'out-of-fuel (lambda (e) (list 'refuel (error-object-irritants e)))))))\n(newline)"],
["eot.r5.math", "(define (tags thunks) (map (lambda (t) (with-exception-handler (lambda (e) (error-object-type e)) t)) thunks))\n(display (tags (list (lambda () (escalate 'a)) (lambda () (escalate 'b)) (lambda () (error \"c\")))))\n(newline)"],
["eot.r5.cs", "(define (retry-if tag n thunk)\n  (with-exception-handler (lambda (e) (if (and (eq? (error-object-type e) tag) (> n 0)) (retry-if tag (- n 1) thunk) (list 'stop (error-object-type e)))) thunk))\n(display (retry-if 'flaky 2 (lambda () (escalate 'fatal))))\n(newline)"]
]
