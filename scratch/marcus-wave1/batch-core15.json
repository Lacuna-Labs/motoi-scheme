["r-r5e", "(define (read-all s)\n  (let ((p (open-input-string s)))\n    (let loop ((acc '()))\n      (let ((d (read p)))\n        (if (eof-object? d) (reverse acc) (loop (cons d acc)))))))\n(display (read-all \"(a 1) (b 2) (c 3)\"))\n(newline)"],
["r-r5m", "(define (read-all s)\n  (let ((p (open-input-string s)))\n    (let loop ((acc '()))\n      (let ((d (read p)))\n        (if (eof-object? d) (reverse acc) (loop (cons d acc)))))))\n(display (list 'count (length (read-all \"1 2 3 4 5\")) 'sum (apply + (read-all \"1 2 3 4 5\"))))\n(newline)"],
["r-r5c", "(define (read-all s)\n  (let ((p (open-input-string s)))\n    (let loop ((acc '()))\n      (let ((d (read p)))\n        (if (eof-object? d) (reverse acc) (loop (cons d acc)))))))\n(define (interp form)\n  (cond ((not (pair? form)) (list 'value form))\n        ((eq? (car form) 'move) (list 'moved (cadr form) (caddr form)))\n        (else (list 'unknown (car form)))))\n(display (map interp (read-all \"(move 1 2) (spin) 7\")))\n(newline)"]
