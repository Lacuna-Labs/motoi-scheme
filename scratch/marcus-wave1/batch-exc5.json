[
["fe.probe", "(display (map (lambda (n) (list n (with-exception-handler (lambda (e) 'unbound) (lambda () (eval-does-not-exist))))) (list 1)))\n(newline)"],
["fe.names", "(display (list (with-exception-handler (lambda (e) (error-object-message e)) (lambda () (open-input-file \"x\"))) (with-exception-handler (lambda (e) (error-object-message e)) (lambda () (file-exists? \"x\"))) (with-exception-handler (lambda (e) (error-object-message e)) (lambda () (delete-file \"x\")))))\n(newline)"],
["fe.r2.eng", "(define (open-safely path)\n  (with-exception-handler (lambda (e) (if (file-error? e) (list 'file-problem path) (list 'not-a-file-problem (error-object-message e))))\n    (lambda () (open-input-file path))))\n(display (open-safely \"/no/such/file\"))\n(newline)"],
["fe.r2.math", "(display (map file-error? (list 1 \"s\" 'sym #t '())))\n(newline)"],
["fe.r2.cs", "(display (with-exception-handler (lambda (e) (list 'read (read-error? e) 'file (file-error? e))) (lambda () (read (open-input-string \"(1\")))))\n(newline)"],
["fe.r3.a", "(file-error? 'anything)"],
["fe.r3.b", "(display (with-exception-handler (lambda (e) (file-error? e)) (lambda () (error \"disk full\"))))\n(newline)"],
["fe.r3.c", "(display (list (file-error? (list 'enoent \"/tmp/x\")) (file-error? \"ENOENT\")))\n(newline)"],
["fe.r4.eng", "(display (map file-error? (list 0 -1 \"\" \"ENOENT\" 'file-error #t #f '() (list 1 2))))\n(newline)"],
["fe.r4.math", "(display (with-exception-handler (lambda (e) (file-error? e)) (lambda () (error \"anything at all\" 1 2 3))))\n(newline)"],
["fe.r4.cs", "(display (with-exception-handler (lambda (e) (list (error-object? e) (file-error? e))) (lambda () (escalate 'disk-full \"/tmp\"))))\n(newline)"],
["fe.r5.eng", "(define (classify-failure thunk)\n  (with-exception-handler (lambda (e) (cond ((read-error? e) 'syntax) ((file-error? e) 'storage) (else 'logic))) thunk))\n(display (list (classify-failure (lambda () (read (open-input-string \"(1\")))) (classify-failure (lambda () (error \"oops\")))))\n(newline)"],
["fe.r5.math", "(display (list 'always-false (equal? (map file-error? (list 1 2 3)) (list #f #f #f))))\n(newline)"],
["fe.r5.cs", "(define (portable-guard thunk)\n  (with-exception-handler (lambda (e) (if (file-error? e) 'retry-storage 'give-up)) thunk))\n(display (list (portable-guard (lambda () 'fine)) (portable-guard (lambda () (error \"boom\")))))\n(newline)"]
]
