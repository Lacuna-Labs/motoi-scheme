["hr5e", "(define (env-alist)\n  (map (lambda (e) (cons (car e) (cadr e))) (get-environment-variables)))\n(display (list 'cdr-is-now-a-string (string? (cdr (assoc \"PATH\" (env-alist))))))\n(newline)"],
