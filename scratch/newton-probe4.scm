(define L (phys/L-free 1.0))
(define (verify-trajectory L traj-fn times tol)
  (define (approx a b) (< (abs (- a b)) tol))
  (let loop ((ts times))
    (if (null? ts) 'verified
        (let ((state (traj-fn (car ts))))
          (if (approx (phys/lagrange-residual L (car state) (cadr state) (car ts)) 0)
              (loop (cdr ts))
              'failed)))))
(display (verify-trajectory L (lambda (t) (list (+ 0 (* 2 t)) 2))
                   (list 0 1) 0.01))
(newline)
(display (phys/lagrange-residual L 0 2 0))
(newline)
