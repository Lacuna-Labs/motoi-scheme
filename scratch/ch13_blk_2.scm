(require 'game/world)
(world/gravity! 0 0)
(define score 0)
(define hero (world/spawn 'hero 0 10))
(define coin (world/spawn 'coin 20 10))
(define (collect!)
  (when (and (entity/alive? coin) (entity/overlaps? hero coin))
    (entity/despawn! coin)
    (set! score (+ score 1))))
(collect!)
(display score)
(newline)
