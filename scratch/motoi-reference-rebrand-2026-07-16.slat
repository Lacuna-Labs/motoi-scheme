; ─────────────────────────────────────────────────────────────────────────
; MOTOI REFERENCE MANUAL REBRAND — 2026-07-16
; ─────────────────────────────────────────────────────────────────────────
; Report from The Engineer executing Alfred's directive:
;   "all of the example code rewritten to support Motoi and all of the
;    reference manual, it'd be now a Motoi Reference Manual and remove
;    all the Sakura verbs from the Motoi reference manual."
;
; Scope: MOTOI-SCHEME-REFERENCE.slat only. Did NOT touch curator/ or
; sakura-scheme/ or scheme-lang/. This is a one-file rewrite.
;
; Doctrine anchors:
;   * Reference IS the language. Adding a verb = document it here first.
;   * Anti-fabrication: never invent Motoi equivalents for Sakura verbs.
;     Flag, don't fake.
;   * No deletes. If a Sakura verb somehow slipped past the auditor, flag
;     it — don't silently delete.
;   * Preserve :dialect, :audience, and other tags.
;   * One-by-one processing: every :example field inspected individually.
; ─────────────────────────────────────────────────────────────────────────

(rebrand-report
  :date "2026-07-16"
  :agent "The Engineer"
  :file "motoi-scheme/scheme/MOTOI-SCHEME-REFERENCE.slat"
  :file-lines-before 17553
  :file-lines-after 17642
  :backup "scratch/MOTOI-SCHEME-REFERENCE.slat.bak-preRebrand"
  :doctrine "reference-is-the-language + anti-fabrication + no-deletes"
  :audience ("alfred-review" "engineer" "training-pipeline")
  :dialect "motoi"
  :training-eligible #t
  :confidentiality "public"
  :status "complete-with-flags"
)

; ── STEP 1: PREAMBLE REBRAND ──

(step1-preamble
  :status "done"
  :change "before/after"
  :before "Motoi Scheme Reference — FILTERED FROM SAKURA REFERENCE / :version 1.0-filtered / :note Motoi-only filtered reference. Every verb documented here IS or WILL BE in the Motoi runtime after Pass-3 Wave 1 migration lands. Sakura-dialect and Lacuna-dialect verbs are documented separately in their respective repos."
  :after "MOTOI SCHEME REFERENCE MANUAL. This is the reference manual for Motoi Scheme, the base language. Motoi (基 — 'foundation') is a small, open-source Scheme dialect derived from R7RS-small and extended with a fantasy-console standard library: framebuffer graphics, sprites, audio, notes and rhythm, AI steering and behavior trees, algebra and topology, artifacts, and Cortex persistent memory. Motoi is the base language; consumer dialects (Sakura, Lacuna) build on top of it by adding, refusing, or modifying verbs — but they never fork it. THIS FILE IS THE LANGUAGE. Everything derives from it: the interpreter, the training data, the tutorial, and every operator script. When code and reference disagree, reference wins."
  :new-fields (":title \"Motoi Scheme Reference Manual\"" ":version \"1.0\"" ":rebranded-at \"2026-07-16\"" ":core-form-count 53")
  :framing "Motoi-first-class, not Sakura-filtered-subset."
)

; ── STEP 2: PER-VERB :EXAMPLE AUDIT + REWRITE ──

(step2-examples
  :status "done"
  :records-processed 989   ; 936 verbs + 53 core-forms
  :records-rewritten 48
  :records-left-alone 759
  :records-flagged-stuck 182
  :dialect-tag-flips 48    ; :dialect "sakura" -> "motoi" inside :examples
  :method "python-slat-parser rebrand-tool-2026-07-16.py"
  :substitution-whitelist "EMPTY — anti-fabrication doctrine"
  :notes "Every record's :examples ( ... ) block was parsed one-by-one. For each example tuple, code was tokenised and every symbol checked against the 262-verb Sakura-dialect set. Zero Motoi-equivalent substitutions performed (per doctrine); dialect-tag flips only where no Sakura verb was referenced."
)

; ── STEP 2b: RECORD-LEVEL DIALECT-TAG FLIPS ──

(step2b-record-dialect-flips
  :status "done"
  :count 6
  :verbs ("cortex/remember" "cortex/recall" "cortex/query" "cortex/forget" "cortex/keys" "cortex/size")
  :change ":dialect \"sakura\" -> :dialect \"motoi\" at record level"
  :rationale "Cortex is Motoi per Alfred's directive (Cortex stays in Motoi). The upstream reference had these labelled 'sakura'; they belong in Motoi."
)

; ── STEP 3: RUNTIME SPOT-CHECK (WAVE 1 LIB) ──

(step3-runtime-spotcheck
