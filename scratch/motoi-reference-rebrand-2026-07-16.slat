    (:verb "escalate" :occurrences 65 :note "Error/routing verb. Also Curator-classified as Sakura. Common across ALL Motoi-base examples.")
    (:verb "act" :occurrences 16 :note "Dispatch primitive. Sakura-classified. Foundational to workflow examples.")
    (:verb "card-do" :occurrences 12 :note "Genuinely Sakura — card system dispatch.")
    (:verb "paint-grid" :occurrences 12 :note "Genuinely Sakura — Conway/canvas cellular verb.")
