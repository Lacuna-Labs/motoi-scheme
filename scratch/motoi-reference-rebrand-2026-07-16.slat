    (:count 8 :class "code-literal-symbols-preserved" :note "Preserve as-is: 'sakura, \"sakura-dark\", \"sakura-pink\", 'sakura color/theme literals in operator-example code. These are brand assets, not language references.")
    (:count 11 :class "docbody-crossref-markdown" :note "Cross-references to Sakura design docs and Curator anchors inside core-form :doc-body markdown examples (e.g. [[curator-canvas-is-sakuras-home]], sakura-magic palette, sakura-mouth anchor, sakura's spoken-reply pattern). Flagged for step5 stuck-docbody report.")
