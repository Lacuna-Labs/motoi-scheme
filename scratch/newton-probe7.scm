(define (generator-driven-mesh n radius edge-fn)
  (let* ((verts (geom/regular-polygon-vertices n radius 0))
         (edges (let loop ((vs verts) (acc (list)))
                  (cond ((null? vs) (reverse acc))
                        ((null? (cdr vs)) (reverse (cons (edge-fn (car vs) (car verts)) acc)))
                        (else (loop (cdr vs) (cons (edge-fn (car vs) (cadr vs)) acc)))))))
    (list 'verts verts 'edges edges)))
(define mesh (generator-driven-mesh 6 1 (lambda (a b) (list a b))))
(display (length (list-ref mesh 3))) (newline)
(display (list-ref mesh 2)) (newline)
