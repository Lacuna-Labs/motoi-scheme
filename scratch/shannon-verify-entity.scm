(define tank (world/spawn 'tank 100 100))
(entity/hp! tank 200)
(entity/damage! tank 50)
(display (list :alive (entity/alive? tank) :hp (entity/hp tank))) (newline)

(define e (world/spawn 'x 0 0))
(entity/hp! e 100) (entity/damage! e 10) (entity/damage! e 20)
(define h1 (entity/hp e))
(define f (world/spawn 'x 0 0))
(entity/hp! f 100) (entity/damage! f 30)
(define h2 (entity/hp f))
(display (list 'h1 h1 'h2 h2 'equal (equal? h1 h2))) (newline)

(define c (world/spawn 'c 0 0))
(entity/hp! c 20)
(let ((hp (entity/hp c)))
  (when (and (not (eq? hp 'nan)) (< hp 25)) (entity/damage! c 20)))
(display (list 'finishing-blow-alive? (entity/alive? c) 'hp (entity/hp c))) (newline)

(define blast (world/spawn 'blast 0 0))
(define near (world/spawn 'foe 4 4))
(define far (world/spawn 'foe 400 400))
(entity/hp! near 20) (entity/hp! far 20)
(for-each (lambda (id)
  (if (and (not (eq? id blast)) (entity/overlaps? blast id) (< (entity/distance blast id) 20))
      (entity/damage! id 5)))
  (list near far))
(display (list 'aoe (entity/hp near) (entity/hp far))) (newline)
