(define (safe-move a b)
  (let loop ((da 1))
    (if (> da a)
        (let loop2 ((db 1))
          (if (> db b)
              #f
              (if (game/wythoff-p? a (- b db))
                  (list a (- b db))
                  (loop2 (+ db 1)))))
        (if (game/wythoff-p? (- a da) b)
            (list (- a da) b)
            (loop (+ da 1))))))
(display (list 'safe-move (safe-move 5 8))) (newline)

(define (find-safe-move a b)
  (let loop-a ((k 1))
    (cond ((> k a) (find-safe-b a b 1))
          ((game/wythoff-p? (- a k) b) (list (- a k) b))
          (else (loop-a (+ k 1))))))
(define (find-safe-b a b k)
  (cond ((> k b) 'no-move)
        ((game/wythoff-p? a (- b k)) (list a (- b k)))
        (else (find-safe-b a b (+ k 1)))))
(display (list 'find-safe-move (find-safe-move 5 8))) (newline)
