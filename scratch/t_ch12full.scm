;; ---- primitives ----
(define (bit-xor2 a b)
  (let loop ((a a) (b b) (bit 1) (acc 0))
    (if (and (= a 0) (= b 0)) acc
        (let ((da (modulo a 2)) (db (modulo b 2)))
          (loop (quotient a 2) (quotient b 2) (* bit 2)
                (+ acc (* bit (if (= da db) 0 1))))))))
(define (nim-sum piles) (fold bit-xor2 0 piles))
(define (nim-outcome piles) (if (zero? (nim-sum piles)) 'P 'N))
(define (nim-move piles)
  (let ((s (nim-sum piles)))
    (let loop ((i 0) (ps piles))
      (if (null? ps) #f
          (let ((target (bit-xor2 s (car ps))))
            (if (< target (car ps)) (cons i target)
                (loop (+ i 1) (cdr ps))))))))
(define (best-nim-move state)
  (let ((mv (nim-move state)))
    (or mv (let loop ((i 0) (ps state))     ;; losing: take 1 from first nonempty
             (cond ((null? ps) #f)
                   ((> (car ps) 0) (cons i (- (car ps) 1)))
                   (else (loop (+ i 1) (cdr ps))))))))
(define (apply-move state mv)
  (let loop ((i 0) (ps state))
    (if (null? ps) '()
        (cons (if (= i (car mv)) (cdr mv) (car ps))
              (loop (+ i 1) (cdr ps))))))
(define (nim-play piles)
  (let loop ((state piles) (turn 'A))
    (if (every zero? state)
        (list 'winner (if (eq? turn 'A) 'B 'A))
        (loop (apply-move state (best-nim-move state))
              (if (eq? turn 'A) 'B 'A)))))
(display (nim-play '(3 5 6))) (newline)

(define (mex lst) (let loop ((m 0)) (if (member m lst) (loop (+ m 1)) m)))
(define gc (make-hash-table))
(define (grundy pos moves-fn)
  (or (hash-table-ref/default gc pos #f)
      (let ((g (mex (map (lambda (p) (grundy p moves-fn)) (moves-fn pos)))))
        (hash-table-set! gc pos g) g)))

(define (unequal-split-moves state)
  (apply append
    (map (lambda (i)
           (let ((n (list-ref state i)))
             (if (< n 3) '()
                 (map (lambda (a)
                        (let ((b (- n a)))
                          (append (take state i) (list a b) (drop state (+ i 1)))))
                      (iota (- (quotient (- n 1) 2) 0) 1)))))
         (iota (length state)))))
(display (grundy '(7) unequal-split-moves)) (newline)
