(define dancer 'dancer-1)
(define (tempo-aware-step entity bpm)
  (let ((cad (motion/cadence bpm '8)))
    (if (hash-table-ref/default cad 'ok #f)
        (let ((step-time (hash-table-ref/default cad 'periodMs #f)))
          (define (walk steps)
            (if (> steps 0)
                (begin (motion/move-to entity (+ (entity/x entity) 50) (entity/y entity))
                       (time/when step-time (lambda () (walk (- steps 1)))))))
          (walk 8))
        (display 'tempo-error))))
(display (tempo-aware-step dancer 130))
(newline)
