;;;
;;; This wave's mandate: wire the lib modules into a base env, smoke-test
;;; Alfred's `play` example, verify Motoi reference source-of-truth,
;;; and sweep residual Sakura branding across the runtime.

(cleanup-report
  :n           "sakura-cleanup-wave-2026-07-16"
  :author      "The Engineer (Opus 4.7)"
  :date        "2026-07-16"
  :status      :complete
  :audience    :engineering
  :dialect     :motoi
  :provenance  (:preceding "motoi-scheme/scratch/pass-3-wave-1-report-2026-07-16.slat"
                :audit "motoi-scheme/scratch/reference-audit-2026-07-16.slat"
                :gap "motoi-scheme/scratch/reference-runtime-gap-2026-07-16.slat"))

;; ─────────────────────────────────────────────────────────────────────────
;; STEP 1 — Wire lib modules into Motoi's env
;; ─────────────────────────────────────────────────────────────────────────

(step-1-lib-wiring
  :landed
    ("src/lib-loader.js       — new. installLibs(env, opts) + makeExtendedBaseEnv(opts). Wires 14 installers in dependency order (base → graphics → media → game → ai → system)."
     "src/index.js            — exports makeExtendedBaseEnv, installLibs, getMediaState. Header retitled sakura-scheme → motoi-scheme.")

  :installer-order-and-notes
    (":base tier   — installR7rsSmall, installAlg  (r7rs-types + topo are utility-only, imported for side-effect verification)"
     ":graphics    — installSprite  (framebuffer + animation are utility-only)"
     ":media       — registerMedia  (owns shared fb + audio timeline + animation loop; must run before game.js which reads via getMediaState())"
     ":audio       — sound.js + audio-driver.js are utility-only (accessed by media.js). BellAdapter is auto-installed as the SoundEngine's default adapter."
     ":game        — installGame + installGameInstances + installScene + installPrefab + installJuggle  (shared game state object via makeGameState())"
     ":ai          — installAi"
     ":system      — installSystem + installEng + installTime + installOps  (registry.js is utility, used by ops)")

  :per-module-verb-counts
    ((:module "lib/base/r7rs-small"      :ok #t  :verbs 157)
     (:module "lib/base/alg"             :ok #t  :verbs 67)
     (:module "lib/graphics/sprite"      :ok #t  :verbs 4)
     (:module "lib/media/media"          :ok #t  :verbs 42)
     (:module "lib/game/game"            :ok #t  :verbs 32)
     (:module "lib/game/game-instances"  :ok #t  :verbs 6)
     (:module "lib/game/scene"           :ok #t  :verbs 5)
     (:module "lib/game/prefab"          :ok #t  :verbs 2)
     (:module "lib/game/juggle"          :ok #t  :verbs 6)
     (:module "lib/ai/ai"                :ok #t  :verbs 18)
     (:module "lib/system/system"        :ok #t  :verbs 10)
     (:module "lib/system/eng"           :ok #t  :verbs 6)
     (:module "lib/system/time-verbs"    :ok #t  :verbs 7)
     (:module "lib/system/ops"           :ok #t  :verbs 35))

  :totals
    (:installers 14
     :utility-modules 7        ;; r7rs-types, topo, registry, animation, sound, audio-driver, game-theory
     :new-verbs-added 397
     :base-env-verb-count 138
     :extended-env-verb-count 535)

  :spot-check-verbs-verified
    ("r7rs-small: char?, string->list"
     "alg: alg/perm"
     "sprite: sprite/define"
     "media: tone, note, circle, clear, render"
     "game: sprite, sprites, entity/make"
     "game-instances: big-bang"
     "scene: scene/clear"
     "prefab: prefab/define"
     "juggle: juggle/valid?, juggle/balls"
     "ai: cortex/remember, cortex/recall, llm/complete"
     "system: input/may-i?"
     "eng: eng/tf, eng/tf-dc-gain"
     "time-verbs: time/delta"
     "ops: (35 verbs registered, module ran clean)")

  :blockers :none)

;; ─────────────────────────────────────────────────────────────────────────
;; STEP 2 — Smoke test for Alfred's `play` example
;; ─────────────────────────────────────────────────────────────────────────

(step-2-audio-smoke
  :goal "Verify that a program calling the base audio surface (tone/note/music) runs end-to-end through the Motoi dispatch pipeline without throwing."

  :context
    "The reference (MOTOI-SCHEME-REFERENCE.slat) documents audio/play as
     the canonical audio-triggering verb. However, no lib module registers
     audio/play — media.js exposes the base audio surface as unqualified
     tone / note / sfx / music. Per reference-runtime-gap-2026-07-16.slat,
     audio/play is one of 35 audio verbs the reference documents but the
     runtime does not implement (fix target: Wave 3+).

     For Wave 2 the correct smoke-target is the seam that DOES exist:
     tone / note / music evaluating through SoundEngine → BellAdapter,
     silent under MOTOI_SOUND=off."

  :results
    ((:test "media.js audio seams registered"
       :verbs-present ("tone" "note" "music" "sfx" "silence" "stop-sound")
       :status :pass)
     (:test "BellAdapter fires without throwing (headless)"
       :verb "engine.note('C4', 0.05, 0.5)"
       :status :pass
       :note "Returns {ok: true, kind: 'note', pitch: 'C4', freq: 261.63…, dur: 0.05, vel: 0.5}")
     (:test "(note \"C4\" 0.05 0.5) evaluates via full parse+evaluate"
       :status :pass
       :note "Full Scheme dispatch through makeExtendedBaseEnv + parse + evaluate returns ok result."))

  :gap-flagged
    "audio/play verb IS documented in reference but NOT registered by any
     lib module. Not a Wave-2 defect — this is one of 35 unimplemented
     audio verbs per reference-runtime-gap-2026-07-16.slat, targeted for
     Wave 3+. The DOCUMENTATION-vs-RUNTIME gap remains 880 verbs; today's
     work brought the RUNTIME up from 126 to ~523 (still gap of ~413)."

  :blockers :none)

;; ─────────────────────────────────────────────────────────────────────────
;; STEP 3 — Motoi reference source-of-truth verification
;; ─────────────────────────────────────────────────────────────────────────

(step-3-reference-verify
  :goal "Confirm the Motoi reference at scheme/MOTOI-SCHEME-REFERENCE.slat is what's loaded/exported, and no code path still points at the old scheme-lang reference."

  :audits
    ((:file "scheme/MOTOI-SCHEME-REFERENCE.slat" :exists #t :size-bytes 2734805)
     (:pattern "scheme-lang/docs" :occurrences-in-runtime 0)
     (:pattern "SAKURA-SCHEME-REFERENCE" :occurrences-in-runtime 1
       :location "lib/media/media.js:376  (fixed → MOTOI-SCHEME-REFERENCE)"
       :status :fixed))

  :runtime-loaders
    "Confirmed no runtime code loads the reference SLAT at boot. The docs-
     emitter EMITS docs FROM the live registry; no code reads the SLAT file
     itself. Reference-loader.js migration (needed to gate registration by
     the reference) is still Wave 2+ per the pass-3 report — not touched
     this wave."

  :package-json
    "package.json 'files' list uses capitalized paths (Scheme, Engineering,
     Words, Spec) — case-insensitive on macOS so lowercase paths resolve
     correctly. No change required."

  :blockers :none)

;; ─────────────────────────────────────────────────────────────────────────
;; STEP 4 — Residual Sakura branding sweep
;; ─────────────────────────────────────────────────────────────────────────

(step-4-rename-sweep
  :scope "src/, adapters/, lib/, bin/, bindings/, tests/  (excluding _archive/, scratch/, scheme-books/)"

  :files-edited-one-at-a-time
    ((:file "src/introspect.js"
       :changes ("Header: sakura-scheme → motoi-scheme"
                 "Docstring: `sakura-scheme help card/open` → `motoi help card/open`"))

     (:file "src/base.js"
       :changes ("Comments (2x): `sakura-scheme help car` → `motoi help car`"
                 "Metadata version: 'sakura-scheme@1.0' → 'motoi-scheme@0.1'"))

     (:file "src/docs-emitter.js"
       :changes ("Header: sakura-scheme → motoi-scheme"
                 "Callers comment: `sakura-scheme docs regen` → `motoi docs regen`"))

     (:file "src/slat.js"
       :changes ("Docstring: 'sakura-scheme' → 'motoi-scheme'"))

     (:file "src/repl.js"
       :changes ("Header: sakura-scheme → motoi-scheme"
                 "Ch 9 doc ref: docs/SAKURA-SCHEME-BOOK.md → scheme/MOTOI-SCHEME-BOOK.md"
                 "`,ask` meta-command: 'sakura' → '<persona>' (downstream fills in)"
                 "Reserved-slot list: `,ask sakura` → `,ask <persona>`"))

     (:file "src/verbRegistry.js"
       :changes ("Categories ref: docs/sakura/HELLO-SURFACE-1.0.md → engineering/HELLO-SURFACE-1.0.ENG.slat"
                 "Comment: 'whether Sakura can fire it' → 'which dialect callers can fire it'"))

     (:file "src/slat-verbs.js"
       :changes ("Docstring (3x): 'Sakura Scheme' → 'Motoi Scheme'"
                 "Metadata: since 'sakura-scheme@1.5' → 'motoi-scheme@0.1'"))

     (:file "src/index.js"
       :changes ("Header: sakura-scheme → motoi-scheme (+ import example uses motoi-scheme)"
                 "Introspection comment: 'REPL, CLI, docs, and Sakura' → '…and downstream dialects'"))

     (:file "lib/media/media.js"
       :changes ("Reference-name comment: SAKURA-SCHEME-REFERENCE.slat → MOTOI-SCHEME-REFERENCE.slat")))

  :items-deliberately-preserved
    ((:item "_sakuraStub property protocol"
       :files ("src/verbRegistry.js" "lib/system/system.js" "lib/base/alg.js")
       :reason "Cross-file marker used to distinguish stubbed verbs from real impls. Renaming to _motoiStub is a coordinated repo-wide refactor; scope is Wave 5. Wave-1 report already flagged this.")

     (:item "MODES.sakura backwards-compat alias"
       :file "lib/graphics/framebuffer.js"
       :reason "Sakura scripts using (set-mode 'sakura) must keep working. MODES.default is now canonical; MODES.sakura aliases to the same value.")

     (:item "'blossom' sprite default color"
       :files ("lib/graphics/sprite.js" "lib/game/game.js")
       :reason "Public verb signature: (sprite 'ball 40 40 'blossom). Existing Sakura-dialect scripts rely on this exact color name.")

     (:item "SAKURA_SOUND env-var fallback"
       :file "lib/audio/sound.js"
       :reason "MOTOI_SOUND is canonical; SAKURA_SOUND=off is honored as a backwards-compat alias for Sakura-dialect consumers with existing shell configs.")

     (:item "Provenance comments across lib/*"
       :files ("lib/game/scene.js" "lib/game/game.js" "lib/system/system.js" "lib/system/time-verbs.js" "lib/audio/sound.js" "lib/audio/audio-driver.js" "lib/graphics/sprite.js" "lib/ai/ai.js" "lib/base/r7rs-small.js" "lib/graphics/framebuffer.js" "lib/base/alg.js" "lib/media/media.js")
       :reason "Historical migration comments (`Provenance: scheme-lang/src/foo.js. Migrated ... Sakura-branded X neutralized to Y`) — these ARE the audit trail. Removing them destroys the provenance record.")

     (:item "adapters/base.js dialect list mention"
       :file "adapters/base.js:12"
       :reason "'A DIALECT LAYER (Sakura, Lacuna, or any other) overrides these' — legitimate reference to Sakura as a valid downstream. Motoi ships neutral shape.")

     (:item "package.json description"
       :file "package.json:5"
       :reason "'Motoi Scheme — the base dialect Sakura and Lacuna share' — correctly positions Motoi under Sakura/Lacuna as downstream consumers.")

     (:item "scheme-books/ book manifest"
       :file "scheme-books/MANIFEST.json"
       :reason "Book source provenance points to sakura-scheme/docs/book/*. Book content lives outside the runtime-cleanup wave — separate lane.")

     (:item "src/dispatch.js Sakura tier + reject reasons"
       :file "src/dispatch.js"
       :occurrences 8
       :reason "sakura power tier + 'sakura-cannot-destroy' reject-reason strings are LOAD-BEARING constants used by downstream Sakura consumers. Renaming requires coordinated changes at consumer sites — explicitly Wave 5 concern per pass-3-wave-1-report §wave-5-prerequisite (dispatch.js adapter decoupling)."))

  :sakura-refs-remaining
    ((:file "src/dispatch.js" :count 8 :status "Wave 5 — dispatch.js decoupling")
     (:file "lib/*/*.js provenance headers" :count "~20" :status "preserved as audit trail")
     (:file "package.json" :count 1 :status "correctly positions Motoi as base of Sakura+Lacuna")
     (:file "adapters/base.js" :count 1 :status "correctly lists Sakura as valid dialect")
     (:file "scheme-books/MANIFEST.json" :count "~50" :status "out of scope — book content provenance"))

  :blockers :none)

