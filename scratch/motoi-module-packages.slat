;;; motoi-module-packages.slat
;;;
;;; Proposed module packages for Motoi Scheme.
;;;
;;; Every package is loadable via `(import (motoi <path>))`. Model does not
;;; memorize module verbs; instead the runtime auto-loads the package on
;;; first `import` and the manual (or SLAT lookup) tells the model what's
;;; inside.
;;;
;;; :doc              "motoi-module-packages"
;;; :audience         :engineer
;;; :confidentiality  "public"
;;; :training-eligible #t
;;; :provenance       "architect-motoi-core-vs-module-2026-07-16"
;;; :owner            "The Architect"
;;; :date             "2026-07-16"

(module-packages
  :date "2026-07-16"
  :package-count 16
  :total-verbs-in-modules 574
  :total-verbs-in-cruft 61
  :total-verbs-in-core 322
  :grand-total 957
  :note
  ("Grand total 957 = 958 reference verbs + 3 motion one-liners
    (bounce/slide/fade — reference library slot 'motion' plus dashed
    aliases). The audit's 958 figure and this classification's 957 differ
    by one verb (base/make-character promoted to CORE, listed once).
    Numerical parity is tracked but not load-bearing for the design.")

  ;; ── PACKAGE 1: (motoi math advanced) ────────────────────────────
  (package
    :name "(motoi math advanced)"
    :folder "modules/math-advanced/"
    :verb-count 220
    :libraries-included ("stat" "linalg" "matrix" "complex" "solve" "seq"
                          "comb" "sym" "calc" "num" "exact" "eng")
    :reasoning
    "Everything past 'basic math' the reference documents. Requires domain
     knowledge — stat/z-score, linalg/svd, calc/hessian, sym/solve-quadratic,
     complex/->polar. A hobbyist reaches for these AFTER their first month
     when they hit a real problem. Domain-knowledge test = fail = MODULE.
     Combined into one package because they interoperate (linalg needs
     matrix, calc needs sym, ops needs linalg)."
    :verbs-summary
    "stat: 18 · linalg: 25 · matrix: 20 · complex: 18 · solve: 13 ·
     seq: 12 · comb: 13 · sym: 20 · calc: 30 · num: 2 · exact: 19 · eng: 6
     · plus duplicated linalg/matrix entries from reference (7 dup)"
    :depends-on ())

  ;; ── PACKAGE 2: (motoi math discrete) ────────────────────────────
  (package
    :name "(motoi math discrete)"
    :folder "modules/math-discrete/"
    :verb-count 88
    :libraries-included ("nt" "alg")
    :reasoning
    "Number theory (nt/*, 29 verbs) and abstract algebra (alg/*, 59 verbs).
     Both are teachable middle-school → hobbyist material but require the
     concept-of-a-group. Split from (math advanced) because these are
     'discrete-math depth' vs 'engineering-math depth' — a kid exploring
     Pascal's triangle wants nt/factor, alg/dihedral without pulling
     calculus + SVD. Separable, self-contained."
    :depends-on ())

  ;; ── PACKAGE 3: (motoi math topology) ────────────────────────────
  (package
    :name "(motoi math topology)"
    :folder "modules/math-topology/"
    :verb-count 27
    :libraries-included ("topo")
    :reasoning
    "Topology, persistent homology, knot theory — deep specialists. A
     small package because the concepts are hard even for hobbyists.
     Separate from (math advanced) so the model doesn't need to load
     50 topo verbs when a kid asks for standard deviation."
    :depends-on ())

  ;; ── PACKAGE 4: (motoi math geometry-advanced) ───────────────────
  (package
    :name "(motoi math geometry-advanced)"
    :folder "modules/math-geometry-advanced/"
    :verb-count 37
    :libraries-included ("geom-remainder-of-set")
    :reasoning
    "The 37 geom/* verbs NOT in CORE: cone/cylinder/sphere/prism/pyramid
     volumes + surfaces, law-of-cosines/sines, inscribed/interior angle
     laws, arc-length, transform-polygon, regular-polygon-* etc. Requires
     Euclidean-geometry vocabulary — high-school geometry, not first-month
     hobbyist. CORE keeps the ~20 kid-graspable geometry verbs."
    :specific-verbs
    ("geom/arc-length" "geom/arccos" "geom/arcsin" "geom/arctan"
     "geom/collinear?" "geom/cone-surface" "geom/cone-volume"
     "geom/cylinder-surface" "geom/cylinder-volume" "geom/dilate"
     "geom/inscribed-angle" "geom/interior-angle" "geom/interior-angle-deg"
     "geom/law-of-cosines-angle" "geom/law-of-cosines-side"
     "geom/law-of-sines-side" "geom/perimeter" "geom/polygon-perimeter"
     "geom/prism-volume" "geom/pyramid-volume" "geom/pythagoras-hypotenuse"
     "geom/pythagoras-leg" "geom/reflect-line" "geom/reflect-origin"
     "geom/reflect-x" "geom/reflect-y" "geom/regular-polygon-area"
     "geom/regular-polygon-vertices" "geom/right-triangle-angle"
     "geom/rotate-about" "geom/sector-area" "geom/similar?"
     "geom/solve-right" "geom/sphere-surface" "geom/sphere-volume"
     "geom/transform-polygon" "geom/triangle-area-heron")
    :depends-on ())

  ;; ── PACKAGE 5: (motoi math curves) ──────────────────────────────
  (package
    :name "(motoi math curves)"
    :folder "modules/math-curves/"
    :verb-count 37
    :libraries-included ("curve")
    :reasoning
    "Curves and differential geometry — bezier/hermite/catmull-rom splines,
     frenet-frame, curvature, torsion, brachistochrone. Requires vector
     calculus. Genuinely deep material a hobbyist reaches for when
     building animation systems or physics sims. Not first-month."
    :depends-on ("(motoi math advanced)"))

  ;; ── PACKAGE 6: (motoi math plot) ────────────────────────────────
  (package
    :name "(motoi math plot)"
    :folder "modules/math-plot/"
    :verb-count 14
    :libraries-included ("plot")
    :reasoning
    "Chart/graph rendering — plot/bar, plot/histogram, plot/contour,
     plot/vector-field. Depends on stat + sym for data prep. Own package
     because rendering surfaces are optional (kid can plot on canvas
     with math + drawing instead)."
    :depends-on ("(motoi math advanced)"))

  ;; ── PACKAGE 7: (motoi science physics) ──────────────────────────
  (package
    :name "(motoi science physics)"
    :folder "modules/science-physics/"
    :verb-count 19
    :libraries-included ("phys")
    :reasoning
    "Lagrangians, units-with-dimensions, gravitational force, RLC damping,
     nbody, quantum uncertainty algebra. Advanced-physics material — one
     package because the verbs interoperate through the quantity type.
     A basic-physics kid uses (world gravity!) etc. from CORE."
    :depends-on ("(motoi math advanced)"))

  ;; ── PACKAGE 8: (motoi science chemistry) ────────────────────────
  (package
    :name "(motoi science chemistry)"
    :folder "modules/science-chemistry/"
    :verb-count 5
    :libraries-included ("chem")
    :reasoning
    "Molar mass, atomic weights, balancing equations. Small package but
     domain-locked; a kid never reaches for chem/balance without
     high-school chemistry context. Keep separate from physics — the
     domains don't compose in kid-space."
    :depends-on ())

  ;; ── PACKAGE 9: (motoi music advanced) ───────────────────────────
  (package
    :name "(motoi music advanced)"
    :folder "modules/music-advanced/"
    :verb-count 10
    :libraries-included ("synth-remainder" "transport" "pattern")
    :reasoning
    "The synth/* verbs NOT in CORE: synth/808, synth/sp1200, synth/orch,
     synth/orchestra, synth/onset-tap, synth/load-score — vintage-machine
     emulation + advanced sound design. Plus transport/tempo + pattern/clave.
     Hobbyist-musician material, not kid-first-month."
    :specific-verbs
    ("synth/808" "synth/sp1200" "synth/orch" "synth/orchestra"
     "synth/onset-tap" "synth/load-score" "transport/tempo"
     "pattern/clave" "tick/lissajous" "tick/mod-n" "tick/pattern"
     "tick/triangle")
    :depends-on ())

  ;; ── PACKAGE 10: (motoi game advanced) ───────────────────────────
  (package
    :name "(motoi game advanced)"
    :folder "modules/game-advanced/"
    :verb-count 21
    :libraries-included ("game-theory-subset")
    :reasoning
    "Combinatorial game theory — Sprague-Grundy, surreal numbers, nim,
     tic-tac-toe minimax, Wythoff. Belongs together as a book-of-games
     package. Requires game-theory background — not something a kid reaches
     for while making a platformer. When they DO reach for it, they want
     all of it (surreal-add compose with surreal-mul etc.)."
    :specific-verbs
    ("game/grundy" "game/mex" "game/nim-outcome" "game/nim-sum"
     "game/star-n" "game/surreal" "game/surreal-add" "game/surreal-birthday"
     "game/surreal-eq?" "game/surreal-is-number?" "game/surreal-le?"
     "game/surreal-lit" "game/surreal-mul" "game/surreal-neg"
     "game/surreal-simplest" "game/surreal-sub" "game/temperature"
     "game/to-real" "game/ttt-best-move" "game/ttt-value"
     "game/wythoff-p?")
    :depends-on ())

  ;; ── PACKAGE 11: (motoi game entity-advanced) ────────────────────
  (package
    :name "(motoi game entity-advanced)"
    :folder "modules/game-entity-advanced/"
    :verb-count 20
    :libraries-included ("entity-remainder" "collision" "prefab" "group")
    :reasoning
    "Entity system depth beyond CORE — bounce!/drag!/friction!/gravity-scale!/
     layer!/mask!/max-speed!/parent!/pin!/pose!/sensor!/shape-flower!/solid!/
     team!/mass!. Plus collision layers, prefab define/spawn, group
     iteration. Real games need these; first-month kids don't."
    :specific-verbs
    ("entity/bounce!" "entity/collisions" "entity/drag!" "entity/friction!"
     "entity/gravity-scale!" "entity/layer!" "entity/mask!"
     "entity/max-speed!" "entity/parent!" "entity/pin!" "entity/pose!"
     "entity/sensor!" "entity/shape-flower!" "entity/solid!"
     "entity/team!" "entity/mass!" "collision/define-layers!"
     "prefab/define" "prefab/spawn" "group/count" "group/each" "group/find")
    :depends-on ())

  ;; ── PACKAGE 12: (motoi game world-advanced) ─────────────────────
  (package
    :name "(motoi game world-advanced)"
    :folder "modules/game-world-advanced/"
    :verb-count 20
    :libraries-included ("world-remainder")
    :reasoning
    "World-tape (record/replay), world/hash/snapshot for deterministic
     testing, world/link!/link-rest! for constraint/joint physics,
     world/solve! for stepwise simulation, world/attract!/repel!/sway-all!
     for particle systems, world/restore! for save-load. Real-game
     infrastructure; kids don't hit these first month."
    :specific-verbs
    ("world/attract!" "world/repel!" "world/sway-all!" "world/link!"
     "world/link-rest!" "world/solve!" "world/hash" "world/snapshot"
     "world/restore!" "world/tape-audio" "world/tape-clear!"
     "world/tape-frames" "world/tape-hash" "world/tape-lcamera"
     "world/tape-record!" "world/tape-recording?" "world/tape-replay"
     "world/tape-save" "world/tape-stop!")
    :depends-on ())

  ;; ── PACKAGE 13: (motoi game ai-advanced) ────────────────────────
  (package
    :name "(motoi game ai-advanced)"
    :folder "modules/game-ai-advanced/"
    :verb-count 14
    :libraries-included ("ai-remainder")
    :reasoning
    "Pathfinding, flow-fields, grids, waypoints — the AI-heavy verbs.
     A hobbyist building enemy AI reaches for these deliberately after
     they've learned the CORE steering primitives (seek/flee/wander)."
    :specific-verbs
    ("ai/flow-field" "ai/flow-at" "ai/follow-flow" "ai/follow-path"
     "ai/grid" "ai/passable?" "ai/path" "ai/wall!" "ai/waypoints"
     "ai/bt-force" "ai/bt-invert" "ai/bt-parallel" "ai/clear!"
     "ai/max-force!")
    :depends-on ())

  ;; ── PACKAGE 14: (motoi game camera-advanced) ────────────────────
  (package
    :name "(motoi game camera-advanced)"
    :folder "modules/game-camera-advanced/"
    :verb-count 9
    :libraries-included ("camera-remainder")
    :reasoning
    "Camera recording, tracing, tilt, export, bring-to-view, fit-all — the
     cinema-tool verbs. Hobbyist reaches for these when building playback
     features or replay recording. First-month kids stay in CORE camera."
    :specific-verbs
    ("camera-record" "camera-trace" "camera-tilt" "camera-scale"
     "camera-export" "camera-bring-to-view" "camera-fit-all")
    :depends-on ())

  ;; ── PACKAGE 15: (motoi game juggle) ─────────────────────────────
  (package
    :name "(motoi game juggle)"
    :folder "modules/game-juggle/"
    :verb-count 6
    :libraries-included ("juggle")
    :reasoning
    "Siteswap notation for juggling patterns — a single self-contained
     specialty. Genuine gem; belongs in modules for niche-interest
     depth. juggle/balls, juggle/generate, juggle/max-throw,
     juggle/simulate, juggle/state, juggle/valid?."
    :depends-on ())

  ;; ── PACKAGE 16: (motoi compat legacy) ───────────────────────────
  (package
    :name "(motoi compat legacy)"
    :folder "modules/compat-legacy/"
    :verb-count 27
    :libraries-included ("core-namespace-aliases" "duplicated-refs")
    :reasoning
    "Backwards-compat: (a) the dashed core-namespace audio/note/input
     aliases (audio-play, audio-halt, audio-playing?, audio-master-volume,
     audio-tempo, audio-time, audio-bpm, audio-beat?, audio-peak,
     audio-rms, audio-band, audio-bands, audio-bar-clock,
     audio-perceptual-bands, note-strike, note-release, note-place,
     note-place-at, note-dots, input-may-i?) — old flat-namespace era.
     (b) surface/* small library (5 verbs) that duplicates canvas-clear/
     surface-exists?. (c) 5 tiny one-verb libraries (transport, pattern,
     floor, domain, route) with only one verb each that are only used
     inside other verbs' internals — kept for external-caller compat."
    :specific-verbs
    ("audio-play" "audio-halt" "audio-playing?" "audio-master-volume"
     "audio-tempo" "audio-time" "audio-bpm" "audio-beat?" "audio-peak"
     "audio-rms" "audio-band" "audio-bands" "audio-bar-clock"
     "audio-perceptual-bands" "note-strike" "note-release" "note-place"
     "note-place-at" "note-dots" "input-may-i?"
     "surface/curtain" "surface/describe" "surface/digest" "surface/dim"
     "surface/spotlight" "floor/problem?" "route/off-domain" "domain/of")
    :depends-on ())

  ;; ── LOADING SEMANTICS ───────────────────────────────────────────
  :loading-semantics
  ("Kid types (import (motoi math advanced)) — runtime resolves to
    modules/math-advanced/ folder, loads all JS modules in it, registers
    all verbs, returns. Idempotent."

   "Model reasoning: when a program uses linalg/svd, the training-time
    reference-manual lookup returns 'that verb lives in (motoi math
    advanced)'. The model emits the import line AND the verb. If the
    model does not know the module's exact verb signature, it emits
    the import + a stub call and relies on runtime + Cortex feedback."

   "Modules do NOT ship in the kid's default REPL. First `(import ...)`
    triggers download-or-load. Local dev = load-from-disk; production kid-
    facing = load-from-CDN with a manifest. Design that pipe when Alfred
    gives the go."

   "Each module .slat sub-reference lives at
    modules/<name>/reference.slat — same shape as MOTOI-SCHEME-
    REFERENCE.slat but scoped. Model can be given targeted RAG lookup
    against these on demand."))
