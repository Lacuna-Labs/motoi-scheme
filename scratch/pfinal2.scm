(display "alt3 tag: ") (display (car (alg/alternating 3))) (newline)
(display "alt3 len: ") (display (length (alg/alternating 3))) (newline)
(display "alt4 len: ") (display (length (alg/alternating 4))) (newline)
(display "alt5 len: ") (display (length (alg/alternating 5))) (newline)
(display "alt3 member id: ") (display (if (member '(0 1 2) (alg/alternating 3)) 'yes 'no)) (newline)
(display "pc empty tag: ") (display (alg/perm-cycles '(0 1 2 3))) (newline)
(display "pc len (1 0 3 2): ") (display (length (alg/perm-cycles '(1 0 3 2)))) (newline)
(display "pc (2 0 1): ") (display (alg/perm-cycles '(2 0 1))) (newline)
(display "pfp count (0 2 1): ") (display (length (alg/perm-fixed-points '(0 2 1)))) (newline)
(display "pfp count id5: ") (display (length (alg/perm-fixed-points '(0 1 2 3 4)))) (newline)
(display "pfp deranged (1 0): ") (display (alg/perm-fixed-points '(1 0))) (newline)
(display "pfixed? and: ") (display (alg/perm-fixed? '(0 1 2) 1)) (newline)
