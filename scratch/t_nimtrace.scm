(define (bit-xor2 a b)
  (let loop ((a a) (b b) (bit 1) (acc 0))
    (if (and (= a 0) (= b 0)) acc
        (let ((da (modulo a 2)) (db (modulo b 2)))
          (loop (quotient a 2) (quotient b 2) (* bit 2) (+ acc (* bit (if (= da db) 0 1))))))))
(define (nim-sum piles) (fold bit-xor2 0 piles))
(define (nim-move piles)
  (let ((s (nim-sum piles)))
    (let loop ((i 0) (ps piles))
      (if (null? ps) #f
          (let ((target (bit-xor2 s (car ps))))
            (if (< target (car ps)) (cons i target) (loop (+ i 1) (cdr ps))))))))
(define (best-nim-move state)
  (or (nim-move state)
      (let loop ((i 0) (ps state))
        (cond ((null? ps) #f) ((> (car ps) 0) (cons i (- (car ps) 1))) (else (loop (+ i 1) (cdr ps)))))))
(define (apply-move state mv)
  (let loop ((i 0) (ps state))
    (if (null? ps) '() (cons (if (= i (car mv)) (cdr mv) (car ps)) (loop (+ i 1) (cdr ps))))))
(let loop ((state '(3 5 6)) (turn 'A) (k 0))
  (display (list k turn state)) (newline)
  (if (or (> k 20) (every zero? state))
      (display 'done)
      (loop (apply-move state (best-nim-move state)) (if (eq? turn 'A) 'B 'A) (+ k 1))))
