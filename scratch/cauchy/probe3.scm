(define h (hash-table 'a 1 'b 2 'c 3))
(hash-table-set! h 'b 99)
(display (list 'reset-keeps-position (hash-table-keys h))) (newline)
(hash-table-delete! h 'a)
(hash-table-set! h 'a 7)
(display (list 'delete-readd-goes-last (hash-table-keys h))) (newline)
(display (list 'find-2arg-hit (hash-table-find (lambda (k v) (and (> v 1) v)) (hash-table 'a 1 'b 2)))) (newline)
(define big (make-hash-table))
(for-each (lambda (i) (hash-table-set! big i (* i i))) (iota 50))
(display (list 'order-50 (equal? (hash-table-keys big) (iota 50)))) (newline)
(display (list 'map-preserves-order (equal? (hash-table-keys (hash-table-map (lambda (v) v) big)) (iota 50)))) (newline)
(display (list 'copy-preserves-order (equal? (hash-table-keys (hash-table-copy big)) (iota 50)))) (newline)
(display (list 'string-keys (hash-table-keys (hash-table "z" 1 "a" 2)))) (newline)
