(define pitch-class-table '(("C" . 0)("Bb" . 10)))
(define (pitch-name->midi s)
  (let* ((n (string-length s))
         (oct (string->number (substring s (- n 1) n)))
         (pc (substring s 0 (- n 1)))
         (pair (assoc pc pitch-class-table)))
    (if (and oct pair) (+ (cdr pair) (* 12 (+ oct 1))) 60)))
(display (pitch-name->midi "C4"))(newline)
(display (* 440.0 (expt 2.0 (/ (- 60 69) 12.0))))(newline)
(display (expt 2.0 (/ (- 60 69) 12.0)))(newline)
(display (/ (- 60 69) 12.0))(newline)
(display (/ -9 12.0))(newline)
