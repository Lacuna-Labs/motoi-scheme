(write (let ((x 'outer))
  (let-syntax ((m (syntax-rules () ((m) x))))
    (let ((x 'inner)) (m))))) (newline)
(write (let ((x 'outer))
  (letrec-syntax ((m (syntax-rules () ((m) x))))
    (let ((x 'inner)) (m))))) (newline)
(write (let ((y 5))
  (let-syntax ((m (syntax-rules () ((m a) (+ a y)))))
    (let ((y 100)) (m 1))))) (newline)
