;; README.slatl — Book of Modules · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from 00-manifest.book.slatl
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-modules.")

(boot-record
  :book-title "Book of Modules"
  :subtitle "How Motoi Scheme grows — the module system that lets one language be many"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-modules"
  :boot-into "00-outline.book.slatl"
  :chapter-count 17 :appendix-count 8
  :audience "programmer-fluent-in-other-languages OR curious-kid-with-a-parent-nearby"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Modules\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn modules in Motoi Scheme, chapter by chapter. Start at 00-outline.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Outline" :file "00-outline.book.slatl" :kind "chapter")
   (:title "What a module is" :file "01-what-a-module-is.book.slatl" :kind "chapter")
   (:title "The import statement" :file "02-the-import-statement.book.slatl" :kind "chapter")
   (:title "The export statement" :file "03-the-export-statement.book.slatl" :kind "chapter")
   (:title "Module discovery" :file "04-module-discovery.book.slatl" :kind "chapter")
   (:title "Versioning" :file "05-versioning.book.slatl" :kind "chapter")
   (:title "Hashes and signatures" :file "06-hashes-and-signatures.book.slatl" :kind "chapter")
   (:title "The module fold — one program, many modules" :file "07-module-fold.book.slatl" :kind "chapter")
   (:title "Cross-cart modules" :file "08-cross-cart-modules.book.slatl" :kind "chapter")
   (:title "Module hygiene" :file "09-module-hygiene.book.slatl" :kind "chapter")
   (:title "Lazy vs eager loading" :file "10-lazy-vs-eager.book.slatl" :kind "chapter")
   (:title "Circular imports" :file "11-circular-imports.book.slatl" :kind "chapter")
   (:title "Module identity" :file "12-module-identity.book.slatl" :kind "chapter")
   (:title "Cortex-tracked usage" :file "13-cortex-tracked-modules.book.slatl" :kind "chapter")
   (:title "Publishing (there is no registry)" :file "14-publishing-a-module.book.slatl" :kind "chapter")
   (:title "Forking and remixing (source, not modules)" :file "15-fork-and-remix.book.slatl" :kind "chapter")
   (:title "Verb vs cart (the module layer is gone)" :file "16-module-verb-cart.book.slatl" :kind "chapter")
   (:title "The tiniest possible unit — a few lines with commentary" :file "appendix-a-tiniest-module.book.slatl" :kind "appendix")
   (:title "Import forms — every shape, and its Motoi answer (there is no import)" :file "appendix-b-import-forms.book.slatl" :kind "appendix")
   (:title "The default search path (there is none — nothing is searched for)" :file "appendix-c-search-path.book.slatl" :kind "appendix")
   (:title "Semantic-version tables" :file "appendix-d-semantic-versions.book.slatl" :kind "appendix")
   (:title "Signature cryptography — the concept, not a Motoi mechanism" :file "appendix-e-signatures.book.slatl" :kind "appendix")
   (:title "Common circular-import shapes and how to break them" :file "appendix-f-circular-shapes.book.slatl" :kind "appendix")
   (:title "Cortex recipes — facts you write, not module events you don't have" :file "appendix-g-cortex-recipes.book.slatl" :kind "appendix")
   (:title "The composition summit — many small verbs folded into one game" :file "appendix-h-module-summit.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
