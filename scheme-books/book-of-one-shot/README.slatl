;; README.slatl — Book of One-Shot · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-one-shot.")

(boot-record
  :book-title "Book of One-Shot"
  :book-kind "scheme-book"
  :book-type "composition"
  :book-slug "book-of-one-shot"
  :boot-into "00-cover.book.slatl"
  :chapter-count 17 :appendix-count 0
  :audience "engineer"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of One-Shot\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn one-shot in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "The Book of One-Shot" :file "00-cover.book.slatl" :kind "chapter")
   (:title "Chapter 1: One Form" :file "ch01-one-form.book.slatl" :kind "chapter")
   (:title "Chapter 2: Close Data, Close Paren" :file "ch02-close-data-close-paren.book.slatl" :kind "chapter")
   (:title "Chapter 3: Looks Simple" :file "ch03-looks-simple.book.slatl" :kind "chapter")
   (:title "Chapter 4: Looks Hard" :file "ch04-looks-hard.book.slatl" :kind "chapter")
   (:title "Chapter 5: Compose, Don't Sequence" :file "ch05-compose-dont-sequence.book.slatl" :kind "chapter")
   (:title "Chapter 6: Recall In Place" :file "ch06-recall-in-place.book.slatl" :kind "chapter")
   (:title "Chapter 7: The Wire-Shot" :file "ch07-the-wire-shot.book.slatl" :kind "chapter")
   (:title "Chapter 8: Registry In One" :file "ch08-registry-in-one.book.slatl" :kind "chapter")
   (:title "Chapter 9: Knowledge In One" :file "ch09-knowledge-in-one.book.slatl" :kind "chapter")
   (:title "Chapter 10: Guard In The Form" :file "ch10-guard-in-the-form.book.slatl" :kind "chapter")
   (:title "Chapter 11: Map The Many" :file "ch11-map-the-many.book.slatl" :kind "chapter")
   (:title "Chapter 12: The Honest-Null Shot" :file "ch12-the-honest-null-shot.book.slatl" :kind "chapter")
   (:title "Chapter 13: Nested Wire-Shots" :file "ch13-nested-wire-shots.book.slatl" :kind "chapter")
   (:title "Chapter 14: The Speech Shot" :file "ch14-the-speech-shot.book.slatl" :kind "chapter")
   (:title "Chapter 15: Refactor To One" :file "ch15-refactor-to-one.book.slatl" :kind "chapter")
   (:title "Chapter 16: The Grand One-Shot" :file "ch16-the-grand-one-shot.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
