;; README.slatl — Book of Sound · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.book.slatl
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-sound.")

(boot-record
  :book-title "Book of Sound"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-sound"
  :boot-into "ch01-the-waveform.book.slatl"
  :chapter-count 16 :appendix-count 3
  :audience "kid"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Sound\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn sound in Motoi Scheme, chapter by chapter. Start at ch01-the-waveform.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1: The Waveform" :file "ch01-the-waveform.book.slatl" :kind "chapter")
   (:title "Chapter 2: Harmonics & Harmony" :file "ch02-harmonics-and-harmony.book.slatl" :kind "chapter")
   (:title "Chapter 3: The Soundboard" :file "ch03-the-soundboard.book.slatl" :kind "chapter")
   (:title "Chapter 4: The Filter — roll-off & cut" :file "ch04-the-filter.book.slatl" :kind "chapter")
   (:title "Chapter 5: The Envelope" :file "ch05-the-envelope.book.slatl" :kind "chapter")
   (:title "Chapter 6: Noise & Texture" :file "ch06-noise-and-texture.book.slatl" :kind "chapter")
   (:title "Chapter 7: The Body — resonance & formants" :file "ch07-the-body.book.slatl" :kind "chapter")
   (:title "Chapter 8: Building an Instrument" :file "ch08-building-an-instrument.book.slatl" :kind "chapter")
   (:title "Chapter 9: Physical Models" :file "ch09-physical-models.book.slatl" :kind "chapter")
   (:title "Chapter 10: The Roster & Modding Voices" :file "ch10-the-roster.book.slatl" :kind "chapter")
   (:title "Chapter 11: Timing" :file "ch11-timing.book.slatl" :kind "chapter")
   (:title "Chapter 12: Sequencing & Chiptune" :file "ch12-sequencing-and-chiptune.book.slatl" :kind "chapter")
   (:title "Chapter 13: Decomposing Sound (FFT)" :file "ch13-decomposing-sound.book.slatl" :kind "chapter")
   (:title "Chapter 14: Transcription & Transposition" :file "ch14-transcription.book.slatl" :kind "chapter")
   (:title "Chapter 15: Voice & Speech" :file "ch15-voice-and-speech.book.slatl" :kind "chapter")
   (:title "Chapter 16: The Crescendo — the Beat Machine" :file "ch16-the-beat-machine.book.slatl" :kind "chapter")
   (:title "Instrument & Synth Vocabulary" :file "appendix-c-instrument-vocabulary.book.slatl" :kind "appendix")
   (:title "Tone Table" :file "appendix-d-tone-table.book.slatl" :kind "appendix")
   (:title "Appendix — The Verbs Cookbook" :file "appendix-verbs-cookbook.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
