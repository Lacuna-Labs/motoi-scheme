(define (launch-vel power deg)
  (let ((r (deg->rad deg)))
    (vec/make (* power (geom/cos r)) (* -1 power (geom/sin r)))))
(define (shell-at x0 y0 vx vy g t)
  (vec/make (car (phys/kinematics x0 vx 0 t))
            (car (phys/kinematics y0 vy g t))))
(define (trail power deg g x0 y0 step count)
  (let ((v (launch-vel power deg)))
    (map (lambda (i) (shell-at x0 y0 (car v) (cadr v) g (* i step)))
         (iota count))))
(define (projectiles-anchor)
  (trail 6 45 0.3 30 210 5 6))
(projectiles-anchor)")
