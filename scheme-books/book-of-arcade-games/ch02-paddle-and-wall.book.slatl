;; ch02-paddle-and-wall.book.slatl
;; Book of Arcade Games — Chapter 2: Paddle and Wall

(dialect :applies ("motoi") :note "Applies to Motoi. Per-record :dialect overrides where a record is specific to one surface.")
(chapter
  :book                "Book of Arcade Games"
  :chapter-number      2
  :title               "Paddle and Wall"
  :dialect             "motoi"
  :audience            :kid
  :also-for            :adult
  :content-rating      :G
  :author-lane         "arcade-games-engineer-lane-2026-07-16"
  :training-eligible   #t
