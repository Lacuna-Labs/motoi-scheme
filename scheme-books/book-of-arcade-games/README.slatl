;; README.slatl — Book of Arcade Games · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-arcade-games.")

(boot-record
  :book-title "Book of Arcade Games"
  :book-kind "scheme-book"
  :book-type "application"
  :book-slug "book-of-arcade-games"
  :boot-into "ch01-bouncing-ball.book.slatl"
  :chapter-count 16 :appendix-count 14
  :audience {"name":":kid"}
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Arcade Games\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn arcade games in Motoi Scheme, chapter by chapter. Start at ch01-bouncing-ball.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "The Bouncing Ball" :file "ch01-bouncing-ball.book.slatl" :kind "chapter")
   (:title "Paddle and Wall" :file "ch02-paddle-and-wall.book.slatl" :kind "chapter")
   (:title "Ship and Thrust" :file "ch03-ship-and-thrust.book.slatl" :kind "chapter")
   (:title "Projectiles" :file "ch04-projectiles.book.slatl" :kind "chapter")
   (:title "The Shoot-Em-Up" :file "ch05-shoot-em-up.book.slatl" :kind "chapter")
   (:title "Feel: Deadzones and Ease" :file "ch06-feel-deadzones-and-ease.book.slatl" :kind "chapter")
   (:title "The Platformer's Jump" :file "ch07-platformers-jump.book.slatl" :kind "chapter")
   (:title "Tile Worlds" :file "ch08-tile-worlds.book.slatl" :kind "chapter")
   (:title "Scrolling and Parallax" :file "ch09-scrolling-and-parallax.book.slatl" :kind "chapter")
   (:title "Enemies That React" :file "ch10-enemies-that-react.book.slatl" :kind "chapter")
   (:title "Powerups and Pickups" :file "ch11-powerups-and-pickups.book.slatl" :kind "chapter")
   (:title "Bosses" :file "ch12-bosses.book.slatl" :kind "chapter")
   (:title "Score, Combo, Multiplier" :file "ch13-score-combo-multiplier.book.slatl" :kind "chapter")
   (:title "The Coin-Op Loop" :file "ch14-coin-op-loop.book.slatl" :kind "chapter")
   (:title "Two Players, One Screen" :file "ch15-two-players-one-screen.book.slatl" :kind "chapter")
   (:title "Ship It: The Whole Cabinet" :file "ch16-ship-it.book.slatl" :kind "chapter")
   (:title "Bounce Coefficient Field Guide" :file "appendix-a-bounce-coefficient-field-guide.book.slatl" :kind "appendix")
   (:title "Layered Collision Cookbook" :file "appendix-b-layered-collision-cookbook.book.slatl" :kind "appendix")
   (:title "The Physics Constants Sheet" :file "appendix-c-physics-constants-sheet.book.slatl" :kind "appendix")
   (:title "Camera Recipes" :file "appendix-d-camera-recipes.book.slatl" :kind "appendix")
   (:title "Sprite Cell Palette" :file "appendix-e-sprite-cell-palette.book.slatl" :kind "appendix")
   (:title "Input Timing Windows" :file "appendix-f-input-timing-windows.book.slatl" :kind "appendix")
   (:title "Score, Combo, Multiplier — Formula Notebook" :file "appendix-g-score-combo-formulas.book.slatl" :kind "appendix")
   (:title "The Feel Knobs" :file "appendix-h-feel-knobs.book.slatl" :kind "appendix")
   (:title "Reading world/collisions Efficiently" :file "appendix-i-reading-world-collisions.book.slatl" :kind "appendix")
   (:title "The Cabinet: Title -> Play -> Game Over Loop" :file "appendix-j-the-cabinet-loop.book.slatl" :kind "appendix")
   (:title "Tape Replay for Attract Mode" :file "appendix-k-tape-replay-attract-mode.book.slatl" :kind "appendix")
   (:title "Ships, Paddles, Balls — 12 Micro-Games in 30 Lines" :file "appendix-l-12-micro-games-in-30-lines-each.book.slatl" :kind "appendix")
   (:title "Appendix M — Grid flowers + pocket motion (2026-07-22)" :file "appendix-m-flowers-and-pocket-motion-2026-07-22.book.slatl" :kind "appendix")
   (:title "Appendix — The Verbs Cookbook" :file "appendix-verbs-cookbook.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
