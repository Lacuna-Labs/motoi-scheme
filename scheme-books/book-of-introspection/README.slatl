;; README.slatl — Book of Introspection · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from 00-manifest.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-introspection.")

(boot-record
  :book-title "Book of Introspection"
  :book-kind "scheme-book"
  :book-type "introspection"
  :book-slug "book-of-introspection"
  :boot-into "00-outline.slat"
  :chapter-count 18 :appendix-count 15
  :audience "programmer-learning-motoi"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Introspection\" — a chaptered introspection book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn introspection in Motoi Scheme, chapter by chapter. Start at 00-outline.slat; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Outline" :file "00-outline.slat" :kind "chapter")
   (:title "What is introspection — programs that can look inside themselves" :file "01-what-is-introspection.book.slatl" :kind "chapter")
   (:title "Verb metadata — the shape of every verb" :file "02-verb-metadata.book.slatl" :kind "chapter")
   (:title "Describe + typeOf — what am I looking at?" :file "03-describe-typeof.book.slatl" :kind "chapter")
   (:title "docOf + sourceOf + examples — where does this verb live?" :file "04-docof-sourceof.book.slatl" :kind "chapter")
   (:title "Environments and bindings — what does the program know right now?" :file "05-environments-bindings.book.slatl" :kind "chapter")
   (:title "Macros and macroexpand — the code before the code" :file "06-macros-macroexpand.book.slatl" :kind "chapter")
   (:title "The reader — how source becomes forms" :file "07-the-reader.book.slatl" :kind "chapter")
   (:title "Errors as data — introspecting failure" :file "08-errors-as-data.book.slatl" :kind "chapter")
   (:title "Trace and watch — introspection over time" :file "09-trace-and-watch.book.slatl" :kind "chapter")
   (:title "Cortex — introspecting what the program remembers" :file "10-cortex.book.slatl" :kind "chapter")
   (:title "The registry — introspecting the whole vocabulary" :file "11-the-registry.book.slatl" :kind "chapter")
   (:title "Apropos and search — introspecting by shape" :file "12-apropos-and-search.book.slatl" :kind "chapter")
   (:title "Ask the LLM — introspection through a peer" :file "13-ask-the-llm.book.slatl" :kind "chapter")
   (:title "Composer introspection — widget round-trip is introspection too" :file "14-composer-introspection.book.slatl" :kind "chapter")
   (:title "Performance introspection — time, fuel, memory" :file "15-performance-introspection.book.slatl" :kind "chapter")
   (:title "Safe introspection — perm, sandbox, and what shouldn't leak" :file "16-safe-introspection.book.slatl" :kind "chapter")
   (:title "Libs and modules — introspecting the loader" :file "17-libs-and-modules.book.slatl" :kind "chapter")
   (:title "Reference-manual anatomy — the SLAT schema of a verb record" :file "appendix-a-verb-record-schema.book.slatl" :kind "appendix")
   (:title "Introspection cheat-sheet — one page per verb" :file "appendix-b-introspection-cheat-sheet.book.slatl" :kind "appendix")
   (:title "Building a ,help command from scratch — 40-line REPL extension" :file "appendix-c-build-a-help-command.book.slatl" :kind "appendix")
   (:title "Introspection at the boundary — foreign values, sidecars, sockets" :file "appendix-d-boundary-introspection.book.slatl" :kind "appendix")
   (:title "Reader-time introspection — meta-programming from source position" :file "appendix-e-reader-time-introspection.book.slatl" :kind "appendix")
   (:title "Introspection for teachers — pedagogical patterns" :file "appendix-f-teachers.book.slatl" :kind "appendix")
   (:title "Introspection for debuggers — practical bug-hunting" :file "appendix-g-debuggers.book.slatl" :kind "appendix")
   (:title "Composer-in-book — the composer round-trip as introspection demo" :file "appendix-h-composer-in-book.book.slatl" :kind "appendix")
   (:title "Appendix I — LLM values enumeration: every knob, every field, every metric" :file "appendix-i-llm-values-enumeration.book.slatl" :kind "appendix")
   (:title "LLM x Introspection — the model reads the metadata" :file "appendix-j-llm-x-introspection.book.slatl" :kind "appendix")
   (:title "LLM x Cortex — grounded memory, persisted insight" :file "appendix-k-llm-x-cortex.book.slatl" :kind "appendix")
   (:title "Completions x Modules — narrowing by scope" :file "appendix-l-completions-x-modules.book.slatl" :kind "appendix")
   (:title "Composer x Introspection — widgets are values, forms are widgets" :file "appendix-m-composer-x-introspection.book.slatl" :kind "appendix")
   (:title "Introspection x Training corpus — what the small model can and cannot be expected to remember" :file "appendix-n-introspection-x-training.book.slatl" :kind "appendix")
   (:title "The Wrong Sink — the error census as negative-selection introspection" :file "appendix-o-the-wrong-sink.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
