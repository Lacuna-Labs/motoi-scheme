;; README.slatl — The Book of Motoi Scheme · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-scheme.")

(boot-record
  :book-title "The Book of Motoi Scheme"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-scheme"
  :boot-into "00-index.book.slatl"
  :chapter-count 17 :appendix-count 21
  :audience "kid"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"The Book of Motoi Scheme\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn the book of motoi scheme in Motoi Scheme, chapter by chapter. Start at 00-index.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Index" :file "00-index.book.slatl" :kind "chapter")
   (:title "Chapter 1 — Hello, and a Sound" :file "01-hello-and-a-sound.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Move Something" :file "02-move-something.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Loops That Draw" :file "03-loops-that-draw.book.slatl" :kind "chapter")
   (:title "Chapter 4 — Arithmetic While It's Alive" :file "04-arithmetic-while-alive.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Lists and Shapes" :file "05-lists-and-shapes.book.slatl" :kind "chapter")
   (:title "Chapter 6 — Functions (Name Your Moves)" :file "06-functions.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Recursion (Patterns That Grow)" :file "07-recursion.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Higher-Order (Map, Filter, Reduce)" :file "08-higher-order.book.slatl" :kind "chapter")
   (:title "Chapter 9 — First Macros" :file "09-first-macros.book.slatl" :kind "chapter")
   (:title "Chapter 10 — Real Macros (A Beat DSL)" :file "10-real-macros-beat-dsl.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Many Sprites and a Little Physics" :file "11-many-sprites-physics.book.slatl" :kind "chapter")
   (:title "Chapter 12 — Composing Sound" :file "12-composing-sound.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Cortex (Memory Between Sessions)" :file "13-cortex.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Modules (Importing What You Need)" :file "14-modules.book.slatl" :kind "chapter")
   (:title "Chapter 15 — Making Your Own Module" :file "15-make-your-own-module.book.slatl" :kind "chapter")
   (:title "Chapter 16 — Show and Tell (A Complete Scene)" :file "16-show-and-tell.book.slatl" :kind "chapter")
   (:title "Appendix A — CORE Verb Cheat Sheet" :file "appendix-A-cheat-sheet.book.slatl" :kind "appendix")
   (:title "Appendix B — Module Directory" :file "appendix-B-module-directory.book.slatl" :kind "appendix")
   (:title "Appendix C — REPL Survival Guide" :file "appendix-C-repl-survival.book.slatl" :kind "appendix")
   (:title "Appendix D — Common Patterns" :file "appendix-D-common-patterns.book.slatl" :kind "appendix")
   (:title "Appendix E — Debugging (Root Cause / Hypothesis / Test)" :file "appendix-E-debugging.book.slatl" :kind "appendix")
   (:title "Appendix F — Reading the Reference" :file "appendix-F-reading-reference.book.slatl" :kind "appendix")
   (:title "Appendix G — Where To Go Next" :file "appendix-G-where-next.book.slatl" :kind "appendix")
   (:title "Appendix H — Glossary" :file "appendix-H-glossary.book.slatl" :kind "appendix")
   (:title "Appendix A — Common errors and what they mean" :file "appendix-I-errors.book.slatl" :kind "appendix")
   (:title "Appendix B — Every primitive, one page each" :file "appendix-J-every-primitive.book.slatl" :kind "appendix")
   (:title "Appendix C — Every record type, one page each" :file "appendix-K-every-record-type.book.slatl" :kind "appendix")
   (:title "Appendix D — The full canonicalization ruleset" :file "appendix-L-canonicalization-rules.book.slatl" :kind "appendix")
   (:title "Appendix E — Where slats live in Lacuna" :file "appendix-M-where-slats-live.book.slatl" :kind "appendix")
   (:title "Appendix F — Cortex integration cookbook" :file "appendix-N-cortex-cookbook.book.slatl" :kind "appendix")
   (:title "Appendix G — Signing recipes" :file "appendix-O-signing-recipes.book.slatl" :kind "appendix")
   (:title "Appendix H — Auto-assembly cookbook" :file "appendix-P-auto-assembly-cookbook.book.slatl" :kind "appendix")
   (:title "Appendix I — Networked carts" :file "appendix-Q-networked-carts.book.slatl" :kind "appendix")
   (:title "Appendix 10 — " :file "appendix-S-next-python.book.slatl" :kind "appendix")
   (:title "Appendix 2 — Top 10 language features (the wow layer)" :file "appendix-T-top-10.book.slatl" :kind "appendix")
   (:title "Appendix 4 — Autogen magic (11 verbs)" :file "appendix-U-autogen.book.slatl" :kind "appendix")
   (:title "Appendix 5 — Solving Scheme pain points (9)" :file "appendix-V-pain-points.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
