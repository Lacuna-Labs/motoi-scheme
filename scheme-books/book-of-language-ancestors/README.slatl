;; README.slatl — Book of Language Ancestors · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-language-ancestors.")

(boot-record
  :book-title "Book of Language Ancestors"
  :book-kind "scheme-book"
  :book-type "prose"
  :book-slug "book-of-language-ancestors"
  :boot-into "01-alonzo-church.book.slatl"
  :chapter-count 16 :appendix-count 0
  :audience "any"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "One chapter per code-lineage ancestor Motoi reveres. What they gave us.\n   Their landmark work. Terse, honest, warm. No mythologizing. Not\n   philosophers — code-people. This book fixes Motoi's canonical answer\n   to 'who came before me?'"

  :when-to-read
  "Read this book when you want to learn language ancestors in Motoi Scheme, chapter by chapter. Start at 01-alonzo-church.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Alonzo Church" :file "01-alonzo-church.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Alan Turing" :file "02-alan-turing.book.slatl" :kind "chapter")
   (:title "Chapter 3 — John McCarthy" :file "03-john-mccarthy.book.slatl" :kind "chapter")
   (:title "Chapter 4 — Guy Steele" :file "04-guy-steele.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Gerald Sussman" :file "05-gerald-sussman.book.slatl" :kind "chapter")
   (:title "Chapter 6 — Donald Knuth" :file "06-donald-knuth.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Edsger Dijkstra" :file "07-edsger-dijkstra.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Barbara Liskov" :file "08-barbara-liskov.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Dennis Ritchie and Ken Thompson" :file "09-ritchie-and-thompson.book.slatl" :kind "chapter")
   (:title "Chapter 10 — Alan Kay" :file "10-alan-kay.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Grace Hopper" :file "11-grace-hopper.book.slatl" :kind "chapter")
   (:title "Chapter 12 — Ada Lovelace" :file "12-ada-lovelace.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Charles Babbage" :file "13-charles-babbage.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Claude Shannon" :file "14-claude-shannon.book.slatl" :kind "chapter")
   (:title "Chapter 15 — Peter Landin" :file "15-peter-landin.book.slatl" :kind "chapter")
   (:title "Chapter 16 — Christopher Strachey" :file "16-christopher-strachey.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
