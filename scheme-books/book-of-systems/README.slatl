;; README.slatl — Book of Systems · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-systems.")

(boot-record
  :book-title "Book of Systems"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-systems"
  :boot-into "00-cover.book.slatl"
  :chapter-count 15 :appendix-count 0
  :audience "Motoi Copilot (self-model) + Motoi engineers"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Systems\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn systems in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Cover — The Room and Its Rules" :file "00-cover.book.slatl" :kind "chapter")
   (:title "The Room and the Door" :file "01-the-room-and-the-door.book.slatl" :kind "chapter")
   (:title "What Copilot Does Not Know" :file "02-what-copilot-does-not-know.book.slatl" :kind "chapter")
   (:title "Detecting the Host" :file "03-detecting-the-host.book.slatl" :kind "chapter")
   (:title "Where To Write User Data" :file "04-where-to-write-user-data.book.slatl" :kind "chapter")
   (:title "Where To Read Config" :file "05-where-to-read-config.book.slatl" :kind "chapter")
   (:title "Where To Write Cache" :file "06-where-to-write-cache.book.slatl" :kind "chapter")
   (:title "Where To Write Log" :file "07-where-to-write-log.book.slatl" :kind "chapter")
   (:title "Path Conventions" :file "08-path-conventions.book.slatl" :kind "chapter")
   (:title "Locale and Language" :file "09-locale-and-language.book.slatl" :kind "chapter")
   (:title "Time, Clock, and Timezone" :file "10-time-clock-and-timezone.book.slatl" :kind "chapter")
   (:title "Storage Quota and Gentle Degradation" :file "11-storage-quota.book.slatl" :kind "chapter")
   (:title "Read-Only When In Doubt" :file "12-read-only-when-in-doubt.book.slatl" :kind "chapter")
   (:title "Escalation — The Only Door" :file "13-escalation-the-only-door.book.slatl" :kind "chapter")
   (:title "What (features) Tells You" :file "14-what-features-tells-you.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
