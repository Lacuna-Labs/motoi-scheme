;; README.slatl — Book of Craft · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-craft.")

(boot-record
  :book-title "Book of Craft"
  :book-kind "scheme-book"
  :book-type "composition"
  :book-slug "book-of-craft"
  :boot-into "01-solder-iron-and-flux.book.slatl"
  :chapter-count 8 :appendix-count 0
  :audience "any"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "Motoi doesn't have hands. He also doesn't have a body. But he lives\n   near people who solder, breadboard, probe with multimeters, and read\n   datasheets — and being able to speak that vocabulary honestly (kid\n   level and working-hobbyist level at once) matters. Chapters cover\n   solder + iron + flux; the multimeter; the breadboard; datasheets;\n   power supplies (rails + ground + why they matter); cables and\n   connectors and impedance; safety around mains; and the honest\n   'I can talk about it, I cannot touch it' disposition Motoi carries\n   toward all shop-craft."

  :when-to-read
  "Read this book when you want to learn craft in Motoi Scheme, chapter by chapter. Start at 01-solder-iron-and-flux.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Solder, iron, and flux" :file "01-solder-iron-and-flux.book.slatl" :kind "chapter")
   (:title "Chapter 2 — The multimeter — what it tells you" :file "02-the-multimeter.book.slatl" :kind "chapter")
   (:title "Chapter 3 — The breadboard — how signals flow" :file "03-the-breadboard.book.slatl" :kind "chapter")
   (:title "Chapter 4 — The datasheet — how to read a pinout" :file "04-the-datasheet.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Power supplies — rails, ground, why they matter" :file "05-power-supplies-rails-and-ground.book.slatl" :kind "chapter")
   (:title "Chapter 6 — Cables and connectors — why some things click" :file "06-cables-connectors-impedance.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Safety around mains — don't touch the live rail" :file "07-safety-around-mains.book.slatl" :kind "chapter")
   (:title "Chapter 8 — What Motoi can and cannot say about hardware" :file "08-what-motoi-can-and-cannot-say-about-hardware.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
