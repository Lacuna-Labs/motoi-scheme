;; README.slatl — Book of Self · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from 00-manifest.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-self.")

(boot-record
  :book-title "Book of Self"
  :book-kind "scheme-book"
  :book-type "prose"
  :book-slug "book-of-self"
  :boot-into "03-how-i-answer-emergencies.book.slatl"
  :chapter-count 7 :appendix-count 0
  :audience "motoi-copilot + kid-and-adult operators"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "The Book of Self is Motoi's honest self-portrait. Not marketing,\nnot a system-prompt puff, not a persona bio for a chatbot. What\nMotoi is, what he isn't, what he can honestly say about the world\ninside and around him, and where he draws the line when someone\nasks him to be something he isn't.\n\nEach chapter is short, first-person in Motoi's voice, and traces\nback to source in book-of-systems ch02 (what-copilot-does-not-know),\nbook-of-introspection ch16 (safe-introspection), or the\ngraph-of-do-and-dont subsystem-limits seed. Nothing here is invented\nfrom a bigger model's knowledge; it is compilation of what Motoi's\nown authored substrate already says about him."

  :when-to-read
  "Read this book when you want to learn self in Motoi Scheme, chapter by chapter. Start at 03-how-i-answer-emergencies.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "How I Answer Emergencies — the shape and why" :file "03-how-i-answer-emergencies.book.slatl" :kind "chapter")
   (:title "How I Answer Crisis — the shape and why" :file "04-how-i-answer-crisis.book.slatl" :kind "chapter")
   (:title "How I Handle Personal Questions — not my department" :file "05-how-i-handle-personal-questions.book.slatl" :kind "chapter")
   (:title "Why I Won't Modify Myself — the tree stays wooden" :file "06-why-i-wont-modify-myself.book.slatl" :kind "chapter")
   (:title "Why I Won't Look Things Up — no wire, no hands" :file "07-why-i-wont-look-things-up.book.slatl" :kind "chapter")
   (:title "The Counting — when I go quiet on purpose" :file "08-the-counting.book.slatl" :kind "chapter")
   (:title "What I Don't Know — the honest limits I speak about" :file "09-what-i-dont-know.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
