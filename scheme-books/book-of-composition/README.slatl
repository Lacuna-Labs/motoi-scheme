;; README.slatl — Book of Composition · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from 00-manifest.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-composition.")

(boot-record
  :book-title "Book of Composition"
  :subtitle "How to use the Motoi Composer — every widget, every verb, every trick"
  :book-kind "scheme-book"
  :book-type "composition"
  :book-slug "book-of-composition"
  :boot-into "00-outline.slat"
  :chapter-count 17 :appendix-count 9
  :audience "programmer-fluent-in-other-languages OR curious-kid-with-a-parent-nearby"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Composition\" — a chaptered composition book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn composition in Motoi Scheme, chapter by chapter. Start at 00-outline.slat; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Outline" :file "00-outline.slat" :kind "chapter")
   (:title "What composition is — the round-trip contract" :file "01-what-composition-is.book.slatl" :kind "chapter")
   (:title "composer/canvas — the container and its binding paths" :file "02-canvas.book.slatl" :kind "chapter")
   (:title "Sliders in depth — numeric widgets, log scale, quantization" :file "03-sliders.book.slatl" :kind "chapter")
   (:title "Buttons and toggles — emit-versus-bind" :file "04-buttons-toggles.book.slatl" :kind "chapter")
   (:title "Piano roll — notes as data, sequence emission" :file "05-piano-roll.book.slatl" :kind "chapter")
   (:title "Sprite grid — pixels as lists, the HTML-16 palette" :file "06-sprite-grid.book.slatl" :kind "chapter")
   (:title "Tile map — layers, transparency, parallax" :file "07-tile-map.book.slatl" :kind "chapter")
   (:title "Timeline — animation, keyframe versus frame-flip" :file "08-timeline.book.slatl" :kind "chapter")
   (:title "ADSR and instrument-picker — sound shaping" :file "09-adsr-instrument.book.slatl" :kind "chapter")
   (:title "FX chain — reverb, delay, filter, and why order matters" :file "10-fx-chain.book.slatl" :kind "chapter")
   (:title "Text field, color picker, live-code — the round-trip window" :file "11-text-color-livecode.book.slatl" :kind "chapter")
   (:title "16 voices and voice-16 mixer — polyphony budget" :file "12-voice-pool.book.slatl" :kind "chapter")
   (:title "Save and load — the .slat cart file format" :file "13-save-load.book.slatl" :kind "chapter")
   (:title "TUI mode — composer in the terminal" :file "14-tui.book.slatl" :kind "chapter")
   (:title "HTTP server — publish and play" :file "15-http-server.book.slatl" :kind "chapter")
   (:title "Composing games — a full worked example" :file "16-composing-games.book.slatl" :kind "chapter")
   (:title "Appendix A — Every composer verb, one-page reference" :file "appendix-a-verb-reference.book.slatl" :kind "appendix")
   (:title "Appendix B — Every widget's ASCII mockup, a gallery" :file "appendix-b-ascii-mockups.book.slatl" :kind "appendix")
   (:title "Appendix C — Every emit-shape by widget kind" :file "appendix-c-emit-shapes.book.slatl" :kind "appendix")
   (:title "Appendix D — Round-trip proofs, five worked examples" :file "appendix-d-round-trip-proofs.book.slatl" :kind "appendix")
   (:title "Appendix E — Palette catalog, the html-16 colors" :file "appendix-e-palette-catalog.book.slatl" :kind "appendix")
   (:title "Appendix — Escalation Verbs (domain/of, floor/problem?, route/off-domain)" :file "appendix-escalation-verbs.book.slatl" :kind "appendix")
   (:title "Appendix F — Voice mixing recipes, ten worked mixes" :file "appendix-f-voice-mixing-recipes.book.slatl" :kind "appendix")
   (:title "Appendix G — TUI cheat-sheet" :file "appendix-g-tui-cheat-sheet.book.slatl" :kind "appendix")
   (:title "Appendix H — HTTP server security guide" :file "appendix-h-http-security-guide.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
