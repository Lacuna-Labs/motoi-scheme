;; README.slatl — Book of Computing · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-computing.")

(boot-record
  :book-title "Book of Computing"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-computing"
  :boot-into "01-transistors-and-speak-and-spell.book.slatl"
  :chapter-count 16 :appendix-count 1
  :audience "any"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "Teach computer science through the old machines Motoi reveres. Each\n   chapter names a machine or an era and uses it to teach a CS concept.\n   Runnable Motoi Scheme code demonstrates the concept. Transistors to\n   quantum computing. The Speak & Spell is Chapter 1 because the Speak\n   & Spell is Motoi's north star."

  :when-to-read
  "Read this book when you want to learn computing in Motoi Scheme, chapter by chapter. Start at 01-transistors-and-speak-and-spell.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Transistors and Speak & Spell" :file "01-transistors-and-speak-and-spell.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Logic gates and adders" :file "02-logic-gates-and-adders.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Chip families — TTL, DTL, CMOS" :file "03-chip-families.book.slatl" :kind "chapter")
   (:title "Chapter 4 — Commodore 64 — the 6502, memory, BASIC" :file "04-commodore-64.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Atari 800 — POKEY, ANTIC, sprites" :file "05-atari-800.book.slatl" :kind "chapter")
   (:title "Chapter 6 — Apple IIc and IIGS — expansion, mouse" :file "06-apple-iic-and-iigs.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Amiga — multitasking, custom chips" :file "07-amiga.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Networks — packet switching, TCP/IP, the Internet" :file "08-networks-and-tcp-ip.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Unix — processes, files, terminals, pipes" :file "09-unix.book.slatl" :kind "chapter")
   (:title "Chapter 10 — Distributed systems — RPC, sharding, consistency" :file "10-distributed-systems.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Lambda, closures, functional programming" :file "11-lambda-and-closures.book.slatl" :kind "chapter")
   (:title "Chapter 12 — Compilers and interpreters" :file "12-compilers-and-interpreters.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Databases and storage layers" :file "13-databases-and-storage.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Concurrency, coroutines, async" :file "14-concurrency-and-async.book.slatl" :kind "chapter")
   (:title "Chapter 15 — AI — symbolic, connectionist, language models" :file "15-ai-historical-arc.book.slatl" :kind "chapter")
   (:title "Chapter 16 — Quantum computing — qubits, gates, entanglement" :file "16-quantum-computing.book.slatl" :kind "chapter")
   (:title "Appendix B — Chemistry Primitives (chem/*)" :file "appendix-b-chemistry-primitives.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
