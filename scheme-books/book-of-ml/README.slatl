;; README.slatl — Book of ML · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-ml.")

(boot-record
  :book-title "Book of ML"
  :subtitle "Build a language model from first principles, in Scheme, on your machine"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-ml"
  :boot-into "01-numbers-and-tensors.book.slatl"
  :chapter-count 16 :appendix-count 4
  :audience "kid-and-adult operators, curious programmers"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of ML\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn ml in Motoi Scheme, chapter by chapter. Start at 01-numbers-and-tensors.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Numbers, tensors, and how a computer counts things" :file "01-numbers-and-tensors.book.slatl" :kind "chapter")
   (:title "Vectors and the dot product" :file "02-vectors-and-dot-product.book.slatl" :kind "chapter")
   (:title "Matrices and matrix-vector multiplication" :file "03-matrices-and-matvec.book.slatl" :kind "chapter")
   (:title "Functions of functions — the composition is the network" :file "04-functions-of-functions.book.slatl" :kind "chapter")
   (:title "What is a model — from a line to a curve" :file "05-what-is-a-model.book.slatl" :kind "chapter")
   (:title "Gradient descent by hand" :file "06-gradient-descent.book.slatl" :kind "chapter")
   (:title "A single neuron" :file "07-single-neuron.book.slatl" :kind "chapter")
   (:title "A layer, then two layers" :file "08-a-layer-then-two.book.slatl" :kind "chapter")
   (:title "Backpropagation from calculus first-principles" :file "09-backpropagation.book.slatl" :kind "chapter")
   (:title "The training loop" :file "10-training-loop.book.slatl" :kind "chapter")
   (:title "Tokens and embeddings" :file "11-tokens-and-embeddings.book.slatl" :kind "chapter")
   (:title "Attention as a soft-lookup" :file "12-attention.book.slatl" :kind "chapter")
   (:title "A transformer block" :file "13-transformer-block.book.slatl" :kind "chapter")
   (:title "Positional encoding and causal masking" :file "14-positional-encoding-and-masking.book.slatl" :kind "chapter")
   (:title "Stacking blocks and tokenization" :file "15-stacking-blocks-and-tokenization.book.slatl" :kind "chapter")
   (:title "The tiny LLM" :file "16-the-tiny-llm.book.slatl" :kind "chapter")
   (:title "The math prerequisites, in Motoi voice" :file "appendix-a-math-prerequisites.book.slatl" :kind "appendix")
   (:title "The philosophy of the field — Turing to attention" :file "appendix-b-philosophy-of-the-field.book.slatl" :kind "appendix")
   (:title "Why LLMs hallucinate" :file "appendix-c-why-llms-hallucinate.book.slatl" :kind "appendix")
   (:title "What you built vs. what I am" :file "appendix-d-what-you-built-vs-what-i-am.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
