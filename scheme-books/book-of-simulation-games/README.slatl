;; README.slatl — Book of Simulation Games · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-simulation-games.")

(boot-record
  :book-title "Book of Simulation Games"
  :book-kind "scheme-book"
  :book-type "application"
  :book-slug "book-of-simulation-games"
  :boot-into "ch01-one-body-two-bodies-many.book.slatl"
  :chapter-count 16 :appendix-count 12
  :audience {"name":":kid"}
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Simulation Games\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn simulation games in Motoi Scheme, chapter by chapter. Start at ch01-one-body-two-bodies-many.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "One Body, Two Bodies, Many" :file "ch01-one-body-two-bodies-many.book.slatl" :kind "chapter")
   (:title "Springs, Chains, Cloth" :file "ch02-springs-chains-cloth.book.slatl" :kind "chapter")
   (:title "The Pendulum and the Lagrangian" :file "ch03-pendulum-and-lagrangian.book.slatl" :kind "chapter")
   (:title "Orbits: Two-Body to Three-Body" :file "ch04-orbits-two-body-to-three-body.book.slatl" :kind "chapter")
   (:title "Boids: Alignment, Cohesion, Separation" :file "ch05-boids.book.slatl" :kind "chapter")
   (:title "Pathfinding on a Grid" :file "ch06-pathfinding-on-a-grid.book.slatl" :kind "chapter")
   (:title "The Brachistochrone" :file "ch07-brachistochrone.book.slatl" :kind "chapter")
   (:title "Cellular Automata" :file "ch08-cellular-automata.book.slatl" :kind "chapter")
   (:title "Particle Systems" :file "ch09-particle-systems.book.slatl" :kind "chapter")
   (:title "Fluid Sketches" :file "ch10-fluid-sketches.book.slatl" :kind "chapter")
   (:title "The RLC Circuit and the World's Damping" :file "ch11-rlc-circuit-and-worlds-damping.book.slatl" :kind "chapter")
   (:title "Game Theory: Nim, Wythoff, Grundy" :file "ch12-game-theory-nim-wythoff-grundy.book.slatl" :kind "chapter")
   (:title "Topology of Motion" :file "ch13-topology-of-motion.book.slatl" :kind "chapter")
   (:title "Autonomous Agents That Learn" :file "ch14-autonomous-agents-that-learn.book.slatl" :kind "chapter")
   (:title "The Simulation IS the Game" :file "ch15-simulation-is-the-game.book.slatl" :kind "chapter")
   (:title "Publish the Simulation" :file "ch16-publish-the-simulation.book.slatl" :kind "chapter")
   (:title "The Integrator Zoo" :file "appendix-a-integrator-zoo.book.slatl" :kind "appendix")
   (:title "Dimensional Analysis with phys/q*" :file "appendix-b-dimensional-analysis.book.slatl" :kind "appendix")
   (:title "Flocking Parameter Space" :file "appendix-c-flocking-parameter-space.book.slatl" :kind "appendix")
   (:title "The Brachistochrone Family" :file "appendix-d-brachistochrone-family.book.slatl" :kind "appendix")
   (:title "Conway Patterns Field Guide" :file "appendix-e-conway-patterns.book.slatl" :kind "appendix")
   (:title "Springs and Cloth Tuning" :file "appendix-f-springs-cloth-tuning.book.slatl" :kind "appendix")
   (:title "Combinatorial Games Beyond Nim" :file "appendix-g-combinatorial-games-beyond-nim.book.slatl" :kind "appendix")
   (:title "Reading topo/persistence Diagrams" :file "appendix-h-reading-topo-persistence.book.slatl" :kind "appendix")
   (:title "The n-body Solar System Kit" :file "appendix-i-nbody-solar-system-kit.book.slatl" :kind "appendix")
   (:title "Emergent Behavior — a Case Study Collection" :file "appendix-j-emergent-behavior-case-studies.book.slatl" :kind "appendix")
   (:title "Deterministic Chaos" :file "appendix-k-deterministic-chaos.book.slatl" :kind "appendix")
   (:title "Sim vs Game — When to Add a Score" :file "appendix-l-sim-vs-game-when-to-add-a-score.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
