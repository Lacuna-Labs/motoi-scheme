;; README.slatl — Book of Animation · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.book.slatl
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-animation.")

(boot-record
  :book-title "Book of Animation"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-animation"
  :boot-into "ch01-surface.book.slatl"
  :chapter-count 16 :appendix-count 7
  :audience "kid"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Animation\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order. The prose (animation history, principles, vector/easing/curve reasoning) is authoritative. NOTE: most runnable examples target a Curator render/sim substrate (paint-cell, big-bang, world/*, entity/*, camera-*, scene/*, prefab/*, part/*, ai/*) that base Motoi Scheme does not provide; those blocks carry a needs-alfred marker and do NOT run through ./bin/motoi until that substrate is wired. Blocks using only base verbs (vec/*, easing/*, curve/*, R7RS, SRFI-1) and the headless display stubs do run."

  :when-to-read
  "Read this book when you want to learn animation in Motoi Scheme, chapter by chapter. Start at ch01-surface.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1: The Surface" :file "ch01-surface.book.slatl" :kind "chapter")
   (:title "Chapter 2: The Language" :file "ch02-language.book.slatl" :kind "chapter")
   (:title "Chapter 3: The Flower" :file "ch03-flower.book.slatl" :kind "chapter")
   (:title "Chapter 4: Vectors" :file "ch04-vectors.book.slatl" :kind "chapter")
   (:title "Chapter 5: Forces" :file "ch05-forces.book.slatl" :kind "chapter")
   (:title "Chapter 6: Oscillation" :file "ch06-oscillation.book.slatl" :kind "chapter")
   (:title "Chapter 7: Particles" :file "ch07-particles.book.slatl" :kind "chapter")
   (:title "Chapter 8: Bodies" :file "ch08-bodies.book.slatl" :kind "chapter")
   (:title "Chapter 9: Locomotion" :file "ch09-locomotion.book.slatl" :kind "chapter")
   (:title "Chapter 10: Steering" :file "ch10-steering.book.slatl" :kind "chapter")
   (:title "Chapter 11: Flocking" :file "ch11-flocking.book.slatl" :kind "chapter")
   (:title "Chapter 12: Wayfinding" :file "ch12-wayfinding.book.slatl" :kind "chapter")
   (:title "Chapter 13: Scenes" :file "ch13-scenes.book.slatl" :kind "chapter")
   (:title "Chapter 14: The Camera" :file "ch14-camera.book.slatl" :kind "chapter")
   (:title "Chapter 15: The Director" :file "ch15-director.book.slatl" :kind "chapter")
   (:title "Chapter 16: The Living Garden" :file "ch16-living-garden.book.slatl" :kind "chapter")
   (:title "appendix-07-norman-mclaren" :file "appendix-07-norman-mclaren.book.slatl" :kind "appendix")
   (:title "Appendix D — Cross-reference Index" :file "appendix-d-cross-reference-index.book.slatl" :kind "appendix")
   (:title "Appendix D — Animating Emoji, Text, and Composed Motion" :file "appendix-d-emoji-and-text.book.slatl" :kind "appendix")
   (:title "Appendix E — Glossary" :file "appendix-e-glossary.book.slatl" :kind "appendix")
   (:title "Appendix — The Verbs Cookbook" :file "appendix-verbs-cookbook.book.slatl" :kind "appendix")
   (:title "Appendix X — Emoji + Easing Cheat-Sheet" :file "appendix-x-emoji-easing-cheatsheet.book.slatl" :kind "appendix")
   (:title "Appendix Y — Tick extras (2026-07-22)" :file "appendix-y-tick-extras-2026-07-22.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
