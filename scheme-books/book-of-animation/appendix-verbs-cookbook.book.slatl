(chapter
  :voice                motoi-copilot
  :book             "Book of Animation"
  :chapter-number   null
  :title            "Appendix — The Verbs Cookbook"
  :source-path      "authored/2026-07-17/book-fill-lane"
  :status           "book-fill-authored-2026-07-17"
  :provenance       ((:authored-by "book-fill-lane-2026-07-17")
                     (:edit-source "MOTOI-3.0-GAP-CLOSURE-PLAN-2026-07-18" :gap "graphics-confabulation-paint-cell-arity" :date "2026-07-18"))
