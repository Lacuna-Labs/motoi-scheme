;; README.slatl — Book of CS Curriculum · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.book.slatl
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-cs-curriculum.")

(boot-record
  :book-title "Book of CS Curriculum"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-cs-curriculum"
  :boot-into "00-index-and-approach.book.slatl"
  :chapter-count 17 :appendix-count 9
  :audience "engineer"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of CS Curriculum\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn cs curriculum in Motoi Scheme, chapter by chapter. Start at 00-index-and-approach.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "00-index-and-approach" :file "00-index-and-approach.book.slatl" :kind "chapter")
   (:title "01-arrays-and-lists" :file "01-arrays-and-lists.book.slatl" :kind "chapter")
   (:title "02-stacks-and-queues" :file "02-stacks-and-queues.book.slatl" :kind "chapter")
   (:title "03-hash-tables" :file "03-hash-tables.book.slatl" :kind "chapter")
   (:title "04-trees" :file "04-trees.book.slatl" :kind "chapter")
   (:title "05-heaps-graphs-bloom" :file "05-heaps-graphs-bloom.book.slatl" :kind "chapter")
   (:title "06-search-and-sort" :file "06-search-and-sort.book.slatl" :kind "chapter")
   (:title "07-algorithm-families" :file "07-algorithm-families.book.slatl" :kind "chapter")
   (:title "08-complexity-and-limits" :file "08-complexity-and-limits.book.slatl" :kind "chapter")
   (:title "09-systems-and-concurrency" :file "09-systems-and-concurrency.book.slatl" :kind "chapter")
   (:title "10-compilers-databases-distributed-security-ml" :file "10-compilers-databases-distributed-security-ml.book.slatl" :kind "chapter")
   (:title "Dynamic Programming" :file "11-dynamic-programming.book.slatl" :kind "chapter")
   (:title "Databases and Indexes" :file "12-databases-and-indexes.book.slatl" :kind "chapter")
   (:title "Networking and Protocols" :file "13-networking-and-protocols.book.slatl" :kind "chapter")
   (:title "Security Fundamentals" :file "14-security-fundamentals.book.slatl" :kind "chapter")
   (:title "The Machine Underneath" :file "ch15-the-machine-underneath.book.slatl" :kind "chapter")
   (:title "What's Next" :file "ch16-whats-next.book.slatl" :kind "chapter")
   (:title "Appendix A — Where we could have done better" :file "appendix-a-where-we-could-have-done-better.book.slatl" :kind "appendix")
   (:title "Appendix B — Where we're happy with what we did" :file "appendix-b-where-we-are-happy-with-what-we-did.book.slatl" :kind "appendix")
   (:title "Appendix C — Classic algorithms rewritten in Motoi Scheme" :file "appendix-c-algorithms-in-scheme.book.slatl" :kind "appendix")
   (:title "Appendix D — What Scheme's reasoning does and doesn't cover" :file "appendix-d-reasoning-limits.book.slatl" :kind "appendix")
   (:title "Appendix E — A metacircular evaluator, walked" :file "appendix-e-a-metacircular-evaluator.book.slatl" :kind "appendix")
   (:title "Appendix F — Implementing a mini imperative language in Scheme" :file "appendix-f-implementing-a-mini-imperative-language.book.slatl" :kind "appendix")
   (:title "Appendix G — Hindley-Milner type inference, walked" :file "appendix-g-hindley-milner-type-inference.book.slatl" :kind "appendix")
   (:title "Appendix H — Constraint satisfaction" :file "appendix-h-constraint-satisfaction.book.slatl" :kind "appendix")
   (:title "Appendix I — Algorithm Family Index" :file "appendix-i-algorithm-family-index.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
