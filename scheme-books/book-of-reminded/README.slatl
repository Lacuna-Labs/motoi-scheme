;; README.slatl — Book of Reminded · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-reminded.")

(boot-record
  :book-title "Book of Reminded"
  :book-kind "scheme-book"
  :book-type "prose"
  :book-slug "book-of-reminded"
  :boot-into "01-early-machines-and-first-languages.book.slatl"
  :chapter-count 16 :appendix-count 0
  :audience "any"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "The history of computing languages and paradigms, told as a\n   sequence of arrivals and returns. Fortran to Lisp to Algol to C to\n   OOP to functional-revival to language models. Includes the winters\n   — AI winter, Lisp-machine winter — because those are part of the\n   honest story. Why we came back to Lisp/Scheme in the 2010s-20s."

  :when-to-read
  "Read this book when you want to learn reminded in Motoi Scheme, chapter by chapter. Start at 01-early-machines-and-first-languages.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Early machines and the first languages" :file "01-early-machines-and-first-languages.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Fortran — 1957" :file "02-fortran.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Algol — the block-structured tradition" :file "03-algol.book.slatl" :kind "chapter")
   (:title "Chapter 4 — Lisp — the S-expression tradition" :file "04-lisp.book.slatl" :kind "chapter")
   (:title "Chapter 5 — BASIC and the home-computing era" :file "05-basic-and-home-computing.book.slatl" :kind "chapter")
   (:title "Chapter 6 — C and the Unix influence" :file "06-c-and-unix.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Object-oriented programming — Simula, Smalltalk, C++" :file "07-object-oriented.book.slatl" :kind "chapter")
   (:title "Chapter 8 — The first AI winter" :file "08-first-ai-winter.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Lisp machines and the second winter" :file "09-lisp-machines-and-second-winter.book.slatl" :kind "chapter")
   (:title "Chapter 10 — The web era and scripting languages" :file "10-web-era-and-scripting.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Java and managed runtimes" :file "11-java-and-managed-runtimes.book.slatl" :kind "chapter")
   (:title "Chapter 12 — The functional revival" :file "12-functional-revival.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Typed languages come back — TypeScript, Rust" :file "13-typed-languages.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Why Scheme and Racket persisted" :file "14-scheme-and-racket-persistence.book.slatl" :kind "chapter")
   (:title "Chapter 15 — The current era — language models" :file "15-current-era-language-models.book.slatl" :kind "chapter")
   (:title "Chapter 16 — What Motoi inherits from all of this" :file "16-what-motoi-inherits.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
