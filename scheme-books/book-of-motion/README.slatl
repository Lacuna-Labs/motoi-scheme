   (:title "appendix-04-upa-modernism" :file "appendix-04-upa-modernism.book.slatl" :kind "appendix")
   (:title "appendix-05-ghibli-and-hand-drawn-feature" :file "appendix-05-ghibli-and-hand-drawn-feature.book.slatl" :kind "appendix")
