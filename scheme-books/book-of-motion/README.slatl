;; README.slatl — Book of Motion · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-motion.")

(boot-record
  :book-title "Book of Motion"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-motion"
  :boot-into "00-cover.book.slatl"
  :chapter-count 23 :appendix-count 11
  :audience "kid"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Motion\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn motion in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "The Book of Motion" :file "00-cover.book.slatl" :kind "chapter")
   (:title "Chapter 1: The Still Frame" :file "ch01-the-still-frame.book.slatl" :kind "chapter")
   (:title "Chapter 2: Velocity" :file "ch02-velocity.book.slatl" :kind "chapter")
   (:title "Chapter 3: Easing" :file "ch03-easing.book.slatl" :kind "chapter")
   (:title "Chapter 4: The Arc" :file "ch04-the-arc.book.slatl" :kind "chapter")
   (:title "Chapter 5: Timing" :file "ch05-timing.book.slatl" :kind "chapter")
   (:title "Chapter 6: Weight & Embodiment" :file "ch06-weight.book.slatl" :kind "chapter")
   (:title "Chapter 7: Squash & Stretch" :file "ch07-squash-stretch.book.slatl" :kind "chapter")
   (:title "Chapter 8: Oscillation" :file "ch08-oscillation.book.slatl" :kind "chapter")
   (:title "Chapter 9: Forces" :file "ch09-forces.book.slatl" :kind "chapter")
   (:title "Chapter 10: Locomotion" :file "ch10-locomotion.book.slatl" :kind "chapter")
   (:title "Chapter 11: Gesture & Expression" :file "ch11-gesture.book.slatl" :kind "chapter")
   (:title "Chapter 12: Secondary Motion" :file "ch12-secondary-motion.book.slatl" :kind "chapter")
   (:title "Chapter 13: Style" :file "ch13-style.book.slatl" :kind "chapter")
   (:title "Chapter 14: Blending Motions" :file "ch14-blending.book.slatl" :kind "chapter")
   (:title "Chapter 15: The Crowd" :file "ch15-the-crowd.book.slatl" :kind "chapter")
   (:title "Chapter 16: The Living Scene" :file "ch16-the-living-scene.book.slatl" :kind "chapter")
   (:title "ch17-animation-history-part-one" :file "ch17-animation-history-part-one.book.slatl" :kind "chapter")
   (:title "ch18-animation-history-part-two" :file "ch18-animation-history-part-two.book.slatl" :kind "chapter")
   (:title "ch19-keyframes-and-inbetweens" :file "ch19-keyframes-and-inbetweens.book.slatl" :kind "chapter")
   (:title "ch20-how-emotion-animates" :file "ch20-how-emotion-animates.book.slatl" :kind "chapter")
   (:title "ch21-good-vs-bad-animation" :file "ch21-good-vs-bad-animation.book.slatl" :kind "chapter")
   (:title "ch22-narrative-arc-in-motion" :file "ch22-narrative-arc-in-motion.book.slatl" :kind "chapter")
   (:title "appendix-01-winsor-mccay-gertie" :file "appendix-01-winsor-mccay-gertie.book.slatl" :kind "appendix")
