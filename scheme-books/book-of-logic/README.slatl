;; README.slatl — Book of Logic · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-logic.")

(boot-record
  :book-title "Book of Logic"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-logic"
  :boot-into "01-propositional-logic.book.slatl"
  :chapter-count 15 :appendix-count 9
  :audience "adult"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Logic\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn logic in Motoi Scheme, chapter by chapter. Start at 01-propositional-logic.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Propositional Logic in Motoi Scheme" :file "01-propositional-logic.book.slatl" :kind "chapter")
   (:title "Predicate Logic (First-Order)" :file "02-predicate-logic.book.slatl" :kind "chapter")
   (:title "Proof Strategies and Natural Deduction" :file "03-proof-strategies-and-natural-deduction.book.slatl" :kind "chapter")
   (:title "Untyped Lambda Calculus" :file "04-untyped-lambda-calculus.book.slatl" :kind "chapter")
   (:title "Simply Typed Lambda Calculus" :file "05-simply-typed-lambda-calculus.book.slatl" :kind "chapter")
   (:title "System F — Polymorphism" :file "06-system-f.book.slatl" :kind "chapter")
   (:title "Constructive Logic and Curry-Howard" :file "07-constructive-logic-curry-howard.book.slatl" :kind "chapter")
   (:title "Propositions as Types, Worked" :file "08-propositions-as-types-worked.book.slatl" :kind "chapter")
   (:title "Modal Logic — S4 and S5" :file "09-modal-logic.book.slatl" :kind "chapter")
   (:title "Temporal Logic and Little Model Checkers" :file "10-temporal-logic.book.slatl" :kind "chapter")
   (:title "Linear Logic — Resources That Get Used" :file "11-linear-logic.book.slatl" :kind "chapter")
   (:title "Category Theory as Logic" :file "12-category-theory-as-logic.book.slatl" :kind "chapter")
   (:title "Non-Monotonic and Default Logic" :file "13-non-monotonic-and-default-logic.book.slatl" :kind "chapter")
   (:title "Probabilistic and Fuzzy Logic" :file "14-probabilistic-and-fuzzy-logic.book.slatl" :kind "chapter")
   (:title "Closing — Logic Composed with Reason-Code" :file "16-closing-composition.book.slatl" :kind "chapter")
   (:title "A Tiny Proof Assistant in Scheme" :file "appendix-A-proof-assistant-in-scheme.book.slatl" :kind "appendix")
   (:title "Unification — Robinson and Martelli-Montanari" :file "appendix-B-unification.book.slatl" :kind "appendix")
   (:title "Resolution" :file "appendix-C-resolution.book.slatl" :kind "appendix")
   (:title "SAT and SMT Lite — DPLL by Hand" :file "appendix-D-sat-and-smt-lite.book.slatl" :kind "appendix")
   (:title "Decision Procedures" :file "appendix-E-decision-procedures.book.slatl" :kind "appendix")
   (:title "Natural Deduction Tree Renderer" :file "appendix-F-natural-deduction-tree-renderer.book.slatl" :kind "appendix")
   (:title "Category Theory Diagram Renderer" :file "appendix-G-category-diagram-renderer.book.slatl" :kind "appendix")
   (:title "Common Desktop Tasks Under a Logic Lens" :file "appendix-H-desktop-tasks-under-logic-lens.book.slatl" :kind "appendix")
   (:title "Deductive Error Introspection — errors as propositions, the census as evidence" :file "appendix-I-deductive-error-introspection.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
