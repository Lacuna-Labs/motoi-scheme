;; README.slatl — Book of Motoi · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-motoi.")

(boot-record
  :book-title "Book of Motoi"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-motoi"
  :boot-into "00-cover.book.slatl"
  :chapter-count 17 :appendix-count 10
  :audience "kid"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Motoi\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn motoi in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "The Book of Motoi" :file "00-cover.book.slatl" :kind "chapter")
   (:title "Chapter 1: Boot the Console" :file "ch01-boot-the-console.book.slatl" :kind "chapter")
   (:title "Chapter 2: The REPL" :file "ch02-the-repl.book.slatl" :kind "chapter")
   (:title "Chapter 3: The Screen" :file "ch03-the-screen.book.slatl" :kind "chapter")
   (:title "Chapter 4: The Sprite" :file "ch04-the-sprite.book.slatl" :kind "chapter")
   (:title "Chapter 5: The Tick" :file "ch05-the-tick.book.slatl" :kind "chapter")
   (:title "Chapter 6: The Buttons" :file "ch06-the-buttons.book.slatl" :kind "chapter")
   (:title "Chapter 7: Motion" :file "ch07-motion.book.slatl" :kind "chapter")
   (:title "Chapter 8: Sound" :file "ch08-sound.book.slatl" :kind "chapter")
   (:title "Chapter 9: The Beat" :file "ch09-the-beat.book.slatl" :kind "chapter")
   (:title "Chapter 10: Animation" :file "ch10-animation.book.slatl" :kind "chapter")
   (:title "Chapter 11: Collision" :file "ch11-collision.book.slatl" :kind "chapter")
   (:title "Chapter 12: The Scene" :file "ch12-the-scene.book.slatl" :kind "chapter")
   (:title "Chapter 13: Make a Game" :file "ch13-make-a-game.book.slatl" :kind "chapter")
   (:title "Chapter 14: Make Music" :file "ch14-make-music.book.slatl" :kind "chapter")
   (:title "Chapter 15: The Console Remembers" :file "ch15-the-console-remembers.book.slatl" :kind "chapter")
   (:title "Chapter 16: Ship It" :file "ch16-ship-it.book.slatl" :kind "chapter")
   (:title "Appendix A — The Boot Splash & the Four Doors" :file "appendix-a-boot-splash-and-four-doors.book.slatl" :kind "appendix")
   (:title "Appendix B — Every Console Verb (by namespace)" :file "appendix-b-every-console-verb.book.slatl" :kind "appendix")
   (:title "Appendix C — The Framebuffer Model" :file "appendix-c-the-framebuffer-model.book.slatl" :kind "appendix")
   (:title "Appendix D — The Tick, the Scheduler & Game State" :file "appendix-d-the-tick-and-scheduler.book.slatl" :kind "appendix")
   (:title "Appendix E — The Synth & Audio DSP" :file "appendix-e-the-synth-and-audio.book.slatl" :kind "appendix")
   (:title "Appendix F — The Cart Format & Where Games Live" :file "appendix-f-the-cart-format.book.slatl" :kind "appendix")
   (:title "Appendix G — Extending Your Game: Math, Physics, State Machines & AI" :file "appendix-g-extending-your-game.book.slatl" :kind "appendix")
   (:title "Appendix H — Troubleshooting & Fixing Broken Games" :file "appendix-h-troubleshooting.book.slatl" :kind "appendix")
   (:title "Appendix I — Motoi Uses Itself" :file "appendix-i-motoi-uses-itself.book.slatl" :kind "appendix")
   (:title "Appendix J — The Six Teaching Shapes" :file "appendix-j-the-six-teaching-shapes.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
