;; README.slatl — Book of Your Own Dialect · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.book.slatl
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-your-own-dialect.")

(boot-record
  :book-title "Book of Your Own Dialect"
  :subtitle "Knowing the edge of your language: not-my-verb recognition, reference-grounding, hallucination recovery, pushback-and-reasoning that always ends at the registry and a self-test, debugging from the real error, and remembering the outcome."
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-your-own-dialect"
  :boot-into "ch01-these-are-not-your-verbs.book.slatl"
  :chapter-count 16 :appendix-count 8
  :audience "programmer-learning-motoi"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "A full-length Motoi Scheme book that teaches the model where the edge of its\n   own language is, and what to do at that edge. When a verb isn't Motoi's —\n   because it belongs to Racket or R6RS, or was simply invented — the correct\n   move is not panic or refusal but to recognize 'that is not my verb', check\n   the reference, and recover to the real analog. From there the book builds the\n   full behavioral loop: accept pushback rather than dig in; track why you were\n   wrong, or explain grounded when the pushback itself is mistaken; reason three\n   ways (deduce / induct / abduct) but never treat reasoning as the last word;\n   ALWAYS verify against the registry plus a tiny self-test through the\n   interpreter (reasoning proposes, the run disposes); debug from the real\n   error; and remember the outcome so the same case does not recur. This\n   composes Motoi's honest-null doctrine (a boundary is positive signal) with a\n   Wittgenstein-limit framing: the edge of the language teaches the language."

  :when-to-read
  "Read this book when you want to learn your own dialect in Motoi Scheme, chapter by chapter. Start at ch01-these-are-not-your-verbs.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — These Are Not Your Verbs" :file "ch01-these-are-not-your-verbs.book.slatl" :kind "chapter")
   (:title "Chapter 2 — What Motoi Actually Is" :file "ch02-what-motoi-actually-is.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Check the Reference, Not Your Memory" :file "ch03-check-the-reference.book.slatl" :kind "chapter")
   (:title "Chapter 4 — The Standards Boundary" :file "ch04-the-standards-boundary.book.slatl" :kind "chapter")
   (:title "Chapter 5 — I Am Not That Language" :file "ch05-i-am-not-that-language.book.slatl" :kind "chapter")
   (:title "Chapter 6 — Do You Have Verb X?" :file "ch06-do-you-have-verb-x.book.slatl" :kind "chapter")
   (:title "Chapter 7 — When You Hallucinate a Verb, Recover" :file "ch07-hallucination-recovery.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Swapped Pairs and Both Directions" :file "ch08-swapped-pairs-and-reversals.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Pushback, Reasoning, and Remembering" :file "ch09-pushback-reasoning-remembering.book.slatl" :kind "chapter")
   (:title "Chapter 10 — Deduce, Induct, Abduct — Then Verify" :file "ch10-deduce-induct-abduct-then-verify.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Debugging From the Real Error" :file "ch11-debugging-from-the-real-error.book.slatl" :kind "chapter")
   (:title "Chapter 12 — The Console Remembers" :file "ch12-the-console-remembers.book.slatl" :kind "chapter")
   (:title "Chapter 13 — A Place to Start: Preseeded Local Memory" :file "ch13-preseeded-local-memory.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Reminders and Not Repeating Mistakes" :file "ch14-reminders-and-not-repeating.book.slatl" :kind "chapter")
   (:title "Chapter 15 — Honest Null as Signal" :file "ch15-honest-null-as-signal.book.slatl" :kind "chapter")
   (:title "Chapter 16 — Putting It Together" :file "ch16-putting-it-together.book.slatl" :kind "chapter")
   (:title "Appendix A — The Not-My-Verb Catalog" :file "appendix-a-not-my-verb-catalog.book.slatl" :kind "appendix")
   (:title "Appendix B — Multi-Dialect Phrasebook" :file "appendix-b-multi-dialect-phrasebook.book.slatl" :kind "appendix")
   (:title "Appendix C — Real-Analog Table" :file "appendix-c-real-analog-table.book.slatl" :kind "appendix")
   (:title "Appendix D — The Cortex Memory Verb Reference" :file "appendix-d-cortex-memory-verb-reference.book.slatl" :kind "appendix")
   (:title "Appendix E — Reasoning-Mode Worked Examples" :file "appendix-e-reasoning-mode-examples.book.slatl" :kind "appendix")
   (:title "Appendix F — Debugging Playbook" :file "appendix-f-debugging-playbook.book.slatl" :kind "appendix")
