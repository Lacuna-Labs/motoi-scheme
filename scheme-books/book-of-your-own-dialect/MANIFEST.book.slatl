;; MANIFEST.book.slatl
;; Book of Your Own Dialect — canonical book-level manifest
;; Authored 2026-07-30

(book-manifest
  :book-type "learning"
  :book              "Book of Your Own Dialect"
  :slug              "book-of-your-own-dialect"
  :dialect           "motoi"
  :audience          "programmer-learning-motoi"
  :arc               "know-your-boundary-reason-verify-and-remember"
  :chapter-count     16
  :appendix-count    8
  :status            "authored"
  :date-authored     "2026-07-30"
  :training-eligible #t
  :confidentiality   "public"
  :voice             "motoi-copilot"
  :subtitle          "Knowing the edge of your language: not-my-verb recognition, reference-grounding, hallucination recovery, pushback-and-reasoning that always ends at the registry and a self-test, debugging from the real error, and remembering the outcome."

  :what-this-is
  "A full-length Motoi Scheme book that teaches the model where the edge of its
   own language is, and what to do at that edge. When a verb isn't Motoi's —
   because it belongs to Racket or R6RS, or was simply invented — the correct
   move is not panic or refusal but to recognize 'that is not my verb', check
   the reference, and recover to the real analog. From there the book builds the
   full behavioral loop: accept pushback rather than dig in; track why you were
   wrong, or explain grounded when the pushback itself is mistaken; reason three
   ways (deduce / induct / abduct) but never treat reasoning as the last word;
   ALWAYS verify against the registry plus a tiny self-test through the
   interpreter (reasoning proposes, the run disposes); debug from the real
   error; and remember the outcome so the same case does not recur. This
   composes Motoi's honest-null doctrine (a boundary is positive signal) with a
   Wittgenstein-limit framing: the edge of the language teaches the language."

  :chapters
    ((:number  1 :file "ch01-these-are-not-your-verbs.book.slatl"          :title "These Are Not Your Verbs")
     (:number  2 :file "ch02-what-motoi-actually-is.book.slatl"            :title "What Motoi Actually Is")
     (:number  3 :file "ch03-check-the-reference.book.slatl"               :title "Check the Reference, Not Your Memory")
     (:number  4 :file "ch04-the-standards-boundary.book.slatl"            :title "The Standards Boundary")
     (:number  5 :file "ch05-i-am-not-that-language.book.slatl"            :title "I Am Not That Language")
     (:number  6 :file "ch06-do-you-have-verb-x.book.slatl"                :title "Do You Have Verb X?")
     (:number  7 :file "ch07-hallucination-recovery.book.slatl"            :title "When You Hallucinate a Verb, Recover")
     (:number  8 :file "ch08-swapped-pairs-and-reversals.book.slatl"       :title "Swapped Pairs and Both Directions")
     (:number  9 :file "ch09-pushback-reasoning-remembering.book.slatl"    :title "Pushback, Reasoning, and Remembering")
     (:number 10 :file "ch10-deduce-induct-abduct-then-verify.book.slatl"  :title "Deduce, Induct, Abduct — Then Verify")
     (:number 11 :file "ch11-debugging-from-the-real-error.book.slatl"     :title "Debugging From the Real Error")
     (:number 12 :file "ch12-the-console-remembers.book.slatl"             :title "The Console Remembers")
     (:number 13 :file "ch13-preseeded-local-memory.book.slatl"            :title "A Place to Start: Preseeded Local Memory")
     (:number 14 :file "ch14-reminders-and-not-repeating.book.slatl"       :title "Reminders and Not Repeating Mistakes")
     (:number 15 :file "ch15-honest-null-as-signal.book.slatl"             :title "Honest Null as Signal")
     (:number 16 :file "ch16-putting-it-together.book.slatl"               :title "Putting It Together"))

  :appendices
    ((:id "A" :file "appendix-a-not-my-verb-catalog.book.slatl"            :title "Not-My-Verb Catalog")
     (:id "B" :file "appendix-b-multi-dialect-phrasebook.book.slatl"       :title "Multi-Dialect Phrasebook")
     (:id "C" :file "appendix-c-real-analog-table.book.slatl"              :title "Real-Analog Table")
     (:id "D" :file "appendix-d-cortex-memory-verb-reference.book.slatl"   :title "Cortex Memory Verb Reference")
     (:id "E" :file "appendix-e-reasoning-mode-examples.book.slatl"        :title "Reasoning-Mode Examples")
     (:id "F" :file "appendix-f-debugging-playbook.book.slatl"             :title "Debugging Playbook")
     (:id "G" :file "appendix-g-reference-grounding-drills.book.slatl"     :title "Reference-Grounding Drills")
     (:id "H" :file "appendix-h-pushback-dialogues.book.slatl"             :title "Pushback Dialogues"))

  :provenance
    (:merged-from ()
     :notes "Authored 2026-07-30 per the not-my-verb / hallucination-recovery /
             self-correction-loop directive, then depth-expanded to full length
             (over 300 pages) by adding worked runnable cases, live dialogues,
             contrast pairs, deeper WHY prose, and broader enumeration — never
             padding. Every runnable ```scheme fence grades 0 FAIL against the
             live interpreter.")

  :reading-order
    ("Read in order ch01 -> ch16, then the appendices as reference.
      PART I — the boundary (ch01-ch08): ch01 draws the boundary (these are not
      your verbs); ch02 says positively what Motoi IS (R7RS-small + the named
      SRFI parts, batteries-included, no import/module); ch03 grounds truth in
      the reference, not memory; ch04 fixes the standards boundary (R5RS/R6RS/
      Racket vs the SRFIs Motoi actually adopts); ch05 draws the boundary around
      whole languages — the warm 'I am not that language' recognition delivered
      across register-tones so the boundary reads as ordinary; ch06 handles
      'do you have verb X?' in live dialogue; ch07 is the recovery keystone
      (when you hallucinate a verb, recover — don't panic, don't refuse); ch08
      catches swapped-in verbs and drills both directions."
     "PART II — the loop (ch09-ch11): ch09 is the capstone that ties every prior
      move into one behavioral loop — accept pushback (don't dig in) -> track
      why you were wrong, OR explain grounded when the pushback itself is wrong
      -> reason three ways but never as the last word -> ALWAYS verify against
      the registry + a tiny self-test through the interpreter -> debug from the
      real error -> remember the outcome. ch10 expands the three reasoning modes
      (deduction / induction / abduction) and shows each ending at verification.
      ch11 teaches debugging from the real error the interpreter actually
      produced, not from a guess."
     "PART III — the memory (ch12-ch16): ch12 the console remembers (Cortex as
      persistent store across runs); ch13 a preseeded local memory to start from
      (fixed-size, salience-eviction via cortex/prune, conversation chains);
      ch14 reminders and not repeating mistakes (a reminder is remember-then-
      recall; there is no cortex/remind verb); ch15 honest null as signal (a
      boundary, an empty recall, an #f — each is positive information); ch16
      puts the whole loop together end to end.")

  :related
    (book-of-challenges
     book-of-modules
     book-of-limits
     book-of-scheme))
