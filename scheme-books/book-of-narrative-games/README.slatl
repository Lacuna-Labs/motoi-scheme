;; README.slatl — Book of Narrative Games · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-narrative-games.")

(boot-record
  :book-title "Book of Narrative Games"
  :book-kind "scheme-book"
  :book-type "application"
  :book-slug "book-of-narrative-games"
  :boot-into "ch01-room-door-choice.book.slatl"
  :chapter-count 16 :appendix-count 12
  :audience {"name":":kid"}
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Narrative Games\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn narrative games in Motoi Scheme, chapter by chapter. Start at ch01-room-door-choice.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "A Room, a Door, a Choice" :file "ch01-room-door-choice.book.slatl" :kind "chapter")
   (:title "The Story Tree" :file "ch02-story-tree.book.slatl" :kind "chapter")
   (:title "What You Did Before" :file "ch03-what-you-did-before.book.slatl" :kind "chapter")
   (:title "Characters, Poses, Breath" :file "ch04-characters-poses-breath.book.slatl" :kind "chapter")
   (:title "Dialogue Trees" :file "ch05-dialogue-trees.book.slatl" :kind "chapter")
   (:title "The Camera Tells the Story" :file "ch06-camera-tells-the-story.book.slatl" :kind "chapter")
   (:title "Puzzle in Prose" :file "ch07-puzzle-in-prose.book.slatl" :kind "chapter")
   (:title "Inventory and World-State" :file "ch08-inventory-and-world-state.book.slatl" :kind "chapter")
   (:title "Sound and Silence" :file "ch09-sound-and-silence.book.slatl" :kind "chapter")
   (:title "The Villain and Their Face" :file "ch10-villain-and-their-face.book.slatl" :kind "chapter")
   (:title "Branching That Matters" :file "ch11-branching-that-matters.book.slatl" :kind "chapter")
   (:title "The Deep-Think Companion" :file "ch12-deep-think-companion.book.slatl" :kind "chapter")
   (:title "Multi-Character Scenes" :file "ch13-multi-character-scenes.book.slatl" :kind "chapter")
   (:title "Playable Poetry" :file "ch14-playable-poetry.book.slatl" :kind "chapter")
   (:title "The Long Story" :file "ch15-long-story.book.slatl" :kind "chapter")
   (:title "The Whole Adventure" :file "ch16-whole-adventure.book.slatl" :kind "chapter")
   (:title "Cortex Schema for a Narrative Game" :file "appendix-a-cortex-schema-narrative.book.slatl" :kind "appendix")
   (:title "Dialogue Tree Formats — Five Ways to Shape a Tree" :file "appendix-b-dialogue-tree-formats.book.slatl" :kind "appendix")
   (:title "The Body Language Catalog" :file "appendix-c-body-language-catalog.book.slatl" :kind "appendix")
   (:title "Camera Moves for Narrative" :file "appendix-d-camera-moves.book.slatl" :kind "appendix")
   (:title "Fade, Dim, Curtain — the Physics of Transition" :file "appendix-e-fade-dim-curtain.book.slatl" :kind "appendix")
   (:title "Sound Motifs and Silence" :file "appendix-f-sound-motifs-and-silence.book.slatl" :kind "appendix")
   (:title "The Companion — When AI Helps and When It Ruins" :file "appendix-g-companion-helps-and-ruins.book.slatl" :kind "appendix")
   (:title "Save Slots and world/snapshot" :file "appendix-h-save-slots-and-snapshot.book.slatl" :kind "appendix")
   (:title "The Consequence Table" :file "appendix-i-consequence-table.book.slatl" :kind "appendix")
   (:title "Poetry, Prose, and Playable Text" :file "appendix-j-poetry-prose-playable.book.slatl" :kind "appendix")
   (:title "Testing a Story — The Playtest Checklist" :file "appendix-k-testing-a-story.book.slatl" :kind "appendix")
   (:title "Publishing to a Share URL" :file "appendix-l-publishing-share-url.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
