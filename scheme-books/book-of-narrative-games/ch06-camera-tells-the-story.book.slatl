;; Book of Narrative Games — Chapter 6: The Camera Tells the Story

(dialect :applies ("motoi") :note "Applies to Motoi. Per-record :dialect overrides where a record is specific to one surface.")
(chapter
  :book                "Book of Narrative Games"
  :chapter-number      6
  :title               "The Camera Tells the Story"
  :dialect             "motoi"
  :audience            :kid
  :also-for            :adult
  :content-rating      :G
  :author-lane         "narrative-games-engineer-lane-2026-07-16"
  :training-eligible   #t
