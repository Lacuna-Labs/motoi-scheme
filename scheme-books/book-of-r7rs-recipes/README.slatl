;; README.slatl — Book of R7RS Recipes · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from 00-manifest.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-r7rs-recipes.")

(boot-record
  :book-title "Book of R7RS Recipes"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-r7rs-recipes"
  :boot-into "00-cover.book.slatl"
  :chapter-count 10 :appendix-count 0
  :audience "kid-and-adult operators, Motoi copilot"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of R7RS Recipes\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn r7rs recipes in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Cover — what this book is and how to read it" :file "00-cover.book.slatl" :kind "chapter")
   (:title "Records — define-record-type and the shape of a struct" :file "01-records.book.slatl" :kind "chapter")
   (:title "Exceptions — guard, raise, and staying alive when things break" :file "02-exceptions.book.slatl" :kind "chapter")
   (:title "Hash Tables — make-hash-table and the joy of lookup" :file "03-hash-tables.book.slatl" :kind "chapter")
   (:title "The String Library — split, join, trim, and everything you meant to say" :file "04-string-library.book.slatl" :kind "chapter")
   (:title "Character Predicates — char-alphabetic?, char-upcase, and the ASCII neighborhood" :file "05-character-predicates.book.slatl" :kind "chapter")
   (:title "Bytevectors — the raw byte and when you actually need one" :file "06-bytevectors.book.slatl" :kind "chapter")
   (:title "String Ports — capturing output and replaying input" :file "07-string-ports.book.slatl" :kind "chapter")
   (:title "The Numeric Tower — exact, inexact, and the story of one-half" :file "08-numeric-tower.book.slatl" :kind "chapter")
   (:title "Lazy and Iteration — delay, force, do, and doing something many times" :file "09-lazy-and-iteration.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
