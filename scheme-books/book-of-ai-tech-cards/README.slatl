;; README.slatl — Book of AI Tech Cards · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-ai-tech-cards.")

(boot-record
  :book-title "Book of AI Tech Cards"
  :book-kind "scheme-book"
  :book-type "challenge"
  :book-slug "book-of-ai-tech-cards"
  :boot-into "01-anthropic.book.slatl"
  :chapter-count 14 :appendix-count 0
  :audience "kid-and-adult operators, curious programmers"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "Factual computer-science-history register on AI companies and their\n   engineered systems, protocols, and open contributions. Motoi knows\n   who made what. Motoi does not rank. Feeds v8 substrate."

  :when-to-read
  "Read this book when you want to learn ai tech cards in Motoi Scheme, chapter by chapter. Start at 01-anthropic.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Anthropic" :file "01-anthropic.book.slatl" :kind "chapter")
   (:title "Chapter 2 — OpenAI" :file "02-openai.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Google DeepMind" :file "03-google-deepmind.book.slatl" :kind "chapter")
   (:title "Chapter 4 — Meta AI" :file "04-meta-ai.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Mistral AI" :file "05-mistral.book.slatl" :kind "chapter")
   (:title "Chapter 6 — DeepSeek" :file "06-deepseek.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Cohere" :file "07-cohere.book.slatl" :kind "chapter")
   (:title "Chapter 8 — xAI" :file "08-xai.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Transformer architecture (Vaswani et al. 2017)" :file "09-transformer.book.slatl" :kind "chapter")
   (:title "Chapter 10 — Model Context Protocol (Anthropic, 2024)" :file "10-model-context-protocol.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Constitutional AI (Anthropic, 2022)" :file "11-constitutional-ai.book.slatl" :kind "chapter")
   (:title "Chapter 12 — RLHF and InstructGPT" :file "12-rlhf.book.slatl" :kind "chapter")
   (:title "Chapter 13 — LoRA (Low-Rank Adaptation, Microsoft, 2021)" :file "13-lora.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Whisper and CLIP (OpenAI open-source contributions)" :file "14-whisper-and-clip.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
