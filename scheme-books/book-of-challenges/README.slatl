;; README.slatl — Book of Challenges · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.book.slatl
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-challenges.")

(boot-record
  :book-title "Book of Challenges"
  :book-kind "scheme-book"
  :book-type "challenge"
  :book-slug "book-of-challenges"
  :boot-into "ch01-recursion-warmups.book.slatl"
  :chapter-count 15 :appendix-count 2
  :audience "operator"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Challenges\" — a chaptered Motoi Scheme book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn challenges in Motoi Scheme, chapter by chapter. Start at ch01-recursion-warmups.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Recursion Warm-Ups" :file "ch01-recursion-warmups.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Higher-Order Moves" :file "ch02-higher-order.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Closures & Captured State" :file "ch03-closures-and-state.book.slatl" :kind "chapter")
   (:title "Chapter 4 — List Surgery" :file "ch04-list-surgery.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Association Lists & JSON" :file "ch05-assoc-and-json.book.slatl" :kind "chapter")
   (:title "Chapter 6 — The Verb Pipeline" :file "ch06-the-verb-pipeline.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Numbers & Stats at Depth" :file "ch07-numbers-and-stats.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Text & String Craft" :file "ch08-text-and-strings.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Memory & the Cortex Graph" :file "ch09-memory-and-cortex.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Control-Flow Mastery" :file "ch11-control-flow-mastery.book.slatl" :kind "chapter")
   (:title "Chapter 12 — Composition & Macro-by-Hand" :file "ch12-composition-and-macros.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Honest Failure at Scale" :file "ch13-honest-failure.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Time, Pacing & Freshness" :file "ch14-time-and-pacing.book.slatl" :kind "chapter")
   (:title "Chapter 15 — The Whole Route" :file "ch15-the-whole-route.book.slatl" :kind "chapter")
   (:title "Chapter 16 — The Summit" :file "ch16-the-summit.book.slatl" :kind "chapter")
   (:title "Appendix C — Solution Shape Guide" :file "appendix-c-solution-shape-guide.book.slatl" :kind "appendix")
   (:title "Appendix D — Difficulty Map" :file "appendix-d-difficulty-map.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
