;; README.slatl — Book of Code · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-code.")

(boot-record
  :book-title "Book of Code"
  :subtitle "A 20,000-year super-run from tally sticks to language models, in Motoi Scheme"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-code"
  :boot-into "01-before-writing-there-were-tallies.book.slatl"
  :chapter-count 16 :appendix-count 8
  :audience "kid-and-adult operators, curious programmers, 11-year-olds and up"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Code\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn code in Motoi Scheme, chapter by chapter. Start at 01-before-writing-there-were-tallies.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Before writing there were tallies" :file "01-before-writing-there-were-tallies.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Boolean logic and the algebra of yes and no" :file "02-boolean-logic.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Electricity: from Volta to the switch" :file "03-electricity-and-the-switch.book.slatl" :kind "chapter")
   (:title "Chapter 4 — From switch to gate: relays, tubes, transistors, chips" :file "04-from-switch-to-gate.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Logic gates as first-class Scheme functions" :file "05-logic-gates-in-scheme.book.slatl" :kind "chapter")
   (:title "Chapter 6 — The half adder and the full adder" :file "06-half-adder-and-full-adder.book.slatl" :kind "chapter")
   (:title "Chapter 7 — The 4-bit adder" :file "07-the-4-bit-adder.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Memory: latches and flip-flops" :file "08-memory-latches-and-flip-flops.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Registers, counters, and the birth of state" :file "09-registers-counters-and-the-birth-of-state.book.slatl" :kind "chapter")
   (:title "Chapter 10 — State machines: Mealy and Moore" :file "10-state-machines-mealy-and-moore.book.slatl" :kind "chapter")
   (:title "Chapter 11 — The ALU: combining adders and logic" :file "11-the-alu.book.slatl" :kind "chapter")
   (:title "Chapter 12 — The CPU: fetch, decode, execute — and loop forever" :file "12-the-cpu-fetch-decode-execute.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Memory: RAM, cache, disk, and why locality matters" :file "13-memory-hierarchy.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Assembly, then higher — from opcodes to Scheme" :file "14-assembly-then-higher.book.slatl" :kind "chapter")
   (:title "Chapter 15 — Operating systems and networks — machines cooperating" :file "15-operating-systems-and-networks.book.slatl" :kind "chapter")
   (:title "Chapter 16 — Cloud, LLMs, and the loop that closes" :file "16-cloud-llms-and-the-loop-that-closes.book.slatl" :kind "chapter")
   (:title "Appendix A — ASCII diagram library" :file "appendix-a-ascii-diagram-library.book.slatl" :kind "appendix")
   (:title "Appendix B — Compressed 20,000-year timeline" :file "appendix-b-20000-year-timeline.book.slatl" :kind "appendix")
   (:title "Appendix C — State machine deep dive" :file "appendix-c-state-machine-deep-dive.book.slatl" :kind "appendix")
   (:title "Appendix D — The modern LLM ecosystem, neutrally described" :file "appendix-d-modern-llm-ecosystem.book.slatl" :kind "appendix")
   (:title "Appendix E — Loops, and why they underpin everything" :file "appendix-e-loops-underpin-everything.book.slatl" :kind "appendix")
   (:title "Appendix F — How this book maps to Book of ML" :file "appendix-f-map-to-book-of-ml.book.slatl" :kind "appendix")
   (:title "Appendix G — Reading list" :file "appendix-g-reading-list.book.slatl" :kind "appendix")
   (:title "Appendix H — Runnable Scheme demos consolidated" :file "appendix-h-runnable-demos-consolidated.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
