;; README.slatl — Book of Instruments · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-instruments.")

(boot-record
  :book-title "Book of Instruments"
  :book-kind "scheme-book"
  :book-type "application"
  :book-slug "book-of-instruments"
  :boot-into "00-cover.book.slatl"
  :chapter-count 17 :appendix-count 1
  :audience "kid"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Instruments\" — a chaptered application book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn instruments in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "The Book of Instruments" :file "00-cover.book.slatl" :kind "chapter")
   (:title "Chapter 1 — The roster" :file "01-the-roster.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Piano" :file "02-piano.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Strings" :file "03-strings.book.slatl" :kind "chapter")
   (:title "Chapter 4 — Percussion" :file "04-percussion.book.slatl" :kind "chapter")
   (:title "Chapter 5 — The Japanese bamboo flute" :file "05-japanese-bamboo-flute.book.slatl" :kind "chapter")
   (:title "Chapter 6 — Brass" :file "06-brass.book.slatl" :kind "chapter")
   (:title "Chapter 7 — African drums" :file "07-african-drums.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Indian tabla" :file "08-indian-tabla.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Strings ensemble" :file "09-strings-ensemble.book.slatl" :kind "chapter")
   (:title "Chapter 10 — The full roster" :file "10-the-full-roster.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Guitars" :file "11-guitars.book.slatl" :kind "chapter")
   (:title "Chapter 12 — Electronic and synthesizers" :file "12-electronic-and-synths.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Latin percussion" :file "13-latin-percussion.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Voice as instrument" :file "14-vocal-instruments.book.slatl" :kind "chapter")
   (:title "Chapter 15 — Arranging for an ensemble" :file "15-arranging-for-ensemble.book.slatl" :kind "chapter")
   (:title "Chapter 16 — The roster remembers" :file "16-the-roster-remembers.book.slatl" :kind "chapter")
   (:title "Appendix A — Synth family extras (2026-07-22)" :file "appendix-a-synth-family-2026-07-22.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
