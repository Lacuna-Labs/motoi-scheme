;; README.slatl — Book of Values · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from 00-manifest.book.slatl
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-values.")

(boot-record
  :book-title "Book of Values"
  :subtitle "The things you carry inside a program — and how not to lie about them"
  :book-kind "scheme-book"
  :book-type "prose"
  :book-slug "book-of-values"
  :boot-into "00-cover.book.slatl"
  :chapter-count 18 :appendix-count 26
  :audience "programmer-fluent-in-other-languages OR curious-kid-with-a-parent-nearby"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Values\" — a chaptered composition book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn values in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Book of Values" :file "00-cover.book.slatl" :kind "chapter")
   (:title "Outline" :file "00-outline.book.slatl" :kind "chapter")
   (:title "Values Have Shape" :file "01-values-have-shape.book.slatl" :kind "chapter")
   (:title "Money Is Not a Scalar" :file "02-money-is-not-a-scalar.book.slatl" :kind "chapter")
   (:title "Metrics Carry Units" :file "03-metrics-carry-units.book.slatl" :kind "chapter")
   (:title "Conversion Is Not Free" :file "04-conversion-is-not-free.book.slatl" :kind "chapter")
   (:title "Provenance" :file "05-provenance.book.slatl" :kind "chapter")
   (:title "The Float Trap" :file "06-the-float-trap.book.slatl" :kind "chapter")
   (:title "Integer Overflow, Silent Wrong" :file "07-integer-overflow.book.slatl" :kind "chapter")
   (:title "Time Is A Value" :file "08-time-is-a-value.book.slatl" :kind "chapter")
   (:title "Comparing Values Correctly" :file "09-comparing-values-correctly.book.slatl" :kind "chapter")
   (:title "Composability" :file "10-composability.book.slatl" :kind "chapter")
   (:title "Rounding Modes" :file "11-rounding-modes.book.slatl" :kind "chapter")
   (:title "Range and Domain" :file "12-range-and-domain.book.slatl" :kind "chapter")
   (:title "Missing Values" :file "13-missing-values.book.slatl" :kind "chapter")
   (:title "Displaying vs Storing" :file "14-displaying-vs-storing.book.slatl" :kind "chapter")
   (:title "Interop" :file "15-interop.book.slatl" :kind "chapter")
   (:title "Value Verification" :file "16-value-verification.book.slatl" :kind "chapter")
   (:title "Appendix A — Currency + Subunit Reference" :file "appendix-a-currency-table.book.slatl" :kind "appendix")
   (:title "Appendix B — SI Conversion Reference" :file "appendix-b-si-conversion.book.slatl" :kind "appendix")
   (:title "Appendix C — Motoi Patterns for Typed Values" :file "appendix-c-typed-value-patterns.book.slatl" :kind "appendix")
   (:title "Appendix D — Cortex Integration for Values with Provenance" :file "appendix-d-cortex-integration.book.slatl" :kind "appendix")
   (:title "Appendix E — Runnable Exercises" :file "appendix-e-exercises.book.slatl" :kind "appendix")
   (:title "Appendix F — Cheat Sheet" :file "appendix-f-cheat-sheet.book.slatl" :kind "appendix")
   (:title "Appendix G — When a Scalar Is Fine" :file "appendix-g-when-scalar-is-fine.book.slatl" :kind "appendix")
   (:title "Appendix H — Glossary" :file "appendix-h-glossary.book.slatl" :kind "appendix")
   (:title "Appendix I — Vectors Are Values Too" :file "appendix-i-vectors.book.slatl" :kind "appendix")
   (:title "Appendix J — Matrices and Transforms" :file "appendix-j-matrices.book.slatl" :kind "appendix")
   (:title "Appendix K — Geometry Values" :file "appendix-k-geometry.book.slatl" :kind "appendix")
   (:title "Appendix L — Colors Are Values" :file "appendix-l-colors.book.slatl" :kind "appendix")
   (:title "Appendix M — Rates and Ratios" :file "appendix-m-rates.book.slatl" :kind "appendix")
   (:title "Appendix N — IDs, Tokens, and Opaque Values" :file "appendix-n-ids-tokens.book.slatl" :kind "appendix")
   (:title "Appendix O — Enums and Symbols" :file "appendix-o-enums-symbols.book.slatl" :kind "appendix")
   (:title "Fixed-point and decimal arithmetic" :file "appendix-p-decimal-arithmetic.book.slatl" :kind "appendix")
   (:title "Error propagation for value operations" :file "appendix-q-error-handling.book.slatl" :kind "appendix")
   (:title "Timezones and the seven kinds of time" :file "appendix-r-timezones.book.slatl" :kind "appendix")
   (:title "Percentages, ratios, and rates — the almost-numbers" :file "appendix-s-percentages.book.slatl" :kind "appendix")
   (:title "Serializing typed values — the on-disk shape" :file "appendix-t-serialization.book.slatl" :kind "appendix")
   (:title "Recipes for comparing typed values" :file "appendix-u-comparison-recipes.book.slatl" :kind "appendix")
   (:title "Validation at boundaries" :file "appendix-v-validation.book.slatl" :kind "appendix")
   (:title "Optionals, nulls, and the honest absence" :file "appendix-w-optionals.book.slatl" :kind "appendix")
   (:title "Worked examples — five values from input to output" :file "appendix-x-worked-examples.book.slatl" :kind "appendix")
   (:title "Value anti-patterns — the recurring mistakes" :file "appendix-y-anti-patterns.book.slatl" :kind "appendix")
   (:title "The whole book in one page" :file "appendix-z-the-summary.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
