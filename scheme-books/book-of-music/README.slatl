;; README.slatl — Book of Music · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-music.")

(boot-record
  :book-title "Book of Music"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-music"
  :boot-into "00-cover.book.slatl"
  :chapter-count 19 :appendix-count 11
  :audience "kid"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Music\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn music in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "The Book of Music" :file "00-cover.book.slatl" :kind "chapter")
   (:title "00-index" :file "00-index.book.slatl" :kind "chapter")
   (:title "Chapter 1: The Surface (of Sound)" :file "ch01-surface-of-sound.book.slatl" :kind "chapter")
   (:title "Chapter 2: The Language" :file "ch02-language.book.slatl" :kind "chapter")
   (:title "Chapter 3: The Note" :file "ch03-note.book.slatl" :kind "chapter")
   (:title "Chapter 4: Melody" :file "ch04-melody.book.slatl" :kind "chapter")
   (:title "Chapter 5: Rhythm & Meter" :file "ch05-rhythm-meter.book.slatl" :kind "chapter")
   (:title "Chapter 6: Harmony" :file "ch06-harmony.book.slatl" :kind "chapter")
   (:title "Chapter 7: Voices" :file "ch07-voices.book.slatl" :kind "chapter")
   (:title "Chapter 8: Timbre & Envelope" :file "ch08-timbre-envelope.book.slatl" :kind "chapter")
   (:title "Chapter 9: Polyphony" :file "ch09-polyphony.book.slatl" :kind "chapter")
   (:title "Chapter 10: Polyrhythm" :file "ch10-polyrhythm.book.slatl" :kind "chapter")
   (:title "ch11-rachmaninoff-second" :file "ch11-rachmaninoff-second.book.slatl" :kind "chapter")
   (:title "ch11a-form-as-meaning" :file "ch11a-form-as-meaning.book.slatl" :kind "chapter")
   (:title "ch12-chopin-and-the-nocturne" :file "ch12-chopin-and-the-nocturne.book.slatl" :kind "chapter")
   (:title "ch13-three-classical-forms" :file "ch13-three-classical-forms.book.slatl" :kind "chapter")
   (:title "ch14-pitch-interval-harmonic-series" :file "ch14-pitch-interval-harmonic-series.book.slatl" :kind "chapter")
   (:title "ch15-tempo-rubato-listening" :file "ch15-tempo-rubato-listening.book.slatl" :kind "chapter")
   (:title "Chapter 16: The Concerto" :file "ch16-concerto.book.slatl" :kind "chapter")
   (:title "appendix-01-bach-goldberg" :file "appendix-01-bach-goldberg.book.slatl" :kind "appendix")
   (:title "appendix-02-debussy" :file "appendix-02-debussy.book.slatl" :kind "appendix")
   (:title "appendix-03-ellington-swing" :file "appendix-03-ellington-swing.book.slatl" :kind "appendix")
   (:title "appendix-04-nina-simone" :file "appendix-04-nina-simone.book.slatl" :kind "appendix")
