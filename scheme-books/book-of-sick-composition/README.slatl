;; README.slatl — Book of Sick Composition · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from 00-manifest.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-sick-composition.")

(boot-record
  :book-title "Book of Sick Composition"
  :book-kind "scheme-book"
  :book-type "composition"
  :book-slug "book-of-sick-composition"
  :boot-into "00-cover.book.slatl"
  :chapter-count 9 :appendix-count 0
  :audience "kid-and-adult operators, Motoi copilot"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "motoi-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "The Book of Sick Composition is a ramp — easy to pro, one lib per\nchapter, every chapter takes Motoi from nothing to something. Each\nchapter opens with what the lib is and why it exists, then a stack\nof four problems that step up in complexity: draw a circle → draw a\nfield of circles → make them pulse → make them respond to a click.\nEvery line of code is a real Motoi verb from the reference. Every\nsolution is authored under intent — no LLM-invented facts, no\nscraped patterns, no pseudo-code.\n\nThe book teaches the shape of composition Alfred cares about: the\nkid opens the file, tries a thing, sees the thing, then trades one\ndetail for another and sees the picture change. Nothing-to-something\nin the small; nothing-to-a-whole-game by chapter eight."

  :when-to-read
  "Read this book when you want to learn sick composition in Motoi Scheme, chapter by chapter. Start at 00-cover.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Cover — a ramp from nothing to something, one lib at a time" :file "00-cover.book.slatl" :kind "chapter")
   (:title "The Base — car, cdr, cons, and the shape of everything" :file "01-base.book.slatl" :kind "chapter")
   (:title "Lists You Move Around — map, filter, and the joy of pipes" :file "02-list-manipulation.book.slatl" :kind "chapter")
   (:title "Higher-Order — functions that take functions" :file "03-higher-order.book.slatl" :kind "chapter")
   (:title "Recursion Without Fear — the same trick, again and again" :file "04-recursion.book.slatl" :kind "chapter")
   (:title "The Frame — begin-frame, text/draw, and drawing your first picture" :file "05-frame.book.slatl" :kind "chapter")
   (:title "The World Loop — an explicit named-recursive frame loop over state" :file "06-world-loop.book.slatl" :kind "chapter")
   (:title "Entities as Data — plain values, functional updates, and the list toolbox" :file "07-entities.book.slatl" :kind "chapter")
   (:title "Sound and Music — a note is a frequency, a sample is math/sin, a beat is data" :file "08-sound-and-music.book.slatl" :kind "chapter")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
