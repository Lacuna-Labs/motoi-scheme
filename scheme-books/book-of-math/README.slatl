;; README.slatl — Book of Math · BOOT RECORD
;;
;; Boot record for this book, per spec/BOOK-LAYOUT.slat. First file any reader
;; (human, LLM, Rosetta) opens in this folder: it names the book's first chapter
;; (:boot-into), briefs a cold reader, and carries the ordered chapter nav that
;; renders to a Markdown table of contents. GENERATED from MANIFEST.slat
;; by scratch/build-book-bootrecords.mjs — regenerate after adding a chapter.
(dialect :applies ("motoi") :note "Boot record for book-of-math.")

(boot-record
  :book-title "Book of Math"
  :book-kind "scheme-book"
  :book-type "learning"
  :book-slug "book-of-math"
  :boot-into "ch01-counting-number-line.book.slatl"
  :chapter-count 16 :appendix-count 6
  :audience "adult"
  :for ("human-reader" "motoi-copilot-training" "motoi-copilot-inference"
        "sakura-training" "returning-collaborator" "rosetta-render-target")
  :training-eligible #t
  :confidentiality "public"

  :what-this-is
  "This folder is \"Book of Math\" — a chaptered learning book for Motoi Scheme, meant to be read by humans AND used as training data for LLMs. Read the chapters in order; every code block runs through ./bin/motoi."

  :when-to-read
  "Read this book when you want to learn math in Motoi Scheme, chapter by chapter. Start at ch01-counting-number-line.book.slatl; each chapter builds on the last."

  :not-here
  "Only this book lives here. The language reference lives in scheme/reference/,
   the engineering & recovery journal in docs/, the operations manual in
   SRE-MANUAL/. Each is its own book folder with its own boot record."

  :nav
  (
   (:title "Chapter 1 — Grade 1: Counting & the Number Line" :file "ch01-counting-number-line.book.slatl" :kind "chapter")
   (:title "Chapter 2 — Grade 2: Place Value & Repeated Addition" :file "ch02-place-value-arrays.book.slatl" :kind "chapter")
   (:title "Chapter 3 — Grade 3: Multiplication & Division" :file "ch03-multiplication-division.book.slatl" :kind "chapter")
   (:title "Chapter 4 — Grade 4: Long Division & Factors" :file "ch04-long-division-factors.book.slatl" :kind "chapter")
   (:title "Chapter 5 — Grade 5: Fractions & Decimals" :file "ch05-fractions-decimals.book.slatl" :kind "chapter")
   (:title "Chapter 6 — Grade 6: Ratios, Integers, Expressions" :file "ch06-ratios-integers-expressions.book.slatl" :kind "chapter")
   (:title "Chapter 7 — Grade 7: Proportions & Probability" :file "ch07-proportions-probability.book.slatl" :kind "chapter")
   (:title "Chapter 8 — Grade 8: Pre-Algebra & the Plane" :file "ch08-pre-algebra-plane.book.slatl" :kind "chapter")
   (:title "Chapter 9 — Grade 9: Algebra I" :file "ch09-algebra-1.book.slatl" :kind "chapter")
   (:title "Chapter 10 — Grade 10: Geometry" :file "ch10-geometry.book.slatl" :kind "chapter")
   (:title "Chapter 11 — Grade 11: Algebra II & Trigonometry" :file "ch11-algebra-2-trig.book.slatl" :kind "chapter")
   (:title "Chapter 12 — Grade 12: Pre-Calculus" :file "ch12-pre-calculus.book.slatl" :kind "chapter")
   (:title "Chapter 13 — Grade 13: Calculus I" :file "ch13-calculus-1.book.slatl" :kind "chapter")
   (:title "Chapter 14 — Grade 14: Calculus II" :file "ch14-calculus-2.book.slatl" :kind "chapter")
   (:title "Chapter 15 — Grade 15: Multivariable & Linear Algebra" :file "ch15-multivariable-linear-algebra.book.slatl" :kind "chapter")
   (:title "Chapter 16 — Grade 16: The Math-Major Electives" :file "ch16-math-major-electives.book.slatl" :kind "chapter")
   (:title "Appendix U — Motoi doing math" :file "appendix-U-motoi-doing-math.book.slatl" :kind "appendix")
   (:title "Appendix V — Advanced Verbs Cookbook (2026-07-22)" :file "appendix-V-advanced-verbs-2026-07-22.book.slatl" :kind "appendix")
   (:title "Appendix W — Topology, Groups, Symbolic Math, Linear Algebra (2026-07-22)" :file "appendix-W-topology-algebra-symbolic-linalg-2026-07-22.book.slatl" :kind "appendix")
   (:title "Appendix W — Const + Eng + Matrix filler (2026-07-22)" :file "appendix-W-unwired-verbs-2026-07-22.book.slatl" :kind "appendix")
   (:title "Appendix — Exact Ordering and Additive Inverse (exact/<=, exact/>=, exact/neg)" :file "appendix-exact-orderings.book.slatl" :kind "appendix")
   (:title "Appendix — The Verbs Cookbook" :file "appendix-verbs-cookbook.book.slatl" :kind "appendix")
  )

  :for-rosetta
  "This folder is a book: this README.slatl (boot record) + a manifest + numbered
   .book.slatl chapters. Render this boot record as the folder landing page:
   the prose sections become the intro, :nav becomes the linked table of contents
   (one item per chapter/appendix in order). Do not hand-author a README.md —
   generate it from here."

  :the-rule
  "One book = one folder = one README.slatl boot record + ordered chapters +
   a manifest. Same shape in every book folder (spec/BOOK-LAYOUT.slat).")
