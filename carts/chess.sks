;; look up the record for the GAME knob
(define (game-for sym)
  (case sym
    ((immortal)  GAME-IMMORTAL)
    ((evergreen) GAME-EVERGREEN)
    ((opera)     GAME-OPERA)
    ((century)   GAME-CENTURY)
    (else GAME-IMMORTAL)))

;; =======================  RENDER (SD framebuffer)  =======================

(define (glyph p) (case (kind p)
                    ((6) "K") ((5) "Q") ((4) "R") ((3) "B") ((2) "N") ((1) "P")
                    (else "")))

(define (draw-board flash-from flash-to)
  (clear 1)
  ;; squares
  (let loop ((r 0)) (when (< r 8)
    (let loop2 ((f 0)) (when (< f 8)
      (let* ((sq (sq-of r f))
             (light (= (modulo (+ r f) 2) 0))
             (x (+ BX (* f SQ))) (y (+ BY (* r SQ)))
             (base (if light 15 4)))          ;; peach light / brown dark
        (set-color base)
        (rect-fill x y SQ SQ)
        (when (or (= sq flash-from) (= sq flash-to))
          (set-color 10) (rect-fill x y SQ SQ))          ;; yellow flash
        (loop2 (+ f 1)))))
    (loop (+ r 1))))
  ;; pieces
  (let loop ((sq 0)) (when (< sq 64)
    (let ((p (at sq)))
      (when (not (empty? p))
        (let ((x (+ BX (* (file sq) SQ))) (y (+ BY (* (rank sq) SQ))))
          ;; a disc backing so both colors read on any square
          (set-color (if (eq? (side p) 'w) 7 0))
          (disc (+ x (quotient SQ 2)) (+ y (quotient SQ 2)) 9)
          (fb/text (glyph p) (+ x 8) (+ y 8)
                   (if (eq? (side p) 'w) 'black 'white)))))
    (loop (+ sq 1))))
  ;; frame + labels
  (set-color 6)
  (rect (- BX 1) (- BY 1) (+ (* 8 SQ) 2) (+ (* 8 SQ) 2))
  (let loop ((f 0)) (when (< f 8)
    (fb/text (vector-ref FILES f) (+ BX (* f SQ) 9) (+ BY (* 8 SQ) 3) 'white)
    (loop (+ f 1))))
  (let loop ((r 0)) (when (< r 8)
    (fb/text (number->string (- 8 r)) (- BX 12) (+ BY (* r SQ) 8) 'white)
    (loop (+ r 1)))))

(define (draw-hud ply turn note)
  (set-color 5) (rect-fill 236 24 80 192)
  (fb/text "CHESS" 244 28 'yellow)
  (fb/text (string-append "mode " (case MODE ((modified) "mod") (else "book")))
           244 42 'white)
  (fb/text (string-append "you " (if (eq? HUMAN-SIDE 'w) "W" "B")) 244 56 'white)
  (fb/text (string-append "ply " (number->string ply)) 244 70 'white)
  (fb/text (string-append "turn " (if (eq? turn 'w) "W" "B")) 244 84 'white)
  (fb/text "material" 244 104 'lavender)
  (fb/text (string-append "W " (number->string (material 'w))) 244 118 'white)
  (fb/text (string-append "B " (number->string (material 'b))) 244 132 'white)
  (fb/text note 244 154 'green))

;; slide-animation helper: interpolated frames of a piece sliding between two
;; squares. Fuel is tight, so we draw the board ONCE (flashing the destination)
;; and then overlay the moving piece at a few interpolated points, rather than
;; re-rendering the whole board per frame.
(define (draw-piece-at cx cy p)
  (set-color (if (eq? (side p) 'w) 7 0))
  (disc cx cy 9)
  (fb/text (glyph p) (- cx 3) (- cy 4) (if (eq? (side p) 'w) 'black 'white)))

(define (animate-slide! m note ply)
  (let* ((from (nth-from m)) (to (nth-to m)) (p (at from))
         (fx (+ BX (* (file from) SQ) (quotient SQ 2)))
         (fy (+ BY (* (rank from) SQ) (quotient SQ 2)))
         (tx (+ BX (* (file to) SQ) (quotient SQ 2)))
         (ty (+ BY (* (rank to) SQ) (quotient SQ 2))))
    (draw-board -1 to)                  ;; board once, destination square flashing
    (draw-hud ply 'w note)
    ;; overlay the sliding piece at the 1/3, 2/3 and full points
    (let loop ((k 1))
      (when (<= k 3)
        (draw-piece-at (+ fx (quotient (* (- tx fx) k) 3))
                       (+ fy (quotient (* (- ty fy) k) 3)) p)
        (loop (+ k 1))))))

;; =======================  MOVE LOG  =======================

(define MOVELOG '())  ;; list of strings, newest first

(define (log-move! ply s name ev)
  (set! MOVELOG
    (cons (string-append
            (number->string (+ (quotient ply 2) 1)) "."
            (if (eq? s 'w) " " "..")
            name
            (if ev (string-append "  {eval " (number->string ev) "}") ""))
          MOVELOG)))

;; =======================  DRIVER  =======================
;; Walk the chosen game's book move-vector ply by ply. HUMAN plays their side
;; from the book (a real surface swaps this for live input); Motoi plays its side
;; per MODE. Book moves apply through apply-book! (castling/ep aware); own-brain
;; moves apply through do-move! (never tagged).

;; normalize the human-side knob to internal 'w / 'b
(define HUMAN (if (eq? HUMAN-SIDE 'black) 'b 'w))
(define MOTOI (other HUMAN))
(define REC (game-for GAME))
(define BOOK (g-moves REC))
(define NBOOK (vector-length BOOK))

;; the book move for a given ply, or #f if the game's score has run out
(define (book-at ply) (if (< ply NBOOK) (vector-ref BOOK ply) #f))

;; heuristic-brain move for side s (used when off the book) -> (move eval)
(define (brain-move s) (choose-from s (gen-moves s)))

;; score a candidate book move for side s the same way the brain scores its own,
;; so 'modified can compare them on one scale. A book move may be a castle/ep;
;; those are treated as non-captures (score 0 gain) for the comparison.
(define (book-brain-score s bm)
  (if (or (book-oo? bm) (book-ooo? bm) (book-ep? bm)) 0
      (net-score s bm (level-lookahead))))

(set-mode 'sd)
(setup!)

(display "=== CHESS — Motoi SD (320x240) : Ten Greatest Games ===") (newline)
(display (g-name REC)) (display " — ") (display (g-white REC))
(display " vs ") (display (g-black REC)) (display ", ") (display (g-year REC))
(newline)
(display "You play ") (display (if (eq? HUMAN 'w) "WHITE" "BLACK"))
(display "; Motoi plays ") (display (if (eq? MOTOI 'w) "WHITE" "BLACK"))
(display ".  Mode: ") (display MODE) (newline)
(display "P=1 N=B=3 R=5 Q=9.  Playback understands castling + en-passant.")
(newline) (newline)

(define RESULT "")
(define DEVIATED #f)   ;; has the HUMAN side left the book? (ends 'straight book)
(define LEFT-BOOK #f)  ;; has MOTOI departed the book in 'modified?
(define LEFT-AT -1)    ;; ply at which Motoi first left the book

;; play ONE ply; return (move . name) with the name computed BEFORE the move is
;; applied (so piece/capture glyphs are correct), or #f if the game is over.
;; Mutates the board.
(define (brain-name-of s m) (move-name m (at (nth-from m)) (at (nth-to m))))
(define (play-brain! ply turn)          ;; own-brain move -> (move . name) or #f
  (let* ((picked (brain-move turn)) (m (car picked)))
    (if (eq? m #f) #f
        (let ((nm (brain-name-of turn m)))
          (do-move! m)
          (log-move! ply turn nm (cadr picked))
          (cons m nm)))))
(define (play-book! ply turn bm)        ;; scripted book move -> (move . name)
  (let ((nm (book-move-name bm)))
    (apply-book! bm)
    (log-move! ply turn nm #f)
    (cons bm nm)))

(define (play-ply ply turn)
  (let* ((bm (book-at ply)))
    (cond
     ;; ---- the game's written score is exhausted: both sides use their brain --
     ((eq? bm #f) (play-brain! ply turn))
     ;; ---- HUMAN's turn: play the book move (real surface = live input) -------
     ((eq? turn HUMAN) (play-book! ply turn bm))
     ;; ---- MOTOI, 'straight, human still on book: follow the script ----------
     ((and (eq? MODE 'straight) (not DEVIATED)) (play-book! ply turn bm))
     ;; ---- MOTOI in 'modified: compare its brain against the book ------------
     ((eq? MODE 'modified)
      (let* ((picked (brain-move turn)) (best (car picked))
             (best-sc (if best (net-score turn best (level-lookahead)) -1000000))
             (book-sc (book-brain-score turn bm)))
        (if (and best (> (- best-sc book-sc) SENSE-THRESHOLD))
            (let ((bn (brain-name-of turn best)))   ;; its sense sees better
              (when (not LEFT-BOOK) (set! LEFT-BOOK #t) (set! LEFT-AT ply))
              (display "  * Motoi left the book at ply ") (display ply)
              (display ": played ") (display bn)
              ;; show the book move by squares (the position may have diverged, so
              ;; a glyph decode of the book's from-square would be misleading)
              (display " over ") (display (sq-name (nth-from bm)))
              (display "-") (display (sq-name (nth-to bm))) (newline)
              (do-move! best)
              (log-move! ply turn bn (cadr picked))
              (cons best bn))
            (play-book! ply turn bm))))            ;; agrees closely -> book
     ;; ---- MOTOI after the human deviated ('straight): own brain ------------
     (else (play-brain! ply turn)))))

;; the run loop
(let loop ((ply 0) (turn 'w))
  (cond
    ((>= ply MAX-PLIES)
     (set! RESULT
       (if (< ply NBOOK)
           (string-append "ply cap reached at " (number->string ply)
                          " of " (number->string NBOOK)
                          " — raise MAX-PLIES + --fuel to play on")
           "reached the end of the historical game")))
    ((and (not (eq? turn HUMAN))       ;; game-over test only on the side to move
          (not (book-at ply))
          (eq? (car (brain-move turn)) #f))
     (set! RESULT (if (in-check? turn) "CHECKMATE" "STALEMATE")))
    (else
     (let ((res (play-ply ply turn)))
       (if (eq? res #f)
           (set! RESULT (if (in-check? turn) "CHECKMATE" "STALEMATE"))
           (let ((m (car res)) (nm (cdr res)))
             ;; did the HUMAN just leave the book? (compare to what the book said)
             (when (and (eq? turn HUMAN) (eq? MODE 'straight))
               (let ((bm (book-at ply)))
                 (when (and bm (not DEVIATED)
                            (or (not (= (nth-from bm) (nth-from m)))
                                (not (= (nth-to bm) (nth-to m)))))
                   (set! DEVIATED #t))))
             ;; compact ASCII status line
             (when (= (modulo ply SHOW-EVERY) 0)
               (display "ply ") (display ply)
               (display (if (eq? turn 'w) "  W " "  B "))
               (display nm)
               (display (cond ((eq? turn HUMAN) "   (you)")
                              (DEVIATED "   (Motoi, own brain)")
                              (LEFT-BOOK "   (Motoi)")
                              (else "   (Motoi, book)")))
               (display "  | mat W=") (display (material 'w))
               (display " B=") (display (material 'b)) (newline))
             ;; ONE SD climax screenshot
             (when (= ply DUMP-PLY)
               (draw-board (nth-from m) (nth-to m))
               (draw-hud ply (other turn)
                         (if DEVIATED "off book"
                             (if LEFT-BOOK "departed" "in book")))
               (newline)
               (display "--- SD screenshot @ ply ") (display ply)
               (display " (") (display nm) (display ") ---")
               (newline)
               (fb/dump 0 0 W H)
               (newline))
             (loop (+ ply 1) (other turn))))))))

;; =======================  RESULT  =======================

(newline)
(display "GAME: ") (display (g-name REC)) (newline)
(display "STATUS: ")
(cond (DEVIATED  (display "you left the book — Motoi finished on its own brain."))
      (LEFT-BOOK (display "Motoi departed the book at ply ") (display LEFT-AT) (display "."))
      (else      (display "played faithfully in the book.")))
(newline)
(newline)
(display "MOVE LOG (most recent last):") (newline)
(for-each (lambda (line) (display "  ") (display line) (newline))
          (reverse MOVELOG))
