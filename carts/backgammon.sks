;; backgammon.sks
;; Motoi Cart — Flagship (SD framebuffer)
;;
;; (cart
;;   :name            "backgammon"
;;   :category        :game
;;   :sub-category    :board
;;   :audience        :kid
;;   :complexity      5
;;   :runtime-tier    :runs-on-core
;;   :render          :sd-framebuffer
;;   :one-line        "Play backgammon against Motoi — 24 points, real dice from a deterministic roll, hitting to the bar and bearing off, with a straight brain you can learn and an adaptive one that reads your style, on the 320x240 screen."
;;   :verbs-used      ("set-mode" "clear" "set-color" "rect-fill" "rect" "line"
;;                     "disc" "triangle-fill" "fb/text" "fb/dump" "make-vector"
;;                     "vector-ref" "vector-set!" "vector" "vector-length" "quotient"
;;                     "remainder" "modulo" "abs" "min" "max" "number->string"
;;                     "string-append" "eq?" "cons" "car" "cdr" "list" "length"
;;                     "reverse" "append" "for-each" "map" "filter" "when" "unless"
;;                     "cond" "case" "let" "let*" "set!")
;;   :inspiration     "Backgammon — five thousand years old, from the royal game of Ur onward; the oldest game we still play, and the one where skill and the luck of the dice argue on every single turn.")
;;
;; HOW TO RUN:
;;   motoi run carts/backgammon.sks
;;
;; WHAT THIS IS
;;   Backgammon on Motoi's real SD screen (320x240). The board is a vector of 24
;;   points; each point holds a small number: 0 is empty, +N means N of YOUR
;;   checkers sit there, -N means N of Motoi's. A vector so a point read is
;;   instant, and plain numbers so "who owns this point and how many" is just the
;;   sign and the size — which matters, because a backgammon move looks at the
;;   board a lot.
;;
;;   You are X and you run the board UP, from the low points toward point 24 and
;;   then OFF the far edge. Motoi is O and runs the other way, down toward point 1
;;   and off its edge. Land two or more checkers on a point and you own it — the
;;   other side can't land there. Land on a lone enemy checker (a "blot") and you
;;   HIT it: it goes to the BAR and has to re-enter from the very start before
;;   that side can do anything else. First to bring all fifteen checkers home and
;;   bear them OFF wins.
;;
;;   THE DICE ARE REAL — and the same every run. Two dice each turn (a double
;;   lets you move four times), rolled from a tiny deterministic generator seeded
;;   by the SEED knob. No clock, no true randomness: change SEED for a different
;;   game, keep it for the exact same one. That is what lets a dice game replay
;;   identically and be studied move by move.
;;
;; MOTOI AS YOUR OPPONENT — the AI-PLAN knob (the fun part)
;;   'straight  — a FIXED, readable playstyle you can learn and beat. For each
;;                die it scores every legal move the same simple way: love a HIT
;;                (send a blot to the bar), love MAKING A POINT (a safe pair),
;;                bring checkers HOME, and as a tie-break just run the farthest-
;;                back checker. It never changes its mind. Once you see how it
;;                values things you can leave safe blots it won't punish and out-
;;                race it. A pattern a person can crack.
;;
;;   'adaptive  — Motoi WATCHES how you play and shifts its plan to counter. It
;;                counts how often YOU hit its blots. If you play a hitting,
;;                aggressive game it turns cautious — it weights SAFETY and making
;;                points far higher so it stops leaving you targets. If you play
;;                quietly it presses its own attack. Readable, human-like: a change
;;                you could narrate ("you keep hitting me, so I'll play safe").
;;
;;   The LEVEL knob sharpens the same brain: 'easy and 'normal keep the light
;;   scoring; 'hard looks one reply deeper on its best candidate so it doesn't
;;   leave an obvious return hit. The DEFAULT ('straight + 'normal) fits the
;;   default fuel; 'hard and 'adaptive stay inside it too — the search is bounded
;;   hard so a whole game always finishes.
;;
;; NO KEYBOARD — how "you vs Motoi" is expressed
;;   A headless cart has no keys, so BOTH sides are driven by the engine. X (the
;;   human stand-in) plays with the SAME light heuristic as 'straight O, so the
;;   demo is a readable self-consistent game; O plays the plan you chose. On a
;;   real surface you'd swap X's chooser for a person picking moves and leave O as
;;   the AI at your chosen plan and LEVEL.
;;
;; POINTS
;;   The score that matters is the PIP COUNT — the total number of steps each
;;   side still has to travel to bring everyone home and off. Lower is better; the
;;   HUD shows both pip counts, whose turn it is, the dice, and Motoi's read of
;;   how aggressively you've been playing.

;; =======================  KNOBS  =======================

(define AI-PLAN 'straight)  ;; 'straight (fixed, learnable playstyle — DEFAULT)
                            ;; 'adaptive (reads your aggression, shifts to counter)
(define LEVEL   'normal)    ;; 'easy 'normal 'hard — 'hard looks one reply deeper.
                            ;; All fit the DEFAULT 200000 fuel; the search is bounded.
(define SEED    7)          ;; deterministic dice; change for a different game
(define MAX-TURNS 14)       ;; hard cap on whole turns, then adjudicate by pips
                            ;; (a full bear-off race is long; this fits the budget)
(define SHOW-EVERY 1)       ;; print a status line every this-many turns
(define DUMP-TURN 6)        ;; render one SD screenshot after this turn

(define W 320)              ;; SD width
(define H 240)              ;; SD height

;; =======================  DETERMINISTIC DICE  =======================
;; A tiny linear-congruential generator so the dice are the same every run
;; without touching the host clock. die -> 1..6.

(define _seed SEED)
(define (rnd)
  (set! _seed (modulo (+ (* _seed 1103515245) 12345) 2147483648))
  (/ _seed 2147483648))
(define (die) (+ 1 (min 5 (quotient (* (rnd) 6000) 1000))))  ;; 1..6, even-ish

;; =======================  CHARM PASS: SOUND  =======================
;; A short opening theme and a small sound on each event — the dice roll, a HIT
;; to the bar, the result. The audio verbs are REAL (tone note sfx music melody)
;; but on a headless run there is no speaker, so they simply do nothing. The
;; SHAPE is what teaches; on a real surface these same calls sing.
;;
;; TEACHING IDEA — "guard your nice-extras so they can never crash the core."
;; Sound is a bonus, not the game. Every audio call goes through one small
;; wrapper, (safe ...), and one flag, SOUND-ON. Flip it off and the game plays
;; on in silence, unchanged. A seatbelt for extras: it only ever helps.
(define SOUND-ON #t)
(define (safe thunk) (when SOUND-ON (thunk)) #t)

(define (play-theme!)                            ;; a rising major chord, "here we go!"
  (safe (lambda ()
    (music 'bg-theme)
    (melody (list 60 64 67 72) 0.12))))          ;; C4 E4 G4 C5

(define (sfx-roll!)                               ;; the clatter of the dice — a blip
  (safe (lambda () (sfx 'blip 440 0.05))))
(define (sfx-hit!)                                ;; a blot sent to the bar — a chime
  (safe (lambda () (note 76 0.10 0.7))))
(define (sfx-result! ahead)                       ;; result: rising if you lead, low if not
  (safe (lambda ()
    (cond ((> ahead 0) (melody (list 67 72 76) 0.12))   ;; you lead the race
          ((< ahead 0) (melody (list 55 52 48) 0.14))   ;; Motoi leads
          (else        (tone 330 0.30))))))             ;; dead-even tone

;; =======================  CHARM PASS: PALETTE  =======================
;; TEACHING IDEA — name your constants. Now "the felt" is a word, not the number
;; 1, and restyling the whole board is a one-line edit right here.
(define COL-FELT   1)    ;; dark background felt
(define COL-STARS  13)   ;; faint lavender speckle
(define COL-LIGHT  15)   ;; peach point
(define COL-DARK   4)    ;; brown point
(define COL-BAR    5)    ;; center bar / HUD panel
(define COL-FRAME  6)    ;; frame lines
(define COL-YOU    7)    ;; your checkers (white)
(define COL-MOTO   8)    ;; Motoi's checkers (red)

;; roll two dice; a double becomes four of that value
(define (roll)
  (let ((a (die)) (b (die)))
    (if (= a b) (list a a a a) (list a b))))

;; =======================  THE BOARD  =======================
;; 24 points, index 0..23. A point is an INTEGER:
;;   0 = empty, +N = N of X's checkers (yours), -N = N of O's (Motoi's).
;; X travels toward higher indices and bears off past 23.
;; O travels toward lower indices and bears off past 0.
(define POINTS (make-vector 24 0))
(define (pt i) (vector-ref POINTS i))
(define (pt! i v) (vector-set! POINTS i v))

;; off-board and bar counts, per side
(define X-OFF 0) (define O-OFF 0)
(define X-BAR 0) (define O-BAR 0)

;; sign helpers -------------------------------------------------------------
(define (owner i)                       ;; 'x 'o or #f
  (let ((v (pt i))) (cond ((> v 0) 'x) ((< v 0) 'o) (else #f))))
(define (count-at i) (abs (pt i)))
(define (mine? i s) (if (eq? s 'x) (> (pt i) 0) (< (pt i) 0)))
(define (foe?  i s) (if (eq? s 'x) (< (pt i) 0) (> (pt i) 0)))
(define (blot? i s) (and (foe? i s) (= (count-at i) 1)))   ;; lone enemy = hittable
(define (blocked? i s) (and (foe? i s) (>= (count-at i) 2)))
(define (other s) (if (eq? s 'x) 'o 'x))

;; add one checker of side s onto point i (respecting sign)
(define (add-checker! i s)
  (pt! i (if (eq? s 'x) (+ (pt i) 1) (- (pt i) 1))))
(define (remove-checker! i s)
  (pt! i (if (eq? s 'x) (- (pt i) 1) (+ (pt i) 1))))

;; =======================  STARTING POSITION  =======================
;; The standard opening set-up, from X's numbering (points 1..24 = index 0..23).
;; X on 1,12,17,19 ; O mirrored on 24,13,8,6.
(define (setup!)
  (let loop ((i 0)) (when (< i 24) (pt! i 0) (loop (+ i 1))))
  ;; X (positive): 2 on pt1, 5 on pt12, 3 on pt17, 5 on pt19
  (pt! 0  2) (pt! 11 5) (pt! 16 3) (pt! 18 5)
  ;; O (negative): 2 on pt24, 5 on pt13, 3 on pt8, 5 on pt6
  (pt! 23 -2) (pt! 12 -5) (pt! 7 -3) (pt! 5 -5)
  (set! X-OFF 0) (set! O-OFF 0) (set! X-BAR 0) (set! O-BAR 0))

;; =======================  DESTINATION / LEGALITY  =======================
;; For a die d and side s, the checker on point `from` lands on `dest`.
;; X: dest = from + d (>=24 means bearing off). O: dest = from - d (<0 = off).
(define (dest-of from d s) (if (eq? s 'x) (+ from d) (- from d)))
(define (bearing-off? dest s) (if (eq? s 'x) (>= dest 24) (< dest 0)))
(define (on-board? dest) (and (>= dest 0) (< dest 24)))

;; a landing point is legal for s if it is on the board and not blocked (a point
;; the foe holds with 2+). Landing on a blot is legal (and hits).
(define (landing-ok? dest s) (and (on-board? dest) (not (blocked? dest s))))

;; entry point from the bar for side s with die d: X enters at index d-1,
;; O enters at index 24-d. (Coming in from the start of its run.)
(define (bar-entry d s) (if (eq? s 'x) (- d 1) (- 24 d)))
(define (bar-count s) (if (eq? s 'x) X-BAR O-BAR))
(define (set-bar! s v) (if (eq? s 'x) (set! X-BAR v) (set! O-BAR v)))
(define (off-count s) (if (eq? s 'x) X-OFF O-OFF))
(define (bump-off! s) (if (eq? s 'x) (set! X-OFF (+ X-OFF 1)) (set! O-OFF (+ O-OFF 1))))

;; --- home-board test: can s bear off yet? (all 15 in the last 6 points) -----
;; X home = points 18..23 ; O home = points 0..5.
(define (all-home? s)
  (and (= (bar-count s) 0)
       (let loop ((i 0) (seen 0))
         (cond ((>= i 24) #t)
               ((mine? i s)
                (if (if (eq? s 'x) (>= i 18) (<= i 5))
                    (loop (+ i 1) (+ seen (count-at i)))
                    #f))
               (else (loop (+ i 1) seen))))))

;; =======================  APPLY / UNDO A SINGLE DIE MOVE  =======================
;; A move is (from dest hit?) where hit? = #t when a blot was sent to the bar.
;; from = -1 means "from the bar". dest = 24 (x) / -1 (o) sentinels a bear-off.

(define (mk-move from dest hit) (list from dest hit))
(define (m-from m) (car m))
(define (m-dest m) (car (cdr m)))
(define (m-hit  m) (car (cdr (cdr m))))

(define (apply-move! m s)
  (let ((from (m-from m)) (dest (m-dest m)))
    ;; lift the checker off its source (bar or a point)
    (if (= from -1) (set-bar! s (- (bar-count s) 1)) (remove-checker! from s))
    (cond
      ((bearing-off? dest s) (bump-off! s))
      (else
       ;; a hit: the lone foe there goes to ITS bar
       (when (m-hit m)
         (pt! dest 0)
         (set-bar! (other s) (+ (bar-count (other s)) 1)))
       (add-checker! dest s)))))

;; =======================  MOVE GENERATION FOR ONE DIE  =======================
;; Given a die value d and side s, list every legal single-die move. If s has
;; checkers on the bar it MUST enter first — only bar moves are generated then.
(define (gen-die-moves d s)
  (if (> (bar-count s) 0)
      ;; must enter from the bar
      (let ((e (bar-entry d s)))
        (if (landing-ok? e s)
            (list (mk-move -1 e (blot? e s)))
            '()))
      ;; normal: every point we own, moved by d
      (let loop ((i 0) (acc '()))
        (if (>= i 24) (reverse acc)
            (if (mine? i s)
                (let ((dest (dest-of i d s)))
                  (cond
                    ((bearing-off? dest s)
                     ;; can only bear off once fully home; exact or overshoot-from-highest
                     (if (and (all-home? s) (bear-off-ok? i d s))
                         (loop (+ i 1) (cons (mk-move i (if (eq? s 'x) 24 -1) #f) acc))
                         (loop (+ i 1) acc)))
                    ((landing-ok? dest s)
                     (loop (+ i 1) (cons (mk-move i dest (blot? dest s)) acc)))
                    (else (loop (+ i 1) acc))))
                (loop (+ i 1) acc))))))

;; bear-off legality: an exact roll always bears off; a larger roll bears off the
;; highest checker only if no checker sits farther from home.
(define (bear-off-ok? from d s)
  (let ((need (if (eq? s 'x) (- 24 from) (+ from 1))))   ;; pips to get off
    (or (= d need)
        (and (> d need) (highest-in-home? from s)))))

;; is `from` the farthest-back checker in s's home board?
(define (highest-in-home? from s)
  (if (eq? s 'x)
      (let loop ((i 18)) (cond ((>= i from) #t)
                               ((mine? i s) #f) (else (loop (+ i 1)))))
      (let loop ((i 5))  (cond ((<= i from) #t)
                               ((mine? i s) #f) (else (loop (- i 1)))))))

;; =======================  PIP COUNT  =======================
;; total steps a side still owes: on-board distance + bar (a full trip) each.
(define (pip-count s)
  (let loop ((i 0) (acc 0))
    (if (>= i 24)
        (+ acc (* (bar-count s) 25))     ;; a checker on the bar owes a full 25
        (loop (+ i 1)
              (if (mine? i s)
                  (+ acc (* (count-at i) (if (eq? s 'x) (- 24 i) (+ i 1))))
                  acc)))))

;; =======================  MOVE SCORING (the readable brain)  =======================
;; Score a single-die move for side s. Higher = better. The weights ARE the
;; playstyle, and 'adaptive nudges them based on how the human has been playing.

;; adaptive state: how many times the human (x) has hit O so far this game.
(define HUMAN-HITS 0)
(define O-BLOTS-LEFT 0)                  ;; running note for the HUD

(define (safety-weight)                  ;; how much O values NOT leaving a blot
  (if (and (eq? AI-PLAN 'adaptive) (>= HUMAN-HITS 1))
      (+ 6 (* 3 HUMAN-HITS))             ;; you keep hitting me -> I play safe
      2))

(define (score-move m s)
  (let* ((from (m-from m)) (dest (m-dest m))
         (hit (if (m-hit m) 8 0))                       ;; sending a blot to the bar
         (off (if (bearing-off? dest s) 12 0))          ;; bearing a checker off
         ;; progress toward home (each step forward is worth a little)
         (prog (if (= from -1) 0
                   (if (eq? s 'x) (- dest from) (- from dest))))
         ;; making a point: land where we already have exactly one (pairs up = safe)
         (make (if (and (on-board? dest) (mine? dest s) (= (count-at dest) 1)) 5 0))
         ;; leaving a blot behind (source becomes lone) is risky
         (expose (if (and (>= from 0) (= (count-at from) 2)) (- 0 (safety-weight)) 0))
         ;; landing alone in enemy territory is risky too
         (land-blot (if (and (on-board? dest) (not (mine? dest s))
                             (not (m-hit m)))
                        (- 0 (quotient (safety-weight) 2)) 0))
         ;; tie-break: run the farthest-back checker (bigger `back` = farther)
         (back (if (= from -1) 30 (if (eq? s 'x) (- 24 from) (+ from 1)))))
    (+ hit off make expose land-blot prog (quotient back 4))))

;; =======================  PICK A DIE MOVE FOR A SIDE  =======================
;; Choose the best-scoring legal move for die d. LEVEL 'hard adds a shallow, CHEAP
;; reply-look: it counts the DIRECT SHOTS the opponent would have at the blot this
;; move would leave (an enemy checker sitting 1..6 pips away with a clear landing),
;; and subtracts that danger. No move-generation, no board copy — just a scan of
;; the destination square's neighbourhood, so it stays well inside the fuel budget.

;; would a checker of side s standing on point `p` be a blot exposed to a direct
;; shot? count enemy checkers 1..6 pips "behind" it that could land on p.
(define (direct-shots-on p s)
  (let ((f (other s)))
    ;; the foe moves toward its own off-edge; a foe checker can hit p if it sits
    ;; d pips away on the side it is coming FROM. For O (moving down) that is p+d;
    ;; for X (moving up) that is p-d. `s` owns the blot, so the foe is `other s`.
    (let loop ((d 1) (n 0))
      (if (> d 6) n
          (let ((src (if (eq? f 'x) (- p d) (+ p d))))  ;; where the hitter sits
            (if (and (on-board? src) (foe? src s) (> (count-at src) 0))
                (loop (+ d 1) (+ n 1))
                (loop (+ d 1) n)))))))

;; danger a move creates: shots at any of OUR blots after we (side s) move.
;; We approximate by looking at the move's destination and its old source: if the
;; destination lands us alone, and/or the source is left as a blot, sum the shots.
(define (move-danger m s)
  (let ((from (m-from m)) (dest (m-dest m)) (d 0))
    ;; source left as a blot (we moved one off a pair)?
    (when (and (>= from 0) (= (count-at from) 2))
      (set! d (+ d (direct-shots-on from s))))
    ;; destination a lone checker in the open (not a hit, not a made point)?
    (when (and (on-board? dest) (not (m-hit m)) (not (mine? dest s))
               (= (count-at dest) 0))
      (set! d (+ d (direct-shots-on dest s))))
    (* d 3)))                            ;; each direct shot is a real risk

(define (level-deep?) (eq? LEVEL 'hard))

(define (pick-die-move d s)
  (let ((moves (gen-die-moves d s)))
    (if (null? moves) #f
        (let loop ((ms moves) (best #f) (bv -100000))
          (if (null? ms) best
              (let* ((base (score-move (car ms) s))
                     (v (if (level-deep?) (- base (move-danger (car ms) s)) base)))
                (if (> v bv) (loop (cdr ms) (car ms) v)
                             (loop (cdr ms) best bv))))))))

;; =======================  PLAY A WHOLE TURN  =======================
;; Consume the dice one at a time, each time picking and applying the best legal
;; move for that die. Track hits for the adaptive read. Returns a short log.
(define (play-turn! s dice)
  (let loop ((ds dice) (moves-made 0) (hits 0))
    (if (null? ds)
        (list moves-made hits)
        (let ((m (pick-die-move (car ds) s)))
          (if (eq? m #f)
              (loop (cdr ds) moves-made hits)     ;; this die can't be used — skip
              (let ((was-hit (m-hit m)))
                (apply-move! m s)
                (when (and was-hit (eq? s 'x)) (set! HUMAN-HITS (+ HUMAN-HITS 1)))
                (loop (cdr ds) (+ moves-made 1) (if was-hit (+ hits 1) hits))))))))

;; =======================  READ OF THE HUMAN (adaptive HUD)  =======================
(define (human-style)
  (cond ((= HUMAN-HITS 0) "quiet so far")
        ((= HUMAN-HITS 1) "hit once")
        ((<= HUMAN-HITS 3) "an aggressive hitter")
        (else "a relentless hitter")))

;; =======================  RENDER (SD framebuffer)  =======================
;; 24 triangular points in two rows of 12, alternating light/dark, checkers as
;; stacked discs, a center bar, and off-trays on the sides.

(define BOARD-X 20) (define BOARD-Y 26)
(define PT-W 20)    (define PT-H 78)    (define GAP 84)   ;; vertical gap between rows

;; A calm, seed-driven starfield in the thin band above the board — drawn from
;; the LCG constants (not the clock) so it is identical every run.
(define (draw-background)
  (clear COL-FELT)
  (let loop ((n 0) (s SEED))
    (when (< n 30)
      (let* ((s2 (modulo (+ (* s 1103515245) 12345) 2147483648))
             (x  (modulo s2 W))
             (s3 (modulo (+ (* s2 1103515245) 12345) 2147483648))
             (y  (modulo s3 (- BOARD-Y 4))))    ;; stars stay in the top band
        (pset x y COL-STARS)
        (loop (+ n 1) s3)))))

;; TEACHING IDEA — a title screen is just ANOTHER drawing; the same verbs that
;; paint the board paint the splash. Order: show title, play the theme, then go.
(define (draw-title)
  (draw-background)
  (set-color 0)         (rect-fill 34 66 252 66)      ;; drop shadow
  (set-color COL-BAR)   (rect-fill 30 62 252 66)      ;; banner
  (set-color COL-FRAME) (rect 30 62 252 66)
  (fb/text "BACKGAMMON" 104 82 'yellow)
  (fb/text "you  vs  Motoi" 116 100 'white)
  ;; a scrap of art: two little checkers + a die-pip triple
  (set-color COL-YOU)  (disc 138 132 7)
  (set-color COL-MOTO) (disc 182 132 7)
  (set-color COL-LIGHT)(triangle-fill 152 150 168 150 160 166 COL-LIGHT)
  (fb/text "* PRESS START *" 106 176 'green)
  (fb/text "rolling..." 130 194 'lavender))

;; screen x for point index's column (0..11 across each row)
(define (col-of i) (if (< i 12) i (- 23 i)))   ;; top row 12..23 mirrors bottom 0..11
(define (top-row? i) (>= i 12))
(define (point-x i)
  (let ((c (col-of i)))
    (+ BOARD-X (* c (+ PT-W 3)) (if (>= c 6) 14 0))))  ;; a bar-gap after the 6th

(define (draw-point i)
  (let* ((x (point-x i))
         (top (top-row? i))
         (base-y (if top BOARD-Y (+ BOARD-Y GAP PT-H)))
         (tip-y  (if top (+ BOARD-Y PT-H) (+ BOARD-Y GAP)))
         (light (= (modulo i 2) 0))
         (c (if light 15 4)))              ;; peach / brown
    ;; triangle: base at the edge, tip toward center
    (triangle-fill x base-y (+ x PT-W) base-y (+ x (quotient PT-W 2)) tip-y c)))

(define (draw-checkers i)
  (let* ((n (count-at i)) (o (owner i)))
    (when (and o (> n 0))
      (let* ((x (+ (point-x i) (quotient PT-W 2)))
             (top (top-row? i))
             (col (if (eq? o 'x) 7 8)))     ;; white for you, red for Motoi
        (set-color col)
        (let loop ((k 0))
          (when (and (< k n) (< k 5))
            (let ((cy (if top (+ BOARD-Y 8 (* k 14))
                              (+ BOARD-Y GAP PT-H -8 (- 0 (* k 14))))))
              (disc x cy 6)
              (set-color 0) (fb/text (number->string n) (- x 2) (- cy 3)
                                     (if (eq? o 'x) 'black 'white))
              (set-color col))
            (loop (+ k 1))))))))

(define (draw-hud turn dice)
  (set-color 5) (rect-fill 250 26 66 174)
  (fb/text "BGAMMON" 254 30 'yellow)
  (fb/text (string-append "you  " (number->string (pip-count 'x))) 254 46 'white)
  (fb/text (string-append "moto " (number->string (pip-count 'o))) 254 60 'white)
  (fb/text "(pips)" 254 74 'lavender)
  (fb/text (string-append "turn " (if (eq? turn 'x) "YOU" "MOT")) 254 92 'white)
  (fb/text (string-append "off Y" (number->string X-OFF)) 254 110 'green)
  (fb/text (string-append "off M" (number->string O-OFF)) 254 124 'green)
  (fb/text (string-append "bar " (number->string X-BAR) "/" (number->string O-BAR))
           254 138 'orange)
  (fb/text "dice" 254 158 'lavender)
  (fb/text (dice->str dice) 254 172 'peach))

(define (dice->str dice)
  (let loop ((ds dice) (acc ""))
    (if (null? ds) acc
        (loop (cdr ds) (string-append acc (number->string (car ds)) " ")))))

(define (draw-board turn dice)
  (draw-background)                           ;; felt + a faint starfield behind all
  ;; frame + center bar
  (set-color 6) (rect BOARD-X (- BOARD-Y 2) 218 (+ (* 2 PT-H) GAP 4))
  (set-color 5) (rect-fill (+ BOARD-X (* 6 (+ PT-W 3))) (- BOARD-Y 2)
                           12 (+ (* 2 PT-H) GAP 4))
  (let loop ((i 0)) (when (< i 24) (draw-point i) (loop (+ i 1))))
  (let loop ((i 0)) (when (< i 24) (draw-checkers i) (loop (+ i 1))))
  (draw-hud turn dice))

;; ASCII mini status — cheap between-frame readability
(define (print-status turn dice mv hits)
  (display "turn ")
  (display (if (eq? turn 'x) "YOU" "MOT"))
  (display "  dice ") (display (dice->str dice))
  (display " moves=") (display mv)
  (when (> hits 0) (display " HIT!x") (display hits))
  (display "  pips you=") (display (pip-count 'x))
  (display " moto=") (display (pip-count 'o))
  (display "  bar ") (display X-BAR) (display "/") (display O-BAR)
  (newline))

;; =======================  DRIVER  =======================

(set-mode 'sd)
(setup!)

(display "=== BACKGAMMON — Motoi SD (320x240) ===") (newline)
(display "You (X, runs up & off) vs Motoi (O, runs down & off)") (newline)
(display "AI-PLAN=") (display AI-PLAN)
(display "   LEVEL=") (display LEVEL)
(display "   SEED=") (display SEED) (newline)
(display "Dice are deterministic — same SEED, same game. Hit blots to the bar!")
(newline) (newline)

;; SPLASH FIRST: draw the title frame, sound the theme, THEN play. This is the
;; ONE extra dump the charm layer allows — the loading screen. To stay within the
;; two-dump budget, the old mid-game screenshot is now a compact ASCII line only.
(play-theme!)
(draw-title)
(display "--- SD title screen ---") (newline)
(fb/dump 0 0 W H)
(newline)

(define RESULT "")

(let loop ((turn-no 1) (side 'x))
  (cond
    ((>= X-OFF 15) (set! RESULT "YOU bore off all 15 — you win!"))
    ((>= O-OFF 15) (set! RESULT "Motoi bore off all 15 — Motoi wins."))
    ((> turn-no MAX-TURNS)
     (set! RESULT
       (let ((d (- (pip-count 'o) (pip-count 'x))))  ;; fewer pips = ahead
         (cond ((> d 0) "turn cap reached — YOU lead the race (fewer pips)")
               ((< d 0) "turn cap reached — Motoi leads the race (fewer pips)")
               (else "turn cap reached — a dead-even race")))))
    (else
     (let* ((dice (roll))
            (res  (play-turn! side dice))
            (mv   (car res)) (hits (car (cdr res))))
       (sfx-roll!)                          ;; the clatter of the dice
       (when (> hits 0) (sfx-hit!))         ;; a blot just went to the bar
       (when (= (modulo turn-no SHOW-EVERY) 0)
         (print-status side dice mv hits))
       (loop (+ turn-no 1) (other side))))))

;; =======================  RESULT  =======================

;; result jingle, then the final SD frame (the second and last dump)
(sfx-result! (- (pip-count 'o) (pip-count 'x)))    ;; fewer pips = ahead
(draw-board 'x (list 0 0))
(newline)
(display "--- SD screenshot @ final ---") (newline)
(fb/dump 0 0 W H)
(newline)

(display "RESULT: ") (display RESULT) (newline)
(display "Final pips  you=") (display (pip-count 'x))
(display "  Motoi=") (display (pip-count 'o)) (newline)
(display "Borne off   you=") (display X-OFF) (display "  Motoi=") (display O-OFF)
(newline)
(display "Motoi's read of you: ") (display (human-style)) (newline)
(newline)
(display "Fork it: set AI-PLAN to 'adaptive and hit Motoi's blots — watch it turn")
(newline)
(display "cautious. Or change SEED for a whole new roll of the dice.")
(newline)
