    ("~/code/motoi-scheme/spec/R7RS-SMALL-PRIMITIVE-FLOOR.slat"
     "~/code/motoi-scheme/spec/R7RS-SMALL-PRIMITIVE-FLOOR.md"
     "~/code/motoi-scheme/spec/VIRTUAL-SHAPE-VOCABULARY.slat"
