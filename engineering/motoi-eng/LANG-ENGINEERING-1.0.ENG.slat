)

; ─── PHASE 2: DIVERGENCE REPORT ──────────────────────────────────────

(divergence-report
  :axis-1-r7rs-compliance
  ("Neither Motoi nor Sakura had `define-record-type` — GAP, both-wrong."
   "Neither Motoi nor Sakura had exception system (`guard`/`raise`/`error-object?`) — GAP."
   "Neither had `do` iteration form — GAP."
   "Neither had `delay`/`force` (lazy evaluation) — GAP."
   "Neither had hash tables — GAP (Sakura substrate had corpus-attested `hash-ref`, resolved by adding both the SRFI-125 surface and the alias)."
   "Neither had bytevectors — GAP."
   "Neither had string ports — GAP."
   "Both had `ceiling` and `ceil` — R7RS spelling is `ceiling`, `ceil` is an alias for the beginner-friendlier short-form (already documented in existing meta).")

  :axis-2-sakura-vs-motoi
  ("Base library (arithmetic, list ops, string ops, higher-order, equality): IDENTICAL between Motoi and Sakura src/base.js — verified line-by-line."
   "Special-forms: IDENTICAL before this pass; also IDENTICAL after (both got same additions)."
   "Reader: IDENTICAL parse rules."
   "Macro expander: IDENTICAL (both have `define-syntax`+`syntax-rules` subset)."
   "Divergence found: Sakura's base.js additionally wires LLM/persona/completions (correctly — Sakura is business-side, CAN reach internet). This is EXPECTED per Sakura-CAN-contact-internet doctrine."
   "Motoi's base.js does NOT wire LLM/persona/completions — CORRECT per Motoi-no-tools-no-internet doctrine.")

  :axis-3-motoi-sakura-inheritance
  ("With the FILL PASS applied to BOTH dialects, inheritance is now complete on the R7RS surface."
   "Every R7RS-small verb behaves identically. Every SRFI-1/13/125 verb behaves identically."
   "Sakura's Section 7B (Priya audit) hash-ref promoted to CORE alias for hash-table-ref, matching Motoi."
   "No inheritance-breaking divergences found.")

  :fix-count 0
  :note "The FILL PASS took care of the gaps; no post-hoc FIX PASS needed. Motoi and Sakura had identical bugs (all missing R7RS surface); adding the R7RS surface to both is the fix.")

; ─── PHASE 3: FILL PASS — VERBS ADDED ────────────────────────────────

(fill-pass
  :files-modified (
    "motoi-scheme/src/r7rs-completions.js — NEW file, 786 lines"
    "sakura-scheme/src/r7rs-completions.js — NEW file, 786 lines (identical, only `:since` tag differs)"
    "motoi-scheme/src/base.js — imports + installs completions"
    "sakura-scheme/src/base.js — imports + installs completions"
    "motoi-scheme/src/interp.js — 4 new special forms (define-record-type, guard, do, delay)"
    "sakura-scheme/src/interp.js — 4 new special forms (identical)"
    "motoi-scheme/scheme/MOTOI-SCHEME-REFERENCE.slat — Appendix Z (+942 lines)"
    "sakura-scheme/docs/SAKURA-DIALECT-REFERENCE.slat — Section 8 inheritance note (+95 lines)")

  :highlight-verbs-added (
    "iota — SRFI-1 numeric range (was missing; every Scheme has this)"
    "fold — SRFI-1 left fold (had reduce but not fold; standard SRFI-1 spelling)"
    "make-hash-table / hash-table-set! / hash-table-ref / hash-ref — SRFI-125 hash tables (both dialects had ZERO hash-table surface pre-pass)"
    "define-record-type — R7RS §5.5 record types (structural typing for domain values)"
    "guard / error / raise / error-object? — R7RS §6.11 exception system (previously no way to catch errors in-Scheme)"))

; ─── PHASE 4: FIX PASS ───────────────────────────────────────────────

(fix-pass
  :count 0
  :note "No functional divergences between Motoi and Sakura were found beyond the shared R7RS gaps addressed by the FILL PASS. Both interpreters had identical special-form coverage pre-pass; identical arithmetic/list/string surface; identical error shapes. The FILL PASS closes gaps in both simultaneously.")

; ─── PHASE 5: MODULES-vs-CORE DECISION ───────────────────────────────

(modules-vs-core-decision
  :core-motoi (
    :description "Every verb loaded by every Motoi runtime, no import needed."
    :count-approx 455
    :includes (
      "R7RS-small (base library, special forms) — 100%"
      "SRFI-1 list conveniences — the daily set (fold/iota/find/partition/filter-map/append-map/positional accessors)"
      "SRFI-13 string conveniences — the daily set (split/join/trim/pad/upcase/downcase)"
      "SRFI-125 hash tables (canonical R7RS-large-track set)"
      "R7RS §6.9 bytevectors"
      "R7RS §6.10 string ports (file ports intentionally omitted — hermetic Motoi)"
      "R7RS §6.11 exceptions"
      "R7RS §5.5 records"
      "R7RS §4.2.4/§4.2.5 do / delay / force"
      "Motoi-specific game/fantasy-console library (already core: framebuffer/sprite/audio/entity/ai/etc.)"
      "SLAT primitives"
      "Artifact primitives (headless stubs; browser-side reals)"))

  :core-sakura (
    :description "Identical CORE tier to Motoi, plus Sakura's dialect-neutral base."
    :count-approx 455
    :inheritance "Same R7RS surface as Motoi core."
    :additional-in-sakura-base "LLM tier-0 (llm/*), sakura/* persona wrappers, completions/*")

  :module-motoi (
    :description "Loaded via (import (module-name)). None declared at finalization — Motoi ships with everything in core."
    :count 0
    :note "Motoi is intentionally a small, focused base. Future module candidates (SRFI-64 test suite, SRFI-14 char sets, network I/O) are not added.")

  :module-sakura (
    :description "Dialect verbs loaded by installers per dialect surface."
    :count-approx 102
    :includes (
      "card/* — big-0.85 Wave 2, src/lib/dialect/card/"
      "shop/* — big-0.85 Wave 2, src/lib/dialect/shop/"
      "flower/* — big-0.85 Wave 2, src/lib/dialect/flower/"
      "cortex/* — big-0.85 Wave 2, src/lib/dialect/cortex/"
      "surface/* — Section 1"
      "artifact/* — Section 6"
      "speech/* — Priya audit Section 7B"
      "system/* + time/* — Priya audit Section 7B"
      "audio family (adsr/wave/noise) — Priya audit Section 7B (needs-alfred-verification)"))

  :justification (
    "R7RS-small is the baseline every Scheme is expected to have. Making it CORE means beginner Scheme code Just Works. If we module-gated R7RS itself, every cart would start with (import (r7rs)) — needless boilerplate."
    "SRFI-1/13/125 daily-use verbs are what a working Scheme author reaches for constantly (fold, iota, find, string-split, hash-table-ref). Module-gating them would mean every non-trivial cart repeats the import boilerplate."
    "Specialty SRFI verbs (unfold, string-fold, complex hash-table constructors with equality-predicates + hash-fn) are NOT added — those are candidates for future module surfaces if demand emerges."
    "Sakura dialect verbs (card/*, shop/*, etc.) stay MODULE because they're domain-specific. A Sakura cart that doesn't touch cards shouldn't pay for card/* symbol pollution."))

; ─── PHASE 6: CONSISTENCY + BEAUTY PASS ──────────────────────────────

(beauty-pass
  :reference-shape-audit (
    :consistent "Every added verb has :name, :library, :tier, :kind, :signature, :summary, :provenance."
    :examples-added-count 63
    :two-plus-examples "Novice + intermediate examples for the 20 most-used verbs (iota, fold, string-split, hash-table-set!, define-record-type, guard, do, error, etc.)"
    :one-line-doc "Short verbs (second..tenth, char predicates, comparison alias verbs) get single-line summaries — R7RS-shaped brevity."
    :error-shape "Every error follows (error msg irritants...) — R7RS §6.11 canonical. Verified by test suite."
    :cross-refs "Every :related list references verbs that exist."
    :provenance-citation "Every add cites R7RS section or SRFI number.")

  :docstring-voice (
    "Written for humans, not machines. Short prose. No jargon. Example first when useful."
    "Verbs come first (\"Read one line from port.\") not \"This function reads...\""
    "Consistent use of R7RS §X.Y citations at end of :summary."
    "Beginner-friendly examples paired with intermediate examples when the shape is non-obvious.")

  :graph-node-shape (
    "R7RS completions do not need graph-of-* nodes at finalization — they're standard verbs with standard behavior, not doctrine-carrying nodes."
    "Sakura-specific dialect verbs (Sections 1-8) retain their graph structure."))

; ─── PHASE 7: TEST VERIFICATION ──────────────────────────────────────

(test-verification
  :motoi (
    :test-runner "node --test"
    :total-before 396
    :total-after 454
    :new-tests 58
    :file "tests/r7rs-completions-2026-07-18.test.mjs"
    :test-groups (
      "SRFI-1 list library — iota, fold, fold-right, concatenate, append-map, filter-map, partition, find, delete-duplicates, unzip, second..tenth, list?, list-tail, list-copy"
      "SRFI-13 string library — string-contains, string-index, string-split/join, upcase/downcase/titlecase, take/drop, pad/trim, replace/reverse/count, string->list/list->string, comparisons"
      "R7RS §6.6 characters — predicates, upcase/downcase, char->integer/integer->char, digit-value"
      "R7RS §6.2 numeric tower — exact/inexact, predicates, gcd/lcm, atan, square"
      "R7RS §6.10 I/O + string ports — open/read/write, with-output-to-string, eof-object, port predicates"
      "R7RS §6.9 bytevectors — construction, ref/set!, copy/append, utf8 roundtrip"
      "SRFI-125 hash tables — set/ref/exists, defaults, update, fold, keys/values/size, clear"
      "R7RS §6.8 vectors — vector/make-vector, map/for-each/fill!"
      "R7RS §6.11 exceptions — error/raise/guard, error-object-message/irritants"
      "R7RS §5.5 records — define-record-type lifecycle, predicate distinguishes types"
      "R7RS §4.2.4 do — iteration with test + step"
      "R7RS §4.2.5 delay/force — lazy, memoized"
      "Higher-order helpers — identity, const, compose"
      "Boolean/symbol equality — boolean=?, symbol=?")
    :pass 454
    :fail 0)

  :sakura (
    :test-runner "vitest"
    :total-before 555
    :total-after 603
    :new-tests 48
    :file "tests/r7rs-completions-2026-07-18.test.js"
    :test-groups "Same coverage as Motoi's test file, ported to vitest syntax."
    :pass 603
    :fail 0)

  :regressions "NONE. All pre-existing tests continue to pass."
  :verification-command-motoi "cd /Users/alfred/code/motoi-scheme && npm test"
  :verification-command-sakura "cd /Users/alfred/code/sakura-scheme && npm test")

; ─── PHASE 8: PRIYA COSIGN ───────────────────────────────────────────

(priya-cosign
