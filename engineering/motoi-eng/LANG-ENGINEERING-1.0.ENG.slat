  :table-b-summary (
    :total-verbs-added 120
    :total-special-forms-added 4
    :verbs-in-both-dialects "identical semantics, identical signatures, identical error shapes"
    :ref-appendix "motoi-scheme/scheme/MOTOI-SCHEME-REFERENCE.slat §APPENDIX Z (lines 18525-19467)"
