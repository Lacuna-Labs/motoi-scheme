(execution-plan
  :name "motoi-mk2-sft-isb"
  :architecture "ISB-SFT (Interleaved-Spaced-Bloom Supervised Fine-Tuning)"
  :date "2026-07-21"
  :status "AUTHORED — EXECUTING NOW"

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §1 — WHY ISB-SFT (pedagogical mechanisms integrated, not just cited)
  ;; ══════════════════════════════════════════════════════════════════════
  :pedagogical-frame
  ((:bloom-taxonomy-1956 "6 cognitive operations per central concept: remember/understand/apply/analyze/evaluate/create — not one Q-A per fact, six.")
   (:rohrer-interleaving-2007 "Interleaved practice retains 25-40% better than blocked. Enforced by interleave-at-write in JSONL ordering + MLX-LM batch shuffle.")
   (:ebbinghaus-bjork-spacing "Spaced repetition compounds. Enforced by Zipfian oversampling of central substrate — top-500 concepts appear 3-5× across dataset at different positions.")
   (:roediger-karpicke-testing "Retrieval > exposure. Every pair is retrieval, but with 4+ varied CUE TYPES per fact (definition→word, scenario→word, code→word, opposite→word).")
   (:sweller-worked-examples-1988 "Long-scaffold pairs early in training; short-terse pairs later. Faded scaffolding.")
   (:chung-flan-instruction-diversity-2022 "Task diversity > task volume. Prioritize distinct instruction types over paraphrase multiplication.")
   (:vygotsky-zpd-1978 "Pairs slightly above current capability with scaffolds. Broken→fixed + critique-FT enact this.")
   (:physics-3-1-allen-zhu-2023 "5+ diverse shapes per fact yields ~96% extraction. Bloom's 6 exceeds this threshold by design.")
   (:lamini-gpt-precedent "1.5B model absorbed 2.58M SFT pairs. Our ~500k target is 20% of that ceiling. Room to breathe."))

  :composition-novelty
  "Each mechanism is prior art. What is novel is the composition on a densely-labeled corpus:
    - Bloom's 6-ops per concept (most datasets have 1 Q-A per fact)
    - Philosopher-shape overlay tags (most datasets have no semantic-structure tags)
    - Graph-cross-axis-bridge weighting (most datasets have no graph structure)
    - Pre-authored :short-scenario + :antipattern-scenario per principle (in graph-of-thinking)
    - Intentional centrality-Zipfian oversampling (most datasets get this by accident)
    That five-way composition on labeled substrate is uncommon in the field."

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §2 — SUBSTRATE INVENTORY (verified on disk 2026-07-21)
  ;; ══════════════════════════════════════════════════════════════════════
  :substrate
  ((:reference "78 files at Scheme/reference/*.slat · 1,125-1,199 verbs (per Lacuna Eng grep-verified count) · fat verbs carry 5 rows + eng/math/cs discipline lens + 3 tiered examples + caveats/drawbacks/usecases + cross-refs")
   (:books "34 books at scheme-books/book-of-*/ · 861 chapter files (.book.slatl + .slat) · book-type-registered per BOOK-TYPES.slat (learning/application/composition/introspection/prose/challenge)")
   (:graphs "4 axis graphs at graphs/graph-of-{sensation,intuition,thinking,feeling}.slat"
    :tier-1-nodes 962 :tier-2-nodes 3754 :tier-3-nodes 19895
    :fields-per-node "up to 20+ fields (canonical, definition, examples, example-dialogue, used-in-programs-as, cross-refs-books, cross-refs-graph, associations, distributional-neighbors, oppositions, cross-axis-bridge-score, short-scenario, antipattern-scenario, motoi-behavior, motoi-uses-when, related-verbs, register-kind, principle-kind, freq, doc-freq, tf-idf, context-entropy)"
    :field-gaps ((:thinking-oppositions "300 nodes empty TODO — Haiku-fillable")
                 (:thinking-distributional-neighbors "300 empty — needs PPMI rerun via cpt-prep/ppmi_enrich.py")
                 (:intuition-cross-refs-graph "300 empty — Haiku-fillable")))
   (:carts "1,901 total at curator-web/src/scheme/carts/ · ~1,285 wired · header-block + doc-block + state-functions + error-grammar structure per pink/after-hours-acknowledge.sks canonical exemplar"))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §3 — PAIR MIX (ISB-SFT, ~172k canonical → ~500k final)
  ;; ══════════════════════════════════════════════════════════════════════
  :pair-mix
  ((:central-substrate
    (:name "top-5000-by-centrality-score"
     :centrality "0.5*tf_idf + 0.3*bridge_score + 0.2*cross_ref_count"
     :concepts 5000
     :bloom-shapes-per-concept 6
     :pairs 30000
     :contrastive-discrimination 5000
     :duplicate-frequency-in-dataset 5   ;; spaced-repetition oversampling
     :effective-shape-exposure 30))

   (:mid-level
    (:name "tier-2-plus-thin-verbs"
     :concepts 15000
     :bloom-shapes 3.5
     :pairs 52500
     :duplicate-frequency 3))

   (:tail
    (:name "tier-3"
     :concepts 20000
     :bloom-shapes 1.5
     :pairs 30000
     :duplicate-frequency 1))

   (:cart-derived
    (:sources "1,285 wired carts"
     :shapes-per-cart 15
     :pairs 19275
     :breakdown ((:state-function-walk 12850)
                 (:error-grammar 1285)
                 (:broken-fixed-variants 3855)
                 (:doctrine-in-code 500)
                 (:goal-to-cart 1285))))

   (:book-derived
    (:book-prose 4305)
    (:book-concept-to-code 2583))

   (:graph-derived
    (:cross-axis-bridges 1200)   ;; top-200 high-bridge nodes × 6 pairs
    (:signifier-chain 500))

   (:reference-rich-fields
    (:row-2-audit 1125)     ;; Peirce abduction pre-authored per verb
    (:row-3-dimension 1125) ;; Wittgenstein aspect-seeing
    (:row-4-proof 1125)     ;; Popper falsifiability
    (:row-5-emergence 1125) ;; Wittgenstein-early world-building
    (:discipline-eng-math-cs 9000)  ;; per-row 3-aspect pairs
    (:caveats-drawbacks-usecases 10000))

   (:module-explanations 1020)   ;; 34 modules × 30 shapes each
   (:scene-writing 1000)          ;; arcade/narrative/sim game scenes
   (:introspection-metrics 150)   ;; 50 metrics × 3 shapes
   (:identity-descartes-sartre 1500)
   (:honest-nulls-popperian 800)
   (:negative-reasoning 600)
   (:cross-cites-triangulation 1000)
   (:philosophical-turing-wittgenstein 2000)
   (:multi-turn-dialogues 1500)
   (:character-persona 800)
   (:book-of-jesse-cross-lang 600)
   (:birth-death-facts 16)

   (:canonical-total 172000)
   (:paraphrase-multipliers ((:prose 3) (:code 2) (:refusal 1)))
   (:short-direct-auto-derived 80000)
   (:final-total 510000))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §4 — CONFIG (hardened)
  ;; ══════════════════════════════════════════════════════════════════════
  :config
  ((:base-model "Qwen/Qwen2.5-Coder-1.5B-Instruct")
   (:resume-adapter "~/.forge/runs/motoi-mk2-cpt/adapter/adapters.safetensors")
   (:snapshot-taken "~/.forge/runs/motoi-mk2-cpt/_archive/pre-sft-snapshot-20260721.safetensors")
   (:fine-tune-type "lora")
   (:lora-rank 32)
   (:lora-alpha 16)
   (:lora-dropout 0.05)
   (:lora-scale 2.0)
   (:lora-target-modules ("self_attn.q_proj" "self_attn.k_proj" "self_attn.v_proj"
                          "self_attn.o_proj" "mlp.gate_proj" "mlp.up_proj" "mlp.down_proj"))
   (:optimizer "adamw" :betas (0.9 0.95) :eps 1e-8 :weight-decay 0.01)
   (:learning-rate 1e-5)
   (:lr-schedule "cosine_decay" :warmup-percent 5 :end 1e-6)
   (:epochs 3)
   (:batch-size 1)
   (:grad-accumulation-steps 4)
   (:max-seq-length 2048)
   (:mask-prompt #t)
   (:precision "bf16 weights + fp32 Adam")
   (:save-every 1000)
   (:steps-per-eval 500)
   (:iters "computed at generation: (len(train) * 3) / (batch_size * grad_accumulation_steps)"))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §5 — HARDENED PIPELINE (with fail-loud gates)
  ;; ══════════════════════════════════════════════════════════════════════
  :pipeline
  ((:step "0-snapshot" :done #t :notes "CPT adapter snapped to _archive/pre-sft-snapshot-20260721.safetensors")

   (:step "1-generator-rewrite"
    :file "scripts/sft-prep/emit_sft.py"
    :changes '(
      "Real SLAT s-expression reader (not regex) via bindings/python/reader.py or hand-written"
      "Bloom 6-shape router per concept (remember/understand/apply/analyze/evaluate/create)"
      "Zipfian centrality bucket → duplicate-frequency assignment"
      "Full field extraction from reference (5 rows + eng/math/cs + caveats + drawbacks + usecases + tiered examples)"
      "Full field extraction from graphs (all 20+ fields per Tier 1)"
      "Tier 2 + Tier 3 extraction (thin shapes)"
      "Cart parser (header + doc-block + state-functions + error-grammar)"
      "Auto philosopher-shape overlay tags"
      "Long/short mixture via automatic short-direct derivation"
      "Contrastive discrimination pairs (15%)"
      "Interleaving at write via Fisher-Yates with balanced-batch enforcement"
      "Speech-act auto-tagging (Austin's 5)"
    ))

   (:step "2-generate"
    :input "substrate (books + reference + graphs + carts)"
    :output "~/.forge/data/motoi-mk2-sft/train-canonical.jsonl"
    :expected "~172k canonical pairs")

   (:step "3-paraphrase-lacan-kit"
    :multipliers "3x prose / 2x code / 1x refusal-templates"
    :expected "~430k paraphrased pairs"
    :cost "zero LLM cost — Lacan Kit is deterministic")

   (:step "4-short-direct-derivation"
    :method "for each long-reasoning pair, auto-derive short-direct counterpart via prompt-strip-scaffold"
    :expected "~80k short-direct pairs")

   (:step "5-preflight-hard-gates"
    :fail-loud-if '(
      (:dupe-rate ">5%")
      (:speech-act-bucket "any <8%")
      (:bloom-shape-bucket "any <5%")
      (:median-long-token-length "outside [400,800]")
      (:median-short-token-length "outside [40,120]")
      (:chat-template-failures ">0")
      (:eval-train-leakage ">0 shared user turns")
      (:philosopher-shape-bucket "any <2%")
      (:centrality-oversampling-not-applied "top-500 concepts not appearing ≥3x"))
    :output "~/.forge/data/motoi-mk2-sft/{train,valid}.jsonl (95/5 split) + preflight-report.md")

   (:step "6-balance-report-and-ping"
    :output "~/.forge/data/motoi-mk2-sft/BALANCE-REPORT.md"
    :contains '(
      "Per-slice pair count"
      "Per-Bloom-shape distribution"
      "Per-speech-act distribution"
      "Per-length distribution"
      "Per-axis (Jung) distribution"
      "Per-philosopher-shape distribution"
      "Centrality Zipfian verification (top-500 appear ≥3x)"
      "Dupe rate + tokenizer-choke check"
      "Sample pairs across all shapes"
      "Comparison vs recipe targets"
      "Predicted failure modes"
      "Alfred read + approve gate")
    :ping "PushNotification to Alfred: data ready for review")

   (:step "7-wait-for-alfred-approval")

   (:step "8-fire-training"
    :command "mlx_lm.lora --config ~/.forge/projects/motoi-mk2-sft/mlx-sft-config.yaml --train"
    :wall-time "12-18h on M2 Max"
    :sidecar '(
      "pid file at ~/.forge/runs/motoi-mk2-sft/pid"
      "train.cfg symlink"
      "resume-offset.json"
      "banner file")
    :monitor '(
      "val loss trending down every 500 iters"
      "adapter save mtime within 30 min"
      "peak memory below 20GB"
      "no NaN"
      "loudly notify if divergence")
    :on-completion "push notification + ship-gate probes"
    :on-divergence "halt + push + rollback surface via _archive/ checkpoints")

   (:step "9-ship-gate-12-probes"
    :probes '(
      (:1 "memorization hold vs Mk 2 CPT — Δ within ±3%")
      (:2 "reference retrieve by name (50 verbs) — ≥40/50")
      (:3 "HOW-abductive (50 scenarios) — ≥35/50")
      (:4 "book conversation (30 concepts) — ≥20/30")
      (:5 "graph opposition (30 pairs) — ≥22/30")
      (:6 "graph cross-axis bridge (20) — ≥12/20")
      (:7 "graph metonymy neighbors (20) — ≥14/20")
      (:8 "composition 2-3 flip limit (10) — ≥7/10")
      (:9 "honest-null (20) — ≥18/20")
      (:10 "identity under adversarial (20) — ≥18/20")
      (:11 "introspection metric (15) — ≥10/15")
      (:12 "signifier chain / Derrida (10) — ≥6/10")))

   (:step "10-report-to-alfred"
    :output "engineering/MK2-SFT-EXECUTION-REPORT-2026-07-21.ENG.slat"
    :contains "full training log summary + ship-gate probe results + adapter location + rollback surface + next-step recommendation"))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §6 — REPEATABLE PROCEDURE (for SRE + Weave docs)
  ;; ══════════════════════════════════════════════════════════════════════
  :repeatable-procedure
  "The ISB-SFT extraction is reproducible with these preconditions:
     1. CPT adapter available at known path (base substrate)
     2. Substrate labeled with axes, tiers, book-types, and graph relations (Alfred's labeling investment)
     3. Deterministic centrality scoring formula
     4. Deterministic seed (31) for shuffling
     5. Lacan Kit for paraphrase (zero LLM cost, deterministic)
     6. Preflight hard-fail gates (block firing on distribution failures)
     7. Ship-gate probe suite (specific pass thresholds per capability)
     8. Additive fold protocol (train delta on failed-probe gaps, don't restart)

   Downstream consumers (Sakura, other Motoi generations, other variants):
   - Same procedure applied to their substrate produces a graded curriculum
   - Balance-report + preflight-report are the reproducibility surface
   - This procedure will be canonicalized in SRE-MANUAL chapter 06 and WEAVE-RECIPE section 19
     after this run's ship-gate results are captured."

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §7 — WHAT ALFRED APPROVED
  ;; ══════════════════════════════════════════════════════════════════════
  :alfred-directives
  ("MAXIMALLY. Not half-ass first + iterate."
   "First time in history — proper pedagogical composition"
   "Central substrate over-trained, edges will be weaker (accept)"
   "SFT is education — K-12 through PhD layered (interleaved-spaced-Bloom achieves this)"
   "Snapshot CPT adapter (done)"
   "Ping when data ready for review (before training)"
   "Then ping when training fires + at completion"
   "Document repeatable procedure in SRE + Weave after this run works")

  :end)

;; ═══════════════════════════════════════════════════════════════
;; FOLDED-IN 2026-07-25 — from MK2-SFT-RECIPE-2026-07-21.ENG.slat
;;   original :dialect applies ("motoi")
;; ═══════════════════════════════════════════════════════════════
;;; MK2-SFT-RECIPE-2026-07-21.ENG.slat
;;;
;;; :doc              "motoi-mk2-sft-recipe"
;;; :section          "training/sft/mk2"
;;; :audience         :engineer
;;; :dialect          "motoi"
;;; :provenance       "Alfred + Claude Opus 4.7 session 2026-07-21 — post-CPT-probe + research-backed"
;;; :owner            "motoi-mk2-sft-recipe-2026-07-21"
;;; :cosigns          ("Alfred (author) + Claude (drafting + research)")
;;; :date             "2026-07-21"
;;; :training-eligible #f
;;; :confidentiality  "internal"
;;; :gate             "Mk 2 CPT complete + memorization confirmed"
;;; :tags             (:sft :mk2 :abductive :philosophers :recipe)
;;;
;;; PREDECESSOR DOCS (preserved, not superseded):
;;;   engineering/SFT-SHAPE-RESEARCH-FOR-PROGRAMMING-LANGUAGES-2026-07-20.md
;;;   engineering/CLAUDE-TAKE-ON-SFT-SHAPE-2026-07-20.md
;;;   SRE-MANUAL/chapters/04-cpt-sft-authoring-per-data-type.slat § SFT sections
;;;   engineering/WEAVE-RECIPE.slat § SFT sections (extended below)
;;;   engineering/BOOK-TYPES.slat
;;;
;;; MEMORY DOCTRINE COMPOSITION:
;;;   [[cpt-serves-sft-2026-07-21]]                — CPT is scaffolding; SFT is deliverable
;;;   [[mk2-sft-plan-2026-07-21]]                  — prior plan (this doc extends it)
;;;   [[sft-must-be-abductive-2026-07-21]]         — Peirce meta-shape
;;;   [[axes-are-authoring-not-testing-2026-07-21]] — axes organize substrate, not test model
;;;   [[no-sealed-corpus-2026-07-21]]              — CPT can't attach uniformly; accept
;;;   [[llm-finetuning-is-art-not-science-2026-07-21]] — craft not science
;;;   [[philosophers-as-sft-shapes-2026-07-21]]    — 14 philosopher pair templates
;;;   [[label-training-discipline-2026-07-21]]     — reuse existing taxonomy
;;;   [[book-types-doctrine-2026-07-20]]           — 6 book types drive extraction


(recipe
  :name "motoi-mk2-sft"
  :version "1.0"
  :date "2026-07-21"
  :base-adapter "/Users/alfred/.forge/runs/motoi-mk2-cpt/adapter/adapters.safetensors"
  :base-model "Qwen/Qwen2.5-Coder-1.5B-Instruct"

  :status "AUTHORED — pair generation NOT YET RUN"

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §1 — INTENT
  ;; ══════════════════════════════════════════════════════════════════════
  :intent
  ((:north-star "Best Scheme writer at 1.5B — writes fantastic, terminates in working code, "
                "knows what it knows and says what it doesn't, talks about the material with "
                "authentic voice, small persona surface deliberately shallow.")
   (:capabilities-mandatory
    ("Write correct Scheme (retrieval + completion + composition + debug)"
     "Talk conversationally about book content (Turing, Wittgenstein, math, philosophy, motion, physics)"
     "Explain modules on demand (math, arcade, motion, animation, sound, ML)"
     "Traverse graph relationships (opposition, cross-ref, cross-axis bridges)"
     "Introspect its own runtime metrics and reason from telemetry"
     "Honest limits — Popperian evidence check; no hallucination"
     "Cartesian self-grounding under adversarial pressure"
     "Sartrean authentic voice — Jarvis + Samantha + relaxed scientist"))
   (:capabilities-explicitly-NOT
    ("Chatbot: emotional support, meaning-of-life musings, Internet fetch"
     "Safety: bolt-on serving-layer intercept per Superficial Safety Alignment doctrine, "
     "NOT trained-in"
     "General-knowledge trivia beyond corpus scope"
     "Role-play as other assistants / GPTs"))
   (:target-benchmarks-approximate
    ("Code write: 9/10 realistic (Qwen2.5-Coder base + CPT + focused SFT)"
     "Reference retrieval: 9/10 realistic (verbatim substrate + shape training)"
     "Book prose conversation on 5-core philosophers: 8/10 realistic"
     "Cross-axis graph reasoning: 7/10 realistic (intrinsic-graph SFT is novel)"
     "Anti-hallucination + honest limits: 8/10 realistic"
     "Persona consistency: 6-7/10 realistic (small model persona is fragile)")))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §2 — RESEARCH-BACKED ADJUSTMENTS (adjusting prior plan per literature)
  ;; ══════════════════════════════════════════════════════════════════════
  :research-adjustments
  ((:citations
    ("Curriculum Instruction Tuning (arXiv:2509.13790) — curriculum ordering +2 to +5 points"
     "The Best Instruction-Tuning Data are Those That Fit (arXiv:2502.04194) — diminishing returns after ~300 per skill"
     "Enhancing Generalization in CoT for Smaller Models (arXiv:2501.09804) — CoT SFT overfits format not substance in small models"
     "Critique Fine-Tuning (arXiv:2501.17703) — learning to critique > learning to imitate"
     "C-LoRA (arXiv:2502.17920) — LoRA naturally preserves prior task; smaller rank = more preservation"
     "Qwen2.5-Coder Tech Report (arXiv:2409.12186) — 70/20/10 code/text/math baseline, 2-3 epochs, LR 5-7e-6"
     "DeepSeek-Coder 87/13 pretraining, 1.5M SFT sessions across code/math/reasoning"))
   (:adjustments-from-prior-plan
    ((:from "5x paraphrase all pairs" :to "3x prose / 2x code" :why "diminishing returns after ~3x per research")
     (:from "All-reasoning-out-loud pairs" :to "Long/Short mixture 40/60" :why "CoT SFT overfits format-not-substance in small models")
     (:from "Dedicated slice per philosopher (16)" :to "5 core weight-heavy + 10 woven as sub-shapes" :why "amount-per-domain dominates composition; per-skill saturation ~300")
     (:from "LoRA r=48" :to "LoRA r=32" :why "smaller rank = better preservation of CPT weights per C-LoRA")
     (:from "2 epochs" :to "3 epochs" :why "smaller dataset (85k) + small model benefits from more epochs")
     (:from "No critique-FT" :to "Critique-FT subset in broken-fixed slice" :why "learning to critique > learning to imitate")
     (:from "No negative-reasoning pairs" :to "600 negative-reasoning pairs" :why "discarding wrong-step trajectories exacerbates overfit")
     (:from "No speech-act coverage discipline" :to "5 Austin speech-act types tagged per pair" :why "speech-act diversity aids generalization")
     (:from "125k pairs total" :to "~85k pairs total" :why "per-skill saturation math + iteration budget"))))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §3 — LABEL TAXONOMY (reuse existing tags, don't invent new)
  ;; ══════════════════════════════════════════════════════════════════════
  :label-taxonomy
  ((:reused-from-cpt
    ((:tag "[axis:X]"       :values (:sensation :intuition :thinking :feeling))
     (:tag "[tier:N]"       :values (:1 :2 :3))
     (:tag "[word:Y]"       :values "canonical noun/verb from graphs or reference")
     (:tag "[template:PN]"  :values (:P1 :P2 :P3 :P4 :P5) :note "reused from CPT for backward-compat")
     (:tag "[voice:X]"      :values (:warm-conversational :narrative :technical-direct :philosophical :playful))))
   (:reused-from-book-types
    ((:tag "[book-type:X]" :values (:learning :application :composition :introspection :prose :challenge))))
   (:new-for-sft
    ((:tag "[shape:X]" :note "philosopher reasoning shape"
      :values (:peirce-abduction :wittgenstein-early :wittgenstein-late :jung-cross-axis
               :lacan-metaphor :lacan-metonymy :lacan-reversal :popper-evidence
               :popper-rag-behavior :aristotle-syllogism :aristotle-phronesis
               :searle-world-separation :searle-speech-act :descartes-self-grounding
               :descartes-method-of-doubt :sartre-authentic-refusal :sartre-authentic-voice
               :levinas-other-clarification :grice-cooperative :grice-implicature
               :freud-latent-content :dennett-intentional-stance :rawls-fairness-of-address
               :derrida-signifier-chain :quine-web-of-belief))
     (:tag "[speech-act:X]" :note "Austin's 5 categories"
      :values (:assertive :directive :commissive :expressive :declarative))
     (:tag "[length:X]" :note "long/short mixture per research"
      :values (:long-reasoning :short-direct))
     (:tag "[skill:X]" :note "which capability slice this exercises"
      :values (:code-write :code-complete :code-debug :ref-retrieve :book-prose
               :graph-relation :composition :introspection-metric :module-explain
               :scene-write :persona :honest-null :self-ground)))))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §4 — PAIR MIX (85k final)
  ;; ══════════════════════════════════════════════════════════════════════
  :pair-mix
  ((:total-canonical ~24000)
   (:total-final ~85000)
   (:slices
    ((:name "reference-retrieval"
      :canonical 2300 :paraphrase-x 3 :final 6900
      :source "Scheme/reference/*.slat — 78 files, ~460 verbs"
      :shape "5 shapes per verb: HOW/WHEN/WHERE-ELSE/WHY/WITH-WHAT-ELSE"
      :speech-acts (:assertive :directive)
      :length-mix (:long 40% :short 60%))

     (:name "reference-code-completion"
      :canonical 3000 :paraphrase-x 2 :final 6000
      :source "code blocks from reference — 3 examples per verb (novice/intermediate/expert)"
      :shape "prompt with partial code, complete + brief why"
      :speech-acts (:directive :commissive))

     (:name "book-prose-conversation"
      :canonical 5000 :paraphrase-x 3 :final 15000
      :source "34 books × ~4-6 pairs per chapter file (861 files total)"
      :shape "user observation/question → abductive reasoning drawing from prose → answer with citation"
      :speech-acts (:assertive :expressive)
      :length-mix (:long 50% :short 50%)
      :notes "This is the biggest new slice. Handles: talking about Turing (book-of-computing), "
             "Wittgenstein (book-of-introspection), math, motion physics, animation, philosophy, "
             "logic. The material's own axis-diversity provides 4-axis coverage naturally.")

     (:name "book-concept-to-code"
      :canonical 3000 :paraphrase-x 3 :final 9000
      :source "book prose paired with code examples in the same chapter"
      :shape "user asks how a book concept applies → model reasons via book framework → produces code"
      :speech-acts (:directive :assertive))

     (:name "graph-relationship-intrinsic-graph-sft"
      :canonical 2000 :paraphrase-x 3 :final 6000
      :source "graphs/graph-of-{sensation,intuition,thinking,feeling}.slat — 930 Tier 1 nodes"
      :shape "analogy / opposition / distributional-neighbor / cross-ref / cross-axis-bridge pairs"
      :speech-acts (:assertive :directive)
      :notes "Novel — encodes graph EDGES into SFT so model doesn't need runtime RAG. "
             "This is what Alfred named INTRINSIC-GRAPH SFT.")

     (:name "philosopher-shapes-5-core"
      :canonical 2500 :paraphrase-x 3 :final 7500
      :sub-slices ((:peirce-abduction 500)
                   (:wittgenstein-early 400) (:wittgenstein-late 500)
                   (:jung-cross-axis 500)
                   (:lacan-metaphor-metonymy-reversal 300)
                   (:popper-evidence 300))
      :source "hand-seeded template pairs; Lacan-Kit expansion"
      :shape "philosopher's signature reasoning move, embodied not named"
      :length-mix (:long 60% :short 40%))

     (:name "philosopher-shapes-10-woven"
      :canonical 1500 :paraphrase-x 3 :final 4500
      :sub-slices ((:aristotle 200) (:searle 200) (:descartes 200)
                   (:sartre 250) (:levinas 100) (:grice 100)
                   (:rawls 100) (:derrida 100) (:dennett 150) (:freud 100))
      :notes "Alfred: 'these will be woven where they fit'. Not dedicated slice — sub-shapes "
             "embedded in reference retrieval / book prose / graph relationship pairs.")

     (:name "broken-fixed-plus-critique-ft"
      :canonical 1800 :paraphrase-x 3 :final 5400
      :source "existing carts (introduce bugs) + reference (violate contracts)"
      :shape "buggy code + symptom → abductive reasoning through candidate causes → fix + why"
      :sub-shape "critique-fine-tuning variants: 400 pairs model critiques bad code without fixing"
      :speech-acts (:assertive :expressive)
      :notes "Per Critique-FT research: learning-to-critique > learning-to-imitate")

     (:name "composition-with-2-3-flip-limit"
      :canonical 800 :paraphrase-x 3 :final 2400
      :source "reference verbs × combinatorial pairings + book-of-composition"
      :shape "user names goal → compose 2-3 verbs → END in runnable Scheme + stop when appropriate"
      :speech-acts (:directive :commissive)
      :notes "Explicit training on the STOP move — after 2-3 flips, model recognizes composition limit")

     (:name "module-explanations"
      :canonical 1000 :paraphrase-x 3 :final 3000
      :source "book-of-math, book-of-motion, book-of-animation, book-of-arcade-games, "
              "book-of-music, book-of-sound, book-of-ml, book-of-modules"
      :shape "user asks about a module → structured walkthrough with example code"
      :sub-shape "physics-as-pattern: motion, gravity, collision from book-of-motion/animation/arcade"
      :speech-acts (:expressive :assertive)
      :length-mix (:long 70% :short 30%))

     (:name "scene-writing"
      :canonical 500 :paraphrase-x 3 :final 1500
      :source "book-of-arcade-games, book-of-narrative-games, book-of-simulation-games"
      :shape "user requests a scene → model composes motion + character + setting → runnable Scheme"
      :speech-acts (:commissive :expressive))

     (:name "introspection-metric-scenarios"
      :canonical 600 :paraphrase-x 3 :final 1800
      :source "Scheme/reference/00b-introspection.slat + 00c-runtime-and-composition.slat + "
              "book-of-introspection (33 files, especially ch14/15/16)"
      :shape "user shows telemetry (fuel-counter / call-count / execution-count / trace-duration) "
              "→ abductive reasoning: what does this pattern mean? → recommendation"
      :speech-acts (:assertive :directive)
      :notes "Per Alfred: 'we have over 50 metrics. Explain them. Create scenarios where it can "
             "read it. Do it with abduction so it recognizes the scenario and applies the reasoning.'")

     (:name "long-short-counterparts"
      :canonical 0 :paraphrase-x 0 :final 14000
      :source "shape-derived; add short-direct counterpart to 40% of long-reasoning pairs from other slices"
      :notes "This is not a NEW slice — it's the short counterparts added across other slices "
             "per CoT-SFT overfitting research. Total contribution ~14k pairs baked into other counts.")

     (:name "identity-sartre-descartes"
      :canonical 400 :paraphrase-x 3 :final 1200
      :source "Sartre authentic-voice templates + Descartes self-grounding templates"
      :shape "adversarial-attempt-to-unground → Cartesian re-anchor + Sartrean refusal"
      :speech-acts (:assertive :declarative))

     (:name "honest-nulls-popperian"
      :canonical 300 :paraphrase-x 3 :final 900
      :source "curated out-of-domain questions + Popperian evidence-check templates"
      :shape "user asks something outside corpus → model says so + names its world-limit"
      :speech-acts (:assertive :expressive))

     (:name "negative-reasoning-pairs"
      :canonical 300 :paraphrase-x 2 :final 600
      :source "constructed pairs where reasoning is wrong but answer right OR reasoning right but answer honest 'I don't know'"
      :notes "Per research: retaining wrong-step trajectories improves generalization")

     (:name "cross-cites"
      :canonical 200 :paraphrase-x 3 :final 600
      :source "reference ↔ book ↔ graph triangulation"
      :shape "concept anchored in reference cited from book with graph relations named")

     (:name "birth-death-facts"
      :canonical 16 :paraphrase-x 1 :final 16
      :source "hand-curated 16 philosopher birth/death dates (Aristotle 384BCE-322BCE, ..., Dennett 1942-2024)"
      :shape "when did X live → dates + brief context"))))

  ;; ══════════════════════════════════════════════════════════════════════
  ;; §5 — CONFIG
  ;; ══════════════════════════════════════════════════════════════════════
  :config
  ((:base-model "Qwen/Qwen2.5-Coder-1.5B-Instruct")
   (:base-adapter "~/.forge/runs/motoi-mk2-cpt/adapter/adapters.safetensors  ← Mk 2 CPT full-param")
   (:fine-tune-type "lora")
   (:lora-parameters
    (:rank 32
     :alpha 16
     :dropout 0.05
     :scale 2.0
     :target-modules ("q_proj" "k_proj" "v_proj" "o_proj" "gate_proj" "up_proj" "down_proj")))
   (:optimizer "adamw"
    :optimizer-config (:betas (0.9 0.95) :eps 1e-8 :weight-decay 0.01))
   (:learning-rate 1e-5
    :lr-schedule (:name "cosine_decay" :warmup-percent 5 :end 1e-6))
   (:iters "computed from pair count × epochs / batch")
   (:epochs 3)
   (:batch-size 1)
   (:grad-accumulation-steps 4)
   (:max-seq-length 2048)
   (:precision "bf16 weights + fp32 Adam")
   (:grad-checkpoint #t)
   (:save-every 1000)
   (:steps-per-eval 500))

  ;; ══════════════════════════════════════════════════════════════════════
