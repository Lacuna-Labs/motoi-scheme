(current-state
  :cpt-adapter-status "SNAPSHOTTED at _archive/pre-sft-snapshot-20260721.safetensors — safe"
  :recipe-doc-status "MK2-SFT-RECIPE-2026-07-21.ENG.slat + MK2-SFT-EXECUTION-PLAN-2026-07-21.ENG.slat authored"
