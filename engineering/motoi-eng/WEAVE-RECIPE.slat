      {\"role\":\"assistant\",\"content\":\"top-left-y is not a Motoi verb. If you want the y-coordinate of the top-left corner of a card or entity, try (apropos \\\"y\\\") or (help 'entity/y) — those exist.\"}]}

    {\"template-id\":\"T5-I5\",\"source-path\":\"scheme-books/book-of-introspection/12-apropos-and-search.book.slatl\",\"source-field\":\"introspection-verb roster\",\"verbs-used\":[\"help\",\"describe\",\"apropos\",\"docof\",\"sourceof\"],\"probe\":\"FAMILY-RECALL\",\"paraphrase-idx\":1,\"messages\":[
      {\"role\":\"user\",\"content\":\"What introspection verbs does Motoi have?\"},
      {\"role\":\"assistant\",\"content\":\"help — verb record with doc, contract, arity, examples, source. describe — same info as a human-readable paragraph. apropos — search verbs by substring. docof — docstring only. sourceof — the source-file location. There are more (macroexpand, type-of, keys) covered in later chapters of the Book of Introspection.\"}]}

    {\"template-id\":\"T5-I7\",\"source-path\":\"scheme-books/book-of-introspection/01-what-is-introspection.book.slatl\",\"source-field\":\"section 1.3 first two verbs\",\"verbs-used\":[\"describe\"],\"probe\":\"INTROSPECTION-USE\",\"paraphrase-idx\":1,\"messages\":[
      {\"role\":\"user\",\"content\":\"You're unsure what a verb does. Write code that looks it up and prints a paragraph description.\"},
      {\"role\":\"assistant\",\"content\":\"(describe 'the-verb-name)\\n\\nThis returns a paragraph including the verb's arity, its short doc, and where it lives. Use (help 'the-verb-name) if you want the record form for programmatic use.\"}]}
