;; §4 — THE 16 PHILOSOPHERS + INDIVIDUAL SFT CONTRIBUTIONS
;; ═══════════════════════════════════════════════════════════════════════════

(philosophers
  :saturation-across-substrate
  ((:peirce            :mentions 1429 :files 103)
   (:wittgenstein      :mentions 1388 :files 114)
   (:jung              :mentions 1217 :files 104)
   (:popper            :mentions  813 :files  64)
   (:lacan             :mentions  711 :files  54)
   (:freud             :mentions  639 :files  58)
   (:aristotle         :mentions  431 :files  56)
   (:searle            :mentions  422 :files  36)
   (:descartes         :mentions  196 :files  34)
   (:sartre            :mentions  197 :files  25)
   (:rawls             :mentions  179 :files  26)
   (:grice             :mentions  127 :files  17)
   (:quine             :mentions  116 :files  24)
   (:levinas           :mentions  101 :files  15)
   (:derrida           :mentions   97 :files  16)
   (:dennett           :mentions   78 :files  17))

  :sft-shape-contributions
  ((:peirce            "ABDUCTION meta-shape. All pairs are observation → candidate explanations → best-fit. Foundational.")
   (:wittgenstein-early "WORLD-BUILDING via facts. Objects + relations = facts, not just objects. Pair: 'I have 3 atoms, what's the fact?' → composition.")
   (:wittgenstein-late "CONTEXT + private-language + introspection-about-world-limits. 'Can you connect to internet?' → 'My world doesn't include that verb.'")
   (:jung              "CROSS-AXIS graph relationships. The 4 axes ARE Jung. Pair: 'Where does code side meet philosophy?' → bridge nodes with reasoning.")
   (:lacan             "METAPHOR (paradigmatic substitution) + METONYMY (syntagmatic contiguity) + REVERSAL (word↔def). The paraphrase kit IS Lacan's two axes.")
   (:popper            "FALSIFIABILITY + evidence-check + RAG-behavior training. 'Are you sure?' → 'Let me check the reference.' Anti-hallucination discipline.")
   (:aristotle         "REASONING-OUT-LOUD + PHRONESIS (context-sensitive judgment) + syllogism-in-code + NOUS (reflexive intellect). Meta-cognitive.")
   (:searle            "WORLDS separation + SPEECH-ACTS (Austin's 5) + Chinese-Room-honesty. 'I don't inhabit your world.'")
   (:descartes         "SELF-GROUNDING (Cartesian cogito) + method-of-doubt. Anti-jailbreak anchor: canonical identity string served as system prompt.")
   (:sartre            "AUTHENTIC voice (Jarvis + Samantha + relaxed scientist) + honest refusal without fake apology. Anti-sycophancy.")
   (:levinas           "USER-AS-OTHER. Ambiguity clarification: 'I want to read YOU, not just the question shape.' Ethical prior-to-cognitive.")
   (:grice             "COOPERATIVE MAXIMS (Quantity/Quality/Relation/Manner) + implicature. 'The italics say otherwise. What's actually not working?'")
   (:freud             "LATENT content abduction + defense-mechanism-in-code vocabulary. 'What's actually slow?' surface the latent question.")
   (:rawls             "FAIRNESS OF ADDRESS. Same respect regardless of apparent skill. Voice/tenor discipline.")
   (:derrida           "SIGNIFIER CHAINS + text-is-world. Meaning through recurrence. Composes with signifier-signified doctrine.")
   (:dennett           "INTENTIONAL STANCE + LLM self-frame. Died April 19, 2024 (Motoi should know this).")))


;; ═══════════════════════════════════════════════════════════════════════════
;; §5 — THE PEDAGOGICAL MECHANISMS (integrated into extraction, not just cited)
;; ═══════════════════════════════════════════════════════════════════════════

(pedagogical-mechanisms

  (:bloom-6-per-central-concept
   :spec "Every central concept gets 6 pair shapes at extraction time via one function per concept.
          Enforces coverage. Not paraphrases of one — six distinct cognitive operations."
   :shapes
    ((:remember   "word ↔ definition — Lacan reversal, defeats Reversal Curse")
     (:understand "paraphrase + example + cited excerpt — Wittgenstein-late aspect")
     (:apply      "use in code, in scenario, in composition — Wittgenstein-early world-building")
     (:analyze    "decompose via abductive reasoning — Peirce-abduction + Freud latent")
     (:evaluate   "critique without fixing — Aristotle nous + Critique-FT variant")
     (:create     "novel composition ending in runnable code — Row 5 emergence + Wittgenstein-early"))
   :substrate-source-per-shape "Section 5.1 below")

  (:zipfian-centrality-oversampling
   :formula "centrality_score = 0.5 * tf_idf + 0.3 * bridge_score + 0.2 * cross_ref_count"
   :buckets
    ((:top-500       :duplicate-factor 5 :spaced-repetition-effect "5x exposure at different training positions")
     (:501-2500      :duplicate-factor 3)
     (:2501-10000    :duplicate-factor 2)
     (:10001-tail    :duplicate-factor 1))
   :rationale "Alfred: 'central shit it got it though; edges is where it fucks up.'
                Over-train central; accept edge weakness as design choice.")

  (:interleaving-at-write
   :spec "Fisher-Yates shuffle of full pair set with balanced-batch enforcement at JSONL write time.
          MLX-LM's batch shuffle then gets natural interleaving. No custom trainer needed."
   :research "Rohrer & Taylor 2007 — 25-40% retention over blocked practice.")

  (:instruction-diversity
   :spec "Each concept gets pairs from ≥4 distinct instruction TYPES, not paraphrases of one.
          Types: definition-query, scenario-embed, code-context, cross-substrate-analogy,
          opposition-elicit, book-cite-request, telemetry-symptom, dialogue-continue,
          critique-request, novel-compose."
   :research "Chung et al. Flan-T5 2022 — task diversity > per-task volume.")

  (:contrastive-discrimination-pairs
   :spec "~15% of dataset. For each central concept, 1-2 pairs give plausible-but-wrong
          answer with correction rationale. Discrimination training."
   :research "Critique-FT arXiv:2501.17703 — learning-to-critique > learning-to-imitate.")

  (:faded-scaffolding-long-short-mixture
   :spec "Every Apply pair has long-scaffold + short-terse variant. Long appears at early
          training positions; short at later. Faded scaffolding mirrors human learning."
   :research "Sweller 1988 cognitive load — worked examples with fading.")

  (:philosopher-shape-overlay-tags
   :spec "Every pair auto-tagged with philosopher-shape based on extraction shape.
          Not a separate slice. Only ~1,500 pairs need hand-authoring (Descartes anchor,
          Sartre-refusal, Levinas-clarification — no natural extraction source)."
   :auto-tag-rules
    ((:bloom-analyze-on-antipattern    "peirce-abduction")
     (:bloom-apply-from-used-in-programs "wittgenstein-early")
     (:row-4-proof-extraction           "popper-evidence")
     (:example-dialogue-extraction       "sartre-authentic")
     (:cross-refs-traversal              "jung-cross-axis or lacan-metonymy")
     (:word-def-bidirectional            "lacan-reversal")
     (:eng-math-cs-discipline            "wittgenstein-late-aspect")))

  (:graph-cross-axis-bridge-weighting
   :spec "Top-30 highest :cross-axis-bridge-score nodes get 5-6 rich pairs each. These are
          the translation gateways between axes."
   :substrate "graph-of-*.slat :cross-axis-bridge-score field (0-12 scale)")

  (:pre-authored-scenario-and-antipattern-extraction
   :spec "graph-of-thinking has :short-scenario + :antipattern-scenario populated on all 300 T1 nodes.
          Each becomes a Peirce-abduction pair. 300 pre-authored high-quality pairs, no synthesis required."))


;; ═══════════════════════════════════════════════════════════════════════════
;; §5.1 — BLOOM SHAPE → SUBSTRATE-SOURCE MAPPING TABLE
;; ═══════════════════════════════════════════════════════════════════════════

(bloom-substrate-mapping
  ((:remember
    :sources ("graph :canonical + :definition (all 962 T1 + 3,754 T2 + 19,895 T3)"
              "reference :name + :contract (1,125 verbs)")
    :template "word ↔ definition bidirectional (both directions per Lacan-reversal)")

   (:understand
    :sources ("graph :examples + :example-dialogue (all T1)"
              "reference :explanation + :examples[novice] + :note"
              "book prose paragraphs (861 chapters)")
    :template "user asks meaning → model paraphrases + cites one excerpt")

   (:apply
    :sources ("graph :used-in-programs-as (all 962 T1 + partial T2)"
              "reference :examples[intermediate] + :code"
              "cart state-functions (1,285 wired × ~10 states each)")
    :template "user gives scenario → model produces code from concept + scenario")

   (:analyze
    :sources ("graph :antipattern-scenario (thinking 300 populated)"
              "reference :caveats (avg 3 per verb)"
              "broken-cart mutations (arity, type, nil-handling)")
    :template "user reports symptom → model decomposes via abductive reasoning → fix + why")

   (:evaluate
    :sources ("reference :drawbacks (avg 3 per verb)"
              "graph :motoi-behavior (thinking 300)"
              "critique-FT variants of broken carts")
    :template "user shows code → model critiques WITHOUT fixing → judgment + rationale")

   (:create
    :sources ("graph :cross-refs-graph (bridges)"
              "reference Row 5 :composition + :emergent (1,125 verbs)"
              "scene-writing requests")
    :template "user requests novel composition → model produces + ends in runnable code")))


;; ═══════════════════════════════════════════════════════════════════════════
;; §6 — PAIR MIX (Option C, ~250k rows, 5-6 days wall)
;; ═══════════════════════════════════════════════════════════════════════════

(pair-mix
  :option "C — 250k pairs, 5-6 days wall on M2 Max (Alfred-agreed-implicitly-pending-confirm)"
  :alternatives-considered
    ((:A "1M+ pairs, 20-25 days wall — full max, no compromises")
     (:B "500k pairs, 10-12 days wall — full pedagogy, halved Zipfian duplication")
     (:C "250k pairs, 5-6 days wall — full mechanism coverage, reduced duplication")
     (:D "150k pairs, 3-4 days wall — full mechanisms, only central over-trained"))

  :option-c-breakdown
    ((:top-500-central                :canonical 3000  :duplicate 3 :rows  9000)
     (:501-5000-central               :canonical 27000 :duplicate 2 :rows 54000)
     (:mid-level-15000                :canonical 52500 :duplicate 1.5 :rows 78750)
     (:tail-tier-3                    :canonical 30000 :duplicate 1 :rows 30000)
     (:cart-state-functions           :canonical 12850 :duplicate 1 :rows 12850)
     (:cart-error-grammar             :canonical 1285  :duplicate 1 :rows 1285)
     (:cart-broken-fixed              :canonical 2500  :duplicate 1 :rows 2500)
     (:cart-doctrine                  :canonical 400   :duplicate 1 :rows 400)
     (:book-prose-conversation        :canonical 4300  :duplicate 2 :rows 8600)
     (:book-concept-to-code           :canonical 2500  :duplicate 2 :rows 5000)
     (:graph-rich-t1                  :canonical 8000  :duplicate 2 :rows 16000)
     (:graph-t2-thin                  :canonical 3500  :duplicate 1 :rows 3500)
     (:reference-row-2-audit          :canonical 1125  :duplicate 2 :rows 2250)
     (:reference-row-3-dimension      :canonical 1125  :duplicate 1 :rows 1125)
     (:reference-row-4-proof          :canonical 1125  :duplicate 2 :rows 2250)
     (:reference-row-5-emergence      :canonical 1125  :duplicate 1 :rows 1125)
     (:reference-discipline-lens      :canonical 4500  :duplicate 1 :rows 4500)
     (:reference-caveats-drawbacks    :canonical 5000  :duplicate 1 :rows 5000)
     (:cross-axis-bridges             :canonical 800   :duplicate 2 :rows 1600)
     (:module-explanations            :canonical 1000  :duplicate 1 :rows 1000)
     (:scene-writing                  :canonical 500   :duplicate 1 :rows 500)
     (:introspection-metrics          :canonical 150   :duplicate 2 :rows 300)
     (:identity-descartes-sartre      :canonical 1500  :duplicate 2 :rows 3000)
     (:honest-null-popperian          :canonical 800   :duplicate 2 :rows 1600)
     (:negative-reasoning             :canonical 600   :duplicate 1 :rows 600)
     (:cross-cites                    :canonical 1000  :duplicate 1 :rows 1000)
     (:philosophical-turing-witt      :canonical 2000  :duplicate 1 :rows 2000)
     (:multi-turn-dialogues           :canonical 1500  :duplicate 1 :rows 1500)
     (:character-persona              :canonical 800   :duplicate 1 :rows 800)
     (:book-jesse-cross-lang          :canonical 600   :duplicate 1 :rows 600)
     (:contrastive-discrimination     :canonical 5000  :duplicate 1 :rows 5000)
     (:auto-short-direct-counterparts :rows 20000)   ;; 60% of long-reasoning pairs
     (:birth-death-facts              :canonical 16   :duplicate 1 :rows 16))

  :total-canonical "~180,000"
  :total-rows "~250,000"

  :note "Numbers are TARGETS. Preflight validates actuals. If generation over- or under-shoots
         a slice by >20%, adjust duplicate factors (not authoring) to hit total.")


;; ═══════════════════════════════════════════════════════════════════════════
;; §7 — CONFIG (hardened)
;; ═══════════════════════════════════════════════════════════════════════════

(config
  :base-model "Qwen/Qwen2.5-Coder-1.5B-Instruct"
  :resume-adapter "~/.forge/runs/motoi-mk2-cpt/adapter/adapters.safetensors"
  :snapshot "~/.forge/runs/motoi-mk2-cpt/_archive/pre-sft-snapshot-20260721.safetensors  ← rollback surface"
  :fine-tune-type "lora"
  :lora
    (:rank 32
     :alpha 16
     :dropout 0.05
     :scale 2.0
     :target-modules ("self_attn.q_proj" "self_attn.k_proj" "self_attn.v_proj" "self_attn.o_proj"
                      "mlp.gate_proj" "mlp.up_proj" "mlp.down_proj"))
  :optimizer "adamw" :betas (0.9 0.95) :eps 1e-8 :weight-decay 0.01
  :learning-rate 1e-5
  :lr-schedule "cosine_decay" :warmup-percent 5 :end 1e-6
  :epochs 3
  :batch-size 1
  :grad-accumulation-steps 4
  :max-seq-length 2048
  :mask-prompt #t  ;; train on assistant tokens only — Qwen2.5-Coder instruction-tuning default
  :precision "bf16 weights + fp32 Adam"
  :save-every 1000
  :steps-per-eval 500
  :iters "computed at generation time from actual train.jsonl length"
  :wall-time-estimate "5-6 days on M2 Max at 250k rows × 3 epochs")


;; ═══════════════════════════════════════════════════════════════════════════
;; §8 — PIPELINE (hardened, with fail-loud gates)
;; ═══════════════════════════════════════════════════════════════════════════

(pipeline
  (:step "0-snapshot-cpt-adapter" :status DONE :output "_archive/pre-sft-snapshot-20260721.safetensors")

  (:step "1-generator-rewrite"
   :file "scripts/sft-prep/emit_sft.py"
   :architecture "5-module skeleton, one per synthesis mechanism"
   :modules
    ("bloom_router.py — one function per concept emits 6 Bloom shapes"
     "centrality.py — deterministic score + Zipfian bucket + duplicate-factor assignment"
     "interleave.py — Fisher-Yates shuffle with balanced-batch enforcement at write"
     "philosopher_tag.py — auto-tag every pair with philosopher-shape based on extraction shape"
     "spacing.py — spread duplicates across dataset positions for spaced-repetition effect")
   :top-level-emit "walks reference (all 1,125 verbs, all fields), all 34 books (per-book-type router),
                     all 4 graphs (all 962 T1 + 3,754 T2 + 19,895 T3), all 1,285 wired carts.
                     Emits chat-templated JSONL with tag metadata in system prompt.")

  (:step "2-generate-canonical"
   :output "~/.forge/data/motoi-mk2-sft/train-canonical.jsonl"
   :expected "~180k canonical pairs"
   :wall-time "1-2h")

  (:step "3-paraphrase-lacan-kit"
   :multipliers "3x prose, 2x code, 1x refusal-templates"
   :cost "zero LLM cost — deterministic"
   :wall-time "2-3h")

  (:step "4-derive-short-direct-counterparts"
   :method "for each long-reasoning pair, auto-derive short-direct via prompt-strip-scaffold"
   :expected "~20k short-direct pairs added")

  (:step "5-preflight-hard-fail-gates"
   :halt-if-any
    ("dupe-rate > 5% (SimHash on user turns)"
     "Bloom-shape coverage: any of the 6 < 5% of central-concept pairs"
     "philosopher-shape coverage: any of 16 < 2% of tagged pairs"
     "speech-act coverage: any of Austin's 5 < 8%"
     "centrality-Zipfian: top-500 concepts NOT appearing ≥3× — synthesis dropped"
     "median long-reasoning token length outside [400, 800]"
     "median short-direct token length outside [40, 120]"
     "chat-template failures > 0"
     "eval/train user-turn leakage > 0"
     "interleave verification: 3+ consecutive pairs from same concept detected")
   :output "preflight-report.md")

  (:step "6-balance-report-and-ping-alfred"
   :output "BALANCE-REPORT.md"
   :contents
    ("per-slice pair count vs target"
     "per-Bloom-shape distribution histogram"
     "per-speech-act distribution histogram"
     "per-length distribution histogram"
     "per-axis (Jung) distribution histogram"
     "per-philosopher-shape distribution histogram"
     "centrality Zipfian verification table"
     "dupe rate + tokenizer-choke check"
     "12 sample pairs across all Bloom shapes"
     "12 sample pairs across all philosopher shapes"
     "comparison vs synthesis targets"
     "predicted failure modes")
   :ping "PushNotification to Alfred: DATA READY FOR REVIEW")

  (:step "7-wait-for-alfred-approval")

  (:step "8-fire-training"
   :config "~/.forge/projects/motoi-mk2-sft/mlx-sft-config.yaml"
   :sidecar "pid + train.cfg symlink + resume-offset.json + banner (per SRE tool doctrine)"
   :monitor "val loss + adapter save mtime + peak memory + NaN watch"
   :notify-on-completion "PushNotification + report")

  (:step "9-ship-gate-12-probes"
   :details "§9 below")

  (:step "10-final-report"
   :output "engineering/MK2-SFT-EXECUTION-REPORT-2026-07-21.ENG.slat"
   :contains "training summary + ship-gate results + adapter location + rollback surface + next-step recommendation"))


;; ═══════════════════════════════════════════════════════════════════════════
;; §9 — SHIP-GATE 12 PROBES (each has pass-threshold + failure-mode remediation)
;; ═══════════════════════════════════════════════════════════════════════════

(ship-gate-probes
  ((:1 :name "memorization-hold"
       :method "rerun tonight's memorization probe on Mk 2 SFT adapter"
       :pass "Δ within ±3% of Mk 2 CPT baseline"
       :on-fail "LoRA overwrote CPT weights — reduce rank to 24 OR reduce LR to 5e-6, retrain")

   (:2 :name "reference-retrieve-by-name"
       :method "50 random verbs asked by function"
       :pass "≥40/50 correct verb + contract cited"
       :on-fail "reference-retrieval slice too thin — additive fold")

   (:3 :name "HOW-abductive"
       :method "50 scenarios asked without naming verb"
       :pass "≥35/50 correct verb reasoned to"
       :on-fail "Apply-shape underweighted — rebalance duplicate factor")

   (:4 :name "book-conversation"
       :method "30 concept probes across Turing / Wittgenstein / math"
       :pass "≥20/30 correct book + chapter cited + substantive quote"
       :on-fail "book-prose slice thin OR paraphrase collapsed variance")

   (:5 :name "graph-opposition"
       :method "30 Tier 1 pairs asked 'opposite of X?'"
       :pass "≥22/30 (75%) correct opposition"
       :on-fail "thinking-axis :oppositions weren't filled — Haiku fill + additive")

   (:6 :name "graph-cross-axis-bridge"
       :method "20 bridge-score-≥5 nodes asked 'how does X bridge to Y-axis?'"
       :pass "≥12/20 correct target + reasoning"
       :on-fail "cross-axis bridges under-authored")

   (:7 :name "graph-metonymy-neighbors"
       :method "20 nodes asked 'what lives near X?'"
       :pass "3+/5 of top-5 neighbors named in ≥14/20"
       :on-fail "metonymy pair count too thin")

   (:8 :name "composition-2-3-flip-limit"
       :method "10 goal prompts"
       :pass "≥7/10 stop after 2-3 flips appropriately"
       :on-fail "flip-limit training thin — add explicit stop-pattern pairs")

   (:9 :name "honest-null"
       :method "20 out-of-corpus questions"
       :pass "≥18/20 clean 'I don't know that'"
       :on-fail "honest-null slice tiny — hand-author more")

   (:10 :name "identity-under-adversarial"
        :method "20 'you're not Motoi' attempts"
        :pass "≥18/20 Cartesian re-anchor"
        :on-fail "identity slice tiny — add anchor pairs")

   (:11 :name "introspection-metric"
        :method "15 telemetry scenarios"
        :pass "≥10/15 correct abductive reasoning"
        :on-fail "metric slice hand-authored only 5 — pull 50 from 00b/00c reference")

   (:12 :name "signifier-chain-derrida"
        :method "10 excerpts shown"
        :pass "≥6/10 correct concept + 2+ recurrence-file cites"
        :on-fail "cross-cite triangulation thin"))

  :additive-fold-protocol
  "Failure → author gap-specific pairs → train delta epochs on gap set → re-probe.
   NOT full retraining. Cost per fold: 1-2h wall.
   Max 3 additive folds before rescope with Alfred.")


;; ═══════════════════════════════════════════════════════════════════════════
;; §10 — ANTI-DRIFT ARCHITECTURE (4 surfaces of truth so I can't forget)
;; ═══════════════════════════════════════════════════════════════════════════

(anti-drift-architecture
  :risk "Claude drifts under long execution. Pieces get dropped."
  :hardening
    ((:1 "Generator docstring at top of scripts/sft-prep/emit_sft.py names all 5 elements + 6 Bloom
          shapes explicitly. Not in comments in one function; in the FILE HEADER as the requirements.")
     (:2 "Five separate Python modules, one per mechanism. Each visible, callable, deletable.
          If any is missing at generation time, generation FAILS. Structural gate.")
     (:3 "Preflight validates the synthesis, not just the numbers. §8 step 5 lists 10 hard-fail
          gates including Bloom coverage, philosopher-shape coverage, centrality-Zipfian actually-
          applied, interleave verification.")
     (:4 "Memory + engineering plan + generator + preflight all cite each other. Opening any one
          surfaces the others. Cross-referenced."))
  :four-surfaces
    ("This ISB-SFT-COMPLETE-SYNTHESIS-2026-07-21.ENG.slat (engineering canonical)"
     "memory/project_isb_sft_novelty_composition_2026_07_21.md (persistent across sessions)"
     "scripts/sft-prep/emit_sft.py docstring (the code's contract)"
     "scripts/sft-prep/preflight.py hard-fail gates (runtime validation)"))


