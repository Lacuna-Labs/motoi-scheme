;;; MANIFEST.slat — motoi-scheme/graphs/ collection manifest.
;;; The four Jung-axis knowledge graphs Motoi draws on. Supersedes the
;;; 2026-07-16 world-graph import manifest (graph-of-science, relocated from
;;; curator/objects/) after the four-axis consolidation of 2026-07-20.

(dialect :applies ("motoi"))

(manifest
  :collection        "motoi-scheme/graphs"
  :title             "Motoi Four-Axis Graphs"
  :subtitle          "The Jungian noun-world Motoi's CPT substrate is grounded in"
  :version           "2.0.0"
  :created           "2026-07-21"
  :updated           "2026-08-10"
  :supersedes        "1.0.0 (graph-of-science world import, 2026-07-16)"
  :owner             "Alfred"
  :authored-by       "motoi corpus lane"
  :dialect           "motoi"
  :audience          (:engineer :any)
  :content-rating    :G
  :training-eligible #t
  :confidentiality   :public

  :parent-collection "/Users/alfred/code/motoi-scheme/"

  ;; The consolidation decision. One graph per Jung axis — not ten graph types.
  ;; Every earlier world/science/words graph either folds into an axis graph or
  ;; is archived. Doctrine: SRE-MANUAL/chapters/05 § four-axis + three-tier.
  :architecture
  "Four SLAT graphs, one per Jungian function. Each is a line-delimited record
   file. Nodes are partitioned into three tiers: Tier 1 (TF-IDF top ~300 per
   axis, doc-freq >= 5) carry the full facet schema plus REQUIRED short-scenario
   and antipattern-scenario per the Derrida signifier/signified doctrine; Tier 2
   (rank ~301-800) carry a lightweight definition + relations + statistical
   metadata; Tier 3 carry a script-stub with inferred definition. CPT reads all
   three tiers; the tier governs how much signified each signifier gets."

  :contents
  ((:graph "graph-of-sensation"
    :file            "graph-of-sensation.slat"
    :axis            "Sensation"
    :covers          "Concrete, perceptible things — the world as directly sensed."
    :node-count      17203
    :size-mb         12
    :enrichment      "Enriched via corpus-semantics miner. Residual gaps: a small
                      set of entropy-0 / bridge-0 Tier-1 nodes and pending markers.")
   (:graph "graph-of-intuition"
    :file            "graph-of-intuition.slat"
    :axis            "Intuition"
    :covers          "Abstract categories and patterns — the world as inferred."
    :node-count      6245
    :size-mb         7
    :enrichment      "Fully enriched. Oppositions use honest-null where the corpus
                      offers no genuine opposite (correct, not a gap).")
   (:graph "graph-of-thinking"
    :file            "graph-of-thinking.slat"
    :axis            "Thinking"
    :covers          "Judgment-principle nouns — invariant, contract, proof,
                      honesty, safety, boundary, refusal. The words that carry
                      axis identity for THINKING."
    :node-count      1100
    :size-mb         2
    :enrichment      "Enriched. Tier-1 cross-axis-bridge-score / context-entropy /
                      idf were back-written 2026-07-26 from the computed
                      tier1-enrichment.json (Step 6b), matching the other axes. A
                      computed bridge-score of 0 is legitimate (all top associations
                      stay in-axis); 3 nodes not in the ppmi Tier-1 set stay
                      honest-0, not fabricated.")
   (:graph "graph-of-feeling"
    :file            "graph-of-feeling.slat"
    :axis            "Feeling"
    :covers          "Tonal / evaluative registers — the world as valued."
    :node-count      675
    :size-mb         1
    :enrichment      "Thin by design — the Feeling axis is deliberately the
                      smallest; register-nouns are few and high-signal."))

  :node-count-total  25223

  :provenance
  "Graphs generated 2026-07-21 from per-axis TF-IDF seed lists; enrichment fields
   (appears-in-corpus, cross-axis-bridge-score, context-entropy, distributional
   neighbors, PPMI associations) computed by
   scripts/corpus-semantics-miner/mine_corpus_semantics.py against the Motoi
   corpus. Derivation logs (2026-07-22) record the per-axis build. No enrichment
   number is hand-authored: empty corpus signal yields honest-null, never a
   fabricated fill (see reset_fabricated_fills.py)."

  :no-deletes-doctrine
  "All graph edits are additive or enrichment-in-place. Never delete a node; a
   superseded node is archived, not removed. Never demote a real fill to
   honest-null, never double-null, never fabricate a computed statistic.")
