;;;
;;; File format: SLAT line-delimited; each node opens with '(node ' at column 0.

(dialect :applies ("motoi"))

(header
  :collection "graph-of-sensation"
  :version "1.0.0"
  :created "2026-07-21"
  :axis "sensation"
  :tier-1-count 300
  :tier-2-count 500
  :tier-3-count 16404
  :selection-rules
  ((:tier "1" :rule "TF-IDF top-300 per axis, doc-freq >= 5")
   (:tier "2" :rule "TF-IDF rank 301-800 within Sensation")
   (:tier "3" :rule "all remaining Sensation content-words, excluding function-words")))

