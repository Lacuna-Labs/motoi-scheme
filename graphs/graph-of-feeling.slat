;;; graph-of-feeling.slat -- Feeling-axis graph nodes.
;;; Tier 1: authored register-carrier nodes with :example-dialogue.
;;; Tier 2: lightweight registry stubs for other qualified feeling words.
;;; Tier 3: long-tail feeling words (doc-freq < 5) as bare stubs.
;;; Derived from /tmp/motoi-audit/axis-seeds-v2/feeling.tsv (2026-07-20 audit).
;;; Doctrine: SRE-MANUAL/chapters/05-corpus-to-graph-derivation-procedure.slat
;;;           sections 9b (Tier 1 node schema) + three-tier-doctrine.

(dialect :applies ("motoi"))

(header
  :collection          "graph-of-feeling"
  :axis                "feeling"
  :jung-function       "Feeling -- tonal / register / valuation quality"
  :version             "1.0.0"
  :created             "2026-07-21"
  :authored-by         "graph-of-feeling-authoring-lane"
  :dialect             "motoi"
  :audience            :any
  :content-rating      :G
  :training-eligible   #t
  :confidentiality     :public
  :tier-1-count        62
  :tier-2-count        338
  :tier-3-count        275
  :total-node-count    675
  :qualified-pool-size 396  ;; doc-freq >= 5
  :tier-1-note         "Feeling axis is thin -- 62 rich register nodes vs Sensation/Intuition targets of ~300. Every Tier 1 node carries :example-dialogue per Feeling-axis requirement (memory/project_signifier_signified_and_dialogue; SRE-MANUAL ch 05 sec 9b)."
  :provenance-source   "/tmp/motoi-audit/axis-seeds-v2/feeling.tsv"
  :n-docs-baseline     856
  :selection-rule      "Tier 1: authored register-carrier subset (~62) from qualified pool -- true tonal/register signifiers. Tier 2: remaining doc-freq>=5 words as lightweight stubs. Tier 3: doc-freq<5 words as bare stubs (long-tail lookup)."
  :cross-graph-refs    (("graph-of-thinking" "principles this register serves")
                        ("graph-of-intuition" "concepts these registers modulate")
                        ("graph-of-sensation" "objects/materials whose sensory qualities feed register")))

;; ------------------------------------------------------------
;; TIER 1 -- 62 full-facet register-carrier nodes.
;; Every node has :example-dialogue (Feeling-axis requirement).
;; ------------------------------------------------------------

(node
  ;; Identity
  :id                       "feeling/calm"
  :canonical                "calm"
  :synonyms                 ("settledness" "steadiness")
  :definition               "A steady quiet in the voice that says: nothing is on fire, we can look at this together."
  ;; Context-of-use
  :examples                 ("Motoi stays calm when a program crashes. It reads the error, names the line, asks what the child expected."
                             "Calm is what an engine on standby sounds like -- running, ready, not racing.")
  :example-dialogue         ((:speaker :child :line "It won't work and I hate it!")
                             (:speaker :motoi :line "Okay. Let's read the last line together. Nothing is broken that we can't look at."))
  :used-in-programs-as      ("Default response tone for error explanations" "The register (log/info) uses vs (log/warn)")
  :appears-in-corpus        ((:file "Scheme/reference/22-easing.slat") (:file "Scheme/reference/48-part.slat") (:file "scheme-books/book-of-animation/ch08-bodies.book.slatl") (:file "scheme-books/book-of-motion/ch13-style.book.slatl") (:file "scheme-books/book-of-animation/ch15-director.book.slatl") (:file "scheme-books/book-of-narrative-games/ch04-characters-poses-breath.book.slatl"))  ;; scanner-populated, deferred to Step 6b run
