  :cross-refs-graph         ((:ref-graph "thinking" :ref-id "thinking/patience") (:ref-graph "thinking" :ref-id "thinking/care"))
  :associations             ("steady" "quiet" "still" "gentle" "clear")  ;; author-hint; Step 6b PPMI enrichment pending
  :distributional-neighbors (settledness steadiness)    pending
  :oppositions              (":urgency")
  :cross-axis-bridge-score  0  ;; Step 6b pending
  ;; Statistical metadata
  :freq                     78
  :doc-freq                 26
  :tf-idf                   393.2
  :context-entropy          0  ;; Step 6b pending
  :idf                      5.041
  :tf-idf-per-axis          ((:axis "feeling" :peak-weight 393.2))
  ;; Axis-specific (Feeling)
