;;; graph-of-thinking.slat — line-delimited Thinking-axis node records.
;;; The Thinking axis of the Motoi four-axis Jung graph.
;;; Judgment-principle nouns: invariant, contract, proof, honesty, safety,
;;; boundary, refusal — the words that carry axis identity for THINKING.
;;;
;;; Generated 2026-07-21 by /tmp/motoi-audit/build-graph-of-thinking.py
;;; from /tmp/motoi-audit/axis-seeds-v2/thinking.tsv.
;;;
;;; Doctrine: SRE-MANUAL/chapters/05-corpus-to-graph-derivation-procedure.slat
;;;   § section-9b-tier-1-node-schema
;;;   § section-three-tier-doctrine
;;;
;;; Three-tier partition per Alfred 2026-07-21:
;;;   Tier 1 — TF-IDF top-300 per axis, doc-freq >= 5 (rich, all 5 categories
;;;            plus Thinking-axis facets including REQUIRED :short-scenario
;;;            and :antipattern-scenario per Derrida signifier/signified
;;;            doctrine — a principle-noun without a story has no signified).
;;;   Tier 2 — TF-IDF rank 301-800 (lightweight :definition + :context-of-use
;;;            + :relations + statistical metadata; no rich scenarios).
;;;   Tier 3 — everything else (script-stub with :definition inferred from
;;;            corpus context + :appears-in-corpus + :surrounding-words).
;;;
;;; NOTE ON POOL SIZE: Thinking is a smaller axis. Seed pool = 1100 words.
;;; Tier 1 taken from top-300 (all doc-freq >= 5). Tier 2 = 500. Tier 3 = tail.

(dialect :applies ("motoi"))

(header
  :collection        "graph-of-thinking"
  :axis              "thinking"
  :version           "1.0.0"
  :created           "2026-07-21"
  :owner             "Alfred"
  :authored-by       "graph-of-thinking-derivation-lane"
  :dialect           "motoi"
  :audience          (:child :adult :any :operator)
  :content-rating    :G
  :training-eligible #t
  :confidentiality   :public
  :format            "SLAT line-delimited; each record opens with '(node ' at column 0"
  :seed-source       "/tmp/motoi-audit/axis-seeds-v2/thinking.tsv"
  :docfreq-source    "/tmp/motoi-audit/axis-seeds-v2/_docfreq.tsv"
  :evidence-source   "/tmp/motoi-audit/evidence.tsv"
  :doctrine
  ((:ref-file "SRE-MANUAL/chapters/05-corpus-to-graph-derivation-procedure.slat"
    :ref-section ":section-9b-tier-1-node-schema")
   (:ref-file "SRE-MANUAL/chapters/05-corpus-to-graph-derivation-procedure.slat"
    :ref-section ":section-three-tier-doctrine"))
  :tier-partition
  ((:tier "1" :selection "seed rank 1..300, doc-freq >= 5, per-axis")
   (:tier "2" :selection "seed rank 301..800 (or up to pool end)")
   (:tier "3" :selection "seed rank 801..end, script-stub only"))
  :required-thinking-facets
  ("principle-kind" "short-scenario" "antipattern-scenario"
   "related-verbs" "motoi-behavior" "related-books")
  :license-notice
  "All node records CC0. Corpus-derived facts point at author-controlled
   corpus files; excerpts are quoted for evidence only.")


;;; ═══ TIER 1 — 300 rich nodes ═══

(node
  :id                    "thinking/exact"
  :canonical             "exact"
  :axis                  "thinking"
  :synonyms              ()
  :definition            "Free of rounding. When exactness matters, a value is what it says it is, not almost-that."
  :examples              ("In Motoi, exact appears as a load-bearing Thinking-axis signifier — a principle the code invokes rather than a fact the code stores."
                          "A student asks: what does exact mean here? Motoi answers by showing where the principle is at play in real Scheme code, not by defining it in the abstract."
                          "The word exact earns its place in the graph by recurring across 183 distinct corpus files — recurrence, not lexicon, is the source of truth.")
  :example-dialogue      ((:speaker :child :line "Where does exact show up in real code?")
                          (:speaker :motoi :line "Look at the assert/check-with verb in Scheme/reference/06-assert.slat — the principle of exact lives in its contract."))
  :used-in-programs-as   ("A field on a verb entry — e.g. :contract, :precondition, :invariant."
                          "An assertion inside a function body that raises when exact is violated."
                          "A test that must pass for every legal input.")
  :appears-in-corpus     ((:file "16-composing-games.book.slatl" :excerpt "See book-of-arcade-games appendix-L for six worked micro-games that follow this exact multi-constraint pattern, and book-of-scheme appendix-D for the 'move-until-condition' pattern"))
  :cross-refs-books      ((:book "book-of-scheme-one" :chapter "13-invariants-and-proof") (:book "book-of-composition" :chapter "05-contracts") (:book "book-of-introspection" :chapter "16-safe-introspection"))
  :cross-refs-graph      ((:ref-graph "thinking" :ref-id "thinking/invariant")
                          (:ref-graph "thinking" :ref-id "thinking/proof")
                          (:ref-graph "intuition" :ref-id "intuition/property"))
  :associations          ("accept" "accepts" "adaptive" "adjacent" "advance")
  :distributional-neighbors ("accept" "accepts" "adaptive" "adjacent" "advance")
  :oppositions           ("approximate")
  :cross-axis-bridge-score 0
  :freq                  2608
  :doc-freq              183
  :tf-idf                10.432
  :context-entropy       8.424
  :idf                   1.571
  :tf-idf-per-axis       ((:axis "thinking" :peak-weight 10.432))
  :principle-kind        :correctness
  :short-scenario        "A child writes a program that reverses a list. Motoi asks: 'What always stays true about exact, no matter what list you give it?' The child sees the answer, writes it as a test, and the test passes. Now the exact is the promise the code keeps."
  :antipattern-scenario  "The child changes the code and forgets to re-run the exact check. Later, a friend gets a wrong answer. Motoi points at the missing check: 'The property was true yesterday and it isn't true today. Find the difference.'"
  :related-verbs         ((:ref-file "Scheme/reference/06-assert.slat" :ref-verb "assert/check-with") (:ref-file "Scheme/reference/06-assert.slat" :ref-verb "assert/invariant") (:ref-file "Scheme/reference/52-predicate.slat" :ref-verb "predicate/of") (:ref-file "Scheme/reference/16-compare.slat" :ref-verb "compare/equal?"))
  :motoi-behavior        "Motoi runs the check inline. If the property fails, Motoi refuses to hand-wave and stops execution with a clear message pointing at the broken invariant."
  :related-books         ((:book "book-of-scheme-one" :chapter "13-invariants-and-proof") (:book "book-of-composition" :chapter "05-contracts") (:book "book-of-introspection" :chapter "16-safe-introspection"))
  :provenance            ((:source "corpus-derived" :lane "graph-of-thinking-tier1-2026-07-21" :date "2026-07-21"))
  :tier                  "1"
  :kid-friendly          #t
  :training-eligible     #t
  :dialect               "motoi"
  :audience              :any
  :content-rating        :G
  :confidentiality       :public)

