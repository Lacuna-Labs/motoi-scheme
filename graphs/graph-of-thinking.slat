(node
  :id                    "thinking/safety"
  :canonical             "safety"
  :axis                  "thinking"
  :synonyms              ()
  :definition            "A Thinking-axis principle in Motoi: safety — a rule or judgment the code invokes to stay correct, safe, honest, or bounded."
  :examples              ("In Motoi, safety appears as a load-bearing Thinking-axis signifier — a principle the code invokes rather than a fact the code stores."
                          "A student asks: what does safety mean here? Motoi answers by showing where the principle is at play in real Scheme code, not by defining it in the abstract."
                          "The word safety earns its place in the graph by recurring across 89 distinct corpus files — recurrence, not lexicon, is the source of truth.")
  :example-dialogue      ((:speaker :child :line "Where does safety show up in real code?")
                          (:speaker :motoi :line "Look at the assert/check-with verb in Scheme/reference/06-assert.slat — the principle of safety lives in its contract."))
  :used-in-programs-as   ("A field on a verb entry — e.g. :contract, :precondition, :invariant."
                          "An assertion inside a function body that raises when safety is violated."
                          "A test that must pass for every legal input.")
  :appears-in-corpus     ((:file "appendix-h-http-security-guide.book.slatl" :excerpt "The compose vs. play separation, the local-only default, the path-safety layers, and the GET-only restriction are load-bearing. Do not weaken them casually. If you must run a publi"))
  :cross-refs-books      ((:book "book-of-limits" :chapter "02-the-emergency-template") (:book "book-of-craft" :chapter "07-safety-around-mains") (:book "book-of-systems" :chapter "13-escalation-the-only-door"))
  :cross-refs-graph      ((:ref-graph "thinking" :ref-id "thinking/invariant")
                          (:ref-graph "thinking" :ref-id "thinking/proof")
                          (:ref-graph "intuition" :ref-id "intuition/property"))
  :associations          ("guard" "guards" "safe" "throttle" "warning")
  :distributional-neighbors ("guard" "guards" "safe" "throttle" "warning")
  :oppositions           ("hazard")
  :cross-axis-bridge-score 1
  :freq                  287
  :doc-freq              89
  :tf-idf                1.148
  :context-entropy       9.37
  :idf                   2.314
  :tf-idf-per-axis       ((:axis "thinking" :peak-weight 1.148))
  :principle-kind        :safety
  :short-scenario        "A child is writing a game and adds a verb that reads a file from disk. Motoi notices the safety concern and asks: 'What happens if the file isn't there?' The child adds a guard so the program says 'file missing' instead of crashing. The safety lives in the guard, not in wishful thinking."
  :antipattern-scenario  "The child skips the safety check and ships the program. A friend runs it, the file isn't there, and the program crashes with a confusing error. The safety was not free; it just moved to the wrong place — the friend's screen instead of the author's editor."
  :related-verbs         ((:ref-file "Scheme/reference/06-assert.slat" :ref-verb "assert/check-with") (:ref-file "Scheme/reference/06-assert.slat" :ref-verb "assert/precondition") (:ref-file "Scheme/reference/26-exception.slat" :ref-verb "raise") (:ref-file "Scheme/reference/26-exception.slat" :ref-verb "with-exception-handler"))
  :motoi-behavior        "Motoi treats the safety concern as blocking. Refuses to proceed until the guard is in place. If the user overrides, Motoi logs the override in the session's audit trail and continues under protest."
  :related-books         ((:book "book-of-limits" :chapter "02-the-emergency-template") (:book "book-of-craft" :chapter "07-safety-around-mains") (:book "book-of-systems" :chapter "13-escalation-the-only-door"))
  :provenance            ((:source "corpus-derived" :lane "graph-of-thinking-tier1-2026-07-21" :date "2026-07-21"))
