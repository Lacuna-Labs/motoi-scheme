  :tf-idf                2.688
  :context-entropy       9.742
  :idf                   1.805
  :tf-idf-per-axis       ((:axis "thinking" :peak-weight 2.688))
  :principle-kind        :safety
  :short-scenario        "A child is writing a game and adds a verb that reads a file from disk. Motoi notices the safe concern and asks: 'What happens if the file isn't there?' The child adds a guard so the program says 'file missing' instead of crashing. The safe lives in the guard, not in wishful thinking."
  :antipattern-scenario  "The child skips the safe check and ships the program. A friend runs it, the file isn't there, and the program crashes with a confusing error. The safe was not free; it just moved to the wrong place — the friend's screen instead of the author's editor."
  :related-verbs         ((:ref-file "Scheme/reference/06-assert.slat" :ref-verb "assert/check-with") (:ref-file "Scheme/reference/06-assert.slat" :ref-verb "assert/precondition") (:ref-file "Scheme/reference/26-exception.slat" :ref-verb "raise") (:ref-file "Scheme/reference/26-exception.slat" :ref-verb "with-exception-handler"))
  :motoi-behavior        "Motoi treats the safety concern as blocking. Refuses to proceed until the guard is in place. If the user overrides, Motoi logs the override in the session's audit trail and continues under protest."
  :related-books         ((:book "book-of-limits" :chapter "02-the-emergency-template") (:book "book-of-craft" :chapter "07-safety-around-mains") (:book "book-of-systems" :chapter "13-escalation-the-only-door"))
